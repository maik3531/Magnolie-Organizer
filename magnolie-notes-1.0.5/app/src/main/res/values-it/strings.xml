    <string name="telefon_titel">Connessione telefonica Magnolie</string><string name="telefon_hinweis">Connessione crittografata indipendente per stato del dispositivo, richieste di composizione e notifiche in sola lettura dalle app selezionate. Non usa mai associazioni o autorizzazioni di Magnolienbaum.</string><string name="telefon_hauptschalter">Attiva connessione telefonica</string><string name="telefon_status">Stato connessione</string><string name="telefon_status_aus">Disattivata</string><string name="telefon_status_getrennt">Disconnessa</string><string name="telefon_status_gepaart">Associata</string><string name="telefon_status_code">Conferma codice</string><string name="telefon_status_fehler">Errore</string><string name="telefon_bluetooth_status">Connessione dati alternativa Bluetooth disponibile</string><string name="telefon_suchen">Cerca desktop</string><string name="telefon_verbinden">Connetti a %1$s</string><string name="telefon_code_stimmt">I codici coincidono</string><string name="telefon_code_falsch">I codici differiscono</string><string name="telefon_kopplung">Desktop associato</string><string name="telefon_geraetestatus">Autorizzazione stato dispositivo</string><string name="telefon_freigegeben">Concessa</string><string name="telefon_nicht_freigegeben">Non concessa</string><string name="telefon_entkoppeln">Rimuovi connessione telefonica</string><string name="telefon_dienst_laeuft">Connessione telefonica attiva; in attesa del desktop</string><string name="telefon_dienst_kanal">Connessione telefonica Magnolie</string><string name="telefon_trennen">Disconnetti</string>
    <string name="telefon_bluetooth_fallback">Connessione dati alternativa Bluetooth</string><string name="telefon_bluetooth_hinweis">Opzionale e disattivata per impostazione predefinita. Wi-Fi resta preferito. Associa prima il desktop nelle impostazioni di sistema Android, poi seleziona qui il dispositivo già associato. La connessione telefonica indipendente usa un proprio handshake crittografato e mai il servizio Bluetooth di Magnolienbaum.</string><string name="telefon_bluetooth_systempaarung">Apri associazione Bluetooth di sistema</string><string name="telefon_bluetooth_geraete">Scegli dispositivo associato</string><string name="telefon_bluetooth_verwenden">Usa %1$s dopo la verifica sicura</string><string name="telefon_bluetooth_zugeordnet">Dispositivo Bluetooth</string><string name="telefon_bluetooth_berechtigung">Autorizzazione Bluetooth non concessa. Nessun tentativo di connessione.</string><string name="telefon_bluetooth_voraussetzung">Attiva e associa prima in modo sicuro la connessione telefonica tramite Wi-Fi.</string>
    <string name="telefon_benachrichtigungen_titel">Notifiche selezionate</string><string name="telefon_benachrichtigungen_schalter">Inoltra notifiche dei messaggi selezionate</string><string name="telefon_benachrichtigungen_hinweis">Sola lettura. Vengono inoltrate solo le notifiche dei messaggi dalle app selezionate. Azioni, risposte, RemoteInput e PendingIntent non vengono mai trasferiti.</string><string name="telefon_systemzugriff_oeffnen">Apri accesso alle notifiche</string><string name="telefon_systemzugriff_erteilt">Accesso alle notifiche concesso</string><string name="telefon_apps_titel">App consentite</string>
