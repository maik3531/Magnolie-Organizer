    <string name="einfuhr_ueberschrift">Importa note</string>
    <string name="einfuhr_erklaerung">Samsung Notes, Google Keep e le altre app conservano le note nel proprio spazio protetto. Android non consente ad alcuna app di accedervi direttamente. Due metodi funzionano sempre: condividere una nota direttamente con Magnolie Notes oppure importare il file esportato da quelle app.</string>
    <string name="einfuhr_teilen_titel">Condividi (funziona ovunque)</string>
    <string name="einfuhr_teilen_text">Apri una nota in Samsung Notes, Keep, ColorNote o qualsiasi altra app, tocca Condividi e scegli «Magnolie Notes». Puoi condividere più note contemporaneamente.</string>
    <string name="einfuhr_datei_titel">Importa un file di esportazione</string>
    <string name="einfuhr_datei_knopf">Scegli file …</string>
    <string name="einfuhr_ordner_knopf">Scegli cartella …</string>
    <string name="einfuhr_formate">Riconosciuti automaticamente: Google Takeout (.zip / .json / .html), Samsung Notes (.sdocx / .txt / .html), Evernote (.enex), backup di ColorNote, Standard Notes (.txt / .json), Simplenote, Joplin e cartelle contenenti semplici file Markdown o di testo.</string>
    <string name="einfuhr_laeuft">Lettura …</string>
    <plurals name="einfuhr_ergebnis">
        <item quantity="one">%1$d nota importata, già presenti: %2$d.</item>
        <item quantity="many">%1$d note importate, %2$d già presenti.</item>
        <item quantity="other">%1$d note importate, %2$d già presenti.</item>
    </plurals>
