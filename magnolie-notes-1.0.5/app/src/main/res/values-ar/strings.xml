    <string name="telefon_titel">اتصال هاتف Magnolie</string><string name="telefon_hinweis">اتصال مشفر مستقل لحالة الجهاز وطلبات الاتصال وإشعارات القراءة فقط من التطبيقات المحددة بدقة. لا يستخدم مطلقًا اقترانات Magnolienbaum أو أذوناته.</string><string name="telefon_hauptschalter">تمكين اتصال الهاتف</string><string name="telefon_status">حالة الاتصال</string><string name="telefon_status_aus">متوقف</string><string name="telefon_status_getrennt">غير متصل</string><string name="telefon_status_gepaart">مقترن</string><string name="telefon_status_code">تأكيد الرمز</string><string name="telefon_status_fehler">خطأ</string><string name="telefon_bluetooth_status">بديل بيانات Bluetooth متاح</string><string name="telefon_suchen">البحث عن الحاسوب</string><string name="telefon_verbinden">الاتصال بـ %1$s</string><string name="telefon_code_stimmt">الرمزان متطابقان</string><string name="telefon_code_falsch">الرمزان مختلفان</string><string name="telefon_kopplung">الحاسوب المقترن</string><string name="telefon_geraetestatus">إذن حالة الجهاز</string><string name="telefon_freigegeben">ممنوح</string><string name="telefon_nicht_freigegeben">غير ممنوح</string><string name="telefon_entkoppeln">إزالة اتصال الهاتف</string><string name="telefon_dienst_laeuft">اتصال الهاتف مفعّل؛ في انتظار الحاسوب</string><string name="telefon_dienst_kanal">اتصال هاتف Magnolie</string><string name="telefon_trennen">قطع الاتصال</string>
    <string name="telefon_bluetooth_fallback">بديل البيانات عبر Bluetooth</string><string name="telefon_bluetooth_hinweis">اختياري ومتوقف افتراضيًا. تظل Wi-Fi هي المفضلة. أقرن الحاسوب أولًا في إعدادات نظام Android، ثم اختر هنا الجهاز المقترن بالفعل. يستخدم اتصال الهاتف المستقل مصافحة مشفرة خاصة به ولا يستخدم مطلقًا خدمة Bluetooth الخاصة بـ Magnolienbaum.</string><string name="telefon_bluetooth_systempaarung">فتح إقران Bluetooth في النظام</string><string name="telefon_bluetooth_geraete">اختيار جهاز مقترن</string><string name="telefon_bluetooth_verwenden">استخدام %1$s بعد التحقق الآمن</string><string name="telefon_bluetooth_zugeordnet">جهاز Bluetooth</string><string name="telefon_bluetooth_berechtigung">لم يُمنح إذن Bluetooth. لم تُجرَ أي محاولة اتصال.</string><string name="telefon_bluetooth_voraussetzung">مكّن اتصال الهاتف وأقرنه بأمان عبر Wi-Fi أولًا.</string>
    <string name="telefon_benachrichtigungen_titel">الإشعارات المحددة</string><string name="telefon_benachrichtigungen_schalter">إعادة توجيه إشعارات الرسائل المحددة</string><string name="telefon_benachrichtigungen_hinweis">للقراءة فقط. لا تُعاد توجيه إلا إشعارات الرسائل من التطبيقات المحددة بدقة. لا تُنقل مطلقًا الإجراءات أو الردود أو RemoteInput أو PendingIntent.</string><string name="telefon_systemzugriff_oeffnen">فتح الوصول إلى الإشعارات</string><string name="telefon_systemzugriff_erteilt">مُنح الوصول إلى الإشعارات</string><string name="telefon_apps_titel">التطبيقات المسموح بها</string>
    <string name="telefon_dienst_sucht">جارٍ البحث عن الحاسوب…</string><string name="telefon_dienst_verbindet">جارٍ الاتصال الآمن بـ %1$s…</string><string name="telefon_dienst_wlan">متصل بـ %1$s عبر Wi-Fi</string><string name="telefon_dienst_bluetooth">متصل بـ %1$s عبر Bluetooth</string><string name="telefon_dienst_fehler">فشل الاتصال؛ ستُعاد المحاولة</string>
    <string name="telefon_waehlen_schalter">السماح بطلبات الاتصال</string><string name="telefon_waehlen_hinweis">متوقف افتراضيًا ومستقل عن التحكم في المكالمات وHFP. لا يفتح الطلب إلا تطبيق الاتصال في النظام، وتؤكد المكالمة هناك.</string><string name="telefon_waehlen_nicht_verfuegbar">لا يتوفر تطبيق اتصال في النظام. لا يمكن تمكين طلبات الاتصال.</string><string name="telefon_waehlen_kanal">طلبات الاتصال</string><string name="telefon_waehlen_titel">تأكيد المكالمة في تطبيق اتصال النظام</string>
    <string name="telefon_eingehend_titel">المكالمات الواردة</string><string name="telefon_eingehend_schalter">مشاركة حالة المكالمة الواردة</string><string name="telefon_nummer_schalter">مشاركة رقم المتصل عند توفره</string><string name="telefon_annehmen_schalter">السماح بالرد على المكالمات من الحاسوب</string><string name="telefon_eingehend_hinweis">كل خيار متوقف افتراضيًا ولا يطلب إلا إذن الهاتف اللازم له. لا يُرسل صوت المكالمة مطلقًا عبر Magnolie.</string><string name="telefon_berechtigung_fehlt">لم يُمنح إذن الهاتف. يظل الخيار متوقفًا.</string>
