    <string name="einfuhr_ueberschrift">استيراد الملاحظات</string>
    <string name="einfuhr_erklaerung">تحتفظ Samsung Notes وGoogle Keep والتطبيقات الأخرى بملاحظاتها في مساحة تخزين محمية خاصة بها، ولا يسمح Android لأي تطبيق آخر بقراءتها مباشرة. هناك طريقتان تعملان دائمًا: مشاركة الملاحظة مباشرة مع Magnolie Notes، أو استيراد ملف التصدير الذي تنشئه تلك التطبيقات.</string>
    <string name="einfuhr_teilen_titel">المشاركة (تعمل في كل مكان)</string>
    <string name="einfuhr_teilen_text">افتح ملاحظة في Samsung Notes أو Keep أو ColorNote أو أي تطبيق آخر، واضغط «مشاركة»، ثم اختر «Magnolie Notes». ويمكن مشاركة عدة ملاحظات دفعة واحدة.</string>
    <string name="einfuhr_datei_titel">استيراد ملف تصدير</string>
    <string name="einfuhr_datei_knopf">اختيار ملف…</string>
    <string name="einfuhr_ordner_knopf">اختيار مجلد…</string>
    <string name="einfuhr_formate">يُتعرّف عليها تلقائيًا: Google Takeout ‏(.zip / .json / .html)، وSamsung Notes ‏(.sdocx / .txt / .html)، وEvernote ‏(.enex)، ونسخ ColorNote الاحتياطية، وStandard Notes ‏(.txt / .json)، وSimplenote، وJoplin، ومجلدات Markdown أو النصوص العادية.</string>
    <string name="einfuhr_laeuft">جارٍ القراءة…</string>
    <plurals name="einfuhr_ergebnis">
