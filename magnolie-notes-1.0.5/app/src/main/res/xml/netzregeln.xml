<?xml version="1.0" encoding="utf-8"?>
<!--
  Der Magnolienbaum spricht bewusst HTTP: die Nutzlast ist innerhalb des
  Protokolls mit AES-256-GCM verschlüsselt und beglaubigt, TLS würde nur eine
  zweite, gegen selbstsignierte Gegenstellen nutzlose Schicht hinzufügen.
  Siehe ENTWURF-MAGNOLIENBAUM.md, Abschnitt 12.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
