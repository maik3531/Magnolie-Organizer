    <string name="blatt_journal">Восстановление</string><string name="journal_titel">Журнал восстановления</string><string name="journal_hinweis">Зашифрованные локальные снимки. Они никогда не попадают в облачную резервную копию Android.</string><string name="journal_zuletzt">Последний снимок</string><string name="journal_naechste">Следующий снимок</string><string name="journal_status">Состояние</string><string name="journal_bereit">Готово</string><string name="journal_intervall">Интервал</string><string name="journal_aus">Выкл.</string><string name="journal_6h">6 часов</string><string name="journal_12h">12 часов</string><string name="journal_taeglich">Ежедневно</string><string name="journal_woechentlich">Еженедельно</string><string name="journal_jetzt">Создать снимок сейчас</string><string name="journal_liste">Снимки</string><string name="journal_leer">Снимков пока нет.</string><string name="journal_integritaet">целостность проверена при открытии</string><string name="journal_vorschau">Предпросмотр</string><string name="journal_restore">Восстановить</string><string name="journal_restore_frage">Восстановить «%1$s»? Сначала будет создан снимок перед восстановлением.</string><string name="journal_loeschen_frage">Удалить этот снимок безвозвратно?</string>
