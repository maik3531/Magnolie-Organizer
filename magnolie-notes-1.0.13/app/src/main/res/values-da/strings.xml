    <string name="einfuhr_ueberschrift">Overtag noter</string>
    <string name="einfuhr_erklaerung">Samsung Notes, Google Keep og andre apps gemmer deres noter i deres eget beskyttede lager. Android lader ikke andre apps læse det direkte. To metoder virker altid: Del en note direkte med Magnolie Notes, eller importér den eksportfil, som appen opretter.</string>
    <string name="einfuhr_teilen_titel">Del (virker overalt)</string>
    <string name="einfuhr_teilen_text">Åbn en note i Samsung Notes, Keep, ColorNote eller en anden app, tryk på Del, og vælg “Magnolie Notes”. Du kan dele flere noter på én gang.</string>
    <string name="einfuhr_datei_titel">Importér en eksportfil</string>
    <string name="einfuhr_datei_knopf">Vælg fil …</string>
    <string name="einfuhr_ordner_knopf">Vælg mappe …</string>
    <string name="einfuhr_formate">Genkendes automatisk: Google Takeout (.zip / .json / .html), Samsung Notes (.sdocx / .txt / .html), Evernote (.enex), ColorNote-sikkerhedskopi, Standard Notes (.txt / .json), Simplenote, Joplin samt almindelige Markdown- eller tekstmapper.</string>
    <string name="einfuhr_laeuft">Læser …</string>
