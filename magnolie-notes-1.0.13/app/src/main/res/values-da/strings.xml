    <string name="blatt_journal">Gendannelse</string><string name="journal_titel">Gendannelsesjournal</string><string name="journal_hinweis">Krypterede lokale øjebliksbilleder. De kommer aldrig med i Androids cloudbackup.</string><string name="journal_zuletzt">Seneste øjebliksbillede</string><string name="journal_naechste">Næste øjebliksbillede</string><string name="journal_status">Status</string><string name="journal_bereit">Klar</string><string name="journal_intervall">Interval</string><string name="journal_aus">Fra</string><string name="journal_6h">6 timer</string><string name="journal_12h">12 timer</string><string name="journal_taeglich">Dagligt</string><string name="journal_woechentlich">Ugentligt</string><string name="journal_jetzt">Tag øjebliksbillede nu</string><string name="journal_liste">Øjebliksbilleder</string><string name="journal_leer">Ingen øjebliksbilleder endnu.</string><string name="journal_integritaet">integritet kontrolleret ved åbning</string><string name="journal_vorschau">Forhåndsvisning</string><string name="journal_restore">Gendan</string><string name="journal_restore_frage">Gendan “%1$s”? Der oprettes først et øjebliksbillede før gendannelsen.</string><string name="journal_loeschen_frage">Slet dette øjebliksbillede permanent?</string>
