    <string name="einfuhr_anleitung_titel">Sådan får du eksportfilen</string>
    <string name="einfuhr_anleitung_keep">Google Keep: Åbn takeout.google.com på telefonen, vælg kun “Keep”, anmod om eksporten, og gem .zip-filen her.</string>
    <string name="einfuhr_anleitung_samsung">Samsung Notes: Åbn listen, tryk længe på en note, vælg Mere → Gem som fil → PDF eller tekst, og importér derefter mappen her. Du kan vælge en hel notesbog på én gang.</string>
    <string name="einfuhr_anleitung_evernote">Evernote: Notesbog → Eksportér noter → .enex.</string>
