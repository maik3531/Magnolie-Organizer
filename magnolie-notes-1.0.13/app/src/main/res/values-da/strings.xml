    <string name="telefon_titel">Magnolie-telefonforbindelse</string><string name="telefon_hinweis">Uafhængig krypteret forbindelse til enhedsstatus, opkaldsanmodninger og skrivebeskyttede notifikationer fra præcist valgte apps. Den bruger aldrig Magnolienbaum-parringer eller -tilladelser.</string><string name="telefon_hauptschalter">Aktivér telefonforbindelse</string><string name="telefon_status">Forbindelsesstatus</string><string name="telefon_status_aus">Fra</string><string name="telefon_status_getrennt">Afbrudt</string><string name="telefon_status_gepaart">Parret</string><string name="telefon_status_code">Bekræft kode</string><string name="telefon_status_fehler">Fejl</string><string name="telefon_bluetooth_status">Bluetooth-datareserve tilgængelig</string><string name="telefon_suchen">Søg efter computer</string><string name="telefon_verbinden">Opret forbindelse til %1$s</string><string name="telefon_code_stimmt">Koderne matcher</string><string name="telefon_code_falsch">Koderne er forskellige</string><string name="telefon_kopplung">Parret computer</string><string name="telefon_geraetestatus">Tilladelse til enhedsstatus</string><string name="telefon_freigegeben">Tilladt</string><string name="telefon_nicht_freigegeben">Ikke tilladt</string><string name="telefon_entkoppeln">Fjern telefonforbindelse</string><string name="telefon_dienst_laeuft">Telefonforbindelse aktiveret; venter på computer</string><string name="telefon_dienst_kanal">Magnolie-telefonforbindelse</string><string name="telefon_trennen">Afbryd</string>
    <string name="telefon_bluetooth_fallback">Bluetooth-datareserve</string><string name="telefon_bluetooth_hinweis">Valgfri og som standard slået fra. Wi-Fi foretrækkes fortsat. Par først computeren i Androids systemindstillinger, og vælg derefter den allerede parrede enhed her. Den uafhængige telefonforbindelse bruger sit eget krypterede håndtryk og aldrig Magnolienbaums Bluetooth-tjeneste.</string><string name="telefon_bluetooth_systempaarung">Åbn Bluetooth-systemparring</string><string name="telefon_bluetooth_geraete">Vælg parret enhed</string><string name="telefon_bluetooth_verwenden">Brug %1$s efter sikker bekræftelse</string><string name="telefon_bluetooth_zugeordnet">Bluetooth-enhed</string><string name="telefon_bluetooth_berechtigung">Bluetooth-tilladelsen blev ikke givet. Ingen forbindelse blev forsøgt.</string><string name="telefon_bluetooth_voraussetzung">Aktivér og par først telefonforbindelsen sikkert via Wi-Fi.</string>
    <string name="telefon_benachrichtigungen_titel">Valgte notifikationer</string><string name="telefon_benachrichtigungen_schalter">Videresend valgte beskednotifikationer</string><string name="telefon_benachrichtigungen_hinweis">Skrivebeskyttet. Kun beskednotifikationer fra præcist valgte apps videresendes. Handlinger, svar, RemoteInput og PendingIntent overføres aldrig.</string><string name="telefon_systemzugriff_oeffnen">Åbn notifikationsadgang</string><string name="telefon_systemzugriff_erteilt">Notifikationsadgang givet</string><string name="telefon_apps_titel">Tilladte apps</string>
    <string name="telefon_dienst_sucht">Søger efter computer…</string><string name="telefon_dienst_verbindet">Opretter sikker forbindelse til %1$s…</string><string name="telefon_dienst_wlan">Forbundet til %1$s via Wi-Fi</string><string name="telefon_dienst_bluetooth">Forbundet til %1$s via Bluetooth</string><string name="telefon_dienst_fehler">Forbindelsen mislykkedes; prøver igen</string>
    <string name="telefon_waehlen_schalter">Tillad opkaldsanmodninger</string><string name="telefon_waehlen_hinweis">Som standard slået fra og uafhængig af opkaldsstyring og HFP. En anmodning åbner kun systemets opkaldsapp; du bekræfter opkaldet der.</string><string name="telefon_waehlen_nicht_verfuegbar">Ingen systemopkaldsapp er tilgængelig. Opkaldsanmodninger kan ikke aktiveres.</string><string name="telefon_waehlen_kanal">Opkaldsanmodninger</string><string name="telefon_waehlen_titel">Bekræft opkald i systemets opkaldsapp</string>
    <string name="telefon_eingehend_titel">Indgående opkald</string><string name="telefon_eingehend_schalter">Del status for indgående opkald</string><string name="telefon_nummer_schalter">Del opkalderens nummer, når det er tilgængeligt</string><string name="telefon_annehmen_schalter">Tillad besvarelse af opkald fra computeren</string><string name="telefon_eingehend_hinweis">Hver indstilling er som standard slået fra og anmoder kun om den nødvendige telefontilladelse. Opkaldslyd sendes aldrig via Magnolie.</string><string name="telefon_berechtigung_fehlt">Telefontilladelsen blev ikke givet. Indstillingen forbliver slået fra.</string>
