<?xml version="1.0" encoding="utf-8"?>
<!-- Opt-in native validation overlay, not part of normal debug or release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".ValidationFolderActivity" android:exported="false" />
        <service android:name=".ValidationAuthenticatorService" android:exported="true"
            android:permission="android.permission.BIND_ACCOUNT_AUTHENTICATOR">
            <intent-filter><action android:name="android.accounts.AccountAuthenticator" /></intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator" android:resource="@xml/validation_account" />
        </service>
    </application>
</manifest>
