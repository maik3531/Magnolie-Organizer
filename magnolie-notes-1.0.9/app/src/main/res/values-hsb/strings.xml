    <string name="blatt_journal">Wobnowjenje</string><string name="journal_titel">Wobnowjenski žurnal</string><string name="journal_hinweis">Zaklučowane lokalne momentowe wobrazy. Do mróčeloweho zawěsćenja Android ženje njezańdu.</string><string name="journal_zuletzt">Posledni momentowy wobraz</string><string name="journal_naechste">Přichodny momentowy wobraz</string><string name="journal_status">Status</string><string name="journal_bereit">Hotowo</string><string name="journal_intervall">Interwal</string><string name="journal_aus">Wupinjene</string><string name="journal_6h">6 hodźin</string><string name="journal_12h">12 hodźin</string><string name="journal_taeglich">Kóždy dźeń</string><string name="journal_woechentlich">Kóždy tydźeń</string><string name="journal_jetzt">Nětko momentowy wobraz wutworić</string><string name="journal_liste">Momentowe wobrazy</string><string name="journal_leer">Hišće žane momentowe wobrazy.</string><string name="journal_integritaet">integrita je so při wočinjenju přepruwowała</string><string name="journal_vorschau">Přehlad</string><string name="journal_restore">Wobnowić</string><string name="journal_restore_frage">„%1$s“ wobnowić? Najprjedy so momentowy wobraz před wobnowjenjom wutwori.</string><string name="journal_loeschen_frage">Tutón momentowy wobraz na přeco zhašeć?</string>
    <string name="journal_kontakt_konflikt">Kontakt je změnjeny</string><string name="journal_kontakt_konflikt_frage">„%1$s“ je so wot momentoweho wobraza změnił. Jenož wubrany zwjazany kontakt přepisać?</string><string name="journal_konflikt_ueberschreiben">Wubrany kontakt přepisać</string>
    <string name="telefon_titel">Telefonowy zwisk Magnolie</string><string name="telefon_hinweis">Samostatny zaklučowany zwisk za status grata, požadanja wołanja a jenož čitajomne zdźělenki z eksaktnje wubranych nałožbow. Ženje njewužiwa koplowanja abo dowolnosće Magnolienbaum.</string><string name="telefon_hauptschalter">Telefonowy zwisk zmóžnić</string><string name="telefon_status">Status zwiska</string><string name="telefon_status_aus">Wupinjene</string><string name="telefon_status_getrennt">Rozdźělene</string><string name="telefon_status_gepaart">Sparowane</string><string name="telefon_status_code">Kod wobkrućić</string><string name="telefon_status_fehler">Zmylk</string><string name="telefon_bluetooth_status">Bluetooth jako narunanje za daty k dispoziciji</string><string name="telefon_suchen">Za desktopom pytać</string><string name="telefon_verbinden">Z %1$s zwjazać</string><string name="telefon_code_stimmt">Kodaj so kryjetej</string><string name="telefon_code_falsch">Kodaj so rozeznawatej</string><string name="telefon_kopplung">Sparowany desktop</string><string name="telefon_geraetestatus">Dowolnosć statusa grata</string><string name="telefon_freigegeben">Dowolene</string><string name="telefon_nicht_freigegeben">Njedowolene</string><string name="telefon_entkoppeln">Telefonowy zwisk wotstronić</string><string name="telefon_dienst_laeuft">Telefonowy zwisk zmóžnjeny; čaka so na desktop</string><string name="telefon_dienst_kanal">Telefonowy zwisk Magnolie</string><string name="telefon_trennen">Zwisk dźělić</string>
    <string name="telefon_bluetooth_fallback">Bluetooth jako narunanje za daty</string><string name="telefon_bluetooth_hinweis">Opcionalne a po standardźe wupinjene. Wi-Fi wostanje preferowane. Sparujće najprjedy desktop w systemowych nastajenjach Android a wubjerće potom tu hižo sparowany grat. Samostatny telefonowy zwisk wužiwa swój zaklučowany protokol rukidaća a ženje Bluetooth-słužbu Magnolienbaum.</string><string name="telefon_bluetooth_systempaarung">Systemowe Bluetooth-koplowanje wočinić</string><string name="telefon_bluetooth_geraete">Sparowany grat wubrać</string><string name="telefon_bluetooth_verwenden">%1$s po wěstej přepruwowanju wužiwać</string><string name="telefon_bluetooth_zugeordnet">Bluetooth-grat</string><string name="telefon_bluetooth_berechtigung">Bluetooth-dowolnosć njeje so dała. Zwisk njeje so spytał.</string><string name="telefon_bluetooth_voraussetzung">Zmóžńće a sparujće najprjedy telefonowy zwisk wěsće přez Wi-Fi.</string>
    <string name="telefon_benachrichtigungen_titel">Wubrane zdźělenki</string><string name="telefon_benachrichtigungen_schalter">Wubrane powěsćowe zdźělenki dale sposrědkować</string><string name="telefon_benachrichtigungen_hinweis">Jenož čitajomne. Jenož powěsćowe zdźělenki z eksaktnje wubranych nałožbow so dale sposrědkuja. Akcije, wotmołwy, RemoteInput a PendingIntent so ženje njepřenjesu.</string><string name="telefon_systemzugriff_oeffnen">Přistup ke zdźělenkam wočinić</string><string name="telefon_systemzugriff_erteilt">Přistup ke zdźělenkam dowoleny</string><string name="telefon_apps_titel">Dowolene nałožby</string>
    <string name="telefon_dienst_sucht">Za desktopom so pyta…</string><string name="telefon_dienst_verbindet">Wěsty zwisk z %1$s so twori…</string><string name="telefon_dienst_wlan">Z %1$s přez Wi-Fi zwjazany</string><string name="telefon_dienst_bluetooth">Z %1$s přez Bluetooth zwjazany</string><string name="telefon_dienst_fehler">Zwisk je so njeporadźił; spytuje so znowa</string>
    <string name="telefon_waehlen_schalter">Požadanja wołanja dowolić</string><string name="telefon_waehlen_hinweis">Po standardźe wupinjene a njewotwisne wot wodźenja zawołanjow a HFP. Požadanje jenož systemowy čisłownik wočini; zawołanje tam wobkrućiće.</string><string name="telefon_waehlen_nicht_verfuegbar">Žadyn systemowy čisłownik njeje k dispoziciji. Požadanja wołanja njedadźa so zmóžnić.</string><string name="telefon_waehlen_kanal">Požadanja wołanja</string><string name="telefon_waehlen_titel">Zawołanje w systemowym čisłowniku wobkrućić</string>
    <string name="telefon_eingehend_titel">Dochadźace zawołanja</string><string name="telefon_eingehend_schalter">Status dochadźaceho zawołanja dźělić</string><string name="telefon_nummer_schalter">Čisło wołaceho dźělić, hdyž je k dispoziciji</string><string name="telefon_annehmen_schalter">Přiwzaće zawołanjow z ličaka dowolić</string><string name="telefon_eingehend_hinweis">Kóžda opcija je po standardźe wupinjena a prosy jenož wo trěbnu telefonowu dowolnosć. Zynk zawołanja so ženje přez Magnolie njeposćele.</string><string name="telefon_berechtigung_fehlt">Telefonowa dowolnosć njeje so dała. Opcija wostanje wupinjena.</string>
