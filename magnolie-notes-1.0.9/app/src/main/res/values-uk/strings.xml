    <string name="blatt_journal">Відновлення</string><string name="journal_titel">Журнал відновлення</string><string name="journal_hinweis">Зашифровані локальні знімки. Вони ніколи не потрапляють до хмарної резервної копії Android.</string><string name="journal_zuletzt">Останній знімок</string><string name="journal_naechste">Наступний знімок</string><string name="journal_status">Стан</string><string name="journal_bereit">Готово</string><string name="journal_intervall">Інтервал</string><string name="journal_aus">Вимкнено</string><string name="journal_6h">6 годин</string><string name="journal_12h">12 годин</string><string name="journal_taeglich">Щодня</string><string name="journal_woechentlich">Щотижня</string><string name="journal_jetzt">Створити знімок зараз</string><string name="journal_liste">Знімки</string><string name="journal_leer">Знімків ще немає.</string><string name="journal_integritaet">цілісність перевірено під час відкриття</string><string name="journal_vorschau">Попередній перегляд</string><string name="journal_restore">Відновити</string><string name="journal_restore_frage">Відновити «%1$s»? Спочатку буде створено знімок перед відновленням.</string><string name="journal_loeschen_frage">Назавжди видалити цей знімок?</string>
