    <string name="telefon_titel">Telefonní připojení Magnolie</string><string name="telefon_hinweis">Nezávislé šifrované připojení pro stav zařízení, požadavky na vytáčení a oznámení pouze pro čtení z přesně vybraných aplikací. Nikdy nepoužívá párování ani oprávnění Magnolienbaum.</string><string name="telefon_hauptschalter">Povolit telefonní připojení</string><string name="telefon_status">Stav připojení</string><string name="telefon_status_aus">Vypnuto</string><string name="telefon_status_getrennt">Odpojeno</string><string name="telefon_status_gepaart">Spárováno</string><string name="telefon_status_code">Potvrdit kód</string><string name="telefon_status_fehler">Chyba</string><string name="telefon_bluetooth_status">Záložní přenos dat přes Bluetooth je k dispozici</string><string name="telefon_suchen">Vyhledat počítač</string><string name="telefon_verbinden">Připojit k %1$s</string><string name="telefon_code_stimmt">Kódy souhlasí</string><string name="telefon_code_falsch">Kódy se liší</string><string name="telefon_kopplung">Spárovaný počítač</string><string name="telefon_geraetestatus">Oprávnění ke stavu zařízení</string><string name="telefon_freigegeben">Povoleno</string><string name="telefon_nicht_freigegeben">Nepovoleno</string><string name="telefon_entkoppeln">Odebrat telefonní připojení</string><string name="telefon_dienst_laeuft">Telefonní připojení je povoleno; čeká se na počítač</string><string name="telefon_dienst_kanal">Telefonní připojení Magnolie</string><string name="telefon_trennen">Odpojit</string>
    <string name="telefon_bluetooth_fallback">Záložní přenos dat přes Bluetooth</string><string name="telefon_bluetooth_hinweis">Volitelné a ve výchozím nastavení vypnuté. Wi-Fi zůstává upřednostňována. Nejprve spárujte počítač v systémovém nastavení Androidu a potom zde vyberte toto již spárované zařízení. Nezávislé telefonní připojení používá vlastní šifrované navázání spojení a nikdy nepoužívá službu Bluetooth Magnolienbaum.</string><string name="telefon_bluetooth_systempaarung">Otevřít systémové párování Bluetooth</string><string name="telefon_bluetooth_geraete">Vybrat spárované zařízení</string><string name="telefon_bluetooth_verwenden">Po bezpečném ověření použít %1$s</string><string name="telefon_bluetooth_zugeordnet">Zařízení Bluetooth</string><string name="telefon_bluetooth_berechtigung">Oprávnění k Bluetooth nebylo uděleno. Nebyl proveden žádný pokus o připojení.</string><string name="telefon_bluetooth_voraussetzung">Nejprve povolte a bezpečně spárujte telefonní připojení přes Wi-Fi.</string>
    <string name="telefon_benachrichtigungen_titel">Vybraná oznámení</string><string name="telefon_benachrichtigungen_schalter">Předávat vybraná oznámení zpráv</string><string name="telefon_benachrichtigungen_hinweis">Pouze pro čtení. Předávají se pouze oznámení zpráv z přesně vybraných aplikací. Akce, odpovědi, RemoteInput ani PendingIntent se nikdy nepřenášejí.</string><string name="telefon_systemzugriff_oeffnen">Otevřít přístup k oznámením</string><string name="telefon_systemzugriff_erteilt">Přístup k oznámením udělen</string><string name="telefon_apps_titel">Povolené aplikace</string>
    <string name="telefon_dienst_sucht">Vyhledávání počítače…</string><string name="telefon_dienst_verbindet">Bezpečné připojování k %1$s…</string><string name="telefon_dienst_wlan">Připojeno k %1$s přes Wi-Fi</string><string name="telefon_dienst_bluetooth">Připojeno k %1$s přes Bluetooth</string><string name="telefon_dienst_fehler">Připojení se nezdařilo; probíhá další pokus</string>
    <string name="telefon_waehlen_schalter">Povolit požadavky na vytáčení</string><string name="telefon_waehlen_hinweis">Ve výchozím nastavení vypnuto a nezávislé na ovládání hovorů a HFP. Požadavek pouze otevře systémový číselník; hovor v něm potvrdíte.</string><string name="telefon_waehlen_nicht_verfuegbar">Systémový číselník není k dispozici. Požadavky na vytáčení nelze povolit.</string><string name="telefon_waehlen_kanal">Požadavky na vytáčení</string><string name="telefon_waehlen_titel">Potvrdit hovor v systémovém číselníku</string>
    <string name="telefon_eingehend_titel">Příchozí hovory</string><string name="telefon_eingehend_schalter">Sdílet stav příchozího hovoru</string><string name="telefon_nummer_schalter">Sdílet číslo volajícího, je-li dostupné</string><string name="telefon_annehmen_schalter">Povolit přijímání hovorů z počítače</string><string name="telefon_eingehend_hinweis">Každá možnost je ve výchozím nastavení vypnutá a žádá pouze o potřebné oprávnění telefonu. Zvuk hovoru se přes Magnolie nikdy nepřenáší.</string><string name="telefon_berechtigung_fehlt">Oprávnění telefonu nebylo uděleno. Možnost zůstává vypnutá.</string>
