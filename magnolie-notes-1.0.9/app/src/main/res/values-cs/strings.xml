    <string name="blatt_journal">Obnovení</string><string name="journal_titel">Deník obnovení</string><string name="journal_hinweis">Šifrované místní snímky. Nikdy se nezahrnují do cloudové zálohy Androidu.</string><string name="journal_zuletzt">Poslední snímek</string><string name="journal_naechste">Další snímek</string><string name="journal_status">Stav</string><string name="journal_bereit">Připraveno</string><string name="journal_intervall">Interval</string><string name="journal_aus">Vypnuto</string><string name="journal_6h">6 hodin</string><string name="journal_12h">12 hodin</string><string name="journal_taeglich">Denně</string><string name="journal_woechentlich">Týdně</string><string name="journal_jetzt">Vytvořit snímek nyní</string><string name="journal_liste">Snímky</string><string name="journal_leer">Zatím žádné snímky.</string><string name="journal_integritaet">integrita ověřena při otevření</string><string name="journal_vorschau">Náhled</string><string name="journal_restore">Obnovit</string><string name="journal_restore_frage">Obnovit „%1$s“? Nejprve se vytvoří snímek před obnovením.</string><string name="journal_loeschen_frage">Trvale odstranit tento snímek?</string>
