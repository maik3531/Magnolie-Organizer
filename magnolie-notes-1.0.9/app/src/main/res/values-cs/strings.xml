    <string name="einfuhr_ueberschrift">Import poznámek</string>
    <string name="einfuhr_erklaerung">Samsung Notes, Google Keep a další aplikace uchovávají poznámky ve vlastním chráněném úložišti. Android nedovoluje jiným aplikacím, aby je přímo četly. Vždy fungují dvě možnosti: sdílet poznámku přímo do Magnolie Notes nebo importovat exportní soubor vytvořený danou aplikací.</string>
    <string name="einfuhr_teilen_titel">Sdílení (funguje všude)</string>
    <string name="einfuhr_teilen_text">Otevřete poznámku v Samsung Notes, Keep, ColorNote nebo jiné aplikaci, klepněte na Sdílet a zvolte „Magnolie Notes“. Lze sdílet i několik poznámek najednou.</string>
    <string name="einfuhr_datei_titel">Import exportního souboru</string>
    <string name="einfuhr_datei_knopf">Vybrat soubor …</string>
    <string name="einfuhr_ordner_knopf">Vybrat složku …</string>
    <string name="einfuhr_formate">Automaticky rozpoznávané formáty: Google Takeout (.zip / .json / .html), Samsung Notes (.sdocx / .txt / .html), Evernote (.enex), záloha ColorNote, Standard Notes (.txt / .json), Simplenote, Joplin a běžné složky s Markdownem nebo textem.</string>
