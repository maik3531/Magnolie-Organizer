    <string name="einfuhr_ueberschrift">Notları içe aktar</string>
    <string name="einfuhr_erklaerung">Samsung Notes, Google Keep ve diğer uygulamalar notlarını kendi korumalı depolama alanlarında tutar. Android, başka uygulamaların bunları doğrudan okumasına izin vermez. Her zaman işe yarayan iki yol vardır: bir notu doğrudan Magnolie Notes ile paylaşmak veya bu uygulamaların oluşturduğu dışa aktarma dosyasını içe aktarmak.</string>
    <string name="einfuhr_teilen_titel">Paylaş (her yerde çalışır)</string>
    <string name="einfuhr_teilen_text">Samsung Notes, Keep, ColorNote veya başka bir uygulamada bir not açın, Paylaş’a dokunun ve “Magnolie Notes”u seçin. Birkaç not aynı anda paylaşılabilir.</string>
    <string name="einfuhr_datei_titel">Dışa aktarma dosyasını içe aktar</string>
    <string name="einfuhr_datei_knopf">Dosya seç…</string>
    <string name="einfuhr_ordner_knopf">Klasör seç…</string>
    <string name="einfuhr_formate">Otomatik tanınanlar: Google Takeout (.zip / .json / .html), Samsung Notes (.sdocx / .txt / .html), Evernote (.enex), ColorNote yedeği, Standard Notes (.txt / .json), Simplenote, Joplin ve düz Markdown ya da metin klasörleri.</string>
    <string name="einfuhr_laeuft">Okunuyor…</string>
    <plurals name="einfuhr_ergebnis">
        <item quantity="one">%1$d not içe aktarıldı, %2$d not zaten vardı.</item>
        <item quantity="other">%1$d not içe aktarıldı, %2$d not zaten vardı.</item>
    </plurals>
