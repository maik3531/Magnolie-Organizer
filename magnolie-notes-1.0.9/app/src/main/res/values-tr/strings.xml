    <string name="blatt_journal">Kurtarma</string><string name="journal_titel">Kurtarma günlüğü</string><string name="journal_hinweis">Şifrelenmiş yerel anlık görüntüler. Android bulut yedeklemesine asla girmezler.</string><string name="journal_zuletzt">Son anlık görüntü</string><string name="journal_naechste">Sonraki anlık görüntü</string><string name="journal_status">Durum</string><string name="journal_bereit">Hazır</string><string name="journal_intervall">Aralık</string><string name="journal_aus">Kapalı</string><string name="journal_6h">6 saat</string><string name="journal_12h">12 saat</string><string name="journal_taeglich">Günlük</string><string name="journal_woechentlich">Haftalık</string><string name="journal_jetzt">Şimdi anlık görüntü oluştur</string><string name="journal_liste">Anlık görüntüler</string><string name="journal_leer">Henüz anlık görüntü yok.</string><string name="journal_integritaet">açılırken bütünlüğü doğrulandı</string><string name="journal_vorschau">Önizleme</string><string name="journal_restore">Geri yükle</string><string name="journal_restore_frage">“%1$s” geri yüklensin mi? Önce geri yükleme öncesi bir anlık görüntü oluşturulur.</string><string name="journal_loeschen_frage">Bu anlık görüntü kalıcı olarak silinsin mi?</string>
