    <string name="blatt_journal">Herstel</string><string name="journal_titel">Hersteldagboek</string><string name="journal_hinweis">Versleutelde lokale momentopnamen. Ze komen nooit in de Android-cloudback-up terecht.</string><string name="journal_zuletzt">Laatste momentopname</string><string name="journal_naechste">Volgende momentopname</string><string name="journal_status">Status</string><string name="journal_bereit">Gereed</string><string name="journal_intervall">Interval</string><string name="journal_aus">Uit</string><string name="journal_6h">6 uur</string><string name="journal_12h">12 uur</string><string name="journal_taeglich">Dagelijks</string><string name="journal_woechentlich">Wekelijks</string><string name="journal_jetzt">Nu momentopname maken</string><string name="journal_liste">Momentopnamen</string><string name="journal_leer">Nog geen momentopnamen.</string><string name="journal_integritaet">integriteit bij openen gecontroleerd</string><string name="journal_vorschau">Voorbeeld</string><string name="journal_restore">Herstellen</string><string name="journal_restore_frage">‘%1$s’ herstellen? Eerst wordt een momentopname van voor het herstel gemaakt.</string><string name="journal_loeschen_frage">Deze momentopname permanent verwijderen?</string>
    <string name="journal_kontakt_konflikt">Contact gewijzigd</string><string name="journal_kontakt_konflikt_frage">‘%1$s’ is sinds de momentopname gewijzigd. Alleen het geselecteerde gekoppelde contact overschrijven?</string><string name="journal_konflikt_ueberschreiben">Geselecteerd contact overschrijven</string>
    <string name="telefon_titel">Magnolie-telefoonverbinding</string><string name="telefon_hinweis">Onafhankelijke versleutelde verbinding voor apparaatstatus, kiesverzoeken en alleen-lezenmeldingen van precies geselecteerde apps. Gebruikt nooit koppelingen of machtigingen van Magnolienbaum.</string><string name="telefon_hauptschalter">Telefoonverbinding inschakelen</string><string name="telefon_status">Verbindingsstatus</string><string name="telefon_status_aus">Uit</string><string name="telefon_status_getrennt">Niet verbonden</string><string name="telefon_status_gepaart">Gekoppeld</string><string name="telefon_status_code">Code bevestigen</string><string name="telefon_status_fehler">Fout</string><string name="telefon_bluetooth_status">Bluetooth-gegevensterugval beschikbaar</string><string name="telefon_suchen">Desktop zoeken</string><string name="telefon_verbinden">Verbinden met %1$s</string><string name="telefon_code_stimmt">Codes komen overeen</string><string name="telefon_code_falsch">Codes verschillen</string><string name="telefon_kopplung">Gekoppelde desktop</string><string name="telefon_geraetestatus">Toestemming voor apparaatstatus</string><string name="telefon_freigegeben">Toegestaan</string><string name="telefon_nicht_freigegeben">Niet toegestaan</string><string name="telefon_entkoppeln">Telefoonverbinding verwijderen</string><string name="telefon_dienst_laeuft">Telefoonverbinding ingeschakeld; wacht op desktop</string><string name="telefon_dienst_kanal">Magnolie-telefoonverbinding</string><string name="telefon_trennen">Verbinding verbreken</string>
    <string name="telefon_bluetooth_fallback">Bluetooth-gegevensterugval</string><string name="telefon_bluetooth_hinweis">Optioneel en standaard uit. Wi-Fi houdt de voorkeur. Koppel de desktop eerst in de Android-systeeminstellingen en selecteer hier daarna dat al gekoppelde apparaat. De onafhankelijke telefoonverbinding gebruikt een eigen versleutelde handshake en nooit de Bluetooth-service van Magnolienbaum.</string><string name="telefon_bluetooth_systempaarung">Bluetooth-systeemkoppeling openen</string><string name="telefon_bluetooth_geraete">Gekoppeld apparaat kiezen</string><string name="telefon_bluetooth_verwenden">%1$s gebruiken na veilige verificatie</string><string name="telefon_bluetooth_zugeordnet">Bluetooth-apparaat</string><string name="telefon_bluetooth_berechtigung">Bluetooth-machtiging is niet verleend. Er is geen verbinding geprobeerd.</string><string name="telefon_bluetooth_voraussetzung">Schakel de telefoonverbinding eerst in en koppel deze veilig via Wi-Fi.</string>
    <string name="telefon_benachrichtigungen_titel">Geselecteerde meldingen</string><string name="telefon_benachrichtigungen_schalter">Geselecteerde berichtmeldingen doorsturen</string><string name="telefon_benachrichtigungen_hinweis">Alleen-lezen. Alleen berichtmeldingen van precies geselecteerde apps worden doorgestuurd. Acties, antwoorden, RemoteInput en PendingIntent worden nooit overgedragen.</string><string name="telefon_systemzugriff_oeffnen">Meldingstoegang openen</string><string name="telefon_systemzugriff_erteilt">Meldingstoegang verleend</string><string name="telefon_apps_titel">Toegestane apps</string>
    <string name="telefon_dienst_sucht">Desktop zoeken…</string><string name="telefon_dienst_verbindet">Veilig verbinden met %1$s…</string><string name="telefon_dienst_wlan">Verbonden met %1$s via Wi-Fi</string><string name="telefon_dienst_bluetooth">Verbonden met %1$s via Bluetooth</string><string name="telefon_dienst_fehler">Verbinding mislukt; nieuwe poging</string>
    <string name="telefon_waehlen_schalter">Kiesverzoeken toestaan</string><string name="telefon_waehlen_hinweis">Standaard uit en onafhankelijk van oproepbediening en HFP. Een verzoek opent alleen de systeemkiezer; u bevestigt de oproep daar.</string><string name="telefon_waehlen_nicht_verfuegbar">Er is geen systeemkiezer beschikbaar. Kiesverzoeken kunnen niet worden ingeschakeld.</string><string name="telefon_waehlen_kanal">Kiesverzoeken</string><string name="telefon_waehlen_titel">Oproep bevestigen in systeemkiezer</string>
    <string name="telefon_eingehend_titel">Inkomende oproepen</string><string name="telefon_eingehend_schalter">Status van inkomende oproep delen</string><string name="telefon_nummer_schalter">Nummer van beller delen indien beschikbaar</string><string name="telefon_annehmen_schalter">Oproepen vanaf de computer laten beantwoorden</string><string name="telefon_eingehend_hinweis">Elke optie staat standaard uit en vraagt alleen de vereiste telefoonmachtiging. Oproepaudio wordt nooit via Magnolie verzonden.</string><string name="telefon_berechtigung_fehlt">De telefoonmachtiging is niet verleend. De optie blijft uit.</string>
