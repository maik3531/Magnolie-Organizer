    <string name="einfuhr_ueberschrift">Notities overnemen</string>
    <string name="einfuhr_erklaerung">Samsung Notes, Google Keep en andere apps bewaren hun notities in hun eigen beveiligde opslag. Android laat andere apps die niet rechtstreeks lezen. Twee manieren werken altijd: deel een notitie direct met Magnolie Notes of importeer het exportbestand dat deze apps maken.</string>
    <string name="einfuhr_teilen_titel">Delen (werkt overal)</string>
    <string name="einfuhr_teilen_text">Open een notitie in Samsung Notes, Keep, ColorNote of een andere app, tik op Delen en kies ‘Magnolie Notes’. U kunt meerdere notities tegelijk delen.</string>
    <string name="einfuhr_datei_titel">Een exportbestand importeren</string>
    <string name="einfuhr_datei_knopf">Bestand kiezen …</string>
    <string name="einfuhr_ordner_knopf">Map kiezen …</string>
    <string name="einfuhr_formate">Automatisch herkend: Google Takeout (.zip / .json / .html), Samsung Notes (.sdocx / .txt / .html), Evernote (.enex), ColorNote-back-up, Standard Notes (.txt / .json), Simplenote, Joplin en gewone Markdown- of tekstmappen.</string>
    <string name="einfuhr_laeuft">Lezen …</string>
    <plurals name="einfuhr_ergebnis">
        <item quantity="one">%1$d notitie overgenomen, al aanwezig: %2$d.</item>
        <item quantity="other">%1$d notities overgenomen, %2$d al aanwezig.</item>
    </plurals>
