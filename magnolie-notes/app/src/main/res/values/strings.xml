    <!-- Einfuhr -->
    <string name="einfuhr_ueberschrift">Take notes over</string>
    <string name="einfuhr_erklaerung">Samsung Notes, Google Keep and the others keep their notes in their own protected storage. Android does not let any app read that directly. Two ways always work: share a note straight into Magnolie Notes, or import the export file those apps write.</string>
    <string name="einfuhr_teilen_titel">Share (works everywhere)</string>
    <string name="einfuhr_teilen_text">Open a note in Samsung Notes, Keep, ColorNote or any other app, tap Share and choose “Magnolie Notes”. Several notes can be shared at once.</string>
    <string name="einfuhr_datei_titel">Import an export file</string>
    <string name="einfuhr_datei_knopf">Choose file …</string>
    <string name="einfuhr_ordner_knopf">Choose folder …</string>
    <string name="einfuhr_formate">Recognised automatically: Google Takeout (.zip / .json / .html), Samsung Notes (.sdocx / .txt / .html), Evernote (.enex), ColorNote backup, Standard Notes (.txt / .json), Simplenote, Joplin and plain Markdown or text folders.</string>
    <string name="einfuhr_laeuft">Reading …</string>
    <plurals name="einfuhr_ergebnis">
        <item quantity="one">%1$d note taken over, %2$d already present.</item>
        <item quantity="other">%1$d notes taken over, %2$d already present.</item>
    </plurals>
