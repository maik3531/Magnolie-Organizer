    <string name="blatt_journal">Recuperación</string><string name="journal_titel">Diario de recuperación</string><string name="journal_hinweis">Instantáneas locales cifradas. Nunca se incluyen en la copia de seguridad en la nube de Android.</string><string name="journal_zuletzt">Última instantánea</string><string name="journal_naechste">Próxima instantánea</string><string name="journal_status">Estado</string><string name="journal_bereit">Listo</string><string name="journal_intervall">Intervalo</string><string name="journal_aus">Desactivado</string><string name="journal_6h">6 horas</string><string name="journal_12h">12 horas</string><string name="journal_taeglich">Diariamente</string><string name="journal_woechentlich">Semanalmente</string><string name="journal_jetzt">Crear instantánea ahora</string><string name="journal_liste">Instantáneas</string><string name="journal_leer">Todavía no hay instantáneas.</string><string name="journal_integritaet">integridad verificada al abrir</string><string name="journal_vorschau">Vista previa</string><string name="journal_restore">Restaurar</string><string name="journal_restore_frage">¿Restaurar «%1$s»? Primero se crea una instantánea previa a la restauración.</string><string name="journal_loeschen_frage">¿Eliminar definitivamente esta instantánea?</string>
