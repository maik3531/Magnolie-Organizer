    <string name="einfuhr_ueberschrift">Importar notas</string>
    <string name="einfuhr_erklaerung">Samsung Notes, Google Keep y las demás guardan sus notas en su propio almacenamiento protegido. Android no permite que ninguna aplicación acceda directamente a él. Hay dos métodos que siempre funcionan: compartir una nota directamente con Magnolie Notes o importar el archivo que exportan esas aplicaciones.</string>
    <string name="einfuhr_teilen_titel">Compartir (funciona siempre)</string>
    <string name="einfuhr_teilen_text">Abra una nota en Samsung Notes, Keep, ColorNote o cualquier otra aplicación, pulse Compartir y elija «Magnolie Notes». Puede compartir varias notas a la vez.</string>
    <string name="einfuhr_datei_titel">Importar un archivo de exportación</string>
    <string name="einfuhr_datei_knopf">Elegir archivo …</string>
    <string name="einfuhr_ordner_knopf">Elegir carpeta …</string>
    <string name="einfuhr_formate">Reconocidos automáticamente: Google Takeout (.zip / .json / .html), Samsung Notes (.sdocx / .txt / .html), Evernote (.enex), copia de seguridad de ColorNote, Standard Notes (.txt / .json), Simplenote, Joplin y carpetas de texto o Markdown sin formato.</string>
    <string name="einfuhr_laeuft">Leyendo …</string>
    <plurals name="einfuhr_ergebnis">
        <item quantity="one">%1$d nota importada, ya presentes: %2$d.</item>
        <item quantity="many">%1$d notas importadas, %2$d ya estaban presentes.</item>
        <item quantity="other">%1$d notas importadas, %2$d ya estaban presentes.</item>
    </plurals>
