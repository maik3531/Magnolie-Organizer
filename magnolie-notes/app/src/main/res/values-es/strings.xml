    <string name="telefon_titel">Conexión telefónica de Magnolie</string><string name="telefon_hinweis">Conexión cifrada independiente para el estado del dispositivo, las solicitudes de marcación y las notificaciones de solo lectura de aplicaciones seleccionadas con precisión. Nunca utiliza emparejamientos ni permisos de Magnolienbaum.</string><string name="telefon_hauptschalter">Activar la conexión telefónica</string><string name="telefon_status">Estado de la conexión</string><string name="telefon_status_aus">Desactivada</string><string name="telefon_status_getrennt">Desconectada</string><string name="telefon_status_gepaart">Emparejada</string><string name="telefon_status_code">Confirmar código</string><string name="telefon_status_fehler">Error</string><string name="telefon_bluetooth_status">Alternativa de datos por Bluetooth disponible</string><string name="telefon_suchen">Buscar el ordenador</string><string name="telefon_verbinden">Conectar con %1$s</string><string name="telefon_code_stimmt">Los códigos coinciden</string><string name="telefon_code_falsch">Los códigos no coinciden</string><string name="telefon_kopplung">Ordenador emparejado</string><string name="telefon_geraetestatus">Permiso para el estado del dispositivo</string><string name="telefon_freigegeben">Concedido</string><string name="telefon_nicht_freigegeben">No concedido</string><string name="telefon_entkoppeln">Eliminar la conexión telefónica</string><string name="telefon_dienst_laeuft">Conexión telefónica activada; esperando al ordenador</string><string name="telefon_dienst_kanal">Conexión telefónica de Magnolie</string><string name="telefon_trennen">Desconectar</string>
    <string name="telefon_bluetooth_fallback">Alternativa de datos por Bluetooth</string><string name="telefon_bluetooth_hinweis">Opcional y desactivada de forma predeterminada. Se sigue prefiriendo Wi-Fi. Primero empareje el ordenador en los ajustes del sistema Android y después seleccione aquí ese dispositivo ya emparejado. La conexión telefónica independiente utiliza su propio protocolo cifrado y nunca el servicio Bluetooth de Magnolienbaum.</string><string name="telefon_bluetooth_systempaarung">Abrir el emparejamiento Bluetooth del sistema</string><string name="telefon_bluetooth_geraete">Elegir dispositivo emparejado</string><string name="telefon_bluetooth_verwenden">Usar %1$s tras la verificación segura</string><string name="telefon_bluetooth_zugeordnet">Dispositivo Bluetooth</string><string name="telefon_bluetooth_berechtigung">No se concedió el permiso de Bluetooth. No se intentó ninguna conexión.</string><string name="telefon_bluetooth_voraussetzung">Primero active y empareje de forma segura la conexión telefónica por Wi-Fi.</string>
    <string name="telefon_benachrichtigungen_titel">Notificaciones seleccionadas</string><string name="telefon_benachrichtigungen_schalter">Reenviar notificaciones de mensajes seleccionadas</string><string name="telefon_benachrichtigungen_hinweis">Solo lectura. Solo se reenvían las notificaciones de mensajes de las aplicaciones seleccionadas con precisión. Nunca se transfieren acciones, respuestas, RemoteInput ni PendingIntent.</string><string name="telefon_systemzugriff_oeffnen">Abrir acceso a notificaciones</string><string name="telefon_systemzugriff_erteilt">Acceso a notificaciones concedido</string><string name="telefon_apps_titel">Aplicaciones permitidas</string>
    <string name="telefon_dienst_sucht">Buscando el ordenador…</string><string name="telefon_dienst_verbindet">Conectando de forma segura con %1$s…</string><string name="telefon_dienst_wlan">Conectado con %1$s por Wi-Fi</string><string name="telefon_dienst_bluetooth">Conectado con %1$s por Bluetooth</string><string name="telefon_dienst_fehler">Error de conexión; volviendo a intentarlo</string>
    <string name="telefon_waehlen_schalter">Permitir solicitudes de marcación</string><string name="telefon_waehlen_hinweis">Desactivado de forma predeterminada e independiente del control de llamadas y de HFP. Una solicitud solo abre el marcador del sistema; allí debe confirmar la llamada.</string><string name="telefon_waehlen_nicht_verfuegbar">No hay ningún marcador del sistema disponible. No se pueden activar las solicitudes de marcación.</string><string name="telefon_waehlen_kanal">Solicitudes de marcación</string><string name="telefon_waehlen_titel">Confirmar la llamada en el marcador del sistema</string>
    <string name="telefon_eingehend_titel">Llamadas entrantes</string><string name="telefon_eingehend_schalter">Compartir el estado de las llamadas entrantes</string><string name="telefon_nummer_schalter">Compartir el número de quien llama cuando esté disponible</string><string name="telefon_annehmen_schalter">Permitir contestar llamadas desde el ordenador</string><string name="telefon_eingehend_hinweis">Cada opción está desactivada de forma predeterminada y solo solicita el permiso de teléfono necesario. El audio de las llamadas nunca se envía mediante Magnolie.</string><string name="telefon_berechtigung_fehlt">No se concedió el permiso de teléfono. La opción permanece desactivada.</string>
