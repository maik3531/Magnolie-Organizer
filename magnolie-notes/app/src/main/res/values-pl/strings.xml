    <string name="blatt_journal">Odzyskiwanie</string><string name="journal_titel">Dziennik odzyskiwania</string><string name="journal_hinweis">Zaszyfrowane migawki lokalne. Nigdy nie trafiają do kopii zapasowej Androida w chmurze.</string><string name="journal_zuletzt">Ostatnia migawka</string><string name="journal_naechste">Następna migawka</string><string name="journal_status">Stan</string><string name="journal_bereit">Gotowe</string><string name="journal_intervall">Interwał</string><string name="journal_aus">Wyłączone</string><string name="journal_6h">6 godzin</string><string name="journal_12h">12 godzin</string><string name="journal_taeglich">Codziennie</string><string name="journal_woechentlich">Co tydzień</string><string name="journal_jetzt">Utwórz migawkę teraz</string><string name="journal_liste">Migawki</string><string name="journal_leer">Nie ma jeszcze migawek.</string><string name="journal_integritaet">integralność sprawdzana przy otwieraniu</string><string name="journal_vorschau">Podgląd</string><string name="journal_restore">Przywróć</string><string name="journal_restore_frage">Przywrócić „%1$s”? Najpierw zostanie utworzona migawka sprzed przywracania.</string><string name="journal_loeschen_frage">Trwale usunąć tę migawkę?</string>
