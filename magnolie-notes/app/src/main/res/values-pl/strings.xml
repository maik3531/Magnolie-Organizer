    <string name="telefon_titel">Połączenie telefoniczne Magnolie</string><string name="telefon_hinweis">Niezależne szyfrowane połączenie do stanu urządzenia, żądań wybierania i powiadomień tylko do odczytu z dokładnie wybranych aplikacji. Nigdy nie używa parowań ani uprawnień Magnolienbaum.</string><string name="telefon_hauptschalter">Włącz połączenie telefoniczne</string><string name="telefon_status">Stan połączenia</string><string name="telefon_status_aus">Wyłączone</string><string name="telefon_status_getrennt">Rozłączone</string><string name="telefon_status_gepaart">Sparowane</string><string name="telefon_status_code">Potwierdź kod</string><string name="telefon_status_fehler">Błąd</string><string name="telefon_bluetooth_status">Dostępne zapasowe połączenie danych Bluetooth</string><string name="telefon_suchen">Wyszukaj komputer</string><string name="telefon_verbinden">Połącz z %1$s</string><string name="telefon_code_stimmt">Kody są zgodne</string><string name="telefon_code_falsch">Kody się różnią</string><string name="telefon_kopplung">Sparowany komputer</string><string name="telefon_geraetestatus">Uprawnienie do stanu urządzenia</string><string name="telefon_freigegeben">Przyznane</string><string name="telefon_nicht_freigegeben">Nieprzyznane</string><string name="telefon_entkoppeln">Usuń połączenie telefoniczne</string><string name="telefon_dienst_laeuft">Połączenie telefoniczne włączone; oczekiwanie na komputer</string><string name="telefon_dienst_kanal">Połączenie telefoniczne Magnolie</string><string name="telefon_trennen">Rozłącz</string>
    <string name="telefon_bluetooth_fallback">Zapasowe połączenie danych Bluetooth</string><string name="telefon_bluetooth_hinweis">Opcjonalne i domyślnie wyłączone. Wi-Fi pozostaje preferowane. Najpierw sparuj komputer w ustawieniach systemu Android, a następnie wybierz tutaj już sparowane urządzenie. Niezależne połączenie telefoniczne używa własnego szyfrowanego uzgadniania i nigdy usługi Bluetooth Magnolienbaum.</string><string name="telefon_bluetooth_systempaarung">Otwórz systemowe parowanie Bluetooth</string><string name="telefon_bluetooth_geraete">Wybierz sparowane urządzenie</string><string name="telefon_bluetooth_verwenden">Użyj %1$s po bezpiecznej weryfikacji</string><string name="telefon_bluetooth_zugeordnet">Urządzenie Bluetooth</string><string name="telefon_bluetooth_berechtigung">Nie przyznano uprawnienia Bluetooth. Nie podjęto próby połączenia.</string><string name="telefon_bluetooth_voraussetzung">Najpierw włącz i bezpiecznie sparuj połączenie telefoniczne przez Wi-Fi.</string>
    <string name="telefon_benachrichtigungen_titel">Wybrane powiadomienia</string><string name="telefon_benachrichtigungen_schalter">Przekazuj wybrane powiadomienia o wiadomościach</string><string name="telefon_benachrichtigungen_hinweis">Tylko do odczytu. Przekazywane są wyłącznie powiadomienia o wiadomościach z dokładnie wybranych aplikacji. Akcje, odpowiedzi, RemoteInput i PendingIntent nigdy nie są przesyłane.</string><string name="telefon_systemzugriff_oeffnen">Otwórz dostęp do powiadomień</string><string name="telefon_systemzugriff_erteilt">Przyznano dostęp do powiadomień</string><string name="telefon_apps_titel">Dozwolone aplikacje</string>
    <string name="telefon_dienst_sucht">Wyszukiwanie komputera…</string><string name="telefon_dienst_verbindet">Bezpieczne łączenie z %1$s…</string><string name="telefon_dienst_wlan">Połączono z %1$s przez Wi-Fi</string><string name="telefon_dienst_bluetooth">Połączono z %1$s przez Bluetooth</string><string name="telefon_dienst_fehler">Połączenie nieudane; ponawianie próby</string>
    <string name="telefon_waehlen_schalter">Zezwalaj na żądania wybierania</string><string name="telefon_waehlen_hinweis">Domyślnie wyłączone i niezależne od sterowania połączeniami oraz HFP. Żądanie tylko otwiera systemowy dialer; połączenie potwierdza się w nim.</string><string name="telefon_waehlen_nicht_verfuegbar">Brak systemowego dialera. Nie można włączyć żądań wybierania.</string><string name="telefon_waehlen_kanal">Żądania wybierania</string><string name="telefon_waehlen_titel">Potwierdź połączenie w systemowym dialerze</string>
    <string name="telefon_eingehend_titel">Połączenia przychodzące</string><string name="telefon_eingehend_schalter">Udostępniaj stan połączenia przychodzącego</string><string name="telefon_nummer_schalter">Udostępniaj numer dzwoniącego, gdy jest dostępny</string><string name="telefon_annehmen_schalter">Zezwalaj na odbieranie połączeń z komputera</string><string name="telefon_eingehend_hinweis">Każda opcja jest domyślnie wyłączona i prosi tylko o wymagane uprawnienie telefonu. Dźwięk połączenia nigdy nie jest wysyłany przez Magnolie.</string><string name="telefon_berechtigung_fehlt">Nie przyznano uprawnienia telefonu. Opcja pozostaje wyłączona.</string>
