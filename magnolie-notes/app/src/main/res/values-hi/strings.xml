    <string name="einfuhr_ueberschrift">नोट्स स्थानांतरित करें</string>
    <string name="einfuhr_erklaerung">Samsung Notes, Google Keep और अन्य ऐप अपने नोट्स को सुरक्षित निजी स्टोरेज में रखते हैं। Android किसी दूसरे ऐप को उन्हें सीधे पढ़ने नहीं देता। दो तरीके हमेशा काम करते हैं: नोट को सीधे Magnolie Notes के साथ साझा करें या उस ऐप की बनाई निर्यात फ़ाइल आयात करें।</string>
    <string name="einfuhr_teilen_titel">साझा करें (हर जगह काम करता है)</string>
    <string name="einfuhr_teilen_text">Samsung Notes, Keep, ColorNote या किसी अन्य ऐप में नोट खोलें, साझा करें पर टैप करें और “Magnolie Notes” चुनें। कई नोट एक साथ साझा किए जा सकते हैं।</string>
    <string name="einfuhr_datei_titel">निर्यात फ़ाइल आयात करें</string>
    <string name="einfuhr_datei_knopf">फ़ाइल चुनें …</string>
    <string name="einfuhr_ordner_knopf">फ़ोल्डर चुनें …</string>
    <string name="einfuhr_formate">अपने-आप पहचाने जाते हैं: Google Takeout (.zip / .json / .html), Samsung Notes (.sdocx / .txt / .html), Evernote (.enex), ColorNote बैकअप, Standard Notes (.txt / .json), Simplenote, Joplin और सामान्य Markdown या टेक्स्ट फ़ोल्डर।</string>
    <string name="einfuhr_laeuft">पढ़ा जा रहा है …</string>
    <plurals name="einfuhr_ergebnis">
        <item quantity="one">%1$d नोट्स स्थानांतरित किए गए, %2$d पहले से मौजूद थे।</item>
        <item quantity="other">%1$d नोट्स स्थानांतरित किए गए, %2$d पहले से मौजूद थे।</item>
