    <string name="device_identifiers_subscription">कोई डिफ़ॉल्ट वॉइस सदस्यता उपलब्ध नहीं है।</string>
    <string name="device_identifiers_unavailable">यह डिवाइस पहचानकर्ता उपलब्ध नहीं है।</string>
