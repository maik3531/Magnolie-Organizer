      "current": [{"id": "a", "uid": "b\u0000c", "icsQuelleId": "a"}],
      "snapshot": [{"id": "b", "uid": "c", "icsQuelleId": "a\u0000b"}],
      "expected": [{"id": "a", "uid": "b\u0000c", "icsQuelleId": "a"}, {"id": "b", "uid": "c", "icsQuelleId": "a\u0000b"}]
    },
    {
      "id": "existing-same-uid-in-two-calendars-restores-without-crash",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "a", "uid": "shared", "icsQuelleId": "calendar-a"}, {"id": "b", "uid": "shared", "icsQuelleId": "calendar-b"}],
      "snapshot": [{"id": "old-b", "uid": "shared", "icsQuelleId": "calendar-b", "notizen": "B"}],
      "expected": [{"id": "a", "uid": "shared", "icsQuelleId": "calendar-a"}, {"id": "b", "uid": "shared", "icsQuelleId": "calendar-b", "notizen": "B"}]
    },
    {
      "id": "duplicate-qualified-uid-uses-unique-local-id",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "a", "uid": "shared", "icsQuelleId": "calendar", "titel": "A"}, {"id": "b", "uid": "shared", "icsQuelleId": "calendar", "titel": "B"}],
      "snapshot": [{"id": "a", "uid": "shared", "icsQuelleId": "calendar", "notizen": "For A"}],
      "expected": [{"id": "a", "uid": "shared", "icsQuelleId": "calendar", "titel": "A", "notizen": "For A"}, {"id": "b", "uid": "shared", "icsQuelleId": "calendar", "titel": "B"}]
    },
    {
      "id": "ambiguous-qualified-uid-retains-snapshot-as-separate-entry",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "a", "uid": "shared", "icsQuelleId": "calendar"}, {"id": "b", "uid": "shared", "icsQuelleId": "calendar"}],
      "snapshot": [{"id": "c", "uid": "shared", "icsQuelleId": "calendar", "notizen": "Keep all three"}],
      "expected": [{"id": "a", "uid": "shared", "icsQuelleId": "calendar"}, {"id": "b", "uid": "shared", "icsQuelleId": "calendar"}, {"id": "c", "uid": "shared", "icsQuelleId": "calendar", "notizen": "Keep all three"}]
    },
    {
      "id": "ambiguous-idless-snapshot-is-retained-once",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "a", "uid": "shared", "icsQuelleId": "calendar"}, {"id": "b", "uid": "shared", "icsQuelleId": "calendar"}],
      "snapshot": [{"uid": "shared", "icsQuelleId": "calendar", "notizen": "Keep original"}],
      "expected": [{"id": "a", "uid": "shared", "icsQuelleId": "calendar"}, {"id": "b", "uid": "shared", "icsQuelleId": "calendar"}, {"uid": "shared", "icsQuelleId": "calendar", "notizen": "Keep original"}]
    },
    {
      "id": "duplicate-local-id-is-not-an-arbitrary-merge-target",
      "area": "notes", "collection": "notizen",
      "current": [{"id": "same", "titel": "A"}, {"id": "same", "titel": "B"}],
      "snapshot": [{"id": "same", "titel": "C", "text": "Keep original"}],
      "expected": [{"id": "same", "titel": "A"}, {"id": "same", "titel": "B"}, {"id": "same", "titel": "C", "text": "Keep original"}]
    },
    {
      "id": "already-present-ambiguous-entry-is-not-duplicated",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "same", "uid": "shared", "titel": "A"}, {"id": "same", "uid": "shared", "titel": "B"}],
      "snapshot": [{"id": "same", "uid": "shared", "titel": "A"}],
      "expected": [{"id": "same", "uid": "shared", "titel": "A"}, {"id": "same", "uid": "shared", "titel": "B"}]
    },
    {
      "id": "snapshot-duplicates-are-retained-in-an-empty-calendar",
      "area": "calendar", "collection": "termine",
      "current": [],
      "snapshot": [{"id": "a", "uid": "shared", "icsQuelleId": "calendar", "titel": "A"}, {"id": "b", "uid": "shared", "icsQuelleId": "calendar", "titel": "B"}],
      "expected": [{"id": "a", "uid": "shared", "icsQuelleId": "calendar", "titel": "A"}, {"id": "b", "uid": "shared", "icsQuelleId": "calendar", "titel": "B"}]
    },
    {
      "id": "snapshot-duplicates-use-local-id-before-filling",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "a", "uid": "shared", "icsQuelleId": "calendar", "titel": "Keep A"}],
      "snapshot": [{"id": "a", "uid": "shared", "icsQuelleId": "calendar", "notizen": "For A"}, {"id": "b", "uid": "shared", "icsQuelleId": "calendar", "titel": "B", "notizen": "For B"}],
      "expected": [{"id": "a", "uid": "shared", "icsQuelleId": "calendar", "titel": "Keep A", "notizen": "For A"}, {"id": "b", "uid": "shared", "icsQuelleId": "calendar", "titel": "B", "notizen": "For B"}]
    },
    {
      "id": "legacy-unqualified-uid-still-fills-missing-fields",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "live", "uid": "same", "titel": "Keep"}],
      "snapshot": [{"id": "saved", "uid": "same", "notizen": "Restore"}],
      "expected": [{"id": "live", "uid": "same", "titel": "Keep", "notizen": "Restore"}]
    },
    {
      "id": "note-uid-still-fills-missing-fields",
      "area": "notes", "collection": "notizen",
      "current": [{"id": "live", "uid": "same", "titel": "Keep", "text": ""}],
      "snapshot": [{"id": "saved", "uid": "same", "text": "Restore"}],
      "expected": [{"id": "live", "uid": "same", "titel": "Keep", "text": "Restore"}]
    },
    {
      "id": "empty-source-falls-through-to-sync-calendar",
      "area": "calendar", "collection": "aufgaben",
      "current": [{"id": "live", "uid": "same", "icsQuelleId": "", "syncKalenderUid": "calendar", "notizen": ""}],
      "snapshot": [{"id": "saved", "uid": "same", "syncKalenderUid": "calendar", "notizen": "Restore"}],
      "expected": [{"id": "live", "uid": "same", "icsQuelleId": "", "syncKalenderUid": "calendar", "notizen": "Restore"}]
    },
    {
      "id": "malformed-source-object-has-conservative-fallback",
