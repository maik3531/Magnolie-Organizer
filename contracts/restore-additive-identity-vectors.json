      "snapshot": [{"id": "unbound", "uid": "old-uid", "syncKalenderUid": "calendar-a", "icsQuelleId": "calendar-a", "notiz": "Recovered", "sync": true, "davHref": "old.ics"}],
      "expected": [{"id": "unbound", "uid": "new-uid", "syncKalenderUid": "", "notiz": "Recovered"}]
    },
    {
      "id": "id-only-record-source-change-keeps-new-transport",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "id-only", "syncKalenderUid": "calendar-b", "notiz": ""}],
      "snapshot": [{"id": "id-only", "syncKalenderUid": "calendar-a", "notiz": "Recovered", "davHref": "old.ics"}],
      "expected": [{"id": "id-only", "syncKalenderUid": "calendar-b", "notiz": "Recovered"}]
    },
    {
      "id": "unique-local-id-beats-unrelated-old-source-uid",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "different-local", "uid": "shared", "syncKalenderUid": "calendar-a", "notiz": ""}, {"id": "moved", "uid": "shared", "syncKalenderUid": "calendar-b", "notiz": ""}],
      "snapshot": [{"id": "moved", "uid": "shared", "syncKalenderUid": "calendar-a", "notiz": "For moved only"}],
      "expected": [{"id": "different-local", "uid": "shared", "syncKalenderUid": "calendar-a", "notiz": ""}, {"id": "moved", "uid": "shared", "syncKalenderUid": "calendar-b", "notiz": "For moved only"}]
    },
    {
      "id": "ambiguous-local-id-after-source-change-holds-restore",
