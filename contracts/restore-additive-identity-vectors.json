      "expected": [{"id": "a", "uid": "same", "kalenderQuelle": "invalid"}, {"id": "b", "uid": "same", "kalenderQuelle": {"id": "calendar"}}]
    },
    {
      "id": "moved-event-keeps-unique-local-id-and-current-transport",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "event-same", "uid": "shared@example.test", "syncKalenderUid": "calendar-b", "titel": "Moved event", "notiz": "", "davHref": "", "davEtag": ""}],
      "snapshot": [{"id": "event-same", "uid": "shared@example.test", "syncKalenderUid": "calendar-a", "titel": "Old event", "notiz": "Recovered note", "davHref": "/calendar-a/old.ics", "davEtag": "old-etag", "syncQuellen": {"calendar-a": {"id": "old.ics", "etag": "old-etag"}}, "kalenderQuelle": {"id": "calendar-a"}, "icsQuelleName": "Old calendar", "icsRoundtrip": ["X-OLD:yes"], "providerMetadaten": {"old": "metadata"}, "sync": true, "geaendert": 123, "unknownProviderWitness": {"old": "keep out"}}],
      "expected": [{"id": "event-same", "uid": "shared@example.test", "syncKalenderUid": "calendar-b", "titel": "Moved event", "notiz": "Recovered note", "davHref": "", "davEtag": ""}]
    },
    {
      "id": "moved-task-keeps-unique-local-id-and-current-source",
      "area": "calendar", "collection": "aufgaben",
      "current": [{"id": "task-same", "uid": "shared", "icsQuelleId": "calendar-b", "titel": "Moved task", "notiz": "", "prio": 1, "erledigt": false}],
      "snapshot": [{"id": "task-same", "uid": "shared", "icsQuelleId": "calendar-a", "titel": "Old task", "notiz": "Task note", "prio": 3, "erledigt": true, "icsElternQuelleId": "calendar-a", "elternUid": "old-parent", "providerMetadaten": {"old": true}}],
      "expected": [{"id": "task-same", "uid": "shared", "icsQuelleId": "calendar-b", "titel": "Moved task", "notiz": "Task note", "prio": 1, "erledigt": false}]
    },
    {
      "id": "local-id-survives-calendar-source-object-change",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "source-object", "uid": "shared", "kalenderQuelle": {"id": "calendar-b"}, "notiz": ""}],
      "snapshot": [{"id": "source-object", "uid": "shared", "kalenderQuelle": {"id": "calendar-a"}, "notiz": "Recovered"}],
      "expected": [{"id": "source-object", "uid": "shared", "kalenderQuelle": {"id": "calendar-b"}, "notiz": "Recovered"}]
    },
    {
      "id": "local-id-survives-source-removal-and-new-uid",
      "area": "calendar", "collection": "termine",
