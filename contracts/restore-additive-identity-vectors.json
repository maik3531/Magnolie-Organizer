      "current": [{"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-b", "notiz": ""}, {"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-c", "notiz": ""}],
      "snapshot": [{"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-a", "notiz": "Do not guess"}],
      "error": "ambiguous-local-id"
    },
    {
      "id": "ambiguous-local-id-snapshot-cannot-create-new-duplicates",
      "area": "calendar", "collection": "termine",
      "current": [],
      "snapshot": [{"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-b", "notiz": ""}, {"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-c", "notiz": ""}],
      "error": "ambiguous-local-id"
    },
    {
      "id": "ambiguous-local-id-snapshot-cannot-pick-one-current-record",
      "area": "calendar", "collection": "aufgaben",
      "current": [{"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-a", "notiz": "Do not guess"}],
      "snapshot": [{"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-b", "notiz": ""}, {"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-c", "notiz": ""}],
      "error": "ambiguous-local-id"
    },
    {
      "id": "exact-existing-ambiguous-local-id-remains-idempotent",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-b", "notiz": ""}, {"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-c", "notiz": ""}],
      "snapshot": [{"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-b", "notiz": ""}],
      "expected": [{"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-b", "notiz": ""}, {"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-c", "notiz": ""}]
    },
    {
      "id": "same-scope-disambiguates-preexisting-local-id-collision",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-b", "notiz": ""}, {"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-c", "notiz": ""}],
      "snapshot": [{"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-b", "notiz": "For B"}],
      "expected": [{"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-b", "notiz": "For B"}, {"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-c", "notiz": ""}]
    },
    {
      "id": "identical-snapshot-local-id-copies-restore-only-once",
      "area": "calendar", "collection": "termine",
      "current": [],
      "snapshot": [{"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-b", "notiz": ""}, {"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-b", "notiz": ""}],
      "expected": [{"id": "ambiguous", "uid": "shared", "syncKalenderUid": "calendar-b", "notiz": ""}]
    },
    {
      "id": "source-change-does-not-invent-empty-content-fields",
      "area": "calendar", "collection": "aufgaben",
      "current": [{"id": "empty", "uid": "same", "syncKalenderUid": "calendar-b"}],
      "snapshot": [{"id": "empty", "uid": "same", "syncKalenderUid": "calendar-a", "notiz": "", "alarme": [], "organisator": {}}],
      "expected": [{"id": "empty", "uid": "same", "syncKalenderUid": "calendar-b"}]
    },
    {
      "id": "changed-secondary-binding-does-not-restore-old-transport",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "same", "uid": "shared", "icsQuelleId": "import-source", "syncKalenderUid": "calendar-b", "notiz": "", "davHref": ""}],
      "snapshot": [{"id": "same", "uid": "shared", "icsQuelleId": "import-source", "syncKalenderUid": "calendar-a", "notiz": "Recovered", "davHref": "/calendar-a/old.ics", "syncQuellen": {"calendar-a": {"id": "old"}}}],
      "expected": [{"id": "same", "uid": "shared", "icsQuelleId": "import-source", "syncKalenderUid": "calendar-b", "notiz": "Recovered", "davHref": ""}]
    }
  ]
}
