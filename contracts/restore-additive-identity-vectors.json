{
  "version": 1,
  "cases": [
    {
      "id": "events-with-the-same-uid-in-different-ics-calendars",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "live-a", "uid": "shared@example.test", "icsQuelleId": "calendar-a", "titel": "A"}],
      "snapshot": [{"id": "saved-b", "uid": "shared@example.test", "icsQuelleId": "calendar-b", "titel": "B"}],
      "expected": [{"id": "live-a", "uid": "shared@example.test", "icsQuelleId": "calendar-a", "titel": "A"}, {"id": "saved-b", "uid": "shared@example.test", "icsQuelleId": "calendar-b", "titel": "B"}]
    },
    {
      "id": "tasks-with-the-same-uid-in-different-sync-calendars",
      "area": "calendar", "collection": "aufgaben",
      "current": [{"id": "live-a", "uid": "shared", "syncKalenderUid": "calendar-a", "titel": "A"}],
      "snapshot": [{"id": "saved-b", "uid": "shared", "syncKalenderUid": "calendar-b", "titel": "B"}],
      "expected": [{"id": "live-a", "uid": "shared", "syncKalenderUid": "calendar-a", "titel": "A"}, {"id": "saved-b", "uid": "shared", "syncKalenderUid": "calendar-b", "titel": "B"}]
    },
    {
      "id": "calendar-source-object-fallback",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "a", "uid": "shared", "kalenderQuelle": {"id": "calendar-a"}}],
      "snapshot": [{"id": "b", "uid": "shared", "kalenderQuelle": {"id": "calendar-b"}}],
      "expected": [{"id": "a", "uid": "shared", "kalenderQuelle": {"id": "calendar-a"}}, {"id": "b", "uid": "shared", "kalenderQuelle": {"id": "calendar-b"}}]
    },
    {
      "id": "ics-source-takes-precedence-over-sync-source",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "a", "uid": "shared", "icsQuelleId": "ics-a", "syncKalenderUid": "same-sync"}],
      "snapshot": [{"id": "b", "uid": "shared", "icsQuelleId": "ics-b", "syncKalenderUid": "same-sync"}],
      "expected": [{"id": "a", "uid": "shared", "icsQuelleId": "ics-a", "syncKalenderUid": "same-sync"}, {"id": "b", "uid": "shared", "icsQuelleId": "ics-b", "syncKalenderUid": "same-sync"}]
    },
    {
      "id": "same-source-and-uid-fill-only-empty-fields",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "live", "uid": "same", "icsQuelleId": "calendar", "titel": "Keep", "notizen": "", "erledigt": false, "prioritaet": 0}],
      "snapshot": [{"id": "saved", "uid": "same", "icsQuelleId": "calendar", "titel": "Old", "notizen": "Restore", "erledigt": true, "prioritaet": 3}],
      "expected": [{"id": "live", "uid": "same", "icsQuelleId": "calendar", "titel": "Keep", "notizen": "Restore", "erledigt": false, "prioritaet": 0}]
    },
    {
      "id": "missing-source-does-not-match-a-qualified-uid",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "a", "uid": "shared"}],
      "snapshot": [{"id": "b", "uid": "shared", "syncKalenderUid": "calendar"}],
      "expected": [{"id": "a", "uid": "shared"}, {"id": "b", "uid": "shared", "syncKalenderUid": "calendar"}]
    },
    {
      "id": "empty-uid-falls-back-to-note-id",
      "area": "notes", "collection": "notizen",
      "current": [{"id": "note-1", "uid": "", "titel": "Keep", "text": ""}],
      "snapshot": [{"id": "note-1", "uid": "", "titel": "Old", "text": "Restore"}],
      "expected": [{"id": "note-1", "uid": "", "titel": "Keep", "text": "Restore"}]
    },
    {
      "id": "null-uid-falls-back-to-event-id",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "event-1", "uid": null, "titel": "Keep"}],
      "snapshot": [{"id": "event-1", "uid": null, "notizen": "Restore"}],
      "expected": [{"id": "event-1", "uid": null, "titel": "Keep", "notizen": "Restore"}]
    },
    {
      "id": "legacy-id-only-contacts",
      "area": "contacts", "collection": "kontakte",
      "current": [{"id": "contact-1", "vorname": "Keep"}],
      "snapshot": [{"id": "contact-1", "vorname": "Old", "nachname": "Restore"}],
      "expected": [{"id": "contact-1", "vorname": "Keep", "nachname": "Restore"}]
    },
    {
      "id": "external-uid-cannot-collide-with-local-id",
      "area": "calendar", "collection": "termine",
      "current": [{"id": "local", "uid": "same", "titel": "UID"}],
      "snapshot": [{"id": "same", "titel": "ID"}],
      "expected": [{"id": "local", "uid": "same", "titel": "UID"}, {"id": "same", "titel": "ID"}]
    },
    {
      "id": "structured-source-and-uid-key-has-no-separator-collision",
