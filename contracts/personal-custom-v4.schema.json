{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal Custom mirror V4 data messages",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/batch"}],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^custom:[0-9a-f]{64}$"},
    "sourceItem": {"type": "string", "minLength": 1, "maxLength": 640, "pattern": "^[^\u0000-\u001f\u007f]+$", "description": "Additional wire limit: 640 UTF-8 bytes, well-formed Unicode, no normalization."},
    "date": {"oneOf": [{"const": ""}, {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}]},
    "recurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["frequency", "interval", "until", "dates", "ordinal", "weekday"],
      "properties": {
        "frequency": {"enum": ["none", "daily", "weekly", "monthly", "yearly", "custom"]},
        "interval": {"type": "integer", "minimum": 1, "maximum": 3660},
        "until": {"$ref": "#/$defs/date"},
        "dates": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}},
        "ordinal": {"type": "integer", "minimum": -1, "maximum": 4},
        "weekday": {"type": "integer", "minimum": 0, "maximum": 7}
      }
    },
    "value": {
      "type": "object", "additionalProperties": false,
      "required": ["module_id", "module_title", "title", "note", "date", "time", "timezone", "completed", "module_reminders", "item_reminder", "lead_minutes", "default_minute", "recurrence"],
      "properties": {
        "module_id": {"$ref": "#/$defs/sourceItem"},
        "module_title": {"type": "string", "maxLength": 480},
        "title": {"type": "string", "maxLength": 1200},
        "note": {"type": "string", "maxLength": 20000},
        "date": {"$ref": "#/$defs/date"},
        "time": {"type": "string", "pattern": "^(|(?:[01][0-9]|2[0-3]):[0-5][0-9])$"},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z][A-Za-z0-9_+.-]*(?:/[A-Za-z0-9_+.-]+)*$"},
        "completed": {"type": "boolean"}, "module_reminders": {"type": "boolean"}, "item_reminder": {"type": "boolean"},
        "lead_minutes": {"type": "integer", "minimum": 0, "maximum": 525600},
        "default_minute": {"type": "integer", "minimum": 0, "maximum": 1439},
        "recurrence": {"$ref": "#/$defs/recurrence"}
      },
      "description": "Text maxima are UTF-8 byte limits on the wire. timezone must be a supported case-sensitive IANA tzdb name or backward alias, not a Windows ID, synthetic offset, system/localtime or posix/right/SystemV name; syntax alone is insufficient (personal-custom-codec-v4.md). textItemId, text modules and dereferenced linked text are forbidden."
    },
    "upsert": {
      "type": "object", "additionalProperties": false, "required": ["id", "item_id", "kind", "hash", "value"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "item_id": {"$ref": "#/$defs/sourceItem"}, "kind": {"enum": ["task", "appointment"]}, "hash": {"$ref": "#/$defs/hash"}, "value": {"$ref": "#/$defs/value"}}
    },
    "deletion": {
      "type": "object", "additionalProperties": false, "required": ["id", "item_id", "prior_hash"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "item_id": {"$ref": "#/$defs/sourceItem"}, "prior_hash": {"$ref": "#/$defs/hash"}}
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "sender_epoch", "receiver_epoch", "sender_revision", "receiver_revision", "trigger"],
      "properties": {
        "format": {"const": 4}, "sender_epoch": {"$ref": "#/$defs/uuid"}, "receiver_epoch": {"$ref": "#/$defs/uuid"},
        "sender_revision": {"$ref": "#/$defs/revision"}, "receiver_revision": {"$ref": "#/$defs/revision"}, "trigger": {"enum": ["manual", "auto_wifi"]}
      }
    },
    "batch": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "sender_epoch", "receiver_epoch", "sender_revision", "receiver_revision", "trigger", "source_id", "revision", "upserts", "deletions"],
      "properties": {
        "format": {"const": 4}, "sender_epoch": {"$ref": "#/$defs/uuid"}, "receiver_epoch": {"$ref": "#/$defs/uuid"},
        "sender_revision": {"$ref": "#/$defs/revision"}, "receiver_revision": {"$ref": "#/$defs/revision"}, "trigger": {"enum": ["manual", "auto_wifi"]},
        "source_id": {"$ref": "#/$defs/uuid"}, "revision": {"$ref": "#/$defs/revision"},
        "upserts": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/upsert"}},
        "deletions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/deletion"}}
      },
      "description": "Runtime checks additionally require 1..32 combined unique identities, <=192 KiB canonical body, matching full source-qualified IDs and SHA-256 hashes."
    }
  }
}
