diff --git a/Magnolie-Organizer-macOS-Beta/Sources/BetaCore/FileImportProtocol.swift b/Magnolie-Organizer-macOS-Beta/Sources/BetaCore/FileImportProtocol.swift
new file mode 100644
index 0000000000000000000000000000000000000000..cc9b01fdd806d75e2fae5d38cbee18f9b4f2384c
--- /dev/null
+++ b/Magnolie-Organizer-macOS-Beta/Sources/BetaCore/FileImportProtocol.swift
@@ -0,0 +1,86 @@
+import Foundation
+import CoreFoundation
+import CryptoKit
+
+/// #785: one framed input and one bounded response. Only native-selected bytes
+/// are passed to the helper. Neither side receives an arbitrary source path.
+public enum FileImportProtocol {
+    public static let maximumInputBytes = 32 * 1024 * 1024
+    public static let maximumHeaderBytes = 8192
+    public static let maximumOutputBytes = 96 * 1024 * 1024
+    public static let formats: Set<String> = ["ics", "lotus", "vcf", "claws", "ldif", "muell"]
+
+    public struct Input {
+        public let bytes: Data, header: Data
+        public let format: String, name: String, sourceSHA256: String
+        public init(bytes: Data, format: String, name: String, language: String, timeZone: String, homeCountry: String) throws {
+            guard !bytes.isEmpty, bytes.count <= maximumInputBytes, formats.contains(format),
+                  !name.isEmpty, name.utf8.count <= 1024, name != ".", name != "..",
+                  !name.contains("/"), !name.contains("\\"),
+                  name.unicodeScalars.allSatisfy({ $0.value >= 32 && $0.value != 127 }),
+                  language.range(of: "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$", options: .regularExpression) != nil,
+                  language.utf8.count <= 64, !timeZone.isEmpty, timeZone.utf8.count <= 256,
+                  homeCountry.range(of: "^[A-Z]{2}$", options: .regularExpression) != nil else {
+                throw BetaError("Invalid file import request.")
+            }
+            self.bytes = bytes; self.format = format; self.name = name
+            sourceSHA256 = Self.digest(bytes)
+            let fields: [String: Any] = ["schema": 1, "format": format, "name": name, "language": language,
+                "timeZone": timeZone, "homeCountry": homeCountry, "byteLength": bytes.count, "sha256": sourceSHA256]
+            var encoded = try JSONSerialization.data(withJSONObject: fields, options: [.sortedKeys])
+            encoded.append(10)
+            guard encoded.count <= maximumHeaderBytes else { throw BetaError("File import header is too large.") }
+            header = encoded
+        }
+        private static func digest(_ data: Data) -> String { FileImportProtocol.digest(data) }
+    }
+
+    public static func digest(_ data: Data) -> String {
+        SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+    }
+    private static func integer(_ value: Any?, equals expected: Int) -> Bool {
+        guard let number = value as? NSNumber, CFGetTypeID(number) != CFBooleanGetTypeID() else { return false }
+        return number.doubleValue == Double(expected)
+    }
+
+    public static func response(_ bytes: Data, input: Input, manifestSHA256: String) throws -> [String: Any] {
+        guard !bytes.isEmpty, bytes.count <= maximumOutputBytes, bytes.last == 10,
+              let text = String(data: bytes, encoding: .utf8),
+              manifestSHA256.range(of: "^[a-f0-9]{64}$", options: .regularExpression) != nil else {
+            throw BetaError("The import helper returned an invalid response.")
+        }
+        let value = try Document.object(text)
+        guard integer(value["schema"], equals: 1),
+              let ok = value["ok"] as? NSNumber, CFGetTypeID(ok) == CFBooleanGetTypeID() else {
+            throw BetaError("The import helper response schema is invalid.")
+        }
+        if !ok.boolValue {
+            guard Set(value.keys) == Set(["schema", "ok", "sourceSHA256", "parserManifestSHA256", "error"]),
+                  value["sourceSHA256"] is NSNull || value["sourceSHA256"] as? String == input.sourceSHA256,
+                  value["parserManifestSHA256"] is NSNull || value["parserManifestSHA256"] as? String == manifestSHA256,
+                  let error = value["error"] as? [String: Any], Set(error.keys) == Set(["code", "message"]),
+                  let code = error["code"] as? String, !code.isEmpty, code.utf8.count <= 128,
+                  let message = error["message"] as? String, !message.isEmpty, message.utf8.count <= 4096 else {
+                throw BetaError("The import helper returned an invalid error.")
+            }
+            throw BetaError(message)
+        }
+        guard Set(value.keys) == Set(["schema", "ok", "format", "name", "sourceSHA256", "parserManifestSHA256", "result"]),
+              value["sourceSHA256"] as? String == input.sourceSHA256,
+              value["parserManifestSHA256"] as? String == manifestSHA256,
+              value["format"] as? String == input.format,
+              let name = value["name"] as? String, OpaqueUTF8Identity(name) == OpaqueUTF8Identity(input.name),
+              let result = value["result"] as? [String: Any], result["fehler"] == nil else {
+            throw BetaError("The import result does not belong to the selected file and parser.")
+        }
+        var records = 0
+        for collection in ["termine", "aufgaben", "kontakte", "notizen", "jahrestage", "geburtstage"] {
+            if let value = result[collection] {
+                guard let list = value as? [[String: Any]] else { throw BetaError("Invalid import collection.") }
+                records += list.count
+            }
+        }
+        guard records <= 100_000 else { throw BetaError("The import exceeds the supported record limit.") }
+        return result
+    }
+}
diff --git a/Magnolie-Organizer-macOS-Beta/Sources/MacBeta/FileImportHost.swift b/Magnolie-Organizer-macOS-Beta/Sources/MacBeta/FileImportHost.swift
new file mode 100644
index 0000000000000000000000000000000000000000..e30afbb250d005850df1b7813b1392cba231bc7e
--- /dev/null
+++ b/Magnolie-Organizer-macOS-Beta/Sources/MacBeta/FileImportHost.swift
@@ -0,0 +1,72 @@
+#if os(macOS)
+import AppKit
+import BetaCore
+
+/// #785: native selection -> frozen current parser -> shared merge -> Save ACK.
+/// A parser response alone never counts as a saved import.
+@MainActor final class FileImportHost {
+    private var busy = false
+    var active: Bool { busy }
+
+    func begin(format: String, wasteToken: String?, bundle: URL,
+               isCurrent: @escaping () -> Bool, settings: @escaping () throws -> [String: String],
+               prepare: @escaping () async throws -> [String: Any],
+               commit: @escaping ([String: Any], String) async throws -> [String: Any],
+               cancel: @escaping (String) async -> Void,
+               translate: @escaping (String) -> String) async {
+        guard !busy, isCurrent(), FileImportProtocol.formats.contains(format) else { return }
+        busy = true
+        defer { busy = false }
+        var token = ""
+        do {
+            let prepared = try await prepare()
+            if prepared["cancelled"] as? Bool == true { return }
+            guard isCurrent(), let selectedToken = prepared["token"] as? String, !selectedToken.isEmpty else {
+                throw BetaError("The import document is no longer available.")
+            }
+            token = selectedToken
+            let context = try settings()
+            guard let language = context["language"], let timeZone = context["timeZone"],
+                  let homeCountry = context["homeCountry"] else {
+                throw BetaError("Invalid file import request.")
+            }
+            let types = ["ics": ["ics", "vcs", "lcs", "zip"], "lotus": ["or6", "csv", "zip"],
+                         "vcf": ["vcf", "csv", "zip"], "claws": ["xml", "ldif", "ldi", "zip"],
+                         "ldif": ["ldif", "ldi", "zip"], "muell": ["ics", "csv"]]
+            let panel = NSOpenPanel()
+            panel.title = translate("Import")
+            panel.canChooseDirectories = false; panel.allowsMultipleSelection = false
+            panel.allowedFileTypes = types[format]
+            guard panel.runModal() == .OK, let url = panel.url else { await cancel(token); return }
+            guard isCurrent() else { throw BetaError("The document changed. Start the file import again.") }
+            let scoped = url.startAccessingSecurityScopedResource()
+            defer { if scoped { url.stopAccessingSecurityScopedResource() } }
+            let response: [String: Any] = try await withCheckedThrowingContinuation { continuation in
+                DispatchQueue.global(qos: .userInitiated).async {
+                    do {
+                        let bytes = try FileImportProcess.readSelected(url)
+                        let request = try FileImportProtocol.Input(bytes: bytes, format: format, name: url.lastPathComponent,
+                            language: language, timeZone: timeZone, homeCountry: homeCountry)
+                        var result = try FileImportProcess.run(request, bundle: bundle)
+                        if format == "muell" {
+                            guard let wasteToken, !wasteToken.isEmpty else { throw BetaError("Missing waste-import operation.") }
+                            result["art"] = "muell"; result["muellToken"] = wasteToken
+                        }
+                        continuation.resume(returning: result)
+                    } catch { continuation.resume(throwing: error) }
+                }
+            }
+            guard isCurrent(), try settings() == context else {
+                throw BetaError("The document or regional settings changed. Start the file import again.")
+            }
+            let receipt = try await commit(response, token)
+            guard receipt["ok"] as? Bool == true else { throw BetaError("The import did not complete.") }
+        } catch {
+            if !token.isEmpty { await cancel(token) }
+            let alert = NSAlert(); alert.messageText = translate("Import failed")
+            alert.informativeText = translate(error.localizedDescription)
+            alert.runModal()
+        }
+    }
+}
+#endif
diff --git a/Magnolie-Organizer-macOS-Beta/Sources/MacBeta/FileImportProcess.swift b/Magnolie-Organizer-macOS-Beta/Sources/MacBeta/FileImportProcess.swift
new file mode 100644
index 0000000000000000000000000000000000000000..57add63e4b07ffd30b9a99e2c6eebdb7dfa35a2d
--- /dev/null
+++ b/Magnolie-Organizer-macOS-Beta/Sources/MacBeta/FileImportProcess.swift
@@ -0,0 +1,140 @@
+#if os(macOS)
+import Foundation
+import Darwin
+import BetaCore
+
+/// One process per file, no shell, no inherited Python paths, no output on disk.
+/// Call on a worker queue. The stdin descriptor is unlinked before any source
+/// bytes are written, avoiding both a visible plaintext copy and pipe deadlocks.
+enum FileImportProcess {
+    private final class Output {
+        private let lock = NSLock()
+        private var bytes = Data()
+        private var failed = false
+        func append(_ block: Data, limit: Int, retain: Bool) -> Bool {
+            lock.lock(); defer { lock.unlock() }
+            guard !failed, block.count <= limit - bytes.count else { failed = true; return false }
+            if retain { bytes.append(block) }
+            else { bytes.append(contentsOf: repeatElement(UInt8(0), count: block.count)) }
+            return true
+        }
+        func result() throws -> Data {
+            lock.lock(); defer { lock.unlock() }
+            guard !failed else { throw BetaError("The import helper exceeded its output limit.") }
+            return bytes
+        }
+    }
+
+    private static func fixedFile(_ root: URL, _ relative: String) throws -> URL {
+        let canonicalRoot = root.resolvingSymlinksInPath().standardizedFileURL
+        let file = canonicalRoot.appendingPathComponent(relative).standardizedFileURL
+        guard file.resolvingSymlinksInPath() == file, file.path.hasPrefix(canonicalRoot.path + "/"),
+              (try file.resourceValues(forKeys: [.isRegularFileKey])).isRegularFile == true else {
+            throw BetaError("The private import runtime is missing or linked outside the app.")
+        }
+        return file
+    }
+
+    static func readSelected(_ url: URL) throws -> Data {
+        guard url.isFileURL, url.host == nil || url.host == "" else { throw BetaError("A local selected file is required.") }
+        let descriptor = open(url.path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK)
+        guard descriptor >= 0 else { throw BetaError("The selected file is unavailable or is a symbolic link.") }
+        let handle = FileHandle(fileDescriptor: descriptor, closeOnDealloc: true)
+        defer { try? handle.close() }
+        var before = stat(), after = stat()
+        guard fstat(descriptor, &before) == 0, before.st_mode & mode_t(S_IFMT) == mode_t(S_IFREG),
+              before.st_size > 0, before.st_size <= Int64(FileImportProtocol.maximumInputBytes) else {
+            throw BetaError("Select a regular import file no larger than 32 MiB.")
+        }
+        var bytes = Data()
+        while true {
+            let block = try handle.read(upToCount: min(65536, FileImportProtocol.maximumInputBytes - bytes.count + 1)) ?? Data()
+            if block.isEmpty { break }
+            guard bytes.count + block.count <= FileImportProtocol.maximumInputBytes else { throw BetaError("The selected file grew beyond the import limit.") }
+            bytes.append(block)
+        }
+        guard fstat(descriptor, &after) == 0, before.st_dev == after.st_dev, before.st_ino == after.st_ino,
+              before.st_size == after.st_size, Int64(bytes.count) == before.st_size,
+              before.st_mtimespec.tv_sec == after.st_mtimespec.tv_sec,
+              before.st_mtimespec.tv_nsec == after.st_mtimespec.tv_nsec,
+              before.st_ctimespec.tv_sec == after.st_ctimespec.tv_sec,
+              before.st_ctimespec.tv_nsec == after.st_ctimespec.tv_nsec else {
+            throw BetaError("The selected file changed while it was read.")
+        }
+        return bytes
+    }
+
+    static func run(_ input: FileImportProtocol.Input, bundle: URL) throws -> [String: Any] {
+        let contents = bundle.resolvingSymlinksInPath().appendingPathComponent("Contents")
+        let executable = try fixedFile(contents, "Helpers/ImportPython/bin/python3.15")
+        let helper = try fixedFile(contents, "Resources/ImportHelper/helper.py")
+        let manifest = try fixedFile(contents, "Resources/ImportHelper/manifest.json")
+        let manifestBytes = try Data(contentsOf: manifest, options: [.mappedIfSafe])
+        guard manifestBytes.count <= 1024 * 1024 else { throw BetaError("Invalid import manifest size.") }
+        let manifestHash = FileImportProtocol.digest(manifestBytes)
+        var template = Array((NSTemporaryDirectory() + "magnolie-import-XXXXXX").utf8CString)
+        let descriptor = template.withUnsafeMutableBufferPointer { mkstemp($0.baseAddress!) }
+        guard descriptor >= 0 else { throw BetaError("Cannot prepare the private import stream.") }
+        let standardInput = FileHandle(fileDescriptor: descriptor, closeOnDealloc: true)
+        defer { try? standardInput.close() }
+        guard template.withUnsafeBufferPointer({ unlink($0.baseAddress!) }) == 0 else {
+            throw BetaError("Cannot unlink the private import stream.")
+        }
+        guard fcntl(descriptor, F_SETFD, FD_CLOEXEC) == 0 else {
+            throw BetaError("Cannot prepare the private import stream.")
+        }
+        try standardInput.write(contentsOf: input.header)
+        try standardInput.write(contentsOf: input.bytes)
+        try standardInput.seek(toOffset: 0)
+
+        let process = Process(), stdout = Pipe(), stderr = Pipe()
+        process.executableURL = executable
+        process.arguments = ["-I", "-S", "-B", helper.path]
+        process.environment = ["PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"]
+        process.currentDirectoryURL = helper.deletingLastPathComponent()
+        process.standardInput = standardInput; process.standardOutput = stdout; process.standardError = stderr
+        let ended = DispatchSemaphore(value: 0)
+        process.terminationHandler = { _ in ended.signal() }
+        let output = Output(), diagnostics = Output(), readers = DispatchGroup()
+        try process.run()
+        for (handle, accumulator, limit, retain) in [
+            (stdout.fileHandleForReading, output, FileImportProtocol.maximumOutputBytes, true),
+            (stderr.fileHandleForReading, diagnostics, 65536, false)
+        ] {
+            readers.enter()
+            DispatchQueue.global(qos: .userInitiated).async {
+                defer { try? handle.close(); readers.leave() }
+                do {
+                    while let block = try handle.read(upToCount: 65536), !block.isEmpty {
+                        if !accumulator.append(block, limit: limit, retain: retain) {
+                            if process.isRunning { process.terminate() }
+                            return
+                        }
+                    }
+                } catch {
+                    _ = accumulator.append(Data([0]), limit: 0, retain: false)
+                    if process.isRunning { process.terminate() }
+                }
+            }
+        }
+        if ended.wait(timeout: .now() + 60) == .timedOut {
+            if process.isRunning { process.terminate() }
+            if ended.wait(timeout: .now() + 1) == .timedOut, process.isRunning { kill(process.processIdentifier, SIGKILL) }
+            _ = ended.wait(timeout: .now() + 2)
+            _ = readers.wait(timeout: .now() + 2)
+            throw BetaError("The file import exceeded its time limit. No import result was applied.")
+        }
+        guard readers.wait(timeout: .now() + 2) == .success else {
+            throw BetaError("The import helper did not close its response streams.")
+        }
+        _ = try diagnostics.result() // Never expose source-containing stderr.
+        let bytes = try output.result()
+        guard process.terminationReason == .exit, process.terminationStatus == 0 else {
+            // A well-formed helper error may explain unsupported/corrupt data.
+            _ = try FileImportProtocol.response(bytes, input: input, manifestSHA256: manifestHash)
+            throw BetaError("The import helper exited without a successful result.")
+        }
+        return try FileImportProtocol.response(bytes, input: input, manifestSHA256: manifestHash)
+    }
+}
+#endif
