    <string name="blatt_journal">Recuperação</string><string name="journal_titel">Diário de recuperação</string><string name="journal_hinweis">Instantâneos locais encriptados. Nunca entram na cópia de segurança na nuvem do Android.</string><string name="journal_zuletzt">Último instantâneo</string><string name="journal_naechste">Próximo instantâneo</string><string name="journal_status">Estado</string><string name="journal_bereit">Pronto</string><string name="journal_intervall">Intervalo</string><string name="journal_aus">Desativado</string><string name="journal_6h">6 horas</string><string name="journal_12h">12 horas</string><string name="journal_taeglich">Diariamente</string><string name="journal_woechentlich">Semanalmente</string><string name="journal_jetzt">Criar instantâneo agora</string><string name="journal_liste">Instantâneos</string><string name="journal_leer">Ainda não há instantâneos.</string><string name="journal_integritaet">integridade verificada ao abrir</string><string name="journal_vorschau">Pré-visualização</string><string name="journal_restore">Restaurar</string><string name="journal_restore_frage">Restaurar “%1$s”? Primeiro será criado um instantâneo anterior ao restauro.</string><string name="journal_loeschen_frage">Eliminar definitivamente este instantâneo?</string>
