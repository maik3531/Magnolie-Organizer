    <string name="telefon_titel">Ligação telefónica Magnolie</string><string name="telefon_hinweis">Ligação encriptada independente para estado do dispositivo, pedidos de marcação e notificações só de leitura das aplicações selecionadas. Nunca usa emparelhamentos nem permissões do Magnolienbaum.</string><string name="telefon_hauptschalter">Ativar ligação telefónica</string><string name="telefon_status">Estado da ligação</string><string name="telefon_status_aus">Desativada</string><string name="telefon_status_getrennt">Desligada</string><string name="telefon_status_gepaart">Emparelhada</string><string name="telefon_status_code">Confirmar código</string><string name="telefon_status_fehler">Erro</string><string name="telefon_bluetooth_status">Alternativa de dados Bluetooth disponível</string><string name="telefon_suchen">Procurar computador</string><string name="telefon_verbinden">Ligar a %1$s</string><string name="telefon_code_stimmt">Os códigos coincidem</string><string name="telefon_code_falsch">Os códigos diferem</string><string name="telefon_kopplung">Computador emparelhado</string><string name="telefon_geraetestatus">Permissão do estado do dispositivo</string><string name="telefon_freigegeben">Concedida</string><string name="telefon_nicht_freigegeben">Não concedida</string><string name="telefon_entkoppeln">Remover ligação telefónica</string><string name="telefon_dienst_laeuft">Ligação telefónica ativa; a aguardar o computador</string><string name="telefon_dienst_kanal">Ligação telefónica Magnolie</string><string name="telefon_trennen">Desligar</string>
    <string name="telefon_bluetooth_fallback">Alternativa de dados Bluetooth</string><string name="telefon_bluetooth_hinweis">Opcional e desativada por predefinição. O Wi-Fi continua a ser preferido. Primeiro emparelhe o computador nas definições do sistema Android e depois selecione aqui o dispositivo já emparelhado. A ligação telefónica independente usa o seu próprio protocolo encriptado e nunca o serviço Bluetooth do Magnolienbaum.</string><string name="telefon_bluetooth_systempaarung">Abrir emparelhamento Bluetooth do sistema</string><string name="telefon_bluetooth_geraete">Escolher dispositivo emparelhado</string><string name="telefon_bluetooth_verwenden">Usar %1$s após verificação segura</string><string name="telefon_bluetooth_zugeordnet">Dispositivo Bluetooth</string><string name="telefon_bluetooth_berechtigung">A permissão Bluetooth não foi concedida. Não foi tentada qualquer ligação.</string><string name="telefon_bluetooth_voraussetzung">Primeiro ative e emparelhe com segurança a ligação telefónica através de Wi-Fi.</string>
    <string name="telefon_benachrichtigungen_titel">Notificações selecionadas</string><string name="telefon_benachrichtigungen_schalter">Reencaminhar notificações de mensagens selecionadas</string><string name="telefon_benachrichtigungen_hinweis">Só de leitura. Apenas são reencaminhadas notificações de mensagens das aplicações selecionadas. Ações, respostas, RemoteInput e PendingIntent nunca são transferidos.</string><string name="telefon_systemzugriff_oeffnen">Abrir acesso às notificações</string><string name="telefon_systemzugriff_erteilt">Acesso às notificações concedido</string><string name="telefon_apps_titel">Aplicações permitidas</string>
    <string name="telefon_dienst_sucht">A procurar o computador…</string><string name="telefon_dienst_verbindet">A ligar com segurança a %1$s…</string><string name="telefon_dienst_wlan">Ligado a %1$s por Wi-Fi</string><string name="telefon_dienst_bluetooth">Ligado a %1$s por Bluetooth</string><string name="telefon_dienst_fehler">A ligação falhou; nova tentativa</string>
    <string name="telefon_waehlen_schalter">Permitir pedidos de marcação</string><string name="telefon_waehlen_hinweis">Desativado por predefinição e independente do controlo de chamadas e do HFP. Um pedido apenas abre o marcador do sistema; confirme aí a chamada.</string><string name="telefon_waehlen_nicht_verfuegbar">Não está disponível um marcador do sistema. Os pedidos de marcação não podem ser ativados.</string><string name="telefon_waehlen_kanal">Pedidos de marcação</string><string name="telefon_waehlen_titel">Confirmar chamada no marcador do sistema</string>
    <string name="telefon_eingehend_titel">Chamadas recebidas</string><string name="telefon_eingehend_schalter">Partilhar estado da chamada recebida</string><string name="telefon_nummer_schalter">Partilhar número de quem liga quando disponível</string><string name="telefon_annehmen_schalter">Permitir atender chamadas no computador</string><string name="telefon_eingehend_hinweis">Cada opção está desativada por predefinição e pede apenas a permissão telefónica necessária. O áudio das chamadas nunca é enviado através do Magnolie.</string><string name="telefon_berechtigung_fehlt">A permissão telefónica não foi concedida. A opção permanece desativada.</string>
