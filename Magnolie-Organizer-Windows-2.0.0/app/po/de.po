msgstr "Magnolienbaum-Briefkasten"

#: app/web/anwendung.js:16409
msgid "Server address"
msgstr "Serveradresse"

#: app/web/anwendung.js:16413
msgid "User name"
msgstr "Benutzername"

#: app/web/anwendung.js:16419
