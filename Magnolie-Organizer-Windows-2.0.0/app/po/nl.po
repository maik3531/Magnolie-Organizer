msgstr "Unavailable"

msgid ""
"Under Wayland, the compositor determines the exact window position; "
"centering and maximizing are passed on as requests."
msgstr ""
"Onder Wayland bepaalt de compositor de exacte vensterpositie; centreren en "
"maximaliseren worden als verzoeken doorgegeven."

msgid "Underline"
msgstr "Onderstrepen"

msgid "Unit"
msgstr "Eenheid"

msgid "Unknown"
msgstr "Onbekend"

msgid "Unknown caller"
msgstr "Onbekende beller"

msgid "Unknown error"
msgstr "Onbekende fout"

msgid "Unknown phone"
msgstr "Onbekende telefoon"

