#: TelefonCoordinator.cs:153
msgid ""
"Magnolie SMS is no longer part of the current Magnolie Notes phone protocol."
msgstr ""
"Magnolie SMS maakt niet langer deel uit van het huidige Magnolie Notes-"
"telefoonprotocol."

#: TelefonCoordinator.cs:159
msgid "This dial request has already been queued."
msgstr "Dit belverzoek staat al in de wachtrij."

#: TelefonCoordinator.cs:166
msgid "The call is no longer ringing."
msgstr "De oproep gaat niet meer over."

#: TelefonCoordinator.cs:167
msgid "The call is no longer ringing or is outdated."
msgstr "De oproep gaat niet meer over of is verouderd."

#: TelefonCoordinator.cs:169
msgid "This answer request has already been queued."
msgstr "Dit antwoordverzoek staat al in de wachtrij."

#: TelefonCoordinator.cs:174
msgid "The call is no longer active."
msgstr "De oproep is niet langer actief."

#: TelefonCoordinator.cs:175
msgid "The call is no longer active or has been updated."
msgstr "De oproep is niet langer actief of is bijgewerkt."

#: TelefonCoordinator.cs:177
msgid "This end-call request has already been queued."
msgstr "Dit verzoek tot beëindiging van het gesprek staat al in de wachtrij."

#: TelefonCoordinator.cs:186
msgid "Personal synchronization is not permitted on both devices."
msgstr "Persoonlijke synchronisatie is op beide apparaten niet toegestaan."

#: TelefonCoordinator.cs:187
msgid "Personal synchronization format 2 was not negotiated."
msgstr "Er is niet onderhandeld over persoonlijk synchronisatieformaat 2."

#: TelefonCoordinator.cs:190 TelefonCoordinator.cs:222
#: TelefonCoordinator.cs:230
msgid "The personal synchronization run has expired."
msgstr "De persoonlijke synchronisatierun is verlopen."

#: TelefonCoordinator.cs:203
msgid "The personal synchronization result is invalid."
msgstr "Het persoonlijke synchronisatieresultaat is ongeldig."

#: TelefonCoordinator.cs:299
#, csharp-format
msgid "TCP port {0} could not be opened: {1}"
msgstr "TCP-poort {0} kon niet worden geopend: {1}"

#: TelefonCoordinator.cs:459
msgid "Another phone is already paired. Remove it first."
msgstr "Er is al een andere telefoon gekoppeld. Verwijder het eerst."

#: TelefonCoordinator.cs:461
msgid ""
"Pairing was rejected cryptographically. The confirmation code, pairing code, "
"or phone key does not match. Restart pairing on both devices."
msgstr ""
"Het koppelen werd cryptografisch afgewezen. De bevestigingscode, "
"koppelingscode of telefoonsleutel komen niet overeen. Start het koppelen "
"opnieuw op beide apparaten."

#: TelefonCoordinator.cs:464
msgid ""
"The phone sent a message unknown to this phone protocol. Organizer and "
"Magnolie Notes must use the same protocol version."
msgstr ""
"De telefoon heeft een bericht verzonden dat onbekend is voor dit "
"telefoonprotocol. Organizer en Magnolie Notes moeten dezelfde protocolversie "
"gebruiken."

#: TelefonCoordinator.cs:466
msgid "The connection to the phone was interrupted during pairing."
msgstr "Tijdens het koppelen is de verbinding met de telefoon verbroken."

#: TelefonCoordinator.cs:467
msgid "Pairing failed:"
msgstr "Koppelen mislukt:"

#: TelefonCoordinator.cs:719
msgid "The phone function is not permitted or available."
msgstr "De telefoonfunctie is niet toegestaan of beschikbaar."

msgid "Language & region"
msgstr "Taal en regio"

