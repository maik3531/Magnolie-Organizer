msgid_plural "Queue: %(open)s of %(count)s transmissions await delivery."
msgstr[0] "Čakanski rynk: %(open)s %(count)s posrědkowanja čaka na dodawanje."
msgstr[1] "Čakanski rynk: %(open)s %(count)s posrědkowanja čaka na dodawanje."
msgstr[2] "Čakanski rynk: %(open)s %(count)s posrědkowanja čaka na dodawanje."
msgstr[3] "Čakanski rynk: %(open)s %(count)s posrědkowanja čaka na dodawanje."

#: app/web/anwendung.js:16364
msgid ""
"Both branches display the same six-digit code when connecting. Confirm it "
"only if it matches, preventing anyone from intercepting the connection."
msgstr ""
"Při zwjazowanju pokazujetej wobaj wotrězkej samsny šěsćměstny kod. Wobkrućće "
"jón jenož, hdyž so woprawdźe kryje; tak zadźěwaće tomu, zo něchtó zwisk "
"wotposłucha."

#: app/web/anwendung.js:16371 app/web/anwendung.js:20685
msgid "Ready."
msgstr "Hotowe."

#: app/web/anwendung.js:16372
