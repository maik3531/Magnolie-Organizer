msgid "%(count)s incoming offer"
msgid_plural "%(count)s incoming offers"
msgstr[0] "%(count)s уваходная прапанова"
msgstr[1] "%(count)s уваходныя прапановы"
msgstr[2] "%(count)s уваходных прапаноў"

#: app/web/anwendung.js:16174
