msgstr[0] "تم إنشاء بطاقة اتصال مكررة واحدة"
msgstr[1] "كانت هناك بطاقتا اتصال مكررتان %(count)s"
msgstr[2] "كانت هناك بطاقتا اتصال مكررتان %(count)s"
