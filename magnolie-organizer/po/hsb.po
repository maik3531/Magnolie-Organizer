msgstr ""
"Wubrane žórło internetneho konta je znjemóžnjene. Wubjerće zmóžnjene žórło w "
"nastajenjach."

msgid "The selected path is not a regular file."
msgstr "Wubrana šćežka njeje regularny dataj."

msgid "The selected phone changed. Try again."
msgstr "Wubrany telefon je so změnił. Spytajće hišće raz."

msgid "The selected source was not found. Select it again in Settings."
msgstr "Wubrane žórło njeje so namakało. Wubjerće jo w Nastajenjach znowa."

msgid ""
"The server operator can see the account, folder and file names, sizes and "
"times of your messages."
msgstr ""
"Serwerowy wobhospodowar móže konto, mjena rjadowakow a datajow, wulkosće a "
"časy wašich powěsćow widźeć."

msgid "The service returned no entries for this selection."
msgstr "Słužba za tutón wuběr žane zapiski njewróći."

msgid ""
"The sheet appears at the edge of the screen, accompanied by the Magnolie "
"chime."
msgstr "Łopjeno so na kromje wobrazowki zjewi, zhromadnje ze zynkom Magnolie."

msgid ""
"The small uniform icons open an installed application when possible. "
"Otherwise, a secure web service is used in the browser."
msgstr ""
"Małe jednore ikony wočinja instalowane nałoženje, jeli je to móžno. Hewak so "
"wěsta websłužba we wobhladowaku wužiwa."

msgid "The snapshot operation failed."
msgstr "Operacija momentoweho wobraza zwrěšći."

msgid "The start date must not be after the end date."
msgstr "Startowy datum njesmě za kónčnym datumom być."

msgid "The synchronization request could not be sent."
msgstr "Synchronizaciske naprašowanje njeda so pósłać."

msgid "The synchronization resume journal is damaged."
msgstr "Dźenik za pokročowanje synchronizacije je wobškodźeny."

msgid "The system dialer opens on the phone. Confirm the call there."
msgstr ""
"Systemowe wólenske nałoženje so na telefonje wočini. Wobkrućće tam zawołanje."

msgid "The task is missing from the update."
msgstr "Nadawk w aktualizaciji faluje."

msgid ""
"The task will be sent to the selected branch. It will also remain here so "
"you can keep track of it."
msgstr ""
"Nadawk so wubranemu hałuzej pósćele. Wostanje tež tu, zo byšće móhli jeho "
"staw wobkedźbować."

msgid ""
"The traffic-light colors are general reference ranges for adults, not a "
"diagnosis. Check abnormal readings and discuss them with a doctor; seek "
"immediate medical help for severe symptoms."
msgstr ""
"Ampelfarby su powšitkowne referencne wobłuki za dorosćenych, nic diagnoza. "
"Přepruwujće anomalne měrjenske hódnoty a wobjednajće je z lěkarjom; při "
"ćežkich symptomach pytajće hnydom medicinsku pomoc."

#, python-format
msgid "The tray applet could not be started: %s"
msgstr "Aplet systemoweho pola njehodźeše so startować: %s"

msgid "The tray applet is not available on this system."
msgstr "Aplet systemoweho pola na tutym systemje k dispoziciji njeje."

msgid ""
"The tray applet requires Ayatana AppIndicator. On plain GNOME, the "
"AppIndicator extension is also required."
msgstr ""
"Aplet systemoweho pola trjeba Ayatana AppIndicator. Na čistem GNOME je tež "
"rozšěrjenje AppIndicator trěbne."

msgid "The trust setting is invalid."
msgstr "Dowěrne nastajenje je njepłaćiwe."

msgid "The two entries do not match."
msgstr "Wobaj zapiskaj so njekryjetej."

msgid "The two new passwords do not match."
msgstr "Wobě nowe hesle so njekryjetej."

msgid "The update check failed."
msgstr "Kontrola aktualizacijow njeje so poradźiła."

msgid "The update information does not contain a valid package checksum."
msgstr ""
"Informacija wo aktualizaciji płaćiwu kontrolnu sumu paketa njewobsahuje."

msgid "The update information does not contain a valid version."
msgstr "Informacija wo aktualizaciji płaćiwu wersiju njewobsahuje."

msgid "The update information does not refer to an allowed package URL."
msgstr "Informacija wo aktualizaciji so na dowoleny URL paketa njepoćahuje."

msgid "The update information has an invalid signature."
msgstr "Informacija wo aktualizaciji ma njepłaćiwu signaturu."

#, python-format
msgid "The update information is currently unavailable (%s)."
msgstr "Informacija wo aktualizaciji tuchwilu k dispoziciji njeje (%s)."

msgid "The update information is unexpectedly large."
msgstr "Informacija wo aktualizaciji je njewočakowanje wulka."

msgid "The update information is unreadable."
msgstr "Informacija wo aktualizaciji njeje čitajomna."

msgid "The user data could not be read."
msgstr "Wužiwarske daty njehodźachu so čitać."

msgid "The value is outside the general green reference range."
msgstr "Hódnota je zwonka powšitkowneho zeleneho referencneho wobłuka."

msgid "The wake-up reminder"
msgstr "Dopominanje z budźenjem"

msgid ""
"The weather service estimated the location from your public IP address. Your "
"own address in Contacts provides a more precise location."
msgstr ""
"Wjedrowa słužba je městno z wašeje zjawneje IP-adresy wotměniła. Waša "
"swójska adresa w Kontaktach dawa dokładniše městno."

#, python-format
msgid ""
"The weather service is unavailable. Is there an internet connection? (%s)"
msgstr "Wjedrowa słužba k dispoziciji njeje. Je internetny zwisk? (%s)"

#, python-format
msgid "The weather service rejected the request (error %s)."
msgstr "Wjedrowa słužba naprašowanje wotpokaza (zmylk %s)."

msgid "The weather service returned no forecast."
msgstr "Wjedrowa słužba žanu předpowědź njewróći."

msgid "The weather service returned too much data."
msgstr "Wjedrowa słužba je přewjele datow wróćiła."

msgid "The weather service returned unreadable data."
msgstr "Wjedrowa słužba je nječitajomne daty wróćiła."

msgid ""
"The year calendar shows all twelve months; the month calendar provides more "
"room for entries."
msgstr ""
"Lětna protyka pokazuje wšě dwanaće měsacow; měsačna protyka dawa wjace "
"městna za zapiski."

msgid "The year is invalid."
msgstr "Lěto je njepłaćiwe."

msgid "There are no entries to export yet."
msgstr "Hišće žane zapiski za eksport njejsu."

msgid "There are no entries."
msgstr "Žane zapiski njejsu."

msgid "There are no holidays in the organizer for this selection yet."
msgstr "Za tutón wuběr hišće žane swjate dny w organizatorje njejsu."

msgid "There are no saved entries on this page."
msgstr "Na tutej stronje žane składowane zapiski njejsu."

msgid "There is no notebook in this group yet."
msgstr "W tutej skupinje hišće žadyn noticnik njeje."

msgid ""
"There is nothing scheduled in this period.\n"
"Click a day on the left to add an appointment."
msgstr ""
"W tutej dobje ničo zaplanowane njeje.\n"
"Klikńće na dźeń nalěwo, zo byšće termin přidali."

msgid "There is nothing to print."
msgstr "Ničo za ćišćenje njeje."

msgid ""
"These are Magnolie's actual tabs. You can show only the sections that fit "
"your everyday life."
msgstr ""
"To su rajtarki, kotrež w Magnolie widźiće. Móžeće jenož te wobłuki pokazać, "
"kotrež we wšědnym žiwjenju trjebaće."

msgid ""
"These choices change how the Organizer displays information. Your entries "
"are not converted or moved."
msgstr ""
"Tute nastajenja změnja, kak Organizer informacije zwobraznja. Waše zapiski "
"so ani njepřetworja ani njepřesunu."

msgid ""
"These options require the matching permissions in Magnolie Notes. Call audio "
"is not sent over the Magnolie data connection."
msgstr ""
"Tute nastajenja sej wotpowědne dowolnosće w Magnolie Notes žadaja. Zynk "
"zawołanja so přez datowy zwisk Magnolie njepřenjesuje."

msgid "This address can be selected and copied."
msgstr "Tuta adresa hodźi so wubrać a kopěrować."

msgid "This answer request has already been queued."
msgstr "Tute naprašowanje za přiwzaćom wołanja je hižo w čakanskim rynku."

msgid "This appointment will appear every %(weekday)s."
msgstr "Tutón termin so kóždy %(weekday)s zjewi."

msgid "This appointment will appear every day."
msgstr "Tutón termin so kóždy dźeń zjewi."

msgid "This appointment will appear every year on %(month)s %(day)s."
msgstr "Tutón termin so kóžde lěto %(day)s %(month)s zjewi."

msgid ""
"This appointment will appear on day %(day)s of every month. In shorter "
"months, it moves to the last day."
msgstr ""
"Tutón termin so %(day)s. dźeń kóždeho měsaca zjewi. W krótszych měsacach so "
"na posledni dźeń přesunje."

msgid "This backup cannot be used."
msgstr "Tute zawěsćenje njehodźi so wužiwać."

msgid "This branch has not been confirmed."
msgstr "Tutón hałuz njeje wobkrućeny."

msgid "This branch has not yet been confirmed."
msgstr "Tutón hałuz hišće njeje wobkrućeny."

msgid "This branch is not known."
msgstr "Tutón hałuz njeje znaty."

