<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../magnolie-organizer-windows/DocumentExportService.cs" Link="DocumentExportService.cs" />
    <Compile Include="../../../magnolie-organizer-windows/NativeLocalization.cs" Link="NativeLocalization.cs" />
    <None Include="../../../magnolie-organizer-windows/app/native-i18n.json" Link="native-i18n.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
