#!/usr/bin/make -f
# Regelwerk des Handbuchs – reine Textinstallation ohne Kompilat.

JS_LAUFER := $(shell command -v node 2>/dev/null || command -v nodejs 2>/dev/null || command -v bun 2>/dev/null)

%:
	dh $@

override_dh_auto_build:
	rm -rf debian/magnolie-handbuch debian/.debhelper debian/files debian/*.substvars
	mkdir -p web/i18n
	set -e; while read sprache; do \
		mkdir -p locale/$$sprache/LC_MESSAGES; \
		python3 werkzeuge/katalog_pruefen.py po/magnolie-handbuch.pot po/$$sprache.po; \
		msgfmt --check --check-format -o locale/$$sprache/LC_MESSAGES/magnolie-handbuch.mo po/$$sprache.po; \
		python3 werkzeuge/po_zu_js.py $$sprache po/$$sprache.po web/i18n/$$sprache.js; \
	done < po/LINGUAS
	python3 -m py_compile bin/magnolie-handbuch
	rm -rf bin/__pycache__

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	set -e; while read sprache; do \
		python3 werkzeuge/katalog_pruefen.py po/magnolie-handbuch.pot po/$$sprache.po; \
	done < po/LINGUAS
	test -n "$(JS_LAUFER)"
	TZ=Europe/Berlin $(JS_LAUFER) pruefungen/handbuch_test.js
	python3 pruefungen/druck_test.py --cli-only
	@if { [ -n "$${DISPLAY:-}" ] || [ -n "$${WAYLAND_DISPLAY:-}" ]; } && \
		command -v pdfinfo >/dev/null && command -v pdftotext >/dev/null && \
		python3 -c 'import gi; gi.require_version("Gtk", "3.0"); gi.require_version("WebKit2", "4.1")' 2>/dev/null; then \
		TZ=Europe/Berlin python3 pruefungen/druck_test.py; \
	else \
		echo "PDF-Druckprüfung übersprungen: keine geeignete grafische Buildumgebung."; \
	fi
endif

override_dh_strip_nondeterminism:
	dh_strip_nondeterminism -Xmagnolie-handbuch.mo

override_dh_auto_clean:
	rm -rf bin/__pycache__ werkzeuge/__pycache__ pruefungen/__pycache__ locale web/i18n/*.js debian/magnolie-handbuch debian/.debhelper debian/files debian/*.substvars
