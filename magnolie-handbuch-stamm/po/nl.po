"fill='#2a150e'/><g fill='none' stroke='#e8e2d4' stroke-width='2.4'><circle "
"cx='230' cy='48' r='8'/><circle cx='230' cy='90' r='8'/><circle cx='230' "
"cy='132' r='8'/><circle cx='230' cy='174' r='8'/></g><line x1='28' y1='44' "
"x2='198' y2='44' stroke='#d8b25c' stroke-width='2'/><line x1='262' y1='44' "
"x2='432' y2='44' stroke='#d8b25c' stroke-width='2'/><g fill='#c9b68c'><rect "
"x='442' y='40' width='14' height='22' rx='3'/><rect x='442' y='68' "
