msgid ""
"Magnolie Organizer - User Guide\n"
"\n"
"Usage:\n"
"  magnolie-handbuch          Open the handbook\n"
"  magnolie-handbuch --help   Show this overview\n"
"  magnolie-handbuch --sprache SPRACHE / --language LANGUAGE\n"
"                             Use de, en, or system for this invocation\n"
"  magnolie-handbuch --pot [DATEI] / --pot-template [FILE]\n"
"                             Create a gettext POT template\n"
msgstr ""
"Magnolie Organizer - Guide de l’utilisateur\n"
"\n"
"Utilisation :\n"
"  magnolie-handbuch          Ouvrir le manuel\n"
"  magnolie-handbuch --help   Afficher cet aperçu\n"
"  magnolie-handbuch --sprache SPRACHE / --language LANGUAGE\n"
"                             Utiliser de, en ou system pour cet appel\n"
"  magnolie-handbuch --pot [DATEI] / --pot-template [FILE]\n"
"                             Créer un modèle POT gettext\n"

