"x='354' y='46'>SUN</text></g><g fill='none' stroke='#d8c39a'><rect x='20' "
"y='52' width='52' height='34'/><rect x='74' y='52' width='52' height='34'/"
"><rect x='128' y='52' width='52' height='34'/><rect x='182' y='52' "
"width='52' height='34'/><rect x='236' y='52' width='52' height='34'/><rect "
"x='290' y='52' width='52' height='34'/><rect x='344' y='52' width='52' "
"height='34'/><rect x='20' y='88' width='52' height='34'/><rect x='74' y='88' "
"width='52' height='34'/><rect x='128' y='88' width='52' height='34'/><rect "
"x='182' y='88' width='52' height='34'/><rect x='236' y='88' width='52' "
"height='34'/><rect x='290' y='88' width='52' height='34'/><rect x='344' "
