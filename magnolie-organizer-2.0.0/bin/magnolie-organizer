  font-family: "DejaVu Sans", sans-serif;
  font-size: 11pt;
  color: #5a4630;
}
label.initialen {
  background-color: #6b3a2a;
  color: #fff8e5;
  border-radius: 18px;
  font-weight: bold;
  padding: 8px;
}
separator.gold { background-color: #d8b25c; min-height: 2px; }
button.papier {
  background-image: none;
  background-color: rgba(90, 70, 48, 0.10);
  border: 1px solid #ab9468;
  border-radius: 5px;
  color: #3a3128;
  font-family: "DejaVu Sans", sans-serif;
  padding: 4px 12px;
}
button.papier:hover { background-color: rgba(90, 70, 48, 0.20); }
"""


SITZUNGS_SCHLUESSEL = ("DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY",
                       "DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR")


def sitzungsumgebung_uebernehmen(prozessordner="/proc", umgebung=None):
    """Sucht die Umgebung der angemeldeten Sitzung.

    Der Dienst im Hintergrund erbt weder Anzeige noch Sitzungsbus. Ohne
    Anzeige bricht GTK beim ersten Fenster hart ab – deshalb werden die
    nötigen Angaben aus einem laufenden Prozess derselben Anmeldung
    übernommen. Liefert die übernommenen Werte."""
    umgebung = umgebung if umgebung is not None else os.environ
    if umgebung.get("DISPLAY") or umgebung.get("WAYLAND_DISPLAY"):
        return {}

    try:
        eigene_kennung = os.getuid()
    except AttributeError:
        eigene_kennung = None

    uebernommen = {}
    try:
        eintraege = sorted((n for n in os.listdir(prozessordner) if n.isdigit()),
                           key=int)
    except OSError:
        eintraege = []

    for name in eintraege:
        pfad = os.path.join(prozessordner, name)
        try:
            if eigene_kennung is not None and os.stat(pfad).st_uid != eigene_kennung:
                continue
            with open(os.path.join(pfad, "environ"), "rb") as datei:
                roh = datei.read()
        except OSError:
            continue

        gefunden = {}
        for stueck in roh.split(b"\0"):
            if b"=" not in stueck:
                continue
            schluessel, _, wert = stueck.partition(b"=")
            try:
                schluessel = schluessel.decode("utf-8")
                wert = wert.decode("utf-8")
            except UnicodeDecodeError:
                continue
            if schluessel in SITZUNGS_SCHLUESSEL and wert:
                gefunden[schluessel] = wert

        if gefunden.get("DISPLAY") or gefunden.get("WAYLAND_DISPLAY"):
            for schluessel, wert in gefunden.items():
                umgebung[schluessel] = wert
                uebernommen[schluessel] = wert
            break

    if not uebernommen:
        # Letzter Versuch: die übliche erste Anzeige
        umgebung.setdefault("DISPLAY", ":0")
        uebernommen["DISPLAY"] = umgebung["DISPLAY"]
    return uebernommen


def anzeige_bereit():
    """Gibt es überhaupt eine Anzeige, auf der ein Fenster erscheinen kann?"""
    if not GTK_OK:
        return False
    if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        return False
    try:
        gelungen = Gtk.init_check([])
        return bool(gelungen[0] if isinstance(gelungen, tuple) else gelungen)
    except Exception:
        return False


def _meldung_platzieren(fenster):
    """Setzt das Blatt an den oberen rechten Rand des Arbeitsbereichs."""
    try:
        anzeige = Gdk.Display.get_default()
        bereich = None
        if hasattr(anzeige, "get_primary_monitor"):
            schirm = anzeige.get_primary_monitor() or anzeige.get_monitor(0)
            if schirm is not None:
                bereich = schirm.get_workarea()
        if bereich is None or bereich.width < 100:
            raise ValueError("kein brauchbarer Arbeitsbereich")
        breite = fenster.get_allocated_width() or 380
        links = bereich.x + max(0, bereich.width - breite - 28)
        oben = bereich.y + 44
    except Exception:
        links, oben = 60, 60
    try:
        fenster.move(links, oben)
    except Exception:
        pass


def magnolie_meldung(kopf, rumpf, wartezeit=60, mit_aktion=True,
                     eigene_schleife=True, aktionsname=None, aktion=None,
                     foto=None, initialen=""):
    """Zeigt die Erinnerung als kleines Papierblatt im Stil des Organizers –
    auch dann, wenn das Programm selbst gar nicht läuft.

    Liefert nur dann True, wenn das Blatt nachweislich erschienen ist:
    Bleibt es aus – etwa weil die Fensterverwaltung es nicht anzeigt –,
    springt die Meldung des Systems ein, statt dass gar nichts kommt."""
    if not anzeige_bereit():
        return False
    try:
        fenster = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        fenster.get_style_context().add_class("magnolie-meldung")
        fenster.set_title(FENSTER_TITEL)
        fenster.set_decorated(False)
        fenster.set_keep_above(True)
        fenster.set_skip_taskbar_hint(True)
        # DIALOG statt NOTIFICATION: Meldungsfenster fremder Programme
        # blenden manche Fensterverwaltungen aus.
        fenster.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        fenster.set_gravity(Gdk.Gravity.NORTH_EAST)
        fenster.set_default_size(380, -1)
        fenster.set_border_width(0)

        # Für die runden Ecken braucht es eine Bildmischung. Gibt es die
        # nicht, bleibt es beim gefüllten Lederrahmen – sonst erschiene
        # rund um die Ecken ein schwarzer Rand.
        try:
            schirm = fenster.get_screen()
            sichtbar = schirm.get_rgba_visual()
            if sichtbar is not None and schirm.is_composited():
                fenster.set_visual(sichtbar)
            else:
                fenster.get_style_context().add_class("ohne-mischung")
        except Exception:
            fenster.get_style_context().add_class("ohne-mischung")

        stil = Gtk.CssProvider()
        stil.load_from_data(MAGNOLIE_MELDUNG_STIL)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), stil,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        blatt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        blatt.get_style_context().add_class("blatt")

        titelzeile = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        bild = None
        if isinstance(foto, bytes) and foto:
            try:
                lader = GdkPixbuf.PixbufLoader.new()
                lader.write(foto)
                lader.close()
                pixbuf = lader.get_pixbuf().scale_simple(
                    42, 42, GdkPixbuf.InterpType.BILINEAR)
                bild = Gtk.Image.new_from_pixbuf(pixbuf)
            except Exception:
                bild = None
        if bild is not None:
            titelzeile.pack_start(bild, False, False, 0)
        elif initialen:
            zeichen = Gtk.Label(label=initialen[:2].upper())
            zeichen.get_style_context().add_class("initialen")
            titelzeile.pack_start(zeichen, False, False, 0)
        titel = Gtk.Label(label=kopf, xalign=0.0)
        titel.get_style_context().add_class("kopf")
        titelzeile.pack_start(titel, True, True, 0)
        blatt.pack_start(titelzeile, False, False, 0)

        linie = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        linie.get_style_context().add_class("gold")
        blatt.pack_start(linie, False, False, 0)

        text = Gtk.Label(label=rumpf, xalign=0.0)
        text.get_style_context().add_class("rumpf")
        text.set_line_wrap(True)
        text.set_max_width_chars(42)
        blatt.pack_start(text, False, False, 0)

        knoepfe = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        knoepfe.set_halign(Gtk.Align.END)
        if mit_aktion:
            auf = Gtk.Button(label=aktionsname or _("Open organizer"))
            auf.get_style_context().add_class("papier")
            auf.connect("clicked", lambda *_egal: (
                aktion() if aktion else organizer_starten(),
                fenster.destroy() if not eigene_schleife else Gtk.main_quit()))
            knoepfe.pack_start(auf, False, False, 0)
        zu = Gtk.Button(label=_("Close"))
        zu.get_style_context().add_class("papier")
        zu.connect("clicked", lambda *_egal: (
            fenster.destroy() if not eigene_schleife else Gtk.main_quit()))
        knoepfe.pack_start(zu, False, False, 0)
        blatt.pack_start(knoepfe, False, False, 2)

        rahmen = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        rahmen.get_style_context().add_class("rahmen")
        rahmen.add(blatt)
        fenster.add(rahmen)
        if eigene_schleife:
            fenster.connect("destroy", lambda *_egal: Gtk.main_quit())

        erschienen = {"ja": False}

        def bei_erscheinen(*_egal):
            erschienen["ja"] = True
            _meldung_platzieren(fenster)
            try:
                fenster.present()
            except Exception:
                pass
            return False

        fenster.connect("map-event", bei_erscheinen)
        fenster.show_all()
        _meldung_platzieren(fenster)

        if not eigene_schleife:
            # Der Organizer läuft bereits – seine Fensterschleife zeigt das
            # Blatt; eine zweite Schleife darf es hier nicht geben.
            if wartezeit:
                GLib.timeout_add_seconds(max(5, wartezeit), lambda: (
                    fenster.destroy(), False)[1])
            return True

        # Notausstieg: Bleibt das Blatt unsichtbar, wird nicht ewig
        # gewartet – dann übernimmt die Meldung des Systems.
        def nachsehen():
            if not erschienen["ja"]:
                Gtk.main_quit()
            return False

        GLib.timeout_add_seconds(3, nachsehen)
        if wartezeit:
            GLib.timeout_add_seconds(max(5, wartezeit),
                                     lambda: (Gtk.main_quit(), False)[1])
        Gtk.main()
        try:
            fenster.destroy()
        except Exception:
            pass
        return erschienen["ja"]
    except Exception:
        return False


def melden(kopf, rumpf, stil="system", mit_aktion=True, wartezeit=60):
    """Zeigt eine Erinnerung im gewünschten Gewand; klappt der eigene Stil
    nicht, springt die Systemmeldung ein."""
    if os.environ.get("WAYLAND_DISPLAY"):
        stil = "system"
    if stil == "magnolie" and magnolie_meldung(
            kopf, rumpf, wartezeit, mit_aktion,
            eigene_schleife=not _SCHLEIFE_LAEUFT["ja"]):
        return "magnolie"
    return "system" if benachrichtigen(kopf, rumpf, mit_aktion, wartezeit) else ""


def wecker_protokoll_datei():
    return os.path.join(daten_verzeichnis(), "wecker.log")


PROTOKOLL_MARKER = '"No valid"'


def contributor_dauerhaft_freigeschaltet(daten, contributor_hash):
    """Prüft ausschließlich den aktuellen entschlüsselten Datenstand."""
    if not contributor_hash or not isinstance(daten, dict):
        return False
    einstellungen = daten.get("einstellungen")
    allgemein = einstellungen.get("allgemein") if isinstance(
        einstellungen, dict) else None
    return (isinstance(allgemein, dict) and
            allgemein.get("contributorFreigeschaltet") is True)


def protokoll_aufbereiten(text, freigeschaltet, jetzt=None):
    """Bereinigt alte Marker und erzeugt die ausschließlich sichtbare Ansicht."""
    zeilen = [zeile for zeile in (text or "").splitlines()
              if zeile.strip() != PROTOKOLL_MARKER]
    if freigeschaltet:
        return "\n".join(zeilen) + ("\n" if zeilen else "")
    zeit = (jetzt or datetime.now()).strftime("%d.%m.%Y %H:%M:%S")
    if not zeilen:
        zeilen = [zeit + "  Diagnostic view created.",
                  zeit + "  No log entries are available."]
    elif len(zeilen) == 1:
        zeilen.append(zeit + "  Diagnostic view created.")
    position = max(1, min(len(zeilen) - 1, len(zeilen) // 2))
    zeilen.insert(position, PROTOKOLL_MARKER)
    return "\n".join(zeilen) + "\n"


# Das Protokoll lässt sich abschalten; der Wecker liest die Einstellung
# einmal je Durchgang und merkt sie sich hier.
_PROTOKOLL = {"an": False}


def zeile_ist_alt(zeile, grenze):
    """Ist eine Protokollzeile älter als der genannte Zeitpunkt?"""
    try:
        wann = datetime.strptime(zeile[:19], "%d.%m.%Y %H:%M:%S")
    except (TypeError, ValueError):
        return False        # ohne lesbares Datum lieber behalten
    return wann < grenze


def protokoll_kuerzen(zeilen, jetzt=None, tage=30, hoechstens=200):
    """Wirft alles hinaus, was älter als die genannten Tage ist, und
    begrenzt zusätzlich die Zeilenzahl."""
    from datetime import timedelta
    jetzt = jetzt or datetime.now()
    grenze = jetzt - timedelta(days=max(1, tage))
    frisch = [z for z in zeilen if not zeile_ist_alt(z, grenze)]
    return frisch[-hoechstens:] if len(frisch) > hoechstens else frisch


def wecker_notiz(text, pfad=None, hoechstens=200, tage=30):
    """Schreibt eine Zeile ins Protokoll des Weckers. Es hilft bei der
    Suche, wenn eine Erinnerung einmal ausbleibt, und bleibt klein:
    Einträge älter als 30 Tage werden ebenso entfernt wie alles, was über
    die Höchstzahl an Zeilen hinausgeht."""
    zeile = "%s  %s" % (datetime.now().strftime("%d.%m.%Y %H:%M:%S"), text)
    if not _PROTOKOLL["an"]:
        return zeile
    pfad = pfad or wecker_protokoll_datei()
    try:
        zeilen = []
        if os.path.exists(pfad):
            with open(pfad, "r", encoding="utf-8") as datei:
                zeilen = datei.read().splitlines()
        zeilen.append(zeile)
        zeilen = protokoll_kuerzen(zeilen, hoechstens=hoechstens, tage=tage)
        with open(pfad, "w", encoding="utf-8") as datei:
            datei.write("\n".join(zeilen) + "\n")
    except OSError:
        pass
    return zeile


def wecker_protokoll_lesen(anzahl=15, pfad=None):
    try:
        with open(pfad or wecker_protokoll_datei(), "r", encoding="utf-8") as datei:
            zeilen = datei.read().splitlines()
    except OSError:
        return []
    return zeilen[-max(1, anzahl):]


def autostart_datei(ordner=None):
    basis = ordner or (os.environ.get("XDG_CONFIG_HOME")
                       or os.path.expanduser("~/.config"))
    return os.path.join(basis, "autostart", "magnolie-erinnerung.desktop")


def autostart_text(programm=None):
    """Eintrag, der den Wecker beim Anmelden mitstartet. Er läuft in der
    Sitzung selbst und hat damit Anzeige und Sitzungsbus – anders als ein
    Dienst, der außerhalb gestartet wird."""
    return (
        "[Desktop Entry]\n"
        "Type=Application\n"
        "Version=1.0\n"
        "Name=" + _("Magnolie Organizer – reminders") + "\n"
        "Comment=" + _("Reminds you about appointments even when the organizer "
                        "is closed") + "\n"
        "Exec=\"" + (programm or eigener_pfad()).replace(
            "\\", "\\\\").replace('"', '\\"') + "\" --wecker\n"
        "Icon=magnolie-organizer\n"
        "Terminal=false\n"
        "NoDisplay=true\n"
        "Hidden=false\n"
        "X-GNOME-Autostart-enabled=true\n"
        "X-GNOME-Autostart-Delay=15\n"
    )


def autostart_einrichten(an, pfad=None):
    """Legt den Autostart-Eintrag an oder entfernt ihn."""
    pfad = pfad or autostart_datei()
    try:
        if an:
            schreibe_wenn_anders(pfad, autostart_text())
        elif os.path.exists(pfad):
            os.remove(pfad)
    except OSError as fehler:
        return {"ok": False, "fehler": fehler_deutsch(
            fehler, _("Adding the alarm monitor to autostart"))}
    return {"ok": True, "fehler": ""}


def wecker_marke(pfad=None):
    return pfad or os.path.join(daten_verzeichnis(), "wecker.pid")


def wecker_lebt(pfad=None):
    """Läuft bereits ein Wecker dieser Anmeldung?

    Nach einem Neustart vergibt das System dieselben Prozessnummern neu.
    Eine liegengebliebene Marke zeigte deshalb auf irgendeinen fremden
    Prozess – der Wecker hielt sich für schon laufend und beendete sich
    sofort, sodass nach dem Hochfahren niemand nach Terminen sah. Darum
    wird zusätzlich geprüft, ob hinter der Nummer wirklich unser Wecker
    steckt."""
    try:
        with open(wecker_marke(pfad), "r", encoding="utf-8") as datei:
            nummer = int((datei.read() or "0").strip() or 0)
    except (OSError, ValueError):
        return False
    if nummer <= 0 or nummer == os.getpid():
        return False
    try:
        os.kill(nummer, 0)
    except OSError:
        return False
    return ist_unser_wecker(nummer)


def ist_unser_wecker(nummer, prozessordner="/proc"):
    """Prüft anhand der Befehlszeile, ob hinter einer Prozessnummer
    tatsächlich unser Wecker steckt. Im Zweifel lieber nein – ein zweiter
    Wecker ist harmlos, gar keiner wäre schlimm."""
    try:
        with open(os.path.join(prozessordner, str(nummer), "cmdline"), "rb") as datei:
            befehl = datei.read().replace(b"\0", b" ").decode("utf-8", "ignore")
    except OSError:
        return False
    return PROGRAMM_NAME in befehl and "--wecker" in befehl


def wecker_anmelden(pfad=None):
    pfad = wecker_marke(pfad)
    try:
        atomar_text_schreiben(pfad, str(os.getpid()))
        return True
    except OSError:
        return False


def wecker_starten(starter=None):
    """Startet den Wecker sofort, damit man sich nicht erst neu anmelden
    muss. Läuft schon einer, geschieht nichts."""
    import subprocess
    if wecker_lebt():
        return "laeuft-schon"
    ziel = eigener_pfad()
    if starter is None:
        def starter(argumente):
            subprocess.Popen(argumente, start_new_session=True,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
    try:
        starter([ziel, "--wecker"])
    except OSError:
        return ""
    return "gestartet"


def wecker_abmelden(pfad=None):
    try:
        os.remove(wecker_marke(pfad))
    except OSError:
        pass


def wecker_schleife(takt=30, hoechstens=0, schlafen=None, lauf=None):
    """Der Wecker selbst: sieht regelmäßig nach fälligen Terminen.

    Er läuft in der angemeldeten Sitzung und übersteht das Schließen des
    Organizers. Beim Start sieht er sofort einmal nach, damit Versäumtes
    gleich nach dem Anmelden gemeldet wird."""
    import time
    schlafen = schlafen or time.sleep
    lauf = lauf or erinnerungslauf
    durchgaenge = 0
    while True:
        try:
            lauf()
        except Exception as fehler:   # ein Fehlschlag darf den Wecker nicht stoppen
            wecker_notiz(_("Run failed: %s") % fehler)
        durchgaenge += 1
        if hoechstens and durchgaenge >= hoechstens:
            return durchgaenge
        schlafen(max(5, takt))


# Läuft bereits eine Ereignisschleife (im Wecker oder im Organizer), darf
# darin keine zweite gestartet werden – sonst gilt das Programm der
# Fensterverwaltung als „reagiert nicht".
_SCHLEIFE_LAEUFT = {"ja": False}


def wecker_betrieb(takt=30, schleife=None):
    """Der Wecker im Betrieb.

    Bevorzugt läuft er in einer Ereignisschleife: Dann bleiben angezeigte
    Blätter bedienbar und die Fensterverwaltung hält das Programm nicht
    für eingeschlafen. Fehlt GTK, tut es auch die einfache Warteschleife."""
    def schlag():
        try:
            erinnerungslauf(als_wecker=True)
        except Exception as fehler:
            wecker_notiz(_("Run failed: %s") % fehler)
        return True

    if GTK_OK and GLib is not None:
        _SCHLEIFE_LAEUFT["ja"] = True
        try:
            schlag()
            GLib.timeout_add_seconds(max(5, takt), schlag)
            (schleife or GLib.MainLoop()).run()
            return "ereignisschleife"
        except Exception as fehler:
            wecker_notiz(_("Event loop is not available: %s") % fehler)
        finally:
            _SCHLEIFE_LAEUFT["ja"] = False

    wecker_schleife(takt=takt, lauf=lambda: erinnerungslauf(als_wecker=True))
    return "warteschleife"


def protokoll_oeffnen(starter=None, freigeschaltet=False):
    """Öffnet eine private, aufbereitete Ansichtskopie des Protokolls."""
    import subprocess
    quelle = wecker_protokoll_datei()
    pfad = os.path.join(daten_verzeichnis(), "wecker-ansicht.log")
    try:
        try:
            with open(quelle, "r", encoding="utf-8") as datei:
                text = datei.read()
        except FileNotFoundError:
            text = ""
        atomar_text_schreiben(
            pfad, protokoll_aufbereiten(text, freigeschaltet), modus=0o600)
    except OSError as fehler:
        return {"ok": False, "pfad": pfad, "womit": "",
                "fehler": fehler_deutsch(fehler, _("Creating the log"))}
    if starter is None:
        def starter(argumente):
            subprocess.Popen(argumente, start_new_session=True,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
    for name in ("xdg-open", "xed", "gedit", "kate", "mousepad"):
        werkzeug = shutil.which(name)
        if not werkzeug:
            continue
        try:
            starter([werkzeug, pfad])
        except OSError:
            continue
        return {"ok": True, "pfad": pfad, "womit": name, "fehler": ""}
    return {"ok": False, "pfad": pfad, "womit": "",
            "fehler": _("No text viewer was found. The log is located at: %s")
                      % pfad}


def erinnerungs_probe(freigeschaltet=None):
    """Führt eine Erinnerung genau so aus wie der Dienst im Hintergrund und
    berichtet in lesbaren Sätzen, was dabei geschah."""
    zeilen = []
    geholt = sitzungsumgebung_uebernehmen()
    anzeige = os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")
    zeilen.append((_("Display: %(display)s") % {"display": anzeige}) if anzeige
                  else _("Display: none"))
    if geholt:
        zeilen.append(_("Imported from session: %(variables)s") % {
            "variables": ", ".join(sorted(geholt.keys()))})
    zeilen.append(_("Own window available: yes") if anzeige_bereit()
                  else _("Own window available: no"))
    autostart = autostart_datei()
    zeilen.append((_("Autostart entry: %(path)s") % {"path": autostart})
                  if os.path.exists(autostart)
                  else _("Autostart entry: missing"))
    zeilen.append(_("Alarm monitor in background: running") if wecker_lebt()
                  else _("Alarm monitor in background: not running"))

    einstellungen = {}
    daten = None
    try:
        with open(daten_datei(), "r", encoding="utf-8") as datei:
            daten = json.load(datei)
        einstellungen = (daten.get("einstellungen") or {}).get("erinnerung") or {}
        zeilen.append(_("Data: %(path)s") % {"path": daten_datei()})
    except (OSError, ValueError):
        zeilen.append(_("Data: not found – open the organizer once."))

    stil = "magnolie" if einstellungen.get("stil") == "magnolie" else "system"
    zeilen.append(_("Reminders: enabled") if einstellungen.get("an")
                  else _("Reminders: disabled"))
    zeilen.append(_("Appearance: Magnolie sheet") if stil == "magnolie"
                  else _("Appearance: system notification"))

    eigener = stil == "magnolie"      # der Klang gehört zum Gewand
    klangdatei = finde_klang_datei()
    zeilen.append((_("Sound file: %(path)s") % {"path": klangdatei}) if klangdatei
                  else _("Sound file: not found"))
    weg = ton_abspielen(eigener=eigener)
    zeilen.append((_("Sound through: %(method)s") % {"method": weg}) if weg
                  else _("Sound through: no output method found"))

    gezeigt = melden("Magnolie Organizer", _("This is a reminder test."),
                     stil, mit_aktion=True, wartezeit=20)
    zeilen.append({
        "magnolie": _("Notification appeared: as a Magnolie sheet"),
        "system": _("Notification appeared: as a system notification"),
        "": _("Notification appeared: not at all")
    }.get(gezeigt, _("Notification appeared: unclear")))

    protokoll = wecker_protokoll_lesen(12)
    if protokoll:
        zeilen.append("")
        zeilen.append(_("Latest alarm monitor entries:"))
        zeilen.extend("  " + z for z in protokoll
                      if z.strip() != PROTOKOLL_MARKER)
    else:
        zeilen.append(_("Alarm monitor log: still empty (%(path)s)") % {
            "path": wecker_protokoll_datei()})
    if freigeschaltet is None:
        web_verzeichnis = finde_web_verzeichnis()
        contributor_hash = contributor_hash_lesen(
            web_verzeichnis) if web_verzeichnis else ""
        freigeschaltet = contributor_dauerhaft_freigeschaltet(
            daten, contributor_hash)
    return protokoll_aufbereiten(
        "\n".join(zeilen), freigeschaltet).splitlines()


_DATEN_ZWISCHENSPEICHER = {"stand": None, "daten": None}


def daten_lesen_gepuffert(pfad=None):
    """Liest die Daten nur dann neu, wenn sich die Datei geändert hat –
    der Wecker sieht schließlich alle halbe Minute nach."""
    pfad = pfad or daten_datei()
    try:
        stand = os.stat(pfad)
        kennung = (stand.st_mtime_ns, stand.st_size)
    except OSError:
        return None
    if _DATEN_ZWISCHENSPEICHER["stand"] == kennung:
        return _DATEN_ZWISCHENSPEICHER["daten"]
    try:
        with open(pfad, "r", encoding="utf-8") as datei:
            roh = datei.read()
        if ist_verschluesselt(roh):
            _DATEN_ZWISCHENSPEICHER["stand"] = kennung
            _DATEN_ZWISCHENSPEICHER["daten"] = "verschluesselt"
            return "verschluesselt"
        daten = json.loads(roh)
    except (OSError, ValueError):
        return None
    _DATEN_ZWISCHENSPEICHER["stand"] = kennung
    _DATEN_ZWISCHENSPEICHER["daten"] = daten
    return daten


def erinnerungslauf(jetzt=None, als_wecker=False):
    """Ein Durchgang des Weckers – auch ohne geöffnetes Programm.

    Meldet immer nur eine Stelle: Läuft der Wecker der Sitzung, hält sich
    der Dienst im Hintergrund zurück, damit nichts doppelt erscheint."""
    jetzt = jetzt or _organizer_jetzt()
    if not als_wecker and wecker_lebt():
        return {"gemeldet": 0, "fehler": ""}
    sitzungsumgebung_uebernehmen()
    daten = daten_lesen_gepuffert()
    if daten == "verschluesselt":
        daten = erinnerungsdaten_lesen()
        if not isinstance(daten, dict):
            wecker_notiz(
                _("The data is encrypted – background reminders have not been "
                  "enabled under Settings > Security."))
            return {"gemeldet": 0, "fehler": ""}
        wecker_notiz(
            _("The data is encrypted – the enabled, limited reminder data is being used."))
    if not isinstance(daten, dict):
        return {"gemeldet": 0, "fehler": _("No data was found.")}

    einstellungen = (daten.get("einstellungen") or {}) if isinstance(daten, dict) else {}
    wecker = einstellungen.get("erinnerung") or {}
    protokoll_standard = wecker.get("protokollVoreinstellung")
    _PROTOKOLL["an"] = (
        protokoll_standard in (1, True, "1")
        and bool(wecker.get("protokoll", False))
    )
    if not wecker.get("an"):
        return {"gemeldet": 0, "fehler": ""}
    anzahl_termine = len((daten.get("termine") or []))

    zustand = erinnerung_zustand_lesen()
    ergebnis = faellige_erinnerungen(
        daten, jetzt, zustand,
        vorlauf=int(wecker.get("vorlauf") or 15),
        verpasste=bool(wecker.get("verpasste", True)))

    if wecker.get("aufgaben", True):
        # Namen der Zuständigen für die Meldung beilegen
        personen = {p.get("id"): p.get("name")
                    for p in (daten.get("personen") or [])
                    if isinstance(p, dict)}
        for a in daten.get("aufgaben") or []:
            if isinstance(a, dict):
                a["personenNamen"] = [personen.get(x) for x in (a.get("personen") or [])
                                      if personen.get(x)]
        ergebnis = faellige_aufgaben(daten, jetzt, ergebnis)

    jt = wecker.get("jahrestage") or {}
    if jt.get("an"):
        ergebnis = faellige_jahrestage(
            daten, jetzt, ergebnis,
            tage_vorher=int(jt.get("tage") or 0),
            auch_am_tag=bool(jt.get("amTag", True)),
            stunde=int(jt.get("stunde") or 8))

    art = erinnerungs_art(wecker.get("art"))
    stil = "magnolie" if wecker.get("stil") == "magnolie" else "system"
    if os.environ.get("WAYLAND_DISPLAY"):
        stil = "system"
    # Der Klang gehört zum Gewand: das System bringt seinen eigenen mit,
    # die Magnolie ihr Glockenspiel.
    eigener_klang = stil == "magnolie"
    if stil != "magnolie":
        art = "both"          # im Gewand des Systems entscheidet dieses

    gemeldet = 0
    offen = []
    for eintrag in ergebnis["faellig"] + ergebnis["verpasst"]:
        kopf, rumpf = erinnerungstext(eintrag)
        # Erst der Ton: das eigene Meldeblatt wartet auf den Benutzer und
        # würde den Klang sonst bis zum Schließen aufhalten.
        if art in ("sound", "both"):
            ton_abspielen(eigener=eigener_klang)
        if art in ("notification", "both"):
            weg = melden(kopf, rumpf, stil)
            weg_text = {
                "magnolie": _("Magnolie sheet"),
                "system": _("system notification"),
                "": _("not delivered"),
            }.get(weg, str(weg))
            wecker_notiz(_("Reported (%(method)s): %(title)s – %(body)s") % {
                "method": weg_text, "title": kopf, "body": rumpf})
            if not weg:
                # Nichts war zu sehen – dann bleibt der Eintrag offen und
                # wird beim nächsten Durchgang erneut versucht.
                offen.append(eintrag.get("id"))
                continue
        else:
            wecker_notiz(_("Sound only: %(title)s – %(body)s") % {
                "title": kopf, "body": rumpf})
        gemeldet += 1

    if not gemeldet and not offen:
        wecker_notiz(_("Checked: nothing due (%(appointments)d appointments, "
                        "lead time %(minutes)s min)") % {
            "appointments": anzahl_termine, "minutes": wecker.get("vorlauf", 15)})

    neuer_zustand = ergebnis["zustand"]
    for kennung in offen:
        neuer_zustand["gemeldet"].pop(str(kennung), None)
    erinnerung_zustand_schreiben(neuer_zustand)

    if wecker.get("wecken"):
        weckruf_stellen(naechster_weckzeitpunkt(
            daten, jetzt, int(wecker.get("vorlauf") or 15)))
    return {"gemeldet": gemeldet, "fehler": ""}


# ---------------------------------------------------------------------------
# Adressen weiterverwenden: Brief, Karte, E-Post und Druck
# ---------------------------------------------------------------------------

def datum_kurz(wert):
    """Formatiert ein Datum nach dem früh verfügbaren Formatgebiet."""
    format_gebiet = str(_REGIONAL.get("formatLocale") or "").lower()
    if format_gebiet in ("en-us", "en-ca"):
        return wert.strftime("%m/%d/%Y")
    if format_gebiet.startswith("en"):
        return wert.strftime("%d/%m/%Y")
    return wert.strftime("%d.%m.%Y")


def _xml_sicher(text):
    return (str(text or "")
            .replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


def anschrift_zeilen(kontakt):
    """Die Anschrift, wie sie auf einen Umschlag gehört."""
    k = kontakt or {}
    zeilen = []
    name = " ".join(t for t in ((k.get("vorname") or "").strip(),
                                (k.get("nachname") or "").strip()) if t)
    if name:
        zeilen.append(name)
    if (k.get("firma") or "").strip():
        zeilen.append(k["firma"].strip())
    if (k.get("strasse") or "").strip():
        zeilen.append(k["strasse"].strip())
    ort = " ".join(t for t in ((k.get("plz") or "").strip(),
                               (k.get("ort") or "").strip()) if t)
    if ort:
        zeilen.append(ort)
    return zeilen


def _fodt_brief_kompakt(kontakt, absender="", datum=None):
    """Baut die bisherige kompakte Briefvorlage."""
    datum = datum or datetime.now()
    empfaenger = anschrift_zeilen(kontakt)
    absenderzeile = " · ".join(
        z.strip() for z in (absender or "").splitlines() if z.strip())

    absaetze = []
    if absenderzeile:
        absaetze.append('<text:p text:style-name="Absender">%s</text:p>'
                        % _xml_sicher(absenderzeile))
    else:
        absaetze.append('<text:p text:style-name="Absender"/>')
    for zeile in empfaenger:
        absaetze.append('<text:p text:style-name="Anschrift">%s</text:p>'
                        % _xml_sicher(zeile))
    for _leer in range(max(0, 5 - len(empfaenger))):
        absaetze.append('<text:p text:style-name="Anschrift"/>')
    absaetze.append('<text:p text:style-name="Datum">%s</text:p>'
                    % datum_kurz(datum))
    absaetze.append('<text:p text:style-name="Standard"/>')
    absaetze.append('<text:p text:style-name="Standard">%s</text:p>' %
                    _xml_sicher(_("Dear Sir or Madam,")))
    absaetze.append('<text:p text:style-name="Standard"/>')
    absaetze.append('<text:p text:style-name="Standard"/>')
    absaetze.append('<text:p text:style-name="Standard">%s</text:p>' %
                    _xml_sicher(_("Yours sincerely,")))

    return (
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        '<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"'
        ' xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"'
        ' xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"'
        ' xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"'
        ' office:version="1.2"'
        ' office:mimetype="application/vnd.oasis.opendocument.text">\n'
        '<office:font-face-decls>'
        '<style:font-face style:name="Liberation Sans"'
        ' svg:font-family="Liberation Sans"/>'
        '</office:font-face-decls>\n'
        '<office:styles>\n'
        '<style:style style:name="Standard" style:family="paragraph">'
        '<style:text-properties style:font-name="Liberation Serif"'
        ' fo:font-size="12pt"/></style:style>\n'
        '<style:style style:name="Absender" style:family="paragraph"'
        ' style:parent-style-name="Standard">'
        '<style:paragraph-properties fo:margin-bottom="0.6cm"'
        ' fo:border-bottom="0.02cm solid #808080" fo:padding-bottom="0.1cm"/>'
        '<style:text-properties fo:font-size="8pt"/></style:style>\n'
        '<style:style style:name="Anschrift" style:family="paragraph"'
        ' style:parent-style-name="Standard">'
        '<style:paragraph-properties fo:margin-bottom="0cm"/>'
        '</style:style>\n'
        '<style:style style:name="Datum" style:family="paragraph"'
        ' style:parent-style-name="Standard">'
        '<style:paragraph-properties fo:text-align="end"'
        ' fo:margin-top="1.2cm"/></style:style>\n'
        '</office:styles>\n'
        '<office:body><office:text>\n' + "\n".join(absaetze) +
        '\n</office:text></office:body>\n</office:document>\n')


def fodt_brief(kontakt, absender="", datum=None, layout="compact"):
    """Baut einen editierbaren Brief im flachen ODF-Format.

    Voreingestellt ist die kompakte Absenderzeile. Wahlweise entsteht eine
    DIN-5008-Form-B-Seite mit Fensteranschrift, Absenderblock sowie zwei
    Falt- und einer Lochmarke."""
    if layout in ("kompakt", "compact"):
        return _fodt_brief_kompakt(kontakt, absender, datum)

    datum = datum or datetime.now()
    empfaenger = anschrift_zeilen(kontakt)
    absender_zeilen = [
        z.strip() for z in (absender or "").splitlines() if z.strip()]
    rueckadresse = " · ".join(absender_zeilen)

    sender_absatz = "".join(
        '<text:p text:style-name="Absenderblock">%s</text:p>'
        % _xml_sicher(zeile) for zeile in absender_zeilen)
    if not sender_absatz:
        sender_absatz = '<text:p text:style-name="Absenderblock"/>'
    anschrift_absatz = "".join(
        '<text:p text:style-name="Anschrift">%s</text:p>'
        % _xml_sicher(zeile) for zeile in empfaenger)
    for _leer in range(max(0, 6 - len(empfaenger))):
        anschrift_absatz += '<text:p text:style-name="Anschrift"/>'

    return (
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        '<office:document'
        ' xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"'
        ' xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"'
        ' xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"'
        ' xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"'
        ' xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"'
        ' xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"'
        ' office:version="1.2"'
        ' office:mimetype="application/vnd.oasis.opendocument.text">\n'
        '<office:styles>\n'
        '<style:default-style style:family="paragraph">'
        '<style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0cm"'
        ' fo:line-height="100%"/>'
        '<style:text-properties style:font-name="Liberation Sans"'
        ' fo:font-family="Liberation Sans"'
        ' fo:font-size="11pt"/></style:default-style>\n'
        '<style:style style:name="Standard" style:family="paragraph">'
        '<style:paragraph-properties fo:margin-bottom="0.42cm"'
        ' fo:line-height="120%"/>'
        '<style:text-properties style:font-name="Liberation Sans"'
        ' fo:font-family="Liberation Sans"'
        ' fo:font-size="11pt"/></style:style>\n'
        '<style:style style:name="Objekte" style:family="paragraph">'
        '<style:paragraph-properties fo:margin="0cm" fo:line-height="1%"/>'
        '<style:text-properties fo:font-size="1pt"/></style:style>\n'
        '<style:style style:name="Briefbeginn" style:family="paragraph"'
        ' style:parent-style-name="Standard">'
        '<style:paragraph-properties fo:margin-top="8.55cm"'
        ' fo:margin-bottom="0.42cm"/></style:style>\n'
        '<style:style style:name="Absenderblock" style:family="paragraph">'
        '<style:paragraph-properties fo:text-align="end" fo:margin-bottom="0.05cm"'
        ' fo:line-height="112%"/>'
        '<style:text-properties style:font-name="Liberation Sans"'
        ' fo:font-family="Liberation Sans"'
        ' fo:font-size="9pt"/></style:style>\n'
        '<style:style style:name="Rueckadresse" style:family="paragraph">'
        '<style:paragraph-properties fo:margin-bottom="0.35cm"'
        ' fo:line-height="100%"/>'
        '<style:text-properties style:font-name="Liberation Sans"'
        ' fo:font-family="Liberation Sans"'
        ' fo:font-size="8pt" style:text-underline-style="solid"'
        ' style:text-underline-width="auto"/></style:style>\n'
        '<style:style style:name="Anschrift" style:family="paragraph">'
        '<style:paragraph-properties fo:margin-bottom="0cm" fo:line-height="110%"/>'
        '<style:text-properties style:font-name="Liberation Sans"'
        ' fo:font-family="Liberation Sans"'
        ' fo:font-size="10pt"/></style:style>\n'
        '<style:style style:name="Datum" style:family="paragraph">'
        '<style:paragraph-properties fo:text-align="end"/>'
        '<style:text-properties style:font-name="Liberation Sans"'
        ' fo:font-family="Liberation Sans"'
        ' fo:font-size="10pt"/></style:style>\n'
        '</office:styles>\n'
        '<office:automatic-styles>'
        '<style:style style:name="Rahmen" style:family="graphic">'
        '<style:graphic-properties draw:stroke="none" draw:fill="none"'
        ' style:wrap="run-through"/></style:style>'
        '<style:style style:name="Marke" style:family="graphic">'
        '<style:graphic-properties draw:stroke="solid" draw:fill="none"'
        ' svg:stroke-color="#555555" svg:stroke-width="0.02cm"/>'
        '</style:style>'
        '<style:page-layout style:name="A4FormB">'
        '<style:page-layout-properties fo:page-width="21cm"'
        ' fo:page-height="29.7cm" style:print-orientation="portrait"'
        ' fo:margin-top="2cm" fo:margin-bottom="2cm"'
        ' fo:margin-left="2.5cm" fo:margin-right="2cm"/>'
        '</style:page-layout>'
        '</office:automatic-styles>\n'
        '<office:master-styles>'
        '<style:master-page style:name="Standard"'
        ' style:page-layout-name="A4FormB"/>'
        '</office:master-styles>\n'
        '<office:body><office:text>\n'
        '<text:p text:style-name="Objekte">'
        '<draw:frame draw:style-name="Rahmen" draw:name="Absenderblock"'
        ' text:anchor-type="page" svg:x="10cm" svg:y="-0.4cm"'
        ' svg:width="6.5cm" svg:height="2.6cm"><draw:text-box>'
        + sender_absatz +
        '</draw:text-box></draw:frame>'
        '<draw:frame draw:style-name="Rahmen" draw:name="Anschriftfeld"'
        ' text:anchor-type="page" svg:x="-0.5cm" svg:y="2.5cm"'
        ' svg:width="8.5cm" svg:height="4.5cm"><draw:text-box>'
        '<text:p text:style-name="Rueckadresse">%s</text:p>' %
        _xml_sicher(rueckadresse) +
        anschrift_absatz +
        '</draw:text-box></draw:frame>'
        '<draw:frame draw:style-name="Rahmen" draw:name="Datum"'
        ' text:anchor-type="page" svg:x="10cm" svg:y="7.35cm"'
        ' svg:width="6.5cm" svg:height="0.65cm"><draw:text-box>'
        '<text:p text:style-name="Datum">%s</text:p></draw:text-box>'
        '</draw:frame>' % datum_kurz(datum) +
        '<draw:line draw:style-name="Marke" draw:name="Faltmarke-oben"'
        ' text:anchor-type="page" svg:x1="-1cm" svg:y1="8.5cm"'
        ' svg:x2="-0.3cm" svg:y2="8.5cm"/>'
        '<draw:line draw:style-name="Marke" draw:name="Lochmarke"'
        ' text:anchor-type="page" svg:x1="-1cm" svg:y1="12.85cm"'
        ' svg:x2="0cm" svg:y2="12.85cm"/>'
        '<draw:line draw:style-name="Marke" draw:name="Faltmarke-unten"'
        ' text:anchor-type="page" svg:x1="-1cm" svg:y1="19cm"'
        ' svg:x2="-0.3cm" svg:y2="19cm"/>'
        '</text:p>\n'
        '<text:p text:style-name="Briefbeginn"/>\n'
        '<text:p text:style-name="Standard">%s</text:p>\n' %
        _xml_sicher(_("Dear Sir or Madam,")) +
        '<text:p text:style-name="Standard"/>\n'
        '<text:p text:style-name="Standard"/>\n'
        '<text:p text:style-name="Standard">%s</text:p>\n' %
        _xml_sicher(_("Yours sincerely,")) +
        '</office:text></office:body>\n</office:document>\n')


_AUSGABE_PRAEFIXE = ("magnolie-brief-", "magnolie-druck-", "magnolie-ods-")
_AUSGABE_MAX_ALTER = 7 * 24 * 60 * 60


def _temporaere_basis():
    laufzeit = os.environ.get("XDG_RUNTIME_DIR", "")
    try:
        stand = os.stat(laufzeit)
        if (laufzeit and os.path.isdir(laufzeit) and stand.st_uid == os.getuid()
                and stand.st_mode & 0o077 == 0):
            return laufzeit
    except OSError:
        pass
    return tempfile.gettempdir()


def temporaere_ausgaben_bereinigen(basis=None, jetzt=None, max_alter=None):
    """Entfernt ausschließlich eigene, alte Magnolie-Ausgabeverzeichnisse."""
    basis = basis or _temporaere_basis()
    jetzt = time.time() if jetzt is None else float(jetzt)
    max_alter = _AUSGABE_MAX_ALTER if max_alter is None else float(max_alter)
    entfernt = 0
    try:
        eintraege = list(os.scandir(basis))
    except OSError:
        return 0
    for eintrag in eintraege:
        if not eintrag.name.startswith(_AUSGABE_PRAEFIXE):
            continue
        try:
            stand = eintrag.stat(follow_symlinks=False)
            if (not eintrag.is_dir(follow_symlinks=False)
                    or stand.st_uid != os.getuid()
                    or jetzt - stand.st_mtime < max_alter):
                continue
            shutil.rmtree(eintrag.path)
            entfernt += 1
        except OSError:
            continue
    return entfernt


def _temporaerer_ausgabeordner(praefix):
    basis = _temporaere_basis()
    temporaere_ausgaben_bereinigen(basis)
    ordner = tempfile.mkdtemp(prefix=praefix, dir=basis)
    os.chmod(ordner, 0o700)
    return ordner


def _private_ausgabe_schreiben(pfad, daten, binaer=False):
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(pfad, flags, 0o600)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb" if binaer else "w",
                       **({} if binaer else {"encoding": "utf-8"})) as datei:
            fd = -1
            datei.write(daten)
    finally:
        if fd >= 0:
            os.close(fd)


def brief_oeffnen(kontakt, absender="", starter=None, ordner=None,
                  layout="compact"):
    """Legt den Brief ab und öffnet ihn in LibreOffice."""
    import subprocess
    if not anschrift_zeilen(kontakt):
        return {"ok": False, "pfad": "", "womit": "",
                "fehler": _("This contact card has no postal address.")}
    ordner = ordner or _temporaerer_ausgabeordner("magnolie-brief-")
    name = "".join(z for z in ((kontakt.get("nachname") or "")
                               + "-" + (kontakt.get("vorname") or ""))
                   if z.isalnum() or z in "-_") or "Brief"
    pfad = os.path.join(ordner, "Brief-%s.fodt" % name)
    try:
        _private_ausgabe_schreiben(
            pfad, fodt_brief(kontakt, absender, layout=layout))
    except OSError as fehler:
        return {"ok": False, "pfad": pfad, "womit": "",
                "fehler": fehler_deutsch(fehler, _("Creating the letter"))}

    if starter is None:
        def starter(argumente):
            subprocess.Popen(argumente, start_new_session=True,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
    for befehl in (["libreoffice", "--writer", pfad], ["soffice", pfad],
                   ["xdg-open", pfad]):
        werkzeug = shutil.which(befehl[0])
        if not werkzeug:
            continue
        try:
            starter([werkzeug] + befehl[1:])
        except OSError:
            continue
        return {"ok": True, "pfad": pfad, "womit": befehl[0], "fehler": ""}
    return {"ok": False, "pfad": pfad, "womit": "",
            "fehler": _("LibreOffice was not found. The letter is located at: %s")
                      % pfad}


def libreoffice_einstellungsdatei(basis=None):
    """Sucht die Datei, in der LibreOffice die Benutzerdaten führt."""
    basis = basis or (os.environ.get("XDG_CONFIG_HOME")
                      or os.path.expanduser("~/.config"))
    kandidaten = []
    for wurzel in (os.path.join(basis, "libreoffice"),
                   os.path.join(basis, "..", ".libreoffice"),
                   os.path.join(basis, "..",
                                ".var/app/org.libreoffice.LibreOffice/config/"
                                "libreoffice")):
        if not os.path.isdir(wurzel):
            continue
        try:
            fassungen = sorted(os.listdir(wurzel), reverse=True)
        except OSError:
            continue
        for fassung in fassungen:
            pfad = os.path.join(wurzel, fassung, "user",
                                "registrymodifications.xcu")
            if os.path.isfile(pfad):
                kandidaten.append(os.path.realpath(pfad))
    return kandidaten[0] if kandidaten else ""


def _xml_zurueck(text):
    """Macht die Ersatzzeichen einer XML-Datei wieder lesbar."""
    for zeichen, klar in (("&lt;", "<"), ("&gt;", ">"), ("&quot;", '"'),
                          ("&apos;", "'"), ("&amp;", "&")):
        text = text.replace(zeichen, klar)
    return text


_LO_FELD = re.compile(
    r'oor:name="([A-Za-z]+)"[^>]*>\s*<value>([^<]*)</value>')


def libreoffice_benutzerdaten(pfad=None):
    """Liest Name und Anschrift aus den Benutzerdaten von LibreOffice.

    Dort trägt man sie ohnehin einmal ein; für den Briefabsender lassen
    sie sich dann übernehmen, statt alles noch einmal zu tippen."""
    pfad = pfad or libreoffice_einstellungsdatei()
    if not pfad or not os.path.isfile(pfad):
        return {"ok": False, "felder": {}, "absender": "",
                "fehler": _("No user data has been entered in LibreOffice yet "
                            "(Tools ▸ Options ▸ User Data).")}
    try:
        with open(pfad, "r", encoding="utf-8", errors="replace") as datei:
            text = datei.read()
    except OSError as fehler:
        return {"ok": False, "felder": {}, "absender": "",
                "fehler": fehler_deutsch(fehler, _("Reading the user data"))}

    interessant = ("givenname", "sn", "o", "street", "postalcode", "l", "c",
                   "mail", "telephonenumber", "homephone")
    felder = {}
    for stueck in text.split("UserProfile/Data")[1:]:
        for name, wert in _LO_FELD.findall(stueck[:4000]):
            if name in interessant and name not in felder and wert.strip():
                felder[name] = _xml_zurueck(wert.strip())

    zeilen = []
    name = " ".join(t for t in (felder.get("givenname", ""),
                                felder.get("sn", "")) if t)
    if name:
        zeilen.append(name)
    if felder.get("o"):
        zeilen.append(felder["o"])
    if felder.get("street"):
        zeilen.append(felder["street"])
    ort = " ".join(t for t in (felder.get("postalcode", ""),
                               felder.get("l", "")) if t)
    if ort:
        zeilen.append(ort)
    if felder.get("c"):
        zeilen.append(felder["c"])

    if not zeilen:
        return {"ok": False, "felder": felder, "absender": "",
                "fehler": _("The LibreOffice user data does not contain an address "
                            "yet (Tools ▸ Options ▸ User Data).")}
    return {"ok": True, "felder": felder, "absender": "\n".join(zeilen),
            "fehler": ""}


def karten_adresse(kontakt, land="Deutschland"):
    """Die Anschrift in einer Zeile, wie sie ein Kartendienst versteht.

    Ohne Land findet kein Dienst zuverlässig etwas – „Hauptstraße 12,
    47051 Duisburg" gibt es weltweit mehrfach oder gar nicht."""
    k = kontakt or {}
    ort = " ".join(t for t in ((k.get("plz") or "").strip(),
                               (k.get("ort") or "").strip()) if t)
    teile = [(k.get("strasse") or "").strip(), ort]
    zeile = ", ".join(t for t in teile if t)
    if not zeile:
        return ""
    land = (land or "").strip()
    if land and land.lower() not in zeile.lower():
        zeile += ", " + land
    return zeile


def eigene_route_adresse(absender, land="Deutschland"):
    """Macht aus der eigenen Anschrift eine Zeile für den Kartendienst.

    Aus „Erika Beispiel / Musterweg 3 / 47051 Duisburg" wird
    „Musterweg 3, 47051 Duisburg, Deutschland" – der Name gehört nicht in
    eine Wegbeschreibung, Straße und Ort schon."""
    zeilen = [z.strip() for z in (absender or "").splitlines() if z.strip()]
    if not zeilen:
        return ""
    # Zeilen mit Ziffern sind Straße und Postleitzahl; Namen haben keine.
    mit_zahl = [z for z in zeilen if any(c.isdigit() for c in z)]
    teile = mit_zahl if mit_zahl else zeilen[1:]
    zeile = ", ".join(teile).strip(", ")
    if not zeile:
        return ""
    land = (land or "").strip()
    if land and land.lower() not in zeile.lower():
        zeile += ", " + land
    return zeile


def karten_wege(adresse, dienst="auto", route=False, von=""):
    """Liefert die möglichen Wege, eine Anschrift auf der Karte zu zeigen.

    Mit ``route=True`` wird nicht nur der Ort gezeigt, sondern gleich der
    Weg dorthin berechnet – vom eigenen Standort aus."""
    from urllib.parse import quote
    frage = quote(adresse)
    geo = "geo:0,0?q=" + frage
    adresse = adresse or ""

    if route:
        # Ohne Ausgangspunkt berechnet kein Dienst einen Weg – deshalb
        # wird die eigene Anschrift mitgegeben, sofern sie hinterlegt ist.
        start = quote(von or "")
        wege = []
        if dienst in ("auto", "gnome-maps"):
            ziel = "maps:daddr=" + frage
            if start:
                ziel = "maps:saddr=" + start + "&daddr=" + frage
            wege.append(("gnome-maps", ["gnome-maps", ziel], ""))
        if dienst in ("auto", "openstreetmap"):
            adr = "https://www.openstreetmap.org/directions?"
            if start:
                adr += "from=" + start + "&"
            adr += "to=" + frage
            wege.append(("openstreetmap", ["xdg-open", adr], ""))
        if dienst == "google":
            adr = "https://www.google.com/maps/dir/?api=1&destination=" + frage
            if start:
                adr += "&origin=" + start
            wege.append(("google", ["xdg-open", adr], ""))
        return wege
    # (Name, Befehl, zusätzlich benötigtes Programm)
    wege = []
    if dienst in ("auto", "gnome-maps"):
        # Gnome-Karten versteht die Suchadresse „maps:q=…" zuverlässiger als
        # eine geo-Adresse ohne Koordinaten – letztere führt oft nur zu
        # „Geo-Adresse konnte nicht geöffnet werden".
        wege.append(("gnome-maps", ["gnome-maps", "maps:q=" + frage], ""))
        wege.append(("gnome-maps", ["gnome-maps", adresse], ""))
        wege.append(("gnome-maps", ["gnome-maps", geo], ""))
        # Über gio nur dann, wenn Gnome-Karten wirklich vorhanden sind –
        # sonst landet die Adresse irgendwo, aber nicht auf einer Karte.
        wege.append(("gnome-maps", ["gio", "open", geo], "gnome-maps"))
    if dienst in ("auto", "openstreetmap"):
        wege.append(("openstreetmap",
                     ["xdg-open",
                      "https://www.openstreetmap.org/search?query=" + frage], ""))
    if dienst == "google":
        wege.append(("google",
                     ["xdg-open",
                      "https://www.google.com/maps/search/?api=1&query="
                      + frage], ""))
    return wege


def karte_oeffnen(kontakt, dienst="auto", starter=None, land="Deutschland",
                  route=False, absender=""):
    """Zeigt die Anschrift auf der Karte – in Gnome-Karten, sonst im Netz.
    Mit ``route`` wird gleich der Weg dorthin berechnet."""
    import subprocess
    adresse = karten_adresse(kontakt, land)
    if not adresse:
        return {"ok": False, "womit": "",
                "fehler": _("This contact card has no postal address.")}
    if starter is None:
        def starter(argumente):
            subprocess.Popen(argumente, start_new_session=True,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
    von = eigene_route_adresse(absender, land) if route else ""
    for name, befehl, benoetigt in karten_wege(adresse, dienst, route, von):
        werkzeug = shutil.which(befehl[0])
        if not werkzeug or (benoetigt and not shutil.which(benoetigt)):
            continue
        try:
            starter([werkzeug] + befehl[1:])
        except OSError:
            continue
        return {"ok": True, "womit": name, "fehler": ""}
    return {"ok": False, "womit": "",
            "fehler": _("No map service was found. GNOME Maps can be installed "
                        "with: sudo apt install gnome-maps")}


def mail_oeffnen(email, betreff="", starter=None, name=""):
    """Öffnet das Post-Programm mit einer neuen Nachricht."""
    import subprocess
    from urllib.parse import quote
    email = _email_adresse(email)
    if not email:
        return {"ok": False, "fehler":
                _("This contact card has no email address.")}
    anzeigename = " ".join(str(name or "").replace("\r", " ").replace("\n", " ")
                            .replace("<", "").replace(">", "").split())
    empfaenger = (anzeigename + " <" + email + ">") if anzeigename else email
    ziel = "mailto:" + quote(empfaenger, safe="@._+-")
    if betreff:
        ziel += "?subject=" + quote(betreff)
    if starter is None:
        def starter(argumente):
            subprocess.Popen(argumente, start_new_session=True,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
    for name in ("xdg-open", "gio"):
        werkzeug = shutil.which(name)
        if not werkzeug:
            continue
        argumente = ([werkzeug, "open", ziel] if name == "gio"
                     else [werkzeug, ziel])
        try:
            starter(argumente)
        except OSError:
            continue
        return {"ok": True, "womit": name, "fehler": ""}
    return {"ok": False, "fehler": _("No mail application was found.")}


_KDECONNECT_BACKEND = None
_KDECONNECT_SPERRE = threading.Lock()


def _kdeconnect_backend(callback=None):
    global _KDECONNECT_BACKEND
    with _KDECONNECT_SPERRE:
        if _KDECONNECT_BACKEND is None:
            _KDECONNECT_BACKEND = KDEConnectSMSBackend(
                os.path.join(daten_verzeichnis(), "kdeconnect"),
                callback=callback)
        elif callback is not None:
            _KDECONNECT_BACKEND.callback = callback
        backend = _KDECONNECT_BACKEND
    backend.start()
    return backend


def kdeconnect_sms_stand(welcher=None, ausfuehren=None):
    """Reports the direct backend; old arguments remain harmless for callers."""
    try:
        return _kdeconnect_backend().status()
    except Exception:
        return {"available": False, "device_count": 0, "device_id": "",
                "reason": "backend_error", "pairing_state": "idle"}


def kdeconnect_sms_senden(nummer, text, land="DE", welcher=None, ausfuehren=None):
    ziel = _telefon_schluessel(str(nummer or ""), land).split("x", 1)[0]
    nachricht = str(text or "")
    if len(ziel) < 6 or not nachricht.strip() or len(nachricht) > 5000:
        raise ValueError(_("The SMS recipient or message is invalid."))
    return _kdeconnect_backend().send_sms(ziel, nachricht)


_FLATPAK_PROGRAMME = {
    "whatsie": ["com.ktechpit.whatsie"],
    "zapzap": ["com.rtosta.zapzap"],
    "threema-desktop": ["ch.threema.threema-desktop"],
    "signal-desktop": ["org.signal.Signal"],
    "kdeconnect-sms": ["org.kde.kdeconnect"],
    "skypeforlinux": ["com.skype.Client"],
    "linphone": ["com.belledonnecommunications.linphone"],
    "jami": ["net.jami.Jami"]}


def _flatpak_installiert(app_id):
    datei = app_id + ".desktop"
    return any(os.path.isfile(os.path.join(basis, datei)) for basis in (
        os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
        "/var/lib/flatpak/exports/share/applications"))


def sozial_oeffnen(dienst, wert, starter=None, welcher=None, land="Deutschland",
                   aktion_art="", aktion_ziel=""):
    """Öffnet einen Kommunikationsweg ohne Kontaktwerte als Befehl auszuführen."""
    import subprocess
    from urllib.parse import quote, urlparse
    dienst = {"telefon": "phone", "phone": "phone", "twitter": "x", "x": "x",
               "likedin": "linkedin", "linkedin": "linkedin"}.get(
        str(dienst or "").strip().lower(), str(dienst or "").strip().lower())
    wert = str(wert or "").strip()[:500]
    namen = {"whatsapp": "WhatsApp", "threema": "Threema",
             "facebook": "Facebook", "instagram": "Instagram",
             "signal": "Signal", "mastodon": "Mastodon", "teams": "Teams",
             "snapchat": "Snapchat", "tiktok": "TikTok", "youtube": "YouTube",
             "telegram": "Telegram", "x": _("X (formerly Twitter)"),
             "linkedin": "LinkedIn", "reddit": "Reddit", "custom": _("Custom"),
             "sms": "SMS",
             "phone": _("Phone call")}
    if dienst not in namen or not wert:
        return {"ok": False, "fehler":
                _("The communication method is incomplete.")}
    welcher = welcher or shutil.which
    aktion_art = {"webseite": "website", "website": "website",
                  "programm": "program", "program": "program"}.get(
                      str(aktion_art or "").strip().lower(), "")
    aktion_ziel = str(aktion_ziel or "").strip()[:500]
    if starter is None:
        def starter(argumente):
            subprocess.Popen(argumente, start_new_session=True,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)

    land_code = {"deutschland": "DE", "germany": "DE", "de": "DE",
                 "osterreich": "AT", "oesterreich": "AT", "austria": "AT",
                 "at": "AT", "schweiz": "CH", "switzerland": "CH",
                 "ch": "CH"}.get(kanonischer_text(land), "DE")
    nummer = _telefon_schluessel(wert, land_code).split("x", 1)[0]
    if dienst in ("whatsapp", "signal", "sms", "phone") and len(nummer) < 6:
        return {"ok": False, "fehler": _("Enter a complete phone number.")}

    if wert.startswith("https://"):
        try:
            parsed = urlparse(wert)
            webziel = (wert if parsed.netloc and not parsed.username and
                       not parsed.password else "")
        except ValueError:
            webziel = ""
    else:
        webziel = ""
    if dienst == "whatsapp":
        webziel = "https://wa.me/" + nummer.lstrip("+")
        programme = ["whatsie", "wasistlos", "zapzap"]
    elif dienst == "threema":
        webziel = webziel or "https://web.threema.ch/"
        programme = ["threema-desktop", "threema"]
    elif dienst == "facebook":
        webziel = webziel or "https://www.facebook.com/" + quote(wert.lstrip("@"), safe="")
        programme = []
    elif dienst == "instagram":
        webziel = webziel or "https://www.instagram.com/" + quote(wert.lstrip("@"), safe="")
        programme = []
    elif dienst == "signal":
        webziel = "https://signal.me/#p/" + quote(nummer, safe="+")
        programme = ["signal-desktop"]
    elif dienst == "mastodon":
        teile = wert.lstrip("@").split("@")
        if not webziel and len(teile) == 2 and re.match(r"^[A-Za-z0-9.-]+$", teile[1]):
            webziel = "https://%s/@%s" % (teile[1], quote(teile[0], safe=""))
        if not webziel:
            return {"ok": False, "fehler":
                    _("Enter the complete Mastodon address @name@server or an "
                      "HTTPS address.")}
        programme = []
    elif dienst == "teams":
        webziel = webziel or ("https://teams.microsoft.com/l/chat/0/0?users=" +
                              quote(wert, safe="@._+-"))
        programme = []
    elif dienst == "snapchat":
        webziel = webziel or "https://www.snapchat.com/add/" + quote(
            wert.lstrip("@"), safe="")
        programme = []
    elif dienst == "tiktok":
        webziel = webziel or "https://www.tiktok.com/@" + quote(
            wert.lstrip("@"), safe="")
        programme = []
    elif dienst == "youtube":
        webziel = webziel or "https://www.youtube.com/@" + quote(
            wert.lstrip("@"), safe="")
        programme = []
    elif dienst == "telegram":
        webziel = webziel or "https://t.me/" + quote(wert.lstrip("@"), safe="")
        programme = []
    elif dienst == "x":
        webziel = webziel or "https://x.com/" + quote(wert.lstrip("@"), safe="")
        programme = []
    elif dienst == "linkedin":
        webziel = webziel or "https://www.linkedin.com/in/" + quote(
            wert.lstrip("@"), safe="")
        programme = []
    elif dienst == "reddit":
        webziel = webziel or "https://www.reddit.com/user/" + quote(
            wert.lstrip("@"), safe="")
        programme = []
    elif dienst == "custom":
        if not webziel and not aktion_art:
            return {"ok": False, "fehler":
                    _("Enter a secure HTTPS address for the custom medium.")}
        programme = []
    elif dienst == "sms":
        webziel = "sms:" + quote(nummer, safe="+")
        programme = []
    else:
        webziel = "tel:" + quote(nummer, safe="+")
        programme = ["skypeforlinux", "skype", "linphone", "jami", "ekiga"]

    if aktion_art == "website":
        vorlage = aktion_ziel.replace("{wert}", quote(wert, safe="@._+-"))
        vorlage = vorlage.replace("{nummer}", quote(nummer, safe="+"))
        vorlage = vorlage.replace("{ziel}", quote(webziel, safe=""))
        try:
            parsed = urlparse(vorlage)
            webziel = (vorlage if parsed.scheme == "https" and parsed.netloc and
                       not parsed.username and not parsed.password else "")
        except ValueError:
            webziel = ""
        if not webziel:
            return {"ok": False, "fehler":
                    _("The custom website is not a secure HTTPS address.")}
        programme = []
    elif aktion_art == "program":
        try:
            kommando = shlex.split(aktion_ziel)
        except ValueError:
            kommando = []
        if not kommando or len(kommando) > 20 or any("\x00" in teil for teil in kommando):
            return {"ok": False, "fehler":
                    _("The custom application command is invalid.")}
        sandbox = re.match(r"^(flatpak|snap):([A-Za-z0-9._-]+)$", kommando[0])
        if sandbox:
            pfad = welcher(sandbox.group(1))
            vorspann = [pfad, "run", sandbox.group(2)] if pfad else []
        else:
            pfad = welcher(kommando[0])
            vorspann = [pfad] if pfad else []
        if not pfad:
            return {"ok": False, "fehler":
                    _("The custom application was not found.")}
        platzhalter = any(any(marke in teil for marke in
                              ("{ziel}", "{wert}", "{nummer}")) for teil in kommando[1:])
        argumente = vorspann
        for teil in kommando[1:]:
            argumente.append(teil.replace("{ziel}", webziel)
                              .replace("{wert}", wert).replace("{nummer}", nummer))
        if not platzhalter:
            argumente.append(webziel)
        try:
            starter(argumente)
            return {"ok": True, "womit": kommando[0], "name": namen[dienst],
                    "fehler": ""}
        except OSError:
            return {"ok": False, "fehler":
                    _("The custom application could not be started.")}

    for programm in programme:
        pfad = welcher(programm)
        if not pfad:
            continue
        argument = ("skype:%s?call" % nummer if programm.startswith("skype")
                    else webziel)
        try:
            starter([pfad, argument])
            return {"ok": True, "womit": programm, "name": namen[dienst],
                    "fehler": ""}
        except OSError:
            continue
    flatpak = welcher("flatpak")
    if flatpak:
        for programm in programme:
            for app_id in _FLATPAK_PROGRAMME.get(programm, []):
                if not _flatpak_installiert(app_id):
                    continue
                try:
                    starter([flatpak, "run", app_id, webziel])
                    return {"ok": True, "womit": "flatpak:" + app_id,
                            "name": namen[dienst], "fehler": ""}
                except OSError:
                    continue
    for programm in ("xdg-open", "gio"):
        pfad = welcher(programm)
        if not pfad:
            continue
        argumente = [pfad, "open", webziel] if programm == "gio" else [pfad, webziel]
        try:
            starter(argumente)
            return {"ok": True, "womit": programm, "name": namen[dienst],
                    "fehler": ""}
        except OSError:
            continue
    return {"ok": False, "fehler": _("No suitable application was found.")}


def drucken(html, name="magnolie-druck", starter=None, ordner=None):
    """Druckt eine Seite: bevorzugt über den Druckdialog des Systems,
    ersatzweise wird die Seite im Betrachter geöffnet."""
    import subprocess
    ordner = ordner or _temporaerer_ausgabeordner("magnolie-druck-")
    pfad = os.path.join(ordner, name + ".html")
    try:
        _private_ausgabe_schreiben(pfad, html)
    except OSError as fehler:
        return {"ok": False, "pfad": "", "womit": "",
                "fehler": fehler_deutsch(fehler, _("Creating the print page"))}

    if starter is None and WEBKIT_OK and anzeige_bereit():
        try:
            ansicht = WebKit2.WebView()
            ansicht.get_settings().set_enable_javascript(False)
            fertig = {"getan": False}

            def bei_fertig(_ansicht, ereignis):
                if ereignis != WebKit2.LoadEvent.FINISHED or fertig["getan"]:
                    return
                fertig["getan"] = True
                auftrag = WebKit2.PrintOperation.new(_ansicht)
                auftrag.run_dialog(None)

            ansicht.connect("load-changed", bei_fertig)
            ansicht.load_uri(GLib.filename_to_uri(pfad, None))
            return {"ok": True, "pfad": pfad, "womit": "druckdialog",
                    "fehler": "", "ansicht": ansicht}
        except Exception:
            pass

    if starter is None:
        def starter(argumente):
            subprocess.Popen(argumente, start_new_session=True,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
    werkzeug = shutil.which("xdg-open")
    if werkzeug:
        try:
            starter([werkzeug, pfad])
            return {"ok": True, "pfad": pfad, "womit": "xdg-open", "fehler": ""}
        except OSError:
            pass
    return {"ok": False, "pfad": pfad, "womit": "",
            "fehler": _("The print page is located at: %s") % pfad}


ODS_MAX_ZEILEN = 5000
ODS_MAX_SPALTEN = 16
ODS_MAX_ZEICHEN = 10000
ODS_MAX_GESAMT = 4 * 1024 * 1024
ODS_MAX_BLAETTER = 24
ODS_KALENDER_STILE = {"", "empty", "outside", "week-number", "saturday",
                       "sunday", "vacation", "personal-vacation", "holiday",
                       "holiday-vacation"}


def _ods_xml_text(wert):
    """Entfernt in XML 1.0 unzulässige Zeichen und maskiert Benutzerdaten."""
    from xml.sax.saxutils import escape
    text = str(wert or "")
    text = "".join(zeichen for zeichen in text if
                   zeichen in "\t\n\r" or ord(zeichen) >= 0x20)
    return escape(text, {'"': "&quot;"})


def adressen_ods_pruefen(titel, spalten, zeilen, zellstile=None):
    """Normalisiert eine kleine, rechteckige Tabelle aus der Web-Brücke."""
    if not isinstance(titel, str) or len(titel) > 160:
        raise ValueError(_("The ODS title is invalid."))
    if (not isinstance(spalten, list) or not 1 <= len(spalten) <= ODS_MAX_SPALTEN or
            any(not isinstance(wert, str) or len(wert) > 160 for wert in spalten)):
        raise ValueError(_("The ODS columns are invalid."))
    if not isinstance(zeilen, list) or not zeilen or len(zeilen) > ODS_MAX_ZEILEN:
        raise ValueError(_("The ODS row count is invalid."))
    gesamt = len(titel) + sum(len(wert) for wert in spalten)
    ausgabe = []
    for zeile in zeilen:
        if not isinstance(zeile, list) or len(zeile) != len(spalten):
            raise ValueError(_("An ODS row has the wrong number of columns."))
        if any(not isinstance(wert, str) or len(wert) > ODS_MAX_ZEICHEN
               for wert in zeile):
            raise ValueError(_("An ODS cell is too long."))
        gesamt += sum(len(wert) for wert in zeile)
        if gesamt > ODS_MAX_GESAMT:
            raise ValueError(_("The ODS export is too large."))
        ausgabe.append(list(zeile))
    stile = None
    if zellstile is not None:
        if (not isinstance(zellstile, list) or len(zellstile) != len(ausgabe) or
                any(not isinstance(zeile, list) or len(zeile) != len(spalten)
                    for zeile in zellstile) or
                any(stil not in ODS_KALENDER_STILE
                    for zeile in zellstile for stil in zeile)):
            raise ValueError(_("The ODS cell styles are invalid."))
        stile = [list(zeile) for zeile in zellstile]
    return titel, list(spalten), ausgabe, stile


def planer_ods_inhalte_pruefen(inhalte, zeilen, spalten):
    """Prüft strukturierte Kalenderzellen für die drucknahe ODS-Ausgabe."""
    if inhalte is None:
        return None
    if (not isinstance(inhalte, list) or len(inhalte) != len(zeilen) or
            any(not isinstance(reihe, list) or len(reihe) != len(spalten)
                for reihe in inhalte)):
        raise ValueError(_("The ODS calendar content is invalid."))
    ausgabe = []
    for reihe in inhalte:
        neu = []
        for zelle in reihe:
            if not isinstance(zelle, dict):
                raise ValueError(_("The ODS calendar content is invalid."))
            datum = zelle.get("datum") or ""
            marker = zelle.get("marker") or []
            eintraege = zelle.get("eintraege") or []
            mehr = zelle.get("mehr") or 0
            if (not isinstance(datum, str) or len(datum) > 80 or
                    not isinstance(marker, list) or len(marker) > 12 or
                    not isinstance(eintraege, list) or len(eintraege) > 6 or
                    not isinstance(mehr, int) or mehr < 0 or mehr > 999):
                raise ValueError(_("The ODS calendar content is invalid."))
            def element(wert, mit_art=False):
                if not isinstance(wert, dict):
                    raise ValueError(_("The ODS calendar content is invalid."))
                text = wert.get("text") or ""
                farbe = str(wert.get("farbe") or "#8b6a35").lower()
                art = wert.get("art") or ""
                if (not isinstance(text, str) or len(text) > 500 or
                        not re.fullmatch(r"#[0-9a-f]{6}", farbe) or
                         not isinstance(art, str) or (mit_art and len(spalten) == 8 and art not in
                        ("termin", "jahrestag", "schicht", "feiertag", "ferien", "urlaub",
                         "muell"))):
                    raise ValueError(_("The ODS calendar content is invalid."))
                return {"text": text, "farbe": farbe, "art": art}
            neu.append({"datum": datum, "marker": [element(x) for x in marker],
                        "eintraege": [element(x, True) for x in eintraege], "mehr": mehr})
        ausgabe.append(neu)
    return ausgabe


def magnolie_logo_pfad():
    hier = os.path.dirname(os.path.abspath(__file__))
    kandidaten = [
        os.path.join(hier, "..", "symbole", "128x128", "magnolie-organizer.png"),
        "/usr/share/icons/hicolor/128x128/apps/magnolie-organizer.png",
        os.path.join(hier, "..", "symbole", "magnolie-organizer.svg"),
        "/usr/share/icons/hicolor/scalable/apps/magnolie-organizer.svg",
    ]
    return next((os.path.abspath(pfad) for pfad in kandidaten
                 if os.path.isfile(pfad)), "")


def adressen_ods_bytes(titel, spalten, zeilen, logo_pfad=None,
                       zellstile=None, kompakt=False, kalenderinhalte=None):
    """Erzeugt ein vollständiges OpenDocument Spreadsheet im Speicher."""
    titel, spalten, zeilen, zellstile = adressen_ods_pruefen(
        titel, spalten, zeilen, zellstile)
    kalenderinhalte = planer_ods_inhalte_pruefen(
        kalenderinhalte, zeilen, spalten)
    ist_monat = bool(kompakt and len(spalten) == 8)
    ist_jahr = bool(kompakt and len(spalten) == 12)
    logo_pfad = magnolie_logo_pfad() if logo_pfad is None else logo_pfad
    logo = b""
    logo_name = ""
    logo_medientyp = ""
    if logo_pfad:
        try:
            with open(logo_pfad, "rb") as datei:
                logo = datei.read(1024 * 1024 + 1)
            if logo.startswith(b"\x89PNG\r\n\x1a\n"):
                logo_name, logo_medientyp = "magnolie-organizer.png", "image/png"
            elif logo.lstrip().startswith((b"<svg", b"<?xml")):
                ET.fromstring(logo)
                logo_name, logo_medientyp = "magnolie-organizer.svg", "image/svg+xml"
            else:
                logo = b""
            if len(logo) > 1024 * 1024:
                logo = b""
                logo_name = logo_medientyp = ""
        except (OSError, ET.ParseError):
            logo = b""
            logo_name = logo_medientyp = ""
    if kompakt:
        logo = b""
        logo_name = logo_medientyp = ""

    ns = ('xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" '
          'xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" '
          'xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" '
          'xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" '
          'xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" '
          'xmlns:xlink="http://www.w3.org/1999/xlink" '
          'xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" '
          'xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"')
    breiten = ["3.2cm", "3.2cm", "4.5cm", "3.2cm", "5.4cm", "4.2cm",
               "3.2cm", "5.4cm", "4.2cm", "4.2cm", "5.0cm", "5.5cm",
               "5.5cm", "5.5cm", "5.5cm", "5.5cm"]
    spalten_xml = []
    stile = []
    for index in range(len(spalten)):
        name = "co%d" % index
        if ist_monat:
            breite = "1cm" if index == 0 else "3.8714cm"
        elif ist_jahr:
            breite = "2.3417cm"
        else:
            breite = "2.15cm" if kompakt else breiten[index]
        stile.append('<style:style style:name="%s" style:family="table-column">'
                     '<style:table-column-properties style:column-width="%s"/>'
                     '</style:style>' % (name, breite))
        spalten_xml.append('<table:table-column table:style-name="%s"/>' % name)

    marker_stile = {}
    eintrag_stile = {}
    balken_stile = {}
    if kalenderinhalte:
        for reihe in kalenderinhalte:
            for inhalt in reihe:
                for marker in inhalt["marker"]:
                    marker_stile.setdefault(marker["farbe"],
                                            "calendarMarker%d" % len(marker_stile))
                for eintrag in inhalt["eintraege"]:
                    schluessel = (eintrag["art"], eintrag["farbe"])
                    eintrag_stile.setdefault(schluessel,
                                             "calendarEntry%d" % len(eintrag_stile))
                    balken_stile.setdefault(eintrag["farbe"],
                                            "calendarBar%d" % len(balken_stile))

    def zelle(wert, stil, inhalt=None):
        if inhalt is not None:
            marker = "".join('<text:span text:style-name="%s"> %s</text:span>' % (
                marker_stile[x["farbe"]], _ods_xml_text(x["text"]))
                for x in inhalt["marker"])
            datum_stil = "calendarMonthDate" if ist_monat else "calendarYearDate"
            abschnitte = ['<text:p><text:span text:style-name="%s">%s</text:span>'
                           '%s</text:p>' % (datum_stil,
                                           _ods_xml_text(inhalt["datum"]), marker)]
            for eintrag in inhalt["eintraege"]:
                if ist_monat:
                    stilname = eintrag_stile[(eintrag["art"], eintrag["farbe"])]
                    abschnitte.append('<text:p text:style-name="%s">'
                                      '<text:span text:style-name="%s">▌</text:span> %s'
                                      '</text:p>' % (stilname,
                                          balken_stile[eintrag["farbe"]],
                                          _ods_xml_text(eintrag["text"])))
                else:
                    abschnitte.append('<text:p text:style-name="calendarYearEntry">%s</text:p>' %
                                      _ods_xml_text(eintrag["text"]))
            if inhalt["mehr"]:
                abschnitte.append('<text:p text:style-name="calendarMore">+%d</text:p>' %
                                  inhalt["mehr"])
            return ('<table:table-cell table:style-name="%s" office:value-type="string">'
                    '%s</table:table-cell>') % (stil, "".join(abschnitte))
        abschnitte = _ods_xml_text(wert).split("\n")
        inhalt = "<text:line-break/>".join(abschnitte)
        return ('<table:table-cell table:style-name="%s" office:value-type="string">'
                '<text:p>%s</text:p></table:table-cell>') % (stil, inhalt)

    blatt_name = titel.rsplit("·", 1)[-1].strip() or spalten[0]
    logo_xml = ""
    if logo:
        blatt_ref = "'%s'.A1" % blatt_name.replace("'", "''")
        logo_xml = ('<table:shapes><draw:frame draw:name="Magnolie" draw:z-index="0" '
                    'svg:x="0.16cm" svg:y="0.12cm" svg:width="0.72cm" '
                    'svg:height="0.72cm" table:anchor-cell-address="%s">'
                    '<draw:image xlink:href="Pictures/%s" xlink:type="simple" '
                    'xlink:show="embed" xlink:actuate="onLoad"/>'
                    '</draw:frame></table:shapes>') % (
                        _ods_xml_text(blatt_ref), logo_name)
    titel_zelle = ('<table:table-cell table:style-name="title" '
                   'table:number-columns-spanned="%d" office:value-type="string">'
                    '<text:p text:style-name="titleParagraph"><text:span text:style-name="titleText">%s</text:span>'
                    '</text:p></table:table-cell>%s') % (
                        len(spalten), _ods_xml_text(titel),
                        '<table:covered-table-cell/>' * (len(spalten) - 1))
    kopf = "".join(zelle(wert, "header") for wert in spalten)
    rumpf = []
    kalender_stilnamen = {"empty": "calendarEmpty", "outside": "calendarOutside",
                          "week-number": "calendarWeek", "saturday": "calendarSaturday",
                           "sunday": "calendarSunday", "vacation": "calendarVacation",
                           "personal-vacation": "calendarPersonalVacation",
                          "holiday": "calendarHoliday",
                          "holiday-vacation": "calendarHolidayVacation"}
    for index, zeile in enumerate(zeilen):
        grundstil = "calendarCell" if kalenderinhalte else (
            "cellAlt" if index % 2 else "cell")
        zellen = []
        for spalte, wert in enumerate(zeile):
            stil = grundstil
            if zellstile:
                stil = kalender_stilnamen.get(zellstile[index][spalte], grundstil)
            inhalt = kalenderinhalte[index][spalte] if kalenderinhalte else None
            zellen.append(zelle(wert, stil, inhalt))
        zeilenstil = (' table:style-name="calendarMonthRow"' if kalenderinhalte and
                      len(spalten) == 8 else (' table:style-name="calendarYearRow"'
                      if kalenderinhalte else ''))
        rumpf.append('<table:table-row%s>%s</table:table-row>' % (zeilenstil,
                      "".join(zellen)))

    kalender_rand = "#756a59" if ist_monat else "#625b50"
    kalender_polster = "0.1cm" if ist_monat else "0.02cm 0.05cm"
    sonntag_farbe = "#f8e8dc" if ist_monat else "#f5c38f"
    ferien_farbe = "#eef2c3" if ist_monat else "#fff200"
    kalender_stile = (
        '<style:style style:name="calendarEmpty" style:family="table-cell">'
        '<style:table-cell-properties fo:background-color="#e5e5e5" '
        'fo:border="0.01cm solid %(rand)s" fo:padding="%(polster)s" '
        'style:vertical-align="top"/></style:style>'
        '<style:style style:name="calendarOutside" style:family="table-cell">'
        '<style:table-cell-properties fo:background-color="#e5e5e5" '
        'fo:border="0.01cm solid %(rand)s" fo:padding="%(polster)s" '
        'fo:wrap-option="wrap" style:vertical-align="top"/>'
        '<style:text-properties fo:color="#998f80"/>'
        '</style:style>'
        '<style:style style:name="calendarWeek" style:family="table-cell">'
        '<style:table-cell-properties fo:background-color="#8b6a35" '
        'fo:border="0.01cm solid #6d5129" fo:padding="0.1cm" '
        'style:vertical-align="middle"/><style:text-properties fo:color="#ffffff" '
        'fo:font-weight="bold"/></style:style>'
        '<style:style style:name="calendarSaturday" style:family="table-cell">'
        '<style:table-cell-properties fo:background-color="#fffbc7" '
        'fo:border="0.01cm solid %(rand)s" fo:padding="%(polster)s" '
        'fo:wrap-option="wrap" style:vertical-align="top"/></style:style>'
        '<style:style style:name="calendarSunday" style:family="table-cell">'
        '<style:table-cell-properties fo:background-color="%(sonntag)s" '
        'fo:border="0.01cm solid %(rand)s" fo:padding="%(polster)s" '
        'fo:wrap-option="wrap" style:vertical-align="top"/></style:style>'
        '<style:style style:name="calendarVacation" style:family="table-cell">'
        '<style:table-cell-properties fo:background-color="%(ferien)s" '
        'fo:border="0.01cm solid %(rand)s" fo:padding="%(polster)s" '
        'fo:wrap-option="wrap" style:vertical-align="top"/></style:style>'
        '<style:style style:name="calendarPersonalVacation" style:family="table-cell">'
        '<style:table-cell-properties fo:background-color="#d9eee7" '
        'fo:border="0.01cm solid %(rand)s" fo:padding="%(polster)s" '
        'fo:wrap-option="wrap" style:vertical-align="top"/></style:style>'
        '<style:style style:name="calendarHoliday" style:family="table-cell">'
        '<style:table-cell-properties fo:background-color="#f4c6ca" '
        'fo:border="0.01cm solid %(rand)s" fo:padding="%(polster)s" '
        'fo:wrap-option="wrap" style:vertical-align="top"/>%(feiertag_text)s</style:style>'
        '<style:style style:name="calendarHolidayVacation" style:family="table-cell">'
        '<style:table-cell-properties fo:background-color="#ffdd57" '
        'fo:border="0.01cm solid %(rand)s" fo:padding="%(polster)s" '
        'fo:wrap-option="wrap" style:vertical-align="top"/>%(feiertag_text)s</style:style>') % {
            "rand": kalender_rand, "polster": kalender_polster,
            "sonntag": sonntag_farbe, "ferien": ferien_farbe,
            "feiertag_text": ("" if ist_monat else
                               '<style:text-properties fo:color="#b01820"/>')}

    eintrag_hintergrund = {"termin": "#f1e7d0", "jahrestag": "#eadce5",
                           "schicht": "#e8dfcf", "feiertag": "#f4c6ca",
                           "ferien": "#eef2c3", "urlaub": "#d9eee7",
                           "muell": "#e8e4dc"}
    struktur_stile = (
        '<style:style style:name="calendarMonthTitleRow" style:family="table-row">'
        '<style:table-row-properties style:row-height="1.09cm" '
        'style:use-optimal-row-height="false"/></style:style>'
        '<style:style style:name="calendarYearTitleRow" style:family="table-row">'
        '<style:table-row-properties style:row-height="1.05cm" '
        'style:use-optimal-row-height="false"/></style:style>'
        '<style:style style:name="calendarMonthHeaderRow" style:family="table-row">'
        '<style:table-row-properties style:row-height="0.65cm" '
        'style:use-optimal-row-height="false"/></style:style>'
        '<style:style style:name="calendarYearHeaderRow" style:family="table-row">'
        '<style:table-row-properties style:row-height="0.61cm" '
        'style:use-optimal-row-height="false"/></style:style>'
        '<style:style style:name="calendarMonthRow" style:family="table-row">'
        '<style:table-row-properties style:row-height="2.792cm" '
        'style:use-optimal-row-height="false"/></style:style>'
        '<style:style style:name="calendarYearRow" style:family="table-row">'
        '<style:table-row-properties style:row-height="0.43cm" '
        'style:use-optimal-row-height="false"/></style:style>'
        '<style:style style:name="calendarMonthDate" style:family="text">'
        '<style:text-properties fo:font-weight="bold" fo:font-size="10pt"/></style:style>'
        '<style:style style:name="calendarYearDate" style:family="text">'
        '<style:text-properties fo:font-weight="600" fo:font-size="5.5pt"/></style:style>'
        '<style:style style:name="calendarYearEntry" style:family="paragraph">'
        '<style:paragraph-properties fo:margin="0cm" fo:line-height="102%"/>'
        '<style:text-properties fo:font-size="3.6pt" fo:font-weight="normal"/></style:style>'
        '<style:style style:name="calendarMore" style:family="paragraph">'
        '<style:paragraph-properties fo:margin-top="0.07cm" fo:margin-bottom="0cm" '
        'fo:border-left="0.25cm solid #998f80" fo:padding="0.05cm 0.1cm" '
        'fo:background-color="#eee8dc"/><style:text-properties fo:color="#29231a" '
        'fo:font-size="8pt"/></style:style>' +
        ''.join('<style:style style:name="%s" style:family="text">'
                '<style:text-properties fo:color="%s" fo:font-size="11pt" '
                'fo:font-family="Liberation Sans, Noto Emoji, Symbola"/></style:style>' %
                (name, farbe) for farbe, name in marker_stile.items()) +
        ''.join('<style:style style:name="%s" style:family="text">'
                '<style:text-properties fo:color="%s" fo:font-size="8pt" '
                'fo:font-weight="bold"/></style:style>' % (name, farbe)
                for farbe, name in balken_stile.items()) +
        ''.join('<style:style style:name="%s" style:family="paragraph">'
                '<style:paragraph-properties fo:margin-top="0.07cm" fo:margin-bottom="0cm" '
                'fo:border-left="0.25cm solid %s" fo:padding="0.05cm 0.1cm" '
                'fo:wrap-option="no-wrap" fo:background-color="%s"/>'
                '<style:text-properties fo:font-size="8pt" '
                'fo:font-weight="normal" fo:color="#29231a"/>'
                '</style:style>' % (name, farbe, eintrag_hintergrund.get(art, "#f1e7d0"))
                for (art, farbe), name in eintrag_stile.items()))

    if ist_monat:
        titel_stile = (
            '<style:style style:name="title" style:family="table-cell">'
            '<style:table-cell-properties fo:background-color="#5c3f25" '
            'fo:padding="0.2cm" style:vertical-align="middle"/></style:style>'
            '<style:style style:name="titleParagraph" style:family="paragraph">'
            '<style:paragraph-properties fo:text-align="center"/></style:style>'
            '<style:style style:name="titleText" style:family="text">'
            '<style:text-properties fo:font-size="17pt" fo:font-weight="bold" '
            'fo:color="#ffffff"/></style:style>'
            '<style:style style:name="header" style:family="table-cell">'
            '<style:table-cell-properties fo:background-color="#8b6a35" '
            'fo:border="0.01cm solid #6d5129" fo:padding="0.15cm" '
            'style:vertical-align="middle"/><style:text-properties fo:color="#ffffff" '
            'fo:font-weight="bold"/></style:style>')
    elif ist_jahr:
        titel_stile = (
            '<style:style style:name="title" style:family="table-cell">'
            '<style:table-cell-properties fo:padding="0cm" '
            'style:vertical-align="middle"/></style:style>'
            '<style:style style:name="titleParagraph" style:family="paragraph">'
            '<style:paragraph-properties fo:text-align="start"/></style:style>'
            '<style:style style:name="titleText" style:family="text">'
            '<style:text-properties fo:font-size="17pt" fo:font-weight="bold" '
            'fo:letter-spacing="0.425pt" fo:color="#17140f"/></style:style>'
            '<style:style style:name="header" style:family="table-cell">'
            '<style:table-cell-properties fo:background-color="#f1ede4" '
            'fo:border="0.01cm solid #29251d" fo:padding="0.14cm 0.05cm" '
            'style:vertical-align="middle"/><style:text-properties fo:color="#17140f" '
            'fo:font-size="8pt" fo:font-weight="bold"/></style:style>')
    else:
        titel_stile = (
            '<style:style style:name="title" style:family="table-cell">'
            '<style:table-cell-properties fo:background-color="#f5efe2" '
            'fo:padding="0.18cm" fo:padding-left="1.02cm" '
            'fo:border-bottom="0.04cm solid #a8823c" '
            'style:vertical-align="middle"/></style:style>'
            '<style:style style:name="titleParagraph" style:family="paragraph"/>'
            '<style:style style:name="titleText" style:family="text">'
            '<style:text-properties fo:font-size="16pt" fo:font-weight="bold" '
            'fo:color="#4f3d28"/></style:style>'
            '<style:style style:name="header" style:family="table-cell">'
            '<style:table-cell-properties fo:background-color="#8b6a35" '
            'fo:border="0.02cm solid #6d5129" fo:padding="0.12cm" '
            'fo:wrap-option="wrap" style:vertical-align="middle"/>'
            '<style:text-properties fo:color="#ffffff" fo:font-weight="bold"/>'
            '</style:style>')
    titel_zeile = (' table:style-name="calendarMonthTitleRow"' if ist_monat else
                    (' table:style-name="calendarYearTitleRow"' if ist_jahr else ""))
    kopf_zeile = (' table:style-name="calendarMonthHeaderRow"' if ist_monat else
                   (' table:style-name="calendarYearHeaderRow"' if ist_jahr else ""))
    letzte_spalte = "H" if ist_monat else "L"
    letzte_zeile = 8 if ist_monat else 33
    druckbereich = ""
    if ist_monat or ist_jahr:
        sicherer_blattname = blatt_name.replace("'", "''")
        druckbereich = (' table:print-ranges="&apos;%s&apos;.A1:&apos;%s&apos;.%s%d"' %
                        (sicherer_blattname, sicherer_blattname,
                         letzte_spalte, letzte_zeile))

    content = ('<?xml version="1.0" encoding="UTF-8"?>'
               '<office:document-content %s office:version="1.2">'
               '<office:automatic-styles>%s'
               '<style:style style:name="tableStyle" style:family="table" '
               'style:master-page-name="MagnoliePage"><style:table-properties '
               'table:display="true" style:writing-mode="lr-tb"/></style:style>'
                '%s'
               '<style:style style:name="calendarCell" style:family="table-cell">'
               '<style:table-cell-properties fo:border="0.01cm solid %s" '
               'fo:padding="%s" fo:wrap-option="wrap" '
               'style:vertical-align="top"/></style:style>'
               '<style:style style:name="cell" style:family="table-cell">'
               '<style:table-cell-properties fo:border="0.01cm solid #cbb894" '
               'fo:padding="0.1cm" fo:wrap-option="wrap" '
               'style:vertical-align="top"/></style:style>'
               '<style:style style:name="cellAlt" style:family="table-cell">'
               '<style:table-cell-properties fo:background-color="#faf7f0" '
               'fo:border="0.01cm solid #cbb894" fo:padding="0.1cm" '
                'fo:wrap-option="wrap" style:vertical-align="top"/></style:style>%s'
                '</office:automatic-styles><office:body><office:spreadsheet>'
                 '<table:table table:name="%s" table:style-name="tableStyle" '
                     'table:print="true"%s>%s%s<table:table-row%s>%s'
                '</table:table-row><table:table-header-rows><table:table-row%s>%s'
               '</table:table-row></table:table-header-rows>%s</table:table>'
               '</office:spreadsheet></office:body></office:document-content>') % (
                     ns, "".join(stile) + struktur_stile, titel_stile,
                     kalender_rand, kalender_polster, kalender_stile,
                     _ods_xml_text(blatt_name), druckbereich, logo_xml,
                     "".join(spalten_xml), titel_zeile, titel_zelle,
                     kopf_zeile, kopf, "".join(rumpf))
    seiten_einstellung = ('fo:margin="0.8cm" style:scale-to-pages="1" '
                           if kompakt else
                           'fo:margin="1.2cm" style:scale-to="92%" ')
    fusszeile = ("" if kompakt else
                  '<style:footer><text:p text:style-name="Footer">Magnolie Organizer · '
                  '<text:page-number text:select-page="current">1</text:page-number>'
                  '</text:p></style:footer>')
    styles = ('<?xml version="1.0" encoding="UTF-8"?>'
              '<office:document-styles %s office:version="1.2">'
               '<office:styles><style:default-style style:family="table-cell">'
               '<style:text-properties fo:font-family="Liberation Sans" '
                'fo:font-size="%s"/></style:default-style>'
               '<style:style style:name="Footer" style:family="paragraph">'
               '<style:paragraph-properties fo:text-align="center"/>'
               '<style:text-properties fo:font-size="8pt" fo:color="#6a5c44"/>'
               '</style:style></office:styles>'
              '<office:automatic-styles><style:page-layout style:name="A4Landscape">'
              '<style:page-layout-properties fo:page-width="29.7cm" '
              'fo:page-height="21cm" style:print-orientation="landscape" '
                '%s'
              'style:print-page-order="ttb"/></style:page-layout>'
               '</office:automatic-styles><office:master-styles>'
               '<style:master-page style:name="MagnoliePage" '
               'style:page-layout-name="A4Landscape">%s'
                '</style:master-page></office:master-styles></office:document-styles>') % (
                    ns, "8pt" if ist_monat else ("7pt" if kompakt else "9pt"),
                    seiten_einstellung, fusszeile)
    manifest_logo = ('<manifest:file-entry manifest:full-path="Pictures/%s" '
                     'manifest:media-type="%s"/>' % (
                         logo_name, logo_medientyp)) if logo else ""
    manifest = ('<?xml version="1.0" encoding="UTF-8"?>'
                '<manifest:manifest '
                'xmlns:manifest="urn:oasis:names:tc:opendocument:xmlns:manifest:1.0" '
                'manifest:version="1.2"><manifest:file-entry manifest:full-path="/" '
                'manifest:media-type="application/vnd.oasis.opendocument.spreadsheet"/>'
                '<manifest:file-entry manifest:full-path="content.xml" '
                'manifest:media-type="text/xml"/><manifest:file-entry '
                'manifest:full-path="styles.xml" manifest:media-type="text/xml"/>%s'
                '</manifest:manifest>') % manifest_logo
    ausgabe = io.BytesIO()
    with zipfile.ZipFile(ausgabe, "w") as archiv:
        archiv.writestr("mimetype", "application/vnd.oasis.opendocument.spreadsheet",
                        compress_type=zipfile.ZIP_STORED)
        archiv.writestr("content.xml", content.encode("utf-8"),
                        compress_type=zipfile.ZIP_DEFLATED)
        archiv.writestr("styles.xml", styles.encode("utf-8"),
                        compress_type=zipfile.ZIP_DEFLATED)
        archiv.writestr("META-INF/manifest.xml", manifest.encode("utf-8"),
                        compress_type=zipfile.ZIP_DEFLATED)
        if logo:
            archiv.writestr("Pictures/" + logo_name, logo,
                            compress_type=zipfile.ZIP_DEFLATED)
    return ausgabe.getvalue()


def adressen_ods_schreiben(titel, spalten, zeilen, logo_pfad=None,
                           ordner=None, dateiname=None, zellstile=None,
                           kompakt=False, kalenderinhalte=None):
    daten = adressen_ods_bytes(titel, spalten, zeilen, logo_pfad,
                               zellstile=zellstile, kompakt=kompakt,
                               kalenderinhalte=kalenderinhalte)
    ordner = ordner or _temporaerer_ausgabeordner("magnolie-ods-")
    os.makedirs(ordner, exist_ok=True)
    dateiname = dateiname or _("Magnolie-Contacts.ods")
    dateiname = os.path.basename(dateiname)
    if not dateiname.lower().endswith(".ods"):
        dateiname += ".ods"
    pfad = os.path.join(ordner, dateiname)
    _private_ausgabe_schreiben(pfad, daten, binaer=True)
    return pfad


def gesundheit_ods_pruefen(tabellen):
    """Prueft die fertigen zweigeteilten Gesundheitstabellen der Web-Bruecke."""
    if not isinstance(tabellen, list) or not 1 <= len(tabellen) <= ODS_MAX_BLAETTER:
        raise ValueError(_("The ODS columns are invalid."))
    ausgabe = []
    blattnamen = set()
    gesamt = 0
    gesamt_zeilen = 0

    def diagramm_pruefen(diagramm):
        if (not isinstance(diagramm, dict) or
                set(diagramm) != {"titel", "serien"}):
            raise ValueError(_("The ODS columns are invalid."))
        titel = diagramm["titel"]
        serien = diagramm["serien"]
        if (not isinstance(titel, str) or not titel.strip() or len(titel) > 80 or
                any(ord(zeichen) < 0x20 for zeichen in titel) or
                not isinstance(serien, list) or not 1 <= len(serien) <= 4):
            raise ValueError(_("The ODS columns are invalid."))
        neue_serien = []
        for serie in serien:
            if (not isinstance(serie, dict) or
                    set(serie) != {"name", "farbe", "punkte"}):
                raise ValueError(_("The ODS columns are invalid."))
            name = serie["name"]
            farbe = serie["farbe"]
            punkte = serie["punkte"]
            if (not isinstance(name, str) or not name.strip() or len(name) > 80 or
                    any(ord(zeichen) < 0x20 for zeichen in name) or
                    not isinstance(farbe, str) or
                    not re.fullmatch(r"#[0-9a-fA-F]{6}", farbe) or
                    not isinstance(punkte, list) or len(punkte) > ODS_MAX_ZEILEN):
                raise ValueError(_("The ODS columns are invalid."))
            neue_punkte = []
            for punkt in punkte:
                if (not isinstance(punkt, list) or len(punkt) != 2 or
                        not isinstance(punkt[0], str) or not punkt[0].strip() or
                        len(punkt[0]) > 40 or
                        any(ord(zeichen) < 0x20 for zeichen in punkt[0]) or
                        isinstance(punkt[1], bool) or
                        not isinstance(punkt[1], (int, float)) or
                        punkt[1] != punkt[1] or abs(punkt[1]) == float("inf")):
                    raise ValueError(_("The ODS columns are invalid."))
                neue_punkte.append([punkt[0], float(punkt[1])])
            neue_serien.append({"name": name.strip(), "farbe": farbe.lower(),
                                "punkte": neue_punkte})
        return {"titel": titel.strip(), "serien": neue_serien}

    for tabelle in tabellen:
        if isinstance(tabelle, dict) and set(tabelle) == {"titel", "diagramme"}:
            titel = tabelle["titel"]
            if (not isinstance(titel, str) or not titel.strip() or len(titel) > 80 or
                    any(ord(zeichen) < 0x20 for zeichen in titel) or
                    any(zeichen in "[]:*?/\\" for zeichen in titel) or
                    titel.startswith("'") or titel.endswith("'") or
                    not isinstance(tabelle["diagramme"], list) or
                    not 1 <= len(tabelle["diagramme"]) <= 6):
                raise ValueError(_("The ODS title is invalid."))
            blattname = titel.strip()
            if blattname.casefold() in blattnamen:
                raise ValueError(_("The ODS title is invalid."))
            blattnamen.add(blattname.casefold())
            diagramme = [diagramm_pruefen(wert) for wert in tabelle["diagramme"]]
            gesamt_zeilen += sum(len(serie["punkte"]) for diagramm in diagramme
                                 for serie in diagramm["serien"])
            if gesamt_zeilen > ODS_MAX_ZEILEN:
                raise ValueError(_("The ODS row count is invalid."))
            gesamt += len(blattname) + sum(len(wert["titel"]) for wert in diagramme)
            if gesamt > ODS_MAX_GESAMT:
                raise ValueError(_("The ODS export is too large."))
            ausgabe.append({"titel": blattname, "diagramme": diagramme})
            continue
        erlaubte_schluessel = {"titel", "links", "rechts", "zeilen"}
        if (not isinstance(tabelle, dict) or
                set(tabelle) not in (erlaubte_schluessel,
                                     erlaubte_schluessel | {"rechtsTitel"},
                                     erlaubte_schluessel | {"rechtsTitel", "diagramm"})):
            raise ValueError(_("The ODS columns are invalid."))
        titel = tabelle["titel"]
        rechts_titel = tabelle.get("rechtsTitel", titel)
        links = tabelle["links"]
        rechts = tabelle["rechts"]
        zeilen = tabelle["zeilen"]
        if (not isinstance(titel, str) or not titel.strip() or len(titel) > 80 or
                any(ord(zeichen) < 0x20 for zeichen in titel) or
                any(zeichen in "[]:*?/\\" for zeichen in titel) or
                titel.startswith("'") or titel.endswith("'")):
            raise ValueError(_("The ODS title is invalid."))
        blattname = titel.strip()
        if (not isinstance(rechts_titel, str) or not rechts_titel.strip() or
                len(rechts_titel) > 80 or
                any(ord(zeichen) < 0x20 for zeichen in rechts_titel)):
            raise ValueError(_("The ODS title is invalid."))
        rechts_titel = rechts_titel.strip()
        if blattname.casefold() in blattnamen:
            raise ValueError(_("The ODS title is invalid."))
        blattnamen.add(blattname.casefold())
        if (not isinstance(links, list) or not isinstance(rechts, list) or
                not 1 <= len(links) <= ODS_MAX_SPALTEN or
                not 1 <= len(rechts) <= ODS_MAX_SPALTEN or
                len(links) + len(rechts) > ODS_MAX_SPALTEN or
                any(not isinstance(wert, str) or not wert.strip() or len(wert) > 160
                    for wert in links + rechts)):
            raise ValueError(_("The ODS columns are invalid."))
        if not isinstance(zeilen, list) or not zeilen or len(zeilen) > ODS_MAX_ZEILEN:
            raise ValueError(_("The ODS row count is invalid."))
        gesamt_zeilen += len(zeilen)
        if gesamt_zeilen > ODS_MAX_ZEILEN:
            raise ValueError(_("The ODS row count is invalid."))
        spaltenzahl = len(links) + len(rechts)
        neue_zeilen = []
        gesamt += (len(blattname) + len(rechts_titel) +
                   sum(len(wert) for wert in links + rechts))
        for zeile in zeilen:
            if not isinstance(zeile, list) or len(zeile) != spaltenzahl:
                raise ValueError(_("An ODS row has the wrong number of columns."))
            if any(not isinstance(wert, str) or len(wert) > ODS_MAX_ZEICHEN
                   for wert in zeile):
                raise ValueError(_("An ODS cell is too long."))
            gesamt += sum(len(wert) for wert in zeile)
            if gesamt > ODS_MAX_GESAMT:
                raise ValueError(_("The ODS export is too large."))
            neue_zeilen.append(list(zeile))
        neue_tabelle = {"titel": blattname, "rechtsTitel": rechts_titel,
                        "links": list(links), "rechts": list(rechts),
                        "zeilen": neue_zeilen}
        if "diagramm" in tabelle:
            if len(rechts) != 1:
                raise ValueError(_("The ODS columns are invalid."))
            neues_diagramm = diagramm_pruefen(tabelle["diagramm"])
            gesamt_zeilen += sum(len(serie["punkte"])
                                 for serie in neues_diagramm["serien"])
            if gesamt_zeilen > ODS_MAX_ZEILEN:
                raise ValueError(_("The ODS row count is invalid."))
            neue_tabelle["diagramm"] = neues_diagramm
        ausgabe.append(neue_tabelle)
    return ausgabe


def _gesundheit_diagramm_svg(diagramm):
    """Erzeugt aus geprueften Messreihen ein eigenstaendiges SVG."""
    serien = diagramm["serien"]
    punkte = [punkt for serie in serien for punkt in serie["punkte"]]
    svg = ['<?xml version="1.0" encoding="UTF-8"?>',
           '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 430 215">',
           '<rect width="430" height="215" fill="#ffffff"/>',
           '<text x="215" y="18" text-anchor="middle" fill="#4f2f54" '
           'font-family="serif" font-size="13" font-weight="bold">%s</text>' %
           _ods_xml_text(diagramm["titel"])]
    for index in range(1, 4):
        y_wert = 35 + index * 36.25
        svg.append('<line x1="34" x2="400" y1="%.2f" y2="%.2f" '
                   'stroke="#d4cec3"/>' % (y_wert, y_wert))
    if punkte:
        minimum = min(punkt[1] for punkt in punkte)
        maximum = max(punkt[1] for punkt in punkte)
        spannweite = max(1, maximum - minimum)
        daten = sorted(set(punkt[0] for punkt in punkte))
        x_werte = {datum: 217 if len(daten) == 1 else
                   40 + index / (len(daten) - 1) * 354
                   for index, datum in enumerate(daten)}
        for serie in serien:
            if not serie["punkte"]:
                continue
            koordinaten = [(x_werte[punkt[0]],
                            174 - (punkt[1] - minimum) / spannweite * 133)
                           for punkt in serie["punkte"]]
            svg.append('<polyline fill="none" stroke="%s" stroke-width="2" '
                       'points="%s"/>' % (serie["farbe"], " ".join(
                           "%.2f,%.2f" % punkt for punkt in koordinaten)))
            svg.extend('<circle cx="%.2f" cy="%.2f" r="2.5" fill="%s"/>' %
                       (punkt[0], punkt[1], serie["farbe"])
                       for punkt in koordinaten)
    svg.append('<rect x="34" y="35" width="366" height="145" fill="none" '
               'stroke="#897b68"/>')
    legendenbreite = 390 / max(1, len(serien))
    for index, serie in enumerate(serien):
        x_wert = 20 + index * legendenbreite
        svg.append('<circle cx="%.2f" cy="199" r="4" fill="%s"/>' %
                   (x_wert, serie["farbe"]))
        svg.append('<text x="%.2f" y="202" fill="#29231d" font-family="sans-serif" '
                   'font-size="10">%s</text>' %
                   (x_wert + 7, _ods_xml_text(serie["name"])))
    svg.append('</svg>')
    return "".join(svg).encode("utf-8")


def gesundheit_ods_bytes(tabellen):
    """Erzeugt eine druckfertige Gesundheitsmappe mit Tabellen und Diagrammen."""
    tabellen = gesundheit_ods_pruefen(tabellen)
    ns = ('xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" '
          'xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" '
          'xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" '
          'xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" '
          'xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" '
          'xmlns:xlink="http://www.w3.org/1999/xlink" '
          'xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" '
          'xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"')

    def zelle(wert, stil):
        inhalt = "<text:line-break/>".join(_ods_xml_text(wert).split("\n"))
        return ('<table:table-cell table:style-name="%s" office:value-type="string">'
                '<text:p>%s</text:p></table:table-cell>') % (stil, inhalt)

    spalten_stile = [
        '<style:style style:name="healthGutterColumn" style:family="table-column">'
        '<style:table-column-properties style:column-width="0.9cm"/>'
        '</style:style>'
    ]
    blaetter = []
    bilder = []

    def diagramm_form(diagramm, blattname, zelle, x_wert, y_wert, breite, hoehe):
        bildname = "Pictures/gesundheit-diagramm-%d.svg" % (len(bilder) + 1)
        bilder.append((bildname, _gesundheit_diagramm_svg(diagramm)))
        blatt_ref = "'%s'.%s" % (blattname.replace("'", "''"), zelle)
        return ('<draw:frame draw:name="healthChart%d" draw:z-index="%d" '
                'svg:x="%s" svg:y="%s" svg:width="%s" svg:height="%s" '
                'table:anchor-cell-address="%s">'
                '<draw:image xlink:href="%s" xlink:type="simple" '
                'xlink:show="embed" xlink:actuate="onLoad"/>'
                '</draw:frame>') % (len(bilder), len(bilder), x_wert, y_wert,
                                    breite, hoehe, _ods_xml_text(blatt_ref), bildname)

    for blatt_index, tabelle in enumerate(tabellen):
        if "diagramme" in tabelle:
            spalten_stile.extend([
                '<style:style style:name="healthChartGridColumn%d" '
                'style:family="table-column"><style:table-column-properties '
                'style:column-width="13.6cm"/></style:style>' % blatt_index,
                '<style:style style:name="healthChartGridRow%d" style:family="table-row">'
                '<style:table-row-properties style:row-height="5.5cm" '
                'style:use-optimal-row-height="false"/></style:style>' % blatt_index])
            rasterzeilen = []
            formen = []
            for index in range(0, len(tabelle["diagramme"]), 2):
                paar = tabelle["diagramme"][index:index + 2]
                zeilennummer = index // 2 + 2
                bild_y = "%.1fcm" % (1.6 + index // 2 * 5.5)
                formen.append(diagramm_form(paar[0], tabelle["titel"],
                                            "A%d" % zeilennummer, "0.5cm", bild_y,
                                            "12.6cm", "4.35cm"))
                zellen = ['<table:table-cell table:style-name="healthChartCell"/>',
                           '<table:table-cell table:style-name="healthSpacer"/>']
                if len(paar) > 1:
                    formen.append(diagramm_form(paar[1], tabelle["titel"],
                                                "C%d" % zeilennummer, "15cm", bild_y,
                                                "12.6cm", "4.35cm"))
                    zellen.append('<table:table-cell table:style-name="healthChartCell"/>')
                else:
                    zellen.append('<table:table-cell table:style-name="healthChartCell"/>')
                rasterzeilen.append('<table:table-row table:style-name="healthChartGridRow%d">%s'
                                    '</table:table-row>' % (blatt_index, "".join(zellen)))
            blaetter.append(
                '<table:table table:name="%s" table:style-name="healthTable" '
                'table:print="true"><table:shapes>%s</table:shapes>'
                '<table:table-column table:style-name="healthChartGridColumn%d"/>'
                '<table:table-column table:style-name="healthGutterColumn"/>'
                '<table:table-column table:style-name="healthChartGridColumn%d"/>'
                '<table:table-row table:style-name="healthTitleRow">'
                '<table:table-cell table:style-name="healthTitle" table:number-columns-spanned="3">'
                '<text:p text:style-name="healthTitleParagraph">%s</text:p></table:table-cell>'
                '<table:covered-table-cell/><table:covered-table-cell/></table:table-row>%s'
                '</table:table>' % (_ods_xml_text(tabelle["titel"]), "".join(formen),
                                    blatt_index, blatt_index,
                                    _ods_xml_text(tabelle["titel"]),
                                    "".join(rasterzeilen)))
            continue
        spalten_xml = []
        for gruppe, spalten in (("L", tabelle["links"]),
                                ("R", tabelle["rechts"])):
            breite = ("%.4f" % (13.6 / len(spalten))).rstrip("0").rstrip(".") + "cm"
            for spalten_index in range(len(spalten)):
                stilname = "healthColumn%d%s%d" % (blatt_index, gruppe, spalten_index)
                spalten_stile.append(
                    '<style:style style:name="%s" style:family="table-column">'
                    '<style:table-column-properties style:column-width="%s"/>'
                    '</style:style>' % (stilname, breite))
                spalten_xml.append('<table:table-column table:style-name="%s"/>' %
                                   stilname)
            if gruppe == "L":
                spalten_xml.append(
                    '<table:table-column table:style-name="healthGutterColumn"/>')

        def titel_haelfte(wert, anzahl):
            return (
                '<table:table-cell table:style-name="healthTitle" '
                'table:number-columns-spanned="%d" office:value-type="string">'
                '<text:p text:style-name="healthTitleParagraph">%s</text:p>'
                '</table:table-cell>%s') % (
                    anzahl, _ods_xml_text(wert),
                    '<table:covered-table-cell/>' * (anzahl - 1))

        leerraum = '<table:table-cell table:style-name="healthSpacer"/>'
        titel_zelle = (titel_haelfte(tabelle["titel"], len(tabelle["links"])) +
                       leerraum + titel_haelfte(tabelle["rechtsTitel"],
                                               len(tabelle["rechts"])))
        kopf = ("".join(zelle(wert, "healthHeader") for wert in tabelle["links"]) +
                leerraum +
                "".join(zelle(wert, "healthHeader") for wert in tabelle["rechts"]))
        rumpf = []
        trennung = len(tabelle["links"])
        diagramm_formen = ""
        if "diagramm" in tabelle:
            rechte_spalte = chr(ord("A") + trennung + 1)
            diagramm_formen = '<table:shapes>%s</table:shapes>' % diagramm_form(
                tabelle["diagramm"], tabelle["titel"], rechte_spalte + "3",
                "15cm", "2cm", "12.6cm", "14.8cm")
        for index, zeile in enumerate(tabelle["zeilen"]):
            stil = "healthCellAlt" if index % 2 else "healthCell"
            if "diagramm" in tabelle:
                rechts_xml = ('<table:table-cell table:style-name="healthChartCell" '
                              'table:number-rows-spanned="%d"/>' % len(tabelle["zeilen"])
                              if index == 0 else '<table:covered-table-cell/>')
            else:
                rechts_xml = "".join(zelle(wert, stil) for wert in zeile[trennung:])
            rumpf.append('<table:table-row table:style-name="healthDataRow">%s'
                         '</table:table-row>' %
                         ("".join(zelle(wert, stil) for wert in zeile[:trennung]) +
                           leerraum +
                           rechts_xml))
        blaetter.append(
             '<table:table table:name="%s" table:style-name="healthTable" '
             'table:print="true">%s%s'
            '<table:table-row table:style-name="healthTitleRow">%s</table:table-row>'
            '<table:table-header-rows>'
            '<table:table-row table:style-name="healthHeaderRow">%s</table:table-row>'
            '</table:table-header-rows>%s</table:table>' % (
                 _ods_xml_text(tabelle["titel"]), diagramm_formen, "".join(spalten_xml),
                 titel_zelle, kopf, "".join(rumpf)))

    content = ('<?xml version="1.0" encoding="UTF-8"?>'
               '<office:document-content %s office:version="1.2">'
               '<office:automatic-styles>%s'
               '<style:style style:name="healthTable" style:family="table" '
               'style:master-page-name="HealthPage"><style:table-properties '
               'table:display="true" style:writing-mode="lr-tb"/></style:style>'
               '<style:style style:name="healthTitleRow" style:family="table-row">'
               '<style:table-row-properties style:row-height="0.9cm" '
               'style:use-optimal-row-height="false"/></style:style>'
               '<style:style style:name="healthHeaderRow" style:family="table-row">'
               '<style:table-row-properties style:row-height="0.7cm" '
               'style:use-optimal-row-height="false"/></style:style>'
               '<style:style style:name="healthDataRow" style:family="table-row">'
               '<style:table-row-properties style:row-height="0.86cm" '
               'style:use-optimal-row-height="false"/></style:style>'
               '<style:style style:name="healthTitle" style:family="table-cell">'
               '<style:table-cell-properties fo:background-color="#eee3f0" '
               'fo:border-bottom="0.04cm solid #6d3f73" fo:padding="0.15cm" '
               'style:vertical-align="middle"/><style:text-properties '
               'fo:font-size="15pt" fo:font-weight="bold" fo:color="#4f2f54"/>'
               '</style:style><style:style style:name="healthTitleParagraph" '
               'style:family="paragraph"><style:paragraph-properties '
               'fo:text-align="center"/></style:style>'
               '<style:style style:name="healthHeader" style:family="table-cell">'
               '<style:table-cell-properties fo:background-color="#7e5685" '
               'fo:border="0.02cm solid #5e3864" fo:padding="0.1cm" '
               'fo:wrap-option="wrap" style:vertical-align="middle"/>'
               '<style:text-properties fo:color="#ffffff" fo:font-weight="bold"/>'
               '</style:style><style:style style:name="healthSpacer" '
               'style:family="table-cell"><style:table-cell-properties '
               'fo:background-color="#ffffff"/></style:style>'
               '<style:style style:name="healthCell" '
               'style:family="table-cell"><style:table-cell-properties '
               'fo:border="0.01cm solid #aa8caf" fo:padding="0.08cm" '
               'fo:wrap-option="wrap" style:vertical-align="middle"/></style:style>'
               '<style:style style:name="healthCellAlt" style:family="table-cell">'
               '<style:table-cell-properties fo:background-color="#f8f2f8" '
               'fo:border="0.01cm solid #aa8caf" fo:padding="0.08cm" '
               'fo:wrap-option="wrap" style:vertical-align="middle"/></style:style>'
               '<style:style style:name="healthChartCell" style:family="table-cell">'
               '<style:table-cell-properties fo:padding="0.12cm" '
               'style:vertical-align="middle"/></style:style>'
               '<style:style style:name="healthChartTitle" style:family="paragraph">'
               '<style:paragraph-properties fo:text-align="center" '
               'fo:margin-bottom="0.08cm"/><style:text-properties fo:font-size="10pt" '
               'fo:font-weight="bold" fo:color="#4f2f54"/></style:style>'
               '</office:automatic-styles><office:body><office:spreadsheet>%s'
               '</office:spreadsheet></office:body></office:document-content>') % (
                   ns, "".join(spalten_stile), "".join(blaetter))
    styles = ('<?xml version="1.0" encoding="UTF-8"?>'
              '<office:document-styles %s office:version="1.2">'
              '<office:styles><style:default-style style:family="table-cell">'
              '<style:text-properties fo:font-family="Liberation Sans" '
              'fo:font-size="8pt"/></style:default-style></office:styles>'
              '<office:automatic-styles><style:page-layout style:name="HealthA4Landscape">'
              '<style:page-layout-properties fo:page-width="29.7cm" '
              'fo:page-height="21cm" style:print-orientation="landscape" '
              'fo:margin="0.8cm" style:scale-to-X="1" style:scale-to-Y="0" '
              'style:print-page-order="ttb"/></style:page-layout>'
              '</office:automatic-styles><office:master-styles>'
              '<style:master-page style:name="HealthPage" '
              'style:page-layout-name="HealthA4Landscape"/>'
              '</office:master-styles></office:document-styles>') % ns
    manifest_bilder = "".join(
        '<manifest:file-entry manifest:full-path="%s" '
        'manifest:media-type="image/svg+xml"/>' % name for name, _daten in bilder)
    manifest = ('<?xml version="1.0" encoding="UTF-8"?>'
                '<manifest:manifest '
                'xmlns:manifest="urn:oasis:names:tc:opendocument:xmlns:manifest:1.0" '
                'manifest:version="1.2"><manifest:file-entry manifest:full-path="/" '
                'manifest:media-type="application/vnd.oasis.opendocument.spreadsheet"/>'
                '<manifest:file-entry manifest:full-path="content.xml" '
                'manifest:media-type="text/xml"/><manifest:file-entry '
                'manifest:full-path="styles.xml" manifest:media-type="text/xml"/>%s'
                '</manifest:manifest>') % manifest_bilder
    ausgabe = io.BytesIO()
    with zipfile.ZipFile(ausgabe, "w") as archiv:
        archiv.writestr("mimetype", "application/vnd.oasis.opendocument.spreadsheet",
                        compress_type=zipfile.ZIP_STORED)
        archiv.writestr("content.xml", content.encode("utf-8"),
                        compress_type=zipfile.ZIP_DEFLATED)
        archiv.writestr("styles.xml", styles.encode("utf-8"),
                        compress_type=zipfile.ZIP_DEFLATED)
        archiv.writestr("META-INF/manifest.xml", manifest.encode("utf-8"),
                        compress_type=zipfile.ZIP_DEFLATED)
        for name, daten in bilder:
            archiv.writestr(name, daten, compress_type=zipfile.ZIP_DEFLATED)
    return ausgabe.getvalue()


def gesundheit_ods_schreiben(tabellen, ordner=None, dateiname=None):
    daten = gesundheit_ods_bytes(tabellen)
    ordner = ordner or _temporaerer_ausgabeordner("magnolie-gesundheit-ods-")
    os.makedirs(ordner, exist_ok=True)
    dateiname = os.path.basename(dateiname or "Magnolie-Gesundheit.ods")
    if not dateiname.lower().endswith(".ods"):
        dateiname += ".ods"
    pfad = os.path.join(ordner, dateiname)
    _private_ausgabe_schreiben(pfad, daten, binaer=True)
    return pfad


def gesundheit_ods_exportieren(tabellen, starter=None, welcher=None):
    try:
        pfad = gesundheit_ods_schreiben(tabellen)
    except (OSError, TypeError, ValueError) as fehler:
        return {"ok": False, "pfad": "", "womit": "", "fehler": str(fehler)}
    return ods_oeffnen(pfad, starter=starter, welcher=welcher)


def ods_oeffnen(pfad, starter=None, welcher=None):
    """Öffnet Calc ohne Shell und fällt auf den Desktop-Öffner zurück."""
    welcher = welcher or shutil.which
    if starter is None:
        def starter(argumente):
            subprocess.Popen(argumente, start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for programm, zusatz in (("libreoffice", ["--calc"]),
                             ("soffice", ["--calc"]), ("xdg-open", [])):
        werkzeug = welcher(programm)
        if not werkzeug:
            continue
        try:
            starter([werkzeug] + zusatz + [pfad])
            return {"ok": True, "pfad": pfad, "womit": programm, "fehler": ""}
        except OSError:
            continue
    return {"ok": False, "pfad": pfad, "womit": "",
            "fehler": _("No suitable application was found.")}


def adressen_ods_exportieren(titel, spalten, zeilen, logo_pfad=None,
                             starter=None, welcher=None):
    try:
        pfad = adressen_ods_schreiben(titel, spalten, zeilen, logo_pfad)
    except (OSError, ValueError) as fehler:
        return {"ok": False, "pfad": "", "womit": "", "fehler": str(fehler)}
    return ods_oeffnen(pfad, starter=starter, welcher=welcher)


def planer_ods_exportieren(titel, spalten, zeilen, stile, jahr,
                           layout="year", monat=0, logo_pfad=None,
                           starter=None, welcher=None, inhalte=None):
    try:
        jahr = int(jahr)
        if jahr < 1000 or jahr > 9999:
            raise ValueError(_("The year is invalid."))
        if layout not in ("year", "month"):
            raise ValueError(_("The planner layout is invalid."))
        monat = int(monat or 0)
        if layout == "month" and monat not in range(1, 13):
            raise ValueError(_("The month is invalid."))
        dateiname = (_("Magnolie-Month-Calendar-%04d-%02d.ods") % (jahr, monat)
                     if layout == "month" else
                     _("Magnolie-Year-Planner-%d.ods") % jahr)
        pfad = adressen_ods_schreiben(
            titel, spalten, zeilen, logo_pfad,
            dateiname=dateiname,
            zellstile=stile, kompakt=True, kalenderinhalte=inhalte)
    except (OSError, TypeError, ValueError) as fehler:
        return {"ok": False, "pfad": "", "womit": "", "fehler": str(fehler)}
    return ods_oeffnen(pfad, starter=starter, welcher=welcher)


# ---------------------------------------------------------------------------
# Kennwortschutz und Verschlüsselung
#
# Ist ein Kennwort gesetzt, liegen die Daten nur verschlüsselt im
# Heimatverzeichnis. Verwendet wird AES-256 im GCM-Verfahren mit einem
# Schlüssel, der über PBKDF2-HMAC-SHA256 aus dem Kennwort abgeleitet wird.
# GCM erkennt jede Veränderung – ein falsches Kennwort scheitert deshalb
# von selbst und dient gleichzeitig als Prüfung.
# ---------------------------------------------------------------------------

KENNWORT_RUNDEN = 240000
KENNWORT_RUNDEN_MIN = 50000
KENNWORT_RUNDEN_MAX = 1000000
KENNWORT_KENNUNG = "magnolie-verschluesselt"
KENNWORT_VERFAHREN = "AES-256-GCM/PBKDF2-SHA256"
DATEN_VERFAHREN = "AES-256-GCM+DEK/PBKDF2-SHA256"
DATEN_AAD = b"magnolie-daten-v2"


def kennwort_moeglich():
    """Steht die Verschlüsselung auf diesem System zur Verfügung?"""
    try:
        from cryptography.hazmat.primitives.ciphers.aead import AESGCM as _AESGCM
        return _AESGCM is not None
    except ImportError:
        return False


def _schluessel_ableiten(kennwort, salz, runden=KENNWORT_RUNDEN):
    import hashlib
    return hashlib.pbkdf2_hmac("sha256", (kennwort or "").encode("utf-8"),
                               salz, int(runden), 32)


def verschluesseln(text, kennwort, runden=KENNWORT_RUNDEN, salz=None,
                   nonce=None):
    """Verpackt Text in eine selbsterklärende, verschlüsselte Hülle."""
    if not kennwort:
        raise RuntimeError(_("Nothing can be encrypted without a password."))
    try:
        from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    except ImportError:
        raise RuntimeError(
            _("An encryption component is missing. Install it with:  "
              "sudo apt install python3-cryptography"))
    import base64
    salz = os.urandom(16) if salz is None else salz
    nonce = os.urandom(12) if nonce is None else nonce
    if (isinstance(runden, bool) or not isinstance(runden, int)
            or not KENNWORT_RUNDEN_MIN <= runden <= KENNWORT_RUNDEN_MAX
            or not isinstance(salz, bytes) or len(salz) != 16
            or not isinstance(nonce, bytes) or len(nonce) != 12):
        raise ValueError("Ungültige Verschlüsselungsparameter")
    schluessel = _schluessel_ableiten(kennwort, salz, runden)
    geheim = AESGCM(schluessel).encrypt(
        nonce, (text or "").encode("utf-8"), KENNWORT_KENNUNG.encode("utf-8"))
    return json.dumps({
        "magnolie": KENNWORT_KENNUNG,
        "fassung": 1,
        "verfahren": KENNWORT_VERFAHREN,
        "runden": int(runden),
        "salz": base64.b64encode(salz).decode("ascii"),
        "nonce": base64.b64encode(nonce).decode("ascii"),
        "daten": base64.b64encode(geheim).decode("ascii"),
    }, ensure_ascii=False, indent=1)


def _daten_huelle_felder(text):
    """Prüft eine Hauptdaten-DEK-Hülle vor jeder Schlüsselableitung."""
    import binascii
    try:
        huelle = json.loads(text)
        if (not isinstance(huelle, dict)
                or huelle.get("magnolie") != KENNWORT_KENNUNG
                or huelle.get("fassung") != 2
                or huelle.get("verfahren") != DATEN_VERFAHREN):
            raise ValueError
        runden = huelle.get("runden")
        if (isinstance(runden, bool) or not isinstance(runden, int)
                or not KENNWORT_RUNDEN_MIN <= runden <= KENNWORT_RUNDEN_MAX):
            raise ValueError
        namen = ("dekKennung", "salz", "dekNonce", "dekDaten",
                 "datenNonce", "daten")
        if any(not isinstance(huelle.get(name), str) for name in namen):
            raise ValueError
        dek_kennung = base64.b64decode(huelle["dekKennung"], validate=True)
        salz = base64.b64decode(huelle["salz"], validate=True)
        dek_nonce = base64.b64decode(huelle["dekNonce"], validate=True)
        dek_daten = base64.b64decode(huelle["dekDaten"], validate=True)
        daten_nonce = base64.b64decode(huelle["datenNonce"], validate=True)
        daten = base64.b64decode(huelle["daten"], validate=True)
        if (len(dek_kennung) != 16 or len(salz) != 16
                or len(dek_nonce) != 12 or len(dek_daten) != 48
                or len(daten_nonce) != 12 or len(daten) < 16):
            raise ValueError
    except (ValueError, KeyError, TypeError, binascii.Error):
        raise RuntimeError(_("The encrypted file is damaged."))
    return (huelle, runden, dek_kennung, salz, dek_nonce, dek_daten,
            daten_nonce, daten)


def _daten_dek_umschlag(dek, dek_kennung, kennwort,
                        runden=KENNWORT_RUNDEN):
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    if (not kennwort or not isinstance(dek, bytes) or len(dek) != 32
            or not isinstance(dek_kennung, bytes) or len(dek_kennung) != 16):
        raise ValueError("Ungültiger Datenschlüssel")
    salz = os.urandom(16)
    nonce = os.urandom(12)
    kek = _schluessel_ableiten(kennwort, salz, runden)
    geheim = AESGCM(kek).encrypt(
        nonce, dek, DATEN_AAD + b"\0dek\0" + dek_kennung)
    return {
        "runden": int(runden),
        "salz": base64.b64encode(salz).decode("ascii"),
        "dekNonce": base64.b64encode(nonce).decode("ascii"),
        "dekDaten": base64.b64encode(geheim).decode("ascii"),
    }


def daten_verschluesseln(text, kennwort, dek=None, dek_kennung=None,
                         umschlag=None):
    """Verschlüsselt Hauptdaten mit einem sitzungsbeständigen DEK."""
    try:
        from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    except ImportError:
        raise RuntimeError(
            _("An encryption component is missing. Install it with:  "
              "sudo apt install python3-cryptography"))
    if not kennwort:
        raise RuntimeError(_("Nothing can be encrypted without a password."))
    dek = os.urandom(32) if dek is None else dek
    dek_kennung = os.urandom(16) if dek_kennung is None else dek_kennung
    if (not isinstance(dek, bytes) or len(dek) != 32
            or not isinstance(dek_kennung, bytes) or len(dek_kennung) != 16):
        raise ValueError("Ungültiger Datenschlüssel")
    if umschlag is None:
        umschlag = _daten_dek_umschlag(dek, dek_kennung, kennwort)
    elif (not isinstance(umschlag, dict)
          or any(name not in umschlag for name in
                 ("runden", "salz", "dekNonce", "dekDaten"))):
        raise ValueError("Ungültiger Datenschlüsselumschlag")
    daten_nonce = os.urandom(12)
    geheim = AESGCM(dek).encrypt(
        daten_nonce, (text or "").encode("utf-8"),
        DATEN_AAD + b"\0inhalt\0" + dek_kennung)
    huelle = {
        "magnolie": KENNWORT_KENNUNG,
        "fassung": 2,
        "verfahren": DATEN_VERFAHREN,
        "dekKennung": base64.b64encode(dek_kennung).decode("ascii"),
        "datenNonce": base64.b64encode(daten_nonce).decode("ascii"),
        "daten": base64.b64encode(geheim).decode("ascii"),
    }
    huelle.update({name: umschlag[name] for name in
                   ("runden", "salz", "dekNonce", "dekDaten")})
    return json.dumps(huelle, ensure_ascii=False, indent=1)


def daten_huelle_anlegen(text, kennwort):
    """Erzeugt eine neue Hauptdatenhülle samt Sitzungszustand."""
    dek = os.urandom(32)
    dek_kennung = os.urandom(16)
    umschlag = _daten_dek_umschlag(dek, dek_kennung, kennwort)
    return (daten_verschluesseln(
        text, kennwort, dek, dek_kennung, umschlag),
        dek, dek_kennung, umschlag)


def daten_entschluesseln(text, kennwort, mit_schluessel=False):
    """Öffnet Hauptdaten und liefert auf Wunsch den DEK-Sitzungszustand."""
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    (huelle, runden, dek_kennung, salz, dek_nonce, dek_daten,
     daten_nonce, daten) = _daten_huelle_felder(text)
    kek = _schluessel_ableiten(kennwort, salz, runden)
    try:
        dek = AESGCM(kek).decrypt(
            dek_nonce, dek_daten, DATEN_AAD + b"\0dek\0" + dek_kennung)
    except Exception:
        raise RuntimeError(_("The password is incorrect."))
    try:
        klar = AESGCM(dek).decrypt(
            daten_nonce, daten, DATEN_AAD + b"\0inhalt\0" + dek_kennung)
        klartext = klar.decode("utf-8")
    except Exception:
        raise RuntimeError(_("The encrypted file is damaged."))
    if not mit_schluessel:
        return klartext
    umschlag = {name: huelle[name] for name in
                ("runden", "salz", "dekNonce", "dekDaten")}
    return klartext, dek, dek_kennung, umschlag


def daten_umschlagen(text, kennwort_alt, kennwort_neu):
    """Wechselt nur den Kennwortumschlag; die Nutzdaten bleiben bytegleich."""
    klar, dek, dek_kennung, _alt = daten_entschluesseln(
        text, kennwort_alt, mit_schluessel=True)
    del klar
    huelle = json.loads(text)
    huelle.update(_daten_dek_umschlag(dek, dek_kennung, kennwort_neu))
    return (json.dumps(huelle, ensure_ascii=False, indent=1), dek,
            dek_kennung, {name: huelle[name] for name in
                          ("runden", "salz", "dekNonce", "dekDaten")})


def ist_verschluesselt(text):
    """Steckt in diesem Text eine verschlüsselte Hülle?"""
    if not text or KENNWORT_KENNUNG not in text[:400]:
        return False
    try:
        huelle = json.loads(text)
    except ValueError:
        return False
    return (isinstance(huelle, dict)
            and huelle.get("magnolie") == KENNWORT_KENNUNG)


def sieht_verschluesselt_aus(anfang):
    """Erkennt die Hüllenkennung auch in einem abgeschnittenen Dateianfang."""
    return bool(re.search(
        r'"magnolie"\s*:\s*"%s"' % re.escape(KENNWORT_KENNUNG),
        str(anfang or "")[:400]))


def entschluesseln(text, kennwort):
    """Öffnet eine verschlüsselte Hülle. Bei falschem Kennwort scheitert es
    mit einer verständlichen Meldung – die Datei bleibt unangetastet."""
    try:
        from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    except ImportError:
        raise RuntimeError(
            _("An encryption component is missing. Install it with:  "
              "sudo apt install python3-cryptography"))
    import base64
    import binascii
    try:
        huelle = json.loads(text)
        if (isinstance(huelle, dict) and huelle.get("magnolie") == KENNWORT_KENNUNG
                and huelle.get("fassung") == 2):
            return daten_entschluesseln(text, kennwort)
        if (not isinstance(huelle, dict)
                or huelle.get("magnolie") != KENNWORT_KENNUNG
                or huelle.get("fassung") != 1
                or huelle.get("verfahren") != KENNWORT_VERFAHREN):
            raise ValueError
        runden = huelle.get("runden")
        if (isinstance(runden, bool) or not isinstance(runden, int)
                or not KENNWORT_RUNDEN_MIN <= runden <= KENNWORT_RUNDEN_MAX):
            raise ValueError
        if (not isinstance(huelle.get("salz"), str)
                or len(huelle["salz"]) != 24
                or not isinstance(huelle.get("nonce"), str)
                or len(huelle["nonce"]) != 16
                or not isinstance(huelle.get("daten"), str)):
            raise ValueError
        salz = base64.b64decode(huelle["salz"], validate=True)
        nonce = base64.b64decode(huelle["nonce"], validate=True)
        geheim = base64.b64decode(huelle["daten"], validate=True)
        if len(salz) != 16 or len(nonce) != 12 or len(geheim) < 16:
            raise ValueError
    except (ValueError, KeyError, TypeError, binascii.Error):
        raise RuntimeError(_("The encrypted file is damaged."))
    schluessel = _schluessel_ableiten(kennwort, salz, runden)
    try:
        klar = AESGCM(schluessel).decrypt(
            nonce, geheim, KENNWORT_KENNUNG.encode("utf-8"))
    except Exception:
        raise RuntimeError(_("The password is incorrect."))
    return klar.decode("utf-8")


# ----------------------------- Sperre nach Fehlversuchen -------------------

SPERRE_VERSUCHE = 3
SPERRE_MINUTEN = 5


def sperre_datei():
    return os.path.join(daten_verzeichnis(), "sperre.json")


def sperre_lesen(pfad=None):
    try:
        with open(pfad or sperre_datei(), "r", encoding="utf-8") as datei:
            roh = json.load(datei)
    except (OSError, ValueError):
        roh = {}
    if not isinstance(roh, dict):
        roh = {}
    try:
        versuche = int(roh.get("versuche") or 0)
    except (TypeError, ValueError):
        versuche = 0
    return {"versuche": max(0, versuche), "bis": str(roh.get("bis") or "")}


def sperre_schreiben(zustand, pfad=None):
    try:
        atomar_text_schreiben(
            pfad or sperre_datei(), json.dumps(zustand, ensure_ascii=False))
        return True
    except OSError:
        return False


def sperre_offen_bis(zustand):
    """Bis wann ist gesperrt? None, wenn nicht gesperrt."""
    if not (zustand or {}).get("bis"):
        return None
    try:
        return datetime.strptime(str(zustand["bis"])[:19], "%Y-%m-%d %H:%M:%S")
    except (TypeError, ValueError):
        return None


def sperre_pruefen(zustand, jetzt=None):
    """Darf jetzt ein Kennwort versucht werden? Liefert (erlaubt, Sekunden)."""
    jetzt = jetzt or datetime.now()
    bis = sperre_offen_bis(zustand)
    if bis and jetzt < bis:
        return False, int((bis - jetzt).total_seconds()) + 1
    return True, 0


def sperre_fehlversuch(zustand, jetzt=None, versuche=SPERRE_VERSUCHE,
                       minuten=SPERRE_MINUTEN):
    """Zählt einen Fehlversuch und sperrt nach der dritten Fehleingabe."""
    from datetime import timedelta
    jetzt = jetzt or datetime.now()
    neu = {"versuche": int((zustand or {}).get("versuche") or 0) + 1, "bis": ""}
    if neu["versuche"] >= max(1, versuche):
        neu["versuche"] = 0
        neu["bis"] = (jetzt + timedelta(minutes=max(1, minuten))).strftime(
            "%Y-%m-%d %H:%M:%S")
    return neu


def sperre_zuruecksetzen():
    return {"versuche": 0, "bis": ""}


def sicherungen_umschluesseln(kennwort_neu, kennwort_alt=None, ordner=None):
    """Verschlüsselt vorhandene Sicherungen oder gibt lokale wieder frei.

    Sicherungen außerhalb des Datenstandorts bleiben ausnahmslos
    verschlüsselt, auch wenn der Kennwortschutz des Organizers endet.
    """
    ordner = ordner or daten_verzeichnis()
    extern = sicherung_ist_extern(ordner)
    if not kennwort_neu and extern:
        return {"geschafft": 0, "misslungen": 0}
    geschafft, misslungen = 0, 0
    try:
        namen = sorted(os.listdir(ordner))
    except OSError:
        return {"geschafft": 0, "misslungen": 0}
    for name in namen:
        if not (name.startswith("sicherung-") and name.endswith(".json")):
            continue
        pfad = os.path.join(ordner, name)
        try:
            inhalt = _text_dekodieren(datei_begrenzt_lesen(
                pfad, SICHERUNG_DATEI_MAX,
                _("The backup file is larger than 256 megabytes.")))
            if ist_verschluesselt(inhalt):
                # Das bei einer externen Sicherung vergebene Kennwort gehört
                # zur Sicherung und ändert sich nicht mit dem Programmkennwort.
                if extern:
                    continue
                if not kennwort_alt:
                    continue
                huelle = json.loads(inhalt)
                if huelle.get("fassung") == 2 and kennwort_neu:
                    neu = daten_umschlagen(
                        inhalt, kennwort_alt, kennwort_neu)[0]
                    if len(neu.encode("utf-8")) > SICHERUNG_DATEI_MAX:
                        raise GroessenFehler(
                            _("The backup file is larger than 256 megabytes."))
                    atomar_text_schreiben(pfad, neu)
                    geschafft += 1
                    continue
                inhalt = entschluesseln(inhalt, kennwort_alt)
            neu = (daten_huelle_anlegen(inhalt, kennwort_neu)[0]
                   if kennwort_neu else inhalt)
            if len(neu.encode("utf-8")) > SICHERUNG_DATEI_MAX:
                raise GroessenFehler(
                    _("The backup file is larger than 256 megabytes."))
            atomar_text_schreiben(pfad, neu)
            geschafft += 1
        except Exception:
            misslungen += 1
    return {"geschafft": geschafft, "misslungen": misslungen}


# ---------------------------------------------------------------------------
# Magnolienbaum: mehrere Organizer schließen sich zusammen
#
# Jede Instanz hat ein dauerhaftes Schlüsselpaar. Zwei Instanzen schließen
# einmalig Bekanntschaft, indem beide denselben sechsstelligen Code
# vergleichen und bestätigen ("Paarung"). Danach reisen Nachrichten
# verschlüsselt und beglaubigt zwischen ihnen.
#
# Der geheime Schlüssel liegt in einer eigenen Datei mit Rechten 0600 und
# wird niemals an die Oberfläche gereicht.
# ---------------------------------------------------------------------------

BAUM_PORT = 8737
BAUM_KENNUNG_ZEICHEN = "abcdefghijkmnopqrstuvwxyz23456789"
BAUM_HÜLLE = "baum-1"
BAUM_ZUSATZ = b"magnolienbaum"
BAUM_HTTP_PAARUNG_MAX = 128 * 1024
BAUM_NACHRICHT_MAX = 40 * 1024 * 1024
BAUM_HTTP_NACHRICHT_MAX = BAUM_NACHRICHT_MAX
BAUM_PARTNER_MAX = 100
BAUM_UNBESTAETIGT_MAX = 20
BAUM_HTTP_FADEN_MAX = 16
BAUM_HTTP_PRO_ADRESSE_MAX = 4
BAUM_HTTP_INAKTIV_SEKUNDEN = 5
BAUM_HTTP_GESAMT_SEKUNDEN = 45
BAUM_PAARUNG_DATEI_MAX = 8192
BAUM_PAARUNG_GUELTIGKEIT = 15 * 60
BAUM_FS_SITZUNGEN_MAX = 64
BAUM_FS_SITZUNG_SEKUNDEN = 30
BAUM_POST_TAKT_SEKUNDEN = 30
BAUM_BLUETOOTH_UUID = "6d61676e-6f6c-6965-6e62-61756d383733"
BAUM_BLUETOOTH_RAHMEN_MAX = BAUM_NACHRICHT_MAX
BAUM_DATEI_KENNUNG = "magnolie-baum-verschluesselt"
BAUM_DATEI_VERFAHREN = "AES-256-GCM+DEK/PBKDF2-SHA256"
BAUM_DATEI_AAD = b"magnolie-baum-v1"
BAUM_MDNS_ART = "_magnolie._tcp.local."
BAUM_KONTAKT_LISTE_MAX = 100
BAUM_KONTAKT_TEXT_MAX = 2048
BAUM_KONTAKT_NOTIZ_MAX = 20000
BAUM_KONTAKT_FOTO_MAX = 2800000
def baum_kontakt_sync_pruefen(inhalt):
    """Validiert den interoperablen Kontaktvertrag ohne stilles Bereinigen."""
    kopf = {"art", "fassung", "freigabeId", "version", "quelle", "geaendert",
            "kontakt"}
    kontakt_felder = {"vorname", "nachname", "firma", "notiz", "geburtstag",
                       "telefone", "emailEintraege", "anschriften"}
    fehler = _("The contact synchronization message is invalid.")
    if (not isinstance(inhalt, dict) or set(inhalt) != kopf
            or inhalt.get("art") != "kontakt_sync" or inhalt.get("fassung") != 1):
        raise RuntimeError(fehler)
    for feld in ("freigabeId", "quelle"):
        wert = inhalt.get(feld)
        if (not isinstance(wert, str) or not wert or len(wert) > 128
                or any(ord(zeichen) < 32 for zeichen in wert)):
            raise RuntimeError(fehler)
    version = inhalt.get("version")
    geaendert = inhalt.get("geaendert")
    if isinstance(version, bool) or not isinstance(version, int) or version < 1:
        raise RuntimeError(fehler)
    if isinstance(geaendert, bool) or not isinstance(geaendert, int) or geaendert < 0:
        raise RuntimeError(fehler)
    kontakt = inhalt.get("kontakt")
    if (not isinstance(kontakt, dict)
            or set(kontakt) not in (kontakt_felder, kontakt_felder | {"foto"})):
        raise RuntimeError(fehler)
    for feld in ("vorname", "nachname", "firma", "geburtstag"):
        wert = kontakt.get(feld)
        if not isinstance(wert, str) or len(wert) > BAUM_KONTAKT_TEXT_MAX:
            raise RuntimeError(fehler)
    if (not isinstance(kontakt.get("notiz"), str)
            or len(kontakt["notiz"]) > BAUM_KONTAKT_NOTIZ_MAX):
        raise RuntimeError(fehler)
    if kontakt["geburtstag"]:
        try:
            if datetime.strptime(kontakt["geburtstag"], "%Y-%m-%d").strftime(
                    "%Y-%m-%d") != kontakt["geburtstag"]:
                raise ValueError
        except ValueError:
            raise RuntimeError(fehler)
    if "foto" in kontakt:
        import base64
        import binascii
        foto = kontakt["foto"]
        if not isinstance(foto, str) or len(foto) > BAUM_KONTAKT_FOTO_MAX:
            raise RuntimeError(fehler)
        if foto:
            treffer = re.fullmatch(
                r"data:image/(?:jpeg|png|webp);base64,([A-Za-z0-9+/]+={0,2})", foto)
            if not treffer:
                raise RuntimeError(fehler)
            try:
                if not base64.b64decode(treffer.group(1), validate=True):
                    raise ValueError
            except (ValueError, binascii.Error):
                raise RuntimeError(fehler)
    for listenname, felder in (("telefone", {"art", "wert"}),
                               ("emailEintraege", {"art", "wert"}),
                               ("anschriften", {"art", "strasse", "plz", "ort",
                                                "region", "land"})):
        liste = kontakt.get(listenname)
        if not isinstance(liste, list) or len(liste) > BAUM_KONTAKT_LISTE_MAX:
            raise RuntimeError(fehler)
        for eintrag in liste:
            if not isinstance(eintrag, dict) or set(eintrag) != felder:
                raise RuntimeError(fehler)
            if any(not isinstance(wert, str) or len(wert) > BAUM_KONTAKT_TEXT_MAX
                   or wert.lower().startswith("data:") for wert in eintrag.values()):
                raise RuntimeError(fehler)
            if str(eintrag.get("art") or "").strip().lower() in {
                    "delete", "deleted", "deletion", "tombstone", "loeschen",
                    "löschen", "geloescht", "gelöscht"}:
                raise RuntimeError(fehler)
    text = json.dumps(inhalt, ensure_ascii=False).lower()
    text_ohne_foto = json.dumps(
        dict(inhalt, kontakt={name: wert for name, wert in kontakt.items()
                              if name != "foto"}), ensure_ascii=False).lower()
    verboten = ("photo", "dataurl", "geloescht", "gelöscht", "deleted",
                "delete", "tombstone", "loeschen", "löschen", "uid", "sync")
    if (any(('"%s"' % marker) in text for marker in verboten)
            or "data:" in text_ohne_foto):
        raise RuntimeError(fehler)
    return inhalt


def baum_kontakt_loeschen_pruefen(inhalt):
    """Validiert einen rein manuellen, partnergebundenen Löschvorschlag."""
    felder = {"art", "fassung", "freigabeId", "version", "quelle", "geaendert"}
    fehler = _("The contact synchronization message is invalid.")
    if (not isinstance(inhalt, dict) or set(inhalt) != felder
            or inhalt.get("art") != "kontakt_loeschen" or inhalt.get("fassung") != 1):
        raise RuntimeError(fehler)
    for name in ("freigabeId", "quelle"):
        wert = inhalt.get(name)
        if (not isinstance(wert, str) or not wert or len(wert) > 128
                or any(ord(zeichen) < 32 for zeichen in wert)):
            raise RuntimeError(fehler)
    for name, minimum in (("version", 1), ("geaendert", 0)):
        wert = inhalt.get(name)
        if isinstance(wert, bool) or not isinstance(wert, int) or wert < minimum:
            raise RuntimeError(fehler)
    return inhalt


def baum_kontakt_nutzlast_pruefen(art, inhalt):
    if art in ("geraete_status_anfrage", "geraete_status"):
        raise RuntimeError(_("This type cannot be shared."))
    if art == "kontakt_sync":
        return baum_kontakt_sync_pruefen(inhalt)
    if art == "kontakt_loeschen":
        return baum_kontakt_loeschen_pruefen(inhalt)
    return inhalt


def baum_host_normieren(host, nur_ip=False):
    """Prüft einen Host und speichert IP-Literale ohne URL-Klammern."""
    import ipaddress
    text = str(host or "").strip()
    if text.startswith("[") and text.endswith("]"):
        text = text[1:-1]
    if (not text or len(text) > 253 or any(ord(zeichen) < 33 for zeichen in text)
            or any(zeichen in text for zeichen in "/\\@?#")):
        raise RuntimeError(_("Enter a valid host name or IP address."))
    try:
        return str(ipaddress.ip_address(text))
    except ValueError:
        if nur_ip:
            raise RuntimeError(_("Enter a valid reachable IPv4 or IPv6 address."))
    try:
        ascii_host = text.rstrip(".").encode("idna").decode("ascii").lower()
    except UnicodeError:
        raise RuntimeError(_("Enter a valid host name or IP address."))
    if (not ascii_host or any(not teil or len(teil) > 63 or
            not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]*[a-z0-9])?", teil)
            for teil in ascii_host.split("."))):
        raise RuntimeError(_("Enter a valid host name or IP address."))
    return ascii_host


def baum_quelladresse_normieren(host):
    """Vereinheitlicht Quelladressen für Sitzungsbindung und Begrenzungen."""
    import ipaddress
    try:
        adresse = ipaddress.ip_address(str(host).split("%", 1)[0])
        if getattr(adresse, "ipv4_mapped", None):
            adresse = adresse.ipv4_mapped
        return str(adresse)
    except ValueError:
        return str(host or "").strip().lower()


def baum_url(host, port, pfad=""):
    """Baut eine HTTP-URL, einschließlich IPv6-Literalen und Zonenkennung."""
    host = baum_host_normieren(host)
    url_host = "[%s]" % host.replace("%", "%25") if ":" in host else host
    return "http://%s:%d%s" % (url_host, int(port), pfad)


def baum_host_port_anzeigen(host, port):
    host = baum_host_normieren(host)
    return "[%s]:%d" % (host, int(port)) if ":" in host else "%s:%d" % (
        host, int(port))


def baum_port_pruefen(port):
    """Prüft einen TCP-Port ohne boolesche oder still umgewandelte Werte."""
    if isinstance(port, bool):
        raise RuntimeError(_("Enter a valid port between 1 and 65535."))
    try:
        nummer = int(port)
    except (TypeError, ValueError):
        raise RuntimeError(_("Enter a valid port between 1 and 65535."))
    if str(port).strip() != str(nummer) or not 1 <= nummer <= 65535:
        raise RuntimeError(_("Enter a valid port between 1 and 65535."))
    return nummer


def baum_firewall_einrichten(ufw_config="/etc/ufw/ufw.conf", starter=None,
                             ufw_befehl=None, pkexec_befehl=None):
    """Öffnet den Baum-Port nur beim Einschalten und nur bei aktivem UFW.

    Die bestätigte Regel bleibt bis zur Paketentfernung bestehen; siehe
    REVIEW-ENTSCHEIDUNGEN.md.
    """
    import subprocess
    try:
        with open(ufw_config, "r", encoding="utf-8") as datei:
            aktiv = any(zeile.strip().upper() == "ENABLED=YES" for zeile in datei)
    except OSError:
        aktiv = False
    if not aktiv:
        return True, ""
    ufw = ufw_befehl or next(
        (pfad for pfad in ("/usr/sbin/ufw", "/usr/bin/ufw")
         if os.path.isfile(pfad) and os.access(pfad, os.X_OK)), None)
    if not ufw:
        return False, _("UFW is active, but its command could not be found.")
    if starter is None:
        starter = subprocess.run
    befehl = [ufw, "allow", "Magnolie Organizer"]
    if hasattr(os, "geteuid") and os.geteuid() != 0:
        pkexec = pkexec_befehl or next(
            (pfad for pfad in ("/usr/bin/pkexec", "/bin/pkexec")
             if os.path.isfile(pfad) and os.access(pfad, os.X_OK)), None)
        if not pkexec:
            return False, _("System authentication for configuring UFW is unavailable.")
        befehl.insert(0, pkexec)
    try:
        ergebnis = starter(befehl, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=120)
    except (OSError, subprocess.SubprocessError) as fehler:
        return False, _("UFW could not be configured (%s).") % fehler_kurz(fehler)
    if ergebnis.returncode:
        return False, _("UFW configuration was cancelled or failed.")
    return True, ""


def fehler_kurz(fehler):
    """Eine knappe, lesbare Fassung einer Fehlermeldung."""
    text = str(fehler or "").strip()
    return (text[:80] + "…") if len(text) > 80 else (text or _("no reason given"))


def baum_datei(ordner=None):
    return os.path.join(ordner or daten_verzeichnis(), "baum.json")


def baum_postdatei(ordner=None):
    return os.path.join(ordner or daten_verzeichnis(), "baum-post.json")


def baum_moeglich():
    """Steht die Verschlüsselung für den Baum zur Verfügung?"""
    try:
        from cryptography.hazmat.primitives.asymmetric.x25519 import (
            X25519PrivateKey as _X25519PrivateKey)
        from cryptography.hazmat.primitives.ciphers.aead import AESGCM as _AESGCM
        return _X25519PrivateKey is not None and _AESGCM is not None
    except ImportError:
        return False


def _zufallskennung(laenge=16):
    import secrets
    return "".join(secrets.choice(BAUM_KENNUNG_ZEICHEN) for _ in range(laenge))


def baum_schluessel_erzeugen(name=""):
    """Legt ein neues, dauerhaftes Schlüsselpaar an."""
    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey
    from cryptography.hazmat.primitives.serialization import (
        Encoding, PrivateFormat, PublicFormat, NoEncryption)
    import base64
    geheim = X25519PrivateKey.generate()
    roh_geheim = geheim.private_bytes(Encoding.Raw, PrivateFormat.Raw,
                                      NoEncryption())
    roh_oeffentlich = geheim.public_key().public_bytes(Encoding.Raw,
                                                       PublicFormat.Raw)
    return {
        "kennung": _zufallskennung(),
        "name": name or _rechnername(),
        "geheim": base64.b64encode(roh_geheim).decode("ascii"),
        "oeffentlich": base64.b64encode(roh_oeffentlich).decode("ascii"),
        "an": False,
        "port": BAUM_PORT,
        "partner": [],
    }


def _rechnername():
    import socket
    try:
        name = socket.gethostname().split(".")[0]
    except Exception:
        name = ""
    return name or "Magnolie"


def _baum_zustand_pruefen(zustand):
    """Prüft eine persistierte Baumidentität, ohne sie bei Fehlern zu ersetzen."""
    import base64
    if not isinstance(zustand, dict):
        raise RuntimeError(_("The Magnolienbaum identity file is damaged."))
    try:
        geheim = base64.b64decode(str(zustand.get("geheim") or ""), validate=True)
        oeffentlich = base64.b64decode(
            str(zustand.get("oeffentlich") or ""), validate=True)
    except Exception:
        raise RuntimeError(_("The Magnolienbaum identity file is damaged."))
    if (not isinstance(zustand, dict) or len(geheim) != 32
            or len(oeffentlich) != 32
            or not isinstance(zustand.get("kennung"), str)
            or not isinstance(zustand.get("partner", []), list)):
        raise RuntimeError(_("The Magnolienbaum identity file is damaged."))
    zustand.setdefault("partner", [])
    zustand.setdefault("port", BAUM_PORT)
    zustand.setdefault("an", False)
    for partner in zustand["partner"]:
        if not isinstance(partner, dict):
            raise RuntimeError(_("The Magnolienbaum identity file is damaged."))
        partner.setdefault("vertraut", False)
        partner.setdefault("kontakte", False)
        partner.setdefault("kontaktLoeschen", False)
        partner.setdefault("fernAdresse", "")
        partner.setdefault("fernPort", BAUM_PORT)
    return zustand


def baum_datei_ist_verschluesselt(text):
    try:
        huelle = json.loads(text)
    except (TypeError, ValueError):
        return False
    return (isinstance(huelle, dict)
            and huelle.get("magnolie") == BAUM_DATEI_KENNUNG)


def _baum_huelle_felder(text):
    """Validiert und dekodiert die Baumhülle vor jeder Schlüsselableitung."""
    import base64
    import binascii
    try:
        huelle = json.loads(text)
        if (not isinstance(huelle, dict)
                or huelle.get("magnolie") != BAUM_DATEI_KENNUNG
                or huelle.get("fassung") != 1
                or huelle.get("verfahren") != BAUM_DATEI_VERFAHREN):
            raise ValueError
        runden = huelle.get("runden")
        if (isinstance(runden, bool) or not isinstance(runden, int)
                or not KENNWORT_RUNDEN_MIN <= runden <= KENNWORT_RUNDEN_MAX):
            raise ValueError
        felder = {}
        for name, laenge in (("dekKennung", 16), ("salz", 16),
                             ("dekNonce", 12), ("datenNonce", 12)):
            if not isinstance(huelle.get(name), str):
                raise ValueError
            felder[name] = base64.b64decode(huelle[name], validate=True)
            if len(felder[name]) != laenge:
                raise ValueError
        for name, minimum in (("dekDaten", 48), ("daten", 16)):
            if not isinstance(huelle.get(name), str):
                raise ValueError
            felder[name] = base64.b64decode(huelle[name], validate=True)
            if len(felder[name]) < minimum:
                raise ValueError
        if len(felder["dekDaten"]) != 48:
            raise ValueError
        felder["runden"] = runden
        return huelle, felder
    except (KeyError, TypeError, ValueError, binascii.Error):
        raise RuntimeError(_("The encrypted Magnolienbaum identity is damaged."))


def _baum_dek_umschlag(dek, dek_kennung, kennwort,
                       runden=KENNWORT_RUNDEN, salz=None, nonce=None):
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    import base64
    salz = os.urandom(16) if salz is None else salz
    nonce = os.urandom(12) if nonce is None else nonce
    kek = _schluessel_ableiten(kennwort, salz, runden)
    daten = AESGCM(kek).encrypt(
        nonce, dek, BAUM_DATEI_AAD + b"\0dek\0" + dek_kennung)
    return {"runden": runden,
            "salz": base64.b64encode(salz).decode("ascii"),
            "dekNonce": base64.b64encode(nonce).decode("ascii"),
            "dekDaten": base64.b64encode(daten).decode("ascii")}


def _baum_huelle_bauen(zustand, kennwort, dek=None, dek_kennung=None,
                       umschlag=None):
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    import base64
    if not kennwort:
        raise RuntimeError(_("Nothing can be encrypted without a password."))
    zustand = _baum_zustand_pruefen(zustand)
    dek = os.urandom(32) if dek is None else dek
    dek_kennung = os.urandom(16) if dek_kennung is None else dek_kennung
    if len(dek) != 32 or len(dek_kennung) != 16:
        raise RuntimeError(_("The encrypted Magnolienbaum identity is damaged."))
    umschlag = umschlag or _baum_dek_umschlag(dek, dek_kennung, kennwort)
    daten_nonce = os.urandom(12)
    klar = json.dumps(zustand, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    daten = AESGCM(dek).encrypt(
        daten_nonce, klar, BAUM_DATEI_AAD + b"\0inhalt\0" + dek_kennung)
    huelle = {"magnolie": BAUM_DATEI_KENNUNG, "fassung": 1,
              "verfahren": BAUM_DATEI_VERFAHREN,
              "dekKennung": base64.b64encode(dek_kennung).decode("ascii"),
              "runden": umschlag["runden"], "salz": umschlag["salz"],
              "dekNonce": umschlag["dekNonce"], "dekDaten": umschlag["dekDaten"],
              "datenNonce": base64.b64encode(daten_nonce).decode("ascii"),
              "daten": base64.b64encode(daten).decode("ascii")}
    return json.dumps(huelle, ensure_ascii=False, indent=1), dek, dek_kennung, umschlag


def _baum_huelle_oeffnen(text, kennwort):
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    huelle, felder = _baum_huelle_felder(text)
    if not kennwort:
        raise RuntimeError(_("The Magnolienbaum identity is encrypted. Unlock the organizer first."))
    kek = _schluessel_ableiten(kennwort, felder["salz"], felder["runden"])
    try:
        dek = AESGCM(kek).decrypt(
            felder["dekNonce"], felder["dekDaten"],
            BAUM_DATEI_AAD + b"\0dek\0" + felder["dekKennung"])
    except Exception:
        raise RuntimeError(_("The password is incorrect."))
    try:
        klar = AESGCM(dek).decrypt(
            felder["datenNonce"], felder["daten"],
            BAUM_DATEI_AAD + b"\0inhalt\0" + felder["dekKennung"])
        zustand = _baum_zustand_pruefen(json.loads(klar.decode("utf-8")))
    except Exception as fehler:
        if isinstance(fehler, RuntimeError):
            raise
        raise RuntimeError(_("The encrypted Magnolienbaum identity is damaged."))
    umschlag = {name: huelle[name] for name in
                ("runden", "salz", "dekNonce", "dekDaten")}
    return zustand, dek, felder["dekKennung"], umschlag


def _baum_huelle_umschlagen(text, kennwort_alt, kennwort_neu):
    zustand, dek, dek_kennung, _umschlag = _baum_huelle_oeffnen(
        text, kennwort_alt)
    if not kennwort_neu:
        return (json.dumps(zustand, ensure_ascii=False, indent=1),
                zustand, None, None, None)
    huelle, felder = _baum_huelle_felder(text)
    neu = _baum_dek_umschlag(dek, dek_kennung, kennwort_neu)
    huelle.update(neu)
    return (json.dumps(huelle, ensure_ascii=False, indent=1),
            zustand, dek, dek_kennung, neu)


def baum_lesen(pfad=None, kennwort="", mit_schluessel=False):
    """Liest die Baumdatei fail-closed; nur eine fehlende Datei wird angelegt."""
    pfad = pfad or baum_datei()
    try:
        with open(pfad, "r", encoding="utf-8") as datei:
            text = datei.read()
    except FileNotFoundError:
        if not baum_moeglich():
            return (None, None, None, None) if mit_schluessel else None
        zustand = baum_schluessel_erzeugen()
        if kennwort:
            text, dek, dek_kennung, umschlag = _baum_huelle_bauen(
                zustand, kennwort)
            atomar_text_schreiben(pfad, text)
        else:
            dek = dek_kennung = umschlag = None
            atomar_text_schreiben(
                pfad, json.dumps(zustand, ensure_ascii=False, indent=1))
        return ((zustand, dek, dek_kennung, umschlag)
                if mit_schluessel else zustand)
    except OSError as fehler:
        raise RuntimeError(fehler_deutsch(fehler, _("Reading the Magnolienbaum identity")))
    if baum_datei_ist_verschluesselt(text):
        zustand, dek, dek_kennung, umschlag = _baum_huelle_oeffnen(text, kennwort)
    else:
        try:
            zustand = _baum_zustand_pruefen(json.loads(text))
        except (TypeError, ValueError):
            raise RuntimeError(_("The Magnolienbaum identity file is damaged."))
        dek = dek_kennung = umschlag = None
        if kennwort:
            neu, dek, dek_kennung, umschlag = _baum_huelle_bauen(zustand, kennwort)
            atomar_text_schreiben(pfad, neu)
    return ((zustand, dek, dek_kennung, umschlag)
            if mit_schluessel else zustand)


def baum_schreiben(zustand, pfad=None, kennwort="", dek=None,
                    dek_kennung=None, umschlag=None):
    """Schreibt die Baumidentität atomar und bei Kennwortschutz verschlüsselt."""
    pfad = pfad or baum_datei()
    zustand = _baum_zustand_pruefen(zustand)
    if kennwort:
        if dek is None or dek_kennung is None or umschlag is None:
            raise RuntimeError(_("The Magnolienbaum encryption key is unavailable."))
        text, _dek, _kennung, _umschlag = _baum_huelle_bauen(
            zustand, kennwort, dek, dek_kennung, umschlag)
    else:
        text = json.dumps(zustand, ensure_ascii=False, indent=1)
    atomar_text_schreiben(pfad, text)
    return True


def fingerabdruck(oeffentlich_b64):
    """Kurze, gut vorlesbare Kennzeichnung eines Schlüssels."""
    import base64
    import hashlib
    try:
        roh = base64.b64decode(oeffentlich_b64)
    except Exception:
        return ""
    h = hashlib.sha256(roh + BAUM_ZUSATZ).hexdigest().upper()
    return "-".join(h[i:i + 4] for i in range(0, 16, 4))


def baum_fingerabdruck_normieren(text):
    """Vereinheitlicht einen eingetippten Magnolienbaum-Fingerabdruck."""
    zeichen = re.sub(r"[^0-9A-Fa-f]", "", str(text or "")).upper()
    if len(zeichen) != 16:
        return ""
    return "-".join(zeichen[i:i + 4] for i in range(0, 16, 4))


def baum_oeffentlicher_schluessel_gueltig(oeffentlich_b64):
    import base64
    try:
        roh = base64.b64decode(str(oeffentlich_b64), validate=True)
    except Exception:
        return False
    return len(roh) == 32


def paarungs_code(oeffentlich_a, oeffentlich_b):
    """Der sechsstellige Code, den beide Seiten vergleichen.

    Die beiden Schlüssel werden der Größe nach geordnet, damit beide
    Seiten unabhängig voneinander dasselbe errechnen."""
    import base64
    import hashlib
    try:
        a = base64.b64decode(oeffentlich_a)
        b = base64.b64decode(oeffentlich_b)
    except Exception:
        return ""
    klein, gross = (a, b) if a <= b else (b, a)
    h = hashlib.sha256(klein + gross + BAUM_ZUSATZ).digest()
    zahl = int.from_bytes(h[:4], "big") % 1000000
    text = "%06d" % zahl
    return text[:3] + " " + text[3:]


def _baum_kanonisch(wert):
    return json.dumps(wert, ensure_ascii=True, sort_keys=True,
                      separators=(",", ":"), allow_nan=False).encode("utf-8")


def _baum_b64url(roh):
    import base64
    return base64.urlsafe_b64encode(roh).decode("ascii").rstrip("=")


def _baum_b64url_lesen(text, laenge):
    import base64
    import binascii
    if not isinstance(text, str) or "=" in text or len(text) > 200:
        raise RuntimeError(_("The pairing file is damaged."))
    try:
        roh = base64.b64decode(text + "=" * (-len(text) % 4),
                               altchars=b"-_", validate=True)
    except (ValueError, binascii.Error):
        raise RuntimeError(_("The pairing file is damaged."))
    if len(roh) != laenge:
        raise RuntimeError(_("The pairing file is damaged."))
    return roh


def _baum_hmac(schluessel, kennung, wert):
    import hashlib
    import hmac
    return hmac.new(schluessel, kennung + _baum_kanonisch(wert),
                    hashlib.sha256).digest()


def _baum_paarungsdatei_oeffentlich(dokument):
    return {name: dokument[name] for name in
            ("magnolie", "fassung", "paarung", "erstellt", "gueltigBis",
             "ziel", "einlader")}


def baum_paarungsdatei_erzeugen(zustand, adresse, port=BAUM_PORT,
                                 jetzt=None, geheimnis=None):
    """Erzeugt Datei und serverseitige Einmaleinladung ohne UI-Zugriff."""
    import hashlib
    import ipaddress
    jetzt = int(time.time() if jetzt is None else jetzt)
    adresse = baum_host_normieren(adresse, nur_ip=True)
    ip_adresse = ipaddress.ip_address(adresse)
    if (ip_adresse.is_unspecified or ip_adresse.is_multicast or
            ip_adresse.is_link_local and "%" not in adresse):
        raise RuntimeError(_("Enter a valid reachable IPv4 or IPv6 address."))
    port = int(port)
    if not 1 <= port <= 65535:
        raise RuntimeError(_("The port is invalid."))
    offen = [e for e in zustand.get("paarungen", [])
             if int(e.get("gueltigBis") or 0) > jetzt]
    if len(offen) >= BAUM_UNBESTAETIGT_MAX:
        raise RuntimeError(_("Too many pairing files are still valid."))
    geheimnis = os.urandom(32) if geheimnis is None else geheimnis
    if not isinstance(geheimnis, bytes) or len(geheimnis) != 32:
        raise ValueError("Ungültiges Paarungsgeheimnis")
    commitment = hashlib.sha256(
        b"magnolie-pair-commit-v2\0" + geheimnis).digest()
    dokument = {
        "magnolie": "magnolie-paarungsdatei", "fassung": 2,
        "paarung": _baum_b64url(commitment), "erstellt": jetzt,
        "gueltigBis": jetzt + BAUM_PAARUNG_GUELTIGKEIT,
        "ziel": {"adresse": adresse, "port": port},
        "einlader": {"kennung": zustand.get("kennung") or "",
                      "name": zustand.get("name") or "",
                      "oeffentlich": zustand.get("oeffentlich") or "",
                      "port": int(zustand.get("port") or BAUM_PORT)},
        "geheimnis": _baum_b64url(geheimnis),
    }
    oeffentlich = _baum_paarungsdatei_oeffentlich(dokument)
    dokument["mac"] = _baum_b64url(_baum_hmac(
        geheimnis, b"magnolie-pair-file-v2\0", oeffentlich))
    einladung = {"paarung": dokument["paarung"],
                  "geheimnis": dokument["geheimnis"],
                  "gueltigBis": dokument["gueltigBis"]}
    zustand["paarungen"] = offen + [einladung]
    # Alte Belege begrenzen; sie enthalten kein Einmalgeheimnis.
    zustand["paarungenVerbraucht"] = [e for e in
        zustand.get("paarungenVerbraucht", [])
        if int(e.get("behaltenBis") or 0) > jetzt][-99:]
    return dokument, einladung


def baum_paarungslink(dokument):
    roh = _baum_kanonisch(dokument)
    if len(roh) > BAUM_PAARUNG_DATEI_MAX:
        raise RuntimeError(_("The pairing file is too large."))
    return "magnolie-pair:" + base64.urlsafe_b64encode(roh).rstrip(
        b"=").decode("ascii")


def baum_paarungsqr(dokument):
    """Stellt dieselbe Paarungsdatei als QR-Link dar, ohne neues Vertrauen."""
    import io
    try:
        import qrcode
        from qrcode.image.svg import SvgPathImage
    except ImportError as fehler:
        raise RuntimeError(_(
            "QR codes require the python3-qrcode package.")) from fehler
    link = baum_paarungslink(dokument)
    qr = qrcode.QRCode(error_correction=qrcode.constants.ERROR_CORRECT_M,
                       border=4, box_size=8)
    qr.add_data(link)
    qr.make(fit=True)
    ausgabe = io.BytesIO()
    qr.make_image(image_factory=SvgPathImage).save(ausgabe)
    return "data:image/svg+xml;base64," + base64.b64encode(
        ausgabe.getvalue()).decode("ascii")


def baum_paarungsdatei_pruefen(dokument, jetzt=None):
    import hashlib
    import hmac
    import ipaddress
    jetzt = int(time.time() if jetzt is None else jetzt)
    if (not isinstance(dokument, dict)
            or set(dokument) != {"magnolie", "fassung", "paarung", "erstellt",
                                 "gueltigBis", "ziel", "einlader", "geheimnis", "mac"}
            or dokument.get("magnolie") != "magnolie-paarungsdatei"
            or dokument.get("fassung") != 2
            or not isinstance(dokument.get("erstellt"), int)
            or isinstance(dokument.get("erstellt"), bool)
            or not isinstance(dokument.get("gueltigBis"), int)
            or isinstance(dokument.get("gueltigBis"), bool)
            or dokument["gueltigBis"] <= jetzt
            or dokument["gueltigBis"] - dokument["erstellt"] > 3600
            or not isinstance(dokument.get("ziel"), dict)
            or set(dokument["ziel"]) != {"adresse", "port"}
            or not isinstance(dokument.get("einlader"), dict)
            or set(dokument["einlader"]) != {"kennung", "name", "oeffentlich", "port"}):
        raise RuntimeError(_("The pairing file is invalid or has expired."))
    try:
        adresse = ipaddress.ip_address(str(dokument["ziel"]["adresse"]))
        port = dokument["ziel"]["port"]
        if (adresse.is_unspecified or adresse.is_multicast or
                adresse.is_link_local and "%" not in str(adresse) or
                isinstance(port, bool) or not 1 <= int(port) <= 65535):
            raise ValueError
    except (TypeError, ValueError):
        raise RuntimeError(_("The pairing file is damaged."))
    if (not dokument["einlader"]["kennung"]
            or not baum_oeffentlicher_schluessel_gueltig(
                dokument["einlader"]["oeffentlich"])):
        raise RuntimeError(_("The pairing file is damaged."))
    geheimnis = _baum_b64url_lesen(dokument["geheimnis"], 32)
    commitment = _baum_b64url_lesen(dokument["paarung"], 32)
    erwartet = hashlib.sha256(b"magnolie-pair-commit-v2\0" + geheimnis).digest()
    mac = _baum_b64url_lesen(dokument["mac"], 32)
    if (not hmac.compare_digest(commitment, erwartet)
            or not hmac.compare_digest(mac, _baum_hmac(
                geheimnis, b"magnolie-pair-file-v2\0",
                _baum_paarungsdatei_oeffentlich(dokument)))):
        raise RuntimeError(_("The pairing file has been changed."))
    return dokument


def baum_paarungsanfrage_bauen(zustand, dokument, nonce=None):
    dokument = baum_paarungsdatei_pruefen(dokument)
    geheimnis = _baum_b64url_lesen(dokument["geheimnis"], 32)
    kern = {"magnolie": "baum-paarung-2", "paarung": dokument["paarung"],
            "nonce": _baum_b64url(os.urandom(32) if nonce is None else nonce),
            "zweig": {"kennung": zustand.get("kennung") or "",
                       "name": zustand.get("name") or "",
                       "oeffentlich": zustand.get("oeffentlich") or "",
                       "port": int(zustand.get("port") or BAUM_PORT)}}
    anfrage = dict(kern)
    anfrage["beweis"] = _baum_b64url(_baum_hmac(
        geheimnis, b"magnolie-pair-request-v2\0", kern))
    return anfrage


def baum_paarungsanfrage_annehmen(zustand, anfrage, adresse="", jetzt=None):
    import hashlib
    import hmac
    jetzt = int(time.time() if jetzt is None else jetzt)
    if (not isinstance(anfrage, dict)
            or set(anfrage) != {"magnolie", "paarung", "nonce", "zweig", "beweis"}
            or anfrage.get("magnolie") != "baum-paarung-2"
            or not isinstance(anfrage.get("zweig"), dict)
            or set(anfrage["zweig"]) != {"kennung", "name", "oeffentlich", "port"}):
        raise RuntimeError(_("The pairing request is invalid."))
    anfrage_hash = hashlib.sha256(_baum_kanonisch(anfrage)).hexdigest()
    for alt in zustand.get("paarungenVerbraucht", []):
        if (alt.get("paarung") == anfrage.get("paarung")
                and alt.get("anfrageHash") == anfrage_hash):
            return alt["antwort"]
    einladung = next((e for e in zustand.get("paarungen", [])
                       if e.get("paarung") == anfrage.get("paarung")), None)
    if not einladung or int(einladung.get("gueltigBis") or 0) <= jetzt:
        raise RuntimeError(_("The pairing file is no longer valid."))
    geheimnis = _baum_b64url_lesen(einladung.get("geheimnis"), 32)
    _baum_b64url_lesen(anfrage.get("nonce"), 32)
    zweig = anfrage["zweig"]
    if (not zweig.get("kennung")
            or not baum_oeffentlicher_schluessel_gueltig(zweig.get("oeffentlich"))):
        raise RuntimeError(_("The pairing request is invalid."))
    kern = dict(anfrage)
    beweis = _baum_b64url_lesen(kern.pop("beweis"), 32)
    if not hmac.compare_digest(beweis, _baum_hmac(
            geheimnis, b"magnolie-pair-request-v2\0", kern)):
        raise RuntimeError(_("The pairing request is invalid."))
    partner = baum_partner_aufnehmen(
        zustand, str(zweig.get("name") or "")[:60], str(zweig["kennung"])[:32],
        zweig["oeffentlich"], adresse, zweig.get("port") or BAUM_PORT)
    partner.update({"bestaetigt": True, "wartet": False,
                    "protokoll": "baum-fs1", "paarungsart": "datei-v2",
                    "vertraut": True})
    antwort_kern = {"magnolie": "baum-paarung-2-antwort",
                    "paarung": anfrage["paarung"], "nonce": anfrage["nonce"],
                    "zweig": {"kennung": zustand.get("kennung") or "",
                               "name": zustand.get("name") or "",
                               "oeffentlich": zustand.get("oeffentlich") or "",
                               "port": int(zustand.get("port") or BAUM_PORT)}}
    antwort = dict(antwort_kern)
    antwort["beweis"] = _baum_b64url(_baum_hmac(
        geheimnis, b"magnolie-pair-response-v2\0", antwort_kern))
    zustand["paarungen"] = [e for e in zustand.get("paarungen", [])
                             if e.get("paarung") != anfrage["paarung"]]
    zustand.setdefault("paarungenVerbraucht", []).append({
        "paarung": anfrage["paarung"], "anfrageHash": anfrage_hash,
        "antwort": antwort, "behaltenBis": jetzt + 86400})
    zustand["paarungenVerbraucht"] = zustand["paarungenVerbraucht"][-100:]
    return antwort


def baum_paarungsantwort_pruefen(dokument, anfrage, antwort):
    import hmac
    dokument = baum_paarungsdatei_pruefen(dokument)
    geheimnis = _baum_b64url_lesen(dokument["geheimnis"], 32)
    if (not isinstance(antwort, dict)
            or set(antwort) != {"magnolie", "paarung", "nonce", "zweig", "beweis"}
            or antwort.get("magnolie") != "baum-paarung-2-antwort"
            or antwort.get("paarung") != dokument["paarung"]
            or antwort.get("nonce") != anfrage.get("nonce")
            or antwort.get("zweig") != dokument.get("einlader")):
        raise RuntimeError(_("The other branch did not prove the pairing file."))
    kern = dict(antwort)
    beweis = _baum_b64url_lesen(kern.pop("beweis"), 32)
    if not hmac.compare_digest(beweis, _baum_hmac(
            geheimnis, b"magnolie-pair-response-v2\0", kern)):
        raise RuntimeError(_("The other branch did not prove the pairing file."))
    return antwort


def _sitzungsschluessel(geheim_b64, partner_oeffentlich_b64, kennung_a,
                        kennung_b):
    """Beide Seiten kommen auf denselben Schlüssel."""
    from cryptography.hazmat.primitives.asymmetric.x25519 import (
        X25519PrivateKey, X25519PublicKey)
    from cryptography.hazmat.primitives.kdf.hkdf import HKDF
    from cryptography.hazmat.primitives import hashes
    import base64
    geheim = X25519PrivateKey.from_private_bytes(base64.b64decode(geheim_b64))
    fremd = X25519PublicKey.from_public_bytes(
        base64.b64decode(partner_oeffentlich_b64))
    gemeinsam = geheim.exchange(fremd)
    # Die Kennungen gehen der Größe nach geordnet ein – beide Seiten
    # errechnen so dasselbe.
    erst, dann = sorted([str(kennung_a), str(kennung_b)])
    return HKDF(algorithm=hashes.SHA256(), length=32, salt=None,
                info=BAUM_ZUSATZ + erst.encode() + b"|" + dann.encode()
                ).derive(gemeinsam)


def _fs_b64(roh):
    import base64
    return base64.b64encode(roh).decode("ascii")


def _fs_b64_lesen(text, laenge):
    import base64
    import binascii
    try:
        roh = base64.b64decode(str(text), validate=True)
    except (ValueError, binascii.Error):
        raise RuntimeError(_("The secure session is damaged."))
    if len(roh) != laenge:
        raise RuntimeError(_("The secure session is damaged."))
    return roh


def _fs_auth_schluessel(geheim_b64, partner, eigene_kennung):
    from cryptography.hazmat.primitives.kdf.hkdf import HKDF
    from cryptography.hazmat.primitives import hashes
    statisch = _sitzungsschluessel(
        geheim_b64, partner["oeffentlich"], eigene_kennung, partner["kennung"])
    return HKDF(algorithm=hashes.SHA256(), length=32, salt=None,
                info=BAUM_ZUSATZ + b"\0baum-fs1\0auth").derive(statisch)


def _fs_mac(schluessel, kennung, kern):
    import hashlib
    import hmac
    return hmac.new(schluessel, kennung + _baum_kanonisch(kern),
                    hashlib.sha256).digest()


def _fs_ephemer_oeffentlich(privat):
    from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat
    return privat.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)


def fs_start_bauen(zustand, partner, sid=None, privat=None):
    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey
    privat = privat or X25519PrivateKey.generate()
    kern = {"magnolie": "baum-fs1-start",
            "von": zustand.get("kennung") or "", "an": partner.get("kennung") or "",
            "sid": _fs_b64(os.urandom(16) if sid is None else sid),
            "epk": _fs_b64(_fs_ephemer_oeffentlich(privat))}
    auth = _fs_auth_schluessel(
        zustand["geheim"], partner, zustand["kennung"])
    start = dict(kern)
    start["mac"] = _fs_b64(_fs_mac(auth, b"start\0", kern))
    return start, privat


def _fs_start_pruefen(zustand, partner, start):
    import hmac
    if (not isinstance(start, dict)
            or set(start) != {"magnolie", "von", "an", "sid", "epk", "mac"}
            or start.get("magnolie") != "baum-fs1-start"
            or start.get("von") != partner.get("kennung")
            or start.get("an") != zustand.get("kennung")):
        raise RuntimeError(_("The secure session request is invalid."))
    _fs_b64_lesen(start["sid"], 16)
    _fs_b64_lesen(start["epk"], 32)
    kern = dict(start)
    mac = _fs_b64_lesen(kern.pop("mac"), 32)
    auth = _fs_auth_schluessel(
        zustand["geheim"], partner, zustand["kennung"])
    if not hmac.compare_digest(mac, _fs_mac(auth, b"start\0", kern)):
        raise RuntimeError(_("The secure session request is invalid."))
    return kern, auth


def _fs_schluessel(ephemer_geheim, fremd_oeffentlich, auth, start_kern,
                    antwort_kern):
    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PublicKey
    from cryptography.hazmat.primitives.kdf.hkdf import HKDF
    from cryptography.hazmat.primitives import hashes
    import hashlib
    gemeinsam = ephemer_geheim.exchange(X25519PublicKey.from_public_bytes(
        fremd_oeffentlich))
    transkript = hashlib.sha256(
        _baum_kanonisch(start_kern) + b"\0" +
        _baum_kanonisch(antwort_kern)).digest()
    salt = _fs_mac(auth, b"key\0", {"transkript": _fs_b64(transkript)})
    material = HKDF(
        algorithm=hashes.SHA256(), length=64, salt=salt,
        info=BAUM_ZUSATZ + b"\0baum-fs1\0keys\0" + transkript).derive(gemeinsam)
    return {"sid": start_kern["sid"], "transkript": transkript,
            "kenc": bytearray(material[:32]), "kack": bytearray(material[32:]),
            "verbraucht": False}


def fs_antwort_bauen(zustand, partner, start, privat=None):
    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey
    import hashlib
    start_kern, auth = _fs_start_pruefen(zustand, partner, start)
    privat = privat or X25519PrivateKey.generate()
    antwort_kern = {"magnolie": "baum-fs1-antwort",
                    "von": zustand["kennung"], "an": partner["kennung"],
                    "sid": start_kern["sid"],
                    "epk": _fs_b64(_fs_ephemer_oeffentlich(privat)),
                    "startHash": _fs_b64(hashlib.sha256(
                        _baum_kanonisch(start_kern)).digest())}
    antwort = dict(antwort_kern)
    antwort["mac"] = _fs_b64(_fs_mac(auth, b"answer\0", antwort_kern))
    sitzung = _fs_schluessel(
        privat, _fs_b64_lesen(start_kern["epk"], 32), auth,
        start_kern, antwort_kern)
    return antwort, sitzung


def fs_antwort_oeffnen(zustand, partner, start, antwort, privat):
    import hashlib
    import hmac
    start_kern = dict(start)
    start_kern.pop("mac", None)
    if (not isinstance(antwort, dict)
            or set(antwort) != {"magnolie", "von", "an", "sid", "epk",
                                "startHash", "mac"}
            or antwort.get("magnolie") != "baum-fs1-antwort"
            or antwort.get("von") != partner.get("kennung")
            or antwort.get("an") != zustand.get("kennung")
            or antwort.get("sid") != start.get("sid")
            or not hmac.compare_digest(
                _fs_b64_lesen(antwort.get("startHash"), 32),
                hashlib.sha256(_baum_kanonisch(start_kern)).digest())):
        raise RuntimeError(_("The secure session response is invalid."))
    antwort_kern = dict(antwort)
    mac = _fs_b64_lesen(antwort_kern.pop("mac"), 32)
    auth = _fs_auth_schluessel(
        zustand["geheim"], partner, zustand["kennung"])
    if not hmac.compare_digest(mac, _fs_mac(auth, b"answer\0", antwort_kern)):
        raise RuntimeError(_("The secure session response is invalid."))
    return _fs_schluessel(
        privat, _fs_b64_lesen(antwort_kern["epk"], 32), auth,
        start_kern, antwort_kern)


def umschlag_bauen_fs(sitzung, eigene_kennung, partner_kennung, inhalt,
                       transport_id, nonce=None):
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    nonce = os.urandom(12) if nonce is None else nonce
    kopf = {"magnolie": "baum-fs1", "von": eigene_kennung,
            "an": partner_kennung, "sid": sitzung["sid"],
            "mid": transport_id, "nonce": _fs_b64(nonce)}
    klar = _baum_kanonisch(inhalt)
    daten = AESGCM(bytes(sitzung["kenc"])).encrypt(
        nonce, klar, b"magnolienbaum\0baum-fs1\0data\0" + _baum_kanonisch(kopf))
    return dict(kopf, daten=_fs_b64(daten))


def umschlag_oeffnen_fs(sitzung, eigene_kennung, partner_kennung, umschlag):
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    if sitzung.get("verbraucht"):
        raise RuntimeError(_("The secure session has already been used."))
    sitzung["verbraucht"] = True
    if (not isinstance(umschlag, dict)
            or set(umschlag) != {"magnolie", "von", "an", "sid", "mid",
                                  "nonce", "daten"}
            or umschlag.get("magnolie") != "baum-fs1"
            or umschlag.get("von") != partner_kennung
            or umschlag.get("an") != eigene_kennung
            or umschlag.get("sid") != sitzung.get("sid")):
        raise RuntimeError(_("The secure message is invalid."))
    _fs_b64_lesen(umschlag.get("mid"), 16)
    kopf = dict(umschlag)
    kopf.pop("daten")
    # Geheimtext ist variabel lang; Base64 wird separat strikt geprüft.
    import base64
    import binascii
    try:
        daten = base64.b64decode(umschlag["daten"], validate=True)
    except (ValueError, binascii.Error):
        raise RuntimeError(_("The secure message is invalid."))
    if len(daten) < 16:
        raise RuntimeError(_("The secure message is invalid."))
    nonce = _fs_b64_lesen(kopf["nonce"], 12)
    try:
        klar = AESGCM(bytes(sitzung["kenc"])).decrypt(
            nonce, daten, b"magnolienbaum\0baum-fs1\0data\0" +
            _baum_kanonisch(kopf))
        inhalt = json.loads(klar.decode("utf-8"))
    except Exception:
        raise RuntimeError(_("The secure message could not be opened."))
    return inhalt, umschlag["mid"]


def fs_ack_bauen(sitzung, umschlag):
    import hashlib
    kern = {"magnolie": "baum-fs1-ack", "sid": sitzung["sid"],
            "mid": umschlag["mid"]}
    bindung = {"transkript": _fs_b64(sitzung["transkript"]),
               "umschlagHash": hashlib.sha256(_baum_kanonisch(umschlag)).hexdigest(),
               "ack": kern}
    return dict(kern, mac=_fs_b64(_fs_mac(
        bytes(sitzung["kack"]), b"ack\0", bindung)))


def fs_ack_pruefen(sitzung, umschlag, antwort):
    import hashlib
    import hmac
    if (not isinstance(antwort, dict)
            or set(antwort) != {"magnolie", "sid", "mid", "mac"}
            or antwort.get("magnolie") != "baum-fs1-ack"
            or antwort.get("sid") != sitzung.get("sid")
            or antwort.get("mid") != umschlag.get("mid")):
        return False
    kern = dict(antwort)
    mac = _fs_b64_lesen(kern.pop("mac"), 32)
    bindung = {"transkript": _fs_b64(sitzung["transkript"]),
               "umschlagHash": hashlib.sha256(_baum_kanonisch(umschlag)).hexdigest(),
               "ack": kern}
    return hmac.compare_digest(mac, _fs_mac(
        bytes(sitzung["kack"]), b"ack\0", bindung))


def fs_sitzung_loeschen(sitzung):
    for name in ("kenc", "kack"):
        wert = sitzung.get(name) if isinstance(sitzung, dict) else None
        if isinstance(wert, bytearray):
            wert[:] = b"\0" * len(wert)


def umschlag_bauen(geheim_b64, partner, eigene_kennung, inhalt, zaehler):
    """Verpackt eine Nachricht verschlüsselt und beglaubigt."""
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    import base64
    schluessel = _sitzungsschluessel(geheim_b64, partner["oeffentlich"],
                                     eigene_kennung, partner["kennung"])
    nonce = os.urandom(12)
    klartext = json.dumps(inhalt, ensure_ascii=False).encode("utf-8")
    kopf = json.dumps({"von": eigene_kennung, "zaehler": int(zaehler)},
                      sort_keys=True).encode("utf-8")
    geheim = AESGCM(schluessel).encrypt(nonce, klartext, kopf)
    return {
        "magnolie": BAUM_HÜLLE,
        "von": eigene_kennung,
        "zaehler": int(zaehler),
        "nonce": base64.b64encode(nonce).decode("ascii"),
        "daten": base64.b64encode(geheim).decode("ascii"),
    }


def umschlag_oeffnen(geheim_b64, partner, eigene_kennung, umschlag,
                     letzter_zaehler=0):
    """Öffnet einen Umschlag. Wirft RuntimeError, wenn etwas nicht stimmt.

    Ein bereits gesehener Zähler wird abgewiesen – so lässt sich eine
    aufgezeichnete Nachricht nicht noch einmal einspielen."""
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    import base64
    if not isinstance(umschlag, dict) or umschlag.get("magnolie") != BAUM_HÜLLE:
        raise RuntimeError(_("This is not a Magnolienbaum message."))
    if str(umschlag.get("von")) != str(partner.get("kennung")):
        raise RuntimeError(_("The message comes from another branch."))
    try:
        zaehler = int(umschlag.get("zaehler"))
    except (TypeError, ValueError):
        raise RuntimeError(_("The message is damaged."))
    if zaehler <= int(letzter_zaehler or 0):
        raise RuntimeError(_("This message has already been received."))
    schluessel = _sitzungsschluessel(geheim_b64, partner["oeffentlich"],
                                     eigene_kennung, partner["kennung"])
    kopf = json.dumps({"von": umschlag.get("von"), "zaehler": zaehler},
                      sort_keys=True).encode("utf-8")
    try:
        klar = AESGCM(schluessel).decrypt(
            base64.b64decode(umschlag["nonce"]),
            base64.b64decode(umschlag["daten"]), kopf)
    except Exception:
        raise RuntimeError(_("The message could not be opened."))
    try:
        inhalt = json.loads(klar.decode("utf-8"))
    except ValueError:
        raise RuntimeError(_("The content is unreadable."))
    return inhalt, zaehler


def baum_partner(zustand, kennung):
    for p in (zustand or {}).get("partner") or []:
        if p.get("kennung") == kennung:
            return p
    return None


def baum_partner_aufnehmen(zustand, name, kennung, oeffentlich, adresse="",
                           port=BAUM_PORT):
    """Trägt eine Gegenstelle ein – zunächst unbestätigt."""
    if not baum_oeffentlicher_schluessel_gueltig(oeffentlich):
        raise RuntimeError(_("The public key is invalid."))
    vorhanden = baum_partner(zustand, kennung)
    if vorhanden:
        if (vorhanden.get("bestaetigt") and vorhanden.get("oeffentlich") and
                vorhanden.get("oeffentlich") != oeffentlich):
            raise RuntimeError(_(
                "The key of this branch has changed. Remove the old connection first "
                "and compare the new fingerprint particularly carefully."))
        vorhanden["name"] = name or vorhanden.get("name") or ""
        vorhanden["oeffentlich"] = oeffentlich
        if adresse:
            vorhanden["adresse"] = adresse
            vorhanden["port"] = int(port or BAUM_PORT)
        return vorhanden
    partner = zustand.get("partner") or []
    if len(partner) >= BAUM_PARTNER_MAX:
        raise RuntimeError(_("The maximum number of branches has been reached."))
    if sum(not p.get("bestaetigt") for p in partner) >= BAUM_UNBESTAETIGT_MAX:
        raise RuntimeError(_("Too many pairing requests are awaiting confirmation."))
    neu = {
        "kennung": kennung,
        "name": name or kennung,
        "oeffentlich": oeffentlich,
        "adresse": adresse,
        "port": int(port or BAUM_PORT),
        "bestaetigt": False,
        "vertraut": False,
        "kontakte": False,
        "kontaktLoeschen": False,
        "fernAdresse": "",
        "fernPort": BAUM_PORT,
        "zaehler_raus": 0,
        "zaehler_rein": 0,
        "zuletzt": "",
    }
    zustand.setdefault("partner", []).append(neu)
    return neu


def baum_partner_einstellungen(partner, vertraut, fern_adresse="",
                                fern_port=BAUM_PORT, kontakte=False,
                                kontakt_loeschen=False):
    """Validiert und setzt die vom Menschen gepflegten Partnereinstellungen."""
    if not isinstance(vertraut, bool):
        raise RuntimeError(_("The trust setting is invalid."))
    if not isinstance(kontakte, bool):
        raise RuntimeError(_("The contact synchronization setting is invalid."))
    if not isinstance(kontakt_loeschen, bool):
        raise RuntimeError(_("The contact synchronization setting is invalid."))
    adresse = str(fern_adresse or "").strip()
    if adresse:
        adresse = baum_host_normieren(adresse)
        port = baum_port_pruefen(fern_port)
    else:
        if str(fern_port or "").strip() not in ("", str(BAUM_PORT)):
            raise RuntimeError(_("Enter a remote address before setting its port."))
        port = BAUM_PORT
    partner["vertraut"] = vertraut
    partner["kontakte"] = kontakte
    partner["kontaktLoeschen"] = kontakt_loeschen
    partner["fernAdresse"] = adresse
    partner["fernPort"] = port
    return partner


def baum_partner_endpunkte(partner):
    """Liefert beobachtetes und konfiguriertes Direktziel ohne Duplikate."""
    endpunkte = []
    for adresse, port in ((partner.get("adresse"), partner.get("port")),
                          (partner.get("fernAdresse"), partner.get("fernPort"))):
        if not adresse:
            continue
        try:
            punkt = (baum_host_normieren(adresse),
                     baum_port_pruefen(port or BAUM_PORT))
        except RuntimeError:
            continue
        if punkt not in endpunkte:
            endpunkte.append(punkt)
    return endpunkte


def _baum_liste_lesen(pfad, speicherart, kennwort=""):
    try:
        with open(pfad, "r", encoding="utf-8") as datei:
            text = datei.read()
    except FileNotFoundError:
        return []
    if ist_verschluesselt(text):
        if not kennwort:
            raise RuntimeError(_("The Magnolienbaum storage is encrypted. Unlock the organizer first."))
        text = entschluesseln(text, kennwort)
        try:
            huelle = json.loads(text)
        except ValueError:
            raise RuntimeError(_("The encrypted Magnolienbaum storage is damaged."))
        if (not isinstance(huelle, dict) or huelle.get("speicher") != speicherart
                or not isinstance(huelle.get("wert"), list)):
            raise RuntimeError(_("The encrypted Magnolienbaum storage is damaged."))
        roh = huelle["wert"]
    else:
        try:
            roh = json.loads(text)
        except ValueError:
            raise RuntimeError(_("The Magnolienbaum storage is damaged."))
    if not isinstance(roh, list):
        raise RuntimeError(_("The Magnolienbaum storage is damaged."))
    return [x for x in roh if isinstance(x, dict)]


def _baum_liste_schreiben(liste, pfad, speicherart, kennwort=""):
    text = json.dumps(liste, ensure_ascii=False, indent=1)
    if kennwort:
        text = verschluesseln(json.dumps(
            {"speicher": speicherart, "wert": liste},
            ensure_ascii=False, separators=(",", ":")), kennwort)
    atomar_text_schreiben(pfad, text)


def baum_post_lesen(pfad=None, kennwort=""):
    return _baum_liste_lesen(pfad or baum_postdatei(), "baum-post-v1", kennwort)


def baum_post_schreiben(post, pfad=None, kennwort=""):
    pfad = pfad or baum_postdatei()
    try:
        _baum_liste_schreiben(post, pfad, "baum-post-v1", kennwort)
        return True
    except (OSError, RuntimeError, TypeError, ValueError):
        return False


def baum_einreihen(post, an, art, inhalt, jetzt=None):
    """Legt eine Sendung in die Warteschlange."""
    baum_kontakt_nutzlast_pruefen(art, inhalt)
    jetzt = jetzt or datetime.now()
    post.append({
        "id": _zufallskennung(12),
        "transportId": _fs_b64(os.urandom(16)),
        "an": an,
        "art": art,
        "inhalt": inhalt,
        "versuche": 0,
        "zuletzt": "",
        "angelegt": jetzt.strftime("%Y-%m-%d %H:%M:%S"),
    })
    return post[-1]


# Nach wie vielen Minuten der nächste Versuch ansteht
BAUM_ABSTAENDE = [1, 2, 5, 10, 30, 60]
BAUM_AUFGEBEN_TAGE = 7


def baum_faellig(sendung, jetzt=None):
    """Ist diese Sendung jetzt an der Reihe?"""
    jetzt = jetzt or datetime.now()
    from datetime import timedelta
    versuche = int(sendung.get("versuche") or 0)
    if versuche == 0:
        return True
    letzter = sendung.get("zuletzt") or ""
    try:
        wann = datetime.strptime(letzter[:19], "%Y-%m-%d %H:%M:%S")
    except (TypeError, ValueError):
        return True
    minuten = BAUM_ABSTAENDE[min(versuche - 1, len(BAUM_ABSTAENDE) - 1)]
    return jetzt >= wann + timedelta(minutes=minuten)


def baum_zu_alt(sendung, jetzt=None):
    """Liegt die Sendung schon zu lange unzustellbar herum?"""
    from datetime import timedelta
    jetzt = jetzt or datetime.now()
    try:
        angelegt = datetime.strptime(
            (sendung.get("angelegt") or "")[:19], "%Y-%m-%d %H:%M:%S")
    except (TypeError, ValueError):
        return False
    return jetzt > angelegt + timedelta(days=BAUM_AUFGEBEN_TAGE)


def baum_fehlversuch(sendung, jetzt=None):
    jetzt = jetzt or datetime.now()
    sendung["versuche"] = int(sendung.get("versuche") or 0) + 1
    sendung["zuletzt"] = jetzt.strftime("%Y-%m-%d %H:%M:%S")
    return sendung


# ------------------------------ Wem gehört eine Aufgabe? -------------------

def aufgabe_zusammenfuehren(hier, dort):
    """Welche Fassung einer Aufgabe gilt?

    1. Die neuere Änderung gewinnt.
    2. Sind beide gleich alt, entscheidet die Herkunft – wer die Aufgabe
       erschaffen hat, hat das letzte Wort."""
    if not hier:
        return dict(dort or {})
    if not dort:
        return dict(hier)
    h = int(hier.get("geaendert") or 0)
    d = int(dort.get("geaendert") or 0)
    if d > h:
        return dict(dort)
    if h > d:
        return dict(hier)
    # Gleichstand: die Herkunft entscheidet
    herkunft = hier.get("herkunft") or dort.get("herkunft") or ""
    if dort.get("quelle") == herkunft and hier.get("quelle") != herkunft:
        return dict(dort)
    return dict(hier)


def darf_loeschen(aufgabe, kennung):
    """Löschen darf nur, wer die Aufgabe erschaffen hat."""
    herkunft = (aufgabe or {}).get("herkunft") or ""
    return not herkunft or herkunft == kennung


# ---------------------------------------------------------------------------
# Magnolienbaum: der Netzdienst
# ---------------------------------------------------------------------------

def baum_antwort_paarung(zustand, anfrage, adresse=""):
    """Beantwortet die Anfrage einer fremden Instanz.

    Die Gegenstelle wird eingetragen, gilt aber erst als bestätigt, wenn
    der Mensch am Rechner den Code abgenickt hat."""
    name = str(anfrage.get("name") or "")[:60]
    kennung = str(anfrage.get("kennung") or "")[:32]
    oeffentlich = str(anfrage.get("oeffentlich") or "")
    if not kennung or not oeffentlich:
        raise RuntimeError(_("The pairing request is incomplete."))
    partner = baum_partner_aufnehmen(zustand, name, kennung, oeffentlich,
                                     adresse, anfrage.get("port") or BAUM_PORT)
    partner["wartet"] = True
    return {
        "name": zustand.get("name") or "",
        "kennung": zustand.get("kennung") or "",
        "oeffentlich": zustand.get("oeffentlich") or "",
        "port": int(zustand.get("port") or BAUM_PORT),
        "code": paarungs_code(zustand.get("oeffentlich"), oeffentlich),
    }


def baum_nachricht_annehmen(zustand, umschlag, verarbeiten=None):
    """Nimmt eine verschlüsselte Nachricht entgegen und reicht den Inhalt
    weiter. Unbestätigte Partner werden abgewiesen."""
    von = str((umschlag or {}).get("von") or "")
    partner = baum_partner(zustand, von)
    if not partner:
        raise RuntimeError(_("This branch is not known."))
    if not partner.get("bestaetigt"):
        raise RuntimeError(_("This branch has not yet been confirmed."))
    inhalt, zaehler = umschlag_oeffnen(
        zustand.get("geheim"), partner, zustand.get("kennung"), umschlag,
        partner.get("zaehler_rein") or 0)
    baum_kontakt_nutzlast_pruefen((inhalt or {}).get("art"), inhalt)
    partner["zaehler_rein"] = zaehler
    partner["zuletzt"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    if verarbeiten:
        verarbeiten(partner, inhalt)
    return inhalt


def _baum_http_json_senden(adresse, inhalt, zeitgrenze=6):
    import urllib.request
    daten = json.dumps(inhalt).encode("utf-8")
    anfrage = urllib.request.Request(
        adresse, data=daten, headers={"Content-Type": "application/json"})
    with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(
            anfrage, timeout=zeitgrenze) as antwort:
        roh = antwort.read(BAUM_HTTP_PAARUNG_MAX + 1)
        if len(roh) > BAUM_HTTP_PAARUNG_MAX:
            raise RuntimeError(_("The response is too large."))
        return json.loads(roh.decode("utf-8"))


def baum_senden_fs(zustand, partner, art, inhalt, transport_id,
                    sender=None, zeitgrenze=6):
    sende = sender or (lambda adresse, nutzlast: _baum_http_json_senden(
        adresse, nutzlast, zeitgrenze))
    for host, port in baum_partner_endpunkte(partner):
        start, privat = fs_start_bauen(zustand, partner)
        basis = baum_url(host, port)
        sitzung = None
        try:
            antwort = sende(basis + "/magnolie/v2/sitzung", start)
            if not isinstance(antwort, dict):
                continue
            sitzung = fs_antwort_oeffnen(zustand, partner, start, antwort, privat)
            try:
                _fs_b64_lesen(transport_id, 16)
            except RuntimeError:
                transport_id = _fs_b64(os.urandom(16))
            umschlag = umschlag_bauen_fs(
                sitzung, zustand["kennung"], partner["kennung"],
                dict(inhalt or {}, art=art), transport_id)
            quittung = sende(basis + "/magnolie/v2/nachricht", umschlag)
            if fs_ack_pruefen(sitzung, umschlag, quittung):
                partner["zuletzt"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                return True
        except Exception:
            pass
        finally:
            if sitzung:
                fs_sitzung_loeschen(sitzung)
            privat = None
    return False


def baum_briefkasten_zustellen(mailbox, transport_id, eigene_kennung,
                                partner_kennung, umschlag, schluessel):
    """Windows-kompatibler Store-and-forward-Schritt; Erfolg erst nach ACK."""
    roh_id = _fs_b64_lesen(transport_id, 16)
    if mailbox.receipt_exists(roh_id, partner_kennung, eigene_kennung, schluessel):
        try:
            mailbox.delete("nachrichten", partner_kennung, roh_id)
        except Exception:
            pass
        try:
            mailbox.delete("quittungen", eigene_kennung, roh_id)
        except Exception:
            pass
        return True
    mailbox.ensure(partner_kennung)
    mailbox.upload(roh_id, eigene_kennung, partner_kennung, umschlag, schluessel)
    return False


def baum_senden(zustand, partner, art, inhalt, sender=None, zeitgrenze=6,
                  transport_id="", mailbox=None, gespeicherter_umschlag=None):
    """Stellt eine Nachricht zu. Liefert True bei Erfolg."""
    import urllib.error
    import urllib.request
    baum_kontakt_nutzlast_pruefen(art, inhalt)
    if not partner.get("bestaetigt"):
        return False
    if partner.get("protokoll") == "baum-fs1":
        return baum_senden_fs(zustand, partner, art, inhalt, transport_id,
                              sender, zeitgrenze)
    if gespeicherter_umschlag is None:
        partner["zaehler_raus"] = int(partner.get("zaehler_raus") or 0) + 1
        umschlag = umschlag_bauen(zustand.get("geheim"), partner,
                                  zustand.get("kennung"),
                                  dict(inhalt or {}, art=art),
                                  partner["zaehler_raus"])
    else:
        umschlag = gespeicherter_umschlag
    fallback_erlaubt = True
    for host, port in baum_partner_endpunkte(partner):
        adresse = baum_url(host, port, "/magnolie/v1/nachricht")
        try:
            if sender is not None:
                if sender(adresse, umschlag):
                    return True
                continue
            daten = json.dumps(umschlag).encode("utf-8")
            anfrage = urllib.request.Request(
                adresse, data=daten,
                headers={"Content-Type": "application/json"})
            with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(
                    anfrage, timeout=zeitgrenze) as antwort:
                if antwort.status in (200, 204):
                    return True
                fallback_erlaubt = False
        except urllib.error.HTTPError:
            fallback_erlaubt = False
        except Exception:
            pass
    if mailbox is not None and fallback_erlaubt:
        schluessel = _sitzungsschluessel(
            zustand.get("geheim"), partner["oeffentlich"],
            zustand.get("kennung"), partner["kennung"])
        return baum_briefkasten_zustellen(
            mailbox, transport_id, zustand["kennung"], partner["kennung"],
            umschlag, schluessel)
    return False


def baum_post_zustellen(zustand, post, jetzt=None, sender=None, hoechstens=0,
                        mailbox=None):
    """Arbeitet die Warteschlange ab. Liefert einen kurzen Bericht."""
    jetzt = jetzt or datetime.now()
    zugestellt, offen, aufgegeben, versucht = 0, 0, 0, 0
    bleibt = []
    partner_in_diesem_lauf = set()
    for sendung in post:
        empfaenger = sendung.get("an")
        if baum_zu_alt(sendung, jetzt):
            aufgegeben += 1
            sendung["aufgegeben"] = True
            bleibt.append(sendung)
            continue
        if not baum_faellig(sendung, jetzt):
            partner_in_diesem_lauf.add(empfaenger)
            offen += 1
            bleibt.append(sendung)
            continue
        partner = baum_partner(zustand, sendung.get("an"))
        if not partner:
            aufgegeben += 1
            sendung["aufgegeben"] = True
            bleibt.append(sendung)
            continue
        if empfaenger in partner_in_diesem_lauf:
            offen += 1
            bleibt.append(sendung)
            continue
        if hoechstens and versucht >= hoechstens:
            offen += 1
            bleibt.append(sendung)
            continue
        partner_in_diesem_lauf.add(empfaenger)
        versucht += 1
        if not sendung.get("transportId"):
            sendung["transportId"] = _fs_b64(os.urandom(16))
        if mailbox is not None and partner.get("protokoll", "baum-1") != "baum-fs1" \
                and not isinstance(sendung.get("briefUmschlag"), dict):
            partner["zaehler_raus"] = int(partner.get("zaehler_raus") or 0) + 1
            sendung["briefZaehler"] = partner["zaehler_raus"]
            sendung["briefUmschlag"] = umschlag_bauen(
                zustand.get("geheim"), partner, zustand.get("kennung"),
                dict(sendung.get("inhalt") or {}, art=sendung.get("art") or "aufgabe"),
                partner["zaehler_raus"])
        if baum_senden(zustand, partner, sendung.get("art") or "aufgabe",
                       sendung.get("inhalt") or {}, sender,
                       transport_id=sendung["transportId"], mailbox=mailbox,
                       gespeicherter_umschlag=sendung.get("briefUmschlag")):
            zugestellt += 1
            continue
        baum_fehlversuch(sendung, jetzt)
        offen += 1
        bleibt.append(sendung)
    post[:] = bleibt
    return {"zugestellt": zugestellt, "offen": offen,
            "aufgegeben": aufgegeben, "versucht": versucht}


def baum_post_wartung(zustand, pfad=None, kennwort="", jetzt=None,
                       sender=None, hoechstens=1, mailbox=None):
    """Lädt, verarbeitet und persistiert einen begrenzten Warteschlangenschritt."""
    leer = {"ausgefuehrt": False, "grund": "aus", "zugestellt": 0,
            "offen": 0, "aufgegeben": 0, "versucht": 0,
            "geaendert": False}
    if not zustand or not zustand.get("an"):
        return leer
    post = baum_post_lesen(pfad, kennwort)
    if mailbox is not None:
        ausgewaehlt, neu_reserviert, empfaenger = 0, 0, set()
        for sendung in post:
            kennung = sendung.get("an")
            if kennung in empfaenger:
                continue
            if baum_zu_alt(sendung, jetzt):
                continue
            if not baum_faellig(sendung, jetzt):
                empfaenger.add(kennung)
                continue
            partner = baum_partner(zustand, sendung.get("an"))
            if not partner or partner.get("protokoll", "baum-1") == "baum-fs1":
                continue
            empfaenger.add(kennung)
            if hoechstens and ausgewaehlt >= hoechstens:
                continue
            ausgewaehlt += 1
            if not isinstance(sendung.get("briefUmschlag"), dict):
                partner["zaehler_raus"] = int(partner.get("zaehler_raus") or 0) + 1
                sendung["briefZaehler"] = partner["zaehler_raus"]
                sendung["briefUmschlag"] = umschlag_bauen(
                    zustand.get("geheim"), partner, zustand.get("kennung"),
                    dict(sendung.get("inhalt") or {}, art=sendung.get("art") or "aufgabe"),
                    partner["zaehler_raus"])
                neu_reserviert += 1
        if neu_reserviert and not baum_post_schreiben(post, pfad, kennwort):
            raise RuntimeError(_("The Magnolienbaum outbox could not be saved."))
    vorher = json.dumps(post, ensure_ascii=False, sort_keys=True)
    bericht = baum_post_zustellen(
        zustand, post, jetzt, sender, hoechstens=hoechstens, mailbox=mailbox)
    geaendert = json.dumps(post, ensure_ascii=False, sort_keys=True) != vorher
    if geaendert and not baum_post_schreiben(post, pfad, kennwort):
        raise RuntimeError(_("The Magnolienbaum outbox could not be saved."))
    bericht.update({"ausgefuehrt": True, "grund": "", "geaendert": geaendert})
    return bericht


class BaumBluetoothDienst(object):
    """Stellt die Baumpfade als authentifiziertes BlueZ-RFCOMM-Profil bereit."""

    OBJEKTPFAD = "/io/gitlab/maik3531/MagnolieOrganizer/BaumProfil"
    SCHNITTSTELLE = "org.bluez.Profile1"
    XML = """<node>
      <interface name="org.bluez.Profile1">
        <method name="Release"/>
        <method name="NewConnection">
          <arg name="device" type="o" direction="in"/>
          <arg name="fd" type="h" direction="in"/>
          <arg name="fd_properties" type="a{sv}" direction="in"/>
        </method>
        <method name="RequestDisconnection">
          <arg name="device" type="o" direction="in"/>
        </method>
      </interface>
    </node>"""

    def __init__(self, baumdienst):
        self.baumdienst = baumdienst
        self._bus = None
        self._registrierung = 0
        self._profil_registriert = False
        self._verbindungen = {}
        import threading
        self._sperre = threading.Lock()
        self._plaetze = threading.BoundedSemaphore(4)

    def starten(self):
        if Gio is None or GLib is None:
            return False
        try:
            self._bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            knoten = Gio.DBusNodeInfo.new_for_xml(self.XML)
            self._registrierung = self._bus.register_object(
                self.OBJEKTPFAD, knoten.interfaces[0], self._methodenaufruf,
                None, None)
            optionen = {
                "Name": GLib.Variant("s", "Magnolienbaum"),
                "Service": GLib.Variant("s", BAUM_BLUETOOTH_UUID),
                "Role": GLib.Variant("s", "server"),
                "RequireAuthentication": GLib.Variant("b", True),
                "RequireAuthorization": GLib.Variant("b", False),
            }
            self._bus.call_sync(
                "org.bluez", "/org/bluez", "org.bluez.ProfileManager1",
                "RegisterProfile", GLib.Variant(
                    "(osa{sv})", (self.OBJEKTPFAD, BAUM_BLUETOOTH_UUID,
                                   optionen)),
                None, Gio.DBusCallFlags.NONE, 5000, None)
            self._profil_registriert = True
            return True
        except Exception:
            if self._bus and self._registrierung:
                try:
                    self._bus.unregister_object(self._registrierung)
                except Exception:
                    pass
            self._registrierung = 0
            self._bus = None
            return False

    def _methodenaufruf(self, _verbindung, _absender, _objektpfad,
                        _schnittstelle, methode, parameter, aufruf):
        if methode == "Release":
            self._profil_registriert = False
            aufruf.return_value(None)
            return
        if methode == "RequestDisconnection":
            geraet = parameter.unpack()[0]
            self._geraet_schliessen(geraet)
            aufruf.return_value(None)
            return
        if methode != "NewConnection":
            aufruf.return_dbus_error(
                "org.bluez.Error.NotSupported", "Unsupported method")
            return
        geraet, fd_index, _eigenschaften = parameter.unpack()
        try:
            fd_liste = aufruf.get_message().get_unix_fd_list()
            fd = os.dup(fd_liste.get(fd_index))
        except Exception:
            aufruf.return_dbus_error(
                "org.bluez.Error.Rejected", "Invalid RFCOMM descriptor")
            return
        if not self._plaetze.acquire(False):
            os.close(fd)
            aufruf.return_dbus_error(
                "org.bluez.Error.Rejected", "Too many connections")
            return
        import socket
        import threading
        buchse = socket.socket(fileno=fd)
        buchse.settimeout(BAUM_HTTP_GESAMT_SEKUNDEN)
        with self._sperre:
            self._verbindungen.setdefault(geraet, set()).add(buchse)
        aufruf.return_value(None)
        threading.Thread(
            target=self._bedienen, args=(geraet, buchse), daemon=True).start()

    @staticmethod
    def _vollstaendig_lesen(buchse, laenge):
        teile = []
        offen = laenge
        while offen:
            teil = buchse.recv(offen)
            if not teil:
                raise ValueError("unvollständiger Bluetooth-Rahmen")
            teile.append(teil)
            offen -= len(teil)
        return b"".join(teile)

    @staticmethod
    def _quelladresse(geraet):
        kennung = str(geraet or "").rsplit("/dev_", 1)[-1]
        if re.fullmatch(r"[0-9A-Fa-f]{2}(?:_[0-9A-Fa-f]{2}){5}", kennung):
            return kennung.replace("_", ":").lower()
        return str(geraet or "").lower()

    def _bedienen(self, geraet, buchse):
        import struct
        try:
            kopf = self._vollstaendig_lesen(buchse, 4)
            laenge = struct.unpack(">I", kopf)[0]
            if not 0 < laenge <= BAUM_BLUETOOTH_RAHMEN_MAX:
                raise ValueError("ungültige Bluetooth-Rahmenlänge")
            rahmen = json.loads(
                self._vollstaendig_lesen(buchse, laenge).decode("utf-8"))
            if (not isinstance(rahmen, dict)
                    or not isinstance(rahmen.get("pfad"), str)
                    or not isinstance(rahmen.get("nutzlast"), dict)):
                raise ValueError("unvollständiger Bluetooth-Rahmen")
            _nummer, antwort = self.baumdienst.behandeln(
                rahmen["pfad"], rahmen["nutzlast"],
                self._quelladresse(geraet))
            roh = json.dumps(antwort, ensure_ascii=False).encode("utf-8")
            if len(roh) > BAUM_BLUETOOTH_RAHMEN_MAX:
                raise ValueError("zu großer Bluetooth-Antwortrahmen")
            buchse.sendall(struct.pack(">I", len(roh)) + roh)
        except Exception:
            pass
        finally:
            with self._sperre:
                offen = self._verbindungen.get(geraet)
                if offen:
                    offen.discard(buchse)
                    if not offen:
                        self._verbindungen.pop(geraet, None)
            try:
                buchse.close()
            except OSError:
                pass
            self._plaetze.release()

    def _geraet_schliessen(self, geraet):
        with self._sperre:
            buchsen = list(self._verbindungen.get(geraet, ()))
        for buchse in buchsen:
            try:
                buchse.close()
            except OSError:
                pass

    def anhalten(self):
        with self._sperre:
            geraete = list(self._verbindungen)
        for geraet in geraete:
            self._geraet_schliessen(geraet)
        if self._bus and self._profil_registriert:
            try:
                self._bus.call_sync(
                    "org.bluez", "/org/bluez", "org.bluez.ProfileManager1",
                    "UnregisterProfile", GLib.Variant("(o)", (self.OBJEKTPFAD,)),
                    None, Gio.DBusCallFlags.NONE, 5000, None)
            except Exception:
                pass
        if self._bus and self._registrierung:
            try:
                self._bus.unregister_object(self._registrierung)
            except Exception:
                pass
        self._profil_registriert = False
        self._registrierung = 0
        self._bus = None


class BaumDienst(object):
    """Nimmt Anfragen anderer Instanzen entgegen.

    Ein winziger Webdienst auf Port 8737, der nur zwei Wege kennt: die
    Paarung und die verschlüsselte Nachricht."""

    def __init__(self, hole_zustand, sichere_zustand, bei_nachricht=None,
                 bei_paarung=None, port=BAUM_PORT, sperre=None,
                 http_zeitgrenze=BAUM_HTTP_GESAMT_SEKUNDEN,
                 http_pro_adresse=BAUM_HTTP_PRO_ADRESSE_MAX):
        self.hole_zustand = hole_zustand
        self.sichere_zustand = sichere_zustand
        self.bei_nachricht = bei_nachricht
        self.bei_paarung = bei_paarung
        self.port = BAUM_PORT if port is None else int(port)
        self.http_zeitgrenze = max(0.1, float(http_zeitgrenze))
        self.http_pro_adresse = max(1, int(http_pro_adresse))
        self._server = None
        self._server6 = None
        self._faden = None
        self._faden6 = None
        self._mdns = None
        self._bluetooth = None
        import threading
        self._sperre = sperre or threading.RLock()
        self._anfragen_sperre = threading.Lock()
        self._anfragen = {}
        self._fs_sitzungen = {}

    def _anfrage_erlaubt(self, adresse, paarung=False):
        import time
        adresse = baum_quelladresse_normieren(adresse)
        jetzt = time.monotonic()
        grenze = 8 if paarung else 120
        fenster = 60.0
        with self._anfragen_sperre:
            zeiten = [z for z in self._anfragen.get(adresse, [])
                      if jetzt - z < fenster]
            if len(zeiten) >= grenze:
                self._anfragen[adresse] = zeiten
                return False
            zeiten.append(jetzt)
            self._anfragen[adresse] = zeiten
            if len(self._anfragen) > 1000:
                self._anfragen = {a: z for a, z in self._anfragen.items()
                                  if z and jetzt - z[-1] < fenster}
            return True

    def behandeln(self, pfad, nachricht, quelle, bereits_begrenzt=False):
        """Behandelt einen Baumpfad unabhängig vom verwendeten Transport."""
        paarung = pfad in ("/magnolie/v1/paarung", "/magnolie/v2/paarung")
        if not bereits_begrenzt and not self._anfrage_erlaubt(quelle, paarung):
            return 429, {"fehler": _("Too many requests.")}
        try:
            with self._sperre:
                zustand = self.hole_zustand()
                if not zustand or not zustand.get("an"):
                    return 503, {"fehler": _(
                        "The Magnolienbaum is switched off.")}
                if pfad == "/magnolie/v1/paarung":
                    antwort = baum_antwort_paarung(zustand, nachricht, quelle)
                    self.sichere_zustand(zustand)
                elif pfad == "/magnolie/v1/nachricht":
                    inhalt = baum_nachricht_annehmen(
                        zustand, nachricht, self.bei_nachricht)
                    self.sichere_zustand(zustand)
                    return 200, {"ok": True, "art": inhalt.get("art")}
                elif pfad == "/magnolie/v2/paarung":
                    antwort = baum_paarungsanfrage_annehmen(
                        zustand, nachricht, quelle)
                    self.sichere_zustand(zustand)
                elif pfad == "/magnolie/v2/sitzung":
                    import time as _zeit
                    partner = baum_partner(
                        zustand, str(nachricht.get("von") or ""))
                    if not partner or not partner.get("bestaetigt"):
                        raise RuntimeError(_("This branch has not been confirmed."))
                    jetzt_mono = _zeit.monotonic()
                    for sid, alt in list(self._fs_sitzungen.items()):
                        if alt["ablauf"] <= jetzt_mono:
                            fs_sitzung_loeschen(alt["sitzung"])
                            self._fs_sitzungen.pop(sid, None)
                    if len(self._fs_sitzungen) >= BAUM_FS_SITZUNGEN_MAX:
                        raise RuntimeError(_("Too many secure sessions are open."))
                    antwort, sitzung = fs_antwort_bauen(
                        zustand, partner, nachricht)
                    if sitzung["sid"] in self._fs_sitzungen:
                        fs_sitzung_loeschen(sitzung)
                        raise RuntimeError(_("This secure session already exists."))
                    self._fs_sitzungen[sitzung["sid"]] = {
                        "sitzung": sitzung, "partner": partner["kennung"],
                        "adresse": baum_quelladresse_normieren(quelle),
                        "ablauf": jetzt_mono + BAUM_FS_SITZUNG_SEKUNDEN}
                    return 200, antwort
                elif pfad == "/magnolie/v2/nachricht":
                    import time as _zeit
                    sitzungs_id = str(nachricht.get("sid") or "")
                    offen = self._fs_sitzungen.pop(sitzungs_id, None)
                    if (not offen or offen["ablauf"] <= _zeit.monotonic()
                            or offen["adresse"] != baum_quelladresse_normieren(quelle)):
                        raise RuntimeError(_(
                            "The secure session is unknown or expired."))
                    sitzung = offen["sitzung"]
                    try:
                        partner = baum_partner(zustand, offen["partner"])
                        if not partner or not partner.get("bestaetigt"):
                            raise RuntimeError(_(
                                "This branch has not been confirmed."))
                        inhalt, transport_id = umschlag_oeffnen_fs(
                            sitzung, zustand["kennung"], partner["kennung"],
                            nachricht)
                        baum_kontakt_nutzlast_pruefen((inhalt or {}).get("art"), inhalt)
                        gesehen = partner.setdefault("transportIds", [])
                        if transport_id not in gesehen:
                            if self.bei_nachricht:
                                self.bei_nachricht(partner, inhalt)
                            gesehen.append(transport_id)
                            partner["transportIds"] = gesehen[-256:]
                        partner["protokoll"] = "baum-fs1"
                        partner["zuletzt"] = datetime.now().strftime(
                            "%Y-%m-%d %H:%M:%S")
                        self.sichere_zustand(zustand)
                        return 200, fs_ack_bauen(sitzung, nachricht)
                    finally:
                        fs_sitzung_loeschen(sitzung)
                else:
                    return 404, {"fehler": _("Unknown endpoint.")}
            if self.bei_paarung:
                self.bei_paarung(nachricht, antwort)
            return 200, antwort
        except RuntimeError as fehler:
            return 403, {"fehler": str(fehler)}
        except Exception:
            return 500, {"fehler": _("Unexpected error.")}

    def starten(self):
        import http.server
        import socketserver
        import threading
        if self._server or self._server6:
            return True
        dienst = self

        class Behandler(http.server.BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.1"

            def setup(self):
                super().setup()
                self.connection.settimeout(BAUM_HTTP_INAKTIV_SEKUNDEN)

            def handle(self):
                self.close_connection = True
                self.handle_one_request()
                self.close_connection = True

            def log_message(self, *_egal):
                pass                      # kein Geplapper auf der Konsole

            def handle_expect_100(self):
                self.close_connection = True
                self._antwort(417, {"fehler": _("The request is unreadable.")})
                return False

            def _antwort(self, nummer, inhalt):
                self.close_connection = True
                roh = json.dumps(inhalt, ensure_ascii=False).encode("utf-8")
                self.send_response(nummer)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(roh)))
                self.send_header("Connection", "close")
                self.end_headers()
                self.wfile.write(roh)

            def do_POST(self):
                self.close_connection = True
                if not dienst._anfrage_erlaubt(
                        self.client_address[0], self.path in (
                            "/magnolie/v1/paarung", "/magnolie/v2/paarung")):
                    self._antwort(429, {"fehler": _("Too many requests.")})
                    return
                try:
                    if self.headers.get("Transfer-Encoding") is not None:
                        self._antwort(400, {"fehler": _("The request is unreadable.")})
                        return
                    if self.headers.get("Expect") is not None:
                        self._antwort(417, {"fehler": _("The request is unreadable.")})
                        return
                    angaben = self.headers.get_all("Content-Length") or []
                    if not angaben:
                        self._antwort(411, {"fehler": _("Content length is missing.")})
                        return
                    if (len(angaben) != 1 or
                            not re.fullmatch(r"(?:0|[1-9][0-9]*)", angaben[0])):
                        raise ValueError("ungültige Länge")
                    laenge = int(angaben[0])
                    grenze = (BAUM_HTTP_NACHRICHT_MAX
                              if self.path in ("/magnolie/v1/nachricht",
                                               "/magnolie/v2/nachricht")
                              else BAUM_HTTP_PAARUNG_MAX)
                    if laenge > grenze:
                        self.close_connection = True
                        self._antwort(413, {"fehler": _("The message is too large.")})
                        return
                    roh = self.rfile.read(laenge)
                    if len(roh) != laenge:
                        raise ValueError("unvollständig")
                    nachricht = json.loads(roh.decode("utf-8"))
                except Exception:
                    try:
                        self._antwort(400, {"fehler": _("The request is unreadable.")})
                    except OSError:
                        pass
                    return
                nummer, antwort = dienst.behandeln(
                    self.path, nachricht, self.client_address[0], True)
                self._antwort(nummer, antwort)

        class LeiserServer(socketserver.ThreadingTCPServer):
            allow_reuse_address = True
            daemon_threads = True
            request_queue_size = BAUM_HTTP_FADEN_MAX

            def __init__(self, *argumente, **schluessel):
                self._plaetze = threading.BoundedSemaphore(BAUM_HTTP_FADEN_MAX)
                self._aktive_sperre = threading.Lock()
                self._aktive = {}
                self._aktive_adressen = {}
                super().__init__(*argumente, **schluessel)

            def process_request(self, request, client_address):
                if not self._plaetze.acquire(False):
                    self.shutdown_request(request)
                    return
                adresse = baum_quelladresse_normieren(client_address[0])
                with self._aktive_sperre:
                    if self._aktive_adressen.get(adresse, 0) >= dienst.http_pro_adresse:
                        self._plaetze.release()
                        self.shutdown_request(request)
                        return
                    self._aktive_adressen[adresse] = self._aktive_adressen.get(adresse, 0) + 1
                    waechter = threading.Timer(
                        dienst.http_zeitgrenze, self._verbindung_beenden,
                        args=(request,))
                    waechter.daemon = True
                    self._aktive[request] = (adresse, waechter)
                    waechter.start()
                try:
                    super().process_request(request, client_address)
                except Exception:
                    self._platz_freigeben(request)
                    raise

            def _verbindung_beenden(self, request):
                import socket as _socket
                try:
                    request.shutdown(_socket.SHUT_RDWR)
                except OSError:
                    pass

            def _platz_freigeben(self, request):
                with self._aktive_sperre:
                    eintrag = self._aktive.pop(request, None)
                    if not eintrag:
                        return
                    adresse, waechter = eintrag
                    waechter.cancel()
                    anzahl = self._aktive_adressen.get(adresse, 1) - 1
                    if anzahl:
                        self._aktive_adressen[adresse] = anzahl
                    else:
                        self._aktive_adressen.pop(adresse, None)
                self._plaetze.release()

            def process_request_thread(self, request, client_address):
                try:
                    super().process_request_thread(request, client_address)
                finally:
                    self._platz_freigeben(request)

            def aktive_schliessen(self):
                with self._aktive_sperre:
                    anfragen = list(self._aktive)
                for request in anfragen:
                    self._verbindung_beenden(request)

        import socket

        class LeiserServer6(LeiserServer):
            address_family = socket.AF_INET6

            def server_bind(self):
                self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
                super().server_bind()

        try:
            self._server = LeiserServer(("", self.port), Behandler)
        except OSError:
            self._server = None
        if self._server:
            self.port = int(self._server.server_address[1])
        try:
            self._server6 = LeiserServer6(("::", self.port), Behandler)
        except OSError:
            self._server6 = None
        if not self._server and not self._server6:
            return False
        if self._server6 and not self._server:
            self.port = int(self._server6.server_address[1])
        if self._server:
            self._faden = threading.Thread(target=self._server.serve_forever,
                                           daemon=True)
            self._faden.start()
        if self._server6:
            self._faden6 = threading.Thread(target=self._server6.serve_forever,
                                            daemon=True)
            self._faden6.start()
        self._rufdienst_starten()
        self._bluetooth = BaumBluetoothDienst(self)
        if not self._bluetooth.starten():
            self._bluetooth = None
        with self._sperre:
            zustand = self.hole_zustand()
        if zustand and zustand.get("an"):
            self._mdns = baum_mdns_veroeffentlichen(zustand, self.port)
        return True

    def _rufdienst_starten(self):
        """Beantwortet Rundrufe im Netz, damit Nachbarn einander finden."""
        import socket
        import threading
        if getattr(self, "_ruf", None):
            return
        try:
            buechse = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            buechse.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            buechse.settimeout(0.5)
            buechse.bind(("", self.port))
        except OSError:
            self._ruf = None
            return
        self._ruf = buechse
        self._ruf_laeuft = True

        def horchen():
            while getattr(self, "_ruf_laeuft", False):
                try:
                    roh, woher = buechse.recvfrom(512)
                except socket.timeout:
                    continue
                except OSError:
                    break
                if roh.strip() != BAUM_RUF:
                    continue
                with self._sperre:
                    zustand = self.hole_zustand()
                if not zustand or not zustand.get("an"):
                    continue
                try:
                    buechse.sendto(baum_ruf_antwort(zustand), woher)
                except OSError:
                    pass

        threading.Thread(target=horchen, daemon=True).start()

    def anhalten(self):
        if self._bluetooth:
            self._bluetooth.anhalten()
            self._bluetooth = None
        self._ruf_laeuft = False
        if getattr(self, "_ruf", None):
            try:
                self._ruf.close()
            except OSError:
                pass
            self._ruf = None
        baum_mdns_beenden(self._mdns)
        self._mdns = None
        for server in (self._server, self._server6):
            if not server:
                continue
            try:
                server.aktive_schliessen()
                server.shutdown()
                server.server_close()
            except Exception:
                pass
        self._server = None
        self._server6 = None
        for faden in (self._faden, self._faden6):
            if faden and faden is not threading.current_thread():
                faden.join(timeout=2)
        self._faden = None
        self._faden6 = None
        for offen in self._fs_sitzungen.values():
            fs_sitzung_loeschen(offen["sitzung"])
        self._fs_sitzungen.clear()


def baum_anfragen(adresse, port, eigener_zustand, zeitgrenze=6,
                  erwarteter_fingerabdruck=""):
    """Fragt bei einer Gegenstelle um Bekanntschaft an."""
    import urllib.request
    erwartet = baum_fingerabdruck_normieren(erwarteter_fingerabdruck)
    if erwarteter_fingerabdruck and not erwartet:
        raise RuntimeError(_("The entered fingerprint is incomplete."))
    ziel = baum_url(adresse, int(port or BAUM_PORT), "/magnolie/v1/paarung")
    anfrage_inhalt = {
        "name": eigener_zustand.get("name") or "",
        "kennung": eigener_zustand.get("kennung") or "",
        "oeffentlich": eigener_zustand.get("oeffentlich") or "",
        "port": int(eigener_zustand.get("port") or BAUM_PORT),
    }
    daten = json.dumps(anfrage_inhalt).encode("utf-8")
    anfrage = urllib.request.Request(
        ziel, data=daten, headers={"Content-Type": "application/json"})
    with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(
            anfrage, timeout=zeitgrenze) as antwort:
        ergebnis = json.loads(antwort.read().decode("utf-8"))
    if not baum_oeffentlicher_schluessel_gueltig(ergebnis.get("oeffentlich")):
        raise RuntimeError(_("The other branch did not send a valid key."))
    erhalten = fingerabdruck(ergebnis.get("oeffentlich"))
    if erwartet and erhalten != erwartet:
        raise RuntimeError(
            _("The fingerprint does not match (received: %(fingerprint)s).") %
            {"fingerprint": erhalten})
    return ergebnis


def baum_paarungsdatei_importieren(dokument, eigener_zustand, sender=None,
                                    zeitgrenze=6):
    dokument = baum_paarungsdatei_pruefen(dokument)
    anfrage = baum_paarungsanfrage_bauen(eigener_zustand, dokument)
    ziel = dokument["ziel"]
    adresse = baum_url(ziel["adresse"], int(ziel["port"]),
                       "/magnolie/v2/paarung")
    sende = sender or (lambda url, nutzlast: _baum_http_json_senden(
        url, nutzlast, zeitgrenze))
    try:
        antwort = sende(adresse, anfrage)
    except Exception:
        # Derselbe Abschluss ist serverseitig idempotent und darf nach einem
        # verlorenen Antwortpaket genau einmal wiederholt werden.
        antwort = sende(adresse, anfrage)
    baum_paarungsantwort_pruefen(dokument, anfrage, antwort)
    einlader = dokument["einlader"]
    partner = baum_partner_aufnehmen(
        eigener_zustand, einlader["name"], einlader["kennung"],
        einlader["oeffentlich"], ziel["adresse"], einlader["port"])
    partner.update({"bestaetigt": True, "wartet": False,
                    "protokoll": "baum-fs1", "paarungsart": "datei-v2",
                    "vertraut": True})
    return partner


def baum_paarungsdatei_laden(pfad, jetzt=None):
    import stat
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(pfad, flags)
        try:
            stand = os.fstat(fd)
            if not stat.S_ISREG(stand.st_mode) or stand.st_size > BAUM_PAARUNG_DATEI_MAX:
                raise RuntimeError(_("The pairing file is too large or not a regular file."))
            with os.fdopen(fd, "r", encoding="utf-8") as datei:
                fd = -1
                text = datei.read(BAUM_PAARUNG_DATEI_MAX + 1)
        finally:
            if fd >= 0:
                os.close(fd)
    except OSError as fehler:
        raise RuntimeError(fehler_deutsch(fehler, _("Reading the pairing file")))
    if len(text.encode("utf-8")) > BAUM_PAARUNG_DATEI_MAX:
        raise RuntimeError(_("The pairing file is too large."))
    try:
        dokument = json.loads(text)
    except ValueError:
        raise RuntimeError(_("The pairing file is damaged."))
    return baum_paarungsdatei_pruefen(dokument, jetzt)


def baum_oeffentliche_adresse(zeitgrenze=6, holer=None):
    """Ermittelt auf ausdrücklichen Wunsch die öffentliche Internetadresse."""
    import ipaddress
    if holer is None:
        import urllib.request

        def holer():
            anfrage = urllib.request.Request(
                "https://api64.ipify.org", headers={
                    "User-Agent": "Magnolie-Organizer/%s" % PROGRAMM_FASSUNG})
            with urllib.request.urlopen(anfrage, timeout=zeitgrenze) as antwort:
                return antwort.read(200).decode("ascii")
    text = str(holer() or "").strip()
    try:
        adresse = ipaddress.ip_address(text)
    except ValueError:
        raise RuntimeError(_("The internet service did not return a valid IP address."))
    if not adresse.is_global:
        raise RuntimeError(_("No public IP address was found."))
    return str(adresse)


def baum_eingangsdatei(ordner=None):
    return os.path.join(ordner or daten_verzeichnis(), "baum-eingang.json")


def baum_eingang_lesen(pfad=None, kennwort=""):
    return _baum_liste_lesen(
        pfad or baum_eingangsdatei(), "baum-eingang-v1", kennwort)


def baum_eingang_schreiben(eingang, pfad=None, kennwort=""):
    pfad = pfad or baum_eingangsdatei()
    try:
        _baum_liste_schreiben(eingang, pfad, "baum-eingang-v1", kennwort)
        return True
    except (OSError, RuntimeError, TypeError, ValueError):
        return False


def baum_eingang_ablegen(partner, inhalt, pfad=None, kennwort=""):
    """Legt eine empfangene Nachricht für die Oberfläche bereit."""
    baum_kontakt_nutzlast_pruefen((inhalt or {}).get("art"), inhalt)
    eingang = baum_eingang_lesen(pfad, kennwort)
    eingang.append({
        "id": _zufallskennung(12),
        "von": partner.get("kennung"),
        "vonName": partner.get("name") or "",
        "art": (inhalt or {}).get("art") or "aufgabe",
        "inhalt": inhalt or {},
        "empfangen": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
    })
    if len(eingang) > 500:
        eingang = eingang[-500:]
    if not baum_eingang_schreiben(eingang, pfad, kennwort):
        raise RuntimeError(_("The Magnolienbaum inbox could not be saved."))
    return eingang[-1]


def baum_ablagen_vorbereiten(kennwort_neu, kennwort_alt=None, ordner=None):
    """Erzeugt neue Baumdatei-Inhalte, ohne die aktiven Dateien zu ändern."""
    ordner = ordner or daten_verzeichnis()
    kennwort_alt = kennwort_neu if kennwort_alt is None else kennwort_alt
    baum_pfad = baum_datei(ordner)
    angaben = [
        (baum_postdatei(ordner), "baum-post-v1"),
        (baum_eingangsdatei(ordner), "baum-eingang-v1"),
    ]
    originale, werte, vorbereitete = {}, {}, {}
    baum_ergebnis = None
    try:
        with open(baum_pfad, "r", encoding="utf-8") as datei:
            baum_text = datei.read()
        originale[baum_pfad] = baum_text
    except FileNotFoundError:
        baum_text = None
    if baum_text is not None:
        if baum_datei_ist_verschluesselt(baum_text):
            if kennwort_neu == kennwort_alt:
                zustand, dek, dek_kennung, umschlag = _baum_huelle_oeffnen(
                    baum_text, kennwort_alt)
                vorbereitet = baum_text
            else:
                vorbereitet, zustand, dek, dek_kennung, umschlag = \
                    _baum_huelle_umschlagen(
                        baum_text, kennwort_alt, kennwort_neu)
        else:
            try:
                zustand = _baum_zustand_pruefen(json.loads(baum_text))
            except (TypeError, ValueError):
                raise RuntimeError(_("The Magnolienbaum identity file is damaged."))
            if kennwort_neu:
                vorbereitet, dek, dek_kennung, umschlag = _baum_huelle_bauen(
                    zustand, kennwort_neu)
            else:
                vorbereitet = json.dumps(zustand, ensure_ascii=False, indent=1)
                dek = dek_kennung = umschlag = None
        if vorbereitet != baum_text:
            vorbereitete[os.path.basename(baum_pfad)] = vorbereitet
        baum_ergebnis = {"zustand": zustand, "dek": dek,
                         "dekKennung": dek_kennung, "umschlag": umschlag}
    for pfad, speicherart in angaben:
        try:
            with open(pfad, "r", encoding="utf-8") as datei:
                originale[pfad] = datei.read()
        except FileNotFoundError:
            continue
        werte[pfad] = _baum_liste_lesen(pfad, speicherart, kennwort_alt)
        war_verschluesselt = ist_verschluesselt(originale[pfad])
        if war_verschluesselt and kennwort_neu == kennwort_alt:
            text = originale[pfad]
        elif kennwort_neu:
            text = verschluesseln(json.dumps(
                {"speicher": speicherart, "wert": werte[pfad]},
                ensure_ascii=False, separators=(",", ":")), kennwort_neu)
        else:
            text = json.dumps(werte[pfad], ensure_ascii=False, indent=1)
        if text != originale[pfad]:
            vorbereitete[os.path.basename(pfad)] = text
    return {"dateien": vorbereitete, "baum": baum_ergebnis}


def baum_ablagen_umschluesseln(kennwort_neu, kennwort_alt=None, ordner=None):
    """Kompatibler Einzelaufruf über dieselbe absturzsichere Transaktion."""
    ordner = ordner or daten_verzeichnis()
    vorbereitet = baum_ablagen_vorbereiten(
        kennwort_neu, kennwort_alt, ordner)
    if vorbereitet["dateien"]:
        art = "entsperrmigration" if kennwort_neu == kennwort_alt else (
            "entfernen" if not kennwort_neu else (
                "setzen" if not kennwort_alt else "aendern"))
        kennwort_transaktion_ausfuehren(vorbereitet["dateien"], art, ordner)
    return {"anzahl": len(vorbereitet["dateien"]),
            "baum": vorbereitet["baum"]}


def baum_benachrichtigungstext(partner, inhalt):
    art = str((inhalt or {}).get("art") or "")
    if (partner or {}).get("vertraut") and art in ("aufgabe", "notiz"):
        return None
    if ((partner or {}).get("vertraut") and (partner or {}).get("kontakte")
            and art == "kontakt_sync"):
        return None
    vorlage = {
        "aufgabe": _("%(branch)s wants to share a task. Please accept or reject it in the Organizer."),
        "termin": _("%(branch)s wants to share an appointment. Please accept or reject it in the Organizer."),
        "kontakt": _("%(branch)s wants to share an address. Please accept or reject it in the Organizer."),
        "kontakt_sync": _("%(branch)s offers contact synchronization. Please accept or reject it in the Organizer."),
        "kontakt_loeschen": _("%(branch)s wants to share an address. Please accept or reject it in the Organizer."),
        "notiz": _("%(branch)s wants to share a note. Please accept or reject it in the Organizer."),
    }.get(art)
    if not vorlage:
        return None
    name = str((partner or {}).get("name") or _("A known branch"))[:60]
    return (_("New Magnolienbaum request"), vorlage % {"branch": name})


# ------------------------------- Suche im Netz -----------------------------

BAUM_RUF = b"MAGNOLIENBAUM?"


def baum_ruf_antwort(zustand):
    return json.dumps({
        "magnolie": BAUM_HÜLLE,
        "name": zustand.get("name") or "",
        "kennung": zustand.get("kennung") or "",
        "fingerabdruck": fingerabdruck(zustand.get("oeffentlich")),
        "port": int(zustand.get("port") or BAUM_PORT),
    }, ensure_ascii=False).encode("utf-8")


def baum_lokale_adressen(vorgegeben=None):
    """Liefert ohne betriebssystemspezifische ioctls bekannte lokale IPs."""
    import ipaddress
    import socket
    adressen = set()
    if vorgegeben is None:
        try:
            ergebnisse = [e[4][0] for e in socket.getaddrinfo(
                socket.gethostname(), None, socket.AF_UNSPEC, socket.SOCK_STREAM)]
        except OSError:
            ergebnisse = []
    else:
        ergebnisse = vorgegeben
    for textadresse in ergebnisse:
        try:
            adresse = ipaddress.ip_address(str(textadresse).split("%", 1)[0])
        except ValueError:
            continue
        if not adresse.is_unspecified and not adresse.is_multicast:
            adressen.add(str(adresse))
    nicht_loopback = [a for a in adressen if not ipaddress.ip_address(a).is_loopback]
    return sorted(nicht_loopback or adressen)


def baum_mdns_veroeffentlichen(zustand, port, klassen=None):
    """Veröffentlicht den Zweig per portablem DNS-SD; Ausfall bleibt optional."""
    import ipaddress
    try:
        if klassen is None:
            from zeroconf import (IPVersion, ServiceInfo, Zeroconf,
                                  get_all_addresses, get_all_addresses_v6)
            rohe_adressen = get_all_addresses() + [
                adresse[0][0] for adresse in get_all_addresses_v6()]
        else:
            Zeroconf, ServiceInfo, IPVersion = klassen
            rohe_adressen = None
        zc = Zeroconf(ip_version=IPVersion.All)
        info = ServiceInfo(
            BAUM_MDNS_ART, "%s.%s" % (zustand.get("kennung"), BAUM_MDNS_ART),
            addresses=[ipaddress.ip_address(a).packed for a in
                       baum_lokale_adressen(rohe_adressen)],
            port=int(port), properties={
                b"kennung": str(zustand.get("kennung") or "").encode("utf-8"),
                b"name": str(zustand.get("name") or "")[:60].encode("utf-8"),
                b"fingerabdruck": fingerabdruck(
                    zustand.get("oeffentlich")).encode("ascii"),
                b"fassung": b"1"})
        zc.register_service(info)
        return zc, info
    except Exception:
        try:
            zc.close()
        except Exception:
            pass
        return None


def baum_mdns_beenden(handle):
    if not handle:
        return
    zc, info = handle
    try:
        zc.unregister_service(info)
    except Exception:
        pass
    try:
        zc.close()
    except Exception:
        pass


def _baum_mdns_eintrag(info, eigene_kennung=""):
    import ipaddress
    eigenschaften = getattr(info, "properties", {}) or {}

    def text(name):
        wert = eigenschaften.get(name.encode("ascii"), b"")
        if isinstance(wert, bytes):
            return wert.decode("utf-8", "replace")
        return str(wert or "")

    kennung = text("kennung")[:64]
    abdruck = text("fingerabdruck")[:24]
    if (not re.fullmatch(r"[a-z2-9]{8,64}", kennung or "") or
            kennung == eigene_kennung or
            not re.fullmatch(r"[0-9A-F]{4}(?:-[0-9A-F]{4}){3}", abdruck)):
        return None
    try:
        adressen = (info.parsed_scoped_addresses()
                    if hasattr(info, "parsed_scoped_addresses")
                    else info.parsed_addresses())
    except Exception:
        return None
    brauchbar = []
    for textadresse in adressen:
        try:
            adresse = ipaddress.ip_address(str(textadresse).split("%", 1)[0])
        except ValueError:
            continue
        if not adresse.is_unspecified and not adresse.is_multicast:
            brauchbar.append(str(textadresse))
    try:
        port = int(info.port)
    except (TypeError, ValueError):
        return None
    if not brauchbar or not 1 <= port <= 65535:
        return None
    brauchbar.sort(key=lambda a: (
        ipaddress.ip_address(a.split("%", 1)[0]).is_link_local,
        ipaddress.ip_address(a.split("%", 1)[0]).version == 4, a))
    return {"name": text("name")[:60] or kennung, "kennung": kennung,
            "fingerabdruck": abdruck, "port": port,
            "adresse": brauchbar[0], "adressen": brauchbar, "fundart": "mdns"}


def baum_mdns_suchen(wartezeit=1.5, eigene_kennung="", klassen=None):
    """Sucht IPv4- und IPv6-Nachbarn per mDNS/DNS-SD."""
    import threading
    gefunden = {}
    sperre = threading.Lock()
    try:
        if klassen is None:
            from zeroconf import IPVersion, ServiceBrowser, Zeroconf
        else:
            Zeroconf, ServiceBrowser, IPVersion = klassen
        zc = Zeroconf(ip_version=IPVersion.All)

        class Lauscher:
            def add_service(self, zeroconf, art, name):
                info = zeroconf.get_service_info(art, name, timeout=500)
                eintrag = _baum_mdns_eintrag(info, eigene_kennung) if info else None
                if eintrag:
                    with sperre:
                        gefunden[eintrag["kennung"]] = eintrag

            update_service = add_service

            def remove_service(self, _zeroconf, _art, _name):
                pass

        browser = ServiceBrowser(zc, BAUM_MDNS_ART, Lauscher())
        threading.Event().wait(max(0.0, float(wartezeit)))
        if hasattr(browser, "cancel"):
            browser.cancel()
        zc.close()
    except Exception:
        try:
            zc.close()
        except Exception:
            pass
    return list(gefunden.values())


def baum_suchziele():
    """Begrenzter IPv4-Fallback für alte Magnolie-Versionen."""
    return ["127.0.0.1", "255.255.255.255"]


def baum_suchen(port=BAUM_PORT, wartezeit=1.5, eigene_kennung="",
                mdns_suche=None):
    """Sucht portabel per mDNS und zusätzlich per altem IPv4-Rundruf."""
    import socket
    import threading
    gefunden = {}
    mdns_ergebnis = []
    mdns_suche = mdns_suche or baum_mdns_suchen

    def mdns_arbeit():
        mdns_ergebnis.extend(mdns_suche(wartezeit, eigene_kennung))

    faden = threading.Thread(target=mdns_arbeit, daemon=True)
    faden.start()
    try:
        buechse = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        buechse.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        buechse.settimeout(0.4)
        for ziel in baum_suchziele():
            try:
                buechse.sendto(BAUM_RUF, (ziel, int(port)))
            except OSError:
                pass
        ende = _zeitpunkt_plus(wartezeit)
        while datetime.now() < ende:
            try:
                roh, woher = buechse.recvfrom(2048)
            except socket.timeout:
                continue
            except OSError:
                break
            try:
                antwort = json.loads(roh.decode("utf-8"))
            except ValueError:
                continue
            if antwort.get("magnolie") != BAUM_HÜLLE:
                continue
            kennung = antwort.get("kennung")
            if not kennung or kennung == eigene_kennung:
                continue
            antwort["adresse"] = woher[0]
            antwort["fundart"] = "udp"
            gefunden[kennung] = antwort
    except OSError:
        pass
    finally:
        try:
            buechse.close()
        except (NameError, OSError):
            pass
    faden.join(timeout=max(0.0, float(wartezeit)) + 0.6)
    for antwort in mdns_ergebnis:
        kennung = antwort.get("kennung")
        if kennung and kennung != eigene_kennung:
            gefunden[kennung] = antwort
    return list(gefunden.values())


def _zeitpunkt_plus(sekunden):
    from datetime import timedelta
    return datetime.now() + timedelta(seconds=sekunden)


FEIERTAG_DIENST = "https://openholidaysapi.org"
WETTER_DIENST = "https://wttr.in"
UPDATE_BASIS = ("https://gitlab.com/maik3531/mint-forgs/-/raw/main/"
                "Magnolie-Organitzer/")
UPDATE_XML = UPDATE_BASIS + "update.xml"
# Roher öffentlicher Ed25519-Schlüssel für Release-Manifeste, Base64-kodiert.
UPDATE_SIGNATUR_SCHLUESSEL = "8eJWsygSF9wsF22cuf+sChUUV5RtXEZt38Ngcugn/1Y="
_LETZTES_HANDBUCH_MANIFEST = {}
_LETZTES_UPDATE_PAKET = ""

_ISO_DATUM = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def _ist_iso(text):
    """Prüft ein Datum der Form JJJJ-MM-TT auf Form und Gültigkeit."""
    if not isinstance(text, str) or not _ISO_DATUM.match(text):
        return False
    try:
        datetime.strptime(text, "%Y-%m-%d")
    except ValueError:
        return False
    return True


def _url_holen(url, zeitlimit=20):
    """Holt eine Netzadresse und liefert verständliche Fehler weiter."""
    import urllib.error
    import urllib.request
    antrag = urllib.request.Request(url, headers={
        "User-Agent": "Magnolie-Organizer/%s (+lokales Programm)" % PROGRAMM_FASSUNG,
        "Accept": "application/json"})
    try:
        with urllib.request.urlopen(antrag, timeout=zeitlimit) as antwort:
            roh = antwort_begrenzt_lesen(
                antwort, FEIERTAG_ANTWORT_MAX,
                _("The holiday service returned too much data."))
            return _text_dekodieren(roh)
    except urllib.error.HTTPError as fehler:
        raise RuntimeError(
            _("The holiday service rejected the request (error %s). Check the "
              "country and region.") % fehler.code)
    except urllib.error.URLError as fehler:
        raise RuntimeError(
            _("The holiday service is unavailable. Is there an internet "
              "connection? (%s)") % (fehler.reason,))
    except OSError as fehler:
        raise RuntimeError(
            _("Retrieving holidays failed (%s).") % fehler)


def _wetter_text_holen(url, zeitlimit=20):
    """Holt höchstens ein MiB Wetterdaten von wttr.in."""
    import urllib.error
    import urllib.request
    antrag = urllib.request.Request(url, headers={
        "User-Agent": "Magnolie-Organizer/%s (+lokales Programm)" % PROGRAMM_FASSUNG,
        "Accept": "application/json"})
    try:
        with urllib.request.urlopen(antrag, timeout=zeitlimit) as antwort:
            roh = antwort.read(1024 * 1024 + 1)
        if len(roh) > 1024 * 1024:
            raise RuntimeError(_("The weather service returned too much data."))
        return _text_dekodieren(roh)
    except urllib.error.HTTPError as fehler:
        raise RuntimeError(
            _("The weather service rejected the request (error %s).") % fehler.code)
    except urllib.error.URLError as fehler:
        raise RuntimeError(
            _("The weather service is unavailable. Is there an internet "
              "connection? (%s)") % (fehler.reason,))
    except OSError as fehler:
        raise RuntimeError(_("Retrieving weather failed (%s).") % fehler)


def wetter_abrufen(ort="", holer=None, libreoffice_lader=None,
                   ohne_ort_abrufen=True):
    """Liest drei Vorhersagetage. Ort: eigene Anschrift, LibreOffice, sonst IP."""
    from urllib.parse import quote

    suchort = str(ort or "").strip()[:120]
    quelle = "adresse" if suchort else ""
    if not suchort:
        lader = libreoffice_lader or libreoffice_benutzerdaten
        try:
            lo = lader() or {}
        except Exception:
            lo = {}
        felder = lo.get("felder") if isinstance(lo, dict) else {}
        felder = felder if isinstance(felder, dict) else {}
        stadt = str(felder.get("l") or "").strip()
        plz = str(felder.get("postalcode") or "").strip()
        suchort = (plz + " " + stadt).strip()[:120]
        if suchort:
            quelle = "libreoffice"
    if not suchort:
        if not ohne_ort_abrufen:
            return {"ok": True, "ohneOrt": True, "ort": "", "quelle": "none",
                    "tage": [], "fehler": ""}
        quelle = "ip"

    pfad = "/" + quote(suchort, safe="") if suchort else "/"
    sprache = "de" if _feiertag_sprache() == "DE" else "en"
    url = WETTER_DIENST + pfad + "?format=j1&lang=" + sprache
    text = (holer or _wetter_text_holen)(url)
    try:
        roh = json.loads(text)
    except (TypeError, ValueError):
        raise RuntimeError(_("The weather service returned unreadable data."))
    if not isinstance(roh, dict):
        raise RuntimeError(_("The weather service returned no forecast."))

    def erster_wert(wert):
        if not isinstance(wert, list) or not wert or not isinstance(wert[0], dict):
            return ""
        return str(wert[0].get("value") or "").strip()

    tage = []
    for tag in (roh.get("weather") or [])[:3]:
        if not isinstance(tag, dict) or not _ist_iso(tag.get("date")):
            continue
        stunden = [h for h in (tag.get("hourly") or []) if isinstance(h, dict)]
        def abstand_mittag(stunde):
            try:
                return abs(int(stunde.get("time") or 0) - 1200)
            except (TypeError, ValueError):
                return 9999
        mittag = min(stunden, key=abstand_mittag) if stunden else {}
        beschreibung = (erster_wert(mittag.get("lang_" + sprache)) or
                        erster_wert(mittag.get("weatherDesc")) or
                        erster_wert(mittag.get("lang_de")))
        try:
            minimum = round(float(tag.get("mintempC")))
            maximum = round(float(tag.get("maxtempC")))
            code = int(mittag.get("weatherCode") or 0)
        except (TypeError, ValueError):
            continue
        tage.append({"datum": tag["date"], "min": minimum, "max": maximum,
                     "code": code, "beschreibung": beschreibung})
    if not tage:
        raise RuntimeError(_("The weather service returned no forecast."))

    ort_name = ""
    gebiete = roh.get("nearest_area") or []
    if gebiete and isinstance(gebiete[0], dict):
        ort_name = erster_wert(gebiete[0].get("areaName"))
    return {"ok": True, "ort": ort_name or suchort or _("approximate area"),
            "quelle": quelle, "tage": tage, "fehler": ""}


def versions_schluessel(fassung):
    """Macht Fassungen wie 1.24.9 oder 1.24.9-2 vergleichbar."""
    text = str(fassung or "").strip().lstrip("vV")
    if not re.fullmatch(r"\d+(?:\.\d+)*(?:-\d+)?", text):
        return ()
    return tuple(int(teil) for teil in re.findall(r"\d+", text))


def _update_url_erlaubt(url):
    try:
        from urllib.parse import urlsplit
        teile = urlsplit(str(url or "").strip())
    except (TypeError, ValueError):
        return False
    basis_pfad = "/maik3531/mint-forgs/-/raw/main/Magnolie-Organitzer/"
    return (teile.scheme == "https" and teile.netloc == "gitlab.com" and
            teile.path.startswith(basis_pfad) and
            teile.path.lower().endswith(".deb") and not teile.query and
             not teile.fragment)


def _appimage_update_url_erlaubt(url, version=""):
    try:
        from urllib.parse import urlsplit
        teile = urlsplit(str(url or "").strip())
        dateiname = os.path.basename(teile.path)
    except (TypeError, ValueError):
        return False
    basis_pfad = "/maik3531/mint-forgs/-/raw/main/Magnolie-Organitzer/"
    if (teile.scheme != "https" or teile.netloc != "gitlab.com" or
            not teile.path.startswith(basis_pfad) or teile.query or teile.fragment):
        return False
    if version:
        return dateiname == "Magnolie-Organizer-%s-x86_64.AppImage" % str(version).strip()
    return bool(re.fullmatch(
        r"Magnolie-Organizer-\d+(?:\.\d+)*(?:-\d+)?-x86_64\.AppImage", dateiname))


def _handbuch_update_url_erlaubt(url, version=""):
    if not _update_url_erlaubt(url):
        return False
    try:
        from urllib.parse import urlsplit
        dateiname = os.path.basename(urlsplit(str(url).strip()).path)
    except (TypeError, ValueError):
        return False
    if version:
        return dateiname == "magnolie-handbuch_%s_all.deb" % str(version).strip()
    return bool(re.fullmatch(r"magnolie-handbuch_\d+(?:\.\d+)*(?:-\d+)?_all\.deb",
                             dateiname))


def _update_manifest_url_erlaubt(url):
    return str(url or "").strip() == UPDATE_XML


def _update_xml_sicher(text):
    """Weist Entitaetsdeklarationen ab, bevor ElementTree sie verarbeitet."""
    xml_text = str(text or "").strip()
    if re.search(r"<!\s*(?:DOCTYPE|ENTITY)\b", xml_text, re.IGNORECASE):
        raise RuntimeError(_("The update information is unreadable."))
    return xml_text


def _update_antwort_oeffnen(antrag, zeitlimit, erlaubt):
    """Öffnet eine Updateadresse und prüft auch jedes Umleitungsziel."""
    import urllib.error
    import urllib.request

    class ErlaubteUpdateUmleitung(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            if not erlaubt(newurl):
                raise urllib.error.HTTPError(newurl, code, msg, headers, fp)
            return super().redirect_request(req, fp, code, msg, headers, newurl)

    if not erlaubt(antrag.full_url):
        raise urllib.error.URLError("update URL is not allowed")
    return urllib.request.build_opener(ErlaubteUpdateUmleitung()).open(
        antrag, timeout=zeitlimit)


def update_info_lesen(text):
    """Liest die kleine update.xml nach dem Vorbild des IPTV Recorders."""
    import xml.etree.ElementTree as ET
    try:
        wurzel = ET.fromstring(_update_xml_sicher(text))
    except (ET.ParseError, ValueError):
        raise RuntimeError(_("The update information is unreadable."))
    version = (wurzel.findtext("./version") or "").strip()
    paket = (wurzel.findtext("./deb") or "").strip()
    if not versions_schluessel(version):
        raise RuntimeError(_("The update information does not contain a valid version."))
    if paket and not _update_url_erlaubt(paket):
        raise RuntimeError(_("The update information does not refer to an allowed package URL."))
    return version, paket


def update_signatur_nachricht(version, paket, pruefsumme,
                              appimage_paket="", appimage_pruefsumme="",
                              manual_version="", manual_linux="", manual_linux_sha="",
                              manual_windows="", manual_windows_sha="",
                              windows_version="", windows_url="", windows_sha=""):
    """Kanonische, vom Releasewerkzeug und vom Programm signierte Nachricht."""
    return ("Magnolie Organizer Update\nversion=%s\ndeb=%s\nsha256=%s\n"
            "appimage=%s\nappimageSha256=%s\nmanualVersion=%s\n"
            "manualLinux=%s\nmanualLinuxSha256=%s\nmanualWindows=%s\n"
            "manualWindowsSha256=%s\nwindowsVersion=%s\nwindows=%s\n"
            "windowsSha256=%s\n" %
            (str(version).strip(), str(paket).strip(),
             str(pruefsumme).strip().lower(), str(appimage_paket).strip(),
             str(appimage_pruefsumme).strip().lower(), str(manual_version).strip(),
             str(manual_linux).strip(), str(manual_linux_sha).strip().lower(),
             str(manual_windows).strip(), str(manual_windows_sha).strip().lower(),
             str(windows_version).strip(), str(windows_url).strip(),
             str(windows_sha).strip().lower())).encode("utf-8")


def _update_signaturschluessel_pruefen(oeffentlicher_schluessel=None):
    schluessel_text = (UPDATE_SIGNATUR_SCHLUESSEL if
                       oeffentlicher_schluessel is None else
                       str(oeffentlicher_schluessel or "")).strip()
    try:
        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
        return Ed25519PublicKey.from_public_bytes(
            base64.b64decode(schluessel_text, validate=True))
    except Exception:
        raise RuntimeError(_("The public key is invalid."))


def update_manifest_pruefen(text, oeffentlicher_schluessel=None):
    """Akzeptiert ausschließlich mit dem Release-Schlüssel signierte Metadaten."""
    import xml.etree.ElementTree as ET
    schluessel = _update_signaturschluessel_pruefen(oeffentlicher_schluessel)
    try:
        wurzel = ET.fromstring(_update_xml_sicher(text))
    except (ET.ParseError, ValueError):
        raise RuntimeError(_("The update information is unreadable."))
    version = (wurzel.findtext("./version") or "").strip()
    paket = (wurzel.findtext("./deb") or "").strip()
    pruefsumme = (wurzel.findtext("./sha256") or "").strip().lower()
    signatur_text = (wurzel.findtext("./signature") or "").strip()
    if not versions_schluessel(version):
        raise RuntimeError(_("The update information does not contain a valid version."))
    if paket and not _update_url_erlaubt(paket):
        raise RuntimeError(_("The update information does not refer to an allowed package URL."))
    appimage = {}
    appimage_knoten = wurzel.find("./appimage")
    if appimage_knoten is not None:
        appimage_architektur = (appimage_knoten.findtext("./architecture") or "").strip()
        appimage_paket = (appimage_knoten.findtext("./url") or "").strip()
        appimage_summe = (appimage_knoten.findtext("./sha256") or "").strip().lower()
        if (appimage_architektur == "x86_64" and
                _appimage_update_url_erlaubt(appimage_paket, version) and
                re.fullmatch(r"[0-9a-f]{64}", appimage_summe)):
            appimage = {"architecture": appimage_architektur,
                        "url": appimage_paket, "sha256": appimage_summe}
    handbuch = {}
    handbuch_fehler = ""
    handbuch_knoten = wurzel.find("./manual")
    if handbuch_knoten is not None:
        handbuch_version = (handbuch_knoten.findtext("./version") or "").strip()
        handbuch_paket = (handbuch_knoten.findtext("./linux/deb") or "").strip()
        handbuch_summe = (handbuch_knoten.findtext("./linux/sha256") or "").strip().lower()
        if (versions_schluessel(handbuch_version) and
                _handbuch_update_url_erlaubt(handbuch_paket, handbuch_version) and
                re.fullmatch(r"[0-9a-f]{64}", handbuch_summe)):
            handbuch = {"version": handbuch_version, "url": handbuch_paket,
                        "sha256": handbuch_summe, "platform": "linux"}
        else:
            handbuch_fehler = _("The manual update information is invalid.")
    if not paket or not _update_url_erlaubt(paket):
        raise RuntimeError(_("The update information does not refer to an allowed package URL."))
    if not re.fullmatch(r"[0-9a-f]{64}", pruefsumme):
        raise RuntimeError(_("The update information does not contain a valid package checksum."))
    try:
        signatur = base64.b64decode(signatur_text, validate=True)
        if len(signatur) != 64:
            raise ValueError("signature length")
        windows_knoten = wurzel.find("./windows")
        schluessel.verify(signatur, update_signatur_nachricht(
            version, paket, pruefsumme,
            appimage_paket if appimage_knoten is not None else "",
            appimage_summe if appimage_knoten is not None else "",
            (handbuch_knoten.findtext("./version") or "") if handbuch_knoten is not None else "",
            (handbuch_knoten.findtext("./linux/deb") or "") if handbuch_knoten is not None else "",
            (handbuch_knoten.findtext("./linux/sha256") or "") if handbuch_knoten is not None else "",
            (handbuch_knoten.findtext("./windows/url") or "") if handbuch_knoten is not None else "",
            (handbuch_knoten.findtext("./windows/sha256") or "") if handbuch_knoten is not None else "",
            (windows_knoten.findtext("./version") or "") if windows_knoten is not None else "",
            (windows_knoten.findtext("./url") or "") if windows_knoten is not None else "",
            (windows_knoten.findtext("./sha256") or "") if windows_knoten is not None else ""))
    except Exception:
        raise RuntimeError(_("The update information has an invalid signature."))
    return {"version": version, "url": paket, "sha256": pruefsumme,
            "appimage": appimage, "handbuch": handbuch,
            "handbuchFehler": handbuch_fehler}


def _update_text_holen(url=UPDATE_XML, zeitlimit=8):
    import urllib.error
    import urllib.request
    antrag = urllib.request.Request(url, headers={
        "User-Agent": "Magnolie-Organizer/%s" % PROGRAMM_FASSUNG,
        "Accept": "application/xml, text/xml, text/plain"})
    try:
        with _update_antwort_oeffnen(
                antrag, zeitlimit, _update_manifest_url_erlaubt) as antwort:
            roh = antwort.read(262145)
    except (urllib.error.HTTPError, urllib.error.URLError, OSError) as fehler:
        raise RuntimeError(_("The update information is currently unavailable (%s).")
                           % fehler)
    if len(roh) > 262144:
        raise RuntimeError(_("The update information is unexpectedly large."))
    return _text_dekodieren(roh)


def update_pruefen(holer=None, oeffentlicher_schluessel=None):
    """Liefert den Aktualisierungsstand ohne eine Installation auszulösen."""
    global _LETZTES_HANDBUCH_MANIFEST, _LETZTES_UPDATE_PAKET
    _LETZTES_UPDATE_PAKET = ""
    try:
        _update_signaturschluessel_pruefen(oeffentlicher_schluessel)
        text = (holer or _update_text_holen)(UPDATE_XML)
        manifest = update_manifest_pruefen(text, oeffentlicher_schluessel)
        version = manifest["version"]
        appimage = manifest.get("appimage") or {}
        als_appimage = bool(os.environ.get("APPIMAGE"))
        paket = appimage.get("url", "") if als_appimage else manifest["url"]
        pruefsumme = (appimage.get("sha256", "") if als_appimage else
                      manifest["sha256"])
    except Exception as fehler:
        _LETZTES_HANDBUCH_MANIFEST = {}
        return {"ok": False, "aktuell": False, "version": "", "url": "",
                "handbuch": {},
                "handbuchFehler": str(fehler) or _("The update check failed."),
                "fehler": str(fehler) or
                _("The update check failed.")}
    neuer = versions_schluessel(version) > versions_schluessel(PROGRAMM_FASSUNG)
    if neuer and not paket:
        return {"ok": False, "aktuell": False, "version": version, "url": "",
                "fehler": _("No package has been specified for the new version yet.")}
    _LETZTES_HANDBUCH_MANIFEST = dict(manifest.get("handbuch") or {})
    _LETZTES_UPDATE_PAKET = paket if neuer else ""
    return {"ok": True, "aktuell": not neuer, "version": version,
            "url": paket if neuer else "", "sha256": pruefsumme,
            "handbuch": manifest.get("handbuch") or {},
            "handbuchFehler": manifest.get("handbuchFehler") or "", "fehler": ""}


def _update_paket_url_oeffnen(url, starter=None):
    import subprocess
    if not (_update_url_erlaubt(url) or _appimage_update_url_erlaubt(url)):
        return {"ok": False, "fehler": _("The package URL is not allowed.")}
    if starter is None:
        def starter(argumente):
            subprocess.Popen(argumente, start_new_session=True,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
    for name in ("xdg-open", "gio"):
        werkzeug = shutil.which(name)
        if not werkzeug:
            continue
        argumente = ([werkzeug, "open", url] if name == "gio"
                     else [werkzeug, url])
        try:
            starter(argumente)
        except OSError:
            continue
        return {"ok": True, "fehler": ""}
    return {"ok": False, "fehler": _("No web browser was found.")}


def update_paket_oeffnen(url, starter=None):
    """Öffnet ausschließlich das zuletzt signiert freigegebene Updatepaket."""
    if str(url or "") != _LETZTES_UPDATE_PAKET:
        return {"ok": False, "fehler": _("The package URL is not allowed.")}
    return _update_paket_url_oeffnen(url, starter)


def medikament_suche_oeffnen(name, starter=None):
    """Öffnet eine feste Arzneimittelsuche ohne frei wählbare Zieladresse."""
    from urllib.parse import quote
    suchtext = str(name or "").strip()[:120]
    if not suchtext:
        return False
    url = "https://www.gelbe-liste.de/suche/" + quote(suchtext, safe="")
    if starter is None:
        def starter(argumente):
            subprocess.Popen(argumente, start_new_session=True,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
    for programm in ("xdg-open", "gio"):
        werkzeug = shutil.which(programm)
        if not werkzeug:
            continue
        argumente = [werkzeug, "open", url] if programm == "gio" else [werkzeug, url]
        try:
            starter(argumente)
            return True
        except OSError:
            continue
    return False


def handbuch_paket_herunterladen(url, version, pruefsumme, platform="linux",
                                 holer=None, starter=None):
    """Lädt genau das zuletzt geprüfte Paket, prüft es und öffnet es sichtbar."""
    import urllib.request
    erwartet = {"version": str(version or ""), "url": str(url or ""),
                "sha256": str(pruefsumme or "").lower(), "platform": platform}
    if platform != "linux" or erwartet != _LETZTES_HANDBUCH_MANIFEST:
        return {"ok": False, "fehler": _("The manual download request is no longer valid.")}
    if (not _handbuch_update_url_erlaubt(url, version) or
            not re.fullmatch(r"[0-9a-f]{64}", erwartet["sha256"])):
        return {"ok": False, "fehler": _("The manual package URL is not allowed.")}
    pfad = ""
    try:
        fd, pfad = tempfile.mkstemp(prefix="magnolie-handbuch-", suffix=".deb")
        os.close(fd)
        antrag = urllib.request.Request(url, headers={
            "User-Agent": "Magnolie-Organizer/%s" % PROGRAMM_FASSUNG})
        antwort = (holer(antrag, timeout=30) if holer else
                   _update_antwort_oeffnen(
                       antrag, 30,
                       lambda ziel: _handbuch_update_url_erlaubt(ziel, version)))
        with antwort, open(pfad, "wb") as datei:
            hasher = hashlib.sha256()
            gesamt = 0
            while True:
                block = antwort.read(1024 * 1024)
                if not block:
                    break
                gesamt += len(block)
                if gesamt > 128 * 1024 * 1024:
                    raise RuntimeError(_("The manual package is unexpectedly large."))
                hasher.update(block)
                datei.write(block)
        if not hmac.compare_digest(hasher.hexdigest(), erwartet["sha256"]):
            raise RuntimeError(_("The manual package checksum does not match."))
        if starter is None:
            starter = lambda argumente: subprocess.Popen(
                argumente, start_new_session=True, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL)
        for name in ("xdg-open", "gio"):
            werkzeug = shutil.which(name)
            if not werkzeug:
                continue
            argumente = ([werkzeug, "open", pfad] if name == "gio" else
                         [werkzeug, pfad])
            try:
                starter(argumente)
                return {"ok": True, "fehler": "", "pfad": pfad}
            except OSError:
                continue
        raise RuntimeError(_("No application was found for the manual package."))
    except Exception as fehler:
        if pfad:
            try:
                os.unlink(pfad)
            except OSError:
                pass
        return {"ok": False, "fehler": str(fehler) or
                _("The manual package could not be opened.")}


def handbuch_paket_oeffnen(url, starter=None):
    """Kompatibler Browserweg für ältere Aufrufer; die UI nutzt den Hash-Download."""
    if not _handbuch_update_url_erlaubt(url):
        return {"ok": False, "fehler": _("The manual package URL is not allowed.")}
    return _update_paket_url_oeffnen(url, starter)


def _feiertag_sprache():
    """Liefert das feste OpenHolidays-Sprachkürzel der Oberfläche."""
    sprache = str(_REGIONAL.get("language") or "de").lower()
    return "DE" if sprache.startswith("de") or sprache == "system" else "EN"


def _name_waehlen(namen, sprache=None):
    """Bevorzugt aus der Namensliste die Sprache der Oberfläche."""
    if isinstance(namen, str):
        return namen
    bester = ""
    for eintrag in namen or []:
        if not isinstance(eintrag, dict):
            continue
        text = (eintrag.get("text") or "").strip()
        if not text:
            continue
        if (eintrag.get("language") or "").upper() == (sprache or _feiertag_sprache()):
            return text
        if not bester:
            bester = text
    return bester


def _openholidays_auswerten(rohtext, art):
    """Wertet die Antwort des Feiertagsdienstes aus und liefert Einträge
    der Form {von, bis, name, art}."""
    try:
        daten = json.loads(rohtext)
    except ValueError:
        raise RuntimeError(_("The holiday service returned an unreadable response."))
    if isinstance(daten, dict):
        daten = daten.get("data") or []
    eintraege = []
    for satz in daten if isinstance(daten, list) else []:
        if not isinstance(satz, dict):
            continue
        von = (satz.get("startDate") or "").strip()[:10]
        bis = (satz.get("endDate") or von).strip()[:10] or von
        name = _name_waehlen(satz.get("name"))
        if not _ist_iso(von) or not name:
            continue
        if not _ist_iso(bis) or bis < von:
            bis = von
        eintraege.append({"von": von, "bis": bis, "name": name, "art": art})
    return eintraege


def feiertage_abrufen(land, region, jahre, ferien=True, holer=None,
                      regionen=None, region_erforderlich=False):
    """Holt Feiertage (und auf Wunsch Schulferien) für die genannten Jahre.
    Liefert {feiertage: [...], bericht: "..."}."""
    holer = holer or _url_holen
    land = (land or "").strip().upper()
    region = (region or "").strip().upper()
    if not land:
        raise RuntimeError(_("Select a country first."))
    jahre = sorted({int(j) for j in jahre or [] if str(j).isdigit()})
    if not jahre:
        raise RuntimeError(_("Select at least one year."))
    if len(jahre) > 3:
        raise RuntimeError(_("Select no more than three years."))

    from urllib.parse import urlencode
    regions_liste = []
    for eintrag in regionen or []:
        if isinstance(eintrag, dict):
            code = str(eintrag.get("code") or "").strip().upper()
            name = str(eintrag.get("name") or "").strip()
        elif isinstance(eintrag, (list, tuple)) and len(eintrag) >= 2:
            code = str(eintrag[0] or "").strip().upper()
            name = str(eintrag[1] or "").strip()
        else:
            continue
        if code and name and (code, name) not in regions_liste:
            regions_liste.append((code, name))
    if len(regions_liste) > 26:
        raise RuntimeError(_("Too many regions were selected."))
    if region and regions_liste:
        regions_liste = []
    if region_erforderlich and not region and not regions_liste:
        raise RuntimeError(_("Select your canton first or enable “All cantons”.")
                           if land == "CH" else
                           _("Select your state first or enable “All states”."))

    ziele = [(region, "")] if region else (regions_liste or [("", "")])
    gesammelt = []
    abruf_bytes = 0
    for jahr in jahre:
        wege = [("PublicHolidays", "public-holiday")]
        if ferien:
            wege.append(("SchoolHolidays", "school-holiday"))
        for pfad, art in wege:
            for region_code, region_name in ziele:
                felder = [
                    ("countryIsoCode", land),
                    ("languageIsoCode", _feiertag_sprache()),
                    ("validFrom", "%d-01-01" % jahr),
                    ("validTo", "%d-12-31" % jahr)]
                if region_code:
                    felder.append(("subdivisionCode", region_code))
                url = "%s/%s?%s" % (
                    FEIERTAG_DIENST, pfad, urlencode(felder))
                try:
                    rohtext = holer(url)
                    abruf_bytes += len(str(rohtext).encode("utf-8"))
                    if abruf_bytes > FEIERTAG_ABRUF_MAX:
                        raise GroessenFehler(
                            _("The holiday service returned too much data."))
                    eintraege = _openholidays_auswerten(rohtext, art)
                except GroessenFehler:
                    raise
                except RuntimeError:
                    if art == "school-holiday":
                        continue      # Schulferien sind nicht überall gepflegt
                    raise
                for eintrag in eintraege:
                    eintrag["region"] = region_code
                    eintrag["regionName"] = region_name
                    gesammelt.append(eintrag)

    # Bei „Alle Bundesländer“ gleiche Zeiträume zusammenfassen. So steht
    # „Sommerferien (Bayern, Hessen)“ einmal da statt zehnmal ohne Herkunft.
    gruppen = {}
    for e in gesammelt:
        schluessel = (e["von"], e["bis"], kanonischer_text(e["name"]), e["art"])
        gruppe = gruppen.setdefault(schluessel, {
            "von": e["von"], "bis": e["bis"], "name": e["name"],
            "art": e["art"], "regionen": set(), "codes": set()})
        if e.get("regionName"):
            gruppe["regionen"].add(e["regionName"])
        if e.get("region"):
            gruppe["codes"].add(e["region"])

    alle_namen = [name for _code, name in regions_liste]
    sauber = []
    for gruppe in gruppen.values():
        namen = sorted(gruppe.pop("regionen"), key=str.casefold)
        codes = sorted(gruppe.pop("codes"))
        if regions_liste and namen:
            if len(namen) == len(alle_namen):
                zusatz = (_("all cantons") if land == "CH" else _("all states"))
            elif len(namen) > len(alle_namen) / 2:
                fehlen = [n for n in alle_namen if n not in namen]
                zusatz = _("all except %(regions)s") % {
                    "regions": ", ".join(fehlen)}
            else:
                zusatz = ", ".join(namen)
            gruppe["name"] += " (" + zusatz + ")"
            gruppe["regionName"] = zusatz
            gruppe["region"] = ",".join(codes)
        else:
            gruppe["regionName"] = namen[0] if namen else ""
            gruppe["region"] = codes[0] if codes else region
        sauber.append(gruppe)
    sauber.sort(key=lambda e: (e["von"], e["name"]))

    anzahl = {
        "public-holiday": len([e for e in sauber
                               if e["art"] == "public-holiday"]),
        "school-holiday": len([e for e in sauber
                               if e["art"] == "school-holiday"]),
    }
    teile = []
    if anzahl["public-holiday"]:
        teile.append(ngettext("%d public holiday", "%d public holidays",
                              anzahl["public-holiday"]) % anzahl["public-holiday"])
    if anzahl["school-holiday"]:
        teile.append(ngettext("%d holiday period", "%d holiday periods",
                              anzahl["school-holiday"]) % anzahl["school-holiday"])
    bericht = (_("Retrieved: %(items)s for %(years)s.") % {
        "items": ", ".join(teile),
        "years": ", ".join(str(j) for j in jahre)}) if teile else \
        _("The service returned no entries for this selection.")
    return {"feiertage": sauber, "bericht": bericht, "jahre": jahre}


# ---------------------------------------------------------------------------
# Lokale Datenquellen (Evolution / Thunderbird) – lesen ohne EDS-Anbindung
#
# Liest Adressen und Termine notfalls direkt aus den Datenbankdateien,
# so wie es auch andere Helfer (z. B. das Tux-i-Maskottchen) tun. Es wird
# ausschließlich GELESEN: die Datenbanken werden vor dem Öffnen in ein
# Temporärverzeichnis kopiert, damit laufende Programme ungestört bleiben.
# ---------------------------------------------------------------------------

_SQL_NAME = re.compile(r"^[A-Za-z0-9_.\- ]+$")


def _sqlite_kopie_oeffnen(pfad):
    """Kopiert eine SQLite-Datei (samt -wal/-shm) und öffnet die Kopie
    schreibgeschützt. Liefert (verbindung, aufraeumen) oder (None, None)."""
    if not os.path.isfile(pfad):
        return None, None
    ordner = tempfile.mkdtemp(prefix="magnolie-lese-")

    def aufraeumen():
        shutil.rmtree(ordner, ignore_errors=True)

    try:
        ziel = os.path.join(ordner, os.path.basename(pfad))
        shutil.copy2(pfad, ziel)
        for anhang in ("-wal", "-shm"):
            if os.path.isfile(pfad + anhang):
                shutil.copy2(pfad + anhang, ziel + anhang)
        verbindung = sqlite3.connect(ziel)
        return verbindung, aufraeumen
    except (OSError, sqlite3.Error):
        aufraeumen()
        return None, None


def _texte_aus_sqlite(pfad, praefixe):
    """Sucht in einer beliebigen SQLite-Datei nach Textspalten, deren
    Inhalt mit einem der Präfixe beginnt (z. B. BEGIN:VCARD), und liefert
    alle Treffer. Funktioniert dadurch für die verschiedenen Ablageformate
    von Evolution (contacts.db, cache.db) und Thunderbird (local.sqlite)."""
    verbindung, aufraeumen = _sqlite_kopie_oeffnen(pfad)
    if verbindung is None:
        return []
    texte = []
    try:
        zeiger = verbindung.cursor()
        try:
            tabellen = [z[0] for z in zeiger.execute(
                "SELECT name FROM sqlite_master WHERE type='table'")]
        except sqlite3.Error:
            return []
        for tabelle in tabellen:
            if not _SQL_NAME.match(tabelle):
                continue
            try:
                spalten = [z[1] for z in zeiger.execute(
                    'PRAGMA table_info("%s")' % tabelle)]
            except sqlite3.Error:
                continue
            for spalte in spalten:
                if not _SQL_NAME.match(spalte):
                    continue
                try:
                    bedingungen = " OR ".join(
                        'LTRIM("%s") LIKE ?' % spalte for _p in praefixe)
                    for (wert,) in zeiger.execute(
                            ('SELECT "%s" FROM "%s" WHERE "%s" IS NOT NULL AND (%s)'
                             % (spalte, tabelle, spalte, bedingungen)),
                            tuple(p + "%" for p in praefixe)):
                        if isinstance(wert, str) and wert.lstrip().startswith(praefixe):
                            texte.append(wert)
                except sqlite3.Error:
                    continue
    finally:
        try:
            verbindung.close()
        finally:
            aufraeumen()
    return texte


def _tb_karten_vcards(pfad):
    """Liest ein Thunderbird-Adressbuch (abook*.sqlite, Tabelle
    properties) und baut daraus vCards für den vorhandenen Parser."""
    verbindung, aufraeumen = _sqlite_kopie_oeffnen(pfad)
    if verbindung is None:
        return []
    karten = {}
    try:
        zeiger = verbindung.cursor()
        try:
            for karte, name, wert in zeiger.execute(
                    "SELECT card, name, value FROM properties"):
                if isinstance(wert, str) and wert:
                    karten.setdefault(karte, {}).setdefault(name, []).append(wert)
        except sqlite3.Error:
            return []
    finally:
        try:
            verbindung.close()
        finally:
            aufraeumen()

    vcards = []
    for karten_uid, eigenschaften in karten.items():
        direkte = eigenschaften.get("_vCard", [])
        if direkte:
            vcards.extend(wert for wert in direkte if "BEGIN:VCARD" in wert.upper())
            continue
        def e(name, standard="", eigenschaften=eigenschaften):
            werte = eigenschaften.get(name, [])
            return werte[0] if werte else standard
        nach, vor = e("LastName", "").strip(), e("FirstName", "").strip()
        anzeige = e("DisplayName", "").strip()
        firma = e("Company", "").strip()
        emails = _email_liste({"emails": [e("PrimaryEmail", "").strip(),
                                            e("SecondEmail", "").strip()]})
        if not (nach or vor or anzeige or firma or emails):
            continue
        zeilen = ["BEGIN:VCARD", "VERSION:3.0",
                  "N:%s;%s;;;" % (_vcard_escape(nach), _vcard_escape(vor)),
                  "FN:" + _vcard_escape(anzeige or (" ".join(
                      t for t in (vor, nach) if t)) or firma or (emails[0] if emails else ""))]
        if firma:
            zeilen.append("ORG:" + _vcard_escape(firma))
        for email in emails:
            zeilen.append("EMAIL:" + _vcard_escape(email))
        for feld, typen in (
                ("HomePhone", "HOME,VOICE"), ("WorkPhone", "WORK,VOICE"),
                ("CellularNumber", "CELL"), ("FaxNumber", "FAX"),
                ("HomeFax", "HOME,FAX"), ("WorkFax", "WORK,FAX"),
                ("PagerNumber", "PAGER"), ("OtherNumber", "VOICE")):
            nummer = e(feld, "").strip()
            if nummer:
                zeilen.append("TEL;TYPE=%s:%s" % (typen, _vcard_escape(nummer)))
        for vorsilbe, typ in (("Home", "HOME"), ("Work", "WORK")):
            strasse = " ".join(t for t in
                               (e(vorsilbe + "Address", "").strip(),
                                e(vorsilbe + "Address2", "").strip()) if t)
            ort = e(vorsilbe + "City", "").strip()
            plz = e(vorsilbe + "ZipCode", "").strip()
            land = e(vorsilbe + "Country", "").strip()
            if strasse or ort or plz or land:
                zeilen.append("ADR;TYPE=%s:;;%s;%s;;%s;%s" % (
                    typ, _vcard_escape(strasse), _vcard_escape(ort),
                    _vcard_escape(plz), _vcard_escape(land)))
        notiz = e("Notes", "").strip()
        if notiz:
            zeilen.append("NOTE:" + _vcard_escape(notiz))
        foto = _vcard_foto(e("PhotoURI", ""), {}, True)
        if not foto:
            name = e("PhotoName", "").strip()
            if name:
                profil = os.path.dirname(pfad)
                for kandidat in (name, os.path.join(profil, "Photos", name),
                                  os.path.join(profil, name)):
                    foto = _vcard_foto(kandidat, {}, True)
                    if foto:
                        break
        if not foto:
            foto = _vcard_foto(e("Photo", ""), {}, True)
        if foto:
            # Der vorhandene vCard-Parser prüft und übernimmt Datenadressen.
            zeilen.append("PHOTO:" + foto)
        try:
            monat, tag = int(e("BirthMonth", "0")), int(e("BirthDay", "0"))
            jahr = int(e("BirthYear", "0") or 0)
            if 1 <= monat <= 12 and 1 <= tag <= 31:
                if jahr >= 1000:
                    zeilen.append("BDAY:%04d-%02d-%02d" % (jahr, monat, tag))
                else:
                    zeilen.append("BDAY:--%02d-%02d" % (monat, tag))
        except (TypeError, ValueError):
            pass
        if karten_uid:
            zeilen.append("UID:" + _vcard_escape(str(karten_uid)))
        zeilen.append("END:VCARD")
        vcards.append("\r\n".join(zeilen) + "\r\n")
    return vcards


def _tb_native_datumzeit(wert, tzid="", ganztag=False):
    """Wandelt Thunderbirds nativeTime (Mikrosekunden seit 1970) um."""
    try:
        dt = datetime.fromtimestamp(int(wert) / 1000000.0, timezone.utc)
    except (OSError, OverflowError, TypeError, ValueError):
        return "", ""
    tzid = str(tzid or "")
    absolut = tzid == "UTC"
    if not ganztag and tzid not in ("", "UTC", "floating"):
        try:
            from zoneinfo import ZoneInfo
            ZoneInfo(tzid)
            absolut = True
        except (ImportError, KeyError, ValueError):
            pass
    if not ganztag and absolut:
        dt = dt.astimezone(_organizer_zeitzone())
    return dt.strftime("%Y-%m-%d"), "" if ganztag else dt.strftime("%H:%M")


def _tb_wiederholung_lesen(werte, datum, zeit="", hat_ausnahmen=False):
    """Liest Thunderbirds gespeicherte RRULE-Zeilen in das einfache Modell."""
    regeln = []
    komplex = bool(hat_ausnahmen)
    for roh in werte or []:
        for zeile in _entfalte_zeilen(str(roh or "")):
            prop = _prop_zerlegen(zeile)
            if not prop:
                komplex = True
                continue
            name, _params, wert = prop
            if name == "RRULE":
                regeln.append(wert)
            elif name in ("RDATE", "EXDATE", "EXRULE"):
                komplex = True
    if len(regeln) != 1:
        return None, bool(komplex or regeln or werte)
    wiederholung = None if komplex else _ics_wiederholung(regeln[0], datum, zeit)
    return wiederholung, bool(komplex or not wiederholung)


def _tb_speicherschluessel(zeile, spalten):
    item_id = zeile["item_id"] if "item_id" in spalten else (
        zeile["id"] if "id" in spalten else "")
    return (str(zeile["cal_id"] or "") if "cal_id" in spalten else "",
            str(item_id or ""),
            zeile["recurrence_id"] if "recurrence_id" in spalten else None,
            str(zeile["recurrence_id_tz"] or "")
            if "recurrence_id_tz" in spalten else "")


def _tb_ical_zeile(name, wert, parameter=None):
    if not isinstance(wert, str) or not wert or "\x00" in wert:
        return ""
    if "\n" in wert or "\r" in wert:
        return wert if wert.startswith(("BEGIN:", "RRULE:", "RDATE:", "EXDATE:")) else ""
    parameter_text = "".join(";%s=%s" % (k, v) for k, v in (parameter or {}).items()
                              if k and v and "\n" not in str(v) and "\r" not in str(v))
    return "%s%s:%s" % (name, parameter_text, wert)


TB_ROUNDTRIP_ZEILEN_MAX = 256


def _tb_zusatzzeilen(zusatz, props, parameter):
    """Baut geordnete Zusatzzeilen; keine gleichnamige Zeile wird ersetzt."""
    prop_zeilen = []
    for name, werte in props.items():
        parameter_werte = parameter.get(name, [])
        parameter_pro_index = [{} for _wert in werte]
        parameter_vorkommen = {}
        for key, wert in parameter_werte:
            index = parameter_vorkommen.get(key, 0)
            parameter_vorkommen[key] = index + 1
            if parameter_pro_index:
                parameter_pro_index[min(index, len(parameter_pro_index) - 1)][key] = wert
        for index, wert in enumerate(werte):
            roh = _tb_ical_zeile(name, wert, parameter_pro_index[index])
            prop = _prop_zerlegen(roh) if roh else None
            if prop:
                prop_zeilen.extend(_ics_roundtrip([prop]))
    ergebnis = [zeile for roh in list(zusatz) + prop_zeilen
                for zeile in _entfalte_zeilen(roh) if zeile]
    if len(ergebnis) > TB_ROUNDTRIP_ZEILEN_MAX:
        raise RuntimeError(_(
            "The Thunderbird calendar entry contains too many additional lines."))
    return ergebnis


def _tb_recurrence_ical(wert, tzid, ganztag=False):
    try:
        dt = datetime.fromtimestamp(int(wert) / 1000000.0, timezone.utc)
        if tzid not in ("", "UTC", "floating"):
            from zoneinfo import ZoneInfo
            dt = dt.astimezone(ZoneInfo(tzid))
        datum, zeit = dt.strftime("%Y-%m-%d"), dt.strftime("%H:%M")
    except (ImportError, KeyError, OSError, OverflowError, TypeError, ValueError):
        return ""
    if not datum:
        return ""
    if ganztag:
        return "RECURRENCE-ID;VALUE=DATE:%s" % datum.replace("-", "")
    kompakt = datum.replace("-", "") + ("T" + zeit.replace(":", "") + "00" if zeit else "")
    if tzid == "UTC":
        kompakt += "Z"
    parameter = ";TZID=" + tzid if tzid not in ("", "UTC", "floating") else ""
    return "RECURRENCE-ID%s:%s" % (parameter, kompakt)


def _tb_normalisierte_kalenderdaten(pfad):
    """Liest aktuelle Thunderbird-Tabellen cal_events und cal_todos.

    Thunderbird speichert die Kernfelder dort einzeln; nur ältere oder
    vereinfachte Ablagen enthalten einen vollständigen icalString.
    """
    ergebnis = {"termine": [], "jahrestage": [], "aufgaben": [],
                "wiederholend": 0, "uebersprungen": 0}
    verbindung, aufraeumen = _sqlite_kopie_oeffnen(pfad)
    if verbindung is None:
        return ergebnis
    try:
        verbindung.row_factory = sqlite3.Row
        zeiger = verbindung.cursor()
        try:
            tabellen = {z[0] for z in zeiger.execute(
                "SELECT name FROM sqlite_master WHERE type='table'")}
        except sqlite3.Error:
            return ergebnis

        eigenschaften = {}
        if "cal_properties" in tabellen:
            try:
                spalten = {z[1] for z in zeiger.execute(
                    'PRAGMA table_info("cal_properties")')}
                if {"item_id", "key", "value"}.issubset(spalten):
                    for zeile in zeiger.execute(
                            "SELECT * FROM cal_properties"):
                        wert = zeile["value"]
                        if isinstance(wert, bytes):
                            wert = _text_dekodieren(wert)
                        if isinstance(wert, str):
                            schluessel = _tb_speicherschluessel(zeile, spalten)
                            eigenschaften.setdefault(schluessel, {}).setdefault(
                                str(zeile["key"]).upper(), []).append(wert)
            except sqlite3.Error:
                pass

        parameter = {}
        if "cal_parameters" in tabellen:
            try:
                spalten = {z[1] for z in zeiger.execute(
                    'PRAGMA table_info("cal_parameters")')}
                if {"item_id", "key1", "key2", "value"}.issubset(spalten):
                    for zeile in zeiger.execute("SELECT * FROM cal_parameters"):
                        wert = zeile["value"]
                        if isinstance(wert, bytes):
                            wert = _text_dekodieren(wert)
                        if isinstance(wert, str):
                            schluessel = _tb_speicherschluessel(zeile, spalten)
                            parameter.setdefault(schluessel, {}).setdefault(
                                str(zeile["key1"]).upper(), []).append((
                                    str(zeile["key2"]).upper(), wert))
            except sqlite3.Error:
                pass

        zusatzdaten = {}
        for tabelle in ("cal_recurrence", "cal_alarms", "cal_attendees",
                        "cal_attachments", "cal_relations"):
            if tabelle not in tabellen:
                continue
            try:
                spalten = {z[1] for z in zeiger.execute(
                    'PRAGMA table_info("%s")' % tabelle)}
                if {"item_id", "icalString"}.issubset(spalten):
                    for zeile in zeiger.execute('SELECT * FROM "%s"' % tabelle):
                        wert = zeile["icalString"]
                        if isinstance(wert, bytes):
                            wert = _text_dekodieren(wert)
                        if not isinstance(wert, str):
                            continue
                        schluessel = _tb_speicherschluessel(zeile, spalten)
                        zusatzdaten.setdefault(schluessel, []).append(wert)
            except sqlite3.Error:
                pass

        if "cal_events" in tabellen:
            try:
                spalten = {z[1] for z in zeiger.execute(
                    'PRAGMA table_info("cal_events")')}
                benoetigt = {"id", "title", "event_start", "event_end"}
                if benoetigt.issubset(spalten) and "icalString" not in spalten:
                    for zeile in zeiger.execute("SELECT * FROM cal_events"):
                        flags = int(zeile["flags"] or 0) if "flags" in spalten else 0
                        ganztag = bool(flags & 8)
                        start_tz = zeile["event_start_tz"] if "event_start_tz" in spalten else ""
                        ende_tz = zeile["event_end_tz"] if "event_end_tz" in spalten else start_tz
                        datum, zeit = _tb_native_datumzeit(
                            zeile["event_start"], start_tz, ganztag)
                        e_datum, e_zeit = _tb_native_datumzeit(
                            zeile["event_end"], ende_tz, ganztag)
                        if not datum:
                            ergebnis["uebersprungen"] += 1
                            continue
                        end_datum = ""
                        if ganztag and e_datum > datum:
                            letzter = (datetime.strptime(e_datum, "%Y-%m-%d") -
                                       timedelta(days=1)).strftime("%Y-%m-%d")
                            end_datum = letzter if letzter > datum else ""
                        elif not ganztag and e_datum > datum:
                            end_datum = e_datum
                        cal_id = str(zeile["cal_id"] or "") \
                            if "cal_id" in spalten else ""
                        schluessel = _tb_speicherschluessel(zeile, spalten)
                        props = eigenschaften.get(schluessel, {})
                        zusatz = list(zusatzdaten.get(schluessel, []))
                        prop_parameter = parameter.get(schluessel, {})
                        prop = lambda name, standard="", props=props: (
                            props.get(name) or [standard])[0]
                        recurrence_id = (zeile["recurrence_id"]
                                         if "recurrence_id" in spalten else None)
                        recurrence_tz = (zeile["recurrence_id_tz"]
                                         if "recurrence_id_tz" in spalten else "")
                        recurrence_zeile = (_tb_recurrence_ical(
                            recurrence_id, recurrence_tz, bool(flags & 512))
                                            if recurrence_id is not None else "")
                        if recurrence_zeile:
                            zusatz.append(recurrence_zeile)
                        zusatz_zeilen = _tb_zusatzzeilen(
                            zusatz, props, prop_parameter)
                        wiederholung = None
                        ics_komplex = recurrence_id is not None
                        if flags & 16:
                            wiederholung, serie_komplex = _tb_wiederholung_lesen(
                                zusatzdaten.get(schluessel, []), datum, zeit,
                                bool(flags & 32) or recurrence_id is not None)
                            ics_komplex = ics_komplex or serie_komplex
                            if ics_komplex:
                                ergebnis["wiederholend"] += 1
                        status = str(zeile["ical_status"] or "").upper() \
                            if "ical_status" in spalten else ""
                        privat = str(zeile["privacy"] or "").upper() \
                            if "privacy" in spalten else ""
                        geaendert = int(zeile["last_modified"] or 0) // 1000 \
                            if "last_modified" in spalten else 0
                        titel = str(zeile["title"] or _("Untitled appointment"))
                        kategorien = _ical_unescape(prop("CATEGORIES"))
                        typ_feld = jahrestag_typ_id(prop("X-MAGNOLIE-TYPE-ID"))
                        jahrestag_markiert, jahrestag_typ = _jahrestag_aus_ereignis(
                            titel, kategorien, typ_feld)
                        if (ganztag and not end_datum and jahrestag_markiert and
                                (not (flags & 16) or (wiederholung and
                                 wiederholung["art"] == "yearly" and
                                 not wiederholung["bis"]))):
                            ergebnis["jahrestage"].append({
                                "name": titel, "datum": datum, "typ": jahrestag_typ,
                                "uid": str(zeile["id"] or ""),
                                "geaendert": geaendert})
                            continue
                        uid = str(zeile["id"] or "")
                        if recurrence_id is not None:
                            uid += "-magnolie-instanz-" + _text_sha256(
                                "%s|%s" % (recurrence_id, recurrence_tz))[:16]
                        ergebnis["termine"].append({
                            "datum": datum, "endDatum": end_datum,
                            "zeit": zeit, "endZeit": e_zeit if not ganztag else "",
                             "titel": titel,
                            "notiz": _ical_unescape(prop("DESCRIPTION")),
                            "kategorien": kategorien,
                            "vertraulich": privat in ("PRIVATE", "CONFIDENTIAL"),
                            "vorlaeufig": status == "TENTATIVE",
                            "kostenstelle": prop("X-MAGNOLIE-KOSTENSTELLE"),
                            "kunde": prop("X-MAGNOLIE-KUNDE"),
                            "wiederholung": wiederholung or {"art": "none", "bis": ""},
                            "icsKomplex": ics_komplex,
                            "icsSerienUid": str(zeile["id"] or "") if ics_komplex else "",
                            "icsRoundtrip": zusatz_zeilen,
                            "icsQuelleName": "Thunderbird: " + cal_id,
                            "icsQuelleId": "thunderbird:" + cal_id,
                            "uid": uid, "geaendert": geaendert})
            except (sqlite3.Error, TypeError, ValueError):
                pass

        if "cal_todos" in tabellen:
            try:
                spalten = {z[1] for z in zeiger.execute(
                    'PRAGMA table_info("cal_todos")')}
                if {"id", "title"}.issubset(spalten) and "icalString" not in spalten:
                    for zeile in zeiger.execute("SELECT * FROM cal_todos"):
                        faellig = ""
                        if "todo_due" in spalten and zeile["todo_due"] is not None:
                            tzid = zeile["todo_due_tz"] if "todo_due_tz" in spalten else ""
                            faellig, _zeit = _tb_native_datumzeit(
                                zeile["todo_due"], tzid, False)
                        cal_id = str(zeile["cal_id"] or "") \
                            if "cal_id" in spalten else ""
                        schluessel = _tb_speicherschluessel(zeile, spalten)
                        props = eigenschaften.get(schluessel, {})
                        prop = lambda name, standard="", props=props: (
                            props.get(name) or [standard])[0]
                        zusatz_zeilen = _tb_zusatzzeilen(
                            zusatzdaten.get(schluessel, []), props,
                            parameter.get(schluessel, {}))
                        try:
                            roh_prio = int(zeile["priority"] or 0) \
                                if "priority" in spalten else 0
                        except (TypeError, ValueError):
                            roh_prio = 0
                        prio = 1 if 1 <= roh_prio <= 3 else (3 if roh_prio >= 7 else 2)
                        status = str(zeile["ical_status"] or "").upper() \
                            if "ical_status" in spalten else ""
                        prozent_feld = ("percent_complete" if "percent_complete" in spalten
                                        else "todo_complete" if "todo_complete" in spalten
                                        else "")
                        prozent = int(zeile[prozent_feld] or 0) if prozent_feld else 0
                        ergebnis["aufgaben"].append({
                            "titel": str(zeile["title"] or _("Untitled")),
                            "faellig": faellig, "prio": prio,
                            "erledigt": status == "COMPLETED" or prozent >= 100,
                            "notiz": _ical_unescape(prop("DESCRIPTION")),
                            "uid": str(zeile["id"] or ""),
                            "icsRoundtrip": zusatz_zeilen,
                            "icsQuelleName": "Thunderbird: " + cal_id,
                            "icsQuelleId": "thunderbird:" + cal_id,
                            "geaendert": (int(zeile["last_modified"] or 0) // 1000
                                          if "last_modified" in spalten else 0)})
            except (sqlite3.Error, TypeError, ValueError):
                pass
    finally:
        try:
            verbindung.close()
        finally:
            aufraeumen()
    return ergebnis


def _unterdateien(wurzel, dateiname):
    """Liefert wurzel/*/dateiname für alle vorhandenen Unterordner."""
    treffer = []
    if os.path.isdir(wurzel):
        try:
            eintraege = sorted(os.listdir(wurzel))
        except OSError:
            eintraege = []
        for name in eintraege:
            pfad = os.path.join(wurzel, name, dateiname)
            if os.path.isfile(pfad):
                treffer.append(pfad)
    return treffer


def _evolution_wurzeln(basis, was):
    """Ablageorte der Evolution-Daten (regulär und Flatpak) für
    'addressbook', 'calendar' oder 'tasks'."""
    return [
        os.path.join(basis, ".local/share/evolution", was),
        os.path.join(basis, ".cache/evolution", was),
        os.path.join(basis, ".var/app/org.gnome.Evolution/data/evolution", was),
        os.path.join(basis, ".var/app/org.gnome.Evolution/cache/evolution", was),
    ]


def _thunderbird_profile(basis):
    profile = []
    for wurzel in (os.path.join(basis, ".thunderbird"),
                   os.path.join(basis, ".var/app/org.mozilla.Thunderbird/.thunderbird"),
                   os.path.join(basis, "snap/thunderbird/common/.thunderbird")):
        if not os.path.isdir(wurzel):
            continue
        try:
            eintraege = sorted(os.listdir(wurzel))
        except OSError:
            continue
        for name in eintraege:
            pfad = os.path.join(wurzel, name)
            if os.path.isdir(pfad):
                profile.append(pfad)
    return profile


def _zaehl_satz(name, adressen, termine, aufgaben):
    stuecke = []
    if adressen:
        stuecke.append(ngettext("%d contact", "%d contacts", adressen) % adressen)
    if termine:
        stuecke.append(ngettext(
            "%d appointment", "%d appointments", termine) % termine)
    if aufgaben:
        stuecke.append(ngettext("%d task", "%d tasks", aufgaben) % aufgaben)
    return name + ": " + ", ".join(stuecke) if stuecke else ""


def _nur_lesen_text():
    text = _("Show selected notifications (read only)")
    treffer = re.search(r"\(([^()]*)\)\s*$", text)
    return treffer.group(1) if treffer else "read only"


def lokal_scannen(basis=None):
    """Durchsucht die lokalen Ablagen von Evolution und Thunderbird nach
    Adressen, Terminen und Aufgaben und liefert eine Import-Nutzlast."""
    basis = basis or os.path.expanduser("~")
    ICS_ANFAENGE = ("BEGIN:VCALENDAR", "BEGIN:VEVENT", "BEGIN:VTODO")
    nutzlast = {"kontakte": [], "geburtstage": [], "termine": [],
                "jahrestage": [], "aufgaben": [],
                "uebersprungen": 0, "wiederholend": 0}

    def uebernehmen(erg):
        zaehler = [0, 0, 0]
        for schluessel in ("kontakte", "geburtstage", "termine",
                           "jahrestage", "aufgaben"):
            nutzlast[schluessel].extend(erg.get(schluessel) or [])
        nutzlast["uebersprungen"] += erg.get("uebersprungen") or 0
        nutzlast["wiederholend"] += erg.get("wiederholend") or 0
        zaehler[0] = len(erg.get("kontakte") or [])
        zaehler[1] = len(erg.get("termine") or [])
        zaehler[2] = len(erg.get("aufgaben") or [])
        return zaehler

    bericht = []

    # ---- Evolution: Adressbücher (lokale Ablage und Konten-Zwischenspeicher)
    ev = [0, 0, 0]
    for wurzel in _evolution_wurzeln(basis, "addressbook"):
        for dateiname in ("contacts.db", "cache.db"):
            for pfad in _unterdateien(wurzel, dateiname):
                texte = _texte_aus_sqlite(pfad, ("BEGIN:VCARD",))
                if texte:
                    z = uebernehmen(vcf_lesen("\n".join(texte), lokale_dateien=True))
                    ev = [a + b for a, b in zip(ev, z)]

    # ---- Evolution: Kalender und Aufgaben
    for was, dateien in (("calendar", ("calendar.ics", "cache.db")),
                         ("tasks", ("tasks.ics", "cache.db"))):
        for wurzel in _evolution_wurzeln(basis, was):
            for dateiname in dateien:
                for pfad in _unterdateien(wurzel, dateiname):
                    if dateiname.endswith(".ics"):
                        try:
                            text = _text_dekodieren(datei_begrenzt_lesen(
                                pfad, IMPORT_DATEI_MAX,
                                _("The import file is larger than 32 megabytes.")))
                        except (OSError, GroessenFehler):
                            continue
                    else:
                        texte = _texte_aus_sqlite(pfad, ICS_ANFAENGE)
                        text = "\n".join(texte)
                    if text.strip():
                        ordnername = os.path.basename(os.path.dirname(pfad))
                        z = uebernehmen(ics_lesen(
                            text, "Evolution: " + ordnername,
                            "evolution:" + os.path.realpath(pfad)))
                        ev = [a + b for a, b in zip(ev, z)]
    satz = _zaehl_satz("Evolution", *ev)
    if satz:
        bericht.append(satz)

    # ---- Thunderbird: Adressbücher und Kalender
    tb = [0, 0, 0]
    for profil in _thunderbird_profile(basis):
        try:
            dateien = sorted(os.listdir(profil))
        except OSError:
            dateien = []
        for name in dateien:
            if name.startswith("abook") and name.endswith(".sqlite"):
                vcards = _tb_karten_vcards(os.path.join(profil, name))
                if vcards:
                    z = uebernehmen(vcf_lesen("".join(vcards), lokale_dateien=True))
                    tb = [a + b for a, b in zip(tb, z)]
        kalender = os.path.join(profil, "calendar-data", "local.sqlite")
        texte = _texte_aus_sqlite(kalender, ICS_ANFAENGE)
        if texte:
            z = uebernehmen(ics_lesen(
                "\n".join(texte), "Thunderbird",
                "thunderbird:" + os.path.realpath(kalender)))
            tb = [a + b for a, b in zip(tb, z)]
        else:
            z = uebernehmen(_tb_normalisierte_kalenderdaten(kalender))
            tb = [a + b for a, b in zip(tb, z)]
    satz = _zaehl_satz("Thunderbird", *tb)
    if satz:
        bericht.append(satz)

    _lokale_kalender_dubletten_bereinigen(nutzlast)
    nutzlast["bericht"] = (_("Found – %s.") % "; ".join(bericht)) if bericht \
        else _("No readable Evolution or Thunderbird stores were found on this computer.")
    return nutzlast


# ---------------------------------------------------------------------------
# Evolution-Data-Server (Online-Konten)
# ---------------------------------------------------------------------------

def nextcloud_einstellungsdatei():
    return os.path.join(konfigurations_verzeichnis(), "nextcloud.json")


def nextcloud_speicher():
    return NextcloudSettingsStore(nextcloud_einstellungsdatei())


def nextcloud_fehlertext(fehler):
    code = nextcloud_fehlercode(fehler)
    texte = {
        "secret_service_unavailable": _(
            "The Linux Secret Service is unavailable. The app password was not stored."),
        "secret_store_failed": _(
            "The Linux Secret Service did not store the app password."),
        "app_password_missing": _("The Nextcloud app password is missing."),
        "invalid_config": _("The Nextcloud settings are invalid."),
        "not_configured": _("Nextcloud is not configured."),
        "not_active": _("Nextcloud is not enabled."),
        "timeout": _("The Nextcloud request timed out."),
        "incomplete_response": _("The Nextcloud response was incomplete."),
        "partial_multistatus": _("Nextcloud returned an incomplete DAV result."),
        "http_301": _("Nextcloud returned a redirect that was not followed."),
        "http_302": _("Nextcloud returned a redirect that was not followed."),
        "http_303": _("Nextcloud returned a redirect that was not followed."),
        "http_307": _("Nextcloud returned a redirect that was not followed."),
        "http_308": _("Nextcloud returned a redirect that was not followed."),
        "http_401": _("Nextcloud rejected the credentials."),
        "http_403": _("Nextcloud denied access to this DAV resource."),
        "http_404": _("The requested Nextcloud DAV resource was not found."),
        "http_405": _("Nextcloud does not allow this DAV operation."),
        "http_412": _("The DAV entry was changed concurrently."),
        "http_507": _("Nextcloud has insufficient storage for this operation."),
    }
    return texte.get(code, _("The Nextcloud operation failed."))


def nextcloud_status(transport=None, discover=True):
    """Liefert DAV-Quellen, ohne Kennwort oder Authorization offenzulegen."""
    store = nextcloud_speicher()
    result = {"verfuegbar": True, "aktiv": False, "davAktiv": False,
              "briefkastenAktiv": False, "server": "", "url": "",
              "benutzer": "",
              "kennwortVorhanden": False, "zustand": "nicht_eingerichtet",
              "fehler": "", "fehlerCode": "none", "kalender": [],
              "adressbuecher": []}
    try:
        settings = store.load()
        if not settings:
            return result
        result.update(aktiv=settings["briefkastenAktiv"],
                      davAktiv=settings["davAktiv"],
                      briefkastenAktiv=settings["briefkastenAktiv"],
                      server=settings["server"],
                      url=settings["server"],
                      benutzer=settings["benutzer"])
        result["kennwortVorhanden"] = store.has_password(settings)
        active = settings["davAktiv"] if discover else (
            settings["davAktiv"] or settings["briefkastenAktiv"])
        if not active:
            result["zustand"] = "aus"
            return result
        if not result["kennwortVorhanden"]:
            result["zustand"] = "unvollstaendig"
            return result
        if not discover:
            result["zustand"] = "bereit"
            return result
        dav = NextcloudDav(configured_client(store, transport))
        result["kalender"] = dav.collections("calendar")
        result["adressbuecher"] = dav.collections("addressbook")
        result["zustand"] = "bereit"
    except Exception as fehler:
        result["zustand"] = "fehler"
        result["fehler"] = nextcloud_fehlertext(fehler)
        result["fehlerCode"] = nextcloud_fehlercode(fehler)
    return result


def _nextcloud_quelle(dav, art, uid):
    for quelle in dav.collections(art):
        if quelle["uid"] == uid:
            return quelle
    raise RuntimeError(_("The selected Nextcloud DAV source was not found."))


def _dav_uid_dateiname(uid, endung):
    return hashlib.sha256(str(uid).encode("utf-8")).hexdigest() + endung


_EDS = {"geprueft": False, "ok": False, "buch_ok": False, "fehler": ""}

EDS_PAKETE = "gir1.2-ecal-2.0 gir1.2-ebook-1.2 gir1.2-edataserver-1.2"


def eds_laden():
    """Lädt die Evolution-Bibliotheken bei Bedarf. Liefert True/False."""
    if _EDS["geprueft"]:
        return _EDS["ok"]
    _EDS["geprueft"] = True
    if not GTK_OK:
        _EDS["fehler"] = _("GTK is not available")
        return False
    try:
        gi.require_version("EDataServer", "1.2")
        gi.require_version("ECal", "2.0")
        gi.require_version("ICalGLib", "3.0")
        from gi.repository import EDataServer, ECal, ICalGLib
        _EDS.update(EDataServer=EDataServer, ECal=ECal, ICalGLib=ICalGLib)
        _EDS["ok"] = True
    except Exception as fehler:
        _EDS["fehler"] = str(fehler)
        return False
    try:
        gi.require_version("EBook", "1.2")
        gi.require_version("EBookContacts", "1.2")
        from gi.repository import EBook, EBookContacts
        _EDS.update(EBook=EBook, EBookContacts=EBookContacts)
        _EDS["buch_ok"] = True
    except Exception:
        _EDS["buch_ok"] = False
    return True


def eds_registry():
    return _EDS["EDataServer"].SourceRegistry.new_sync(None)


def eds_quellen(registry):
    """Listet Kalender und Adressbücher der Online-Konten auf."""
    ES = _EDS["EDataServer"]

    def liste(erweiterung):
        aus = []
        for quelle in registry.list_sources(erweiterung):
            try:
                if not quelle.get_enabled():
                    continue
                name = _eds_quellenname(registry, quelle)
                aus.append({"uid": quelle.get_uid(), "name": name})
            except Exception:
                continue
        aus.sort(key=lambda eintrag: eintrag["name"].lower())
        return aus

    kalender = liste(ES.SOURCE_EXTENSION_CALENDAR)
    buecher = liste(ES.SOURCE_EXTENSION_ADDRESS_BOOK) if _EDS["buch_ok"] else []
    return kalender, buecher


def _eds_quellenname(registry, quelle):
    """Liefert den sichtbaren Konten- und Kalendernamen einer EDS-Quelle."""
    name = quelle.get_display_name() or "?"
    try:
        eltern_uid = quelle.get_parent()
        eltern = registry.ref_source(eltern_uid) if eltern_uid else None
        eltern_name = (eltern.get_display_name() or "") if eltern else ""
    except Exception:
        eltern_name = ""
    if eltern_name and eltern_name != name:
        return eltern_name + " · " + name
    return name


def fehler_deutsch(fehler, worum=None):
    """Fasst eine Ausnahme verständlich zusammen; eigene RuntimeError-Texte
    gehen unverändert durch."""
    if isinstance(fehler, RuntimeError):
        return str(fehler)
    worum = worum or _("Connecting to the online accounts")
    technik = str(fehler).strip() or fehler.__class__.__name__
    return _("%s reported an unexpected error (technical detail: %s).") % (
        worum, technik)


def _quelle(registry, quellen_uid):
    """Findet eine Quelle über ihre Kennung – robust gegenüber den
    unterschiedlichen Methodennamen der EDS-Fassungen: erst ref_source
    (der übliche Weg), dann lookup_by_uid (ältere Hüllen), zuletzt die
    vollständige Quellenliste."""
    for methodenname in ("ref_source", "lookup_by_uid"):
        finden = getattr(registry, methodenname, None)
        if finden is None:
            continue
        try:
            q = finden(quellen_uid)
        except (TypeError, AttributeError):
            continue
        if q:
            return q
    try:
        quellen = registry.list_sources(None)
    except TypeError:
        try:
            quellen = registry.list_sources()
        except Exception:
            quellen = []
    except Exception:
        quellen = []
    for q in quellen or []:
        try:
            if q.get_uid() == quellen_uid:
                return q
        except Exception:
            continue
    raise RuntimeError(_("The selected source was not found. Select it again in Settings."))


def eds_kalender_client(registry, quellen_uid):
    ECal = _EDS["ECal"]
    q = _quelle(registry, quellen_uid)
    try:
        return ECal.Client.connect_sync(q, ECal.ClientSourceType.EVENTS, 20, None)
    except TypeError:
        return ECal.Client.connect_sync(q, ECal.ClientSourceType.EVENTS, None)


def eds_events_lesen(client):
    """Liefert nur einen nachweislich vollständigen Kalender-Snapshot."""
    try:
        ergebnis = client.get_object_list_sync("#t", None)
    except (AttributeError, TypeError):
        try:
            ergebnis = client.get_object_list_as_comps_sync("#t", None)
        except Exception as fehler:
            raise RuntimeError(_("The calendar could not be read: %s") % fehler) from fehler
    except Exception as fehler:
        raise RuntimeError(_("The calendar could not be read: %s") % fehler) from fehler
    if isinstance(ergebnis, tuple):
        if len(ergebnis) < 2 or ergebnis[0] is not True:
            raise RuntimeError(_("The calendar backend reported an incomplete result."))
        liste = ergebnis[-1] or []
    else:
        liste = ergebnis or []
    texte = []
    for nummer, eintrag in enumerate(liste, 1):
        try:
            text = eintrag.as_ical_string()
        except AttributeError:
            try:
                text = eintrag.get_icalcomponent().as_ical_string()
            except Exception as fehler:
                raise RuntimeError(_(
                    "Calendar entry %(number)d could not be read completely: %(error)s") % {
                        "number": nummer, "error": fehler}) from fehler
        except Exception as fehler:
            raise RuntimeError(_(
                "Calendar entry %(number)d could not be read completely: %(error)s") % {
                    "number": nummer, "error": fehler}) from fehler
        if not isinstance(text, str) or not text.strip():
            raise RuntimeError(_(
                "Calendar entry %d was empty. Synchronization was stopped.") % nummer)
        texte.append(text)
    return texte


def eds_event_fehlend_bestaetigt(client, uid_wert):
    """Bestätigt eine Fernlöschung unabhängig vom vollständigen Listenabruf."""
    lesen = getattr(client, "get_objects_for_uid_sync", None)
    if lesen is None:
        raise RuntimeError(_(
            "A missing appointment could not be verified. Synchronization was stopped."))
    try:
        ergebnis = lesen(uid_wert, None)
    except Exception as fehler:
        raise RuntimeError(_(
            "A missing appointment could not be verified: %s") % fehler) from fehler
    if isinstance(ergebnis, tuple):
        if len(ergebnis) < 2 or ergebnis[0] is not True:
            raise RuntimeError(_(
                "The calendar backend could not verify a missing appointment."))
        liste = ergebnis[-1] or []
    else:
        liste = ergebnis or []
    return not bool(liste)


def _icomp_aus_text(text):
    ICalGLib = _EDS["ICalGLib"]
    art = ICalGLib.ComponentKind.VEVENT_COMPONENT
    comp = ICalGLib.Component.new_from_string(text)
    try:
        if comp is not None and comp.isa() == art:
            return comp
    except Exception:
        pass
    huelle = ICalGLib.Component.new_from_string(
        "BEGIN:VCALENDAR\r\nVERSION:2.0\r\n" + text + "END:VCALENDAR\r\n")
    if huelle is not None:
        innen = huelle.get_first_component(art)
        if innen is not None:
            return innen
    return comp


def eds_event_anlegen(client, text):
    ECal = _EDS["ECal"]
    comp = _icomp_aus_text(text)
    if comp is None:
        raise RuntimeError(_("Appointment could not be read"))
    try:
        ergebnis = client.create_object_sync(comp, ECal.OperationFlags.NONE, None)
    except TypeError:
        ergebnis = client.create_object_sync(comp, None)
    if isinstance(ergebnis, tuple):
        return ergebnis[-1] if ergebnis[0] else None
    return ergebnis


def eds_event_aendern(client, text):
    ECal = _EDS["ECal"]
    comp = _icomp_aus_text(text)
    if comp is None:
        raise RuntimeError(_("Appointment could not be read"))
    try:
        client.modify_object_sync(comp, ECal.ObjModType.ALL,
                                  ECal.OperationFlags.NONE, None)
    except TypeError:
        client.modify_object_sync(comp, ECal.ObjModType.ALL, None)


def eds_event_loeschen(client, uid_wert):
    ECal = _EDS["ECal"]
    try:
        client.remove_object_sync(uid_wert, None, ECal.ObjModType.ALL,
                                  ECal.OperationFlags.NONE, None)
    except TypeError:
        client.remove_object_sync(uid_wert, None, ECal.ObjModType.ALL, None)


def eds_buch_client(registry, quellen_uid):
    EBook = _EDS["EBook"]
    q = _quelle(registry, quellen_uid)
    try:
        return EBook.BookClient.connect_sync(q, 20, None)
    except TypeError:
        return EBook.BookClient.connect_sync(q, None)


def _vcard_format():
    EBookContacts = _EDS["EBookContacts"]
    fmt = getattr(EBookContacts, "VCardFormat", None)
    if fmt is None:
        return 1
    for name in ("VCARD_30", "FORMAT_VCARD_30", "30"):
        wert = getattr(fmt, name, None)
        if wert is not None:
            return wert
    return 1


def _buch_flags():
    fl = getattr(_EDS.get("EBook"), "OperationFlags", None)
    return fl.NONE if fl is not None else 0


def _eds_feldwerte(kontakt, namen):
    """Liest EContact-Felder über mehrere EDS-/GI-Fassungen hinweg."""
    ec = _EDS.get("EBookContacts")
    felder = getattr(ec, "ContactField", None) if ec is not None else None
    ergebnis = []
    for name in namen:
        feld = getattr(felder, name, None) if felder is not None else None
        if feld is None:
            continue
        try:
            wert = kontakt.get(feld)
        except Exception:
            continue
        if isinstance(wert, (list, tuple)):
            ergebnis.extend(wert)
        elif wert is not None:
            ergebnis.append(wert)
    return ergebnis


def _eds_attribute_werte(kontakt, feldname):
    """Liest wiederholte EContact-Felder typisiert statt als gpointer."""
    ec = _EDS.get("EBookContacts")
    felder = getattr(ec, "ContactField", None) if ec is not None else None
    feld = getattr(felder, feldname, None) if felder is not None else None
    if feld is None or not hasattr(kontakt, "get_attributes"):
        return []
    try:
        attribute = kontakt.get_attributes(feld) or []
    except Exception:
        return []
    ergebnis = []
    for attribut in attribute:
        try:
            werte = list(attribut.get_values() or [])
        except Exception:
            continue
        typen = []
        try:
            for parameter in attribut.get_params() or []:
                if str(parameter.get_name() or "").upper() == "TYPE":
                    typen.extend(parameter.get_values() or [])
        except Exception:
            pass
        for wert in werte:
            ergebnis.append({"wert": wert, "typen": _telefon_typen(typen)})
    return ergebnis


def _bilddatenadresse(roh, mime=""):
    """Verpackt Bildbytes begrenzt als Datenadresse."""
    if hasattr(roh, "get_data") and not isinstance(roh, (bytes, bytearray)):
        try:
            roh = roh.get_data()
        except Exception:
            return ""
    if isinstance(roh, tuple):
        for teil in roh:
            foto = _bilddatenadresse(teil, mime)
            if foto:
                return foto
        return ""
    if isinstance(roh, memoryview):
        roh = roh.tobytes()
    if not isinstance(roh, (bytes, bytearray)):
        return ""
    roh = bytes(roh)
    if not roh or len(roh) > 2700000:
        return ""
    art = str(mime or "").lower().split("/")[-1]
    if art == "jpg":
        art = "jpeg"
    if roh.startswith(b"\xff\xd8\xff"):
        art = "jpeg"
    elif roh.startswith(b"\x89PNG\r\n\x1a\n"):
        art = "png"
    elif roh.startswith((b"GIF87a", b"GIF89a")):
        art = "gif"
    elif len(roh) >= 12 and roh[:4] == b"RIFF" and roh[8:12] == b"WEBP":
        art = "webp"
    if art not in ("jpeg", "png", "gif", "webp"):
        return ""
    return "data:image/%s;base64,%s" % (
        art, base64.b64encode(roh).decode("ascii"))


def _eds_foto_dataadresse(kontakt):
    """Holt ein EDS-Foto auch dann, wenn es in der vCard-Ausgabe fehlt."""
    kandidaten = _eds_feldwerte(kontakt, ("PHOTO",))
    for zugriff in (
            lambda: kontakt.get_property("photo"),
            lambda: kontakt.props.photo):
        try:
            wert = zugriff()
            if wert is not None:
                kandidaten.append(wert)
        except Exception:
            pass

    gesehen = set()

    def untersuche(wert, tiefe=0, mime=""):
        if wert is None or tiefe > 3:
            return ""
        nummer = id(wert)
        if nummer in gesehen:
            return ""
        gesehen.add(nummer)
        if isinstance(wert, str):
            return _vcard_foto(wert, {"MEDIATYPE": mime}, True)
        foto = _bilddatenadresse(wert, mime)
        if foto:
            return foto
        if isinstance(wert, (list, tuple)):
            for teil in wert:
                foto = untersuche(teil, tiefe + 1, mime)
                if foto:
                    return foto
            return ""
        mime_neu = mime
        for name in ("get_mime_type", "mime_type", "mime", "content_type"):
            try:
                probe = getattr(wert, name)
                probe = probe() if callable(probe) else probe
                if probe:
                    mime_neu = str(probe)
                    break
            except Exception:
                pass
        for name in ("get_uri", "get_data", "get_inlined", "get_bytes",
                     "uri", "data", "inlined", "bytes"):
            try:
                probe = getattr(wert, name)
                probe = probe() if callable(probe) else probe
            except Exception:
                continue
            foto = untersuche(probe, tiefe + 1, mime_neu)
            if foto:
                return foto
        return ""

    for kandidat in kandidaten:
        foto = untersuche(kandidat)
        if foto:
            return foto
    return ""


def _eds_vcard_ergaenzen(kontakt, text):
    """Ergänzt Listenfelder und Foto aus den strukturierten EDS-Feldern."""
    text = str(text or "")
    vorhandene = []
    vorhandene_telefone = set()
    hat_foto = False
    for zeile in _entfalte_zeilen(text):
        zerlegt = _prop_zerlegen(zeile)
        if not zerlegt:
            continue
        name, params, wert = zerlegt
        if name == "EMAIL":
            adresse = _email_adresse(_ical_unescape(_vcard_wert(wert, params)))
            if adresse:
                vorhandene.append(adresse.lower())
        elif name == "TEL":
            nummer = _ical_unescape(_vcard_wert(wert, params)).strip()
            if nummer:
                vorhandene_telefone.add(_telefon_schluessel(nummer) or nummer)
        elif name == "PHOTO" and _vcard_foto(wert, params, True):
            hat_foto = True

    zusaetze = []
    email_attribute = _eds_attribute_werte(kontakt, "EMAIL")
    if email_attribute:
        email_werte = [eintrag["wert"] for eintrag in email_attribute]
    else:
        email_werte = []
        for wert in _eds_feldwerte(
                kontakt, ("EMAIL", "EMAIL_1", "EMAIL_2", "EMAIL_3", "EMAIL_4")):
            email_werte.extend(wert if isinstance(wert, (list, tuple)) else [wert])
    for email_wert in email_werte:
        email = _email_adresse(email_wert)
        if email and email.lower() not in vorhandene:
            zusaetze.append("EMAIL;TYPE=INTERNET:" + _vcard_escape(email))
            vorhandene.append(email.lower())

    telefon_attribute = _eds_attribute_werte(kontakt, "TEL")
    if telefon_attribute:
        telefon_werte = telefon_attribute
    else:
        telefon_werte = []
        for feldnamen, typen in (
                (("PHONE_HOME", "PHONE_HOME_1", "PHONE_HOME_2"), ["HOME", "VOICE"]),
                (("PHONE_BUSINESS", "PHONE_BUSINESS_1", "PHONE_BUSINESS_2"), ["WORK", "VOICE"]),
                (("PHONE_MOBILE",), ["CELL"]), (("PHONE_HOME_FAX",), ["HOME", "FAX"]),
                (("PHONE_BUSINESS_FAX",), ["WORK", "FAX"]),
                (("PHONE_PAGER",), ["PAGER"]), (("PHONE_OTHER",), ["VOICE"])):
            for nummer in _eds_feldwerte(kontakt, feldnamen):
                for einzel in nummer if isinstance(nummer, (list, tuple)) else [nummer]:
                    telefon_werte.append({"wert": einzel, "typen": typen})
    for telefon in telefon_werte:
        einzel = telefon.get("wert")
        typen = _telefon_typen(telefon.get("typen") or [])
        if _ist_eds_zeigerwert(einzel):
            continue
        einzel = str(einzel or "").strip()
        schluessel = _telefon_schluessel(einzel) or einzel
        if einzel and schluessel not in vorhandene_telefone:
            zusaetze.append("TEL;TYPE=%s:%s" %
                            (",".join(typen or ["VOICE"]), _vcard_escape(einzel)))
            vorhandene_telefone.add(schluessel)

    if not hat_foto:
        foto = _eds_foto_dataadresse(kontakt)
        treffer = re.match(r"^data:image/([^;]+);base64,(.+)$", foto, re.I)
        if treffer:
            art = treffer.group(1).lower()
            art = "JPEG" if art in ("jpg", "jpeg") else art.upper()
            zusaetze.append("PHOTO;ENCODING=b;TYPE=%s:%s" %
                            (art, treffer.group(2)))
    if not zusaetze:
        return text
    einfuegung = "\r\n".join(_falte(zeile) for zeile in zusaetze) + "\r\n"
    return re.sub(r"END:VCARD\s*$",
                  lambda _treffer: einfuegung + "END:VCARD\r\n",
                  text.strip(), flags=re.I)


def eds_kontakte_lesen(client):
    """Liest und prüft einen vollständigen Adressbuch-Snapshot."""
    abfrage = '(contains "x-evolution-any-field" "")'
    try:
        ergebnis = client.get_contacts_sync(abfrage, None)
    except Exception as fehler:
        raise RuntimeError(_("The address book could not be read: %s") % fehler)
    if isinstance(ergebnis, tuple):
        if not ergebnis or not ergebnis[0]:
            raise RuntimeError(_("The address book backend reported an incomplete read."))
        liste = ergebnis[-1] or []
    else:
        liste = ergebnis or []
    fmt = _vcard_format()
    aus = {"remoteGesamt": len(liste), "serialisiert": 0, "geparst": 0,
           "gueltigeUids": 0, "fehler": [], "vollstaendig": True,
           "texte": [], "kontakte": [], "geburtstage": []}
    uids = set()
    for nummer, kontakt in enumerate(liste, 1):
        # Gnome-Kontakte/Evolution speichern Fotos häufig nur als Verweis
        # auf eine lokale Bilddatei. EDS kann diese Verweise vor der
        # vCard-Ausgabe in echte, übertragbare Bilddaten umwandeln.
        try:
            kontakt.inline_local_photos()
        except (AttributeError, TypeError):
            try:
                kontakt.inline_local_photos(None)
            except Exception:
                pass
        except Exception:
            pass
        try:
            text = kontakt.to_string(fmt)
        except Exception as fehler:
            aus["fehler"].append(_("Contact %d could not be serialized: %s") %
                                  (nummer, fehler))
            continue
        # Manche EDS-Ausgaben lassen Listenfelder oder ein Bild trotz
        # vorhandener strukturierter Kontaktfelder weg. Ergänzen Sie beides
        # ausdrücklich, damit Gnome-Kontakte verlustfrei ankommt.
        text = _eds_vcard_ergaenzen(kontakt, text)
        aus["serialisiert"] += 1
        try:
            gelesen = vcf_lesen(text)
        except Exception as fehler:
            aus["fehler"].append(_("Contact %d contains an unreadable vCard: %s") %
                                  (nummer, fehler))
            continue
        if len(gelesen["kontakte"]) != 1 or gelesen.get("uebersprungen"):
            aus["fehler"].append(_("Contact %d contains an unreadable vCard.") % nummer)
            continue
        aus["geparst"] += 1
        obj = gelesen["kontakte"][0]
        uid_wert = str(obj.get("uid") or "").strip()
        if not uid_wert:
            aus["fehler"].append(_("Contact %d has no UID.") % nummer)
            continue
        if uid_wert in uids:
            aus["fehler"].append(_("The address book contains the UID %s more than once.") %
                                  uid_wert)
            continue
        uids.add(uid_wert)
        aus["gueltigeUids"] += 1
        aus["texte"].append(text)
        aus["kontakte"].append(obj)
        aus["geburtstage"].extend(gelesen["geburtstage"])
    aus["vollstaendig"] = not aus["fehler"] and (
        aus["remoteGesamt"] == aus["serialisiert"] == aus["geparst"] ==
        aus["gueltigeUids"])
    return aus


def kontakt_snapshot_hash(kontakte):
    """Bindet eine Baseline reproduzierbar an UID und gelesenen Inhalt."""
    inhalt = [{feld: kontakt.get(feld) for feld in ("uid", "geaendert") +
               tuple(KONTAKT_FELDER) + ("vcardRoundtrip", "vcardParameter")}
              for kontakt in sorted(kontakte, key=lambda k: str(k.get("uid") or ""))]
    return hashlib.sha256(json.dumps(
        inhalt, ensure_ascii=False, sort_keys=True,
        separators=(",", ":")).encode("utf-8")).hexdigest()


def kontakte_erster_sync(lokal, entfernt):
    """Additiver Erstimport ohne lokale oder entfernte Löschungen/Schreibvorgänge."""
    kontakte_vor_sync_zuordnen(lokal, entfernt)
    vorher = {id(obj): json.dumps(obj, ensure_ascii=False, sort_keys=True)
              for obj in lokal}
    ergebnis = []
    gesehen = set()
    geaendert = 0
    for obj in lokal:
        uid_wert = obj.get("uid")
        fern = entfernt.get(uid_wert)
        if fern is None:
            # Eine alte Bindung kann zu einer anderen EDS-Quelle gehören.
            # In der neuen Baseline ist dieser Kontakt lokal und wird später
            # hochgeladen, niemals als bestätigte Remote-Löschung behandelt.
            obj["sync"] = False
            ergebnis.append(obj)
            continue
        zusammen, _anlegen, _aendern, _loeschen, _zaehler = sync_merge(
            [obj], {uid_wert: fern}, [], 0, KONTAKT_FELDER)
        ergebnis.extend(zusammen)
        gesehen.add(uid_wert)
        if json.dumps(zusammen[0], ensure_ascii=False, sort_keys=True) != vorher[id(obj)]:
            geaendert += 1
    neu = 0
    for uid_wert, fern in entfernt.items():
        if uid_wert in gesehen:
            continue
        obj = dict(fern)
        obj["sync"] = True
        ergebnis.append(obj)
        neu += 1
    return ergebnis, {"lokalNeu": neu, "lokalAktualisiert": geaendert,
                      "remoteAnlegen": 0, "remoteAendern": 0,
                      "remoteLoeschen": 0}


def eds_kontakt_anlegen(client, vcard):
    EBookContacts = _EDS["EBookContacts"]
    kontakt = EBookContacts.Contact.new_from_vcard(vcard)
    try:
        ergebnis = client.add_contact_sync(kontakt, _buch_flags(), None)
    except TypeError:
        ergebnis = client.add_contact_sync(kontakt, None)
    if isinstance(ergebnis, tuple):
        return ergebnis[-1] if ergebnis[0] else None
    return ergebnis


def eds_kontakt_aendern(client, vcard):
    EBookContacts = _EDS["EBookContacts"]
    kontakt = EBookContacts.Contact.new_from_vcard(vcard)
    try:
        client.modify_contact_sync(kontakt, _buch_flags(), None)
    except TypeError:
        client.modify_contact_sync(kontakt, None)


def eds_kontakt_loeschen(client, uid_wert):
    try:
        client.remove_contact_by_uid_sync(uid_wert, _buch_flags(), None)
    except TypeError:
        client.remove_contact_by_uid_sync(uid_wert, None)


# ---------------------------------------------------------------------------
# Fenster mit WebKit-Ansicht und Nachrichtenbrücke
# ---------------------------------------------------------------------------

_FENSTER_BASIS = Gtk.Window if GTK_OK else object
ORGANIZER_URI = "magnolie-organizer://app/index.html"
_ORGANIZER_RESSOURCEN = {
    "/index.html": ("index.html", "text/html"),
    "/stil.css": ("stil.css", "text/css"),
    "/schriften/Z003-MediumItalic.otf":
        ("schriften/Z003-MediumItalic.otf", "font/otf"),
    "/kaffee-qr.png": ("kaffee-qr.png", "image/png"),
    "/i18n.js": ("i18n.js", "application/javascript"),
    "/i18n-start.js": ("i18n-start.js", "application/javascript"),
    "/anwendung.js": ("anwendung.js", "application/javascript"),
}
_ORGANIZER_RESSOURCEN.update({
    "/i18n/%s.js" % sprache: ("i18n/%s.js" % sprache, "application/javascript")
    for sprache in UNTERSTUETZTE_SPRACHEN
})


def organizer_ressource(adresse, web_verzeichnis, sprache="de"):
    """Ordnet ausschließlich feste Dateien dem internen Organizer-Ursprung zu."""
    from urllib.parse import urlsplit
    try:
        uri = urlsplit(str(adresse or ""))
    except ValueError:
        return None
    if (uri.scheme != "magnolie-organizer" or uri.netloc != "app" or
            uri.query or uri.fragment):
        return None
    if uri.path == "/i18n-active.js":
        aktiv = system_sprache() if sprache == "system" else (
            normalisiere_sprache(sprache, False) or "en")
        datei = "i18n-en.js" if aktiv == "en" else "i18n/%s.js" % aktiv
        mime = "application/javascript"
    elif uri.path in _ORGANIZER_RESSOURCEN:
        datei, mime = _ORGANIZER_RESSOURCEN[uri.path]
    else:
        return None
    wurzel = os.path.realpath(web_verzeichnis)
    pfad = os.path.realpath(os.path.join(wurzel, datei))
    try:
        if os.path.commonpath((wurzel, pfad)) != wurzel or not os.path.isfile(pfad):
            return None
    except ValueError:
        return None
    return pfad, mime


def organizer_navigation(adresse, benutzeraktion=False):
    """Lässt intern nur die Startseite und extern nur bewusste Weblinks zu."""
    from urllib.parse import urlsplit
    if adresse == ORGANIZER_URI:
        return "intern"
    try:
        schema = urlsplit(str(adresse or "")).scheme.lower()
    except ValueError:
        return "sperren"
    if benutzeraktion and schema in ("https", "http", "mailto"):
        return "extern"
    return "sperren"


def chromium_finden(which=shutil.which):
    """Findet einen bekannten Chromium-Befehl, ohne eine Shell zu verwenden."""
    for name in ("chromium", "chromium-browser", "google-chrome",
                 "google-chrome-stable"):
        pfad = which(name)
        if not pfad:
            continue
        pfad = os.path.realpath(os.path.abspath(pfad))
        try:
            modus = os.stat(pfad).st_mode
        except OSError:
            continue
        if stat.S_ISREG(modus) and os.access(pfad, os.X_OK):
            return pfad
    return None


def appimage_laufzeit(umgebung=None):
    umgebung = os.environ if umgebung is None else umgebung
    return bool(umgebung.get("APPIMAGE") or umgebung.get("APPDIR"))


def browser_transport_waehlen(gtk_ok, webkit_ok, appimage=False,
                              chromium=None):
    if not gtk_ok:
        return "fehlt"
    if webkit_ok:
        return "webkit"
    if not appimage and chromium:
        return "chromium"
    return "fehlt"


def organizer_http_ressource(pfad, token, web_verzeichnis, sprache="de"):
    """Prüft Fähigkeitspfad und feste Ressourcen ohne URL-Dekodierungs-Tricks."""
    if not isinstance(pfad, str) or "?" in pfad or "#" in pfad:
        return None
    vorspann = "/" + token
    if not pfad.startswith(vorspann + "/"):
        return None
    if not hmac.compare_digest(pfad[1:1 + len(token)], token):
        return None
    intern = pfad[len(vorspann):]
    if intern == "/i18n-active.js":
        aktiv = system_sprache() if sprache == "system" else (
            normalisiere_sprache(sprache, False) or "en")
        datei = "i18n-en.js" if aktiv == "en" else "i18n/%s.js" % aktiv
        eintrag = (datei, "application/javascript")
    else:
        eintrag = _ORGANIZER_RESSOURCEN.get(intern)
    if not eintrag or "%" in intern or "\\" in intern or ".." in intern:
        return None
    wurzel = os.path.realpath(web_verzeichnis)
    datei = os.path.realpath(os.path.join(wurzel, eintrag[0]))
    try:
        if os.path.commonpath((wurzel, datei)) != wurzel or not os.path.isfile(datei):
            return None
    except ValueError:
        return None
    return datei, eintrag[1]


class OrganizerHTTPServer:
    """Kleiner statischer Loopback-Server ohne native Befehlsoberfläche."""

    def __init__(self, web_verzeichnis, token=None, sprache="de"):
        self.web_verzeichnis = os.path.realpath(web_verzeichnis)
        self.token = token or os.urandom(24).hex()
        self.sprache = sprache
        besitzer = self

        class Handler(BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.0"

            def do_GET(self):
                erwartet = "127.0.0.1:%d" % self.server.server_port
                if self.headers.get_all("Host", []) != [erwartet]:
                    return self._ablehnen(403)
                ressource = organizer_http_ressource(
                    self.path, besitzer.token, besitzer.web_verzeichnis,
                    besitzer.sprache)
                if not ressource:
                    return self._ablehnen(404)
                try:
                    with open(ressource[0], "rb") as datei:
                        daten = datei.read()
                except OSError:
                    return self._ablehnen(404)
                self.send_response(200)
                self.send_header("Content-Type", ressource[1])
                self.send_header("Content-Length", str(len(daten)))
                self._sicherheitskopf()
                self.end_headers()
                self.wfile.write(daten)

            def _ablehnen(self, status):
                self.send_response(status)
                self.send_header("Content-Length", "0")
                self._sicherheitskopf()
                self.end_headers()

            def _sicherheitskopf(self):
                self.send_header("Cache-Control", "no-store")
                self.send_header("Content-Security-Policy",
                    "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; "
                    "img-src 'self' data: blob:; connect-src 'none'; object-src 'none'; "
                    "frame-src 'none'; base-uri 'none'; form-action 'none'")
                self.send_header("Cross-Origin-Resource-Policy", "same-origin")
                self.send_header("Referrer-Policy", "no-referrer")
                self.send_header("X-Content-Type-Options", "nosniff")
                self.send_header("X-Frame-Options", "DENY")

            def do_HEAD(self): self._ablehnen(405)
            def do_POST(self): self._ablehnen(405)
            def do_PUT(self): self._ablehnen(405)
            def do_DELETE(self): self._ablehnen(405)
            def do_OPTIONS(self): self._ablehnen(405)
            def do_PATCH(self): self._ablehnen(405)
            def do_TRACE(self): self._ablehnen(405)
            def do_CONNECT(self): self._ablehnen(405)
            def log_message(self, *_werte): pass

        self.server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        self.server.daemon_threads = True
        self.port = self.server.server_port
        self.origin = "http://127.0.0.1:%d" % self.port
        self.url = "%s/%s/index.html" % (self.origin, self.token)
        self._thread = threading.Thread(target=self.server.serve_forever,
                                        name="magnolie-http", daemon=True)

    def start(self):
        self._thread.start()

    def close(self):
        self.server.shutdown()
        self.server.server_close()
        if self._thread.is_alive():
            self._thread.join(1)


def cdp_nachrichten(puffer, daten):
    """Zerlegt die NUL-gerahmten JSON-Nachrichten des CDP-Pipe-Transports."""
    puffer += daten
    nachrichten = []
    while b"\0" in puffer:
        roh, puffer = puffer.split(b"\0", 1)
        if not roh:
            continue
        wert = json.loads(roh.decode("utf-8"))
        if not isinstance(wert, dict):
            raise ValueError("CDP-Nachricht ist kein Objekt")
        nachrichten.append(wert)
    return nachrichten, puffer


class CDPPipeClient:
    """Minimaler threadsicherer CDP-Client für Chromiums Debugging-Pipe."""

    def __init__(self, lesen, schreiben, bei_ereignis=None):
        self.lesen, self.schreiben = lesen, schreiben
        self.bei_ereignis = bei_ereignis or (lambda _nachricht: None)
        self._kennung = 0
        self._sperre = threading.Lock()
        self._wartend = {}
        self._geschlossen = False
        self._thread = threading.Thread(target=self._lesen, name="magnolie-cdp",
                                        daemon=True)
        self._thread.start()

    def sende(self, methode, parameter=None, session=None, timeout=5):
        fertig = threading.Event()
        with self._sperre:
            if self._geschlossen:
                raise RuntimeError("CDP-Pipe ist geschlossen")
            self._kennung += 1
            kennung = self._kennung
            self._wartend[kennung] = [fertig, None]
            nachricht = {"id": kennung, "method": methode,
                         "params": parameter or {}}
            if session:
                nachricht["sessionId"] = session
            roh = json.dumps(nachricht, separators=(",", ":")).encode("utf-8") + b"\0"
            try:
                self.schreiben.write(roh)
                self.schreiben.flush()
            except (OSError, ValueError):
                self._wartend.pop(kennung, None)
                raise RuntimeError("CDP-Pipe konnte nicht beschrieben werden")
        if not fertig.wait(timeout):
            with self._sperre:
                self._wartend.pop(kennung, None)
            raise TimeoutError("CDP-Antwort auf %s fehlt" % methode)
        with self._sperre:
            wartend = self._wartend.pop(kennung, None)
        if wartend is None:
            raise RuntimeError("CDP-Pipe ist geschlossen")
        antwort = wartend[1]
        if "error" in antwort:
            raise RuntimeError("CDP %s: %s" % (methode, antwort["error"]))
        return antwort.get("result") or {}

    def _lesen(self):
        puffer = b""
        try:
            while True:
                daten = self.lesen.read(4096)
                if not daten:
                    break
                nachrichten, puffer = cdp_nachrichten(puffer, daten)
                for nachricht in nachrichten:
                    kennung = nachricht.get("id")
                    with self._sperre:
                        wartend = self._wartend.get(kennung)
                        if wartend:
                            wartend[1] = nachricht
                            wartend[0].set()
                    if not wartend:
                        self.bei_ereignis(nachricht)
        except (OSError, ValueError, UnicodeError) as fehler:
            debug_notiz("chromium.cdp.read-failed", error=fehler)
        finally:
            with self._sperre:
                self._geschlossen = True
                for wartend in list(self._wartend.values()):
                    wartend[1] = {"error": {"message": "CDP-Pipe geschlossen"}}
                    wartend[0].set()

    def close(self):
        self._geschlossen = True
        for strom in (self.schreiben, self.lesen):
            try:
                strom.close()
            except OSError:
                pass


NOTIZ_ANHANG_URL_MAX = 12000000
NOTIZ_ANHANG_DATEI_MAX = 8 * 1024 * 1024
NOTIZ_ANHANG_ARTEN = {
    "image/jpeg": (".jpg", lambda daten: daten.startswith(b"\xff\xd8\xff")),
    "image/png": (".png", lambda daten: daten.startswith(b"\x89PNG\r\n\x1a\n")),
    "image/webp": (".webp", lambda daten: len(daten) >= 12 and
                    daten[:4] == b"RIFF" and daten[8:12] == b"WEBP"),
    "image/gif": (".gif", lambda daten: daten[:6] in (b"GIF87a", b"GIF89a")),
    "application/pdf": (".pdf", lambda daten: daten.startswith(b"%PDF-")),
}


def notiz_anhang_name(name, mime):
    """Kanonisiert einen untrusted Anzeigenamen für Dialog und Tempdatei."""
    endung = NOTIZ_ANHANG_ARTEN[mime][0]
    name = re.sub(r"[\x00-\x1f\x7f/\\]+", "_", str(name or "")).strip()
    name = name.strip(". ")
    stamm = os.path.splitext(name)[0].strip(". ")
    if not stamm:
        stamm = "attachment"
    stamm = stamm[:max(1, 180 - len(endung))].rstrip(". ") or "attachment"
    return stamm + endung


def notiz_anhang_dekodieren(data_url, name=""):
    """Prüft und dekodiert genau die erlaubten Notizanhang-Data-URLs."""
    if not isinstance(data_url, str) or not data_url:
        raise ValueError(_("The file has an unsupported format."))
    if len(data_url) > NOTIZ_ANHANG_URL_MAX:
        raise ValueError(_("The file is larger than 8 megabytes."))
    treffer = re.fullmatch(
        r"data:(image/(?:jpeg|png|webp|gif)|application/pdf);base64,"
        r"([A-Za-z0-9+/]+={0,2})", data_url)
    if not treffer or len(treffer.group(2)) % 4:
        raise ValueError(_("The file has an unsupported format."))
    mime, kodiert = treffer.groups()
    try:
        daten = base64.b64decode(kodiert, validate=True)
    except (ValueError, binascii.Error):
        raise ValueError(_("The file has an unsupported format."))
    if len(daten) > NOTIZ_ANHANG_DATEI_MAX:
        raise ValueError(_("The file is larger than 8 megabytes."))
    if not daten or not NOTIZ_ANHANG_ARTEN[mime][1](daten):
        raise ValueError(_("The file has an unsupported format."))
    return {"mime": mime, "name": notiz_anhang_name(name, mime), "daten": daten}


def tray_fenster_zustand(fenster):
    sichtbar = False
    abgebildet = False
    minimiert = False
    try:
        sichtbar = bool(fenster.get_visible())
    except AttributeError:
        pass
    try:
        abgebildet = bool(fenster.get_mapped())
    except AttributeError:
        pass
    try:
        gdk_fenster = fenster.get_window()
        minimiert = bool(gdk_fenster and
                          gdk_fenster.get_state() & Gdk.WindowState.ICONIFIED)
    except AttributeError:
        pass
    return {"internal_hidden": bool(getattr(fenster, "_tray_window_hidden", False)),
            "gtk_visible": sichtbar, "mapped": abgebildet,
            "iconified": minimiert,
            "indicator": bool(getattr(fenster, "_tray_indikator", None)),
            "indicator_type": getattr(fenster, "_tray_art", "") or "none"}


class ChromiumTransport:
    """Externe Chromium-App mit ausschließlich per CDP erreichbarer Brücke."""

    def __init__(self, programm, web_verzeichnis, bruecken_name, sprache,
                 bei_nachricht, bei_ende):
        self.programm = programm
        self.http = OrganizerHTTPServer(web_verzeichnis, sprache=sprache)
        self.url, self.origin = self.http.url, self.http.origin
        self.bruecken_name = bruecken_name
        self.sprache = sprache
        self.bei_nachricht, self.bei_ende = bei_nachricht, bei_ende
        self.profil = None
        self.prozess = None
        self.cdp = None
        self.session = None
        self.target = None
        self.main_frame = None
        self.kontexte = set()
        self._beendet = False

    def start(self):
        self.http.start()
        self.profil = tempfile.mkdtemp(prefix="magnolie-chromium-")
        os.chmod(self.profil, 0o700)
        befehl_lesen, befehl_schreiben = os.pipe()
        ereignis_lesen, ereignis_schreiben = os.pipe()

        argumente = [
            self.programm, "--remote-debugging-pipe", "--user-data-dir=" + self.profil,
            "--no-first-run", "--no-default-browser-check", "--disable-sync",
            "--disable-background-networking", "--disable-component-update",
            "--disable-default-apps", "--disable-extensions", "--disable-breakpad",
            "--disable-client-side-phishing-detection", "--disable-features=Translate",
            "--app=about:blank",
        ]
        # Die FD-Zuordnung geschieht in einem frisch gestarteten Einfaden-Helfer.
        # preexec_fn wäre im mehrfädigen Organizer nicht sicher.
        helfer = [sys.executable, "-c",
                  "import os,sys;os.dup2(int(sys.argv[1]),3);"
                  "os.dup2(int(sys.argv[2]),4);os.execv(sys.argv[3],sys.argv[3:])",
                  str(befehl_lesen), str(ereignis_schreiben)] + argumente
        try:
            self.prozess = subprocess.Popen(
                helfer, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, close_fds=True,
                pass_fds=(befehl_lesen, ereignis_schreiben))
        except Exception:
            os.close(befehl_lesen); os.close(befehl_schreiben)
            os.close(ereignis_lesen); os.close(ereignis_schreiben)
            self.close()
            raise
        os.close(befehl_lesen)
        os.close(ereignis_schreiben)
        self.cdp = CDPPipeClient(os.fdopen(ereignis_lesen, "rb", buffering=0),
                                 os.fdopen(befehl_schreiben, "wb", buffering=0),
                                 self._ereignis)
        self.cdp.sende("Target.setDiscoverTargets", {"discover": True})
        ende = time.monotonic() + 8
        while time.monotonic() < ende:
            ziele = self.cdp.sende("Target.getTargets").get("targetInfos", [])
            ziel = next((z for z in ziele if z.get("type") == "page" and
                         z.get("url") in ("about:blank", "")), None)
            if ziel:
                break
            time.sleep(.05)
        else:
            raise RuntimeError("Chromium hat die Organizer-Seite nicht geöffnet")
        self.target = ziel["targetId"]
        self.session = self.cdp.sende("Target.attachToTarget", {
            "targetId": self.target, "flatten": True})["sessionId"]
        self.cdp.sende("Target.setAutoAttach", {
            "autoAttach": True, "waitForDebuggerOnStart": True, "flatten": True})
        self.cdp.sende("Runtime.enable", session=self.session)
        self.cdp.sende("Page.enable", session=self.session)
        try:
            self.cdp.sende("Browser.setDownloadBehavior", {"behavior": "deny"})
        except RuntimeError:
            self.cdp.sende("Page.setDownloadBehavior", {"behavior": "deny"},
                           self.session)
        self.cdp.sende("Fetch.enable", {"patterns": [{"urlPattern": "*"}]}, self.session)
        self.main_frame = self.cdp.sende("Page.getFrameTree", session=self.session).get(
            "frameTree", {}).get("frame", {}).get("id")
        self.cdp.sende("Runtime.addBinding", {"name": self.bruecken_name}, self.session)
        script = self._bruecken_script()
        self.cdp.sende("Page.addScriptToEvaluateOnNewDocument", {"source": script},
                       self.session)
        self.cdp.sende("Page.navigate", {"url": self.url}, self.session)
        threading.Thread(target=self._prozess_beobachten,
                         name="magnolie-chromium-wait", daemon=True).start()

    def sprache_setzen(self, sprache):
        self.sprache = sprache
        self.http.sprache = sprache

    def _bruecken_script(self):
        name = json.dumps(self.bruecken_name)
        sprache = json.dumps(self.sprache)
        return """(() => {
          'use strict';
          const n=%s, send=window[n];
          Object.defineProperty(window,'__MAGNOLIE_BRUECKE__',{value:n});
          Object.defineProperty(window,'__MAGNOLIE_SPRACHE__',{value:%s});
          const handler=Object.freeze({postMessage(value){send(String(value));}});
          let webkit=window.webkit;
          if (!webkit || typeof webkit!=='object') {
            webkit={}; Object.defineProperty(window,'webkit',{value:webkit});
          }
          let handlers=webkit.messageHandlers;
          if (!handlers || typeof handlers!=='object') {
            handlers={}; Object.defineProperty(webkit,'messageHandlers',{value:handlers});
          }
          Object.defineProperty(handlers,n,{value:handler});
          document.addEventListener('click',event=>{
            const link=event.target && event.target.closest && event.target.closest('a[href]');
            if (!link) return;
            let url;
            try { url=new URL(link.href,location.href); } catch (_) { return; }
            if (!['http:','https:','mailto:'].includes(url.protocol)) return;
            event.preventDefault(); event.stopImmediatePropagation();
            handler.postMessage(JSON.stringify({cmd:'chromium_extern_oeffnen',adresse:url.href}));
          },true);
        })();""" % (name, sprache)

    def _ereignis(self, nachricht):
        methode, daten = nachricht.get("method"), nachricht.get("params") or {}
        session = nachricht.get("sessionId")
        if methode == "Runtime.executionContextCreated" and session == self.session:
            kontext = daten.get("context") or {}
            zusatz = kontext.get("auxData") or {}
            if (kontext.get("origin") == self.origin and zusatz.get("isDefault") is True
                    and zusatz.get("frameId") == self.main_frame):
                self.kontexte.add(kontext.get("id"))
        elif methode == "Runtime.executionContextDestroyed":
            self.kontexte.discard(daten.get("executionContextId"))
        elif (methode == "Runtime.bindingCalled" and session == self.session and
              daten.get("name") == self.bruecken_name and
              daten.get("executionContextId") in self.kontexte and
              isinstance(daten.get("payload"), str)):
            GLib.idle_add(lambda: (self.bei_nachricht(daten["payload"]), False)[1])
        elif methode == "Fetch.requestPaused" and session == self.session:
            anfrage = daten.get("request") or {}
            uri = urlsplit(anfrage.get("url") or "")
            erlaubt = (anfrage.get("method") == "GET" and not uri.query and
                        not uri.fragment and
                        "%s://%s" % (uri.scheme, uri.netloc) == self.origin and
                        organizer_http_ressource(
                            uri.path, self.http.token, self.http.web_verzeichnis))
            kommando = "Fetch.continueRequest" if erlaubt else "Fetch.failRequest"
            parameter = {"requestId": daten.get("requestId")}
            if not erlaubt:
                parameter["errorReason"] = "BlockedByClient"
            self._asynchron(kommando, parameter)
        elif methode == "Page.frameNavigated" and session == self.session:
            frame = daten.get("frame") or {}
            if frame.get("id") == self.main_frame and frame.get("url") != self.url:
                self._asynchron("Page.navigate", {"url": self.url})
        elif methode == "Target.targetCreated":
            ziel = daten.get("targetInfo") or {}
            if self.target and ziel.get("type") == "page" and ziel.get("targetId") != self.target:
                threading.Thread(target=lambda: self.cdp.sende(
                    "Target.closeTarget", {"targetId": ziel.get("targetId")}),
                    daemon=True).start()

    def _asynchron(self, methode, parameter=None):
        threading.Thread(target=lambda: self.cdp.sende(
            methode, parameter, self.session), daemon=True).start()

    def evaluate(self, quelltext):
        if self.cdp and self.session:
            self.cdp.sende("Runtime.evaluate", {"expression": quelltext,
                           "awaitPromise": False}, self.session)

    def bring_to_front(self):
        if self.cdp and self.session:
            self.cdp.sende("Page.bringToFront", session=self.session)

    def minimize(self):
        if not self.cdp or not self.target:
            return
        fenster = self.cdp.sende("Browser.getWindowForTarget", {
            "targetId": self.target}).get("windowId")
        if fenster is not None:
            self.cdp.sende("Browser.setWindowBounds", {
                "windowId": fenster, "bounds": {"windowState": "minimized"}})

    def _prozess_beobachten(self):
        status = self.prozess.wait()
        if not self._beendet:
            GLib.idle_add(lambda: (self.bei_ende(status), False)[1])

    def close(self):
        if self._beendet:
            return
        self._beendet = True
        if self.cdp:
            try:
                self.cdp.sende("Browser.close", timeout=1)
            except Exception:
                pass
            self.cdp.close()
        if self.prozess and self.prozess.poll() is None:
            try:
                self.prozess.terminate()
                self.prozess.wait(2)
            except (OSError, subprocess.TimeoutExpired):
                try:
                    self.prozess.kill()
                except OSError:
                    pass
        self.http.close()
        if self.profil:
            shutil.rmtree(self.profil, ignore_errors=True)
            self.profil = None


class Fenster(_FENSTER_BASIS):

    def __init__(self, web_verzeichnis):
        super().__init__(title=FENSTER_TITEL)
        self._fenster = fenster_zustand_lesen()
        self.set_default_size(self._fenster["breite"], self._fenster["hoehe"])
        self.set_size_request(980, 640)
        self.set_position(Gtk.WindowPosition.CENTER)
        self._sync_laeuft = False
        self._operation_laeuft = False
        self._journal_timer = None
        self._kennwort = ""
        self._gesperrt = True
        self._daten_dek = None
        self._daten_dek_kennung = None
        self._daten_umschlag = None
        self._aktuelle_daten = None
        self._daten_sperre = threading.RLock()
        self._speicher_auftraege = queue.Queue()
        self._speicher_laeuft = False
        self._speicher_thread = threading.Thread(
            target=self._speicher_lauf, daemon=True)
        self._speicher_thread.start()
        self._baum = None
        self._baum_dek = None
        self._baum_dek_kennung = None
        self._baum_umschlag = None
        self._baumdienst = None
        self._baum_sperre = threading.RLock()
        self._baum_post_timer = None
        self._baum_post_laeuft = False
        self._baum_post_planung = False
        self._baum_post_stop = False
        self._baum_briefkasten_fehler = ""
        self._baum_briefkasten_zustand = "nicht_eingerichtet"
        self._telefon = None
        self._telefon_sperre = threading.RLock()
        self._tray_einstellungen = tray_einstellungen_lesen()
        self._regional = dict(_REGIONAL)
        self._tray_indikator = None
        self._tray_art = ""
        self._tray_window_hidden = False
        self._tray_hide_quelle = None
        self._tray_wechsel = 0
        self._tray_oeffnet = False
        self._wirklich_beenden = False
        self._beenden_angefragt = False
        self._beenden_speicherfehler = False
        self._notiz_anhang_temp = None
        debug_notiz("window.init", wayland=bool(os.environ.get("WAYLAND_DISPLAY")),
                    tray_enabled=bool(self._tray_einstellungen.get("aktiv")),
                    tray_start="--tray-start" in sys.argv[1:])
        self._setze_symbol()
        _kdeconnect_backend(self._kde_ereignis)

        # Zuletzt benutzte Fensterform wiederherstellen
        if self._fenster["maximiert"]:
            self.maximize()
        if self._fenster["vollbild"]:
            self.fullscreen()
        self.connect("window-state-event", self._bei_fensterzustand)
        self.connect("key-press-event", self._bei_taste)
        self.connect("delete-event", self._bei_schliessen)

        self._web_verzeichnis = os.path.realpath(web_verzeichnis)
        self._contributor_hash = contributor_hash_lesen(self._web_verzeichnis)
        self._organizer_geladen = False
        self._bruecken_name = "bridge_" + os.urandom(16).hex()
        self._chromium = None
        if WEBKIT_OK:
            self._webkit_einrichten()
        else:
            self._chromium_einrichten()

        try:
            self.get_style_context().add_class("magnolie-fenster")
            fensterstil = Gtk.CssProvider()
            fensterstil.load_from_data(
                b"window.magnolie-fenster { background-color: #2e3a34; }")
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), fensterstil,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        except Exception:
            pass

        self.connect("destroy", self._bei_ende)
        self._tray_aktualisieren()

    def _webkit_einrichten(self):
        self._organizer_uri = ORGANIZER_URI
        kontext = WebKit2.WebContext.get_default()
        kontext.register_uri_scheme("magnolie-organizer", self._bei_organizer_anfrage)
        sicherheit = kontext.get_security_manager()
        for methode in ("register_uri_scheme_as_local", "register_uri_scheme_as_secure",
                        "register_uri_scheme_as_display_isolated"):
            try:
                getattr(sicherheit, methode)("magnolie-organizer")
            except AttributeError:
                pass
        inhalte = WebKit2.UserContentManager()
        inhalte.connect("script-message-received::" + self._bruecken_name,
                        self.bei_nachricht)
        if not inhalte.register_script_message_handler(self._bruecken_name):
            raise RuntimeError(_("The secure interface could not be registered."))
        script = ("window.__MAGNOLIE_BRUECKE__=%s;window.__MAGNOLIE_SPRACHE__=%s;") % (
            json.dumps(self._bruecken_name), json.dumps(_REGIONAL.get("language") or "de"))
        inhalte.add_script(WebKit2.UserScript.new(
            script, WebKit2.UserContentInjectedFrames.TOP_FRAME,
            WebKit2.UserScriptInjectionTime.START, ["magnolie-organizer://app/*"], None))
        self.ansicht = WebKit2.WebView(user_content_manager=inhalte)
        einstellungen = self.ansicht.get_settings()
        try:
            einstellungen.set_enable_developer_extras(False)
        except AttributeError:
            pass
        for methode in ("set_allow_file_access_from_file_urls",
                        "set_allow_universal_access_from_file_urls"):
            try:
                getattr(einstellungen, methode)(False)
            except AttributeError:
                pass
        try:
            farbe = Gdk.RGBA(); farbe.parse("#2e3a34")
            self.ansicht.set_background_color(farbe)
        except (AttributeError, TypeError):
            pass
        self.ansicht.connect("context-menu", lambda *a: True)
        self.ansicht.connect("decide-policy", self.bei_navigation)
        self.ansicht.connect("load-changed", self._bei_laden)
        self.add(self.ansicht)
        self.ansicht.load_uri(self._organizer_uri)

    def _chromium_einrichten(self):
        programm = chromium_finden()
        if not programm:
            raise RuntimeError("Chromium ist nicht verfügbar")
        transport = ChromiumTransport(
            programm, self._web_verzeichnis, self._bruecken_name,
            _REGIONAL.get("language") or "de", self.bei_nachricht,
            self._chromium_beendet)
        self._chromium = self.ansicht = transport
        self._organizer_uri = transport.url
        self._organizer_geladen = True
        try:
            transport.start()
        except Exception:
            self._organizer_geladen = False
            transport.close()
            raise

    def _chromium_beendet(self, status):
        if self._wirklich_beenden:
            return
        debug_notiz("chromium.exited", status=status)
        def abschliessen():
            if (getattr(self, "_speicher_laeuft", False) or
                    getattr(self._speicher_auftraege, "unfinished_tasks", 0)):
                return True
            self._wirklich_beenden = True
            self.destroy()
            return False
        GLib.timeout_add(50, abschliessen)

    def zeige_wenn_bereit(self, wartezeit=3):
        """Zeigt das Fenster erst, wenn die Seite gezeichnet ist.

        Sonst steht für einen Augenblick ein leeres Fenster auf dem
        Schirm – je nach System weiß oder schwarz."""
        self._gezeigt = False

        if getattr(self, "_chromium", None):
            self._gezeigt = True
            if (self._tray_einstellungen.get("aktiv") and
                    (self._tray_einstellungen.get("startMinimiert") or
                     "--tray-start" in sys.argv[1:]) and self._tray_indikator):
                self._tray_window_hidden = True
                self._chromium.minimize()
            else:
                self._chromium.bring_to_front()
            return

        def zeigen(*_egal):
            if self._gezeigt:
                return False
            self._gezeigt = True
            minimiert = (self._tray_einstellungen.get("aktiv") and
                          (self._tray_einstellungen.get("startMinimiert") or
                           "--tray-start" in sys.argv[1:]))
            debug_notiz("window.initial-display", minimized=bool(minimiert),
                        indicator=bool(self._tray_indikator))
            if not minimiert or not self._tray_indikator:
                self._tray_zeigen()
            else:
                self._tray_window_hidden = True
            return False

        def bei_ladewechsel(_ansicht, ereignis):
            if ereignis == WebKit2.LoadEvent.FINISHED:
                debug_notiz("webview.load-finished")
                zeigen()

        try:
            self.ansicht.connect("load-changed", bei_ladewechsel)
        except Exception:
            pass
        # Sicherheitsnetz: Nach spätestens vier Sekunden wird gezeigt.
        GLib.timeout_add_seconds(max(1, wartezeit), zeigen)

    # ------------------------------------------------------------------ GTK

    def _bei_fensterzustand(self, _fenster, ereignis):
        """Merkt sich, ob das Fenster maximiert oder im Vollbild ist."""
        try:
            zustand = ereignis.new_window_state
            geaendert = getattr(ereignis, "changed_mask", 0)
            minimiert_geaendert = bool(geaendert & Gdk.WindowState.ICONIFIED)
            ins_tray = (minimiert_geaendert and
                        zustand & Gdk.WindowState.ICONIFIED and
                        not self._tray_oeffnet and
                        self._tray_indikator and
                        self._tray_einstellungen.get("aktiv") and
                        self._tray_einstellungen.get("minimierenInTray"))
            debug_notiz("window.state", changed=int(geaendert), state=int(zustand),
                        iconified=bool(zustand & Gdk.WindowState.ICONIFIED),
                        iconified_changed=minimiert_geaendert,
                        hide_scheduled=bool(self._tray_hide_quelle),
                        opening=self._tray_oeffnet,
                        internal_hidden=self._tray_window_hidden)
            if not self._tray_window_hidden and not ins_tray:
                self._fenster["maximiert"] = bool(zustand & Gdk.WindowState.MAXIMIZED)
                self._fenster["vollbild"] = bool(zustand & Gdk.WindowState.FULLSCREEN)
            if ins_tray:
                self._tray_hide_planen()
        except AttributeError:
            pass
        return False

    def _tray_hide_abbrechen(self):
        quelle = self._tray_hide_quelle
        self._tray_hide_quelle = None
        if not quelle:
            return False
        try:
            GLib.source_remove(quelle)
            debug_notiz("tray.hide.cancel", source=quelle)
        except (AttributeError, TypeError):
            pass
        return True

    def _tray_hide_planen(self):
        if self._tray_hide_quelle or self._tray_oeffnet:
            return False
        wechsel = self._tray_wechsel

        def verbergen():
            self._tray_hide_quelle = None
            zustand = tray_fenster_zustand(self)
            if wechsel != self._tray_wechsel or not zustand["iconified"]:
                debug_notiz("tray.hide.skip", generation=wechsel,
                            current=self._tray_wechsel, **zustand)
                return False
            debug_notiz("tray.hide.execute", generation=wechsel, **zustand)
            self._tray_window_hidden = True
            self.hide()
            return False

        self._tray_hide_quelle = GLib.idle_add(verbergen)
        debug_notiz("tray.hide.schedule", source=self._tray_hide_quelle,
                    generation=wechsel, **tray_fenster_zustand(self))
        return True

    def _bei_taste(self, _fenster, ereignis):
        """F11 schaltet das Vollbild um."""
        try:
            name = Gdk.keyval_name(ereignis.keyval)
        except AttributeError:
            return False
        if name != "F11":
            return False
        if self._fenster.get("vollbild"):
            self.unfullscreen()
        else:
            self.fullscreen()
        return True

    def _bei_schliessen(self, *_egal):
        if (not self._wirklich_beenden and self._tray_indikator and
                self._tray_einstellungen.get("aktiv") and
                self._tray_einstellungen.get("schliessenInTray")):
            self._tray_verbergen()
            return True
        if not self._wirklich_beenden:
            self._beenden_anfragen()
            return True
        return False

    def _beenden_anfragen(self):
        if self._beenden_angefragt:
            return
        self._beenden_angefragt = True
        self._beenden_speicherfehler = False
        self.sende_js("App.vorBeenden();")

        def freigeben():
            # Ohne bestätigtes ``beenden_bereit`` darf ein Bridge- oder
            # Serialisierungsfehler niemals ungespeicherte Daten verwerfen.
            self._beenden_angefragt = False
            return False
        GLib.timeout_add_seconds(5, freigeben)

    def _beenden_endgueltig(self):
        if self._wirklich_beenden:
            return False
        self._wirklich_beenden = True
        if getattr(self, "_chromium", None):
            self._chromium.close()
        self.destroy()
        return False

    def _tray_zeigen(self, *_egal):
        if getattr(self, "_chromium", None):
            self._tray_window_hidden = False
            try:
                self._chromium.bring_to_front()
            except Exception as fehler:
                debug_notiz("chromium.front-failed", error=fehler)
            return
        debug_notiz("tray.show.begin", **tray_fenster_zustand(self))
        self._tray_wechsel += 1
        self._tray_hide_abbrechen()
        self._tray_oeffnet = True
        self._tray_window_hidden = False
        self.show_all()
        try:
            self.deiconify()
        except AttributeError:
            pass
        art = self._tray_einstellungen.get("oeffnen", "previous")
        if art == "maximized":
            self.unfullscreen()
            self.maximize()
        elif art == "centered":
            self.unfullscreen()
            self.unmaximize()
            self.set_position(Gtk.WindowPosition.CENTER_ALWAYS)
        elif self._fenster.get("vollbild"):
            self.fullscreen()
        elif self._fenster.get("maximiert"):
            self.maximize()
        elif (not os.environ.get("WAYLAND_DISPLAY") and
              self._fenster.get("x") is not None and self._fenster.get("y") is not None):
            self.move(self._fenster["x"], self._fenster["y"])
        self.present()
        debug_notiz("tray.show.end", **tray_fenster_zustand(self))

        wechsel = self._tray_wechsel
        def nachpruefen(versuch=0):
            if wechsel != self._tray_wechsel or self._tray_window_hidden:
                return False
            zustand = tray_fenster_zustand(self)
            debug_notiz("tray.show.probe", generation=wechsel, attempt=versuch,
                        **zustand)
            if zustand["iconified"] or not zustand["mapped"]:
                self.show_all()
                try:
                    self.deiconify()
                except AttributeError:
                    pass
                self.present()
                debug_notiz("tray.show.retry", generation=wechsel,
                            attempt=versuch,
                            **tray_fenster_zustand(self))
                if versuch < 5:
                    GLib.timeout_add(120, lambda: nachpruefen(versuch + 1))
                    return False
            self._tray_oeffnet = False
            debug_notiz("tray.show.settled", generation=wechsel,
                        attempt=versuch, **tray_fenster_zustand(self))
            return False
        GLib.timeout_add(120, nachpruefen)

    def _tray_verbergen(self, *_egal):
        if getattr(self, "_chromium", None):
            self._tray_window_hidden = True
            try:
                self._chromium.minimize()
            except Exception as fehler:
                debug_notiz("chromium.minimize-failed", error=fehler)
            return
        debug_notiz("tray.hide.begin", **tray_fenster_zustand(self))
        self._tray_wechsel += 1
        self._tray_hide_abbrechen()
        self._tray_oeffnet = False
        self._merke_fenster()
        self._tray_window_hidden = True
        self.hide()
        debug_notiz("tray.hide.end", **tray_fenster_zustand(self))

    def _tray_debug_zustand(self):
        return tray_fenster_zustand(self)

    def _tray_umschalten(self, *_egal):
        if getattr(self, "_chromium", None):
            if self._tray_window_hidden:
                self._tray_zeigen()
            else:
                self._tray_verbergen()
            return
        verborgen = self._tray_window_hidden or not self.get_visible()
        try:
            verborgen = verborgen or not self.get_mapped()
        except AttributeError:
            pass
        try:
            gdk_fenster = self.get_window()
            verborgen = verborgen or bool(
                gdk_fenster and gdk_fenster.get_state() & Gdk.WindowState.ICONIFIED)
        except AttributeError:
            pass
        debug_notiz("tray.toggle", decision="show" if verborgen else "hide",
                    **tray_fenster_zustand(self))
        if verborgen:
            self._tray_zeigen()
        else:
            self._tray_verbergen()

    def _tray_linksklick(self, _symbol, ereignis):
        if getattr(ereignis, "button", 0) != 1:
            return False
        self._tray_umschalten()
        return True

    def _tray_einstellungen_zeigen(self, *_egal):
        self._tray_zeigen()
        GLib.idle_add(lambda: (self.sende_js("App.trayEinstellungen();"), False)[1])

    def _tray_telefon_zeigen(self, _eintrag, kennung):
        if self._gesperrt or not self._telefon:
            return
        partner = self._telefon.store.peer(kennung)
        if not partner:
            return
        name = str(partner.get("display_name") or _("Unknown phone"))[:60]
        status = dict(self._telefon.store.status(kennung) or {})
        status["online"] = kennung in self._telefon.connections
        status["last_contact_ms"] = partner.get("last_contact_ms", 0)
        self._tray_zeigen()
        self.antwort("App.geraetOeffnen", {
            "kennung": kennung, "name": name, "status": status})
        threading.Thread(target=lambda: self._telefon_status_anfordern(kennung),
                         daemon=True).start()

    def _tray_telefon_verbinden(self, *_egal):
        if self._gesperrt or not self._telefon or not self._telefon.enabled:
            return
        self._tray_zeigen()
        threading.Thread(target=self._telefon_pairing_oeffnen, daemon=True).start()

    def _tray_telefone_aktualisieren(self):
        eintrag = getattr(self, "_tray_telefone", None)
        if not eintrag:
            return
        aktiv = bool(not self._gesperrt and self._telefon and self._telefon.enabled)
        partner_liste = list(self._telefon.store.peers) if aktiv else []
        untermenue = Gtk.Menu()
        for partner in sorted(partner_liste,
                              key=lambda p: str(p.get("display_name") or "").casefold()):
            name = str(partner.get("display_name") or _("Unknown phone"))[:60]
            telefon = Gtk.MenuItem(label=name)
            telefon.connect("activate", self._tray_telefon_zeigen,
                            partner.get("device_id") or "")
            untermenue.append(telefon)
        eintrag.set_submenu(untermenue)
        eintrag.set_visible(aktiv and bool(partner_liste))
        verbinden = getattr(self, "_tray_telefon_verbinden_eintrag", None)
        if verbinden:
            verbinden.set_visible(aktiv)
        untermenue.show_all()

    def _tray_beenden(self, *_egal):
        self._beenden_anfragen()

    def _tray_aktualisieren(self):
        diagnose = tray_system_diagnose()
        aktiv = bool(self._tray_einstellungen.get("aktiv") and
                     diagnose["verfuegbar"])
        debug_notiz("tray.update.begin",
                    configured=bool(self._tray_einstellungen.get("aktiv")),
                    available=diagnose["verfuegbar"], kind=diagnose["art"],
                    reason=diagnose["grund"], desktop=diagnose["desktop"],
                    session_type=os.environ.get("XDG_SESSION_TYPE") or "unknown",
                    wayland=bool(os.environ.get("WAYLAND_DISPLAY")),
                    display=bool(os.environ.get("DISPLAY")),
                    session_bus=bool(os.environ.get("DBUS_SESSION_BUS_ADDRESS")))
        if not aktiv:
            if self._tray_indikator:
                if self._tray_art in ("statusicon", "xapp"):
                    self._tray_indikator.set_visible(False)
                else:
                    self._tray_indikator.set_status(AppIndicator.IndicatorStatus.PASSIVE)
                self._tray_indikator = None
                self._tray_art = ""
            return False
        if self._tray_indikator:
            if self._tray_art in ("statusicon", "xapp"):
                self._tray_indikator.set_visible(True)
            else:
                self._tray_indikator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
            self._tray_zaehler_anzeigen()
            return True
        try:
            desktop = str(os.environ.get("XDG_CURRENT_DESKTOP") or "").upper()
            cinnamon_xapp = "CINNAMON" in desktop and XApp is not None
            cinnamon_statusicon = (not cinnamon_xapp and "CINNAMON" in desktop and
                                    not os.environ.get("WAYLAND_DISPLAY") and
                                    hasattr(Gtk, "StatusIcon"))
            cinnamon_native = cinnamon_xapp or cinnamon_statusicon
            menu = Gtk.Menu()
            oeffnen = Gtk.MenuItem(label=_("Open Magnolie Organizer"))
            oeffnen.connect("activate", self._tray_zeigen)
            minimieren = Gtk.MenuItem(label=_("Minimize to tray"))
            minimieren.connect("activate", self._tray_verbergen)
            einstellungen = Gtk.MenuItem(label=_("Settings"))
            einstellungen.connect("activate", self._tray_einstellungen_zeigen)
            beenden = Gtk.MenuItem(label=_("Quit"))
            beenden.connect("activate", self._tray_beenden)
            if not cinnamon_native:
                menu.append(oeffnen)
                menu.append(minimieren)
            self._tray_telefon_verbinden_eintrag = None
            telefone = Gtk.MenuItem(label=_("Phones"))
            menu.append(telefone)
            self._tray_telefone = telefone
            menu.append(einstellungen)
            menu.append(Gtk.SeparatorMenuItem())
            menu.append(beenden)
            menu.show_all()
            if cinnamon_xapp:
                indikator = XApp.StatusIcon.new()
                indikator.set_name("magnolie-organizer")
                indikator.set_icon_name("magnolie-organizer")
                indikator.set_tooltip_text(FENSTER_TITEL)
                indikator.connect("activate", self._tray_umschalten)
                indikator.set_secondary_menu(menu)
                indikator.set_visible(True)
                self._tray_art = "xapp"
            elif cinnamon_statusicon:
                indikator = Gtk.StatusIcon.new_from_icon_name("magnolie-organizer")
                indikator.set_title(FENSTER_TITEL)
                indikator.set_tooltip_text(FENSTER_TITEL)
                indikator.connect("button-release-event", self._tray_linksklick)
                indikator.connect("popup-menu", lambda symbol, knopf, zeit:
                    menu.popup(None, None, Gtk.StatusIcon.position_menu,
                               symbol, knopf, zeit))
                indikator.set_visible(True)
                self._tray_art = "statusicon"
            else:
                indikator = AppIndicator.Indicator.new(
                    "magnolie-organizer", "magnolie-organizer",
                    AppIndicator.IndicatorCategory.APPLICATION_STATUS)
                indikator.set_title(FENSTER_TITEL)
                indikator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
                indikator.set_menu(menu)
                self._tray_art = "appindicator"
            self._tray_indikator = indikator
            self._tray_menu = menu
            self._tray_telefone_aktualisieren()
            self._tray_zaehler_anzeigen()
            debug_notiz("tray.update.ready", indicator_type=self._tray_art)
            return True
        except Exception as fehler:
            debug_ausnahme("tray.update.failed", error=fehler)
            sys.stderr.write(_("The tray applet could not be started: %s") % fehler + "\n")
            self._tray_indikator = None
            return False

    def _tray_zaehler_anzeigen(self):
        indikator = self._tray_indikator
        if not indikator:
            return
        anzahl = max(0, min(999, int(getattr(self, "_tray_zaehler", 0) or 0)))
        text = ("99+" if anzahl > 99 else str(anzahl)) if (
            self._tray_einstellungen.get("zaehler") and anzahl) else ""
        tooltip = FENSTER_TITEL
        if text:
            tooltip += " · " + (ngettext(
                "%d notification today", "%d notifications today", anzahl) % anzahl)
        try:
            if self._tray_art == "appindicator" and hasattr(indikator, "set_label"):
                indikator.set_label(text, "99+")
            elif self._tray_art == "xapp" and hasattr(indikator, "set_label"):
                indikator.set_label(text)
            if hasattr(indikator, "set_tooltip_text"):
                indikator.set_tooltip_text(tooltip)
        except Exception as fehler:
            debug_ausnahme("tray.count.failed", error=fehler)

    def _tray_zaehler_setzen(self, roh):
        try:
            self._tray_zaehler = max(0, min(999, int(roh)))
        except (TypeError, ValueError):
            self._tray_zaehler = 0
        self._tray_zaehler_anzeigen()

    def _tray_einstellungen_setzen(self, roh):
        bisher_aktiv = bool(self._tray_einstellungen.get("aktiv"))
        self._tray_einstellungen = tray_einstellungen(roh)
        gespeichert = tray_einstellungen_schreiben(self._tray_einstellungen)
        autostart = tray_autostart_einrichten(
            self._tray_einstellungen.get("aktiv") and
            self._tray_einstellungen.get("autostart"))
        verfuegbar = self._tray_aktualisieren()
        if bisher_aktiv and not self._tray_einstellungen.get("aktiv"):
            self._tray_zeigen()
        antwort = {"ok": gespeichert["ok"] and autostart["ok"],
                   "verfuegbar": tray_system_verfuegbar(),
                   "aktiv": bool(verfuegbar),
                   "fehler": gespeichert.get("fehler") or autostart.get("fehler") or ""}
        self.antwort("App.trayStand", antwort)

    def _merke_fenster(self):
        if not (self._fenster["maximiert"] or self._fenster["vollbild"]):
            try:
                breite, hoehe = self.get_size()
                self._fenster["breite"] = int(breite)
                self._fenster["hoehe"] = int(hoehe)
                if not os.environ.get("WAYLAND_DISPLAY"):
                    x, y = self.get_position()
                    self._fenster["x"], self._fenster["y"] = int(x), int(y)
            except (AttributeError, TypeError, ValueError):
                pass
        fenster_zustand_schreiben(self._fenster)

    def _bei_ende(self, *_egal):
        if self._journal_timer:
            try:
                GLib.source_remove(self._journal_timer)
            except (AttributeError, TypeError):
                pass
        try:
            self._speicher_auftraege.put_nowait(None)
        except AttributeError:
            pass
        self._baum_post_stop = True
        self._baum_post_pause()
        if self._baumdienst:
            self._baumdienst.anhalten()
            self._baumdienst = None
        if self._telefon:
            self._telefon.stop()
        _ANRUF_LAUTSTAERKE.restore()
        if _KDECONNECT_BACKEND is not None:
            _KDECONNECT_BACKEND.stop()
        if self._notiz_anhang_temp:
            shutil.rmtree(self._notiz_anhang_temp, ignore_errors=True)
            self._notiz_anhang_temp = None
        if getattr(self, "_chromium", None):
            self._chromium.close()
        self._merke_fenster()
        Gtk.main_quit()

    def _setze_symbol(self):
        for pfad in (
            "/usr/share/icons/hicolor/256x256/apps/magnolie-organizer.png",
            "/usr/share/icons/hicolor/128x128/apps/magnolie-organizer.png",
        ):
            if os.path.isfile(pfad):
                try:
                    self.set_icon_from_file(pfad)
                    return
                except GLib.Error:
                    pass
        try:
            self.set_icon_name("magnolie-organizer")
        except Exception:
            pass

    def _bei_organizer_anfrage(self, anfrage):
        ressource = organizer_ressource(
            anfrage.get_uri(), self._web_verzeichnis, self._regional["language"])
        daten = b""
        mime = "text/plain"
        if ressource:
            try:
                with open(ressource[0], "rb") as datei:
                    daten = datei.read()
                mime = ressource[1]
            except OSError:
                daten = b""
        strom = Gio.MemoryInputStream.new_from_bytes(GLib.Bytes.new(daten))
        anfrage.finish(strom, len(daten), mime)

    def _bei_laden(self, ansicht, ereignis):
        if ereignis == WebKit2.LoadEvent.STARTED:
            self._organizer_geladen = False
        elif ereignis == WebKit2.LoadEvent.COMMITTED:
            self._organizer_geladen = ansicht.get_uri() == self._organizer_uri

    def _organizer_vertraut(self):
        if getattr(self, "_chromium", None):
            return bool(self._organizer_geladen and not self._chromium._beendet)
        try:
            return (bool(self._organizer_geladen) and
                    self.ansicht.get_uri() == self._organizer_uri)
        except AttributeError:
            return False

    def bei_navigation(self, ansicht, entscheidung, art):
        arten = [WebKit2.PolicyDecisionType.NAVIGATION_ACTION]
        try:
            arten.append(WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION)
        except AttributeError:
            pass
        if art not in arten:
            return False
        try:
            aktion = entscheidung.get_navigation_action()
            adresse = aktion.get_request().get_uri()
            benutzeraktion = bool(aktion.is_user_gesture())
        except AttributeError:
            entscheidung.ignore()
            return True
        weg = organizer_navigation(adresse, benutzeraktion)
        if weg == "intern":
            return False
        entscheidung.ignore()
        if weg == "extern":
            try:
                Gtk.show_uri_on_window(self, adresse, Gdk.CURRENT_TIME)
            except GLib.Error:
                pass
        return True

    # ----------------------------------------------------------- Dateiwahl

    def _datei_oeffnen(self, titel, filter_liste):
        dialog = Gtk.FileChooserDialog(title=titel, parent=self,
                                       action=Gtk.FileChooserAction.OPEN)
        dialog.add_buttons(_("Cancel"), Gtk.ResponseType.CANCEL,
                           _("Open"), Gtk.ResponseType.ACCEPT)
        for name, muster in filter_liste:
            f = Gtk.FileFilter()
            f.set_name(name)
            f.add_pattern(muster)
            dialog.add_filter(f)
        antwort = dialog.run()
        pfad = dialog.get_filename() if antwort == Gtk.ResponseType.ACCEPT else None
        dialog.destroy()
        return pfad

    def _datei_speichern(self, titel, vorschlag, filter_liste):
        dialog = Gtk.FileChooserDialog(title=titel, parent=self,
                                       action=Gtk.FileChooserAction.SAVE)
        dialog.add_buttons(_("Cancel"), Gtk.ResponseType.CANCEL,
                           _("Save"), Gtk.ResponseType.ACCEPT)
        dialog.set_do_overwrite_confirmation(True)
        dialog.set_current_name(vorschlag)
        for name, muster in filter_liste:
            f = Gtk.FileFilter()
            f.set_name(name)
            f.add_pattern(muster)
            dialog.add_filter(f)
        antwort = dialog.run()
        pfad = dialog.get_filename() if antwort == Gtk.ResponseType.ACCEPT else None
        dialog.destroy()
        return pfad

    def _ordner_waehlen(self, titel, vorwahl=""):
        dialog = Gtk.FileChooserDialog(
            title=titel, parent=self,
            action=Gtk.FileChooserAction.SELECT_FOLDER)
        dialog.add_buttons(_("Cancel"), Gtk.ResponseType.CANCEL,
                           _("Select"), Gtk.ResponseType.ACCEPT)
        vorwahl = sicherungs_verzeichnis(vorwahl)
        if os.path.isdir(vorwahl):
            try:
                dialog.set_current_folder(vorwahl)
            except Exception:
                pass
        antwort = dialog.run()
        pfad = dialog.get_filename() if antwort == Gtk.ResponseType.ACCEPT else None
        dialog.destroy()
        return pfad

    # --------------------------------------------------------------- Brücke

    def sende_js(self, quelltext):
        """Führt JavaScript in der Ansicht aus – immer über die Hauptschleife,
        damit es auch aus Arbeits-Threads heraus sicher ist."""
        def _fertig(ansicht, ergebnis, art):
            try:
                if art == "evaluate":
                    ansicht.evaluate_javascript_finish(ergebnis)
                else:
                    ansicht.run_javascript_finish(ergebnis)
            except GLib.Error as fehler:
                debug_ausnahme("bridge.javascript.failed", error=fehler)

        def _im_haupt():
            if not self._organizer_vertraut():
                return False
            if getattr(self, "_chromium", None):
                try:
                    self._chromium.evaluate(quelltext)
                except Exception as fehler:
                    debug_notiz("bridge.javascript.failed", error=fehler)
            elif hasattr(self.ansicht, "evaluate_javascript"):
                self.ansicht.evaluate_javascript(quelltext, -1, None, None,
                                                 None, _fertig, "evaluate")
            else:
                self.ansicht.run_javascript(quelltext, None, _fertig, "run")
            return False
        GLib.idle_add(_im_haupt)

    def antwort(self, funktion, nutzlast):
        self.sende_js("%s(JSON.parse(%s));" % (funktion, js_zeichenkette(nutzlast)))

    def bei_nachricht(self, inhalte, ergebnis=None):
        if not self._organizer_vertraut():
            return
        try:
            if ergebnis is None:
                roh = inhalte
            else:
                wert = ergebnis.get_js_value() if hasattr(ergebnis, "get_js_value") else ergebnis
                roh = wert.to_string()
            nachricht = json.loads(roh)
        except (TypeError, ValueError, AttributeError) as fehler:
            sys.stderr.write(_("Unreadable message from the interface: %s") % fehler + "\n")
            return

        if not isinstance(nachricht, dict):
            return

        befehl = nachricht.get("cmd")
        if not isinstance(befehl, str) or not befehl:
            return

        if (str(befehl or "").startswith("baum_") or
                str(befehl or "").startswith("telefon_")) and self._gesperrt:
            return

        if befehl == "bereit":
            self._oeffnen_oder_sperren()
            if not self._gesperrt:
                threading.Thread(target=self._baum_dienst_pflegen,
                                 daemon=True).start()
                threading.Thread(target=self._telefon_dienst_pflegen,
                                 daemon=True).start()

        elif befehl == "debug_startphase":
            felder = {}
            for name, wert in (nachricht.get("phasen") or {}).items():
                if (isinstance(name, str) and len(name) <= 40 and
                        isinstance(wert, (int, float)) and not isinstance(wert, bool)):
                    felder[name] = round(float(wert), 1)
            debug_notiz("startup.web-data", **felder)

        elif befehl == "chromium_extern_oeffnen" and self._chromium:
            adresse = nachricht.get("adresse")
            if organizer_navigation(adresse, True) == "extern":
                try:
                    Gtk.show_uri_on_window(self, adresse, Gdk.CURRENT_TIME)
                except GLib.Error:
                    pass

        elif befehl == "entsperren":
            self._entsperren(nachricht.get("kennwort") or "")

        elif befehl == "kennwort_setzen":
            self._kennwort_setzen(nachricht.get("neu") or "",
                                  nachricht.get("alt") or "",
                                  bool(nachricht.get("sicherungen", True)),
                                  nachricht.get("sicherungsordner") or "")

        elif befehl == "kennwort_entfernen":
            self._kennwort_entfernen(
                nachricht.get("alt") or "",
                nachricht.get("sicherungsordner") or "")

        elif befehl == "speichern":
            if not self._darf_schreiben():
                sys.stderr.write(
                    _("Save rejected: The data is encrypted and has not been unlocked yet.") + "\n")
                self.antwort("App.gespeichert", {
                    "id": nachricht.get("id"), "ok": False,
                    "fehler": _("Save rejected: The data is encrypted and has not been unlocked yet.")})
                self._beenden_angefragt = False
                return
            kennung = nachricht.get("id")
            klartext = nachricht.get("text")
            if (isinstance(kennung, bool) or not isinstance(kennung, int)
                    or kennung < 1 or not isinstance(klartext, str)):
                self.antwort("App.gespeichert", {
                    "id": kennung, "ok": False,
                    "fehler": _("The save request is invalid.")})
                return
            self._speicher_auftraege.put((kennung, klartext))

        elif befehl == "regional_einstellungen":
            sauber = regional_einstellungen(nachricht.get("regional"))
            if regional_einstellungen_schreiben(sauber):
                self._regional = sauber
                if self._chromium:
                    self._chromium.sprache_setzen(sauber["language"])
                self.antwort("App.regionalErgebnis", {
                    "ok": True, "regional": sauber})
            else:
                self.antwort("App.regionalErgebnis", {
                    "ok": False,
                    "fehler": _("The regional settings could not be saved.")})

        elif befehl == "contributor_pruefen":
            key = nachricht.get("key")
            if not isinstance(key, str) or len(key) > 1024:
                key = ""
            ist_hash = hashlib.sha256(key.encode("utf-8")).hexdigest()
            self.antwort("App.contributorGeprueft", {
                "ok": bool(getattr(self, "_contributor_hash", "")) and
                hmac.compare_digest(
                    ist_hash, getattr(self, "_contributor_hash", ""))})

        elif befehl == "beenden_bereit":
            if (not getattr(self, "_speicher_laeuft", False)
                    and not getattr(self._speicher_auftraege,
                                    "unfinished_tasks", 0)):
                GLib.idle_add(self._beenden_endgueltig)

        elif befehl == "beenden_abgebrochen":
            self._beenden_angefragt = False
            self._beenden_speicherfehler = False

        elif befehl == "tray_einstellungen":
            self._tray_einstellungen_setzen(nachricht.get("einstellungen") or {})

        elif befehl == "tray_zaehler":
            self._tray_zaehler_setzen(nachricht.get("anzahl") or 0)

        elif befehl == "sicherung":
            if not self._darf_schreiben():
                self.sende_js("App.sicherungFertig(JSON.parse(%s));"
                              % js_zeichenkette(""))
                return
            try:
                ziel = lege_sicherung_an(
                    nachricht.get("pfad") or "", "sicherung",
                    nachricht.get("kennwort") or "",
                    getattr(self, "_kennwort", ""))
                antwort = {"ok": bool(ziel), "pfad": ziel or "", "fehler": ""}
            except Exception as fehler:
                sys.stderr.write(_("Backup failed: %s") % fehler + "\n")
                antwort = {"ok": False, "pfad": "",
                           "fehler": fehler_deutsch(
                               fehler, _("Creating the backup"))}
            self.antwort("App.sicherungFertig", antwort)

        elif befehl == "journal_liste":
            self._journal_stand_melden()

        elif befehl == "journal_intervall":
            intervall = str(nachricht.get("intervall") or "weekly")
            if intervall not in JOURNAL_INTERVALLE:
                intervall = "weekly"
            with self._daten_sperre:
                if isinstance(self._aktuelle_daten, dict):
                    allgemein = self._aktuelle_daten.setdefault(
                        "einstellungen", {}).setdefault("allgemein", {})
                    allgemein["wiederherstellungsintervall"] = intervall
            self._journal_stand_melden()

        elif befehl == "journal_erzeugen":
            try:
                stand = self._journal_snapshot("manual")
                self.antwort("App.journalErgebnis", {"ok": True, "snapshot": stand})
            except Exception as fehler:
                self.antwort("App.journalErgebnis", {"ok": False,
                    "fehler": fehler_deutsch(fehler, _("Creating a recovery snapshot"))})
            self._journal_stand_melden()

        elif befehl == "journal_vorschau":
            try:
                stand, gelesen = journal_snapshot_lesen(
                    nachricht.get("snapshotId") or "", self._kennwort)
                self.antwort("App.journalVorschau", {"ok": True,
                    "snapshot": stand, "summary": gelesen["anzahlen"],
                    "photos": gelesen["fotos"], "attachments": gelesen["anhaenge"]})
            except Exception as fehler:
                self.antwort("App.journalVorschau", {"ok": False,
                    "fehler": fehler_deutsch(fehler, _("Previewing a recovery snapshot"))})

        elif befehl == "journal_loeschen":
            try:
                snapshot_id = _journal_uuid(nachricht.get("snapshotId"))
                ziel = os.path.join(journal_verzeichnis(), snapshot_id)
                if os.path.islink(ziel) or not os.path.isdir(ziel):
                    raise OSError(_("The recovery snapshot was not found."))
                shutil.rmtree(ziel)
                _verzeichnis_sync(journal_verzeichnis())
                self.antwort("App.journalErgebnis", {"ok": True, "deleted": True})
            except Exception as fehler:
                self.antwort("App.journalErgebnis", {"ok": False,
                    "fehler": fehler_deutsch(fehler, _("Deleting a recovery snapshot"))})
            self._journal_stand_melden()

        elif befehl == "journal_wiederherstellen":
            self._journal_wiederherstellen(nachricht.get("snapshotId") or "")

        elif befehl == "mutations_snapshot":
            grund = nachricht.get("reason") or ""
            token = str(nachricht.get("token") or "")[:128]
            try:
                if grund not in ("pre-contact-import", "pre-contact-merge",
                                  "pre-contact-delete"):
                    raise ValueError("reason")
                self._journal_snapshot(grund)
                self.antwort("App.mutationsSnapshot", {"ok": True, "token": token})
            except Exception as fehler:
                self.antwort("App.mutationsSnapshot", {"ok": False, "token": token,
                    "fehler": fehler_deutsch(fehler, _("Creating the required recovery snapshot"))})

        elif befehl == "sicherung_waehlen":
            pfad = self._datei_oeffnen(
                _("Restore backup"),
                [(_("Magnolie backup (*.json)"), "*.json"),
                 (_("All files"), "*")])
            if pfad:
                probe = sicherung_lesen(pfad)
                self.antwort("App.sicherungAusgewaehlt", {
                    "ok": bool(probe.get("ok") or
                               probe.get("brauchtKennwort")),
                    "pfad": pfad,
                    "verschluesselt": bool(probe.get("verschluesselt")),
                    "brauchtKennwort": bool(probe.get("brauchtKennwort")),
                    "fehler": probe.get("fehler") or ""})

        elif befehl == "sicherung_wiederherstellen":
            self._sicherung_wiederherstellen(
                nachricht.get("pfad") or "",
                nachricht.get("kennwort") or "",
                nachricht.get("sicherungsordner") or "")

        elif befehl == "gesamtarchiv_waehlen":
            self._gesamtarchiv_waehlen()

        elif befehl == "gesamtarchiv_pruefen":
            self._gesamtarchiv_pruefen(
                nachricht.get("pfad") or "", nachricht.get("kennwort") or "")

        elif befehl == "gesamtarchiv_importieren":
            self._gesamtarchiv_importieren(
                nachricht.get("pfad") or "", nachricht.get("kennwort") or "",
                nachricht.get("modus") or "",
                nachricht.get("sicherungsordner") or "")

        elif befehl == "gesamtarchiv_exportieren":
            self._gesamtarchiv_exportieren(nachricht.get("kennwort") or "")

        elif befehl == "import":
            self.bei_import(nachricht)

        elif befehl == "export":
            self.bei_export(nachricht)

        elif befehl == "notiz_anhang_datei":
            self.bei_notiz_anhang_datei(nachricht)

        elif befehl == "eds_status":
            threading.Thread(target=self._eds_status_arbeit, daemon=True).start()

        elif befehl == "baum_briefkasten_pruefen":
            threading.Thread(target=lambda: self._nextcloud_status_melden(
                "App.baumBriefkastenPruefung"), daemon=True).start()

        elif befehl == "baum_briefkasten_status":
            threading.Thread(target=lambda: self._nextcloud_status_melden(
                "App.baumBriefkastenStatus"), daemon=True).start()

        elif befehl == "baum_briefkasten_speichern":
            threading.Thread(target=lambda: self._nextcloud_speichern(
                bool(nachricht.get("davAktiv", nachricht.get("aktiv"))),
                bool(nachricht.get("briefkastenAktiv", nachricht.get("aktiv"))),
                nachricht.get("server") or
                nachricht.get("url") or "", nachricht.get("benutzer") or "",
                nachricht.get("appKennwort") or
                nachricht.get("anwendungskennwort") or
                nachricht.get("kennwort") or "",
                bool(nachricht.get("kennwortLoeschen")),
                "App.baumBriefkastenGespeichert"), daemon=True).start()

        elif befehl == "import_lokal":
            threading.Thread(target=self._import_lokal_arbeit, daemon=True).start()

        elif befehl == "feiertage":
            threading.Thread(target=self._feiertage_arbeit, args=(nachricht,),
                             daemon=True).start()

        elif befehl == "wetter":
            threading.Thread(target=self._wetter_arbeit, args=(nachricht,),
                             daemon=True).start()

        elif befehl == "update_pruefen":
            threading.Thread(target=self._update_pruefen_arbeit,
                             daemon=True).start()

        elif befehl == "update_oeffnen":
            threading.Thread(target=lambda: self.antwort(
                "App.updateGeoeffnet", update_paket_oeffnen(
                    nachricht.get("url") or "")), daemon=True).start()

        elif befehl == "medikament_suchen":
            threading.Thread(target=medikament_suche_oeffnen,
                             args=(nachricht.get("name") or "",), daemon=True).start()

        elif befehl == "handbuch_oeffnen":
            threading.Thread(target=lambda: self.antwort(
                "App.handbuchGeoeffnet", handbuch_oeffnen()),
                daemon=True).start()

        elif befehl == "handbuch_herunterladen":
            threading.Thread(target=lambda: self.antwort(
                "App.handbuchDownloadGeoeffnet", handbuch_paket_herunterladen(
                    nachricht.get("url") or "", nachricht.get("version") or "",
                    nachricht.get("sha256") or "", nachricht.get("platform") or "")),
                daemon=True).start()

        elif befehl == "rechtschreibung":
            self._rechtschreibung_setzen(
                bool(nachricht.get("an")), nachricht.get("sprache"))

        elif befehl == "brief":
            threading.Thread(target=lambda: self.antwort(
                "App.adressWeg", brief_oeffnen(nachricht.get("kontakt") or {},
                                               nachricht.get("absender") or "",
                                               layout=nachricht.get("layout")
                                               or "compact")),
                daemon=True).start()

        elif befehl == "ordner_waehlen":
            pfad = self._ordner_waehlen(
                _("Select backup folder"), nachricht.get("pfad") or "")
            if pfad:
                self.antwort("App.sicherungsordnerGewaehlt", {"pfad": pfad})

        elif befehl == "karte":
            threading.Thread(target=lambda: self.antwort(
                "App.adressWeg", karte_oeffnen(
                    nachricht.get("kontakt") or {},
                    nachricht.get("dienst") or "auto",
                    land=nachricht.get("land", "Deutschland"),
                    route=bool(nachricht.get("route")),
                    absender=nachricht.get("absender") or "")),
                daemon=True).start()

        elif befehl == "ablage_kopieren":
            self._ablage_setzen(nachricht.get("text") or "")

        elif befehl == "ablage_holen":
            self._ablage_holen()

        elif befehl == "baum_paarungsdatei_erzeugen":
            self._baum_paarungsdatei_erzeugen(
                nachricht.get("adresse") or "",
                int(nachricht.get("port") or BAUM_PORT))

        elif befehl == "baum_paarungsqr_erzeugen":
            self._baum_paarungsqr_erzeugen(
                nachricht.get("adresse") or "",
                int(nachricht.get("port") or BAUM_PORT))

        elif befehl == "baum_paarungsdatei_importieren":
            self._baum_paarungsdatei_import_waehlen()

        elif befehl == "baum_stand":
            threading.Thread(target=self._baum_stand_melden,
                             daemon=True).start()

        elif befehl == "telefon_status_anfordern":
            threading.Thread(target=lambda: self._telefon_status_anfordern(
                 nachricht.get("kennung") or ""), daemon=True).start()

        elif befehl == "telefon_stand":
            threading.Thread(target=self._telefon_stand_melden, daemon=True).start()

        elif befehl == "kde_reconnect":
            threading.Thread(target=self._kde_reconnect, daemon=True).start()

        elif befehl == "telefon_ein":
            threading.Thread(target=lambda: self._telefon_schalten(
                bool(nachricht.get("an"))), daemon=True).start()

        elif befehl == "telefon_pairing_oeffnen":
            threading.Thread(target=self._telefon_pairing_oeffnen, daemon=True).start()

        elif befehl == "telefon_pairing_bestaetigen":
            if self._telefon:
                self._telefon.confirm_pairing(nachricht.get("attemptId") or "",
                                               bool(nachricht.get("ja")))

        elif befehl == "telefon_pairing_abbrechen":
            if self._telefon:
                self._telefon.cancel_pairing()

        elif befehl == "telefon_entfernen":
            threading.Thread(target=lambda: self._telefon_entfernen(
                nachricht.get("kennung") or ""), daemon=True).start()

        elif befehl == "telefon_bluetooth_schalten":
            threading.Thread(target=lambda: self._telefon_bluetooth_schalten(
                nachricht.get("kennung") or "", bool(nachricht.get("an")),
                nachricht.get("adresse") or ""), daemon=True).start()

        elif befehl == "telefon_freigabe":
            threading.Thread(target=lambda: self._telefon_freigabe(
                nachricht.get("kennung") or "", nachricht.get("name") or "",
                bool(nachricht.get("an"))), daemon=True).start()

        elif befehl == "personal_sync_einstellungen":
            threading.Thread(target=lambda: self._personal_sync_einstellungen(
                nachricht.get("kennung") or "", bool(nachricht.get("eigen")),
                bool(nachricht.get("autoWlan"))), daemon=True).start()

        elif befehl == "personal_sync_senden":
            threading.Thread(target=lambda: self._personal_sync_senden(
                nachricht.get("kennung") or "", nachricht.get("art") or "",
                nachricht.get("inhalt") or {},
                (nachricht.get("inhalt") or {}).get("trigger") or "manual"),
                daemon=True).start()

        elif befehl == "personal_sync_lauf_senden":
            threading.Thread(target=lambda: self._personal_sync_lauf_senden(
                nachricht.get("kennung") or "", nachricht.get("request") or {},
                nachricht.get("batches") or [], nachricht.get("sources") or [],
                (nachricht.get("request") or {}).get("trigger") or "manual",
                nachricht.get("report"),
                nachricht.get("commit")), daemon=True).start()

        elif befehl == "personal_sync_attachment_index":
            threading.Thread(target=lambda: self._personal_sync_attachment_index(
                nachricht.get("kennung") or "", nachricht.get("runId") or "",
                bool(nachricht.get("reply")), nachricht.get("recordsHash") or "",
                nachricht.get("sources") or []), daemon=True).start()

        elif befehl == "telefon_personal_sync_commit":
            threading.Thread(target=lambda: self._personal_sync_commit(
                nachricht.get("kennung") or "", nachricht.get("messageId") or "",
                nachricht.get("token") or "", nachricht.get("erfolgreich") is True),
                daemon=True).start()

        elif befehl == "telefon_waehlen":
            threading.Thread(target=lambda: self._telefon_waehlen(
                nachricht.get("nummer") or "", nachricht.get("clientRef") or "",
                nachricht.get("land") or "DE"), daemon=True).start()

        elif befehl == "telefon_annehmen":
            threading.Thread(target=lambda: self._telefon_annehmen(
                nachricht.get("kennung") or "", nachricht.get("callRef") or "",
                nachricht.get("commandRef") or ""), daemon=True).start()

        elif befehl == "telefon_auflegen":
            threading.Thread(target=lambda: self._telefon_auflegen(
                nachricht.get("kennung") or "", nachricht.get("callRef") or "",
                int(nachricht.get("revision") or 0), nachricht.get("commandRef") or ""),
                daemon=True).start()

        elif befehl == "kde_sms_senden":
            threading.Thread(target=lambda: self._kde_sms_senden(
                nachricht.get("nummer") or "", nachricht.get("text") or "",
                nachricht.get("land") or "DE", nachricht.get("clientRef") or ""),
                daemon=True).start()

        elif befehl == "kde_pairing_start":
            threading.Thread(target=lambda: self._kde_pairing_start(
                nachricht.get("kennung") or "", bool(nachricht.get("erneuern"))),
                daemon=True).start()

        elif befehl == "kde_pairing_complete":
            threading.Thread(target=lambda: self._kde_pairing_complete(
                nachricht.get("kennung") or ""), daemon=True).start()

        elif befehl == "kde_pairing_confirm":
            threading.Thread(target=lambda: self._kde_pairing_confirm(
                bool(nachricht.get("ja"))), daemon=True).start()

        elif befehl == "telefon_sms_benachrichtigen":
            self._telefon_sms_benachrichtigen(nachricht)

        elif befehl == "telefon_meldung_anzeigen":
            self._telefon_meldung_anzeigen(nachricht)

        elif befehl == "telefon_anruf_anzeigen":
            self._telefon_anruf_anzeigen(nachricht)
        elif befehl == "telefon_anruf_lautstaerke_wiederherstellen":
            _ANRUF_LAUTSTAERKE.restore(str(nachricht.get("callRef") or ""))

        elif befehl == "baum_ein":
            threading.Thread(
                target=lambda: self._baum_schalten(
                    bool(nachricht.get("an")),
                    nachricht.get("name") or ""), daemon=True).start()

        elif befehl == "baum_suchen":
            threading.Thread(target=self._baum_suchen_arbeit,
                             daemon=True).start()

        elif befehl == "baum_paaren":
            threading.Thread(
                target=lambda: self._baum_paaren(
                    nachricht.get("adresse") or "",
                    int(nachricht.get("port") or BAUM_PORT),
                    nachricht.get("fingerabdruck") or ""),
                daemon=True).start()

        elif befehl == "baum_internet_adresse":
            threading.Thread(target=self._baum_internet_adresse,
                             daemon=True).start()

        elif befehl == "baum_bestaetigen":
            threading.Thread(
                target=lambda: self._baum_bestaetigen(
                    nachricht.get("kennung") or "",
                    bool(nachricht.get("ja"))), daemon=True).start()

        elif befehl == "baum_entfernen":
            threading.Thread(
                target=lambda: self._baum_entfernen(
                    nachricht.get("kennung") or ""), daemon=True).start()

        elif befehl == "baum_delegieren":
            threading.Thread(
                target=lambda: self._baum_delegieren(
                    nachricht.get("kennung") or "",
                    nachricht.get("aufgabe") or {}), daemon=True).start()

        elif befehl == "baum_teilen":
            threading.Thread(
                target=lambda: self._baum_teilen(
                    nachricht.get("kennung") or "",
                    nachricht.get("art") or "",
                    nachricht.get("inhalt") or {}), daemon=True).start()

        elif befehl == "baum_rueckmeldung":
            threading.Thread(
                target=lambda: self._baum_rueckmeldung(
                    nachricht.get("kennung") or "",
                    nachricht.get("stand") or {}), daemon=True).start()

        elif befehl == "baum_eingang_geleert":
            threading.Thread(
                target=lambda: self._baum_eingang_leeren(
                    nachricht.get("ids") or []), daemon=True).start()

        elif befehl == "lo_benutzer":
            threading.Thread(target=lambda: self.antwort(
                "App.loBenutzer", libreoffice_benutzerdaten()),
                daemon=True).start()

        elif befehl == "baum_partner_einstellungen":
            threading.Thread(
                target=lambda: self._baum_partner_einstellungen(
                    nachricht.get("kennung") or "", nachricht.get("vertraut"),
                    nachricht.get("fernAdresse") or "", nachricht.get("fernPort"),
                    nachricht.get("kontakte", False),
                    nachricht.get("kontaktLoeschen", False)),
                daemon=True).start()

        elif befehl == "mail":
            threading.Thread(target=lambda: self.antwort(
                "App.adressWeg", mail_oeffnen(nachricht.get("email") or "", name=
                                               nachricht.get("name") or "")),
                daemon=True).start()

        elif befehl == "sozial":
            threading.Thread(target=lambda: self.antwort(
                "App.adressWeg", sozial_oeffnen(
                    nachricht.get("dienst") or "",
                    nachricht.get("wert") or "",
                    land=nachricht.get("land") or "Deutschland",
                    aktion_art=nachricht.get("aktionArt") or "",
                    aktion_ziel=nachricht.get("aktionZiel") or "")), daemon=True).start()

        elif befehl == "drucken":
            self._drucken(nachricht.get("html") or "")

        elif befehl == "adressen_ods":
            threading.Thread(target=lambda: self.antwort(
                "App.adressWeg", adressen_ods_exportieren(
                    nachricht.get("titel"), nachricht.get("spalten"),
                    nachricht.get("zeilen"))), daemon=True).start()

        elif befehl == "gesundheit_ods":
            threading.Thread(target=lambda: self.antwort(
                "App.adressWeg", gesundheit_ods_exportieren(
                    nachricht.get("tabellen"))), daemon=True).start()

        elif befehl == "planer_ods":
            threading.Thread(target=lambda: self.antwort(
                "App.adressWeg", planer_ods_exportieren(
                    nachricht.get("titel"), nachricht.get("spalten"),
                    nachricht.get("zeilen"), nachricht.get("stile"),
                     nachricht.get("jahr"), nachricht.get("layout") or "year",
                     nachricht.get("monat") or 0,
                     inhalte=nachricht.get("inhalte"))), daemon=True).start()

        elif befehl == "protokoll_zeigen":
            threading.Thread(target=self._protokoll_zeigen_arbeit,
                             daemon=True).start()

        elif befehl == "vorschlaege":
            threading.Thread(target=self._vorschlaege_arbeit,
                             args=(nachricht,), daemon=True).start()

        elif befehl == "erinnerung_einrichten":
            threading.Thread(target=self._erinnerung_einrichten_arbeit,
                             args=(nachricht,), daemon=True).start()

        elif befehl == "erinnerung_zeigen":
            threading.Thread(target=self._erinnerung_zeigen_arbeit,
                             args=(nachricht,), daemon=True).start()

        elif befehl == "wort_merken":
            threading.Thread(target=self._wort_merken_arbeit,
                             args=(nachricht,), daemon=True).start()

        elif befehl in ("sync", "sync_start"):
            if self._sync_laeuft or self._operation_laeuft:
                return
            self._sync_laeuft = True
            threading.Thread(target=self._sync_arbeit, args=(nachricht,),
                             daemon=True).start()

    # ------------------------------------------------------- Import/Export

    def bei_import(self, nachricht):
        art = nachricht.get("art")
        einstellungen = {
            "ics": (_("Import calendar file"),
                    [(_("iCalendar (*.ics)"), "*.ics"),
                     (_("ZIP archives (*.zip)"), "*.zip"),
                     (_("vCalendar (*.vcs)"), "*.vcs"),
                     (_("Lotus Calendar (*.lcs)"), "*.lcs"),
                     (_("All files"), "*")]),
            "lotus": (_("Import Lotus Organizer CSV"),
                      [(_("CSV files (*.csv)"), "*.csv"),
                       (_("ZIP archives (*.zip)"), "*.zip"), (_("All files"), "*")]),
            "vcf": (_("Import contacts"),
                    [(_("Contact cards (*.vcf)"), "*.vcf"),
                     (_("CSV files (*.csv)"), "*.csv"),
                     (_("ZIP archives (*.zip)"), "*.zip"), (_("All files"), "*")]),
            "claws": (_("Import Claws Mail contacts"),
                      [(_("Claws Mail address book (*.xml)"), "*.xml"),
                        ("LDIF (*.ldif, *.ldi)", "*.ldif"),
                        ("LDIF (*.ldi)", "*.ldi"),
                        (_("ZIP archives (*.zip)"), "*.zip"), (_("All files"), "*")]),
        }.get(art)
        if not einstellungen:
            return
        pfad = self._datei_oeffnen(einstellungen[0], einstellungen[1])
        if not pfad:
            self.antwort("App.importErgebnis", {"art": art, "abgebrochen": True})
            return
        try:
            roh = datei_begrenzt_lesen(
                pfad, IMPORT_DATEI_MAX,
                _("The import file is larger than 32 megabytes."))
            nutzlast = import_rohdaten_lesen(art, roh, os.path.basename(pfad))
        except GroessenFehler as fehler:
            self.antwort("App.importErgebnis",
                         {"art": art, "abgebrochen": False,
                          "fehler": str(fehler)})
            return
        except (OSError, ValueError, TypeError, csv.Error, ET.ParseError,
                zipfile.BadZipFile) as fehler:
            self.antwort("App.importErgebnis",
                         {"art": art, "abgebrochen": False,
                           "fehler": _("File could not be read: %s") % fehler})
            return
        nutzlast["art"] = art
        nutzlast["abgebrochen"] = False
        nutzlast["datei"] = os.path.basename(pfad)
        self.antwort("App.importErgebnis", nutzlast)

    def bei_notiz_anhang_datei(self, nachricht, starter=None):
        kennung = nachricht.get("id")
        aktion = nachricht.get("aktion")
        antwort = {"id": kennung, "ok": False, "abgebrochen": False, "fehler": ""}
        if (isinstance(kennung, bool) or not isinstance(kennung, int) or kennung < 1 or
                aktion not in ("open", "save")):
            antwort["fehler"] = _("The file has an unsupported format.")
            self.antwort("App.notizAnhangDateiErgebnis", antwort)
            return
        try:
            anhang = notiz_anhang_dekodieren(nachricht.get("daten"),
                                             nachricht.get("name"))
            endung = NOTIZ_ANHANG_ARTEN[anhang["mime"]][0]
            filter_liste = [(_("All files"), "*" + endung)]
            if aktion == "save":
                pfad = self._datei_speichern(_("Save as…"), anhang["name"], filter_liste)
                if not pfad:
                    antwort["abgebrochen"] = True
                else:
                    atomar_binaer_schreiben(pfad, anhang["daten"])
                    antwort.update({"ok": True, "pfad": pfad})
            else:
                if not self._notiz_anhang_temp:
                    self._notiz_anhang_temp = tempfile.mkdtemp(prefix="magnolie-attachment-")
                    os.chmod(self._notiz_anhang_temp, 0o700)
                pfad = os.path.join(self._notiz_anhang_temp, anhang["name"])
                atomar_binaer_schreiben(pfad, anhang["daten"])
                werkzeug = shutil.which("xdg-open")
                if not werkzeug:
                    raise OSError(_("No suitable application was found."))
                if starter is None:
                    starter = lambda argumente: subprocess.Popen(
                        argumente, start_new_session=True,
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                starter([werkzeug, pfad])
                antwort.update({"ok": True})
        except ValueError as fehler:
            antwort["fehler"] = str(fehler)
        except OSError as fehler:
            antwort["fehler"] = (_("The file could not be written (%s).") % fehler
                                 if aktion == "save" else
                                 _("The file could not be read."))
        self.antwort("App.notizAnhangDateiErgebnis", antwort)

    def bei_export(self, nachricht):
        art = nachricht.get("art")
        liste = nachricht.get("daten") or []
        einstellungen = {
            "ics-termine": (_("Save appointments"), "magnolie-termine.ics",
                            [(_("Calendar (*.ics)"), "*.ics")],
                            ics_schreiben_termine, "utf-8"),
            "ics-jahrestage": (_("Save anniversaries"), "magnolie-jahrestage.ics",
                               [(_("Calendar (*.ics)"), "*.ics")],
                               ics_schreiben_jahrestage, "utf-8"),
            "ics-aufgaben": (_("Save tasks"), "magnolie-aufgaben.ics",
                             [(_("Calendar (*.ics)"), "*.ics")],
                             ics_schreiben_aufgaben, "utf-8"),
            "csv-termine": (_("Save Lotus CSV"), "magnolie-termine-lotus.csv",
                            [(_("CSV files (*.csv)"), "*.csv")],
                            lotus_csv_schreiben, "utf-8-sig"),
            "vcf-adressen": (_("Save contacts"), "magnolie-adressen.vcf",
                              [(_("Contact cards (*.vcf)"), "*.vcf")],
                              vcf_schreiben, "utf-8"),
            "ldif-adressen": (_("Save contacts for Claws Mail"),
                               "magnolie-adressen-claws.ldif",
                               [(_("LDIF address book (*.ldif)"), "*.ldif")],
                               ldif_schreiben, "utf-8"),
        }.get(art)
        if not einstellungen:
            return
        titel, vorschlag, filter_liste, wandler, zeichensatz = einstellungen
        pfad = self._datei_speichern(titel, vorschlag, filter_liste)
        if not pfad:
            self.antwort("App.exportErgebnis", {"art": art, "abgebrochen": True})
            return
        try:
            uebersprungen = 0
            ldif_unbrauchbar = 0
            ldif_foto_verloren = 0
            anzahl = len(liste)
            bericht = ""
            block_wandler = {
                "ics-termine": _ics_termine_bloecke,
                "ics-jahrestage": _ics_jahrestage_bloecke,
                "ics-aufgaben": _ics_aufgaben_bloecke,
            }.get(art)
            if block_wandler:
                bloecke, uebersprungen = block_wandler(liste)
                inhalt = _vcalendar(bloecke)
                anzahl = len(bloecke)
            elif art == "ldif-adressen":
                inhalt, uebersprungen, foto_verloren = _ldif_export(liste)
                anzahl = len(liste) - uebersprungen
                ldif_unbrauchbar = uebersprungen
                ldif_foto_verloren = foto_verloren
            else:
                inhalt = wandler(liste)
            if art == "csv-termine":
                verluste = sum(1 for eintrag in liste if
                               wiederholung_art((eintrag.get("wiederholung") or {}).get("art")) != "none" or
                               eintrag.get("individuelleErinnerungTage") or
                               eintrag.get("standardErinnerung") is False or
                               eintrag.get("icsRoundtrip"))
                if verluste:
                    bericht = ("%d Termine enthalten Serien-, Erinnerungs- oder ICS-Zusatzdaten, "
                               "die Lotus CSV standardbedingt nicht darstellen kann." % verluste)
            if art == "ldif-adressen":
                atomar_text_schreiben(pfad, inhalt, modus=0o600)
            else:
                with open(pfad, "w", encoding=zeichensatz, newline="") as datei:
                    datei.write(inhalt)
            self.antwort("App.exportErgebnis",
                         {"art": art, "abgebrochen": False, "ok": True,
                            "pfad": pfad, "anzahl": anzahl,
                            "uebersprungen": (0 if art == "ldif-adressen" else uebersprungen),
                            "ldifUnbrauchbar": ldif_unbrauchbar,
                            "ldifFotoVerloren": ldif_foto_verloren,
                            "bericht": bericht})
        except (OSError, TypeError, ValueError) as fehler:
            self.antwort("App.exportErgebnis",
                         {"art": art, "abgebrochen": False, "ok": False,
                           "fehler": _("The file could not be written (%s).") % fehler})

    # -------------------------------------------------------- EDS-Arbeiten

    def _rechtschreibung_setzen(self, an, sprache=None):
        """Schaltet die Rechtschreibprüfung von WebKit um. Die roten
        Wellenlinien zeichnet WebKit selbst, sobald ein Wörterbuch für die
        gewählte Oberflächensprache vorhanden ist."""
        try:
            kontext = self.ansicht.get_context()
        except AttributeError:
            return
        try:
            if an:
                kontext.set_spell_checking_languages(
                    rechtschreib_sprachen(sprache))
            kontext.set_spell_checking_enabled(bool(an))
        except (AttributeError, TypeError):
            pass

    def _erinnerung_einrichten_arbeit(self, nachricht):
        an = bool(nachricht.get("an"))
        ergebnis = erinnerungsdienst_einrichten(an)
        if an:
            wecker_starten()
        if an and nachricht.get("wecken"):
            weck = weckruf_stellen(naechster_weckzeitpunkt(
                {"termine": nachricht.get("termine") or []}, _organizer_jetzt(),
                int(nachricht.get("vorlauf") or 15)))
            ergebnis["weckruf"] = weck
        self.antwort("App.erinnerungStand", ergebnis)

    def _erinnerung_zeigen_arbeit(self, nachricht):
        art = erinnerungs_art(nachricht.get("art"))
        if os.environ.get("WAYLAND_DISPLAY"):
            art = "both"
        kopf = nachricht.get("kopf") or _("Appointment")
        rumpf = nachricht.get("rumpf") or ""
        if art in ("sound", "both"):
            ton_abspielen(eigener=nachricht.get("stil") == "magnolie")
        if art in ("notification", "both"):
            stil = nachricht.get("stil") or "system"
            if os.environ.get("WAYLAND_DISPLAY"):
                stil = "system"
            if stil == "magnolie":
                # Auf dem Bildschirm, nicht im Buch: der Organizer kann
                # verdeckt oder eingeklappt sein.
                ergebnis = {}

                def zeigen():
                    ergebnis["gezeigt"] = magnolie_meldung(
                        kopf, rumpf, wartezeit=45, mit_aktion=False,
                        eigene_schleife=False)
                    if not ergebnis["gezeigt"]:
                        benachrichtigen(kopf, rumpf, mit_aktion=False,
                                        wartezeit=20)
                    return False

                GLib.idle_add(zeigen)
            else:
                benachrichtigen(kopf, rumpf, mit_aktion=False, wartezeit=20)

    def _drucken(self, html):
        """Der Druckdialog gehört auf den Hauptfaden."""
        ergebnis = drucken(html)
        self._druckansicht = ergebnis.pop("ansicht", None)
        self.antwort("App.adressWeg", ergebnis)

    def _vielleicht_verschluesseln(self, text):
        """Verschlüsselt den Text, wenn ein Kennwort gesetzt ist."""
        if getattr(self, "_kennwort", ""):
            if (not isinstance(getattr(self, "_daten_dek", None), bytes)
                    or not isinstance(getattr(self, "_daten_dek_kennung", None), bytes)
                    or not isinstance(getattr(self, "_daten_umschlag", None), dict)):
                raise RuntimeError(_("The data key is not available."))
            return daten_verschluesseln(
                text, self._kennwort, self._daten_dek,
                self._daten_dek_kennung, self._daten_umschlag)
        return text

    def _speicher_lauf(self):
        """Schreibt Save-Aufträge seriell außerhalb des GTK-Hauptfadens."""
        while True:
            auftrag = self._speicher_auftraege.get()
            if auftrag is None:
                self._speicher_auftraege.task_done()
                return
            kennung, klartext = auftrag
            self._speicher_laeuft = True
            try:
                with self._daten_sperre:
                    daten = json.loads(klartext)
                    if not isinstance(daten, dict):
                        raise ValueError(_("The data is not a JSON object."))
                    if getattr(self, "_kennwort", ""):
                        erinnerungsdaten_schreiben(daten)
                    else:
                        erinnerungsdaten_schreiben({})
                    speichere_text(self._vielleicht_verschluesseln(klartext))
                    self._aktuelle_daten = daten
                ergebnis = {"id": kennung, "ok": True, "fehler": ""}
            except Exception as fehler:
                sys.stderr.write(_("Saving failed: %s") % fehler + "\n")
                self._beenden_angefragt = False
                self._beenden_speicherfehler = True
                ergebnis = {
                    "id": kennung, "ok": False,
                    "fehler": fehler_deutsch(fehler, _("Saving the data"))}
            finally:
                self._speicher_laeuft = False
                self._speicher_auftraege.task_done()
            self.antwort("App.gespeichert", ergebnis)

    def _darf_schreiben(self):
        """Letzte Sicherung: Über eine verschlüsselte Datei wird niemals
        Klartext geschrieben, solange das Kennwort nicht eingegeben ist.
        Ein Fehler in der Oberfläche darf keine Daten kosten."""
        if getattr(self, "_operation_laeuft", False):
            return False
        if getattr(self, "_kennwort", ""):
            return True
        try:
            with open(daten_datei(), "r", encoding="utf-8") as datei:
                anfang = datei.read(400)
        except OSError:
            return True
        return not sieht_verschluesselt_aus(anfang)

    def _journal_snapshot(self, grund):
        with self._daten_sperre:
            daten = getattr(self, "_aktuelle_daten", None)
            if not isinstance(daten, dict):
                raise RuntimeError(_("The current organizer data is incomplete."))
            return journal_snapshot_erzeugen(daten, grund, self._kennwort)

    def _journal_stand_melden(self):
        try:
            staende = journal_liste(kennwort=self._kennwort)
            allgemein = ((self._aktuelle_daten or {}).get("einstellungen") or {}).get(
                "allgemein") or {}
            intervall = allgemein.get("wiederherstellungsintervall", "weekly")
            if intervall not in JOURNAL_INTERVALLE:
                intervall = "weekly"
            periodisch = next((s for s in staende if s.get("reason") == "weekly"), None)
            letzter = periodisch.get("createdAt") if periodisch else ""
            naechster = ""
            if letzter and JOURNAL_INTERVALLE[intervall]:
                naechster = (_journal_zeit(letzter) + timedelta(
                    seconds=JOURNAL_INTERVALLE[intervall])).isoformat().replace("+00:00", "Z")
            self.antwort("App.journalStand", {"ok": True, "snapshots": staende,
                "interval": intervall, "last": letzter, "next": naechster,
                "status": allgemein.get("wiederherstellungsstatus", "")})
        except Exception as fehler:
            self.antwort("App.journalStand", {"ok": False, "snapshots": [],
                "fehler": fehler_deutsch(fehler, _("Reading recovery snapshots"))})

    def _journal_periodisch(self):
        if self._gesperrt or self._operation_laeuft or self._sync_laeuft:
            return True
        daten = self._aktuelle_daten or {}
        allgemein = (daten.get("einstellungen") or {}).get("allgemein") or {}
        intervall = allgemein.get("wiederherstellungsintervall", "weekly")
        periodisch = next((s for s in journal_liste(integritaet=False)
                           if s.get("reason") == "weekly"), None)
        if journal_faellig(intervall, periodisch.get("createdAt") if periodisch else None):
            try:
                self._journal_snapshot("weekly")
                allgemein["wiederherstellungsstatus"] = "ok"
            except Exception as fehler:
                allgemein["wiederherstellungsstatus"] = str(fehler)
                debug_notiz("snapshot.periodic.skipped", error=fehler)
            self._journal_stand_melden()
        return True

    def _journal_planen(self):
        if self._journal_timer:
            return
        GLib.idle_add(lambda: (self._journal_periodisch(), False)[1])
        self._journal_timer = GLib.timeout_add_seconds(15 * 60,
                                                       self._journal_periodisch)

    def _journal_wiederherstellen(self, snapshot_id):
        if (getattr(self, "_operation_laeuft", False) or
                getattr(self, "_sync_laeuft", False)):
            self.antwort("App.journalWiederhergestellt", {"ok": False,
                "fehler": _("Another data operation is still running.")})
            return
        self._operation_laeuft = True
        try:
            with self._daten_sperre:
                _stand, gelesen = journal_snapshot_lesen(snapshot_id, self._kennwort)
                vorher = self._journal_snapshot("pre-restore")
                daten = journal_restore_daten(gelesen["daten"])
                klar = json.dumps(daten, ensure_ascii=False, indent=1)
                atomar_text_schreiben(daten_datei(), self._vielleicht_verschluesseln(klar))
                erinnerungsdaten_schreiben(daten if self._kennwort else {})
                self._aktuelle_daten = daten
            self.antwort("App.journalWiederhergestellt", {"ok": True,
                "daten": daten, "vorher": vorher["snapshotId"],
                "syncEpoch": daten["syncMetadaten"]["syncEpoch"]})
        except Exception as fehler:
            self.antwort("App.journalWiederhergestellt", {"ok": False,
                "fehler": fehler_deutsch(fehler, _("Restoring a recovery snapshot"))})
        finally:
            self._operation_laeuft = False
            self._journal_stand_melden()

    def _oeffnen_oder_sperren(self):
        """Beim Start: Sind die Daten verschlüsselt, wird zuerst nach dem
        Kennwort gefragt."""
        start = time.monotonic()
        self._kennwort = getattr(self, "_kennwort", "")
        try:
            kennwort_transaktion_reparieren()
        except RuntimeError as fehler:
            self._gesperrt = True
            self.antwort("App.init", {"gesperrt": True, "neu": False,
                                      "datenPfad": daten_datei(),
                                      "handbuchInstalliert": handbuch_installiert(),
                                      "handbuchVersion": handbuch_version(),
                                      "trayVerfuegbar": tray_system_verfuegbar(),
                                       "trayEinstellungen": self._tray_einstellungen,
                                      "contributorAktiv": bool(getattr(
                                          self, "_contributor_hash", "")),
                                      "regional": self._regional, "wartet": 0,
                                      "wayland": bool(os.environ.get(
                                          "WAYLAND_DISPLAY"))})
            self.antwort("App.entsperrtFehler", {
                "wartet": 0,
                "fehler": fehler_deutsch(
                    fehler, _("Recovering the password transaction"))})
            return
        try:
            with open(daten_datei(), "r", encoding="utf-8") as datei:
                roh = datei.read()
        except OSError:
            roh = ""
        debug_notiz("startup.data-read",
                    duration_ms=round((time.monotonic() - start) * 1000, 1),
                    bytes=len(roh.encode("utf-8")))
        if ist_verschluesselt(roh):
            self._gesperrt = True
            self._tray_telefone_aktualisieren()
            zustand = sperre_lesen()
            erlaubt, sekunden = sperre_pruefen(zustand)
            self.antwort("App.init", {"gesperrt": True, "neu": False,
                                      "datenPfad": daten_datei(),
                                       "handbuchInstalliert": handbuch_installiert(),
                                       "handbuchVersion": handbuch_version(),
                                       "trayVerfuegbar": tray_system_verfuegbar(),
                                       "trayEinstellungen": self._tray_einstellungen,
                                       "contributorAktiv": bool(getattr(
                                           self, "_contributor_hash", "")),
                                       "regional": self._regional,
                                      "wartet": 0 if erlaubt else sekunden,
                                      "wayland": bool(os.environ.get(
                                          "WAYLAND_DISPLAY"))})
            return
        self._gesperrt = False
        laden_start = time.monotonic()
        daten, ist_neu, migriert = lade_daten()
        gruppen = {}
        if isinstance(daten, dict):
            for name in ("termine", "aufgaben", "kontakte", "notizen",
                         "jahrestage", "feiertage", "tagmarken"):
                wert = daten.get(name)
                if isinstance(wert, list):
                    gruppen[name] = len(wert)
        debug_notiz("startup.data-loaded",
                    duration_ms=round((time.monotonic() - laden_start) * 1000, 1),
                    migrated=migriert, new=ist_neu, **gruppen)
        self._aktuelle_daten = daten
        senden_start = time.monotonic()
        self.antwort("App.init", {"daten": daten, "neu": ist_neu,
                                  "datenPfad": daten_datei(),
                                  "migriert": migriert,
                                  "kennwort": bool(self._kennwort),
                                  "handbuchInstalliert": handbuch_installiert(),
                                  "handbuchVersion": handbuch_version(),
                                  "trayVerfuegbar": tray_system_verfuegbar(),
                                  "trayEinstellungen": self._tray_einstellungen,
                                  "contributorAktiv": bool(getattr(
                                      self, "_contributor_hash", "")),
                                  "regional": self._regional,
                                  "wayland": bool(os.environ.get(
                                          "WAYLAND_DISPLAY"))})
        debug_notiz("startup.data-dispatched",
                    duration_ms=round((time.monotonic() - senden_start) * 1000, 1),
                    total_ms=round((time.monotonic() - start) * 1000, 1))
        journal_planen = getattr(self, "_journal_planen", None)
        if journal_planen:
            journal_planen()

    def _entsperren(self, kennwort):
        zustand = sperre_lesen()
        erlaubt, sekunden = sperre_pruefen(zustand)
        if not erlaubt:
            self.antwort("App.entsperrtFehler",
                         {"wartet": sekunden,
                          "fehler": _("Too many failed attempts. Wait a moment.")})
            return
        try:
            with open(daten_datei(), "r", encoding="utf-8") as datei:
                roh = datei.read()
            huelle = json.loads(roh)
            ist_alt = huelle.get("fassung") == 1
            if ist_alt:
                klar = entschluesseln(roh, kennwort)
                neue_daten, daten_dek, daten_dek_kennung, daten_umschlag = (
                    daten_huelle_anlegen(klar, kennwort))
            else:
                (klar, daten_dek, daten_dek_kennung,
                 daten_umschlag) = daten_entschluesseln(
                    roh, kennwort, mit_schluessel=True)
                neue_daten = None
            daten = json.loads(klar)
        except RuntimeError as fehler:
            neu = sperre_fehlversuch(zustand)
            sperre_schreiben(neu)
            _erlaubt, wartet = sperre_pruefen(neu)
            self.antwort("App.entsperrtFehler",
                         {"wartet": wartet, "fehler": str(fehler)})
            return
        except (OSError, ValueError):
            self.antwort("App.entsperrtFehler",
                         {"wartet": 0,
                          "fehler": _("The file could not be read.")})
            return

        try:
            with self._daten_sperre, self._baum_sperre:
                baum_migration = baum_ablagen_vorbereiten(
                    kennwort, kennwort)
                neue_dateien = dict(baum_migration["dateien"])
                if neue_daten is not None:
                    neue_dateien["daten.json"] = neue_daten
                if neue_dateien:
                    kennwort_transaktion_ausfuehren(
                        neue_dateien, "entsperrmigration")
                Fenster._baum_migration_uebernehmen(self, baum_migration)
        except Exception as fehler:
            self.antwort("App.entsperrtFehler", {
                "wartet": 0,
                "fehler": fehler_deutsch(
                    fehler, _("Unlocking the Magnolienbaum storage"))})
            return
        self._kennwort = kennwort
        self._daten_dek = daten_dek
        self._daten_dek_kennung = daten_dek_kennung
        self._daten_umschlag = daten_umschlag
        self._gesperrt = False
        self._aktuelle_daten = daten
        sperre_schreiben(sperre_zuruecksetzen())
        self.antwort("App.init", {"daten": daten, "neu": False,
                                  "datenPfad": daten_datei(),
                                  "kennwort": True,
                                  "handbuchInstalliert": handbuch_installiert(),
                                  "handbuchVersion": handbuch_version(),
                                  "trayVerfuegbar": tray_system_verfuegbar(),
                                  "trayEinstellungen": self._tray_einstellungen,
                                  "contributorAktiv": bool(getattr(
                                      self, "_contributor_hash", "")),
                                  "regional": self._regional,
                                  "wayland": bool(os.environ.get(
                                       "WAYLAND_DISPLAY"))})
        journal_planen = getattr(self, "_journal_planen", None)
        if journal_planen:
            journal_planen()
        threading.Thread(target=self._baum_dienst_pflegen, daemon=True).start()
        telefon_pflegen = getattr(self, "_telefon_dienst_pflegen", None)
        if telefon_pflegen:
            threading.Thread(target=telefon_pflegen, daemon=True).start()

    def _kennwort_setzen(self, neu, alt, mit_sicherungen=True,
                         sicherungsordner=""):
        """Richtet den Kennwortschutz ein oder ändert das Kennwort."""
        if not kennwort_moeglich():
            self.antwort("App.kennwortStand", {
                "ok": False, "fehler":
                    _("An encryption component is missing. Install it with: "
                      "sudo apt install python3-cryptography")})
            return
        if len(neu) < 4:
            self.antwort("App.kennwortStand", {
                "ok": False, "fehler": _("Choose at least four characters.")})
            return
        # Der Organizer ist bereits entsperrt – das bisherige Kennwort ist
        # also bekannt und muss nicht noch einmal eingetippt werden.
        bisher = getattr(self, "_kennwort", "")
        try:
            with self._daten_sperre, self._baum_sperre:
                with open(daten_datei(), "r", encoding="utf-8") as datei:
                    roh = datei.read()
                klar = entschluesseln(roh, bisher) if ist_verschluesselt(roh) else roh
                baum_migration = baum_ablagen_vorbereiten(neu, bisher)
                neue_dateien = dict(baum_migration["dateien"])
                if (bisher and ist_verschluesselt(roh)
                        and json.loads(roh).get("fassung") == 2):
                    (neue_huelle, daten_dek, daten_dek_kennung,
                     daten_umschlag) = daten_umschlagen(roh, bisher, neu)
                else:
                    (neue_huelle, daten_dek, daten_dek_kennung,
                     daten_umschlag) = daten_huelle_anlegen(klar, neu)
                neue_dateien["daten.json"] = neue_huelle
                kennwort_transaktion_ausfuehren(
                    neue_dateien, "aendern" if bisher else "setzen")
                Fenster._baum_migration_uebernehmen(self, baum_migration)
                erinnerungsdaten_schreiben(json.loads(klar))
                self._kennwort = neu
                self._daten_dek = daten_dek
                self._daten_dek_kennung = daten_dek_kennung
                self._daten_umschlag = daten_umschlag
        except Exception as fehler:
            self.antwort("App.kennwortStand", {
                "ok": False,
                "fehler": fehler_deutsch(fehler, _("Encrypting the data"))})
            return
        bericht = {}
        if mit_sicherungen:
            bericht = sicherungen_umschluesseln(
                neu, bisher, sicherungs_verzeichnis(sicherungsordner))
        try:
            journal_bericht = journal_umschluesseln(neu, bisher)
        except Exception:
            journal_bericht = {"geschafft": 0, "misslungen": 1}
        self._kennwort = neu
        sperre_schreiben(sperre_zuruecksetzen())
        self.antwort("App.kennwortStand", {
            "ok": True, "an": True, "fehler": "",
            "sicherungen": bericht.get("geschafft", 0),
            "sicherungenFehler": bericht.get("misslungen", 0),
            "journal": journal_bericht.get("geschafft", 0),
            "journalFehler": journal_bericht.get("misslungen", 0)})

    def _kennwort_entfernen(self, alt="", sicherungsordner=""):
        bisher = getattr(self, "_kennwort", "")
        try:
            with open(daten_datei(), "r", encoding="utf-8") as datei:
                anfang = datei.read(400)
        except OSError:
            anfang = ""
        if sieht_verschluesselt_aus(anfang) and not bisher:
            self.antwort("App.kennwortStand", {
                "ok": False, "fehler":
                    _("The data is encrypted. Unlock the organizer with the password "
                      "first.")})
            return
        try:
            with self._daten_sperre, self._baum_sperre:
                with open(daten_datei(), "r", encoding="utf-8") as datei:
                    roh = datei.read()
                klar = entschluesseln(roh, bisher) if ist_verschluesselt(roh) else roh
                baum_migration = baum_ablagen_vorbereiten("", bisher)
                neue_dateien = dict(baum_migration["dateien"])
                neue_dateien["daten.json"] = klar
                kennwort_transaktion_ausfuehren(
                    neue_dateien, "entfernen")
                Fenster._baum_migration_uebernehmen(self, baum_migration)
                erinnerungsdaten_schreiben({})
                # Nur Sicherungen am Datenstandort dürfen wieder offen daliegen.
                # Ein gewählter externer Ordner bleibt unabhängig davon geschützt.
                sicherungsbericht = sicherungen_umschluesseln(
                    "", bisher, daten_verzeichnis())
                try:
                    journal_bericht = journal_umschluesseln("", bisher)
                except Exception:
                    journal_bericht = {"geschafft": 0, "misslungen": 1}
                self._kennwort = ""
                self._daten_dek = None
                self._daten_dek_kennung = None
                self._daten_umschlag = None
        except Exception as fehler:
            self.antwort("App.kennwortStand", {
                "ok": False,
                "fehler": fehler_deutsch(fehler, _("Decrypting the data"))})
            return
        self._kennwort = ""
        # Nachsehen, ob die Datei nun wirklich offen daliegt.
        try:
            with open(daten_datei(), "r", encoding="utf-8") as datei:
                nachher = datei.read(400)
        except OSError:
            nachher = ""
        if sieht_verschluesselt_aus(nachher):
            self.antwort("App.kennwortStand", {
                "ok": False, "fehler":
                    _("The data is still encrypted. Try again.")})
            return
        self.antwort("App.kennwortStand", {
            "ok": True, "an": False, "fehler": "",
            "sicherungen": sicherungsbericht.get("geschafft", 0),
            "sicherungenFehler": sicherungsbericht.get("misslungen", 0),
            "journal": journal_bericht.get("geschafft", 0),
            "journalFehler": journal_bericht.get("misslungen", 0)})

    def _sicherung_wiederherstellen(self, pfad, kennwort="",
                                    sicherungsordner=""):
        """Ersetzt den Bestand erst nach Prüfung und legt vorher eine Kopie an."""
        if (getattr(self, "_operation_laeuft", False) or
                getattr(self, "_sync_laeuft", False)):
            self.antwort("App.sicherungWiederhergestellt", {"ok": False,
                "fehler": _("Another data operation is still running.")})
            return
        self._operation_laeuft = True
        vorher_baum_kennwort = getattr(self, "_kennwort", "")
        ziel_kennwort = vorher_baum_kennwort
        gelesen = sicherung_lesen(pfad, kennwort)
        if not gelesen.get("ok"):
            self.antwort("App.sicherungWiederhergestellt", {
                "ok": False, "fehler": gelesen.get("fehler") or
                (_("Enter the backup password.")
                 if gelesen.get("brauchtKennwort") else
                 _("The backup could not be read.")),
                "brauchtKennwort": bool(gelesen.get("brauchtKennwort"))})
            self._operation_laeuft = False
            return
        self._daten_sperre.acquire()
        try:
            ziel_ordner = sicherungsordner
            vorher_kennwort = getattr(self, "_kennwort", "") or (
                kennwort if gelesen.get("verschluesselt") else "")
            # Eine alte, unverschlüsselte Sicherung liefert kein Kennwort für
            # die Vorsicherung. In diesem Sonderfall bleibt die Kopie am
            # lokalen Datenstandort statt extern im Klartext zu landen.
            if sicherung_ist_extern(ziel_ordner) and not vorher_kennwort:
                ziel_ordner = ""
            journal_snapshot = getattr(self, "_journal_snapshot", None)
            vorher = journal_snapshot("pre-restore") if journal_snapshot else {
                "snapshotId": lege_sicherung_an(
                    ziel_ordner, "sicherung-vor-wiederherstellung",
                    vorher_kennwort, getattr(self, "_kennwort", "")) or ""}
            if os.path.isfile(daten_datei()) and not vorher["snapshotId"]:
                raise OSError(_("The previous data could not be backed up."))
            ziel_kennwort = getattr(self, "_kennwort", "")
            if gelesen.get("verschluesselt") and not ziel_kennwort:
                ziel_kennwort = kennwort
            with self._baum_sperre:
                baum_migration = baum_ablagen_vorbereiten(
                    ziel_kennwort, vorher_baum_kennwort)
                neue_dateien = dict(baum_migration["dateien"])
                gelesen["daten"] = journal_restore_daten(gelesen["daten"])
                klar = json.dumps(gelesen["daten"], ensure_ascii=False, indent=1)
                if ziel_kennwort:
                    (neue_dateien["daten.json"], daten_dek,
                     daten_dek_kennung, daten_umschlag) = (
                        daten_huelle_anlegen(klar, ziel_kennwort))
                else:
                    neue_dateien["daten.json"] = klar
                    daten_dek = daten_dek_kennung = daten_umschlag = None
                kennwort_transaktion_ausfuehren(
                    neue_dateien, "wiederherstellen")
                Fenster._baum_migration_uebernehmen(self, baum_migration)
                self._kennwort = ziel_kennwort
                self._daten_dek = daten_dek
                self._daten_dek_kennung = daten_dek_kennung
                self._daten_umschlag = daten_umschlag
            sperre_schreiben(sperre_zuruecksetzen())
            erinnerungsdaten_schreiben(
                gelesen["daten"] if ziel_kennwort else {})
        except Exception as fehler:
            self.antwort("App.sicherungWiederhergestellt", {
                "ok": False,
                "fehler": fehler_deutsch(
                    fehler, _("Restoring the backup")),
                "brauchtKennwort": False})
            return
        finally:
            self._daten_sperre.release()
            self._operation_laeuft = False
        self.antwort("App.sicherungWiederhergestellt", {
            "ok": True, "daten": gelesen["daten"],
            "kennwort": bool(self._kennwort),
            "vorher": vorher["snapshotId"], "pfad": os.path.abspath(pfad)})

    def _gesamtarchiv_vorschau(self, pfad, gelesen):
        self.antwort("App.gesamtarchivAusgewaehlt", {
            "ok": True, "pfad": os.path.abspath(pfad), "geprueft": True,
            "verschluesselt": bool(gelesen["verschluesselt"]),
            "brauchtKennwort": False, "erstellt": gelesen["erstellt"],
            "plattform": gelesen["plattform"],
            "appversion": gelesen["appversion"],
            "anzahlen": gelesen["anzahlen"], "fotos": gelesen["fotos"],
            "anhaenge": gelesen["anhaenge"]})

    def _gesamtarchiv_waehlen(self):
        pfad = self._datei_oeffnen(
            "Magnolie-Gesamtarchiv importieren",
            [("Magnolie-Gesamtarchiv (*.magnolie)", "*.magnolie")])
        if not pfad:
            self.antwort("App.gesamtarchivAusgewaehlt", {
                "ok": False, "abgebrochen": True})
            return
        try:
            anfang = _text_dekodieren(datei_begrenzt_lesen(
                pfad, GESAMTARCHIV_DATEI_MAX,
                "Das Gesamtarchiv ist größer als 384 MiB."))
            if ist_verschluesselt(anfang):
                self.antwort("App.gesamtarchivAusgewaehlt", {
                    "ok": True, "pfad": os.path.abspath(pfad),
                    "verschluesselt": True, "brauchtKennwort": True,
                    "geprueft": False})
                return
            self._gesamtarchiv_vorschau(
                pfad, gesamtarchiv_lesen_text(anfang))
        except Exception as fehler:
            self.antwort("App.gesamtarchivAusgewaehlt", {
                "ok": False, "pfad": os.path.abspath(pfad),
                "fehler": fehler_deutsch(fehler, "Gesamtarchiv prüfen")})

    def _gesamtarchiv_pruefen(self, pfad, kennwort):
        try:
            self._gesamtarchiv_vorschau(
                pfad, gesamtarchiv_lesen(pfad, kennwort))
        except Exception as fehler:
            self.antwort("App.gesamtarchivAusgewaehlt", {
                "ok": False, "pfad": os.path.abspath(pfad),
                "verschluesselt": True, "brauchtKennwort": True,
                "fehler": fehler_deutsch(fehler, "Gesamtarchiv prüfen")})

    def _gesamtarchiv_exportieren(self, kennwort):
        pfad = self._datei_speichern(
            "Magnolie-Gesamtarchiv exportieren", "magnolie-gesamtarchiv.magnolie",
            [("Magnolie-Gesamtarchiv (*.magnolie)", "*.magnolie")])
        if not pfad:
            self.antwort("App.gesamtarchivExportiert", {
                "ok": False, "abgebrochen": True})
            return
        try:
            if os.path.lexists(pfad) and os.path.islink(pfad):
                raise OSError("Verknüpfte Dateien werden nicht überschrieben.")
            with self._daten_sperre:
                roh = _text_dekodieren(datei_begrenzt_lesen(
                    daten_datei(), SICHERUNG_DATEI_MAX,
                    "Der aktuelle Datenbestand ist zu groß."))
                klar = entschluesseln(roh, self._kennwort) if ist_verschluesselt(roh) else roh
                daten = json.loads(klar)
                text = gesamtarchiv_erzeugen(daten, kennwort=kennwort)
                atomar_text_schreiben(pfad, text)
            self.antwort("App.gesamtarchivExportiert", {
                "ok": True, "abgebrochen": False, "pfad": os.path.abspath(pfad),
                "verschluesselt": bool(kennwort)})
        except Exception as fehler:
            self.antwort("App.gesamtarchivExportiert", {
                "ok": False, "abgebrochen": False,
                "fehler": fehler_deutsch(fehler, "Gesamtarchiv exportieren")})

    def _gesamtarchiv_importieren(self, pfad, kennwort, modus,
                                  sicherungsordner=""):
        if (getattr(self, "_operation_laeuft", False) or
                getattr(self, "_sync_laeuft", False)):
            self.antwort("App.gesamtarchivImportiert", {"ok": False, "daten": None,
                "fehler": _("Another data operation is still running.")})
            return
        self._operation_laeuft = True
        try:
            if modus != "vollstaendig-ersetzen":
                raise RuntimeError("Nur 'Vollständig ersetzen' wird unterstützt.")
            gelesen = gesamtarchiv_lesen(pfad, kennwort)
            with self._daten_sperre:
                roh = _text_dekodieren(datei_begrenzt_lesen(
                    daten_datei(), SICHERUNG_DATEI_MAX,
                    "Der aktuelle Datenbestand ist zu groß."))
                lokal_text = (entschluesseln(roh, self._kennwort)
                               if ist_verschluesselt(roh) else roh)
                lokal = json.loads(lokal_text)
                importiert = gesamtarchiv_lokales_bewahren(
                    gelesen["daten"], lokal, gelesen["plattform"] != "linux")
                ziel_ordner = sicherungsordner
                if sicherung_ist_extern(ziel_ordner) and not self._kennwort:
                    ziel_ordner = ""
                journal_snapshot = getattr(self, "_journal_snapshot", None)
                vorher = journal_snapshot("pre-restore") if journal_snapshot else {
                    "snapshotId": lege_sicherung_an(
                        ziel_ordner, "sicherung-vor-wiederherstellung",
                        self._kennwort, self._kennwort) or ""}
                if os.path.isfile(daten_datei()) and not vorher["snapshotId"]:
                    raise OSError("Der bisherige Datenbestand konnte nicht gesichert werden.")
                importiert = journal_restore_daten(importiert)
                klar = json.dumps(importiert, ensure_ascii=False, indent=1)
                if self._kennwort:
                    gespeichert = daten_verschluesseln(
                        klar, self._kennwort, self._daten_dek,
                        self._daten_dek_kennung, self._daten_umschlag)
                else:
                    gespeichert = klar
                atomar_text_schreiben(daten_datei(), gespeichert)
                erinnerungsdaten_schreiben(importiert if self._kennwort else {})
            self.antwort("App.gesamtarchivImportiert", {
                "ok": True, "daten": importiert,
                "kennwort": bool(self._kennwort), "vorher": vorher["snapshotId"]})
        except Exception as fehler:
            self.antwort("App.gesamtarchivImportiert", {
                "ok": False, "daten": None,
                "fehler": fehler_deutsch(fehler, "Gesamtarchiv importieren")})
        finally:
            self._operation_laeuft = False

    # ------------------------------------------------ Telefonverbindung

    def _telefon_ereignis(self, art, nutzlast):
        if art == "pairing_open":
            self.antwort("App.telefonPairingOffen", nutzlast)
        elif art == "pairing_code":
            GLib.idle_add(lambda: (self._tray_zeigen(), False)[1])
            self.antwort("App.telefonPairingCode", nutzlast)
        elif art == "paired":
            self.antwort("App.telefonGekoppelt", nutzlast)
        elif art == "device_status":
            status = dict(nutzlast.get("status") or {})
            status["online"] = True
            self.antwort("App.geraetStatus", {
                "kennung": nutzlast.get("device_id") or "",
                "name": nutzlast.get("display_name") or "", "status": status})
        elif art == "dial_status":
            self.antwort("App.telefonWaehlStatus", nutzlast)
        elif art == "selected_notification":
            self.antwort("App.telefonMeldung", nutzlast)
        elif art == "incoming_call":
            _anruf_zustand = nutzlast.get("state")
            _anruf_ruf = str(nutzlast.get("call_ref") or "")
            # Klingelt es oder wird gesprochen, muss der Funk an sein, damit das
            # Telefon den Ton hierher legen kann; bei "idle" zurueckstellen.
            if _anruf_zustand in ("ringing", "offhook"):
                _ANRUF_BLUETOOTH.ensure(_anruf_ruf)
            else:
                _ANRUF_BLUETOOTH.restore(_anruf_ruf)
            if _anruf_zustand != "ringing":
                _ANRUF_LAUTSTAERKE.restore(_anruf_ruf)
            self.antwort("App.telefonEingehenderAnruf", nutzlast)
            if nutzlast.get("state") == "offhook":
                GLib.idle_add(lambda: (self._tray_zeigen(), False)[1])
        elif art == "answer_status":
            self.antwort("App.telefonAnnehmStatus", nutzlast)
        elif art == "end_status":
            self.antwort("App.telefonAuflegeStatus", nutzlast)
        elif art == "personal_sync":
            self.antwort("App.personalSync", nutzlast)
        elif art == "personal_sync_error":
            self.antwort("App.personalSyncFehler", {"fehler": nutzlast.get("error") or
                _("Personal synchronization failed.")})
        elif art == "personal_sync_progress":
            self.antwort("App.personalSyncFortschritt", nutzlast)
        elif art == "personal_sync_attachment_index":
            self.antwort("App.personalSyncAttachmentIndex", nutzlast)
        elif art == "personal_decision_accepted":
            self.antwort("App.personalSyncDecisionAccepted", nutzlast)
        if art in ("status", "paired", "device_status"):
            self._telefon_stand_melden()

    def _telefon_dienst_pflegen(self):
        with self._telefon_sperre:
            if self._telefon is None:
                try:
                    self._telefon = PhoneService(
                        os.path.join(daten_verzeichnis(), "telefon"),
                        local_device_name(), self._telefon_ereignis)
                except Exception as fehler:
                    self._telefon_fehler = fehler_deutsch(
                        fehler, _("Starting the phone connection"))
                    return False
            if self._telefon.enabled:
                gestartet = self._telefon.start()
                if not gestartet:
                    self._telefon_fehler = _(
                        "Port 8741 is unavailable. The phone listener could not start.")
                return gestartet
            self._telefon.stop()
            return False

    def _telefon_bericht(self):
        self._telefon_dienst_pflegen()
        if not self._telefon:
            return {"possible": False, "enabled": False, "listening": False,
                    "port": TELEFON_PORT, "peers": [],
                    "kdeconnect": kdeconnect_sms_stand(),
                    "error": getattr(self, "_telefon_fehler", "")}
        bericht = self._telefon.report()
        bericht["kdeconnect"] = kdeconnect_sms_stand()
        bericht["error"] = getattr(self, "_telefon_fehler", "")
        return bericht

    def _telefon_stand_melden(self):
        _kdeconnect_backend(self._kde_ereignis)
        if self._telefon:
            self._telefon.replay_personal_sync()
        self.antwort("App.telefonStand", self._telefon_bericht())
        GLib.idle_add(lambda: (self._tray_telefone_aktualisieren(), False)[1])

    def _kde_ereignis(self, art, nutzlast):
        ziel = {"sms": "App.telefonSmsEmpfangen",
                "pairing": "App.kdePairingCode",
                "pairing_status": "App.kdePairingStatus"}.get(art)
        if ziel:
            def melden():
                if art == "pairing":
                    self._tray_zeigen()
                self.antwort(ziel, nutzlast)
                return False
            GLib.idle_add(melden)

    def _kde_reconnect(self):
        try:
            _kdeconnect_backend(self._kde_ereignis).discover()
        except Exception:
            pass
        self._telefon_stand_melden()

    def _telefon_schalten(self, an):
        self._telefon_dienst_pflegen()
        if not self._telefon:
            self._telefon_stand_melden()
            return
        self._telefon_fehler = ""
        if an:
            ok, fehler = baum_firewall_einrichten()
            if not ok:
                self._telefon_fehler = fehler
                self._telefon_stand_melden()
                return
        self._telefon.set_enabled(an)
        self._telefon_stand_melden()

    def _telefon_pairing_oeffnen(self):
        self._telefon_dienst_pflegen()
        try:
            if not self._telefon:
                raise RuntimeError(_("The phone connection is not available."))
            self._telefon.open_pairing()
        except Exception as fehler:
            self.antwort("App.telefonPairingFehler", {
                "fehler": fehler_deutsch(fehler, _("Opening phone pairing"))})
        self._telefon_stand_melden()

    def _telefon_status_anfordern(self, kennung):
        try:
            if not self._telefon:
                raise RuntimeError(_("The phone connection is not available."))
            self._telefon.request_status(kennung)
        except Exception as fehler:
            self.antwort("App.geraetStatus", {
                "kennung": kennung, "fehler": fehler_deutsch(
                    fehler, _("Requesting the device status"))})

    def _telefon_entfernen(self, kennung):
        if self._telefon:
            self._telefon.remove(kennung)
        self._telefon_stand_melden()

    def _telefon_bluetooth_schalten(self, kennung, an, adresse):
        try:
            if not self._telefon:
                raise RuntimeError(_("The phone connection is not available."))
            self._telefon.set_bluetooth(kennung, an, adresse)
            self._telefon_fehler = ""
        except Exception as fehler:
            self._telefon_fehler = fehler_deutsch(
                fehler, _("Configuring Bluetooth data"))
        self._telefon_stand_melden()

    def _telefon_freigabe(self, kennung, name, an):
        try:
            if not self._telefon:
                raise RuntimeError(_("The phone connection is not available."))
            self._telefon.set_grant(kennung, name, an)
            self._telefon_fehler = ""
        except Exception as fehler:
            self._telefon_fehler = fehler_deutsch(fehler, _("Changing phone permission"))
        self._telefon_stand_melden()

    def _personal_sync_einstellungen(self, kennung, eigen, auto_wlan):
        try:
            if not self._telefon:
                raise RuntimeError(_("The phone connection is not available."))
            self._telefon.set_personal_sync(kennung, eigen, auto_wlan)
            self._telefon_fehler = ""
        except Exception as fehler:
            self._telefon_fehler = fehler_deutsch(fehler, "Persönlicher Sync")
        self._telefon_stand_melden()

    def _personal_sync_senden(self, kennung, art, inhalt, trigger):
        try:
            if not self._telefon:
                raise RuntimeError(_("The phone connection is not available."))
            self._telefon.send_personal_sync(kennung, art, inhalt, trigger)
        except Exception as fehler:
            self.antwort("App.personalSyncFehler", {"fehler": fehler_deutsch(
                fehler, "Persönlicher Sync")})

    def _personal_sync_lauf_senden(self, kennung, request, batches, sources, trigger, report, commit):
        try:
            if not self._telefon:
                raise RuntimeError(_("The phone connection is not available."))
            self._telefon.send_personal_sync_run(kennung, request, batches, sources, trigger, report)
            if commit and not self._telefon.commit_personal_sync(kennung,
                    commit.get("messageId") or "", commit.get("token") or "", True):
                raise RuntimeError("Unbekannter Personal-Sync-Commit.")
        except Exception as fehler:
            self.antwort("App.personalSyncFehler", {"fehler": fehler_deutsch(
                fehler, "Persönlicher Sync")})

    def _personal_sync_attachment_index(self, kennung, run_id, reply, records_hash, sources):
        try:
            if not self._telefon:
                raise RuntimeError(_("The phone connection is not available."))
            self._telefon.index_local_attachments(kennung, run_id, reply, records_hash, sources)
        except Exception as fehler:
            self.antwort("App.personalSyncFehler", {"fehler": fehler_deutsch(
                fehler, "Persönlicher Sync")})

    def _personal_sync_commit(self, kennung, message_id, token, erfolgreich):
        try:
            if not self._telefon or not self._telefon.commit_personal_sync(
                    kennung, message_id, token, erfolgreich):
                raise RuntimeError("Unbekannter Personal-Sync-Commit.")
        except Exception as fehler:
            self.antwort("App.personalSyncFehler", {"fehler": fehler_deutsch(
                fehler, "Persönlicher Sync speichern")})

    def _telefon_waehlen(self, nummer, client_ref, land):
        try:
            GLib.idle_add(lambda: (self._tray_zeigen(), False)[1])
            if not self._telefon:
                raise RuntimeError(_("The phone connection is not available."))
            ziel = _telefon_schluessel(str(nummer or ""), land).split("x", 1)[0]
            if not re.fullmatch(r"\+[0-9]{3,15}", ziel):
                raise ValueError(_("The phone number is invalid."))
            bericht = self._telefon.report()
            telefone = [peer for peer in bericht.get("peers", [])
                if peer.get("state") in {"online_wifi", "online_bluetooth"}
                and (peer.get("capabilities", {}).get("items", {}).get("dial_request", {})
                     .get("available"))
                and 1 in peer.get("capabilities", {}).get("items", {}).get(
                    "dial_request", {}).get("versions", [])
                and peer.get("grants", {}).get("grants", {}).get("dial_request")]
            if len(telefone) != 1:
                raise RuntimeError(_("Exactly one online Magnolie Notes phone must allow dial requests."))
            # Schon vor dem Waehlen einschalten: Der Funk braucht ein bis drei
            # Sekunden, erst danach kann das Telefon sein Freisprechprofil
            # aufbauen. Der Anrufzustand stellt spaeter zurueck.
            _ANRUF_BLUETOOTH.ensure(str(client_ref or ""))
            self._telefon.request_dial(telefone[0]["device_id"], ziel, client_ref)
        except Exception as fehler:
            self.antwort("App.telefonWaehlStatus", {"client_ref": client_ref,
                "state": "failed", "error": fehler_deutsch(fehler, _("Opening the system dialer")),
                 "occurred_ms": 0})

    def _telefon_auflegen(self, kennung, call_ref, revision, command_ref):
        try:
            if not self._telefon:
                raise RuntimeError(_("The phone connection is not available."))
            self._telefon.request_end_call(kennung, call_ref, revision, command_ref)
        except Exception as fehler:
            self.antwort("App.telefonAuflegeStatus", {"command_ref": command_ref,
                "call_ref": call_ref, "state": "failed",
                 "error": fehler_deutsch(fehler, _("Ending the call")), "occurred_ms": 0})

    def _telefon_annehmen(self, kennung, call_ref, command_ref):
        try:
            if not self._telefon:
                raise RuntimeError(_("The phone connection is not available."))
            _ANRUF_BLUETOOTH.ensure(call_ref)
            self._telefon.request_answer(kennung, call_ref, command_ref)
        except Exception as fehler:
            self.antwort("App.telefonAnnehmStatus", {"command_ref": command_ref,
                "call_ref": call_ref, "state": "failed",
                "error": fehler_deutsch(fehler, _("Answering the call")),
                "occurred_ms": 0})

    def _kde_sms_senden(self, nummer, text, land, client_ref):
        try:
            antwort = kdeconnect_sms_senden(nummer, text, land)
            antwort["client_ref"] = str(client_ref or "")[:160]
            self.antwort("App.kdeSmsStatus", antwort)
        except Exception as fehler:
            self.antwort("App.kdeSmsStatus", {"ok": False, "state": "failed",
                "client_ref": str(client_ref or "")[:160],
                "error": fehler_deutsch(fehler, _("Sending SMS with KDE Connect"))})

    def _kde_pairing_start(self, kennung, erneuern=False):
        try:
            self.antwort("App.kdePairingCode", _kdeconnect_backend().begin_pairing(
                kennung or None, replace_stored=erneuern))
        except Exception as fehler:
            self.antwort("App.kdePairingCode", {"state": "failed",
                "error": fehler_deutsch(fehler, _("Pairing KDE Connect"))})
        self._telefon_stand_melden()

    def _kde_pairing_complete(self, kennung):
        try:
            self.antwort("App.kdePairingCode",
                         _kdeconnect_backend().complete_pairing(kennung))
        except Exception as fehler:
            self.antwort("App.kdePairingCode", {"state": "failed",
                "error": fehler_deutsch(fehler, _("Completing KDE Connect pairing"))})
        self._telefon_stand_melden()

    def _kde_pairing_confirm(self, stimmt):
        try:
            self.antwort("App.kdePairingStatus",
                         _kdeconnect_backend().confirm_pairing(stimmt))
        except Exception as fehler:
            self.antwort("App.kdePairingStatus", {"state": "failed",
                "error": fehler_deutsch(fehler, _("Pairing KDE Connect"))})
        self._telefon_stand_melden()

    def _telefon_sms_benachrichtigen(self, nachricht):
        name = str(nachricht.get("name") or "")[:200]
        nummer = str(nachricht.get("nummer") or "")[:128]
        text = str(nachricht.get("text") or "")[:10000]
        kennung = str(nachricht.get("kennung") or "")[:64]
        stil = "magnolie" if (nachricht.get("stil") == "magnolie"
            and not os.environ.get("WAYLAND_DISPLAY")) else "system"
        dauer = nachricht.get("dauer") if nachricht.get("dauer") in (0, 15, 30, 60, 120) else 60
        foto = b""
        foto_wert = str(nachricht.get("foto") or "")
        if len(foto_wert) <= 2 * 1024 * 1024 and re.fullmatch(
                r"data:image/(?:png|jpeg|webp);base64,[A-Za-z0-9+/=]+", foto_wert):
            try:
                foto = base64.b64decode(foto_wert.split(",", 1)[1], validate=True)
                if not (foto.startswith(b"\x89PNG\r\n\x1a\n") or foto.startswith(b"\xff\xd8\xff")
                        or foto.startswith(b"RIFF") and foto[8:12] == b"WEBP"):
                    foto = b""
            except (ValueError, binascii.Error):
                foto = b""
        initialen = "".join(teil[0] for teil in name.split()[:2] if teil)[:2]
        text = text if len(text) <= 150 else text[:149] + "…"
        if not name or not nummer or not kennung:
            return

        beantwortet = {"ja": False}

        def antworten():
            if beantwortet["ja"]:
                return
            beantwortet["ja"] = True
            self._tray_zeigen()
            self.antwort("App.telefonAntwort", {"kennung": kennung, "nummer": nummer})

        def anzeigen():
            titel = _("SMS from %(name)s") % {"name": name}
            wartezeit = dauer
            if stil == "magnolie":
                try:
                    if magnolie_meldung(titel, text, wartezeit, True,
                            eigene_schleife=False, aktionsname=_("Reply"),
                            aktion=antworten, foto=foto, initialen=initialen):
                        return False
                except Exception:
                    pass
            benachrichtigen(titel, text, mit_aktion=True, wartezeit=wartezeit,
                            aktionsname=_("Reply"), aktion=antworten,
                            eigene_schleife=False)
            return False
        GLib.idle_add(anzeigen)

    def _telefon_meldung_anzeigen(self, nachricht):
        app = str(nachricht.get("app") or "")[:200]
        titel = str(nachricht.get("titel") or "")[:500]
        text = str(nachricht.get("text") or "")[:5000]
        if not app or not (titel or text):
            return
        threading.Thread(target=lambda: benachrichtigen(
            app + (" · " + titel if titel else ""), text,
            mit_aktion=False, wartezeit=20), daemon=True).start()

    def _telefon_anruf_anzeigen(self, nachricht):
        zustand = str(nachricht.get("state") or "")
        call_ref = str(nachricht.get("callRef") or "")
        kennung = str(nachricht.get("kennung") or "")
        name = str(nachricht.get("name") or _("Unknown caller"))[:200]
        nummer = str(nachricht.get("nummer") or "")[:128]
        stil = "magnolie" if (nachricht.get("stil") == "magnolie"
            and not os.environ.get("WAYLAND_DISPLAY")) else "system"
        dauer = nachricht.get("dauer") if nachricht.get("dauer") in (0, 15, 30, 60, 120) else 60
        foto = b""
        foto_wert = str(nachricht.get("foto") or "")
        if len(foto_wert) <= 2 * 1024 * 1024 and re.fullmatch(
                r"data:image/(?:png|jpeg|webp);base64,[A-Za-z0-9+/=]+", foto_wert):
            try:
                foto = base64.b64decode(foto_wert.split(",", 1)[1], validate=True)
                if not (foto.startswith(b"\x89PNG\r\n\x1a\n") or foto.startswith(b"\xff\xd8\xff")
                        or foto.startswith(b"RIFF") and foto[8:12] == b"WEBP"):
                    foto = b""
            except (ValueError, binascii.Error):
                foto = b""
        initialen = "".join(teil[0] for teil in name.split()[:2] if teil)[:2]
        if zustand != "ringing":
            return
        if nachricht.get("leiser"):
            _ANRUF_LAUTSTAERKE.lower(call_ref)
        ausgefuehrt = {"ja": False}
        def annehmen():
            if ausgefuehrt["ja"]:
                return
            ausgefuehrt["ja"] = True
            try:
                if self._telefon:
                    self._telefon.request_answer(kennung, call_ref, str(uuid.uuid4()))
            except Exception as fehler:
                self.antwort("App.telefonAnnehmStatus", {"state": "failed",
                    "error": fehler_deutsch(fehler, _("Answering the call"))})
        def oeffnen():
            if ausgefuehrt["ja"]:
                return
            ausgefuehrt["ja"] = True
            organizer_starten()
        def anzeigen():
            titel = _("Incoming call")
            text = name + (("\n" + nummer) if nummer and nummer != name else "")
            aktionsname = _("Answer") if nachricht.get("annehmen") else _("Open organizer")
            aktion = annehmen if nachricht.get("annehmen") else oeffnen
            if stil == "magnolie":
                try:
                    if magnolie_meldung(titel, text, dauer, True,
                            eigene_schleife=False, aktionsname=aktionsname,
                            aktion=aktion, foto=foto, initialen=initialen):
                        return False
                except Exception:
                    pass
            benachrichtigen(titel, text, mit_aktion=True, wartezeit=dauer,
                            aktionsname=aktionsname, aktion=aktion,
                            eigene_schleife=False)
            return False
        GLib.idle_add(anzeigen)

    # ----------------------------------------------------- Magnolienbaum

    def _baum_migration_uebernehmen(self, ergebnis):
        baum = ergebnis.get("baum") if isinstance(ergebnis, dict) else None
        if not baum:
            return
        self._baum = baum["zustand"]
        self._baum_dek = baum["dek"]
        self._baum_dek_kennung = baum["dekKennung"]
        self._baum_umschlag = baum["umschlag"]

    def _baum_zustand(self):
        with self._baum_sperre:
            if getattr(self, "_baum", None) is None:
                (self._baum, self._baum_dek, self._baum_dek_kennung,
                 self._baum_umschlag) = baum_lesen(
                    kennwort=self._kennwort, mit_schluessel=True)
                geaendert = False
                for sendung in baum_post_lesen(kennwort=self._kennwort):
                    partner = baum_partner(self._baum, sendung.get("an"))
                    try:
                        zaehler = int(sendung.get("briefZaehler") or 0)
                    except (TypeError, ValueError):
                        zaehler = 0
                    if partner and zaehler > int(partner.get("zaehler_raus") or 0):
                        partner["zaehler_raus"] = zaehler
                        geaendert = True
                if geaendert:
                    self._baum_sichern(self._baum)
            return self._baum

    def _baum_sichern(self, zustand=None):
        with self._baum_sperre:
            baum_schreiben(
                zustand if zustand is not None else self._baum,
                kennwort=self._kennwort, dek=self._baum_dek,
                dek_kennung=self._baum_dek_kennung,
                umschlag=self._baum_umschlag)

    def _baum_dienst_pflegen(self):
        """Startet oder beendet den Netzdienst je nach Einstellung."""
        if self._gesperrt:
            self._baum_post_pause()
            laeuft = getattr(self, "_baumdienst", None)
            if laeuft:
                laeuft.anhalten()
                self._baumdienst = None
            return False
        zustand = self._baum_zustand()
        self._baum_alte_statuspost_entfernen()
        laeuft = getattr(self, "_baumdienst", None)
        if zustand and zustand.get("an"):
            if laeuft:
                self._baum_post_aktivieren()
                return True
            neuer_dienst = BaumDienst(
                self._baum_zustand, self._baum_sichern,
                bei_nachricht=self._baum_empfangen,
                port=int(zustand.get("port") or BAUM_PORT),
                sperre=self._baum_sperre)
            if neuer_dienst.starten():
                self._baumdienst = neuer_dienst
                self._baum_post_aktivieren()
                return True
            return False
        self._baum_post_pause()
        if laeuft:
            laeuft.anhalten()
            self._baumdienst = None
        return False

    def _baum_alte_statuspost_entfernen(self):
        """Entfernt nur die zwei inzwischen verbotenen Telefon-Uebergangsarten."""
        post = baum_post_lesen(kennwort=self._kennwort)
        bereinigt = [sendung for sendung in post if sendung.get("art") not in
                     ("geraete_status_anfrage", "geraete_status")]
        entfernt = len(post) - len(bereinigt)
        if entfernt:
            if not baum_post_schreiben(bereinigt, kennwort=self._kennwort):
                raise RuntimeError(_("The Magnolienbaum outbox could not be saved."))
            self._baum_fehler = ngettext(
                "One obsolete device-status transmission was removed from the tree queue.",
                "%(count)s obsolete device-status transmissions were removed from the tree queue.",
                entfernt) % {"count": entfernt}
        return entfernt

    def _baum_post_lauf(self, jetzt=None, sender=None, hoechstens=1):
        if self._gesperrt:
            return {"ausgefuehrt": False, "grund": "gesperrt",
                    "zugestellt": 0, "offen": 0, "aufgegeben": 0,
                    "versucht": 0, "geaendert": False}
        with self._baum_sperre:
            zustand = self._baum_zustand()
            mailbox = None
            try:
                settings = nextcloud_speicher().load()
                if settings and settings["briefkastenAktiv"]:
                    mailbox = NextcloudMailbox(configured_client(
                        nextcloud_speicher(), purpose="briefkasten"))
            except Exception as fehler:
                self._baum_briefkasten_fehler = str(fehler)
                self._baum_briefkasten_zustand = "fehler"
            bericht = baum_post_wartung(
                zustand, kennwort=self._kennwort, jetzt=jetzt,
                sender=sender, hoechstens=hoechstens, mailbox=mailbox)
            if bericht.get("versucht"):
                self._baum_sichern(zustand)
            return bericht

    def _baum_post_tick(self):
        if self._baum_post_stop:
            self._baum_post_timer = None
            return False
        if self._gesperrt or self._baum_post_laeuft:
            return True
        self._baum_post_laeuft = True

        def arbeiten():
            geaendert = False
            try:
                geaendert = bool(self._baum_post_lauf().get("geaendert"))
                geaendert = self._baum_briefkasten_poll() or geaendert
            except Exception as fehler:
                debug_ausnahme("tree.outbox.failed", error=fehler)
            finally:
                def fertig():
                    self._baum_post_laeuft = False
                    if geaendert and not self._baum_post_stop:
                        self._baum_stand_melden()
                    return False
                GLib.idle_add(fertig)
        threading.Thread(target=arbeiten, daemon=True).start()
        return True

    def _baum_briefkasten_poll(self):
        if self._gesperrt:
            return False
        store = nextcloud_speicher()
        settings = store.load()
        if not settings or not settings["briefkastenAktiv"]:
            return False
        mailbox = NextcloudMailbox(configured_client(store, purpose="briefkasten"))
        with self._baum_sperre:
            zustand = self._baum_zustand()
            eigene = zustand.get("kennung") or ""
            mailbox.ensure(eigene)
            pending, gesamt = [], 0
            erster_fehler = None
            for transport_id in mailbox.list_incoming(eigene):
                if len(pending) >= 256:
                    erster_fehler = RuntimeError(
                        _("The mailbox contains too many pending messages."))
                    break
                try:
                    dokument = mailbox.get_incoming(eigene, transport_id)
                    gesamt += len(dokument)
                    if gesamt > 64 * 1024 * 1024:
                        raise RuntimeError(_("The mailbox backlog is too large."))
                    sender = mailbox_sender(dokument, transport_id, eigene)
                    partner = baum_partner(zustand, sender)
                    if not partner or not partner.get("bestaetigt"):
                        raise RuntimeError(_("The mailbox sender is unknown."))
                    key = _sitzungsschluessel(
                        zustand["geheim"], partner["oeffentlich"],
                        eigene, sender)
                    envelope = read_mailbox_document(
                        dokument, transport_id, sender, eigene, key)
                    if not isinstance(envelope, dict):
                        raise RuntimeError(_("The mailbox envelope is invalid."))
                    pending.append((sender, int(envelope.get("zaehler") or 0),
                                    transport_id, envelope, key))
                except Exception as fehler:
                    erster_fehler = erster_fehler or fehler
            geaendert = False
            for sender, _zaehler, transport_id, envelope, key in sorted(
                    pending, key=lambda item: (item[0], item[1])):
                partner = baum_partner(zustand, sender)
                transport_text = base64.urlsafe_b64encode(
                    transport_id).decode("ascii").rstrip("=")
                gesehen = partner.setdefault("brief_transport_ids", [])
                doppelt = transport_text in gesehen
                if not doppelt:
                    if int(envelope.get("zaehler") or 0) != int(
                            partner.get("zaehler_rein") or 0) + 1:
                        erster_fehler = erster_fehler or RuntimeError(
                            _("The mailbox message sequence has a gap."))
                        continue
                    baum_nachricht_annehmen(
                        zustand, envelope,
                        lambda p, inhalt: self._baum_empfangen(p, inhalt))
                    gesehen.append(transport_text)
                    partner["brief_transport_ids"] = gesehen[-2048:]
                    self._baum_sichern(zustand)
                    geaendert = True
                mailbox.write_receipt(transport_id, eigene, sender, key)
                mailbox.delete("nachrichten", eigene, transport_id)
            self._baum_briefkasten_fehler = str(erster_fehler or "")
            self._baum_briefkasten_zustand = "unvollstaendig" if erster_fehler else "bereit"
            return geaendert

    def _baum_post_planen(self):
        self._baum_post_planung = False
        if self._baum_post_stop or self._gesperrt:
            return False
        try:
            if not self._baum_zustand().get("an"):
                return False
        except Exception:
            return False
        if self._baum_post_timer is None:
            self._baum_post_timer = GLib.timeout_add_seconds(
                BAUM_POST_TAKT_SEKUNDEN, self._baum_post_tick)
        self._baum_post_tick()
        return False

    def _baum_post_aktivieren(self):
        if self._baum_post_stop or self._baum_post_planung:
            return
        self._baum_post_planung = True
        GLib.idle_add(self._baum_post_planen)

    def _baum_post_pause(self):
        quelle = self._baum_post_timer
        self._baum_post_timer = None
        if quelle is not None:
            try:
                GLib.source_remove(quelle)
            except (AttributeError, TypeError):
                pass

    def _baum_empfangen(self, partner, inhalt):
        with self._baum_sperre:
            if self._gesperrt:
                raise RuntimeError(_("Unlock the organizer before receiving Magnolienbaum messages."))
            baum_eingang_ablegen(partner, inhalt, kennwort=self._kennwort)
        meldung = baum_benachrichtigungstext(partner, inhalt)
        if meldung:
            threading.Thread(target=lambda: benachrichtigen(
                meldung[0], meldung[1], mit_aktion=False), daemon=True).start()
        self._baum_stand_melden()

    def _baum_bericht(self):
        with self._baum_sperre:
            quelle = self._baum_zustand()
            zustand = dict(quelle) if quelle else None
            if zustand:
                zustand["partner"] = [dict(p) for p in quelle.get("partner") or []]
        if not zustand:
            return {"moeglich": baum_moeglich(), "an": False, "partner": [],
                    "fehler": _("A component required by the Magnolienbaum is missing. "
                                "Install it with:  sudo apt install "
                                "python3-cryptography")}
        post = baum_post_lesen(kennwort=self._kennwort)
        return {
            "moeglich": True,
            "an": bool(zustand.get("an")),
            "laeuft": bool(getattr(self, "_baumdienst", None)),
            "name": zustand.get("name") or "",
            "kennung": zustand.get("kennung") or "",
            "fingerabdruck": fingerabdruck(zustand.get("oeffentlich")),
            "port": int(zustand.get("port") or BAUM_PORT),
            "partner": [{
                "kennung": p.get("kennung"),
                "name": p.get("name") or "",
                "adresse": p.get("adresse") or "",
                "port": int(p.get("port") or BAUM_PORT),
                "vertraut": bool(p.get("vertraut")),
                "kontakte": bool(p.get("kontakte")),
                "kontaktLoeschen": bool(p.get("kontaktLoeschen")),
                "fernAdresse": p.get("fernAdresse") or "",
                "fernPort": int(p.get("fernPort") or BAUM_PORT),
                "bestaetigt": bool(p.get("bestaetigt")),
                "wartet": bool(p.get("wartet")),
                "protokoll": p.get("protokoll") or "baum-1",
                "paarungsart": p.get("paarungsart") or "lokal-v1",
                "code": paarungs_code(zustand.get("oeffentlich"),
                                      p.get("oeffentlich")),
                "fingerabdruck": fingerabdruck(p.get("oeffentlich")),
                "zuletzt": p.get("zuletzt") or "",
            } for p in zustand.get("partner") or []],
            "post": len(post),
            "postOffen": len([s for s in post if not s.get("aufgegeben")]),
            "eingang": baum_eingang_lesen(kennwort=self._kennwort),
            "fehler": getattr(self, "_baum_fehler", ""),
        }

    def _baum_stand_melden(self):
        self.antwort("App.baumStand", self._baum_bericht())

    def _baum_schalten(self, an, name):
        zustand = self._baum_zustand()
        if not zustand:
            self._baum_stand_melden()
            return
        self._baum_fehler = ""
        if an:
            ok, fehler = baum_firewall_einrichten()
            if not ok:
                self._baum_fehler = fehler
                self._baum_stand_melden()
                return
        name_geaendert = bool(name and name[:60] != zustand.get("name"))
        with self._baum_sperre:
            zustand["an"] = bool(an)
            if name:
                zustand["name"] = name[:60]
            self._baum_sichern(zustand)
        if name_geaendert and getattr(self, "_baumdienst", None):
            self._baumdienst.anhalten()
            self._baumdienst = None
        self._baum_dienst_pflegen()
        self._baum_stand_melden()

    def _baum_suchen_arbeit(self):
        zustand = self._baum_zustand() or {}
        gefunden = baum_suchen(int(zustand.get("port") or BAUM_PORT), 1.5,
                               zustand.get("kennung") or "")
        self.antwort("App.baumGefunden", {"nachbarn": gefunden})

    def _baum_paarungsdatei_erzeugen(self, adresse, port):
        pfad = self._datei_speichern(
            _("Save Magnolienbaum pairing file"),
            "magnolie-paarung.magnolie-paarung",
            [(_("Magnolienbaum pairing file (*.magnolie-paarung)"),
              "*.magnolie-paarung")])
        if not pfad:
            return
        try:
            with self._baum_sperre:
                zustand = self._baum_zustand()
                dokument, _einladung = baum_paarungsdatei_erzeugen(
                    zustand, adresse, port)
                self._baum_sichern(zustand)
            atomar_text_schreiben(
                pfad, json.dumps(dokument, ensure_ascii=False, indent=1))
            self.antwort("App.baumPaarungsdatei", {
                "ok": True, "art": "erzeugt", "pfad": pfad,
                "gueltigBis": dokument["gueltigBis"], "fehler": ""})
            self._baum_stand_melden()
        except Exception as fehler:
            self.antwort("App.baumPaarungsdatei", {
                "ok": False, "art": "erzeugt", "fehler":
                    fehler_deutsch(fehler, _("Creating the pairing file"))})

    def _baum_paarungsqr_erzeugen(self, adresse, port):
        try:
            with self._baum_sperre:
                zustand = self._baum_zustand()
                probe = dict(zustand)
                probe["paarungen"] = list(zustand.get("paarungen", []))
                probe["paarungenVerbraucht"] = list(
                    zustand.get("paarungenVerbraucht", []))
                dokument, _einladung = baum_paarungsdatei_erzeugen(
                    probe, adresse, port)
                bild = baum_paarungsqr(dokument)
                zustand["paarungen"] = probe["paarungen"]
                zustand["paarungenVerbraucht"] = probe["paarungenVerbraucht"]
                self._baum_sichern(zustand)
            self.antwort("App.baumPaarungsdatei", {
                "ok": True, "art": "qr", "bild": bild,
                "gueltigBis": dokument["gueltigBis"], "fehler": ""})
            self._baum_stand_melden()
        except Exception as fehler:
            self.antwort("App.baumPaarungsdatei", {
                "ok": False, "art": "qr", "fehler":
                    fehler_deutsch(fehler, _("Creating the pairing QR code"))})

    def _baum_paarungsdatei_import_waehlen(self):
        pfad = self._datei_oeffnen(
            _("Open Magnolienbaum pairing file"),
            [(_("Magnolienbaum pairing file (*.magnolie-paarung)"),
              "*.magnolie-paarung")])
        if pfad:
            threading.Thread(
                target=lambda: self._baum_paarungsdatei_importieren(pfad),
                daemon=True).start()

    def _baum_paarungsdatei_importieren(self, pfad):
        try:
            dokument = baum_paarungsdatei_laden(pfad)
            with self._baum_sperre:
                zustand = self._baum_zustand()
                partner = baum_paarungsdatei_importieren(dokument, zustand)
                self._baum_sichern(zustand)
            self.antwort("App.baumPaarungsdatei", {
                "ok": True, "art": "importiert", "name": partner.get("name") or "",
                "fehler": ""})
            self._baum_stand_melden()
        except Exception as fehler:
            self.antwort("App.baumPaarungsdatei", {
                "ok": False, "art": "importiert", "fehler":
                    fehler_deutsch(fehler, _("Importing the pairing file"))})

    def _baum_paaren(self, adresse, port, erwarteter_fingerabdruck=""):
        zustand = self._baum_zustand()
        if not zustand:
            self.antwort("App.baumPaarung",
                         {"ok": False,
                          "fehler": _("The Magnolienbaum is not available.")})
            return
        try:
            adresse = baum_host_normieren(adresse)
            antwort = baum_anfragen(adresse, port, zustand,
                                    erwarteter_fingerabdruck=
                                    erwarteter_fingerabdruck)
            with self._baum_sperre:
                partner = baum_partner_aufnehmen(
                    zustand, antwort.get("name") or "",
                    antwort.get("kennung") or "",
                    antwort.get("oeffentlich") or "", adresse,
                    antwort.get("port") or port)
                partner["wartet"] = True
                self._baum_sichern(zustand)
        except Exception as fehler:
            self.antwort("App.baumPaarung", {
                "ok": False,
                "fehler": _("The other branch is not responding (%(error)s).")
                          % {"error": fehler_kurz(fehler)}})
            return
        code = paarungs_code(zustand.get("oeffentlich"),
                             antwort.get("oeffentlich") or "")
        self.antwort("App.baumPaarung", {
            "ok": True, "fehler": "",
            "kennung": partner["kennung"], "name": partner["name"],
            "code": code,
            "fingerabdruck": fingerabdruck(partner["oeffentlich"])})

    def _baum_internet_adresse(self):
        try:
            adresse = baum_oeffentliche_adresse()
            ergebnis = {"ok": True, "adresse": adresse, "fehler": ""}
        except Exception as fehler:
            ergebnis = {"ok": False, "adresse": "",
                        "fehler": _("The public address could not be determined "
                                    "(%(error)s).") %
                                  {"error": fehler_kurz(fehler)}}
        self.antwort("App.baumInternet", ergebnis)

    def _baum_bestaetigen(self, kennung, ja):
        with self._baum_sperre:
            zustand = self._baum_zustand()
            partner = baum_partner(zustand, kennung) if zustand else None
            if not partner:
                self._baum_stand_melden()
                return
            if ja:
                partner["bestaetigt"] = True
                partner["wartet"] = False
            else:
                zustand["partner"] = [p for p in zustand["partner"]
                                      if p.get("kennung") != kennung]
            self._baum_sichern(zustand)
        self._baum_stand_melden()

    def _baum_entfernen(self, kennung):
        with self._baum_sperre:
            zustand = self._baum_zustand()
            if not zustand:
                return
            zustand["partner"] = [p for p in zustand.get("partner") or []
                                  if p.get("kennung") != kennung]
            self._baum_sichern(zustand)
        self._baum_stand_melden()

    def _baum_partner_einstellungen(self, kennung, vertraut, fern_adresse, fern_port,
                                    kontakte=False, kontakt_loeschen=False):
        try:
            with self._baum_sperre:
                zustand = self._baum_zustand()
                partner = baum_partner(zustand, kennung) if zustand else None
                if not partner or not partner.get("bestaetigt"):
                    raise RuntimeError(_("This branch has not been confirmed."))
                baum_partner_einstellungen(
                    partner, vertraut, fern_adresse, fern_port, kontakte,
                    kontakt_loeschen)
                self._baum_sichern(zustand)
            self.antwort("App.baumPartnerEinstellungen", {"ok": True, "fehler": ""})
        except Exception as fehler:
            self.antwort("App.baumPartnerEinstellungen", {
                "ok": False, "fehler": fehler_deutsch(
                    fehler, _("Saving the branch settings"))})
        self._baum_stand_melden()

    def _baum_delegieren(self, kennung, aufgabe):
        self._baum_sendung(kennung, "aufgabe", aufgabe)

    def _baum_teilen(self, kennung, art, inhalt):
        if art not in ("termin", "kontakt", "notiz", "notiz_sync", "sync_anfrage",
                       "kontakt_sync", "kontakt_loeschen"):
            self.antwort("App.baumGesendet", {
                "ok": False, "fehler": _("This type cannot be shared.")})
            return
        self._baum_sendung(kennung, art, inhalt)

    def _baum_rueckmeldung(self, kennung, stand):
        """Schickt den Erledigt-Stand zur Herkunft der Aufgabe zurück."""
        if not stand.get("id"):
            self.antwort("App.baumGesendet", {
                "ok": False, "fehler": _("The task is missing from the update.")})
            return
        self._baum_sendung(kennung, "stand", {
            "id": str(stand.get("id") or ""),
            "erledigt": bool(stand.get("erledigt")),
            "geaendert": int(stand.get("geaendert") or 0),
        })

    def _baum_sendung(self, kennung, art, inhalt):
        with self._baum_sperre:
            zustand = self._baum_zustand()
            partner = baum_partner(zustand, kennung) if zustand else None
            if not partner or not partner.get("bestaetigt"):
                self.antwort("App.baumGesendet", {
                    "ok": False,
                    "fehler": _("This branch has not been confirmed.")})
                return
            post = baum_post_lesen(kennwort=self._kennwort)
            baum_kontakt_nutzlast_pruefen(art, inhalt)
            baum_einreihen(post, kennung, art, inhalt)
            if not baum_post_schreiben(post, kennwort=self._kennwort):
                raise RuntimeError(_("The Magnolienbaum outbox could not be saved."))
            bericht = baum_post_zustellen(zustand, post)
            if not baum_post_schreiben(post, kennwort=self._kennwort):
                raise RuntimeError(_("The Magnolienbaum outbox could not be saved."))
            self._baum_sichern(zustand)
        self.antwort("App.baumGesendet", {
            "ok": True, "fehler": "",
            "zugestellt": bericht["zugestellt"], "offen": bericht["offen"],
            "an": partner.get("name") or kennung, "kennung": kennung,
            "art": art})
        self._baum_stand_melden()

    def _baum_eingang_leeren(self, ids):
        with self._baum_sperre:
            behalten = [e for e in baum_eingang_lesen(
                kennwort=self._kennwort) if e.get("id") not in set(ids)]
            baum_eingang_schreiben(behalten, kennwort=self._kennwort)

    def _ablage_setzen(self, text):
        """Legt Text in die Zwischenablage des Systems."""
        try:
            ablage = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            ablage.set_text(text, -1)
            ablage.store()
        except Exception:
            pass

    def _ablage_holen(self):
        """Reicht den Inhalt der Zwischenablage an die Oberfläche."""
        try:
            ablage = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            ablage.request_text(
                lambda _a, text, _d: self.antwort(
                    "App.ablage", {"text": text or ""}), None)
        except Exception:
            self.antwort("App.ablage", {"text": ""})

    def _protokoll_zeigen_arbeit(self):
        freigeschaltet = contributor_dauerhaft_freigeschaltet(
            getattr(self, "_aktuelle_daten", None),
            getattr(self, "_contributor_hash", ""))
        self.antwort("App.protokollStand", protokoll_oeffnen(
            freigeschaltet=freigeschaltet))

    def _vorschlaege_arbeit(self, nachricht):
        nutzlast = rechtschreib_pruefen(
            nachricht.get("wort"), sprache=nachricht.get("sprache"))
        nutzlast["kennung"] = nachricht.get("kennung") or ""
        self.antwort("App.vorschlaege", nutzlast)

    def _wort_merken_arbeit(self, nachricht):
        self.antwort("App.wortGemerkt", wort_aufnehmen(
            nachricht.get("wort"), sprache=nachricht.get("sprache")))

    def _feiertage_arbeit(self, nachricht):
        try:
            nutzlast = feiertage_abrufen(
                nachricht.get("land"), nachricht.get("region"),
                nachricht.get("jahre"), bool(nachricht.get("ferien", True)),
                regionen=nachricht.get("regionen") or [],
                region_erforderlich=bool(
                    nachricht.get("regionErforderlich")))
        except Exception as fehler:
            nutzlast = {"fehler": fehler_deutsch(
                fehler, _("Retrieving holidays"))}
        self.antwort("App.feiertageErgebnis", nutzlast)

    def _wetter_arbeit(self, nachricht):
        try:
            ohne_ort = nachricht.get("ohneOrtAbrufen")
            nutzlast = wetter_abrufen(
                nachricht.get("ort") or "",
                ohne_ort_abrufen=True if ohne_ort is None else bool(ohne_ort))
        except Exception as fehler:
            nutzlast = {"ok": False, "fehler": fehler_deutsch(
                fehler, _("Retrieving weather"))}
        nutzlast["kennung"] = nachricht.get("kennung") or 0
        self.antwort("App.wetterErgebnis", nutzlast)

    def _update_pruefen_arbeit(self):
        self.antwort("App.updateErgebnis", update_pruefen())

    def _import_lokal_arbeit(self):
        try:
            nutzlast = lokal_scannen()
        except Exception as fehler:
            nutzlast = {"fehler": fehler_deutsch(
                fehler, _("Scanning this computer"))}
        nutzlast["art"] = "lokal"
        nutzlast["abgebrochen"] = False
        self.antwort("App.importErgebnis", nutzlast)

    def _eds_status_arbeit(self):
        nutzlast = {"verfuegbar": False, "buchOk": False,
                    "kalender": [], "adressbuecher": [],
                    "fehler": "", "pakete": EDS_PAKETE}
        try:
            if eds_laden():
                registry = eds_registry()
                kalender, buecher = eds_quellen(registry)
                nutzlast.update(verfuegbar=True, buchOk=_EDS["buch_ok"],
                                kalender=kalender, adressbuecher=buecher)
            else:
                nutzlast["fehler"] = _EDS["fehler"]
        except Exception as fehler:
            nutzlast["fehler"] = fehler_deutsch(fehler)
        cloud = nextcloud_status()
        nutzlast["nextcloud"] = cloud
        nutzlast["alleKalender"] = [dict(item, quelle="eds") for item in
                                     nutzlast["kalender"]] + [
                                         dict(item, quelle="nextcloud") for item in
                                         cloud["kalender"]]
        nutzlast["alleAdressbuecher"] = [dict(item, quelle="eds") for item in
                                          nutzlast["adressbuecher"]] + [
                                              dict(item, quelle="nextcloud") for item in
                                              cloud["adressbuecher"]]
        self.antwort("App.edsStatus", nutzlast)

    def _nextcloud_status_melden(self, callback="App.nextcloudStatus"):
        mailbox_status = callback.startswith("App.baumBriefkasten")
        settings = nextcloud_speicher().load()
        pruefung = callback == "App.baumBriefkastenPruefung"
        nutzlast = nextcloud_status(discover=not mailbox_status or bool(
            pruefung and settings and settings["davAktiv"]))
        if callback == "App.baumBriefkastenPruefung" and nutzlast["zustand"] == "bereit":
            if settings and settings["briefkastenAktiv"]:
                try:
                    mailbox = NextcloudMailbox(configured_client(
                        nextcloud_speicher(), purpose="briefkasten"))
                    mailbox.test_access((self._baum_zustand() or {}).get("kennung") or "")
                except Exception as fehler:
                    nutzlast["zustand"] = "fehler"
                    nutzlast["fehler"] = nextcloud_fehlertext(fehler)
                    nutzlast["fehlerCode"] = nextcloud_fehlercode(fehler)
        self.antwort(callback, nutzlast)

    def _nextcloud_speichern(self, dav_aktiv, briefkasten_aktiv, server, benutzer,
                              app_kennwort,
                              kennwort_loeschen, callback="App.nextcloudGespeichert"):
        try:
            nextcloud_speicher().save(dav_aktiv, briefkasten_aktiv, server, benutzer,
                                      app_kennwort,
                                      kennwort_loeschen)
            ergebnis = nextcloud_status(
                discover=not callback.startswith("App.baumBriefkasten"))
        except Exception as fehler:
            ergebnis = {"verfuegbar": True, "aktiv": False, "davAktiv": False,
                        "briefkastenAktiv": False, "server": "", "url": "",
                        "benutzer": "", "kennwortVorhanden": False,
                        "zustand": "fehler", "fehler": nextcloud_fehlertext(fehler),
                        "fehlerCode": nextcloud_fehlercode(fehler),
                        "kalender": [], "adressbuecher": []}
        self.antwort(callback, ergebnis)

    def _sync_status_arbeit(self):
        eds = {"verfuegbar": False, "buchOk": False, "kalender": [],
               "adressbuecher": [], "fehler": "", "pakete": EDS_PAKETE}
        try:
            if eds_laden():
                kalender, buecher = eds_quellen(eds_registry())
                eds.update(verfuegbar=True, buchOk=_EDS["buch_ok"],
                           kalender=kalender, adressbuecher=buecher)
            else:
                eds["fehler"] = _EDS["fehler"]
        except Exception as fehler:
            eds["fehler"] = fehler_deutsch(fehler)
        cloud = nextcloud_status()
        self.antwort("App.syncStatus", {
            "quellen": {"eds": eds, "nextcloud": cloud},
            "kalender": [dict(item, quelle="eds") for item in eds["kalender"]] +
                        [dict(item, quelle="nextcloud") for item in cloud["kalender"]],
            "adressbuecher": [dict(item, quelle="eds") for item in eds["adressbuecher"]] +
                             [dict(item, quelle="nextcloud") for item in cloud["adressbuecher"]],
            "fehler": ""})

    def _sync_arbeit(self, nachricht):
        try:
            self._sync_ausfuehren(nachricht)
        except Exception as fehler:
            text = (nextcloud_fehlertext(fehler) if isinstance(fehler, NextcloudError)
                    else fehler_deutsch(fehler))
            self.sende_js("App.syncFehler(JSON.parse(%s));"
                          % js_zeichenkette(text))
        finally:
            self._sync_laeuft = False

    def _nextcloud_sync_ausfuehren(self, nachricht, kal_uids, buch_uid,
                                   antworten=True, snapshot=True):
        daten = nachricht.get("daten") or {}
        snapshot_funktion = getattr(self, "_journal_snapshot", None)
        if snapshot and snapshot_funktion:
            snapshot_funktion("pre-sync")
        dav = NextcloudDav(configured_client(nextcloud_speicher()))
        termine = [dict(item) for item in (daten.get("termine") or [])]
        kontakte = [dict(item) for item in (daten.get("kontakte") or [])]
        jahrestage = [dict(item) for item in (daten.get("jahrestage") or [])]
        geloescht = daten.get("geloescht") or {}
        tote_termine = [dict(item) for item in (geloescht.get("termine") or [])]
        tote_kontakte = [dict(item) for item in (geloescht.get("kontakte") or [])]
        letzte = daten.get("letzteSyncs") if isinstance(daten.get("letzteSyncs"), dict) else {}
        kalender_syncs = dict(letzte.get("kalender") or {})
        adress_syncs = dict(letzte.get("adressbuecher") or {})
        sync_meta = daten.get("syncMetadaten") if isinstance(daten.get("syncMetadaten"), dict) else {}
        nextcloud_meta = sync_meta.get("nextcloud") if isinstance(
            sync_meta.get("nextcloud"), dict) else {}
        kalender_meta = dict(nextcloud_meta.get("kalender") or {})
        adress_meta = dict(nextcloud_meta.get("adressbuecher") or {})
        # Einmalige Migration bereits ausgelieferter DAV-Cursor aus letzteSyncs.
        for uid, stand in list(kalender_syncs.items()):
            if isinstance(stand, dict):
                kalender_meta.setdefault(uid, stand)
                kalender_syncs[uid] = int(stand.get("letzterSync") or 0)
        for uid, stand in list(adress_syncs.items()):
            if isinstance(stand, dict):
                adress_meta.setdefault(uid, stand)
                adress_syncs[uid] = int(stand.get("letzterSync") or 0)
        bericht = []
        vorschau = None

        if kal_uids:
            ausgewaehlt = set(kal_uids)
            rest = [item for item in termine if item.get("syncKalenderUid") and
                    item.get("syncKalenderUid") not in ausgewaehlt]
            rest_tote = [item for item in tote_termine if item.get("syncKalenderUid") and
                         item.get("syncKalenderUid") not in ausgewaehlt]
            standard = kal_uids[0]
            for uid in kal_uids:
                quelle = _nextcloud_quelle(dav, "calendar", uid)
                resources = dav.report(quelle["href"], "calendar")
                fern, remote_meta, remote_data = {}, {}, {}
                for resource in resources:
                    remote_data[resource["href"]] = resource["data"]
                    gelesen = ics_lesen(resource["data"])
                    if gelesen.get("uebersprungen"):
                        raise RuntimeError(_("The Nextcloud calendar was not read completely."))
                    for item in gelesen["termine"]:
                        item_uid = item.get("uid")
                        if not item_uid or item_uid in fern:
                            raise RuntimeError(_("The Nextcloud calendar contains missing or duplicate UIDs."))
                        fern[item_uid] = item
                        remote_meta[item_uid] = {"href": resource["href"],
                                                 "etag": resource["etag"]}
                basis = kalender_meta.get(uid) if isinstance(kalender_meta.get(uid), dict) else {}
                erster = not basis.get("initialisiert")
                lokal = []
                for item in termine:
                    besitzer = item.get("syncKalenderUid") or ""
                    if besitzer == uid or (not besitzer and uid == standard):
                        item["syncKalenderUid"] = uid
                        lokal.append(item)
                tombstones = [item for item in tote_termine if
                              item.get("syncKalenderUid") == uid or
                              (not item.get("syncKalenderUid") and uid == standard)]
                if erster:
                    lokal_nach_uid = {item.get("uid"): item for item in lokal if item.get("uid")}
                    for item in lokal:
                        item["sync"] = False
                    empfangen = 0
                    for item_uid, remote in fern.items():
                        local = lokal_nach_uid.get(item_uid)
                        if local is None:
                            local = dict(remote)
                            lokal.append(local)
                            empfangen += 1
                        elif (remote.get("geaendert") or 0) > (local.get("geaendert") or 0):
                            for feld in TERMIN_FELDER:
                                if feld in remote:
                                    local[feld] = remote[feld]
                            for feld in ICS_BEGLEITFELDER:
                                if feld in remote:
                                    local[feld] = remote[feld]
                                else:
                                    local.pop(feld, None)
                        local["sync"] = True
                        local["syncKalenderUid"] = uid
                        meta = remote_meta[item_uid]
                        local["davHref"] = meta["href"]
                        local["davEtag"] = meta["etag"]
                        _dav_syncquelle_setzen(local, uid, meta["href"], meta["etag"])
                    rest.extend(lokal)
                    rest_tote.extend(tombstones)
                    sync_zeit = jetzt_ms()
                    kalender_meta[uid] = {"initialisiert": True, "letzterSync": sync_zeit,
                                          "etags": remote_meta}
                    kalender_syncs[uid] = sync_zeit
                    bericht.append(_("Appointments: safe first import from %(source)s: %(count)d received.") %
                                   {"source": quelle["name"], "count": empfangen})
                    continue
                for item in lokal:
                    if item.get("uid") in remote_meta:
                        item["davHref"] = remote_meta[item["uid"]]["href"]
                        item["davEtag"] = remote_meta[item["uid"]]["etag"]
                        _dav_syncquelle_setzen(item, uid, item["davHref"], item["davEtag"])
                merged, anlegen, aendern, loeschen, zaehler = sync_merge(
                    lokal, fern, tombstones, int(basis.get("letzterSync") or 0),
                    TERMIN_FELDER)
                fehler = 0
                for item in anlegen:
                    href = quelle["href"].rstrip("/") + "/" + _dav_uid_dateiname(item["uid"], ".ics")
                    try:
                        item["davEtag"] = dav.put(
                            href, ics_schreiben_termine([item]), create=True)
                        item["davHref"] = href
                        _dav_syncquelle_setzen(item, uid, href, item["davEtag"])
                        remote_meta[item["uid"]] = {"href": href,
                                                     "etag": item["davEtag"]}
                    except Exception:
                        item["sync"] = False
                        fehler += 1
                for item in aendern:
                    meta = remote_meta.get(item["uid"])
                    try:
                        if not meta:
                            raise RuntimeError(_("The DAV ETag is missing."))
                        resource_text = ics_resource_aktualisieren(
                            remote_data[meta["href"]], item)
                        item["davEtag"] = dav.put(
                            meta["href"], resource_text, meta["etag"])
                        remote_data[meta["href"]] = resource_text
                        for andere_meta in remote_meta.values():
                            if andere_meta.get("href") == meta["href"]:
                                andere_meta["etag"] = item["davEtag"]
                        item["davHref"] = meta["href"]
                        _dav_syncquelle_setzen(item, uid, meta["href"], item["davEtag"])
                        remote_meta[item["uid"]] = {"href": meta["href"],
                                                     "etag": item["davEtag"]}
                    except Exception:
                        fehler += 1
                geschafft = set()
                for item_uid in loeschen:
                    meta = remote_meta.get(item_uid)
                    try:
                        if not meta:
                            raise RuntimeError(_("The DAV ETag is missing."))
                        dav.delete(meta["href"], meta["etag"])
                        geschafft.add(item_uid)
                        remote_meta.pop(item_uid, None)
                    except Exception:
                        fehler += 1
                tote_nach_uid = {item.get("uid"): item for item in tombstones}
                for item_uid in loeschen:
                    if item_uid in geschafft:
                        continue
                    tombstone = dict(tote_nach_uid.get(item_uid) or {})
                    tombstone.update({"uid": item_uid,
                                      "zeit": tombstone.get("zeit", 0),
                                      "syncKalenderUid": uid})
                    rest_tote.append(tombstone)
                for item in merged:
                    item["syncKalenderUid"] = uid
                    meta = remote_meta.get(item.get("uid"))
                    if meta:
                        item["davHref"] = meta["href"]
                        item["davEtag"] = meta["etag"]
                        _dav_syncquelle_setzen(item, uid, meta["href"], meta["etag"])
                rest.extend(merged)
                if not fehler:
                    sync_zeit = jetzt_ms()
                    kalender_meta[uid] = {"initialisiert": True,
                                          "letzterSync": sync_zeit,
                                          "etags": remote_meta}
                    kalender_syncs[uid] = sync_zeit
                bericht.append(_sync_satz(_("Appointments"), zaehler, fehler))
            termine, tote_termine = rest, rest_tote

        if buch_uid:
            quelle = _nextcloud_quelle(dav, "addressbook", buch_uid)
            resources = dav.report(quelle["href"], "addressbook")
            fern, remote_meta = {}, {}
            geburtstage = []
            for resource in resources:
                gelesen = vcf_lesen(resource["data"])
                if gelesen.get("uebersprungen") or len(gelesen["kontakte"]) != 1:
                    raise RuntimeError(_("The Nextcloud address book was not read completely."))
                item = gelesen["kontakte"][0]
                item_uid = item.get("uid")
                if not item_uid or item_uid in fern:
                    raise RuntimeError(_("The Nextcloud address book contains missing or duplicate UIDs."))
                fern[item_uid] = item
                remote_meta[item_uid] = {"href": resource["href"], "etag": resource["etag"]}
                geburtstage.extend(gelesen.get("geburtstage") or [])
            basis = adress_meta.get(buch_uid) if isinstance(adress_meta.get(buch_uid), dict) else {}
            erster = not basis.get("initialisiert")
            if erster:
                kontakte, plan = kontakte_erster_sync(kontakte, fern)
                for item in kontakte:
                    item_uid = item.get("uid")
                    if item_uid in remote_meta:
                        item["davHref"] = remote_meta[item_uid]["href"]
                        item["davEtag"] = remote_meta[item_uid]["etag"]
                        _dav_syncquelle_setzen(item, buch_uid, item["davHref"], item["davEtag"])
                zaehler = {"lokal_neu": plan["lokalNeu"],
                           "lokal_geaendert": plan["lokalAktualisiert"],
                           "lokal_geloescht": 0, "remote_neu": 0,
                           "remote_geaendert": 0, "remote_geloescht": 0}
                anlegen, aendern, loeschen, fehler = [], [], [], 0
            else:
                kontakte_vor_sync_zuordnen(kontakte, fern)
                alte_etags = basis.get("etags") if isinstance(basis.get("etags"), dict) else {}
                lokal_nach_uid = {item.get("uid"): item for item in kontakte if item.get("uid")}
                letzter_sync = int(basis.get("letzterSync") or 0)
                bisheriger_hash = str(basis.get("snapshotHash") or "")
                remote_inhalt_geaendert = (not bisheriger_hash or
                                            bisheriger_hash != kontakt_snapshot_hash(list(fern.values())))
                for item_uid, remote in fern.items():
                    alt = alte_etags.get(item_uid) if isinstance(alte_etags.get(item_uid), dict) else {}
                    local = lokal_nach_uid.get(item_uid)
                    if (remote_inhalt_geaendert and local is not None and alt.get("etag") and
                            alt.get("etag") != remote_meta[item_uid].get("etag") and
                            (remote.get("geaendert") or 0) <= (local.get("geaendert") or 0)):
                        # REV ist bei mehreren CardDAV-Anbietern optional oder
                        # unverändert. Ein neuer ETag ist dort das stärkere Signal.
                        remote["geaendert"] = max((local.get("geaendert") or 0) + 1,
                                                   letzter_sync + 1)
                for item in kontakte:
                    if item.get("uid") in remote_meta:
                        item["davHref"] = remote_meta[item["uid"]]["href"]
                        item["davEtag"] = remote_meta[item["uid"]]["etag"]
                        _dav_syncquelle_setzen(item, buch_uid, item["davHref"], item["davEtag"])
                kontakte, anlegen, aendern, loeschen, zaehler = sync_merge(
                    kontakte, fern, tote_kontakte,
                    letzter_sync, KONTAKT_FELDER)
                fehler = 0
            erfolgreich = {"anlegen": 0, "aendern": 0, "loeschen": 0}
            for item in anlegen:
                href = quelle["href"].rstrip("/") + "/" + _dav_uid_dateiname(item["uid"], ".vcf")
                try:
                    item["davEtag"] = dav.put(href, vcard_text(item), create=True)
                    item["davHref"] = href
                    _dav_syncquelle_setzen(item, buch_uid, href, item["davEtag"])
                    remote_meta[item["uid"]] = {"href": href,
                                                 "etag": item["davEtag"]}
                    erfolgreich["anlegen"] += 1
                except Exception:
                    item["sync"] = False
                    fehler += 1
            for item in aendern:
                meta = remote_meta.get(item["uid"])
                try:
                    if not meta or not meta.get("etag"):
                        raise RuntimeError(_("The DAV ETag is missing."))
                    item["davEtag"] = dav.put(meta["href"], vcard_text(item), meta["etag"])
                    item["davHref"] = meta["href"]
                    _dav_syncquelle_setzen(item, buch_uid, meta["href"], item["davEtag"])
                    remote_meta[item["uid"]] = {"href": meta["href"],
                                                 "etag": item["davEtag"]}
                    erfolgreich["aendern"] += 1
                except Exception:
                    fehler += 1
            geschafft = set()
            for item_uid in loeschen:
                meta = remote_meta.get(item_uid)
                try:
                    if not meta or not meta.get("etag"):
                        raise RuntimeError(_("The DAV ETag is missing."))
                    dav.delete(meta["href"], meta["etag"])
                    geschafft.add(item_uid)
                    remote_meta.pop(item_uid, None)
                    erfolgreich["loeschen"] += 1
                except Exception:
                    fehler += 1
            tote_kontakte = kontakt_grabsteine_nach_loeschung(
                tote_kontakte, loeschen, geschafft, jetzt_ms())
            for item in kontakte:
                meta = remote_meta.get(item.get("uid"))
                if meta:
                    item["davHref"] = meta["href"]
                    item["davEtag"] = meta["etag"]
                    _dav_syncquelle_setzen(item, buch_uid, meta["href"], meta["etag"])
            if not fehler:
                sync_zeit = jetzt_ms()
                adress_meta[buch_uid] = {"initialisiert": True,
                                         "letzterSync": sync_zeit,
                                         "remoteAnzahl": len(fern),
                                         "snapshotHash": kontakt_snapshot_hash(list(fern.values())),
                                         "etags": remote_meta}
                adress_syncs[buch_uid] = sync_zeit
            bericht.append((_("Contacts: safe first import from %(source)s: %(count)d received.") %
                            {"source": quelle["name"], "count": zaehler["lokal_neu"]}) if erster else
                           _sync_satz(_("Contacts"), zaehler, fehler))
            vorschau = {"quelle": quelle["name"],
                        "modus": "erstimport" if erster else "bidirektional",
                        "remoteGemeldet": len(resources), "remoteGelesen": len(fern),
                        "lokalNeu": zaehler["lokal_neu"],
                        "lokalAktualisiert": zaehler["lokal_geaendert"],
                        "remoteGeplant": {"anlegen": len(anlegen),
                                           "aendern": len(aendern),
                                           "loeschen": len(loeschen)},
                        "remoteErfolgreich": erfolgreich, "fehler": fehler}
            vorhandene = {(kanonischer_text(item.get("name")),
                            (item.get("datum") or "")[5:]) for item in jahrestage}
            for geburtstag in geburtstage:
                key = (kanonischer_text(geburtstag["name"]), geburtstag["datum"][5:])
                if key not in vorhandene:
                    jahrestage.append({"name": geburtstag["name"],
                                       "datum": geburtstag["datum"], "typ": "birthday",
                                       "uid": _neue_uid(), "geaendert": jetzt_ms()})
                    vorhandene.add(key)

        nextcloud_meta = dict(nextcloud_meta)
        nextcloud_meta.update({"kalender": kalender_meta, "adressbuecher": adress_meta,
            "quarantinedDeletes": dict(nextcloud_meta.get("quarantinedDeletes") or {}),
            "transaktionen": dict(nextcloud_meta.get("transaktionen") or {})})
        neue_sync_meta = dict(sync_meta)
        neue_sync_meta.update({"syncEpoch": sync_meta.get("syncEpoch") or
                               daten.get("syncEpoch") or str(uuid.uuid4()),
                               "ersteSyncLoeschungsfrei": False,
                               "quarantinedDeletes": sync_meta.get("quarantinedDeletes") or {},
                               "nextcloud": nextcloud_meta})
        ergebnis = {
            "termine": termine, "kontakte": kontakte, "jahrestage": jahrestage,
            "geloescht": {"termine": tote_termine, "kontakte": tote_kontakte},
            "letzterSync": jetzt_ms(),
            "letzteSyncs": {"kalender": kalender_syncs, "adressbuecher": adress_syncs},
            "adressbuchBaselineKandidat": None, "kontaktVorschau": vorschau,
            "syncMetadaten": neue_sync_meta,
            "bericht": " ".join(bericht) or _("Synchronization completed.")}
        if antworten:
            self.antwort("App.syncFertig", ergebnis)
        return ergebnis

    def _sync_ausfuehren(self, nachricht, antworten=True, snapshot=True):
        daten = nachricht.get("daten") or {}
        snapshot_funktion = getattr(self, "_journal_snapshot", None)
        if snapshot and snapshot_funktion:
            snapshot_funktion("pre-sync")
        wahl = nachricht.get("wahl") or {}
        kal_uids = []
        rohe_kal_uids = wahl.get("kalenderUids") or []
        if not isinstance(rohe_kal_uids, (list, tuple)):
            rohe_kal_uids = []
        for uid in rohe_kal_uids:
            uid = str(uid or "").strip()
            if uid and uid not in kal_uids:
                kal_uids.append(uid)
        kal_uid = (wahl.get("kalenderUid") or "").strip()
        if kal_uid and kal_uid not in kal_uids:
            kal_uids.insert(0, kal_uid)
        if not kal_uid and kal_uids:
            kal_uid = kal_uids[0]
        buch_uid = (wahl.get("adressbuchUid") or "").strip()
        if not kal_uids and not buch_uid:
            raise RuntimeError(_(
                "First select a calendar or address book from the online accounts."))
        nextcloud_gewaehlt = (any(uid.startswith("nextcloud-calendar:") for uid in kal_uids)
                              or buch_uid.startswith("nextcloud-addressbook:"))
        nextcloud_kalender, eds_kalender, nextcloud_buch, eds_buch = \
            sync_quellen_aufteilen(kal_uids, buch_uid)
        if nextcloud_gewaehlt and not eds_kalender and not eds_buch:
            return self._nextcloud_sync_ausfuehren(
                nachricht, nextcloud_kalender, nextcloud_buch,
                antworten=antworten, snapshot=False)
        if nextcloud_gewaehlt:
            transaktions_id = hashlib.sha256(json.dumps({
                "kalender": sorted(kal_uids), "adressbuch": buch_uid,
                "epoch": daten.get("syncEpoch") or ""}, sort_keys=True,
                separators=(",", ":")).encode("utf-8")).hexdigest()
            voriger_stand = sync_transaktion_lesen()
            transaktion = {"id": transaktions_id, "status": "prepared",
                "phase": "nextcloud", "wiederaufnahme":
                    voriger_stand.get("id") == transaktions_id,
                "kalender": sorted(kal_uids), "adressbuch": buch_uid}
            vorbereitete_daten = dict(daten)
            vorbereitete_meta = dict(daten.get("syncMetadaten") or {})
            vorbereitete_nextcloud = dict(vorbereitete_meta.get("nextcloud") or {})
            transaktionen = dict(vorbereitete_nextcloud.get("transaktionen") or {})
            transaktionen[transaktions_id] = dict(transaktion)
            vorbereitete_nextcloud["transaktionen"] = transaktionen
            vorbereitete_meta["nextcloud"] = vorbereitete_nextcloud
            vorbereitete_daten["syncMetadaten"] = vorbereitete_meta
            vorbereitete_nachricht = dict(nachricht)
            vorbereitete_nachricht["daten"] = vorbereitete_daten
            sync_transaktion_schreiben(transaktion)
            if (voriger_stand.get("id") == transaktions_id and
                    voriger_stand.get("phase") == "eds" and
                    isinstance(voriger_stand.get("zwischenstand"), dict)):
                cloud = voriger_stand["zwischenstand"]
            else:
                cloud = self._nextcloud_sync_ausfuehren(
                    vorbereitete_nachricht, nextcloud_kalender, nextcloud_buch,
                    antworten=False, snapshot=False)
            transaktion["phase"] = "eds"
            transaktion["zwischenstand"] = cloud
            sync_transaktion_schreiben(transaktion)
            folge_daten = dict(daten)
            for feld in ("termine", "kontakte", "jahrestage", "geloescht",
                         "letzterSync", "letzteSyncs", "syncMetadaten", "syncEpoch"):
                if feld in cloud:
                    folge_daten[feld] = cloud[feld]
            folge = {"daten": folge_daten, "wahl": {
                "kalenderUid": eds_kalender[0] if eds_kalender else "",
                "kalenderUids": eds_kalender, "adressbuchUid": eds_buch}}
            ergebnis = self._sync_ausfuehren(
                folge, antworten=False, snapshot=False)
            ergebnis_meta = ergebnis.get("syncMetadaten") or {}
            ergebnis_nextcloud = ergebnis_meta.get("nextcloud") or {}
            ergebnis_transaktionen = ergebnis_nextcloud.get("transaktionen") or {}
            ergebnis_transaktionen[transaktions_id] = dict(
                transaktion, status="complete", phase="complete")
            ergebnis_nextcloud["transaktionen"] = ergebnis_transaktionen
            ergebnis_meta["nextcloud"] = ergebnis_nextcloud
            ergebnis["syncMetadaten"] = ergebnis_meta
            berichte = [text for text in (cloud.get("bericht"), ergebnis.get("bericht"))
                         if text and text != _("Synchronization completed.")]
            ergebnis["bericht"] = " ".join(berichte) or _("Synchronization completed.")
            if antworten:
                self.antwort("App.syncFertig", ergebnis)
            sync_transaktion_abschliessen()
            return ergebnis
        if not eds_laden():
            raise RuntimeError(
                _("Online account integration (Evolution Data Server) is not available "
                  "on this system. Install it with:\nsudo apt install %s") % EDS_PAKETE)

        termine = list(daten.get("termine") or [])
        kontakte = list(daten.get("kontakte") or [])
        jahrestage = list(daten.get("jahrestage") or [])
        geloescht = daten.get("geloescht") or {}
        tote_termine = list(geloescht.get("termine") or [])
        tote_kontakte = list(geloescht.get("kontakte") or [])
        sync_meta = daten.get("syncMetadaten") if isinstance(
            daten.get("syncMetadaten"), dict) else {}
        eds_meta = sync_meta.get("eds") if isinstance(sync_meta.get("eds"), dict) else {}
        eds_adress_meta = dict(eds_meta.get("adressbuecher") or {})
        loeschungsfrei = bool(sync_meta.get("ersteSyncLoeschungsfrei") or
                             ((daten.get("einstellungen") or {}).get("sync") or {}).get(
                                 "ersteSyncLoeschungsfrei"))
        if loeschungsfrei:
            tote_termine = []
            tote_kontakte = []
        letzter = int(daten.get("letzterSync") or 0)
        letzte_syncs_roh = daten.get("letzteSyncs") or {}
        if not isinstance(letzte_syncs_roh, dict):
            letzte_syncs_roh = {}
        rohe_kalender_syncs = letzte_syncs_roh.get("kalender") or {}
        kalender_syncs = dict(rohe_kalender_syncs) if isinstance(
            rohe_kalender_syncs, dict) else {}
        rohe_adressbuch_syncs = letzte_syncs_roh.get("adressbuecher") or {}
        adressbuch_syncs = dict(rohe_adressbuch_syncs) if isinstance(
            rohe_adressbuch_syncs, dict) else {}
        # Vor dem gemeinsamen Metadatenschema lagen EDS-Baselines hier.
        if buch_uid and buch_uid not in eds_adress_meta:
            alter_buch_stand = adressbuch_syncs.get(buch_uid)
            if isinstance(alter_buch_stand, dict) and alter_buch_stand.get("initialisiert"):
                eds_adress_meta[buch_uid] = dict(alter_buch_stand)
            elif isinstance(alter_buch_stand, (int, float)) and alter_buch_stand > 0:
                eds_adress_meta[buch_uid] = {
                    "initialisiert": True, "letzterSync": int(alter_buch_stand)}
        if buch_uid:
            adressbuch_syncs.pop(buch_uid, None)
        bericht = []
        registry = eds_registry()

        buch_client = buch_lesen = buch_fern = buch_basis = None
        erster_buch_sync = False
        buch_name = buch_uid
        if buch_uid and _EDS["buch_ok"]:
            try:
                buch_quelle = _quelle(registry, buch_uid)
                buch_name = buch_quelle.get_display_name() or buch_uid
            except Exception:
                pass
            buch_client = eds_buch_client(registry, buch_uid)
            buch_basis = eds_adress_meta.get(buch_uid)
            if not isinstance(buch_basis, dict):
                buch_basis = {}
            erster_buch_sync = not bool(buch_basis.get("initialisiert"))
            if erster_buch_sync and "refresh-supported" in (
                    getattr(buch_client, "get_capabilities", lambda: [])() or []):
                try:
                    if buch_client.refresh_sync(None) is False:
                        raise RuntimeError(_(
                            "The address book backend could not be refreshed."))
                except RuntimeError:
                    raise
                except Exception as fehler:
                    raise RuntimeError(_("The address book could not be refreshed: %s") %
                                       fehler)
            buch_lesen = eds_kontakte_lesen(buch_client)
            if not buch_lesen["vollstaendig"]:
                details = "; ".join(buch_lesen["fehler"][:3])
                raise RuntimeError(_(
                    "Contact synchronization was stopped because the address book "
                    "was not read completely: %s") % (details or _("unknown error")))
            buch_fern = {k["uid"]: k for k in buch_lesen["kontakte"]}

        if kal_uids:
            ausgewaehlt = set(kal_uids)
            uebrige_termine = [t for t in termine
                               if not t.get("syncKalenderUid") or
                               t.get("syncKalenderUid") not in ausgewaehlt]
            uebrige_tote = [t for t in tote_termine
                            if not t.get("syncKalenderUid") or
                            t.get("syncKalenderUid") not in ausgewaehlt]
            neue_termine = list(uebrige_termine)
            neue_tote = list(uebrige_tote)
            sync_zeit = jetzt_ms()
            for quelle_uid in kal_uids:
                quelle_name = _("Evolution Data Server")
                try:
                    quellobjekt = _quelle(registry, quelle_uid)
                    quelle_name = _eds_quellenname(registry, quellobjekt)
                except Exception:
                    pass
                client = eds_kalender_client(registry, quelle_uid)
                fern = {}
                fern_gelesen = []
                gesperrte_serien = set()
                for text in eds_events_lesen(client):
                    # Online-Kalenderereignisse bleiben Kalenderereignisse. Eine
                    # Umklassifizierung als Magnolie-Jahrestag würde Kategorien,
                    # Alarme und die Serienprovenienz verlieren.
                    gelesen = ics_lesen(text, jahrestage_als_termine=True)
                    if gelesen.get("uebersprungen"):
                        raise RuntimeError(_(
                            "Calendar synchronization was stopped because an EDS "
                            "entry was not read completely."))
                    fern_gelesen.extend(gelesen["termine"])
                    gesperrte_serien.update(gelesen.get("komplexeSerien") or [])
                gesperrte_serien.update({
                    t.get("icsSerienUid") or t.get("uid")
                    for t in fern_gelesen if t.get("icsKomplex")})
                gesperrte_serien.discard("")
                gesperrte_serien.discard(None)
                fern_komplex = []
                for t in fern_gelesen:
                    _termin_quelle_hinzufuegen(
                        t, "eds:" + quelle_uid, quelle_name, t.get("uid"))
                    t["kalenderQuelle"] = {"id": quelle_uid, "name": quelle_name,
                                            "anbieter": _("Evolution Data Server")}
                    if (t.get("uid") and t.get("uid") not in gesperrte_serien and
                            t.get("icsSerienUid") not in gesperrte_serien):
                        if t["uid"] in fern:
                            raise RuntimeError(_(
                                "Calendar synchronization was stopped because EDS "
                                "returned the same appointment identifier more than once."))
                        fern[t["uid"]] = t
                    elif t.get("uid"):
                        t["icsReadOnly"] = True
                        t["icsReadOnlyGrund"] = "EDS"
                        t["syncKalenderUid"] = quelle_uid
                        t["sync"] = True
                        fern_komplex.append(t)
                belegte_uids = {str(t.get("uid") or "") for t in termine}
                zugeordnete_lokale = set()
                termin_index = {}
                for vorhanden in termine:
                    for kennung in _termin_externe_kennungen(vorhanden):
                        termin_index.setdefault(kennung, []).append(vorhanden)
                for entfernt in fern_gelesen:
                    kandidaten = []
                    kandidaten_ids = set()
                    for kennung in _termin_externe_kennungen(entfernt):
                        for vorhanden in termin_index.get(kennung, ()):
                            if id(vorhanden) not in kandidaten_ids:
                                kandidaten.append(vorhanden)
                                kandidaten_ids.add(id(vorhanden))
                    for vorhanden in kandidaten:
                        if id(vorhanden) in zugeordnete_lokale:
                            continue
                        besitzer = vorhanden.get("syncKalenderUid") or ""
                        if besitzer not in ("", quelle_uid) or not _termin_eds_ics_identisch(
                                vorhanden, entfernt):
                            continue
                        remote_uid = str(entfernt.get("uid") or "")
                        _termin_quelle_hinzufuegen(
                            vorhanden, "eds:" + quelle_uid, quelle_name, remote_uid)
                        vorhanden["kalenderQuelle"] = {
                            "id": quelle_uid, "name": quelle_name,
                            "anbieter": _("Evolution Data Server")}
                        vorhanden["syncKalenderUid"] = quelle_uid
                        zugeordnete_lokale.add(id(vorhanden))
                        if remote_uid and (remote_uid == vorhanden.get("uid") or
                                           remote_uid not in belegte_uids):
                            belegte_uids.discard(str(vorhanden.get("uid") or ""))
                            vorhanden["uid"] = remote_uid
                            belegte_uids.add(remote_uid)
                        break
                neue_termine = [t for t in neue_termine
                                 if t.get("syncKalenderUid") != quelle_uid]
                lokal = []
                geschuetzt = 0
                vorhandene_komplex_uids = set()
                for t in termine:
                    besitzer = t.get("syncKalenderUid") or ""
                    if besitzer == quelle_uid:
                        if (t.get("icsKomplex") or
                                t.get("uid") in gesperrte_serien or
                                t.get("icsSerienUid") in gesperrte_serien):
                            t["icsReadOnly"] = True
                            t["icsReadOnlyGrund"] = "EDS"
                            _termin_quelle_hinzufuegen(
                                t, "eds:" + quelle_uid, quelle_name, t.get("uid"))
                            neue_termine.append(t)
                            vorhandene_komplex_uids.add(t.get("uid"))
                            geschuetzt += 1
                            continue
                        lokal.append(t)
                tombstones = []
                for t in tote_termine:
                    besitzer = t.get("syncKalenderUid") or ""
                    if besitzer == quelle_uid:
                        if t.get("uid") in gesperrte_serien:
                            neue_tote.append(t)
                            geschuetzt += 1
                            continue
                        tombstones.append(t)
                neue_komplexe = [t for t in fern_komplex
                                  if t.get("uid") not in vorhandene_komplex_uids]
                neue_termine.extend(neue_komplexe)
                letzter_kalender_sync = int(kalender_syncs.get(quelle_uid) or
                                             (letzter if quelle_uid == kal_uid else 0))
                for obj in lokal:
                    uid_wert = str(obj.get("uid") or "")
                    if (obj.get("sync") and uid_wert and uid_wert not in fern and
                            (obj.get("geaendert") or 0) <= letzter_kalender_sync and
                            not eds_event_fehlend_bestaetigt(client, uid_wert)):
                        raise RuntimeError(_(
                            "Calendar synchronization was stopped because the full "
                            "calendar result omitted an appointment that still exists."))
                lokal, anlegen, aendern, loeschen, z = sync_merge(
                    lokal, fern, tombstones, letzter_kalender_sync, TERMIN_FELDER)
                for obj in lokal:
                    obj["syncKalenderUid"] = quelle_uid
                    _termin_quelle_hinzufuegen(
                        obj, "eds:" + quelle_uid, quelle_name, obj.get("uid"))
                fehler = 0
                for obj in anlegen:
                    try:
                        neu = eds_event_anlegen(client, vevent_text(obj))
                        if neu and neu != obj["uid"]:
                            obj["uid"] = neu
                    except Exception:
                        fehler += 1
                        obj["sync"] = False
                for obj in aendern:
                    try:
                        eds_event_aendern(client, vevent_text(obj))
                    except Exception:
                        fehler += 1
                geschafft = set()
                for uid in loeschen:
                    try:
                        eds_event_loeschen(client, uid)
                        geschafft.add(uid)
                    except Exception:
                        fehler += 1
                zeiten = {t.get("uid"): t.get("zeit", 0) for t in tombstones}
                neue_tote.extend(grabsteine_behalten(tombstones, sync_zeit))
                vorhandene_tote = {str(t.get("uid") or "") for t in neue_tote
                                   if t.get("syncKalenderUid") == quelle_uid}
                neue_tote.extend({"uid": uid, "zeit": zeiten.get(uid, 0),
                                  "syncKalenderUid": quelle_uid}
                                 for uid in loeschen
                                 if uid not in geschafft and uid not in vorhandene_tote)
                neue_termine.extend(lokal)
                kalender_syncs[quelle_uid] = sync_zeit
                bericht.append(_sync_satz(
                    "%s · %s" % (quelle_name, _("Appointments")), z, fehler))
                if neue_komplexe:
                    anzahl = len(neue_komplexe)
                    bericht.append("%s: %s (%s)." % (quelle_name,
                        ngettext("%d appointment", "%d appointments", anzahl) % anzahl,
                        _nur_lesen_text()))
            termine = neue_termine
            tote_termine = neue_tote

        if buch_uid:
            if not _EDS["buch_ok"]:
                bericht.append(_(
                    "Contacts: component gir1.2-ebook-1.2 is missing; skipped."))
            else:
                client = buch_client
                fern = buch_fern
                geburtstage = buch_lesen["geburtstage"]
                erster_buch_sync = not bool(buch_basis.get("initialisiert"))
                if erster_buch_sync:
                    kontakte, plan = kontakte_erster_sync(kontakte, fern)
                    anlegen, aendern, loeschen = [], [], []
                    z = {"lokal_neu": plan["lokalNeu"],
                         "lokal_geaendert": plan["lokalAktualisiert"],
                         "lokal_geloescht": 0, "remote_neu": 0,
                         "remote_geaendert": 0, "remote_geloescht": 0}
                else:
                    kontakte_vor_sync_zuordnen(kontakte, fern)
                    kontakte, anlegen, aendern, loeschen, z = sync_merge(
                        kontakte, fern, tote_kontakte,
                        int(buch_basis.get("letzterSync") or letzter),
                        KONTAKT_FELDER)
                geplant = {"anlegen": len(anlegen), "aendern": len(aendern),
                            "loeschen": len(loeschen)}
                erfolgreich = {"anlegen": 0, "aendern": 0, "loeschen": 0}
                fehler = 0
                for obj in anlegen:
                    try:
                        neu = eds_kontakt_anlegen(client, vcard_text(obj))
                        if neu and neu != obj["uid"]:
                            obj["uid"] = neu
                        erfolgreich["anlegen"] += 1
                    except Exception:
                        fehler += 1
                        obj["sync"] = False
                for obj in aendern:
                    try:
                        eds_kontakt_aendern(client, vcard_text(obj))
                        erfolgreich["aendern"] += 1
                    except Exception:
                        fehler += 1
                geschafft = set()
                for u in loeschen:
                    try:
                        eds_kontakt_loeschen(client, u)
                        geschafft.add(u)
                        erfolgreich["loeschen"] += 1
                    except Exception:
                        fehler += 1
                tote_kontakte = kontakt_grabsteine_nach_loeschung(
                    tote_kontakte, loeschen, geschafft, jetzt_ms())
                if erster_buch_sync:
                    bericht.append(_(
                        "Contacts: safe first import from %(source)s: %(count)d received.") % {
                            "source": buch_name, "count": z["lokal_neu"]})
                else:
                    wirklich = dict(z)
                    wirklich["remote_neu"] = erfolgreich["anlegen"]
                    wirklich["remote_geaendert"] = erfolgreich["aendern"]
                    wirklich["remote_geloescht"] = erfolgreich["loeschen"]
                    bericht.append(_sync_satz(_("Contacts"), wirklich, fehler))
                    if not fehler:
                        sync_zeit = jetzt_ms()
                        eds_adress_meta[buch_uid] = {
                            "initialisiert": True, "letzterSync": sync_zeit,
                            "remoteAnzahl": buch_lesen["remoteGesamt"],
                            "snapshotHash": kontakt_snapshot_hash(
                                buch_lesen["kontakte"])}

                vorhandene = {(kanonischer_text(j.get("name")),
                               (j.get("datum") or "")[5:]) for j in jahrestage}
                neu_jt = 0
                for g in geburtstage:
                    schluessel = (kanonischer_text(g["name"]), g["datum"][5:])
                    if g["name"] and g["datum"] and schluessel not in vorhandene:
                        jahrestage.append({"name": g["name"], "datum": g["datum"],
                                           "typ": "birthday",
                                           "uid": _neue_uid(),
                                           "geaendert": jetzt_ms()})
                        vorhandene.add(schluessel)
                        neu_jt += 1
                if neu_jt:
                    bericht.append(ngettext(
                        "%d birthday from the address book added as an anniversary.",
                        "%d birthdays from the address book added as anniversaries.",
                        neu_jt) % neu_jt)

        adressbuch_kandidat = None
        if buch_uid and _EDS["buch_ok"] and erster_buch_sync:
            adressbuch_kandidat = {
                "sourceUid": buch_uid, "initialisiert": True,
                "letzterSync": jetzt_ms(),
                "remoteAnzahl": buch_lesen["remoteGesamt"],
                "snapshotHash": kontakt_snapshot_hash(buch_lesen["kontakte"])}
        neue_sync_meta = dict(sync_meta)
        neue_sync_meta.update({"syncEpoch": sync_meta.get("syncEpoch") or
                               daten.get("syncEpoch") or str(uuid.uuid4()),
                               "ersteSyncLoeschungsfrei": False,
                               "quarantinedDeletes": sync_meta.get("quarantinedDeletes") or {},
                               "eds": {"adressbuecher": eds_adress_meta}})
        ergebnis = {
            "termine": termine, "kontakte": kontakte, "jahrestage": jahrestage,
            "geloescht": {"termine": tote_termine, "kontakte": tote_kontakte},
            "letzterSync": jetzt_ms(),
            "letzteSyncs": {"kalender": kalender_syncs,
                             "adressbuecher": adressbuch_syncs},
            "adressbuchBaselineKandidat": adressbuch_kandidat,
            "kontaktVorschau": ({
                "quelle": buch_name,
                "modus": "erstimport" if erster_buch_sync else "bidirektional",
                "remoteGemeldet": buch_lesen["remoteGesamt"],
                "remoteGelesen": buch_lesen["gueltigeUids"],
                "lokalNeu": z["lokal_neu"],
                "lokalAktualisiert": z["lokal_geaendert"],
                "remoteGeplant": geplant,
                "remoteErfolgreich": erfolgreich,
                "fehler": fehler} if buch_uid and _EDS["buch_ok"] else None),
            "syncMetadaten": neue_sync_meta,
            "bericht": " ".join(bericht) or _("Synchronization completed.")}
        if antworten:
            self.antwort("App.syncFertig", ergebnis)
        return ergebnis


def sync_quellen_aufteilen(kalender_uids, adressbuch_uid):
    nextcloud_kalender = [uid for uid in kalender_uids
                          if uid.startswith("nextcloud-calendar:")]
    eds_kalender = [uid for uid in kalender_uids
                    if not uid.startswith("nextcloud-calendar:")]
    nextcloud_buch = (adressbuch_uid if adressbuch_uid.startswith(
        "nextcloud-addressbook:") else "")
    return nextcloud_kalender, eds_kalender, nextcloud_buch, (
        "" if nextcloud_buch else adressbuch_uid)


def _dav_syncquelle_setzen(item, quelle, remote_id, etag, eigen=True):
    alle = dict(item.get("syncQuellen") or {})
    alle[quelle] = {"id": remote_id, "etag": etag,
                    "geaendert": int(item.get("geaendert") or 0),
                    "eigen": bool(eigen)}
    item["syncQuellen"] = alle
    item["sync"] = True


def sync_transaktionsdatei():
    return os.path.join(daten_verzeichnis(), "sync-transaktion.aes")


def _sync_transaktionsschluessel():
    pfad = os.path.join(daten_verzeichnis(), ".sync-transaktion.key")
    try:
        fd = os.open(pfad, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        status = os.fstat(fd)
        if not stat.S_ISREG(status.st_mode) or status.st_mode & 0o077:
            os.close(fd)
            raise ValueError("insecure journal key")
        with os.fdopen(fd, "rb") as datei:
            schluessel = datei.read(33)
        if len(schluessel) != 32:
            raise ValueError("invalid journal key")
        return schluessel
    except FileNotFoundError:
        schluessel = os.urandom(32)
        os.makedirs(os.path.dirname(pfad), mode=0o700, exist_ok=True)
        fd = os.open(pfad, os.O_WRONLY | os.O_CREAT | os.O_EXCL |
                     getattr(os, "O_NOFOLLOW", 0), 0o600)
        try:
            os.write(fd, schluessel)
            os.fsync(fd)
        finally:
            os.close(fd)
        _verzeichnis_sync(os.path.dirname(pfad))
        return schluessel


def sync_transaktion_lesen():
    try:
        from cryptography.hazmat.primitives.ciphers.aead import AESGCM
        with open(sync_transaktionsdatei(), "rb") as datei:
            roh = datei.read(64 * 1024 * 1024 + 1)
        if len(roh) < 13 or len(roh) > 64 * 1024 * 1024:
            raise ValueError("invalid journal")
        klar = AESGCM(_sync_transaktionsschluessel()).decrypt(
            roh[:12], roh[12:], b"magnolie-nextcloud-sync-journal-v1")
        stand = json.loads(klar.decode("utf-8"))
        return stand if isinstance(stand, dict) else {}
    except FileNotFoundError:
        return {}
    except Exception as fehler:
        raise RuntimeError(_("The synchronization resume journal is damaged.")) from fehler


def sync_transaktion_schreiben(stand):
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    ziel = sync_transaktionsdatei()
    os.makedirs(os.path.dirname(ziel), mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".sync-transaktion-", dir=os.path.dirname(ziel))
    try:
        with os.fdopen(fd, "wb") as datei:
            klar = json.dumps(stand, ensure_ascii=False, sort_keys=True,
                              separators=(",", ":")).encode("utf-8")
            nonce = os.urandom(12)
            datei.write(nonce + AESGCM(_sync_transaktionsschluessel()).encrypt(
                nonce, klar, b"magnolie-nextcloud-sync-journal-v1"))
            datei.flush()
            os.fsync(datei.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, ziel)
        _verzeichnis_sync(os.path.dirname(ziel))
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def sync_transaktion_abschliessen():
    try:
        os.unlink(sync_transaktionsdatei())
        _verzeichnis_sync(os.path.dirname(sync_transaktionsdatei()))
    except FileNotFoundError:
        pass


def _sync_satz(was, z, fehler):
    stuecke = []
    if z["lokal_neu"]:
        stuecke.append(_("%d received") % z["lokal_neu"])
    if z["remote_neu"]:
        stuecke.append(_("%d uploaded") % z["remote_neu"])
    ab = z["lokal_geaendert"] + z["remote_geaendert"]
    if ab:
        stuecke.append(_("%d synchronized") % ab)
    ge = z["lokal_geloescht"] + z["remote_geloescht"]
    if ge:
        stuecke.append(_("%d deleted") % ge)
    if z.get("konflikte"):
        stuecke.append(_("%d synchronization conflict") % z["konflikte"])
    if fehler:
        stuecke.append(ngettext("%d error", "%d errors", fehler) % fehler)
    return _("%s: %s.") % (
        was, ", ".join(stuecke) if stuecke else _("no changes"))


# ---------------------------------------------------------------------------
# Programmstart
# ---------------------------------------------------------------------------

def einzelinstanz_anmelden(anwendungskennung, aktivieren):
    """Meldet die Anwendung am Sitzungsbus an. Ein weiterer Start sendet nur
    ein Aktivierungssignal an das bereits laufende Fenster."""
    anwendung = Gio.Application.new(anwendungskennung,
                                    Gio.ApplicationFlags.FLAGS_NONE)
    def bei_aktivierung(_anwendung):
        debug_notiz("singleton.activate")
        aktivieren()
    anwendung.connect("activate", bei_aktivierung)
    debug_notiz("singleton.register.begin")
    try:
        anwendung.register(None)
    except GLib.Error as fehler:
        debug_ausnahme("singleton.register.failed", error=fehler)
        return anwendung, False
    if anwendung.get_is_remote():
        debug_notiz("singleton.remote", activation="send")
        anwendung.activate()
        return anwendung, True
    anwendung.hold()
    debug_notiz("singleton.primary", held=True)
    return anwendung, False

def haupt():
    if _DEBUG_ANGEFORDERT or "--debug" in sys.argv[1:]:
        ziel = debug_einrichten()
        if ziel:
            sys.stderr.write("Debug log: %s\n" % ziel)
    debug_notiz("startup.arguments",
                debug="--debug" in sys.argv[1:],
                tray_start="--tray-start" in sys.argv[1:],
                reminder="--erinnerung" in sys.argv[1:],
                alarm="--wecker" in sys.argv[1:],
                probe="--probe" in sys.argv[1:])
    sprache, pot_ziel, fehler = befehlszeile_lesen(sys.argv[1:])
    if fehler:
        sys.stderr.write(fehler + "\n")
        sys.exit(2)
    sprache_anwenden(sprache)
    debug_notiz("startup.language", language=_REGIONAL.get("language") or "unknown")
    if pot_ziel is not None:
        ziel = os.path.abspath(pot_ziel or "magnolie-organizer.pot")
        try:
            pot_erzeugen(ziel)
        except (OSError, subprocess.SubprocessError) as pot_fehler:
            einzelheit = (getattr(pot_fehler, "stderr", "") or str(pot_fehler)).strip()
            sys.stderr.write(_("Could not create POT template: %s") % einzelheit + "\n")
            sys.exit(1)
        sys.stdout.write(_("POT template written to: %s") % ziel + "\n")
        sys.exit(0)

    if not any(a in sys.argv[1:] for a in
               ("--erinnerung", "--wecker", "--probe", "--hilfe", "--help")):
        systemkalender_bereinigen()

    if "--erinnerung" in sys.argv[1:]:
        debug_notiz("startup.branch", branch="reminder")
        ergebnis = erinnerungslauf()
        if ergebnis.get("fehler"):
            sys.stderr.write(ergebnis["fehler"] + "\n")
        sys.exit(0)

    if "--wecker" in sys.argv[1:]:
        debug_notiz("startup.branch", branch="alarm")
        if wecker_lebt():
            wecker_notiz(_("Alarm monitor start canceled – one is already running."))
            sys.exit(0)
        geholt = sitzungsumgebung_uebernehmen()
        wecker_anmelden()
        wecker_notiz(_("Alarm monitor started (process %(pid)d, display "
                        "%(display)s%(session)s).") % {
            "pid": os.getpid(),
            "display": os.environ.get("DISPLAY")
                       or os.environ.get("WAYLAND_DISPLAY") or _("none"),
            "session": _(", imported from the session") if geholt else "",
        })
        try:
            art = wecker_betrieb()
            art_text = {
                "ereignisschleife": _("event loop"),
                "warteschleife": _("waiting loop"),
            }.get(art, str(art))
            wecker_notiz(_("Operation ended (%s).") % art_text)
        finally:
            wecker_notiz(_("Alarm monitor stopped."))
            wecker_abmelden()
        sys.exit(0)

    if "--probe" in sys.argv[1:]:
        debug_notiz("startup.branch", branch="probe")
        ueberschrift = _("Reminder test")
        sys.stdout.write(ueberschrift + "\n")
        sys.stdout.write("-" * len(ueberschrift) + "\n")
        for zeile in erinnerungs_probe():
            sys.stdout.write(zeile + "\n")
        sys.exit(0)

    if "--hilfe" in sys.argv[1:] or "--help" in sys.argv[1:]:
        debug_notiz("startup.branch", branch="help")
        zeilen = [
            _("Magnolie Organizer – personal organizer in a paper design"), "",
            _("Usage:"),
            "  magnolie-organizer              " + _("Open the application"),
            "  magnolie-organizer --erinnerung " + _("Check for due appointments"),
            "                                  " + _("(used by the session service)"),
            "  magnolie-organizer --wecker     " + _("Remind about appointments in the background"),
            "                                  " + _("(starts when you sign in)"),
            "  magnolie-organizer --tray-start " + _("Start through the tray applet"),
            "  magnolie-organizer --probe      " + _("Test reminders and report what happens"),
            "  magnolie-organizer --debug      " + _("Write startup and tray diagnostics to the debug log"),
            "                                  " + _("Log file: ~/.local/state/magnolie-organizer/debug.log"),
            "  magnolie-organizer --sprache SPRACHE / --language LANGUAGE",
            "                                  " + _("Use a supported language code or system for this invocation"),
            "  magnolie-organizer --pot [DATEI] / --pot-template [FILE]",
            "                                  " + _("Create a gettext POT template"),
            "  magnolie-organizer --hilfe      " + _("Show this overview"),
        ]
        sys.stdout.write("\n".join(zeilen) + "\n")
        sys.exit(0)

    chromium = chromium_finden() if GTK_OK and not WEBKIT_OK else None
    transport = browser_transport_waehlen(
        GTK_OK, WEBKIT_OK, appimage_laufzeit(), chromium)
    if transport == "fehlt":
        debug_notiz("startup.gtk-unavailable", error=GTK_FEHLER or "unknown")
        einzelheit = GTK_FEHLER if not GTK_OK else (
            WEBKIT_FEHLER or "WebKit2GTK GI and Chromium are unavailable")
        sys.stderr.write(
            _("Magnolie Organizer requires GTK 3 and WebKit2GTK.") + "\n" +
            _("Install the packages, for example with:") + "\n" +
            "  sudo apt install python3-gi gir1.2-gtk-3.0 gir1.2-webkit2-4.1\n"
            + _("Error: %s") % einzelheit + "\n")
        sys.exit(1)

    GLib.set_prgname(PROGRAMM_NAME)
    GLib.set_application_name(FENSTER_TITEL)
    debug_notiz("startup.branch", branch="gui", transport=transport)

    fenster_halter = {"fenster": None}
    anwendung, schon_offen = einzelinstanz_anmelden(
        "io.gitlab.maik3531.MagnolieOrganizer",
        lambda: (fenster_halter["fenster"]._tray_zeigen()
                 if fenster_halter["fenster"] and
                 "--tray-start" not in sys.argv[1:] else None))
    if schon_offen:
        debug_notiz("startup.exit", reason="existing-instance")
        return

    web_verzeichnis = finde_web_verzeichnis()
    if not web_verzeichnis:
        debug_notiz("startup.web-missing")
        dialog = Gtk.MessageDialog(
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.CLOSE,
            text=_("Magnolie Organizer is not completely installed."))
        dialog.format_secondary_text(
            _("The directory containing the interface "
              "(/usr/share/magnolie-organizer/web) was not found."))
        dialog.run()
        dialog.destroy()
        sys.exit(1)

    debug_notiz("startup.window-create", web="found")
    fenster = Fenster(web_verzeichnis)
    fenster_halter["fenster"] = fenster
    fenster.zeige_wenn_bereit()
    try:
        debug_notiz("startup.gtk-main", state="enter")
        Gtk.main()
    finally:
        debug_notiz("startup.gtk-main", state="exit")
        anwendung.release()


if __name__ == "__main__":
    haupt()
