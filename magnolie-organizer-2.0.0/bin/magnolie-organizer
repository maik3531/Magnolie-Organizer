def tray_system_diagnose(desktop=None, aktivierte_erweiterungen=None):
    desktop = str(desktop if desktop is not None else
                  os.environ.get("XDG_CURRENT_DESKTOP") or "").upper()
    if "CINNAMON" in desktop and XApp is not None:
        return {"verfuegbar": True, "art": "xapp", "grund": "cinnamon-xapp",
                "desktop": desktop or "unknown"}
    if ("CINNAMON" in desktop and not os.environ.get("WAYLAND_DISPLAY") and
            GTK_OK and hasattr(Gtk, "StatusIcon")):
        return {"verfuegbar": True, "art": "statusicon",
                "grund": "cinnamon-x11-statusicon", "desktop": desktop or "unknown"}
    if AppIndicator is None:
        return {"verfuegbar": False, "art": "none", "grund": "no-appindicator",
                "desktop": desktop or "unknown"}
    if "GNOME" not in desktop:
        return {"verfuegbar": True, "art": "appindicator",
                "grund": "appindicator", "desktop": desktop or "unknown"}
    erweiterungs_probe = "provided"
    if aktivierte_erweiterungen is None:
        try:
            ausgabe = subprocess.check_output(
                ["gnome-extensions", "list", "--enabled"],
                stderr=subprocess.DEVNULL, timeout=2, text=True)
            aktivierte_erweiterungen = ausgabe.splitlines()
            erweiterungs_probe = "ok"
        except subprocess.TimeoutExpired:
            aktivierte_erweiterungen = []
            erweiterungs_probe = "timeout"
        except (OSError, subprocess.SubprocessError):
            aktivierte_erweiterungen = []
            erweiterungs_probe = "failed"
    kennungen = {str(x).strip().lower() for x in aktivierte_erweiterungen}
    vorhanden = bool({"appindicatorsupport@rgcjonas.gmail.com",
                      "ubuntu-appindicators@ubuntu.com"} & kennungen)
    return {"verfuegbar": vorhanden, "art": "appindicator",
            "grund": "gnome-extension" if vorhanden else "gnome-extension-missing",
            "desktop": desktop or "unknown", "erweiterungs_probe": erweiterungs_probe}


def tray_system_verfuegbar(desktop=None, aktivierte_erweiterungen=None):
    return tray_system_diagnose(desktop, aktivierte_erweiterungen)["verfuegbar"]


