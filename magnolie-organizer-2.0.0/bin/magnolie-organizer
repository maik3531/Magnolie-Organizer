REGIONAL_STANDARD = {
    "language": "de",
    "formatLocale": "de-DE",
    "hourCycle": "h23",
    "firstDayOfWeek": "monday",
    "weekRule": "iso",
    "temperatureUnit": "celsius",
    "timeZone": "system",
}

UNTERSTUETZTE_SPRACHEN = (
    "ar", "be", "cs", "da", "de", "es", "fr", "hi", "hsb", "it",
    "ja", "nb", "nl", "pl", "pt", "ru", "tr", "uk", "zh_CN",
)


def normalisiere_sprache(wert, system_erlaubt=True):
    roh = str(wert or "").strip().replace("-", "_")
    if system_erlaubt and roh == "system":
        return "system"
    klein = roh.lower()
    for sprache in UNTERSTUETZTE_SPRACHEN:
        if klein == sprache.lower() or klein.split("_", 1)[0] == sprache.lower():
            return sprache
    return "en" if klein == "en" or klein.startswith("en_") else None


def system_sprache():
    roh = os.environ.get("LANGUAGE") or locale.getlocale()[0] or "en"
    return normalisiere_sprache(str(roh).split(":", 1)[0], False) or "en"


def regional_einstellungen(roh=None):
    """Begrenzt die frühe, unverschlüsselte Regionalauswahl auf stabile Werte.

    Während der Fundamentphase entsprechen die Vorgaben bewusst vollständig
    dem bisherigen deutschen Verhalten.
    """
    roh = roh if isinstance(roh, dict) else {}
    aus = dict(REGIONAL_STANDARD)
    sprachwert = str(roh.get("language") or "").strip().replace("_", "-")
    sprache = normalisiere_sprache(sprachwert)
    if sprache:
        aus["language"] = "system" if sprache == "system" else sprachwert
    format_gebiet = str(roh.get("formatLocale") or "").strip().replace("_", "-")
    if format_gebiet == "system" or re.match(
            r"^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$", format_gebiet):
        aus["formatLocale"] = format_gebiet
    if roh.get("hourCycle") in ("system", "h12", "h23"):
        aus["hourCycle"] = roh["hourCycle"]
    if roh.get("firstDayOfWeek") in ("locale", "monday", "sunday", "saturday"):
        aus["firstDayOfWeek"] = roh["firstDayOfWeek"]
    if roh.get("weekRule") == "iso":
        aus["weekRule"] = "iso"
    if roh.get("temperatureUnit") in ("system", "celsius", "fahrenheit"):
        aus["temperatureUnit"] = roh["temperatureUnit"]
    zeitzone = str(roh.get("timeZone") or "").strip()
    if (zeitzone == "system" or
            (".." not in zeitzone and re.match(
                r"^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)+$", zeitzone))):
        aus["timeZone"] = zeitzone
    return aus


def konfigurations_verzeichnis():
    basis = (os.environ.get("XDG_CONFIG_HOME") or
             os.path.expanduser("~/.config"))
    return os.path.join(basis, PROGRAMM_NAME)


def regional_datei():
    return os.path.join(konfigurations_verzeichnis(), "locale.json")


def regional_einstellungen_lesen(pfad=None):
    try:
        with open(pfad or regional_datei(), "r", encoding="utf-8") as datei:
            return regional_einstellungen(json.load(datei))
    except (OSError, ValueError, TypeError):
        return regional_einstellungen()


def regional_einstellungen_schreiben(werte, pfad=None):
    ziel = pfad or regional_datei()
    sauber = regional_einstellungen(werte)
    try:
        os.makedirs(os.path.dirname(ziel), mode=0o700, exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix=".locale-", dir=os.path.dirname(ziel))
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as datei:
                json.dump(sauber, datei, ensure_ascii=False, indent=2)
                datei.write("\n")
            os.chmod(tmp, 0o600)
            os.replace(tmp, ziel)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
        return True
    except OSError:
        return False


def finde_locale_verzeichnis():
    skript = os.path.dirname(os.path.realpath(__file__))
    kandidaten = [os.environ.get("MAGNOLIE_LOCALE_DIR"),
                  os.path.join(skript, "..", "locale"),
                  os.path.join(skript, "locale"),
                  "/usr/share/locale"]
    for pfad in kandidaten:
        if pfad and os.path.isdir(os.path.abspath(pfad)):
            return os.path.abspath(pfad)
    return "/usr/share/locale"


def gettext_uebersetzung(sprache=None, locale_verzeichnis=None):
    sprachen = None
    if sprache and sprache != "system":
        sprachen = [str(sprache).replace("-", "_")]
    return gettext.translation(I18N_DOMAIN,
                               localedir=locale_verzeichnis or finde_locale_verzeichnis(),
                               languages=sprachen, fallback=True)


_REGIONAL = regional_einstellungen_lesen()
_UEBERSETZUNG = gettext_uebersetzung(_REGIONAL["language"])
_ = _UEBERSETZUNG.gettext
ngettext = _UEBERSETZUNG.ngettext


def befehlszeile_lesen(argumente):
    """Liest nur die frühen, GTK-unabhängigen Kommandozeilenoptionen."""
    sprache = None
    pot = None
    index = 0
    while index < len(argumente):
        argument = argumente[index]
        if argument in ("--sprache", "--language"):
            if index + 1 >= len(argumente) or argumente[index + 1].startswith("--"):
                return None, None, _("Option %s requires a language.") % argument
            roh_sprache = argumente[index + 1]
            sprache = normalisiere_sprache(roh_sprache)
            if not sprache:
                return None, None, _("Invalid language: %s. Use a supported language code or system.") % roh_sprache
            index += 2
            continue
        if argument in ("--pot", "--pot-template"):
            pot = ""
            if index + 1 < len(argumente) and not argumente[index + 1].startswith("--"):
                pot = argumente[index + 1]
                index += 1
        index += 1
    return sprache, pot, None


def sprache_anwenden(sprache):
    global _UEBERSETZUNG, _, ngettext
    if sprache is None:
        return
    _UEBERSETZUNG = gettext_uebersetzung(sprache)
    _ = _UEBERSETZUNG.gettext
    ngettext = _UEBERSETZUNG.ngettext
    if sprache == "system":
        _REGIONAL["language"] = system_sprache()
    else:
        _REGIONAL["language"] = sprache


def pot_erzeugen(ziel):
    skript = os.path.dirname(os.path.realpath(__file__))
    kandidaten = [
        os.path.join(skript, "..", "werkzeuge", "pot_erzeugen.py"),
        "/usr/share/magnolie-organizer/werkzeuge/pot_erzeugen.py",
    ]
    werkzeug = next((os.path.abspath(pfad) for pfad in kandidaten
                     if os.path.isfile(os.path.abspath(pfad))), None)
    if not werkzeug:
        raise FileNotFoundError("pot_erzeugen.py")
    subprocess.run([sys.executable, werkzeug, "--output", ziel], check=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)

def finde_web_verzeichnis():
    """Sucht das Verzeichnis mit index.html (Installation oder Quellbaum)."""
    kandidaten = []
    aus_umgebung = os.environ.get("MAGNOLIE_ORGANIZER_WEB")
    if aus_umgebung:
        kandidaten.append(aus_umgebung)
    skript = os.path.dirname(os.path.realpath(__file__))
    kandidaten += [
        "/usr/share/magnolie-organizer/web",
        os.path.join(skript, "..", "share", "magnolie-organizer", "web"),
        os.path.join(skript, "web"),
    ]
    for pfad in kandidaten:
        pfad = os.path.abspath(pfad)
        if os.path.isfile(os.path.join(pfad, "index.html")):
            return pfad
    return None


def contributor_hash_lesen(web_verzeichnis):
    """Liest die optionale Konfiguration eines offiziellen Binärpakets."""
    pfad = os.path.join(os.path.dirname(os.path.realpath(web_verzeichnis)),
                        "build-config.json")
    try:
        if os.path.getsize(pfad) > 4096:
            return ""
        with open(pfad, "r", encoding="ascii") as datei:
            wert = json.load(datei).get("contributorHash", "")
    except (OSError, ValueError, AttributeError):
        return ""
    return wert.lower() if isinstance(wert, str) and re.fullmatch(
        r"[0-9a-fA-F]{64}", wert) else ""


def daten_verzeichnis():
    if GTK_OK and GLib:
        basis = GLib.get_user_data_dir() or os.path.expanduser("~/.local/share")
    else:
        basis = (os.environ.get("XDG_DATA_HOME")
                 or os.path.expanduser("~/.local/share"))
    pfad = os.path.join(basis, PROGRAMM_NAME)
    os.makedirs(pfad, mode=0o700, exist_ok=True)
    try:
        os.chmod(pfad, 0o700)
        daten = os.path.join(pfad, "daten.json")
        if os.path.isfile(daten):
            os.chmod(daten, 0o600)
    except OSError:
        pass
    return pfad


def daten_datei():
    return os.path.join(daten_verzeichnis(), "daten.json")


def eigener_pfad():
    """Pfad genau dieser Installation, auch unter /usr/local oder im Quellbaum."""
    return os.path.realpath(__file__)


def atomar_text_schreiben(pfad, inhalt, modus=0o600):
    """Ersetzt eine private Textdatei atomar im selben Verzeichnis."""
    ordner = os.path.dirname(os.path.abspath(pfad))
    os.makedirs(ordner, mode=0o700, exist_ok=True)
    fd, temporaer = tempfile.mkstemp(prefix=".magnolie-", dir=ordner)
    try:
        os.fchmod(fd, modus)
        with os.fdopen(fd, "w", encoding="utf-8") as datei:
            fd = -1
            datei.write(inhalt)
            datei.flush()
            os.fsync(datei.fileno())
        os.replace(temporaer, pfad)
        os.chmod(pfad, modus)
        ordner_fd = os.open(ordner, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(ordner_fd)
        finally:
            os.close(ordner_fd)
    finally:
        if fd >= 0:
            os.close(fd)
        if os.path.exists(temporaer):
            os.unlink(temporaer)


def atomar_binaer_schreiben(pfad, inhalt, modus=0o600):
    """Ersetzt eine private Binärdatei atomar im selben Verzeichnis."""
    ordner = os.path.dirname(os.path.abspath(pfad))
    os.makedirs(ordner, mode=0o700, exist_ok=True)
    fd, temporaer = tempfile.mkstemp(prefix=".magnolie-", dir=ordner)
    try:
        os.fchmod(fd, modus)
        with os.fdopen(fd, "wb") as datei:
            fd = -1
            datei.write(inhalt)
            datei.flush()
            os.fsync(datei.fileno())
        os.replace(temporaer, pfad)
        os.chmod(pfad, modus)
        ordner_fd = os.open(ordner, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(ordner_fd)
        finally:
            os.close(ordner_fd)
    finally:
        if fd >= 0:
            os.close(fd)
        if os.path.exists(temporaer):
            os.unlink(temporaer)


IMPORT_DATEI_MAX = 32 * 1024 * 1024
IMPORT_ARCHIV_EINTRAEGE_MAX = 128
IMPORT_ARCHIV_EINTRAG_MAX = 16 * 1024 * 1024
IMPORT_ARCHIV_VERHAELTNIS_MAX = 200
SICHERUNG_DATEI_MAX = 256 * 1024 * 1024
GESAMTARCHIV_DATEI_MAX = 384 * 1024 * 1024
GESAMTARCHIV_KENNUNG = "magnolie-gesamtarchiv"
GESAMTARCHIV_FASSUNG = 1
GESAMTARCHIV_DATENSCHEMA = 1
JOURNAL_KENNUNG = "magnolie-snapshot"
JOURNAL_FASSUNG = 1
JOURNAL_INTERVALLE = {"off": 0, "6h": 6 * 3600, "12h": 12 * 3600,
                      "daily": 86400, "weekly": 7 * 86400}
JOURNAL_GRUENDE = {"weekly", "manual", "pre-sync", "pre-restore",
                   "pre-contact",
                   "pre-contact-import", "pre-contact-merge",
                   "pre-contact-delete"}
JOURNAL_BUDGET_MAX = 1024 * 1024 * 1024
JOURNAL_RESERVE = 1024 * 1024 * 1024
FEIERTAG_ANTWORT_MAX = 1024 * 1024
FEIERTAG_ABRUF_MAX = 8 * 1024 * 1024


class GroessenFehler(RuntimeError):
    """Eine externe Nutzlast überschreitet ihre verbindliche Obergrenze."""


def _gesamtarchiv_kanonisch(wert):
    return json.dumps(wert, ensure_ascii=True, sort_keys=True,
                      separators=(",", ":"), allow_nan=False).encode("utf-8")


def _gesamtarchiv_tokens_pruefen(wert):
    if isinstance(wert, dict):
        for name, inhalt in wert.items():
            schluessel = str(name).replace("_", "").replace("-", "").lower()
            if schluessel in ("graphtoken", "accesstoken", "refreshtoken",
                              "clientsecret"):
                raise RuntimeError(
                    "Externe Integrationstokens dürfen nicht im Gesamtarchiv enthalten sein.")
            _gesamtarchiv_tokens_pruefen(inhalt)
    elif isinstance(wert, list):
        for inhalt in wert:
            _gesamtarchiv_tokens_pruefen(inhalt)


def gesamtarchiv_erzeugen(daten, plattform="linux", appversion=None,
                           kennwort="", erstellt=None):
    """Erzeugt den plattformneutralen, vollständigen Datencontainer."""
    if not isinstance(daten, dict):
        raise RuntimeError("Der Datenbestand muss ein JSON-Objekt sein.")
    daten = _gesamtarchiv_wiederholungen_normalisieren(daten)
    _gesamtarchiv_tokens_pruefen(daten)
    kanonisch = _gesamtarchiv_kanonisch(daten)
    wurzel = {
        "magnolie": GESAMTARCHIV_KENNUNG,
        "fassung": GESAMTARCHIV_FASSUNG,
        "datenschema": GESAMTARCHIV_DATENSCHEMA,
        "erstellt": erstellt or datetime.now(timezone.utc).isoformat(),
        "plattform": plattform,
        "appversion": appversion or PROGRAMM_FASSUNG,
        "sha256": hashlib.sha256(kanonisch).hexdigest(),
        "daten": daten,
    }
    text = _gesamtarchiv_kanonisch(wurzel).decode("utf-8")
    if kennwort:
        text = verschluesseln(text, kennwort)
    if len(text.encode("utf-8")) > GESAMTARCHIV_DATEI_MAX:
        raise GroessenFehler("Das Gesamtarchiv ist größer als 384 MiB.")
    return text


def _gesamtarchiv_data_urls(wert, feld):
    anzahl = 0
    if isinstance(wert, dict):
        for name, inhalt in wert.items():
            if (name == feld and isinstance(inhalt, str)
                    and inhalt.lower().startswith("data:")):
                anzahl += 1
            anzahl += _gesamtarchiv_data_urls(inhalt, feld)
    elif isinstance(wert, list):
        anzahl += sum(_gesamtarchiv_data_urls(x, feld) for x in wert)
    return anzahl


def _gesamtarchiv_wiederholungen_normalisieren(daten):
    ergebnis = json.loads(json.dumps(daten, ensure_ascii=False))
    for termin in ergebnis.get("termine") or []:
        if not isinstance(termin, dict) or not isinstance(termin.get("wiederholung"), dict):
            continue
        wiederholung = termin["wiederholung"]
        if str(wiederholung.get("art") or "").lower() == "monthly_weekday":
            wiederholung["art"] = "monthly"
    return ergebnis


def gesamtarchiv_lesen_text(text, kennwort=""):
    """Validiert und öffnet ein Archiv vollständig vor jeder Mutation."""
    verschluesselt = ist_verschluesselt(text)
    if verschluesselt and not kennwort:
        raise RuntimeError("Für dieses Gesamtarchiv ist das Kennwort erforderlich.")
    klar = entschluesseln(text, kennwort) if verschluesselt else text
    try:
        wurzel = json.loads(klar)
    except (TypeError, ValueError):
        raise RuntimeError("Das Gesamtarchiv enthält kein gültiges JSON-Objekt.")
    if (not isinstance(wurzel, dict)
            or wurzel.get("magnolie") != GESAMTARCHIV_KENNUNG
            or wurzel.get("fassung") != GESAMTARCHIV_FASSUNG
            or wurzel.get("datenschema") != GESAMTARCHIV_DATENSCHEMA):
        raise RuntimeError(
            "Format oder Datenschema des Gesamtarchivs wird nicht unterstützt.")
    daten = wurzel.get("daten")
    if not isinstance(daten, dict):
        raise RuntimeError("Der Datenbestand des Gesamtarchivs muss ein Objekt sein.")
    if wurzel.get("plattform") not in ("linux", "windows"):
        raise RuntimeError("Die Quellplattform des Gesamtarchivs ist ungültig.")
    try:
        erstellt = str(wurzel.get("erstellt") or "").replace("Z", "+00:00")
        erstellt = re.sub(r"(\.\d{6})\d+(?=[+-]\d{2}:\d{2}$)", r"\1", erstellt)
        datetime.fromisoformat(erstellt)
    except ValueError:
        raise RuntimeError("Das Erstellungsdatum des Gesamtarchivs ist ungültig.")
    ist_hash = hashlib.sha256(_gesamtarchiv_kanonisch(daten)).hexdigest()
    soll_hash = str(wurzel.get("sha256") or "").lower()
    if len(soll_hash) != 64 or not hmac.compare_digest(ist_hash, soll_hash):
        raise RuntimeError("Die SHA-256-Prüfsumme des Gesamtarchivs stimmt nicht.")
    _gesamtarchiv_tokens_pruefen(daten)
    daten = _gesamtarchiv_wiederholungen_normalisieren(daten)
    namen = ("termine", "aufgaben", "kontakte", "notizen", "notizgruppen",
             "notizbuecher", "jahrestage", "feiertage", "urlaube",
             "muelltermine", "personen", "schichten", "zyklusmarker",
             "tagmarken", "papierkorb", "tombstones")
    fotos = _gesamtarchiv_data_urls(daten, "foto")
    anhaenge = _gesamtarchiv_data_urls(daten, "daten")
    return {"daten": daten, "erstellt": wurzel["erstellt"],
            "plattform": wurzel["plattform"],
            "appversion": str(wurzel.get("appversion") or ""),
            "verschluesselt": verschluesselt,
            "anzahlen": {name: len(daten.get(name) or [])
                          if isinstance(daten.get(name), list) else 0
                          for name in namen},
            "fotos": fotos, "anhaenge": anhaenge}


def gesamtarchiv_lesen(pfad, kennwort=""):
    roh = datei_begrenzt_lesen(
        pfad, GESAMTARCHIV_DATEI_MAX,
        "Das Gesamtarchiv ist größer als 384 MiB.")
    return gesamtarchiv_lesen_text(_text_dekodieren(roh), kennwort)


def gesamtarchiv_lokales_bewahren(importiert, lokal, plattformwechsel):
    ergebnis = json.loads(json.dumps(importiert, ensure_ascii=False))
    if not plattformwechsel:
        return ergebnis
    for pfad in (("einstellungen", "allgemein", "tray"),
                 ("einstellungen", "allgemein", "sicherungsordner"),
                 ("einstellungen", "sync")):
        quelle = lokal
        for name in pfad:
            quelle = quelle.get(name) if isinstance(quelle, dict) else None
        if quelle is None:
            continue
        ziel = ergebnis
        for name in pfad[:-1]:
            if not isinstance(ziel.get(name), dict):
                ziel[name] = {}
            ziel = ziel[name]
        ziel[pfad[-1]] = json.loads(json.dumps(quelle, ensure_ascii=False))
    return ergebnis


def journal_verzeichnis(basis=None):
    return os.path.join(os.path.abspath(basis or daten_verzeichnis()),
                        "wiederherstellungsstaende")


def _journal_zeit(wert=None):
    if wert is None:
        return datetime.now(timezone.utc)
    if isinstance(wert, datetime):
        return wert.astimezone(timezone.utc)
    return datetime.fromisoformat(str(wert).replace("Z", "+00:00")).astimezone(
        timezone.utc)


def _journal_uuid(wert):
    try:
        return str(uuid.UUID(str(wert)))
    except (ValueError, TypeError, AttributeError):
        raise RuntimeError(_("The recovery snapshot manifest is invalid."))


def _journal_manifest_pruefen(manifest):
    if (not isinstance(manifest, dict)
            or manifest.get("format") != JOURNAL_KENNUNG
            or manifest.get("formatVersion") != JOURNAL_FASSUNG
            or manifest.get("platform") != "linux"
            or not isinstance(manifest.get("appVersion"), str)
            or not manifest.get("appVersion")
            or manifest.get("reason") not in JOURNAL_GRUENDE
            or not isinstance(manifest.get("summary"), dict)
            or not isinstance(manifest.get("payload"), dict)):
        raise RuntimeError(_("The recovery snapshot manifest is invalid."))
    manifest["snapshotId"] = _journal_uuid(manifest.get("snapshotId"))
    manifest["syncEpoch"] = _journal_uuid(manifest.get("syncEpoch"))
    zeit = _journal_zeit(manifest.get("createdAt"))
    if not str(manifest.get("createdAt", "")).endswith("Z"):
        raise RuntimeError(_("The recovery snapshot manifest is invalid."))
    payload = manifest["payload"]
    if (payload.get("schema") != GESAMTARCHIV_DATENSCHEMA
            or not re.fullmatch(r"[0-9a-f]{64}", str(payload.get("sha256", "")))
            or not re.fullmatch(r"[0-9a-f]{64}", str(payload.get("sourceSha256", "")))
            or isinstance(payload.get("size"), bool)
            or not isinstance(payload.get("size"), int) or payload["size"] < 1):
        raise RuntimeError(_("The recovery snapshot manifest is invalid."))
    manifest["_created"] = zeit
    return manifest


def journal_bereinigen(basis=None):
    wurzel = journal_verzeichnis(basis)
    if os.path.lexists(wurzel) and os.path.islink(wurzel):
        raise OSError(_("The recovery snapshot folder must not be a symbolic link."))
    os.makedirs(wurzel, mode=0o700, exist_ok=True)
    os.chmod(wurzel, 0o700)
    for name in list(os.listdir(wurzel)):
        if not (name.startswith(".") and name.endswith(".rewrite-new")):
            continue
        snapshot_id = name[1:-len(".rewrite-new")]
        neu = os.path.join(wurzel, name)
        alt = os.path.join(wurzel, ".%s.rewrite-old" % snapshot_id)
        if os.path.lexists(alt):
            continue
        if os.path.islink(neu):
            os.unlink(neu)
        elif os.path.isdir(neu):
            shutil.rmtree(neu)
        elif os.path.lexists(neu):
            os.unlink(neu)
    for name in list(os.listdir(wurzel)):
        if not (name.startswith(".") and name.endswith(".rewrite-old")):
            continue
        snapshot_id = name[1:-len(".rewrite-old")]
        alt = os.path.join(wurzel, name)
        neu = os.path.join(wurzel, ".%s.rewrite-new" % snapshot_id)
        ziel = os.path.join(wurzel, snapshot_id)
        if not os.path.exists(ziel):
            os.replace(neu if os.path.isdir(neu) else alt, ziel)
        if os.path.isdir(alt):
            shutil.rmtree(alt)
        if os.path.isdir(neu):
            shutil.rmtree(neu)
    for name in os.listdir(wurzel):
        pfad = os.path.join(wurzel, name)
        if name.startswith(".") and name.endswith(".partial"):
            if os.path.islink(pfad):
                os.unlink(pfad)
            elif os.path.isdir(pfad):
                shutil.rmtree(pfad)
    return wurzel


def journal_liste(basis=None, kennwort="", integritaet=True):
    wurzel = journal_bereinigen(basis)
    ergebnis = []
    for name in os.listdir(wurzel):
        pfad = os.path.join(wurzel, name)
        if name.startswith(".") or os.path.islink(pfad) or not os.path.isdir(pfad):
            continue
        try:
            manifest_pfad = os.path.join(pfad, "manifest.json")
            payload_pfad = os.path.join(pfad, "payload.magnolie")
            if os.path.islink(manifest_pfad) or os.path.islink(payload_pfad):
                raise OSError("symlink")
            manifest = _journal_manifest_pruefen(json.loads(_text_dekodieren(
                datei_begrenzt_lesen(manifest_pfad, 1024 * 1024,
                                     _("The recovery snapshot manifest is too large.")))))
            if manifest["snapshotId"] != name:
                raise RuntimeError(_("The recovery snapshot manifest is invalid."))
            stand = dict(manifest)
            stand.pop("_created", None)
            stand["path"] = pfad
            stand["integrity"] = "unchecked"
            if integritaet:
                groesse = os.path.getsize(payload_pfad)
                korrekt = (groesse == manifest["payload"]["size"] and
                           hmac.compare_digest(_datei_sha256(payload_pfad),
                                               manifest["payload"]["sha256"]))
                stand["integrity"] = "ok" if korrekt else "damaged"
            ergebnis.append(stand)
        except Exception:
            ergebnis.append({"snapshotId": name, "path": pfad,
                              "integrity": "damaged", "reason": "",
                              "createdAt": "", "summary": {},
                              "payload": {"size": 0}})
    return sorted(ergebnis, key=lambda x: x.get("createdAt", ""), reverse=True)


def journal_faellig(intervall, letzter_stand=None, jetzt=None):
    sekunden = JOURNAL_INTERVALLE.get(str(intervall or "weekly"))
    if sekunden is None:
        sekunden = JOURNAL_INTERVALLE["weekly"]
    if not sekunden:
        return False
    if not letzter_stand:
        return True
    try:
        return (_journal_zeit(jetzt) - _journal_zeit(letzter_stand)).total_seconds() >= sekunden
    except (ValueError, TypeError):
        return True


def _journal_behalten(staende, jetzt):
    behalten = set()
    wochen, monate, kurz, restore = [], [], [], []
    for stand in staende:
        try:
            zeit = _journal_zeit(stand["createdAt"])
        except (KeyError, ValueError, TypeError):
            continue
        grund = stand.get("reason")
        if grund == "manual" and stand.get("pinned", True):
            behalten.add(stand["snapshotId"])
        elif grund == "weekly":
            wochen.append((zeit, stand))
            monate.append((zeit, stand))
        elif grund == "pre-restore":
            restore.append((zeit, stand))
        else:
            kurz.append((zeit, stand))
    for _zeit, stand in sorted(wochen, reverse=True)[:8]:
        behalten.add(stand["snapshotId"])
    monatssieger = {}
    for zeit, stand in sorted(monate, reverse=True):
        monatssieger.setdefault((zeit.year, zeit.month), stand)
    for stand in list(monatssieger.values())[:6]:
        behalten.add(stand["snapshotId"])
    junge = [x for x in sorted(kurz, reverse=True)
             if (jetzt - x[0]).total_seconds() <= 14 * 86400]
    for _zeit, stand in junge[:20]:
        behalten.add(stand["snapshotId"])
    for zeit, stand in sorted(restore, reverse=True)[:5]:
        if (jetzt - zeit).total_seconds() <= 30 * 86400:
            behalten.add(stand["snapshotId"])
    return behalten


def _journal_retention_plan(basis=None, jetzt=None, budget=None, disk_usage=None):
    wurzel = journal_bereinigen(basis)
    staende = journal_liste(basis, integritaet=False)
    behalten = _journal_behalten(staende, _journal_zeit(jetzt))
    loeschen = [stand for stand in staende
                if stand.get("snapshotId") not in behalten]
    staende = [stand for stand in staende
               if stand.get("snapshotId") in behalten]
    volumen = (disk_usage or shutil.disk_usage)(wurzel)
    limit = min(JOURNAL_BUDGET_MAX, int(volumen.total * 0.05)) if budget is None else budget
    gesamt = sum(int(s.get("payload", {}).get("size", 0)) for s in staende)
    jetzt_utc = _journal_zeit(jetzt)
    loeschbar = [s for s in reversed(staende)
                 if not (s.get("reason") == "manual" and s.get("pinned", True))
                 and not (s.get("reason") == "pre-restore" and s.get("createdAt")
                          and (jetzt_utc - _journal_zeit(s["createdAt"])).total_seconds()
                          <= 30 * 86400)]
    while gesamt > limit and loeschbar:
        stand = loeschbar.pop(0)
        gesamt -= int(stand.get("payload", {}).get("size", 0))
        loeschen.append(stand)
    return {"size": gesamt, "budget": limit, "free": volumen.free,
            "reserve": JOURNAL_RESERVE, "delete": loeschen}


def journal_retention(basis=None, jetzt=None, budget=None, disk_usage=None):
    plan = _journal_retention_plan(basis, jetzt, budget, disk_usage)
    for stand in plan.pop("delete"):
        shutil.rmtree(stand["path"])
    return plan


def journal_snapshot_erzeugen(daten, grund, kennwort="", basis=None, jetzt=None,
                               pinned=None, disk_usage=None, haken=None):
    if grund not in JOURNAL_GRUENDE or not isinstance(daten, dict):
        raise ValueError("snapshot")
    zeit = _journal_zeit(jetzt)
    erstellt = zeit.isoformat(timespec="microseconds").replace("+00:00", "Z")
    quellhash = hashlib.sha256(_gesamtarchiv_kanonisch(daten)).hexdigest()
    for alt in journal_liste(basis, integritaet=False):
        if (alt.get("reason") == grund and
                alt.get("payload", {}).get("sourceSha256") == quellhash):
            try:
                if abs((zeit - _journal_zeit(alt["createdAt"])).total_seconds()) <= 900:
                    alt["deduplicated"] = True
                    return alt
            except (ValueError, TypeError):
                pass
    text = gesamtarchiv_erzeugen(daten, "linux", PROGRAMM_FASSUNG,
                                 kennwort=kennwort, erstellt=erstellt)
    payload = text.encode("utf-8")
    stand = _journal_retention_plan(basis, zeit, disk_usage=disk_usage)
    if stand["size"] + len(payload) > stand["budget"]:
        raise OSError(_("Not enough protected disk space for a recovery snapshot."))
    wurzel = journal_bereinigen(basis)
    volumen = (disk_usage or shutil.disk_usage)(wurzel)
    freigebbar = sum(int(alt.get("payload", {}).get("size", 0))
                     for alt in stand["delete"])
    if volumen.free + freigebbar - len(payload) < JOURNAL_RESERVE:
        raise OSError(_("Not enough protected disk space for a recovery snapshot."))
    snapshot_id = str(uuid.uuid4())
    sync_meta = daten.get("syncMetadaten") if isinstance(
        daten.get("syncMetadaten"), dict) else {}
    epoch = sync_meta.get("syncEpoch") or daten.get("syncEpoch")
    try:
        epoch = _journal_uuid(epoch)
    except RuntimeError:
        epoch = str(uuid.uuid4())
    namen = ("termine", "aufgaben", "kontakte", "notizen", "notizgruppen",
             "notizbuecher", "jahrestage", "feiertage", "urlaube",
             "muelltermine", "personen", "schichten", "zyklusmarker",
             "tagmarken", "papierkorb", "tombstones")
    manifest = {"format": JOURNAL_KENNUNG, "formatVersion": JOURNAL_FASSUNG,
                "snapshotId": snapshot_id, "createdAt": erstellt,
                "platform": "linux", "appVersion": PROGRAMM_FASSUNG,
                "reason": grund, "pinned": bool(grund == "manual" if pinned is None else pinned),
                "payload": {"sha256": hashlib.sha256(payload).hexdigest(),
                            "sourceSha256": quellhash, "size": len(payload),
                            "schema": GESAMTARCHIV_DATENSCHEMA},
                "summary": {name: len(daten.get(name) or [])
                            if isinstance(daten.get(name), list) else 0 for name in namen},
                "syncEpoch": epoch}
    stufe = os.path.join(wurzel, ".%s.partial" % snapshot_id)
    ziel = os.path.join(wurzel, snapshot_id)
    os.mkdir(stufe, 0o700)
    os.chmod(stufe, 0o700)
    try:
        atomar_binaer_schreiben(os.path.join(stufe, "payload.magnolie"), payload)
        if haken:
            haken("payload")
        atomar_text_schreiben(os.path.join(stufe, "manifest.json"), json.dumps(
            manifest, ensure_ascii=False, sort_keys=True, indent=2) + "\n")
        _verzeichnis_sync(stufe)
        if haken:
            haken("manifest")
        os.replace(stufe, ziel)
        _verzeichnis_sync(wurzel)
    finally:
        if os.path.isdir(stufe):
            shutil.rmtree(stufe)
    for alt in stand["delete"]:
        shutil.rmtree(alt["path"])
    journal_retention(basis, zeit, disk_usage=disk_usage)
    aus = dict(manifest)
    aus.update(path=ziel, integrity="ok", deduplicated=False)
    return aus


def journal_snapshot_lesen(snapshot_id, kennwort="", basis=None):
    snapshot_id = _journal_uuid(snapshot_id)
    stand = next((s for s in journal_liste(basis) if s.get("snapshotId") == snapshot_id), None)
    if not stand or stand.get("integrity") != "ok":
        raise RuntimeError(_("The recovery snapshot is missing or damaged."))
    gelesen = gesamtarchiv_lesen(os.path.join(stand["path"], "payload.magnolie"), kennwort)
    quellhash = hashlib.sha256(_gesamtarchiv_kanonisch(gelesen["daten"])).hexdigest()
    if not hmac.compare_digest(quellhash, stand["payload"]["sourceSha256"]):
        raise RuntimeError(_("The recovery snapshot payload does not match its manifest."))
    return stand, gelesen


def journal_umschluesseln(kennwort_neu, kennwort_alt="", basis=None):
    """Passt vorhandene Wiederherstellungspunkte atomar an den Kennwortschutz an."""
    wurzel = journal_bereinigen(basis)
    geschafft, misslungen = 0, 0
    for stand in journal_liste(basis):
        if stand.get("integrity") != "ok":
            misslungen += 1
            continue
        snapshot_id = stand["snapshotId"]
        ziel = os.path.join(wurzel, snapshot_id)
        neu = os.path.join(wurzel, ".%s.rewrite-new" % snapshot_id)
        alt = os.path.join(wurzel, ".%s.rewrite-old" % snapshot_id)
        try:
            _geprueft, gelesen = journal_snapshot_lesen(
                snapshot_id, kennwort_alt, basis)
            text = gesamtarchiv_erzeugen(
                gelesen["daten"], "linux", stand["appVersion"],
                kennwort=kennwort_neu, erstellt=stand["createdAt"])
            payload = text.encode("utf-8")
            manifest = json.loads(_text_dekodieren(datei_begrenzt_lesen(
                os.path.join(ziel, "manifest.json"), 1024 * 1024,
                _("The recovery snapshot manifest is too large."))))
            manifest["payload"]["sha256"] = hashlib.sha256(payload).hexdigest()
            manifest["payload"]["size"] = len(payload)
            os.mkdir(neu, 0o700)
            atomar_binaer_schreiben(os.path.join(neu, "payload.magnolie"), payload)
            atomar_text_schreiben(os.path.join(neu, "manifest.json"), json.dumps(
                manifest, ensure_ascii=False, sort_keys=True, indent=2) + "\n")
            _verzeichnis_sync(neu)
            os.replace(ziel, alt)
            os.replace(neu, ziel)
            _verzeichnis_sync(wurzel)
            shutil.rmtree(alt)
            geschafft += 1
        except Exception:
            misslungen += 1
            if not os.path.exists(ziel) and os.path.isdir(alt):
                os.replace(alt, ziel)
            if os.path.isdir(neu):
                shutil.rmtree(neu)
    return {"geschafft": geschafft, "misslungen": misslungen}


def journal_restore_daten(daten):
    neu = json.loads(json.dumps(daten, ensure_ascii=False))
    epoch = str(uuid.uuid4())
    meta = neu.get("syncMetadaten") if isinstance(neu.get("syncMetadaten"), dict) else {}
    quarantined = {"geloescht": neu.get("geloescht") or {},
                   "tombstones": neu.get("tombstones") or [],
                   "baumKontaktGeloescht": neu.get("baumKontaktGeloescht") or []}
    meta.update({"syncEpoch": epoch, "ersteSyncLoeschungsfrei": True,
                 "quarantinedDeletes": quarantined})
    neu["syncMetadaten"] = meta
    neu["syncEpoch"] = epoch
    neu["geloescht"] = {"termine": [], "kontakte": []}
    neu["tombstones"] = []
    neu["baumKontaktGeloescht"] = []
    einstellungen = neu.setdefault("einstellungen", {})
    sync = einstellungen.setdefault("sync", {})
    sync["syncEpoch"] = epoch
    sync["ersteSyncLoeschungsfrei"] = True
    return neu


def datei_begrenzt_lesen(pfad, grenze, meldung):
    """Liest genau eine reguläre Datei symlinkfrei und größenbegrenzt."""
    if not stat.S_ISREG(os.lstat(pfad).st_mode):
        raise OSError(_("The selected path is not a regular file."))
    if not hasattr(os, "O_NOFOLLOW"):
        raise OSError(_("The selected path is not a regular file."))
    flags = (os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
             | getattr(os, "O_NONBLOCK", 0) | os.O_NOFOLLOW)
    fd = os.open(pfad, flags)
    try:
        stand = os.fstat(fd)
        if not stat.S_ISREG(stand.st_mode):
            raise OSError(_("The selected path is not a regular file."))
        if stand.st_size > grenze:
            raise GroessenFehler(meldung)
        with os.fdopen(fd, "rb", closefd=False) as datei:
            roh = datei.read(grenze + 1)
        if len(roh) > grenze:
            raise GroessenFehler(meldung)
        return roh
    finally:
        os.close(fd)


def antwort_begrenzt_lesen(antwort, grenze, meldung):
    """Begrenzt HTTP-Antworten mit und ohne verlässliche Längenangabe."""
    try:
        angabe = antwort.headers.get("Content-Length")
        if angabe is not None and int(str(angabe).strip()) > grenze:
            raise GroessenFehler(meldung)
    except (AttributeError, TypeError, ValueError):
        pass
    teile = []
    uebrig = grenze + 1
    while uebrig:
        teil = antwort.read(min(64 * 1024, uebrig))
        if not teil:
            break
        teile.append(teil)
        uebrig -= len(teil)
    roh = b"".join(teile)
    if len(roh) > grenze:
        raise GroessenFehler(meldung)
    return roh


KENNWORT_TRANSAKTION_KENNUNG = "magnolie-kennwort-transaktion"
KENNWORT_TRANSAKTION_DATEIEN = (
    "baum-post.json", "baum-eingang.json", "baum.json", "daten.json")
_KENNWORT_TRANSAKTION_HAKEN = {"funktion": None}


def _transaktion_haken(stelle):
    funktion = _KENNWORT_TRANSAKTION_HAKEN.get("funktion")
    if funktion:
        funktion(stelle)


def _verzeichnis_sync(pfad):
    fd = os.open(pfad, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _text_sha256(text):
    import hashlib
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def _datei_sha256(pfad):
    import hashlib
    wert = hashlib.sha256()
    with open(pfad, "rb") as datei:
        for block in iter(lambda: datei.read(1024 * 1024), b""):
            wert.update(block)
    return wert.hexdigest()


def kennwort_transaktion_ordner(ordner=None):
    return os.path.join(ordner or daten_verzeichnis(), ".kennwort-transaktion")


def _kennwort_journal_pruefen(roh):
    if (not isinstance(roh, dict)
            or roh.get("magnolie") != KENNWORT_TRANSAKTION_KENNUNG
            or roh.get("fassung") != 1
            or roh.get("art") not in ("setzen", "aendern", "entfernen",
                                       "entsperrmigration", "wiederherstellen")
            or not isinstance(roh.get("dateien"), list)
            or not roh["dateien"]):
        raise RuntimeError(_("The password transaction journal is damaged."))
    gesehen = set()
    for eintrag in roh["dateien"]:
        if (not isinstance(eintrag, dict)
                or eintrag.get("ziel") not in KENNWORT_TRANSAKTION_DATEIEN
                or eintrag["ziel"] in gesehen
                or eintrag.get("stufe") != "%02d.neu" %
                   KENNWORT_TRANSAKTION_DATEIEN.index(eintrag["ziel"])
                or not isinstance(eintrag.get("altVorhanden"), bool)
                or not re.fullmatch(r"[0-9a-f]{64}", eintrag.get("neuSha256", ""))
                or (eintrag["altVorhanden"] and not re.fullmatch(
                    r"[0-9a-f]{64}", eintrag.get("altSha256", "")))):
            raise RuntimeError(_("The password transaction journal is damaged."))
        gesehen.add(eintrag["ziel"])
    return roh


def kennwort_transaktion_reparieren(ordner=None):
    """Schließt eine festgeschriebene Mehrdatei-Transaktion idempotent ab."""
    basis = os.path.abspath(ordner or daten_verzeichnis())
    transaktion = kennwort_transaktion_ordner(basis)
    if not os.path.isdir(transaktion):
        return False
    journal_pfad = os.path.join(transaktion, "journal.json")
    if not os.path.isfile(journal_pfad):
        shutil.rmtree(transaktion)
        _verzeichnis_sync(basis)
        return False
    try:
        with open(journal_pfad, "r", encoding="utf-8") as datei:
            journal = _kennwort_journal_pruefen(json.load(datei))
    except (OSError, ValueError) as fehler:
        raise RuntimeError(_("The password transaction journal is damaged.")) from fehler
    for eintrag in journal["dateien"]:
        ziel = os.path.join(basis, eintrag["ziel"])
        stufe = os.path.join(transaktion, eintrag["stufe"])
        if os.path.isfile(ziel) and _datei_sha256(ziel) == eintrag["neuSha256"]:
            continue
        if not os.path.isfile(stufe) or _datei_sha256(stufe) != eintrag["neuSha256"]:
            raise RuntimeError(_("A prepared password transaction file is missing or damaged."))
        if os.path.exists(ziel):
            if (not eintrag["altVorhanden"]
                    or _datei_sha256(ziel) != eintrag.get("altSha256")):
                raise RuntimeError(_("The data changed during password transaction recovery."))
        elif eintrag["altVorhanden"]:
            raise RuntimeError(_("The data changed during password transaction recovery."))
        _transaktion_haken("vor-" + eintrag["ziel"])
        os.replace(stufe, ziel)
        os.chmod(ziel, 0o600)
        _transaktion_haken("nach-" + eintrag["ziel"])
        _verzeichnis_sync(basis)
    for eintrag in journal["dateien"]:
        ziel = os.path.join(basis, eintrag["ziel"])
        if not os.path.isfile(ziel) or _datei_sha256(ziel) != eintrag["neuSha256"]:
            raise RuntimeError(_("The password transaction could not be completed."))
    _transaktion_haken("vor-bereinigung")
    shutil.rmtree(transaktion)
    _verzeichnis_sync(basis)
    return True


def kennwort_transaktion_ausfuehren(dateien, art, ordner=None):
    """Bereitet alle Enddateien vor und trifft danach einen dauerhaften Commit."""
    basis = os.path.abspath(ordner or daten_verzeichnis())
    kennwort_transaktion_reparieren(basis)
    if (art not in ("setzen", "aendern", "entfernen", "entsperrmigration",
                    "wiederherstellen") or not isinstance(dateien, dict)
            or not dateien
            or any(name not in KENNWORT_TRANSAKTION_DATEIEN for name in dateien)
            or any(not isinstance(text, str) for text in dateien.values())):
        raise ValueError("Ungültige Kennworttransaktion")
    transaktion = kennwort_transaktion_ordner(basis)
    os.makedirs(transaktion, mode=0o700, exist_ok=False)
    os.chmod(transaktion, 0o700)
    _verzeichnis_sync(basis)
    journal = {"magnolie": KENNWORT_TRANSAKTION_KENNUNG, "fassung": 1,
               "art": art, "dateien": []}
    for name in KENNWORT_TRANSAKTION_DATEIEN:
        if name not in dateien:
            continue
        ziel = os.path.join(basis, name)
        stufenname = "%02d.neu" % KENNWORT_TRANSAKTION_DATEIEN.index(name)
        stufe = os.path.join(transaktion, stufenname)
        vorhanden = os.path.isfile(ziel)
        alt_hash = _datei_sha256(ziel) if vorhanden else ""
        atomar_text_schreiben(stufe, dateien[name])
        _transaktion_haken("vorbereitet-" + name)
        journal["dateien"].append({
            "ziel": name, "stufe": stufenname, "altVorhanden": vorhanden,
            "altSha256": alt_hash, "neuSha256": _text_sha256(dateien[name])})
    _verzeichnis_sync(transaktion)
    _transaktion_haken("vor-journal")
    atomar_text_schreiben(
        os.path.join(transaktion, "journal.json"),
        json.dumps(journal, ensure_ascii=False, indent=1))
    _verzeichnis_sync(transaktion)
    _verzeichnis_sync(basis)
    _transaktion_haken("nach-journal")
    kennwort_transaktion_reparieren(basis)
    return True


def uebernehme_alte_daten():
    """Holt die Daten von „Organizer Klassik" herüber, falls vorhanden.

    Die alte Datei bleibt unangetastet; kopiert wird nur, wenn der
    Magnolie Organizer selbst noch keine Daten hat.
    """
    neu = daten_datei()
    if os.path.isfile(neu):
        return False
    alt = os.path.join(os.path.dirname(daten_verzeichnis()), ALTER_NAME, "daten.json")
    if not os.path.isfile(alt):
        return False
    try:
        shutil.copy2(alt, neu)
        os.chmod(neu, 0o600)
        return True
    except OSError as fehler:
        sys.stderr.write(_("Importing the old data failed: %s") % fehler + "\n")
        return False


def lade_daten():
    """Liest die Daten. Liefert (daten_oder_None, ist_neu, migriert)."""
    migriert = uebernehme_alte_daten()
    pfad = daten_datei()
    if not os.path.isfile(pfad):
        return None, True, False
    try:
        with open(pfad, "r", encoding="utf-8") as datei:
            return json.load(datei), False, migriert
    except (OSError, ValueError) as fehler:
        # Beschädigte Datei beiseitelegen statt überschreiben.
        sys.stderr.write(_("Warning: The data file could not be read (%s).") % fehler + "\n")
        try:
            beiseite = pfad + ".defekt-" + datetime.now().strftime("%Y%m%d-%H%M%S")
            shutil.copy2(pfad, beiseite)
            sys.stderr.write(_("Copy stored at: %s") % beiseite + "\n")
        except OSError:
            pass
        return None, True, False


def speichere_text(text):
    """Schreibt bereits fertigen JSON-Text atomar.

    Die Oberfläche hat den Text ohnehin schon erzeugt; ihn hier noch
    einmal umzuwandeln kostete bei großen Beständen unnötig Zeit."""
    atomar_text_schreiben(daten_datei(), text)


def daten_text_erzeugen(daten, kennwort=None):
    """Erzeugt den endgültigen offenen oder kennwortgeschützten Datentext."""
    gross = len((daten or {}).get("termine") or []) > 2000
    if gross:
        text = json.dumps(daten, ensure_ascii=False, separators=(",", ":"))
    else:
        text = json.dumps(daten, ensure_ascii=False, indent=1)
    if kennwort:
        text = daten_huelle_anlegen(text, kennwort)[0]
    return text


def speichere_daten(daten, kennwort=None):
    """Schreibt die Daten atomar (erst Temporärdatei, dann umbenennen)."""
    text = daten_text_erzeugen(daten, kennwort)
    atomar_text_schreiben(daten_datei(), text)


def sicherungs_verzeichnis(pfad=""):
    """Löst den optional gewählten Sicherungsordner eindeutig auf."""
    if not (pfad or "").strip():
        return daten_verzeichnis()
    return os.path.abspath(os.path.expandvars(os.path.expanduser(pfad.strip())))


def sicherung_ist_extern(ordner=""):
    """Liegt der Sicherungsordner außerhalb des lokalen Datenstandorts?"""
    basis = os.path.realpath(daten_verzeichnis())
    ziel = os.path.realpath(sicherungs_verzeichnis(ordner))
    try:
        return os.path.commonpath((basis, ziel)) != basis
    except ValueError:
        return True


def lege_sicherung_an(ordner="", vorsilbe="sicherung", kennwort="",
                      quellkennwort=None):
    """Legt eine geprüfte Sicherung mit Zeitstempel an.

    Außerhalb des lokalen Datenstandorts wird niemals nur die Datendatei
    kopiert: Dort ist ein eigenes Kennwort Pflicht und der Klarbestand wird
    frisch verschlüsselt. ``quellkennwort`` öffnet bei Bedarf die aktuelle
    Datendatei; fehlt es, wird das Sicherungskennwort dafür versucht.
    """
    quelle = daten_datei()
    if not os.path.isfile(quelle):
        return None
    ordner = sicherungs_verzeichnis(ordner)
    extern = sicherung_ist_extern(ordner)
    if extern and len(str(kennwort or "")) < 4:
        raise RuntimeError(
            _("Backups outside the data location require a password with at "
              "least four characters."))
    os.makedirs(ordner, exist_ok=True)
    quelltext = _text_dekodieren(datei_begrenzt_lesen(
        quelle, SICHERUNG_DATEI_MAX,
        _("The backup file is larger than 256 megabytes.")))
    stempel = datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    vorsilbe = ("sicherung-vor-wiederherstellung"
                 if vorsilbe == "sicherung-vor-wiederherstellung"
                 else "sicherung")
    ziel = os.path.join(ordner, "%s-%s.json" % (vorsilbe, stempel))
    if not extern:
        atomar_text_schreiben(ziel, quelltext)
        return ziel

    if not kennwort_moeglich():
        raise RuntimeError(
            _("The encrypted backup requires python3-cryptography."))
    roh = quelltext
    if ist_verschluesselt(roh):
        quelle_passwort = (kennwort if quellkennwort is None else quellkennwort)
        roh = entschluesseln(roh, quelle_passwort or "")
    daten = json.loads(roh)
    if not isinstance(daten, dict):
        raise RuntimeError(_("The current organizer data is incomplete."))
    sicherungstext = verschluesseln(roh, kennwort)
    if len(sicherungstext.encode("utf-8")) > SICHERUNG_DATEI_MAX:
        raise GroessenFehler(
            _("The backup file is larger than 256 megabytes."))
    atomar_text_schreiben(ziel, sicherungstext)
    return ziel


def sicherung_lesen(pfad, kennwort=""):
    """Liest und prüft eine Sicherungsdatei, ohne den Bestand zu verändern."""
    pfad = os.path.abspath(os.path.expanduser(str(pfad or "").strip()))
    if not pfad or not os.path.exists(pfad):
        return {"ok": False, "fehler": _("The backup file was not found."),
                "brauchtKennwort": False, "verschluesselt": False}
    try:
        roh = _text_dekodieren(datei_begrenzt_lesen(
            pfad, SICHERUNG_DATEI_MAX,
            _("The backup file is larger than 256 megabytes.")))
    except GroessenFehler as fehler:
        return {"ok": False, "fehler": str(fehler),
                "brauchtKennwort": False, "verschluesselt": False}
    except OSError as fehler:
        return {"ok": False, "fehler": fehler_deutsch(
            fehler, _("Reading the backup")),
                "brauchtKennwort": False, "verschluesselt": False}
    verschluesselt = ist_verschluesselt(roh)
    if verschluesselt and not kennwort:
        return {"ok": False, "fehler": "", "brauchtKennwort": True,
                "verschluesselt": True}
    try:
        klar = entschluesseln(roh, kennwort) if verschluesselt else roh
        daten = json.loads(klar)
    except RuntimeError as fehler:
        return {"ok": False, "fehler": str(fehler),
                "brauchtKennwort": verschluesselt,
                "verschluesselt": verschluesselt}
    except ValueError:
        return {"ok": False,
                "fehler": _("The backup does not contain readable organizer data."),
                "brauchtKennwort": False,
                "verschluesselt": verschluesselt}
    if not isinstance(daten, dict):
        return {"ok": False,
                "fehler": _("The backup does not contain a complete data set."),
                "brauchtKennwort": False,
                "verschluesselt": verschluesselt}
    return {"ok": True, "daten": daten, "fehler": "",
            "brauchtKennwort": False, "verschluesselt": verschluesselt}


def js_zeichenkette(wert):
    """Verpackt einen Python-Wert als sicheres JS-Literal (JSON in JSON)."""
    return json.dumps(json.dumps(wert, ensure_ascii=False))


# ---------------------------------------------------------------------------
# Zeit-Helfer
# ---------------------------------------------------------------------------

def jetzt_ms():
    return int(datetime.now(timezone.utc).timestamp() * 1000)


def _utc_stempel(ms=None):
    """iCalendar-Zeitstempel in UTC, z. B. 20260724T101500Z."""
    if not ms:
        ms = jetzt_ms()
    dt = datetime.fromtimestamp(ms / 1000.0, timezone.utc)
    return dt.strftime("%Y%m%dT%H%M%SZ")


def _stempel_zu_ms(wert):
    """Liest 20260101T101010Z (oder ohne Z / ohne Sekunden) als Millisekunden."""
    w = (wert or "").strip()
    utc = w.endswith("Z")
    w = w.rstrip("Z")
    for form in ("%Y%m%dT%H%M%S", "%Y%m%dT%H%M", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M"):
        try:
            dt = datetime.strptime(w, form)
            break
        except ValueError:
            continue
    else:
        return 0
    dt = dt.replace(tzinfo=timezone.utc) if utc else dt.astimezone()
    return int(dt.timestamp() * 1000)


_uid_zaehler = [0]


def _neue_uid():
    _uid_zaehler[0] += 1
    return "mag-%s-%d@magnolie-organizer" % (
        datetime.now().strftime("%Y%m%d%H%M%S%f"), _uid_zaehler[0])


def _text_dekodieren(rohbytes):
    """Bytes einer Austauschdatei möglichst verlustfrei zu Text machen."""
    if rohbytes.startswith((b"\xff\xfe", b"\xfe\xff")):
        return rohbytes.decode("utf-16")
    for zeichensatz in ("utf-8-sig", "utf-8", "cp1252"):
        try:
            return rohbytes.decode(zeichensatz)
        except UnicodeDecodeError:
            continue
    return rohbytes.decode("latin-1", "replace")


# ---------------------------------------------------------------------------
# iCalendar (.ics) – lesen und schreiben
# ---------------------------------------------------------------------------

def _entfalte_zeilen(text):
    """Hebt die iCalendar-Zeilenfaltung auf (Folgezeilen mit Leerraum)."""
    zeilen = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    aus = []
    for z in zeilen:
        if z[:1] in (" ", "\t") and aus:
            aus[-1] += z[1:]
        else:
            aus.append(z)
    return [z for z in aus if z.strip()]


def _prop_zerlegen(zeile):
    """NAME;PARAM=wert;PARAM2="a:b":inhalt  ->  (NAME, {PARAM: wert}, inhalt)"""
    in_anf = False
    doppelpunkt = -1
    for i, c in enumerate(zeile):
        if c == '"':
            in_anf = not in_anf
        elif c == ":" and not in_anf:
            doppelpunkt = i
            break
    if doppelpunkt < 0:
        return None
    kopf, wert = zeile[:doppelpunkt], zeile[doppelpunkt + 1:]
    teile, puffer, in_anf = [], "", False
    for c in kopf:
        if c == '"':
            in_anf = not in_anf
            puffer += c
        elif c == ";" and not in_anf:
            teile.append(puffer)
            puffer = ""
        else:
            puffer += c
    teile.append(puffer)
    name = teile[0].strip().upper()
    # Gruppen-Vorsilben wie item1.EMAIL abstreifen (vCard-Eigenheit)
    if "." in name:
        name = name.split(".")[-1]
    params = {}
    for p in teile[1:]:
        if "=" in p:
            schluessel, pw = p.split("=", 1)
            schluessel = schluessel.strip().upper()
            pw = pw.strip().strip('"')
            if schluessel == "TYPE" and params.get(schluessel):
                params[schluessel] += "," + pw
            else:
                params[schluessel] = pw
        elif p.strip():
            params[p.strip().upper()] = ""
    return name, params, wert


def _prop_gruppe(zeile):
    """Liefert bei item1.TEL die Gruppe item1, sonst einen leeren Text."""
    kopf = str(zeile or "").split(":", 1)[0].split(";", 1)[0].strip()
    return kopf.rsplit(".", 1)[0] if "." in kopf else ""


def _ical_unescape(wert):
    aus, i = "", 0
    while i < len(wert):
        c = wert[i]
        if c == "\\" and i + 1 < len(wert):
            folge = wert[i + 1]
            aus += "\n" if folge in "nN" else folge
            i += 2
        else:
            aus += c
            i += 1
    return aus


def _ical_escape(wert):
    return (str(wert or "")
            .replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,")
            .replace("\r\n", "\n").replace("\n", "\\n"))


def _falte(zeile):
    """Faltet iCalendar-/vCard-Zeilen nach höchstens 75 UTF-8-Oktetten."""
    stuecke, teil = [], []
    breite = 0
    grenze = 75
    for zeichen in zeile:
        laenge = len(zeichen.encode("utf-8"))
        if teil and breite + laenge > grenze:
            stuecke.append("".join(teil))
            teil = []
            breite = 0
            grenze = 74  # Ein Oktett der Folgezeile ist das Faltungsleerzeichen.
        teil.append(zeichen)
        breite += laenge
    stuecke.append("".join(teil))
    return "\r\n ".join(stuecke)


def _zeitzonenname():
    """Liefert die gewählte oder zuverlässig erkennbare IANA-Zeitzone."""
    gewaehlt = str((_REGIONAL or {}).get("timeZone") or "system").strip()
    kandidaten = [] if gewaehlt == "system" else [gewaehlt]
    if gewaehlt == "system":
        kandidaten.append(str(os.environ.get("TZ") or "").lstrip(":"))
        try:
            with open("/etc/timezone", "r", encoding="utf-8") as datei:
                kandidaten.append(datei.read().strip())
        except OSError:
            pass
        lokal = os.path.realpath("/etc/localtime")
        if "/zoneinfo/" in lokal:
            kandidaten.append(lokal.split("/zoneinfo/", 1)[1])
    for name in kandidaten:
        if (not name or len(name) > 100 or ".." in name or not
                re.fullmatch(r"[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)+", name)):
            continue
        try:
            from zoneinfo import ZoneInfo
            ZoneInfo(name)
            return name
        except (ImportError, KeyError, ValueError):
            continue
    return ""


def _organizer_zeitzone():
    name = _zeitzonenname()
    if name:
        try:
            from zoneinfo import ZoneInfo
            return ZoneInfo(name)
        except (ImportError, KeyError, ValueError):
            pass
    return datetime.now().astimezone().tzinfo


def _organizer_jetzt():
    """Aktuelle naive Wandzeit in der für den Organizer gewählten Zone."""
    return datetime.now(timezone.utc).astimezone(
        _organizer_zeitzone()).replace(tzinfo=None)


def _ics_datumzeit(wert, params):
    """DTSTART-artige Werte -> ("JJJJ-MM-TT", "HH:MM" oder "")."""
    w = (wert or "").strip()
    if params.get("VALUE", "").upper() == "DATE" or (len(w) == 8 and w.isdigit()):
        if len(w) == 8 and w.isdigit():
            try:
                tag = datetime.strptime(w, "%Y%m%d")
            except ValueError:
                return None, ""
            return tag.strftime("%Y-%m-%d"), ""
        return None, ""
    utc = w.endswith("Z")
    w = w.rstrip("Z")
    for form in ("%Y%m%dT%H%M%S", "%Y%m%dT%H%M"):
        try:
            dt = datetime.strptime(w, form)
            break
        except ValueError:
            continue
    else:
        return None, ""
    tzid = str(params.get("TZID") or "").strip()
    if utc:
        dt = dt.replace(tzinfo=timezone.utc).astimezone(_organizer_zeitzone())
    elif tzid:
        try:
            from zoneinfo import ZoneInfo
            dt = dt.replace(tzinfo=ZoneInfo(tzid)).astimezone(
                _organizer_zeitzone())
        except (ImportError, KeyError, ValueError):
            pass
    return dt.strftime("%Y-%m-%d"), dt.strftime("%H:%M")


def _ics_wiederholung(rrule, datum, zeit=""):
    """Bildet nur RRULEs ab, die das interne einfache Modell exakt versteht."""
    teile = str(rrule or "").upper().split(";")
    paare = [teil.split("=", 1) for teil in teile if "=" in teil]
    if len(paare) != len(teile) or len({p[0] for p in paare}) != len(paare):
        return None
    werte = dict(paare)
    if set(werte) - {"FREQ", "INTERVAL", "UNTIL", "BYDAY", "BYMONTHDAY",
                        "BYMONTH", "BYSETPOS", "WKST"}:
        return None
    art = {"DAILY": "daily", "WEEKLY": "weekly", "MONTHLY": "monthly",
           "YEARLY": "yearly"}.get(werte.get("FREQ"))
    try:
        intervall = int(werte.get("INTERVAL", "1"))
    except ValueError:
        return None
    if not art or not 1 <= intervall <= 3660 or (art not in ("daily", "weekly") and intervall != 1):
        return None
    try:
        start = datetime.strptime(datum, "%Y-%m-%d")
    except (TypeError, ValueError):
        return None
    if art == "daily":
        if any(name in werte for name in (
                "BYDAY", "BYMONTHDAY", "BYMONTH", "BYSETPOS")):
            return None
    elif art == "weekly":
        tag = ("MO", "TU", "WE", "TH", "FR", "SA", "SU")[start.weekday()]
        if werte.get("BYDAY") not in (None, tag):
            return None
        if "BYMONTHDAY" in werte or "BYMONTH" in werte or "BYSETPOS" in werte:
            return None
    elif art == "monthly":
        ordinal = None
        wochentag = ""
        if "BYDAY" in werte:
            if "BYMONTHDAY" in werte or "BYMONTH" in werte:
                return None
            treffer = re.fullmatch(r"(-1|[1-4])?(MO|TU|WE|TH|FR|SA|SU)",
                                   werte["BYDAY"])
            if not treffer:
                return None
            if treffer.group(1):
                if "BYSETPOS" in werte:
                    return None
                ordinal = int(treffer.group(1))
            else:
                if not re.fullmatch(r"-1|[1-4]", werte.get("BYSETPOS", "")):
                    return None
                ordinal = int(werte["BYSETPOS"])
            wochentag = treffer.group(2)
        else:
            if "BYSETPOS" in werte or "BYMONTH" in werte:
                return None
            if werte.get("BYMONTHDAY") not in (None, str(start.day)):
                return None
            if start.day > 28:
                return None
    else:
        if "BYDAY" in werte or "BYSETPOS" in werte:
            return None
        if werte.get("BYMONTH") not in (None, str(start.month)):
            return None
        if werte.get("BYMONTHDAY") not in (None, str(start.day)):
            return None
        if start.month == 2 and start.day == 29:
            return None
    bis = ""
    if werte.get("UNTIL"):
        try:
            roh = werte["UNTIL"]
            if re.fullmatch(r"\d{8}", roh):
                ende = datetime.strptime(roh, "%Y%m%d")
            elif re.fullmatch(r"\d{8}T\d{6}Z", roh):
                if roh[-3:-1] != "00":
                    return None
                ende = datetime.strptime(roh, "%Y%m%dT%H%M%SZ").replace(
                    tzinfo=timezone.utc).astimezone(_organizer_zeitzone())
            elif re.fullmatch(r"\d{8}T\d{6}", roh):
                if roh[-2:] != "00":
                    return None
                ende = datetime.strptime(roh, "%Y%m%dT%H%M%S")
            else:
                return None
            if "T" in roh and zeit and ende.strftime("%H:%M") < zeit:
                ende -= timedelta(days=1)
            bis = ende.strftime("%Y-%m-%d")
        except ValueError:
            return None
    ergebnis = {"art": art, "bis": bis}
    if intervall > 1:
        ergebnis["intervall"] = intervall
    if art == "monthly" and ordinal is not None:
        ergebnis.update({"ordinal": ordinal, "wochentag": wochentag})
        if "BYSETPOS" in werte:
            ergebnis["rruleForm"] = "bysetpos"
    return ergebnis


def _typ_aus_kategorien(kategorien):
    k = (kategorien or "").lower()
    if "geburtstag" in k or "birthday" in k:
        return "birthday"
    if "hochzeit" in k or "wedding" in k:
        return "wedding-anniversary"
    if "namenstag" in k:
        return "name-day"
    if any(wort in k for wort in ("todestag", "gestorben", "verstorben", "death")):
        return "death-anniversary"
    if "gedenk" in k or "memorial" in k:
        return "memorial-day"
    return "other"


def _jahrestag_aus_ereignis(titel, kategorien, typ_feld=""):
    """Erkennt ausdrücklich als Jahrestag bezeichnete Kalenderereignisse."""
    text = "%s %s" % (kategorien or "", titel or "")
    markiert = bool(typ_feld or re.search(
        r"(?:geburtstag|birthday|hochzeit|wedding|todestag|gestorben|verstorben|"
        r"death|anniversary|jahrestag|namenstag|memorial|gedenk)", text, re.I))
    return markiert, typ_feld or _typ_aus_kategorien(text)


def _hole(props, name):
    for n, p, w in props:
        if n == name:
            return p, w
    return None, None


def _ics_prop_roh(name, params, wert):
    parameter = "".join(";%s%s" % (schluessel, ("=" + str(inhalt)) if inhalt else "")
                        for schluessel, inhalt in (params or {}).items())
    return "%s%s:%s" % (name, parameter, wert)


def _ics_roundtrip(props, komplex=False):
    namen = {"RRULE", "RDATE", "EXDATE", "EXRULE", "RECURRENCE-ID", "DURATION",
             "LOCATION", "URL", "ORGANIZER", "ATTENDEE", "ATTACH", "X-ALT-DESC",
             "TRANSP", "BEGIN", "END", "ACTION", "TRIGGER", "REPEAT"}
    erzeugt = {"UID", "DTSTAMP", "LAST-MODIFIED", "SEQUENCE", "DTSTART", "DTEND", "DUE", "SUMMARY",
               "DESCRIPTION", "CATEGORIES", "CLASS", "STATUS", "PRIORITY",
               "PERCENT-COMPLETE", "X-MAGNOLIE-ERINNERUNG-AM-TAG",
               "X-MAGNOLIE-KOSTENSTELLE", "X-MAGNOLIE-KUNDE",
               "X-MAGNOLIE-ERINNERUNG-TAGE", "X-MAGNOLIE-STANDARDERINNERUNG"}
    if komplex:
        namen.update(("DTSTART", "DTEND"))
    ergebnis, tiefe = [], 0
    for name, params, wert in props:
        if name == "BEGIN":
            tiefe += 1
        if tiefe or name in namen or name not in erzeugt:
            ergebnis.append(_ics_prop_roh(name, params, wert))
        if name == "END" and tiefe:
            tiefe -= 1
    return ergebnis


def _erinnerung_tage(wert):
    try:
        tage = int(wert or 0)
    except (TypeError, ValueError):
        return 0
    return tage if 1 <= tage <= 7 else 0


def _ics_komponente(art, props, ergebnis, komplexe_serie=False,
                    jahrestage_als_termine=False):
    roundtrip_props = props
    haupt_props, tiefe = [], 0
    for prop in props:
        if prop[0] == "BEGIN":
            tiefe += 1
        elif prop[0] == "END" and tiefe:
            tiefe -= 1
        elif not tiefe:
            haupt_props.append(prop)
    props = haupt_props

    def wert(name, standard=""):
        _, w = _hole(props, name)
        return _ical_unescape(w) if w is not None else standard

    def ganzzahl(name):
        try:
            zahl = int(wert(name) or 0)
        except (TypeError, ValueError):
            return 0
        return zahl if 1 <= zahl <= 7 else 0

    uid_wert = wert("UID")
    serien_uid = uid_wert
    recurrence_params, recurrence_id = _hole(props, "RECURRENCE-ID")
    wiederholungsnamen = {"RRULE", "RDATE", "EXDATE", "RECURRENCE-ID",
                          "EXRULE"}
    wiederholungsteile = [n for n, _p, _w in props
                          if n in wiederholungsnamen]
    nicht_abbildbar = (komplexe_serie or
                       any(n in ("EXDATE", "RECURRENCE-ID", "EXRULE")
                           for n in wiederholungsteile) or
                       wiederholungsteile.count("RRULE") > 1 or
                       ("RDATE" in wiederholungsteile and "RRULE" in wiederholungsteile))
    if recurrence_id:
        instanz_hash = _text_sha256(json.dumps(
            [recurrence_params or {}, recurrence_id], ensure_ascii=False,
            sort_keys=True, separators=(",", ":")))
        uid_wert = "%smagnolie-instanz-%s" % (
            (uid_wert + "-") if uid_wert else "", instanz_hash[:16])
    geaendert = 0
    _last_modified_params, last_modified = _hole(props, "LAST-MODIFIED")
    for n in ("LAST-MODIFIED", "DTSTAMP"):
        _params_stempel, w = _hole(props, n)
        if w:
            geaendert = _stempel_zu_ms(w)
            if geaendert:
                break
    try:
        ics_sequence = max(0, int(wert("SEQUENCE") or 0))
    except (TypeError, ValueError):
        ics_sequence = 0

    if art == "VTODO":
        titel = wert("SUMMARY")
        if not titel:
            ergebnis["uebersprungen"] += 1
            return
        p_due, w_due = _hole(props, "DUE")
        faellig, faellig_zeit = "", ""
        if w_due:
            d, faellig_zeit = _ics_datumzeit(w_due, p_due or {})
            faellig = d or ""
        p_start, w_start = _hole(props, "DTSTART")
        _start_datum, start_zeit = _ics_datumzeit(w_start, p_start or {}) if w_start else ("", "")
        try:
            prio_roh = int(wert("PRIORITY") or "0")
        except ValueError:
            prio_roh = 0
        prio = 1 if 1 <= prio_roh <= 3 else (3 if prio_roh >= 7 else 2)
        ergebnis["aufgaben"].append({
            "titel": titel, "faellig": faellig,
            "startZeit": start_zeit, "faelligZeit": faellig_zeit, "prio": prio,
            "erledigt": (wert("STATUS").strip().upper() == "COMPLETED" or
                          wert("PERCENT-COMPLETE").strip() == "100"),
            "notiz": wert("DESCRIPTION"),
            "erinnern": wert("X-MAGNOLIE-ERINNERUNG-AM-TAG") == "1",
            "individuelleErinnerungTage": ganzzahl("X-MAGNOLIE-ERINNERUNG-TAGE"),
            "uid": uid_wert, "geaendert": geaendert,
            "icsRoundtrip": _ics_roundtrip(roundtrip_props, nicht_abbildbar)})
        return

    p_start, w_start = _hole(props, "DTSTART")
    if not w_start:
        ergebnis["uebersprungen"] += 1
        return
    datum, zeit = _ics_datumzeit(w_start, p_start or {})
    if not datum:
        ergebnis["uebersprungen"] += 1
        return
    titel = wert("SUMMARY") or _("Untitled appointment")
    rrule = wert("RRULE").upper()
    kategorien = wert("CATEGORIES")
    quellzone = ("UTC" if str(w_start).strip().upper().endswith("Z")
                 else str((p_start or {}).get("TZID") or "").strip())
    zielzone = _zeitzonenname()
    if rrule and zeit and quellzone and quellzone != zielzone:
        nicht_abbildbar = True

    end_datum, end_zeit = "", ""
    p_ende, w_ende = _hole(props, "DTEND")
    if w_ende:
        e_datum, e_zeit = _ics_datumzeit(w_ende, p_ende or {})
        if not zeit and e_datum and e_datum > datum:
            # Bei ganztägigen Ereignissen ist DTEND nach RFC 5545 exklusiv.
            letzter = (datetime.strptime(e_datum, "%Y-%m-%d") -
                       timedelta(days=1)).strftime("%Y-%m-%d")
            end_datum = letzter if letzter > datum else ""
        elif zeit and e_datum and e_datum >= datum:
            end_datum = e_datum if e_datum > datum else ""
            if e_zeit and (e_datum > datum or e_zeit != zeit):
                end_zeit = e_zeit
    if rrule and _hole(props, "DURATION")[1]:
        nicht_abbildbar = True
    start_roh = str(w_start).strip().upper().rstrip("Z")
    ende_roh = str(w_ende or "").strip().upper().rstrip("Z")
    if rrule and zeit and (not end_zeit or
                           (re.fullmatch(r"\d{8}T\d{6}", start_roh) and
                            start_roh[-2:] != "00") or
                           (re.fullmatch(r"\d{8}T\d{6}", ende_roh) and
                            ende_roh[-2:] != "00")):
        nicht_abbildbar = True

    typ_id = jahrestag_typ_id(wert("X-MAGNOLIE-TYPE-ID"))
    typ_feld = (wert("X-MAGNOLIE-TYP") or
                wert("X-MAGNOLIE-JAHRESTAG-TYP")).strip()[:80]
    typ_feld = typ_id or jahrestag_typ_id(typ_feld) or typ_feld
    jahrestag_markiert, typ_kategorie = _jahrestag_aus_ereignis(
        titel, kategorien, typ_feld)
    rdate_daten = []
    if "RDATE" in wiederholungsteile and not rrule and not nicht_abbildbar:
        for name, params, rohwerte in props:
            if name != "RDATE":
                continue
            for rohwrt in str(rohwerte).split(","):
                rdatum, rzeit = _ics_datumzeit(rohwrt.strip(), params or {})
                if not rdatum or rzeit != zeit or rdatum <= datum:
                    nicht_abbildbar = True
                    rdate_daten = []
                    break
                rdate_daten.append(rdatum)
            if nicht_abbildbar:
                break
    wiederholung = ({"art": "custom", "bis": "", "daten": sorted(set(rdate_daten))}
                    if rdate_daten and not nicht_abbildbar else
                    (_ics_wiederholung(rrule, datum, zeit)
                     if rrule and not nicht_abbildbar else None))
    # Der einfache interne Serienparser lehnt den 29. Februar fuer normale
    # Termine bewusst ab. Jahrestage koennen dieses Datum jedoch darstellen.
    einfache_jahresregel = (rrule in ("FREQ=YEARLY", "FREQ=YEARLY;INTERVAL=1") and
                            not komplexe_serie and
                            wiederholungsteile == ["RRULE"])
    jahrestag_regel = (not rrule or einfache_jahresregel or
                       (wiederholung and wiederholung["art"] == "yearly" and
                        not wiederholung["bis"]))
    ganztag_jahrestag = (not zeit or (zeit == "00:00" and end_zeit == "23:59"))
    if (not jahrestage_als_termine and jahrestag_markiert and jahrestag_regel and
            ganztag_jahrestag and not end_datum):
        ergebnis["jahrestage"].append({
            "name": titel, "datum": datum, "typ": typ_kategorie,
            "uid": uid_wert, "icsSerienUid": serien_uid,
            "geaendert": geaendert})
        return
    if nicht_abbildbar or (rrule and not wiederholung):
        ergebnis["wiederholend"] += 1
    ics_komplex = bool(nicht_abbildbar or (rrule and not wiederholung))

    ergebnis["termine"].append({
        "datum": datum, "endDatum": end_datum,
        "zeit": zeit, "endZeit": end_zeit,
        "titel": titel, "notiz": wert("DESCRIPTION"),
        "kategorien": kategorien,
        "vertraulich": wert("CLASS").strip().upper() in ("CONFIDENTIAL", "PRIVATE"),
        "vorlaeufig": wert("STATUS").strip().upper() == "TENTATIVE",
        "kostenstelle": wert("X-MAGNOLIE-KOSTENSTELLE"),
        "kunde": wert("X-MAGNOLIE-KUNDE"),
        "individuelleErinnerungTage": ganzzahl("X-MAGNOLIE-ERINNERUNG-TAGE"),
        "standardErinnerung": wert("X-MAGNOLIE-STANDARDERINNERUNG", "1") != "0",
        "wiederholung": wiederholung or {"art": "none", "bis": ""},
        "icsKomplex": ics_komplex,
        "icsSerienUid": serien_uid if ics_komplex else "",
        "icsRoundtrip": _ics_roundtrip(roundtrip_props, ics_komplex),
        "icsSequence": ics_sequence,
        "icsAenderungszeitFehlt": not bool(last_modified),
        "uid": uid_wert, "geaendert": geaendert})


def _sicherer_ics_quellenpfad(name):
    """Macht einen Dateinamen/ZIP-Pfad anzeigbar, ohne Traversal zu bewahren."""
    teile = []
    for teil in str(name or "").replace("\\", "/").split("/"):
        teil = "".join(zeichen for zeichen in teil
                       if ord(zeichen) >= 32 and zeichen != "\x7f").strip()
        if not teil or teil in (".", ".."):
            continue
        teil = teil.replace(":", "_")
        if teil:
            teile.append(teil)
    return "/".join(teile) or _("Calendar")


def _ics_quelle_setzen(ergebnis, text, quellenname="", quellen_id=""):
    kalendername = ""
    for zeile in _entfalte_zeilen(text):
        prop = _prop_zerlegen(zeile)
        if prop and prop[0] == "X-WR-CALNAME":
            kalendername = _ical_unescape(prop[2]).strip()
            break
    fallback = _sicherer_ics_quellenpfad(quellenname)
    name = kalendername or fallback
    stabile_quelle = quellen_id or (fallback if quellenname else "calendar")
    stabile_basis = "%s\n%s" % (stabile_quelle, kalendername)
    kennung = "ics:" + _text_sha256(stabile_basis)
    for art in ("termine", "jahrestage", "aufgaben"):
        for item in ergebnis.get(art) or []:
            item["icsQuelleName"] = name
            item["icsQuelleId"] = kennung


def _termin_externe_kennungen(termin):
    return {str(wert).strip() for wert in (
        termin.get("uid"), termin.get("icsSerienUid")) if str(wert or "").strip()}


def _termin_recurrence_id(termin):
    for zeile in termin.get("icsRoundtrip") or []:
        prop = _prop_zerlegen(str(zeile))
        if prop and prop[0] == "RECURRENCE-ID":
            return json.dumps([prop[1] or {}, prop[2]], ensure_ascii=False,
                              sort_keys=True, separators=(",", ":"))
    return ""


def _termin_eds_ics_identisch(lokal, entfernt):
    """Erkennt dieselbe externe Instanz, nicht nur gleich aussehende Termine."""
    quelle = str(lokal.get("icsQuelleId") or "")
    if not quelle or quelle.startswith("eds:"):
        return False
    if not (_termin_externe_kennungen(lokal) &
            _termin_externe_kennungen(entfernt)):
        return False
    if _termin_recurrence_id(lokal) != _termin_recurrence_id(entfernt):
        return False
    return (lokal.get("datum") or "", lokal.get("endDatum") or "",
            lokal.get("zeit") or "", lokal.get("endZeit") or "",
            kanonischer_text(lokal.get("titel"))) == (
                entfernt.get("datum") or "", entfernt.get("endDatum") or "",
                entfernt.get("zeit") or "", entfernt.get("endZeit") or "",
                kanonischer_text(entfernt.get("titel")))


def _termin_quelle_hinzufuegen(termin, quellen_id, name, externe_uid=""):
    """Bewahrt Import- und Sync-Provenienz bei einem zusammengeführten Termin."""
    alle = dict(termin.get("syncQuellen") or {})
    alte_id = str(termin.get("icsQuelleId") or "")
    alter_name = str(termin.get("icsQuelleName") or "").strip()
    if alte_id and alte_id != quellen_id and alte_id not in alle:
        alle[alte_id] = {"id": str(termin.get("uid") or ""),
                         "name": alter_name, "eigen": False}
    alle[quellen_id] = {"id": str(externe_uid or termin.get("uid") or ""),
                        "name": str(name or "").strip(), "eigen": False}
    namen = []
    for eintrag in alle.values():
        quellname = str(eintrag.get("name") or "").strip() \
            if isinstance(eintrag, dict) else ""
        if quellname and quellname not in namen:
            namen.append(quellname)
    termin["syncQuellen"] = alle
    termin["icsQuelleId"] = quellen_id
    termin["icsQuelleName"] = " + ".join(namen) or str(name or "")


def _lokale_kalender_dubletten_bereinigen(nutzlast):
    """Vereinigt dieselbe externe Kalenderinstanz aus lokalen Cache-Kopien."""
    termine = []
    for termin in nutzlast.get("termine") or []:
        treffer = next((vorhanden for vorhanden in termine
                        if _termin_eds_ics_identisch(vorhanden, termin)), None)
        if treffer is None:
            termine.append(termin)
            continue
        quelle_id = str(termin.get("icsQuelleId") or "")
        if quelle_id:
            _termin_quelle_hinzufuegen(
                treffer, quelle_id, termin.get("icsQuelleName"), termin.get("uid"))
        if termin.get("icsKomplex") and not treffer.get("icsKomplex"):
            quellen = dict(treffer.get("syncQuellen") or {})
            quellen.update(termin.get("syncQuellen") or {})
            treffer.clear()
            treffer.update(termin)
            treffer["syncQuellen"] = quellen
    nutzlast["termine"] = termine

    def kennungen(eintrag):
        return {str(wert).strip() for wert in (
            eintrag.get("uid"), eintrag.get("icsSerienUid"))
                if str(wert or "").strip()}

    jahrestage = []
    for jahrestag in nutzlast.get("jahrestage") or []:
        ids = kennungen(jahrestag)
        treffer = next((vorhanden for vorhanden in jahrestage
                        if ids and ids & kennungen(vorhanden) and
                        (vorhanden.get("datum") or "")[5:] ==
                        (jahrestag.get("datum") or "")[5:] and
                        kanonischer_text(vorhanden.get("name")) ==
                        kanonischer_text(jahrestag.get("name"))), None)
        if treffer is None:
            jahrestage.append(jahrestag)
            continue
        namen = [str(treffer.get("icsQuelleName") or "").strip(),
                 str(jahrestag.get("icsQuelleName") or "").strip()]
        treffer["icsQuelleName"] = " + ".join(dict.fromkeys(n for n in namen if n))
        if (jahrestag.get("datum") or "9999-99-99") < (
                treffer.get("datum") or "9999-99-99"):
            treffer["datum"] = jahrestag["datum"]
        if not treffer.get("icsSerienUid"):
            treffer["icsSerienUid"] = jahrestag.get("icsSerienUid") or ""

    termin_kennungen = set().union(*(kennungen(t) for t in termine)) if termine else set()
    nutzlast["jahrestage"] = [j for j in jahrestage
                               if not (kennungen(j) & termin_kennungen)]
    return nutzlast


def ics_lesen(text, quellenname="", quellen_id="", jahrestage_als_termine=False):
    """Liest iCalendar-Text. Termine, jährliche Wiederholungen (als
    Jahrestage) und VTODO-Aufgaben werden übernommen; eingebettete
    Bestandteile wie VALARM bleiben als Roundtrip-Daten erhalten."""
    if not isinstance(text, str) or "\x00" in text or not re.search(
            r"(?im)^BEGIN:(?:VCALENDAR|VEVENT|VTODO)\s*$", text):
        raise ValueError(_("The selected file is not a readable iCalendar file."))
    ergebnis = {"termine": [], "jahrestage": [], "aufgaben": [],
                "wiederholend": 0, "uebersprungen": 0,
                "komplexeSerien": []}
    komponenten = []
    art = None
    stapel = []
    props = []
    for zeile in _entfalte_zeilen(text):
        zerlegt = _prop_zerlegen(zeile)
        if not zerlegt:
            continue
        name, params, wert = zerlegt
        if name == "BEGIN":
            w = wert.strip().upper()
            elternart = stapel[-1] if stapel else None
            stapel.append(w)
            if art is None and w in ("VEVENT", "VTODO") and elternart in (
                    None, "VCALENDAR"):
                art = w
                props = []
            elif art is not None:
                props.append((name, params, wert))
        elif name == "END":
            w = wert.strip().upper()
            if not stapel or stapel[-1] != w:
                raise ValueError(_("The selected iCalendar file is incomplete."))
            elternart = stapel[-2] if len(stapel) > 1 else None
            if art is not None and w != art:
                props.append((name, params, wert))
            elif art == w:
                komponenten.append((art, props))
                art = None
            elif elternart == "VCALENDAR" and w != "VTIMEZONE":
                ergebnis["uebersprungen"] += 1
            stapel.pop()
        elif art is not None:
            props.append((name, params, wert))
    if art is not None or stapel:
        raise ValueError(_("The selected iCalendar file is incomplete."))
    komplexe_uids = set()
    for komponenten_art, komponenten_props in komponenten:
        if komponenten_art != "VEVENT" or not _hole(
                komponenten_props, "RECURRENCE-ID")[1]:
            continue
        _params_uid, uid = _hole(komponenten_props, "UID")
        if uid:
            komplexe_uids.add(_ical_unescape(uid))
    for komponenten_art, komponenten_props in komponenten:
        _params_uid, uid = _hole(komponenten_props, "UID")
        _ics_komponente(
            komponenten_art, komponenten_props, ergebnis,
            komponenten_art == "VEVENT" and
            bool(uid and _ical_unescape(uid) in komplexe_uids),
            jahrestage_als_termine=jahrestage_als_termine)
    komplexe_uids.update(
        t.get("icsSerienUid") or t.get("uid")
        for t in ergebnis["termine"] if t.get("icsKomplex"))
    komplexe_uids.discard("")
    komplexe_uids.discard(None)
    ergebnis["komplexeSerien"] = sorted(komplexe_uids)
    if quellenname or quellen_id or re.search(r"(?im)^X-WR-CALNAME(?:;[^:]*)?:", text):
        _ics_quelle_setzen(ergebnis, text, quellenname, quellen_id)
    return ergebnis


def _vevent_zeilen(t):
    uid_wert = str(t.get("icsSerienUid") or t.get("uid") or _neue_uid()).strip()
    z = ["BEGIN:VEVENT",
         "UID:" + uid_wert,
         "DTSTAMP:" + _utc_stempel()]
    if t.get("geaendert"):
        z.append("LAST-MODIFIED:" + _utc_stempel(t["geaendert"]))
    if t.get("icsSequence") is not None:
        try:
            z.append("SEQUENCE:%d" % max(0, int(t.get("icsSequence") or 0)))
        except (TypeError, ValueError):
            pass
    datum = t.get("datum") or ""
    datetime.strptime(datum, "%Y-%m-%d")
    kompakt = datum.replace("-", "")
    end_datum = t.get("endDatum") or t.get("datum") or ""
    datetime.strptime(end_datum, "%Y-%m-%d")
    zeit = t.get("zeit") or ""
    if zeit:
        datetime.strptime(zeit, "%H:%M")
        tzid = _zeitzonenname()
        parameter = ";TZID=" + tzid if tzid else ""
        z.append("DTSTART%s:%sT%s00" % (
            parameter, kompakt, zeit.replace(":", "")))
        if t.get("endZeit"):
            datetime.strptime(t["endZeit"], "%H:%M")
            z.append("DTEND%s:%sT%s00" % (
                parameter, end_datum.replace("-", ""),
                t["endZeit"].replace(":", "")))
        else:
            ende = (datetime.strptime(end_datum + " " + zeit,
                                      "%Y-%m-%d %H:%M") +
                    timedelta(minutes=30))
            z.append("DTEND%s:%s" % (
                parameter, ende.strftime("%Y%m%dT%H%M00")))
    else:
        z.append("DTSTART;VALUE=DATE:" + kompakt)
        exklusiv = (datetime.strptime(end_datum, "%Y-%m-%d") +
                    timedelta(days=1)).strftime("%Y%m%d")
        z.append("DTEND;VALUE=DATE:" + exklusiv)
    wiederholung = t.get("wiederholung") or {}
    frequenz = {"daily": "DAILY", "weekly": "WEEKLY", "monthly": "MONTHLY",
                "yearly": "YEARLY"}.get(wiederholung_art(wiederholung.get("art")))
    if frequenz:
        regel = "FREQ=" + frequenz
        try:
            intervall = max(1, min(3660, int(wiederholung.get("intervall") or 1)))
        except (TypeError, ValueError):
            intervall = 1
        if frequenz in ("DAILY", "WEEKLY") and intervall > 1:
            regel += ";INTERVAL=%d" % intervall
        if frequenz == "MONTHLY":
            try:
                ordinal = int(wiederholung.get("ordinal"))
            except (TypeError, ValueError):
                ordinal = 0
            wochentag = str(wiederholung.get("wochentag") or "").upper()
            if ordinal in (-1, 1, 2, 3, 4) and wochentag in (
                    "MO", "TU", "WE", "TH", "FR", "SA", "SU"):
                if wiederholung.get("rruleForm") == "bysetpos":
                    regel += ";BYDAY=%s;BYSETPOS=%d" % (wochentag, ordinal)
                else:
                    regel += ";BYDAY=%d%s" % (ordinal, wochentag)
        bis = wiederholung.get("bis") or ""
        if bis:
            datetime.strptime(bis, "%Y-%m-%d")
            if zeit and tzid:
                ende = datetime.strptime(bis + " " + zeit, "%Y-%m-%d %H:%M")
                ende = ende.replace(tzinfo=_organizer_zeitzone()).astimezone(timezone.utc)
                bis_wert = ende.strftime("%Y%m%dT%H%M%SZ")
            elif zeit:
                bis_wert = bis.replace("-", "") + "T" + zeit.replace(":", "") + "00"
            else:
                bis_wert = bis.replace("-", "")
            regel += ";UNTIL=" + bis_wert
        z.append("RRULE:" + regel)
    elif wiederholung_art(wiederholung.get("art")) == "custom":
        daten = sorted({wert for wert in (wiederholung.get("daten") or [])
                        if isinstance(wert, str) and re.fullmatch(r"\d{4}-\d{2}-\d{2}", wert)})
        if daten:
            if zeit:
                z.append("RDATE:" + ",".join(
                    wert.replace("-", "") + "T" + zeit.replace(":", "") + "00"
                    for wert in daten))
            else:
                z.append("RDATE;VALUE=DATE:" + ",".join(
                    wert.replace("-", "") for wert in daten))
    z.append("SUMMARY:" + _ical_escape(t.get("titel")))
    if t.get("notiz"):
        z.append("DESCRIPTION:" + _ical_escape(t["notiz"]))
    if t.get("kategorien"):
        z.append("CATEGORIES:" + _ical_escape(t["kategorien"]))
    if t.get("vertraulich"):
        z.append("CLASS:CONFIDENTIAL")
    if t.get("vorlaeufig"):
        z.append("STATUS:TENTATIVE")
    if t.get("kostenstelle"):
        z.append("X-MAGNOLIE-KOSTENSTELLE:" + _ical_escape(t["kostenstelle"]))
    if t.get("kunde"):
        z.append("X-MAGNOLIE-KUNDE:" + _ical_escape(t["kunde"]))
    tage = _erinnerung_tage(t.get("individuelleErinnerungTage"))
    if tage:
        z.append("X-MAGNOLIE-ERINNERUNG-TAGE:%d" % tage)
    if t.get("standardErinnerung") is False:
        z.append("X-MAGNOLIE-STANDARDERINNERUNG:0")
    _ics_roundtrip_anwenden(z, t.get("icsRoundtrip"))
    z.append("END:VEVENT")
    return z


def _jahrestag_zeilen(jt):
    datum = jt.get("datum") or ""
    datetime.strptime(datum, "%Y-%m-%d")
    typ = jt.get("typ") or "other"
    typ_id = jahrestag_typ_id(typ)
    legacy = JT_TYPEN[typ_id][1] if typ_id else typ
    return ["BEGIN:VEVENT",
            "UID:" + (jt.get("uid") or _neue_uid()),
            "DTSTAMP:" + _utc_stempel(),
            "DTSTART;VALUE=DATE:" + datum.replace("-", ""),
            "RRULE:FREQ=YEARLY",
            "SUMMARY:" + _ical_escape(jt.get("name")),
            "CATEGORIES:" + _ical_escape(legacy),
            "X-MAGNOLIE-TYPE-ID:" + _ical_escape(typ_id or "custom"),
            "X-MAGNOLIE-TYP:" + _ical_escape(legacy),
            "X-MAGNOLIE-JAHRESTAG-TYP:" + _ical_escape(typ_id or legacy),
            "END:VEVENT"]


def _vtodo_zeilen(a):
    z = ["BEGIN:VTODO",
         "UID:" + (a.get("uid") or _neue_uid()),
         "DTSTAMP:" + _utc_stempel(),
         "SUMMARY:" + _ical_escape(a.get("titel"))]
    if a.get("faellig"):
        datetime.strptime(a["faellig"], "%Y-%m-%d")
        if a.get("startZeit"):
            datetime.strptime(a["startZeit"], "%H:%M")
            z.append("DTSTART:" + a["faellig"].replace("-", "") + "T" +
                     a["startZeit"].replace(":", "") + "00")
        if a.get("faelligZeit"):
            datetime.strptime(a["faelligZeit"], "%H:%M")
            z.append("DUE:" + a["faellig"].replace("-", "") + "T" +
                     a["faelligZeit"].replace(":", "") + "00")
        else:
            z.append("DUE;VALUE=DATE:" + a["faellig"].replace("-", ""))
    z.append("PRIORITY:" + {1: "1", 2: "5", 3: "9"}.get(a.get("prio"), "5"))
    if a.get("erledigt"):
        z.append("STATUS:COMPLETED")
        z.append("PERCENT-COMPLETE:100")
    if a.get("notiz"):
        z.append("DESCRIPTION:" + _ical_escape(a["notiz"]))
    if a.get("erinnern"):
        z.append("X-MAGNOLIE-ERINNERUNG-AM-TAG:1")
    tage = _erinnerung_tage(a.get("individuelleErinnerungTage"))
    if tage:
        z.append("X-MAGNOLIE-ERINNERUNG-TAGE:%d" % tage)
    _ics_roundtrip_anwenden(z, a.get("icsRoundtrip"))
    z.append("END:VTODO")
    return z


def _ics_roundtrip_anwenden(zeilen, roundtrip):
    rohzeilen = [str(zeile).replace("\r", "").replace("\n", "")
                 for zeile in (roundtrip or []) if isinstance(zeile, str) and
                 re.match(r"^[A-Za-z0-9-]+(?:;[^:]*)?:", zeile)]
    if not rohzeilen:
        return
    ersetzen = {zeile.split(":", 1)[0].split(";", 1)[0].upper()
                for zeile in rohzeilen} & {
                    "DTSTART", "DTEND", "DUE", "DURATION", "RRULE", "RDATE",
                    "EXDATE", "EXRULE", "RECURRENCE-ID"}
    zeilen[:] = [zeile for zeile in zeilen
                 if zeile.split(":", 1)[0].split(";", 1)[0].upper() not in ersetzen]
    zeilen.extend(rohzeilen)


def _utc_offset_text(offset):
    sekunden = int((offset or timedelta()).total_seconds())
    zeichen = "+" if sekunden >= 0 else "-"
    sekunden = abs(sekunden)
    stunden, rest = divmod(sekunden, 3600)
    minuten, sekunden = divmod(rest, 60)
    return "%s%02d%02d%s" % (
        zeichen, stunden, minuten, "%02d" % sekunden if sekunden else "")


def _vtimezone_zeilen(tzid, von_jahr, bis_jahr):
    """Erzeugt eine VTIMEZONE aus den wirklichen zoneinfo-Übergängen."""
    try:
        from zoneinfo import ZoneInfo
        zone = ZoneInfo(tzid)
    except (ImportError, KeyError, ValueError):
        return []
    von_jahr = max(1, int(von_jahr) - 1)
    bis_jahr = min(9998, int(bis_jahr) + 1)
    start = datetime(von_jahr, 1, 1, tzinfo=timezone.utc)
    ende = datetime(bis_jahr + 1, 1, 1, tzinfo=timezone.utc)
    cursor = start
    vorher = cursor.astimezone(zone)
    vorher_offset = vorher.utcoffset() or timedelta()
    uebergaenge = []
    while cursor < ende:
        naechster = min(cursor + timedelta(hours=12), ende)
        nachher = naechster.astimezone(zone)
        nachher_offset = nachher.utcoffset() or timedelta()
        if nachher_offset != vorher_offset:
            links, rechts = cursor, naechster
            while rechts - links > timedelta(seconds=1):
                mitte = links + (rechts - links) / 2
                if (mitte.astimezone(zone).utcoffset() or timedelta()) == vorher_offset:
                    links = mitte
                else:
                    rechts = mitte
            wechsel = rechts.replace(microsecond=0)
            lokal = (wechsel.replace(tzinfo=None) + vorher_offset)
            neu = wechsel.astimezone(zone)
            uebergaenge.append((
                "DAYLIGHT" if neu.dst() and neu.dst() != timedelta() else "STANDARD",
                lokal.strftime("%Y%m%dT%H%M%S"), vorher_offset,
                neu.utcoffset() or timedelta(), neu.tzname() or tzid))
            vorher_offset = neu.utcoffset() or timedelta()
        else:
            vorher_offset = nachher_offset
        cursor = naechster
    zeilen = ["BEGIN:VTIMEZONE", "TZID:" + tzid,
              "X-LIC-LOCATION:" + tzid]
    if not uebergaenge:
        lokal = start.astimezone(zone)
        offset = lokal.utcoffset() or timedelta()
        uebergaenge.append(("STANDARD", "%04d0101T000000" % von_jahr,
                            offset, offset, lokal.tzname() or tzid))
    gruppen = {}
    for art, zeitpunkt, von, nach, name in uebergaenge:
        gruppen.setdefault((art, von, nach, name), []).append(zeitpunkt)
    for (art, von, nach, name), zeitpunkte in gruppen.items():
        zeilen.extend(["BEGIN:" + art,
                       "DTSTART:" + zeitpunkte[0],
                       "TZOFFSETFROM:" + _utc_offset_text(von),
                       "TZOFFSETTO:" + _utc_offset_text(nach),
                       "TZNAME:" + _ical_escape(name)])
        if len(zeitpunkte) > 1:
            zeilen.append("RDATE:" + ",".join(zeitpunkte[1:]))
        zeilen.append("END:" + art)
    zeilen.append("END:VTIMEZONE")
    return zeilen


def _vcalendar(bloecke):
    zeilen = ["BEGIN:VCALENDAR", "VERSION:2.0",
              "PRODID:-//Magnolie Organizer//DE", "CALSCALE:GREGORIAN"]
    tzids = set()
    jahre = []
    for block in bloecke:
        for zeile in block:
            treffer = re.search(r"(?:^|;)TZID=([^;:]+)", zeile)
            if treffer:
                tzids.add(treffer.group(1))
            jahre.extend(int(jahr) for jahr in re.findall(
                r"(?::|UNTIL=)(\d{4})\d{4}", zeile))
    if jahre:
        for tzid in sorted(tzids):
            zeilen.extend(_vtimezone_zeilen(tzid, min(jahre), max(jahre)))
    for block in bloecke:
        zeilen.extend(block)
    zeilen.append("END:VCALENDAR")
    return "\r\n".join(_falte(z) for z in zeilen) + "\r\n"


def ics_schreiben_termine(termine):
    bloecke, _uebersprungen = _ics_termine_bloecke(termine)
    return _vcalendar(bloecke)


def _ics_bloecke(eintraege, wandler):
    bloecke = []
    uebersprungen = 0
    for eintrag in eintraege:
        try:
            bloecke.append(wandler(eintrag))
        except (AttributeError, TypeError, ValueError):
            uebersprungen += 1
    return bloecke, uebersprungen


def _ics_termine_bloecke(termine):
    return _ics_bloecke(termine, _vevent_zeilen)


def _ics_jahrestage_bloecke(jahrestage):
    return _ics_bloecke(jahrestage, _jahrestag_zeilen)


def _ics_aufgaben_bloecke(aufgaben):
    return _ics_bloecke(aufgaben, _vtodo_zeilen)


def ics_schreiben_jahrestage(jahrestage):
    bloecke, _uebersprungen = _ics_jahrestage_bloecke(jahrestage)
    return _vcalendar(bloecke)


def ics_schreiben_aufgaben(aufgaben):
    bloecke, _uebersprungen = _ics_aufgaben_bloecke(aufgaben)
    return _vcalendar(bloecke)


def vevent_text(t):
    """Einzelner VEVENT-Block (für den Evolution-Data-Server)."""
    return "\r\n".join(_falte(z) for z in _vevent_zeilen(t)) + "\r\n"


def ics_resource_aktualisieren(text, termin):
    """Ersetzt genau einen VEVENT und behaelt die CalDAV-Ressource zusammen."""
    muster = re.compile(r"(?ims)^BEGIN:VEVENT\s*$.*?^END:VEVENT\s*$")
    treffer = []
    for block in muster.finditer(text):
        try:
            gelesen = ics_lesen(block.group(0))
        except ValueError:
            continue
        if (len(gelesen["termine"]) == 1 and
                gelesen["termine"][0].get("uid") == termin.get("uid")):
            treffer.append(block)
    if len(treffer) != 1:
        raise ValueError(_("The calendar resource does not contain exactly one matching appointment."))
    block = treffer[0]
    ersatz = vevent_text(termin).rstrip("\r\n")
    return text[:block.start()] + ersatz + text[block.end():]


# ---------------------------------------------------------------------------
# vCard (.vcf) – lesen und schreiben
# ---------------------------------------------------------------------------

def _vcard_karten(text):
    """Zerlegt eine .vcf-Datei in Karten (Listen entfalteter Zeilen).
    Beherrscht die Standardfaltung sowie die Quoted-Printable-Umbrüche
    alter vCard-2.1-Dateien (Zeile endet mit „=")."""
    karten, karte = [], None
    for roh in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        glatt = roh.strip().upper()
        if karte is None:
            if glatt == "BEGIN:VCARD":
                karte = []
            continue
        if glatt == "END:VCARD":
            karten.append(karte)
            karte = None
            continue
        if roh[:1] in (" ", "\t") and karte:
            karte[-1] += roh[1:]
        elif (karte and karte[-1].endswith("=")
              and "QUOTED-PRINTABLE" in karte[-1].split(":", 1)[0].upper()):
            karte[-1] = karte[-1][:-1] + roh
        elif (karte and karte[-1].split(":", 1)[0].upper().startswith("PHOTO")
              and ("ENCODING=B" in karte[-1].split(":", 1)[0].upper()
                   or "ENCODING=BASE64" in karte[-1].split(":", 1)[0].upper())
              and re.fullmatch(r"[A-Za-z0-9+/=]+", roh.strip())):
            # Manche vCard-2.1-Erzeuger brechen Base64 ohne den laut
            # Standard nötigen Einzug um. Auch diese Bildzeilen gehören zur
            # vorherigen PHOTO-Eigenschaft.
            karte[-1] += roh.strip()
        elif roh.strip():
            karte.append(roh)
    return karten


def _vcard_wert(wert, params):
    """Dekodiert Quoted-Printable-Werte alter vCards, sonst unverändert."""
    if "QUOTED-PRINTABLE" in params or params.get("ENCODING", "").upper() == "QUOTED-PRINTABLE":
        try:
            roh = quopri.decodestring(wert.encode("latin-1", "replace"))
        except Exception:
            return wert
        for zeichensatz in (params.get("CHARSET", "utf-8"), "utf-8", "latin-1"):
            try:
                return roh.decode(zeichensatz)
            except (LookupError, UnicodeDecodeError):
                continue
        return roh.decode("latin-1", "replace")
    return wert


def _vcard_restparameter(params):
    """Behält Parameter, die der Magnolie-Serializer nicht selbst erzeugt."""
    aus = []
    eigene = {"TYPE", "ENCODING", "CHARSET", "VALUE"}
    nackte_typen = {"HOME", "WORK", "CELL", "VOICE", "FAX", "PAGER", "PREF",
                    "INTERNET"}
    for name, wert in params.items():
        if (name in eigene or (not wert and name in nackte_typen) or
                not re.fullmatch(r"[A-Z0-9-]+", name)):
            continue
        wert = str(wert or "")
        if any(c in wert for c in "\r\n\""):
            continue
        aus.append(name + (("=\"%s\"" % wert) if any(c in wert for c in ":;,")
                           else ("=" + wert if wert else "")))
    return aus


def _vcard_parameter_liste(roh):
    return [p for p in roh if isinstance(p, str) and
            re.fullmatch(r"[A-Z0-9-]+(?:=(?:[^\r\n\";:,]+|\"[^\r\n\"]*\"))?", p)][:32] \
        if isinstance(roh, list) else []


def _vcard_parameter_text(eintrag, kontakt, name, index):
    parameter = _vcard_parameter_liste(eintrag.get("vcardParameter"))
    if not parameter:
        alle = kontakt.get("vcardParameter")
        werte = alle.get(name) if isinstance(alle, dict) else None
        parameter = _vcard_parameter_liste(
            werte[index] if isinstance(werte, list) and index < len(werte) else [])
    return "".join(";" + p for p in parameter if isinstance(p, str) and
                   re.fullmatch(r"[A-Z0-9-]+(?:=(?:[^\r\n\";:,]+|\"[^\r\n\"]*\"))?", p))


def _semikolon_teile(wert):
    """Trennt an „;", ohne maskierte „\\;" zu zerreißen."""
    teile, puffer, i = [], "", 0
    while i < len(wert):
        c = wert[i]
        if c == "\\" and i + 1 < len(wert):
            puffer += c + wert[i + 1]
            i += 2
        elif c == ";":
            teile.append(puffer)
            puffer = ""
            i += 1
        else:
            puffer += c
            i += 1
    teile.append(puffer)
    return teile


def _bday_datum(wert):
    w = (wert or "").strip().split("T")[0]
    m = re.match(r"^--(\d{2})-?(\d{2})$", w)          # ohne Jahr
    if m:
        # 2000 ist ein gültiges Schaltjahr und dient nur intern als Träger;
        # das Flag sorgt beim Export wieder für die jahrlose vCard-Form.
        monat, tag = m.groups()
        try:
            datetime.strptime("2000-%s-%s" % (monat, tag), "%Y-%m-%d")
        except ValueError:
            return ""
        return "2000-%s-%s" % (monat, tag)
    m = re.match(r"^(\d{4})-?(\d{2})-?(\d{2})$", w)
    if m:
        return "%s-%s-%s" % m.groups()
    return ""


def _typen_von(params):
    typen = set()
    for schluessel, wert in params.items():
        if schluessel == "TYPE":
            for t in wert.split(","):
                typen.add(t.strip().upper())
        elif not wert:                                 # nackte Parameter (vCard 2.1)
            typen.add(schluessel)
    # CardBook übernimmt für Google-Kontakte die People-API-Bezeichnungen.
    # Diese sind keine üblichen vCard-Typen, haben aber eindeutige Entsprechungen.
    if "MOBILE" in typen:
        typen.discard("MOBILE")
        typen.add("CELL")
    if "HOMEFAX" in typen:
        typen.discard("HOMEFAX")
        typen.update(("HOME", "FAX"))
    if "WORKFAX" in typen:
        typen.discard("WORKFAX")
        typen.update(("WORK", "FAX"))
    return typen


def _telefon_typen_aus_label(typen, label):
    """Ergänzt Typen aus freien CardBook-/Apple-Telefonbezeichnungen."""
    aus = set(typen)
    text = str(label or "").strip()
    apple = re.fullmatch(r"_\$!<([^<>]+)>!\$_", text)
    vergleich = (apple.group(1) if apple else text).casefold()
    vergleich = re.sub(r"[\s_-]+", "", vergleich)
    if (vergleich in ("mobil", "mobile", "handy", "cell", "iphone")
            or "mobil" in vergleich):
        aus.add("CELL")
    elif vergleich in ("zuhause", "home", "privat", "private"):
        aus.add("HOME")
    elif vergleich in ("arbeit", "work", "geschäftlich", "geschaeftlich"):
        aus.add("WORK")
    elif vergleich in ("homefax", "faxzuhause", "privatfax"):
        aus.update(("HOME", "FAX"))
    elif vergleich in ("workfax", "faxarbeit", "geschäftsfax", "geschaeftsfax"):
        aus.update(("WORK", "FAX"))
    elif vergleich == "fax":
        aus.add("FAX")
    elif vergleich == "pager":
        aus.add("PAGER")
    return sorted(aus)


def _vcard_foto(wert, params, lokale_dateien=False):
    """Übernimmt eingebettete Kontaktbilder als begrenzte Datenadresse.

    Evolution und Gnome-Kontakte legen Bilder teils als lokale file:-URI
    ab. Solche Dateien werden eingebettet; Verweise ins Netz werden
    weiterhin absichtlich nicht geladen."""
    roh_wert = str(wert or "").strip()

    def lokale_datei_datenadresse(pfad):
        if not pfad or not os.path.isabs(pfad):
            return ""
        try:
            if os.path.getsize(pfad) > 2700000:
                return ""
            with open(pfad, "rb") as datei:
                roh = datei.read(2700001)
        except OSError:
            return ""
        if len(roh) > 2700000:
            return ""
        if roh.startswith(b"\xff\xd8\xff"):
            art = "jpeg"
        elif roh.startswith(b"\x89PNG\r\n\x1a\n"):
            art = "png"
        elif roh.startswith((b"GIF87a", b"GIF89a")):
            art = "gif"
        elif len(roh) >= 12 and roh[:4] == b"RIFF" and roh[8:12] == b"WEBP":
            art = "webp"
        else:
            return ""
        return "data:image/%s;base64,%s" % (
            art, base64.b64encode(roh).decode("ascii"))

    if lokale_dateien and roh_wert.lower().startswith("file:"):
        try:
            from urllib.parse import unquote, urlsplit
            uri = urlsplit(roh_wert)
            if uri.scheme.lower() != "file" or uri.netloc not in ("", "localhost"):
                return ""
            foto = lokale_datei_datenadresse(unquote(uri.path))
            if foto:
                return foto
        except (TypeError, ValueError):
            return ""
    elif lokale_dateien and os.path.isabs(roh_wert):
        foto = lokale_datei_datenadresse(roh_wert)
        if foto:
            return foto

    wert = re.sub(r"\s+", "", roh_wert)
    if not wert or len(wert) > 3600000:
        return ""
    if re.match(r"^data:image/(?:jpeg|png|webp|gif);base64,", wert, re.I):
        return wert
    if re.match(r"^[a-z]+://", wert, re.I):
        return ""
    if not re.match(r"^[A-Za-z0-9+/=]+$", wert):
        return ""
    art = (params.get("TYPE") or params.get("MEDIATYPE") or "JPEG")
    art = art.split(",")[0].split("/")[-1].lower()
    if art == "jpg":
        art = "jpeg"
    if art not in ("jpeg", "png", "webp", "gif"):
        art = "jpeg"
    return "data:image/%s;base64,%s" % (art, wert)


_EMAIL_MUSTER = re.compile(r"^[^\s@<>,;:]+@[^\s@<>,;:]+\.[^\s@<>,;:]+$")


def _email_adresse(wert):
    """Liefert nur eine erkennbare E-Post-Anschrift, ohne Anzeigenamen."""
    text = str(wert or "").strip()
    klammer = re.search(r"<([^<>]+)>", text)
    if klammer:
        text = klammer.group(1).strip()
    if text.lower().startswith("mailto:"):
        text = text[7:]
    if len(text) > 254 or not _EMAIL_MUSTER.match(text):
        return ""
    domain = text.rsplit("@", 1)[-1].lower()
    if domain == "invalid" or domain.endswith(".invalid"):
        return ""
    return text


def _email_eintraege(kontakt):
    """Liefert E-Post-Anschriften mit Typ und freier Bezeichnung."""
    kandidaten = []
    if isinstance(kontakt, dict):
        roh = kontakt.get("emailEintraege")
        if isinstance(roh, (list, tuple)):
            kandidaten.extend(roh)
        roh = kontakt.get("emails")
        if isinstance(roh, (list, tuple)):
            kandidaten.extend(roh)
        elif roh:
            kandidaten.append(roh)
        if kontakt.get("email"):
            kandidaten.insert(0, kontakt.get("email"))
    ergebnis, gesehen = [], {}
    for roh in kandidaten:
        objekt = isinstance(roh, dict)
        wert = _email_adresse((roh.get("wert") or roh.get("email")) if objekt else roh)
        if not wert:
            continue
        typen = _telefon_typen(roh.get("typen")) if objekt else []
        parameter = _vcard_parameter_liste(
            roh.get("vcardParameter")) if objekt else []
        label = _kontakt_label(roh.get("label")) if objekt else ""
        rolle = ("private" if objekt and
                 (roh.get("rolle") == "private" or
                  kanonischer_text(label) in ("privat", "private")) else "")
        if rolle:
            label = ""
        schluessel = wert.lower()
        if schluessel in gesehen:
            ziel = ergebnis[gesehen[schluessel]]
            ziel["typen"] = sorted(set(ziel["typen"] + typen))
            if label and not ziel.get("label"):
                ziel["label"] = label
            if rolle and not ziel.get("rolle"):
                ziel["rolle"] = rolle
            ziel["vcardParameter"] = list(dict.fromkeys(
                ziel.get("vcardParameter", []) + parameter))[:32]
            continue
        neu = {"wert": wert, "typen": typen}
        if parameter:
            neu["vcardParameter"] = parameter
        if label:
            neu["label"] = label
        if rolle:
            neu["rolle"] = rolle
        gesehen[schluessel] = len(ergebnis)
        ergebnis.append(neu)
    return ergebnis


def _email_liste(kontakt):
    """Liefert alle E-Post-Anschriften, alte Einzelfelder eingeschlossen."""
    return [eintrag["wert"] for eintrag in _email_eintraege(kontakt)]


def _email_eintraege_vereinigen(*kontakte):
    """Vereinigt E-Post-Anschriften samt Typen und freien Bezeichnungen."""
    return _email_eintraege({"emailEintraege": [
        eintrag for kontakt in kontakte
        for eintrag in _email_eintraege(kontakt)]})


def _emails_vereinigen(*kontakte):
    """Vereinigt E-Post-Anschriften und behält die erste Reihenfolge bei."""
    return [eintrag["wert"] for eintrag in _email_eintraege_vereinigen(*kontakte)]


def _kontaktpersonen_liste(kontakt):
    """Liefert alle Notfallkontakte, alte Einzelfelder eingeschlossen."""
    kandidaten = []
    if isinstance(kontakt, dict):
        roh = kontakt.get("kontaktpersonen")
        if isinstance(roh, (list, tuple)):
            kandidaten.extend(roh)
        if any(kontakt.get(feld) for feld in (
                "kontaktpersonName", "kontaktpersonTelefon", "kontaktpersonStatus")):
            kandidaten.insert(0, {
                "name": kontakt.get("kontaktpersonName"),
                "telefon": kontakt.get("kontaktpersonTelefon"),
                "status": kontakt.get("kontaktpersonStatus")})
    ergebnis, gesehen = [], set()
    for roh in kandidaten:
        if not isinstance(roh, dict):
            continue
        eintrag = {
            "name": str(roh.get("name") or "").strip(),
            "telefon": str(roh.get("telefon") or "").strip(),
            "status": str(roh.get("status") or roh.get("beziehung") or "").strip()[:80]}
        if not any(eintrag.values()):
            continue
        schluessel = (kanonischer_text(eintrag["name"]),
                      _telefon_schluessel(eintrag["telefon"]) or eintrag["telefon"],
                      kanonischer_text(eintrag["status"]))
        if schluessel in gesehen:
            continue
        gesehen.add(schluessel)
        ergebnis.append(eintrag)
    return ergebnis


def _kontaktpersonen_setzen(kontakt, kontaktpersonen):
    kontakt["kontaktpersonen"] = _kontaktpersonen_liste(
        {"kontaktpersonen": kontaktpersonen})
    erste = kontakt["kontaktpersonen"][0] if kontakt["kontaktpersonen"] else {}
    kontakt["kontaktpersonName"] = erste.get("name", "")
    kontakt["kontaktpersonTelefon"] = erste.get("telefon", "")
    kontakt["kontaktpersonStatus"] = erste.get("status", "")
    return kontakt


def _kontaktpersonen_vereinigen(*kontakte):
    return _kontaktpersonen_liste({"kontaktpersonen": [
        person for kontakt in kontakte
        for person in _kontaktpersonen_liste(kontakt)]})


def _soziale_medien_liste(kontakt):
    erlaubt = {"whatsapp", "threema", "facebook", "instagram", "signal",
               "mastodon", "teams", "snapchat", "tiktok", "youtube",
               "telegram", "x", "linkedin", "reddit", "custom", "sms", "phone"}
    eigene_symbole = {"custom", "twitch", "irc", "discord", "matrix", "slack", "github"}
    ergebnis, gesehen = [], set()
    roh_liste = kontakt.get("sozialeMedien") if isinstance(kontakt, dict) else []
    for roh in roh_liste if isinstance(roh_liste, (list, tuple)) else []:
        if not isinstance(roh, dict):
            continue
        dienst_roh = str(roh.get("dienstId") or roh.get("dienst") or "").strip().lower()
        dienst = {"telefon": "phone", "phone": "phone", "twitter": "x", "x": "x",
                   "likedin": "linkedin", "linkedin": "linkedin"}.get(
            dienst_roh, dienst_roh)
        wert = str(roh.get("wert") or roh.get("kennung") or "").strip()[:500]
        schluessel = (dienst, kanonischer_text(wert))
        if dienst not in erlaubt or not wert or schluessel in gesehen:
            continue
        gesehen.add(schluessel)
        eintrag = {"dienst": dienst, "wert": wert}
        if dienst == "custom":
            symbol = str(roh.get("symbol") or "custom").strip().lower()
            eintrag["symbol"] = symbol if symbol in eigene_symbole else "custom"
        aktion_art = str(roh.get("aktionArtId") or
                          roh.get("aktionArt") or "").strip().lower()
        aktion_ziel = str(roh.get("aktionZiel") or "").strip()[:500]
        aktion_art = {"webseite": "website", "website": "website",
                      "programm": "program", "program": "program"}.get(
                          aktion_art, "")
        if aktion_art and aktion_ziel:
            eintrag["aktionArt"] = aktion_art
            eintrag["aktionZiel"] = aktion_ziel
        ergebnis.append(eintrag)
    return ergebnis


def _soziale_medien_vereinigen(*kontakte):
    return _soziale_medien_liste({"sozialeMedien": [
        eintrag for kontakt in kontakte
        for eintrag in _soziale_medien_liste(kontakt)]})


def _telefon_schluessel(wert, land="DE"):
    """Vergleicht internationale und nationale Schreibweisen derselben Nummer."""
    text = re.sub(r"^tel:", "", str(wert or "").strip(), flags=re.I)
    erweiterung = ""
    treffer = re.search(r"(?:\b(?:ext|extension|durchwahl)\b|[x#])\s*(\d+)\s*$",
                        text, re.I)
    if treffer:
        erweiterung = "x" + treffer.group(1)
        text = text[:treffer.start()]
    text = re.sub(r"^\s*\+(49|43|41)\s*\(0\)", r"+\1", text)
    plus = text.lstrip().startswith("+")
    ziffern = re.sub(r"\D", "", text)
    if ziffern.startswith("00"):
        plus, ziffern = True, ziffern[2:]
    if plus:
        for code in ("49", "43", "41"):
            if ziffern.startswith(code + "0"):
                ziffern = code + ziffern[len(code) + 1:]
                break
        schluessel = "+" + ziffern
    elif ziffern.startswith("0"):
        code = {"DE": "49", "AT": "43", "CH": "41"}.get(str(land).upper(), "49")
        schluessel = "+" + code + ziffern[1:]
    else:
        schluessel = ziffern
    return schluessel + erweiterung if len(ziffern) >= 6 else ""


def _ist_eds_zeigerwert(wert):
    """Erkennt als Dezimalzahl ausgegebene 64-Bit-GI/GList-Zeiger."""
    text = str(wert or "").strip()
    if not re.fullmatch(r"\d{13,15}", text):
        return False
    nummer = int(text)
    return 0x700000000000 <= nummer < 0x800000000000 and nummer % 16 == 0


def _telefon_typen(roh):
    if isinstance(roh, str):
        roh = re.split(r"[,;]", roh)
    aus = []
    for typ in roh if isinstance(roh, (list, tuple, set)) else []:
        typ = re.sub(r"[^A-Z0-9-]", "", str(typ or "").upper())[:40]
        if typ and typ not in aus:
            aus.append(typ)
    if "X-HAUPTSITZ" in aus:
        aus.remove("X-HAUPTSITZ")
        if "X-HEAD-OFFICE" not in aus:
            aus.append("X-HEAD-OFFICE")
    if "X-ZWEITSITZ" in aus:
        aus.remove("X-ZWEITSITZ")
        if "X-SECONDARY-OFFICE" not in aus:
            aus.append("X-SECONDARY-OFFICE")
    return aus


def _kontakt_label(wert):
    return re.sub(r"[\x00-\x1f\x7f]", " ", str(wert or "")).strip()[:80]


def _telefon_typ_gruppe(typen):
    menge = set(typen)
    for gruppe, werte in (("fax", {"FAX"}), ("mobil", {"CELL", "MOBILE"}),
                           ("pager", {"PAGER"}), ("zuhause", {"HOME"}),
                           ("arbeit", {"WORK"})):
        if menge & werte:
            return gruppe
    return ""


def _telefon_liste(kontakt):
    """Liefert alle Nummern; alte telefon/mobil-Felder werden mit migriert."""
    roh = kontakt.get("telefone") if isinstance(kontakt, dict) else []
    kandidaten = list(roh) if isinstance(roh, list) else []
    if isinstance(kontakt, dict) and kontakt.get("telefon"):
        kandidaten.append({"wert": kontakt["telefon"], "typen": ["VOICE"]})
    if isinstance(kontakt, dict) and kontakt.get("mobil"):
        kandidaten.append({"wert": kontakt["mobil"], "typen": ["CELL"]})
    ergebnis, positionen = [], {}
    for eintrag in kandidaten:
        if isinstance(eintrag, str):
            wert, typen = eintrag, []
        elif isinstance(eintrag, dict):
            wert = eintrag.get("wert") or eintrag.get("nummer") or ""
            typen = _telefon_typen(eintrag.get("typen") or [])
            parameter = _vcard_parameter_liste(eintrag.get("vcardParameter"))
            label = _kontakt_label(eintrag.get("label"))
            rolle = ("private" if eintrag.get("rolle") == "private" or
                     kanonischer_text(label) in ("privat", "private") else "")
            if rolle:
                label = ""
        else:
            continue
        if isinstance(eintrag, str):
            label = ""
            rolle = ""
            parameter = []
        wert = re.sub(r"^tel:", "", str(wert).strip(), flags=re.I)
        if not wert or _ist_eds_zeigerwert(wert):
            continue
        schluessel = _telefon_schluessel(wert) or "roh:" + re.sub(
            r"\s", "", kanonischer_text(wert))
        passende = positionen.get(schluessel, [])
        vereinigt = False
        for stelle in passende:
            ziel = ergebnis[stelle]
            if (ziel.get("label") and label and
                    kanonischer_text(ziel["label"]) != kanonischer_text(label)):
                continue
            ziel_gruppe = _telefon_typ_gruppe(ziel["typen"])
            neue_gruppe = _telefon_typ_gruppe(typen)
            if label and not ziel.get("label"):
                ziel["typen"] = list(typen)
                ziel["label"] = label
            elif not (ziel_gruppe and neue_gruppe and ziel_gruppe != neue_gruppe):
                for typ in typen:
                    if typ not in ziel["typen"]:
                        ziel["typen"].append(typ)
            if rolle and not ziel.get("rolle"):
                ziel["rolle"] = rolle
            ziel["vcardParameter"] = list(dict.fromkeys(
                ziel.get("vcardParameter", []) + parameter))[:32]
            vereinigt = True
            break
        if vereinigt:
            continue
        positionen.setdefault(schluessel, []).append(len(ergebnis))
        neu = {"wert": wert, "typen": typen}
        if parameter:
            neu["vcardParameter"] = parameter
        if label:
            neu["label"] = label
        if rolle:
            neu["rolle"] = rolle
        ergebnis.append(neu)
    return ergebnis


def _telefone_setzen(kontakt, telefone):
    kontakt["telefone"] = _telefon_liste({"telefone": telefone})
    mobil = next((t["wert"] for t in kontakt["telefone"]
                  if any(typ in ("CELL", "MOBILE") for typ in t["typen"])), "")
    telefon = next((t["wert"] for t in kontakt["telefone"]
                    if not any(typ in ("CELL", "MOBILE") for typ in t["typen"])), "")
    kontakt["telefon"] = telefon or (kontakt["telefone"][0]["wert"]
                                      if kontakt["telefone"] else "")
    kontakt["mobil"] = mobil
    return kontakt


def _telefone_vereinigen(*kontakte):
    return _telefon_liste({"telefone": [eintrag for kontakt in kontakte
                                         for eintrag in _telefon_liste(kontakt)]})


def _anschrift_liste(kontakt):
    roh = kontakt.get("anschriften") if isinstance(kontakt, dict) else []
    kandidaten = list(roh) if isinstance(roh, list) else []
    hat_legacy = isinstance(kontakt, dict) and any(kontakt.get(feld) for feld in
                                                   ("strasse", "plz", "ort"))
    legacy_vorhanden = hat_legacy and any(
        isinstance(a, dict) and all(str(a.get(feld) or "").strip() ==
                                    str(kontakt.get(feld) or "").strip()
                                    for feld in ("strasse", "plz", "ort"))
        for a in kandidaten)
    if hat_legacy and not legacy_vorhanden:
        kandidaten.append({"strasse": kontakt.get("strasse", ""),
                           "plz": kontakt.get("plz", ""),
                           "ort": kontakt.get("ort", ""), "land": "",
                           "typen": ["HOME"]})
    ergebnis, gesehen = [], {}
    for eintrag in kandidaten:
        if not isinstance(eintrag, dict):
            continue
        sauber = {"strasse": str(eintrag.get("strasse") or "").strip(),
                  "plz": str(eintrag.get("plz") or "").strip(),
                  "ort": str(eintrag.get("ort") or "").strip(),
                  "land": str(eintrag.get("land") or "").strip(),
                  "typen": _telefon_typen(eintrag.get("typen") or []),
                  "label": _kontakt_label(eintrag.get("label"))}
        parameter = _vcard_parameter_liste(eintrag.get("vcardParameter"))
        if parameter:
            sauber["vcardParameter"] = parameter
        if not sauber["label"]:
            sauber.pop("label")
        if not any(sauber[feld] for feld in ("strasse", "plz", "ort", "land")):
            continue
        strasse_norm = kanonischer_text(sauber["strasse"])
        strasse_norm = re.sub(r"strasse|str\.", "strasse", strasse_norm)
        strasse_norm = re.sub(r"[^\w]", "", strasse_norm).replace("_", "")
        schluessel = (strasse_norm,) + tuple(
            re.sub(r"[^\w]", "", kanonischer_text(sauber[feld])).replace("_", "")
            for feld in ("plz", "ort", "land"))
        vereinigt = False
        for stelle in gesehen.get(schluessel, []):
            ziel = ergebnis[stelle]
            label = sauber.get("label", "")
            if ziel.get("label") and label and \
                    kanonischer_text(ziel["label"]) != kanonischer_text(label):
                continue
            for typ in sauber["typen"]:
                if typ not in ziel["typen"]:
                    ziel["typen"].append(typ)
            if label and not ziel.get("label"):
                ziel["label"] = label
            ziel["vcardParameter"] = list(dict.fromkeys(
                ziel.get("vcardParameter", []) + parameter))[:32]
            vereinigt = True
            break
        if vereinigt:
            continue
        gesehen.setdefault(schluessel, []).append(len(ergebnis))
        ergebnis.append(sauber)
    return ergebnis


def _anschriften_setzen(kontakt, anschriften):
    kontakt["anschriften"] = _anschrift_liste({"anschriften": anschriften})
    haupt = kontakt["anschriften"][0] if kontakt["anschriften"] else {}
    for feld in ("strasse", "plz", "ort"):
        kontakt[feld] = haupt.get(feld, "")
    return kontakt


def _anschriften_vereinigen(*kontakte):
    return _anschrift_liste({"anschriften": [eintrag for kontakt in kontakte
                                               for eintrag in _anschrift_liste(kontakt)]})


def _claws_datum(wert):
    text = str(wert or "").strip()
    for muster in (r"(\d{4})-(\d{2})-(\d{2})", r"(\d{4})(\d{2})(\d{2})"):
        treffer = re.fullmatch(muster, text)
        if treffer:
            datum = "-".join(treffer.groups())
            try:
                datetime.strptime(datum, "%Y-%m-%d")
                return datum
            except ValueError:
                return ""
    return ""


def _claws_kontakt(felder):
    """Überführt LDAP-/Claws-Felder in eine Magnolie-Karteikarte."""
    def werte(*namen):
        aus = []
        for name in namen:
            aus.extend(felder.get(name.casefold(), []))
        return [str(wert).strip() for wert in aus if str(wert).strip()]

    def erster(*namen):
        liste = werte(*namen)
        return liste[0] if liste else ""

    vorname = erster("givenName", "first-name")
    nachname = erster("sn", "surname", "last-name")
    anzeigename = erster("cn", "commonName", "displayName")
    if not vorname and not nachname and anzeigename:
        teile = anzeigename.split()
        if len(teile) > 1:
            vorname, nachname = " ".join(teile[:-1]), teile[-1]
        else:
            nachname = anzeigename
    emails = _email_liste({"emails": werte("mail", "email", "primaryEmail",
                                             "secondEmail", "mozillaSecondEmail")})
    strasse = erster("street", "streetAddress", "homeStreet", "mozillaHomeStreet")
    plz = erster("postalCode", "zip", "homePostalCode", "mozillaHomePostalCode")
    ort = erster("l", "locality", "city", "homeLocalityName", "mozillaHomeLocalityName")
    post = erster("postalAddress", "homePostalAddress")
    if post:
        marke = "\x00MAGNOLIE-DOLLAR\x00"
        teile = [teil.replace(marke, "$").strip() for teil in
                 post.replace("\\24", marke).split("$") if teil.strip()]
        if teile and not strasse:
            strasse = teile[0]
        for teil in teile[1:]:
            plz_ort = re.match(r"^(\d{4,6})\s+(.+)$", teil)
            if plz_ort and not plz:
                plz, ort = plz_ort.groups()
            elif not ort and not re.fullmatch(r"[A-Z]{2}", teil, re.I):
                ort = teil
    notizen = werte("description", "info", "notes", "remarks", "custom1",
                    "custom2", "custom3", "custom4", "mozillaCustom1",
                    "mozillaCustom2", "mozillaCustom3", "mozillaCustom4",
                    "mozillaHomeUrl", "mozillaWorkUrl", "homeUrl", "workUrl")
    titel = erster("title")
    abteilung = erster("ou", "departmentNumber")
    for zusatz in (titel, abteilung):
        if zusatz and zusatz not in notizen:
            notizen.append(zusatz)
    geburtstag = erster("dateOfBirth", "birthDate", "birthday")
    if not geburtstag:
        jahr, monat, tag = (erster("birthYear", "mozillaBirthYear"),
                            erster("birthMonth", "mozillaBirthMonth"),
                            erster("birthDay", "mozillaBirthDay"))
        if monat and tag:
            geburtstag = "%04d-%02d-%02d" % (int(jahr or 2000), int(monat), int(tag))
    uid_wert = erster("entryUUID", "uid")
    telefone = []
    for namen, typen in (
            (("telephoneNumber", "phone"), ["VOICE"]),
            (("homePhone",), ["HOME", "VOICE"]),
            (("workPhone",), ["WORK", "VOICE"]),
            (("mobile", "cell", "cellphone"), ["CELL"]),
            (("facsimileTelephoneNumber", "fax"), ["FAX"]),
            (("pager", "pagerTelephoneNumber"), ["PAGER"])):
        for nummer in werte(*namen):
            telefone.append({"wert": nummer, "typen": typen})
    kontakt = {
        "uid": uid_wert, "nachname": nachname, "vorname": vorname,
        "firma": erster("o", "organization", "company"),
        "strasse": strasse, "plz": plz, "ort": ort,
        "email": emails[0] if emails else "", "emails": emails,
        "notiz": "\n".join(notizen), "foto": erster("jpegPhoto"), "geaendert": 0,
        "geburtstag": _claws_datum(geburtstag),
        "geburtstagJahrUnbekannt": bool(not erster("birthYear", "mozillaBirthYear") and
                                         erster("birthMonth", "mozillaBirthMonth")),
    }
    _telefone_setzen(kontakt, telefone)
    post_werte = werte("postalAddress", "homePostalAddress")
    separate_anschrift = bool(werte(
        "street", "streetAddress", "homeStreet", "mozillaHomeStreet",
        "postalCode", "zip", "homePostalCode", "mozillaHomePostalCode",
        "l", "locality", "city", "homeLocalityName", "mozillaHomeLocalityName"))
    anschriften = ([{"strasse": strasse, "plz": plz, "ort": ort,
                      "land": "", "typen": ["HOME"]}]
                   if separate_anschrift else [])
    for weiterer_post in post_werte:
        marke = "\x00MAGNOLIE-DOLLAR\x00"
        teile = [teil.replace(marke, "$").strip() for teil in
                 weiterer_post.replace("\\24", marke).split("$") if teil.strip()]
        if not teile:
            continue
        adr = {"strasse": teile[0], "plz": "", "ort": "", "land": "",
               "typen": ["HOME"]}
        for teil in teile[1:]:
            plz_ort = re.match(r"^(\d{4,6})\s+(.+)$", teil)
            if plz_ort:
                adr["plz"], adr["ort"] = plz_ort.groups()
            elif not adr["ort"] and not re.fullmatch(r"[A-Z]{2}", teil, re.I):
                adr["ort"] = teil
            elif not adr["land"]:
                adr["land"] = teil
        anschriften.append(adr)
    _anschriften_setzen(kontakt, anschriften)
    name = " ".join(teil for teil in (vorname, nachname) if teil).strip()
    if not name:
        name = anzeigename or kontakt["firma"]
    return kontakt, name, _claws_datum(geburtstag)


def ldif_lesen(text):
    """Liest ein LDIF-Adressbuch einschließlich Faltung und Base64-Werten."""
    if isinstance(text, bytes):
        if len(text) > 32 * 1024 * 1024:
            raise ValueError(_("The LDIF address book is larger than 32 megabytes."))
        text = text.decode("utf-8-sig", "replace")
    zeilen = []
    for zeile in str(text or "").replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if zeile.startswith(" ") and zeilen:
            zeilen[-1] += zeile[1:]
        else:
            zeilen.append(zeile)
    bloecke, block = [], []
    for zeile in zeilen + [""]:
        if zeile.strip():
            if not zeile.lstrip().startswith("#"):
                block.append(zeile)
        elif block:
            bloecke.append(block)
            block = []
    if len(bloecke) > 200000:
        raise ValueError(_("The LDIF address book contains too many people."))
    ergebnis = {"kontakte": [], "geburtstage": [], "uebersprungen": 0}
    for zeilenblock in bloecke:
        felder = {}
        unlesbar = False
        for zeile in zeilenblock:
            treffer = re.match(r"^([A-Za-z][A-Za-z0-9-]*)(?:;[^:]*)?(::?|:<)\s?(.*)$", zeile)
            if not treffer:
                unlesbar = True
                continue
            name, trenner, wert = treffer.groups()
            if name.casefold() in ("version", "dn", "objectclass") or name.casefold() == "changetype":
                continue
            if trenner == ":<":
                continue
            if trenner == "::":
                try:
                    dekodiert = base64.b64decode(wert, validate=True)
                    if name.casefold() == "jpegphoto" and len(dekodiert) <= 2700000:
                        wert = "data:image/jpeg;base64," + base64.b64encode(dekodiert).decode("ascii")
                    else:
                        wert = dekodiert.decode("utf-8")
                except (ValueError, UnicodeDecodeError):
                    unlesbar = True
                    continue
            felder.setdefault(name.casefold(), []).append(wert)
        kontakt, name, geburtstag = _claws_kontakt(felder)
        if not name and not kontakt["emails"]:
            if felder or unlesbar:
                ergebnis["uebersprungen"] += 1
            continue
        ergebnis["kontakte"].append(kontakt)
        if name and geburtstag:
            ergebnis["geburtstage"].append({"name": name, "datum": geburtstag})
        if unlesbar:
            ergebnis["uebersprungen"] += 1
    return ergebnis


def _ldif_dn_wert(wert):
    """Maskiert einen Attributwert fuer die Verwendung in einem LDAP-DN."""
    text = str(wert or "")
    aus = []
    for stelle, zeichen in enumerate(text):
        code = ord(zeichen)
        if code == 0:
            aus.append("\\00")
        elif (zeichen in ',+"\\<>;=' or
              (stelle == 0 and zeichen in (" ", "#")) or
              (stelle == len(text) - 1 and zeichen == " ")):
            aus.append("\\" + zeichen)
        elif code < 32 or code == 127:
            for oktett in zeichen.encode("utf-8"):
                aus.append("\\%02X" % oktett)
        else:
            aus.append(zeichen)
    return "".join(aus)


def _ldif_falten(zeile):
    """Faltet eine logische LDIF-Zeile auf hoechstens 76 UTF-8-Oktette."""
    stuecke, teil, breite, grenze = [], [], 0, 76
    for zeichen in zeile:
        laenge = len(zeichen.encode("utf-8"))
        if teil and breite + laenge > grenze:
            stuecke.append("".join(teil))
            teil, breite, grenze = [], 0, 75
        teil.append(zeichen)
        breite += laenge
    stuecke.append("".join(teil))
    return "\r\n ".join(stuecke)


def _ldif_zeile(name, wert, binaer=False):
    """Kodiert einen Wert ohne die LDIF-Struktur durch Benutzerdaten zu oeffnen."""
    if binaer:
        roh = bytes(wert)
        return _ldif_falten(name + ":: " + base64.b64encode(roh).decode("ascii"))
    text = str(wert or "")
    roh = text.encode("utf-8")
    base64_noetig = bool(
        text[:1] in (" ", ":", "<") or text[-1:] == " " or
        any(oktett == 0 or oktett in (10, 13) or oktett >= 128 for oktett in roh))
    if base64_noetig:
        return _ldif_falten(name + ":: " + base64.b64encode(roh).decode("ascii"))
    return _ldif_falten(name + ": " + text)


def _ldif_fingerabdruck(kontakt):
    teile = [str(kontakt.get(feld) or "") for feld in
             ("vorname", "nachname", "firma", "notiz", "geburtstag")]
    teile.extend(e["wert"] for e in _email_eintraege(kontakt))
    for telefon in _telefon_liste(kontakt):
        teile.extend((telefon["wert"], ",".join(sorted(_telefon_typen(
            telefon.get("typen"))))))
    for anschrift in _anschrift_liste(kontakt):
        teile.extend(str(anschrift.get(feld) or "") for feld in
                     ("strasse", "plz", "ort", "land"))
    return hashlib.sha256("\x1f".join(teile).encode("utf-8")).hexdigest()


def _ldif_uid(kontakt, verwendet):
    roh = str(kontakt.get("uid") or "").strip()
    fingerabdruck = _ldif_fingerabdruck(kontakt)
    if re.fullmatch(r"[A-Za-z0-9._-]{1,64}", roh):
        basis = roh
    elif roh:
        basis = "magnolie-" + hashlib.sha256(roh.encode("utf-8")).hexdigest()[:24]
    else:
        basis = "magnolie-" + fingerabdruck[:24]
    uid = basis
    if uid.casefold() in verwendet:
        uid = basis[:53] + "-" + fingerabdruck[:10]
        nummer = 2
        while uid.casefold() in verwendet:
            suffix = "-%d" % nummer
            uid = basis[:64 - len(suffix)] + suffix
            nummer += 1
    verwendet.add(uid.casefold())
    return uid


def _ldif_jpeg(foto):
    treffer = re.fullmatch(
        r"data:image/(?:jpeg|jpg|png|gif|webp);base64,([A-Za-z0-9+/=]+)",
        str(foto or "").strip(), re.I)
    if not treffer:
        return None
    try:
        roh = base64.b64decode(treffer.group(1), validate=True)
    except (ValueError, binascii.Error):
        return None
    if len(roh) > 2700000 or not roh.startswith(b"\xff\xd8\xff"):
        return None
    return roh


def _ldif_export(kontakte):
    eintraege, verwendet = [], set()
    uebersprungen = foto_verloren = 0
    for kontakt in kontakte:
        if not isinstance(kontakt, dict):
            uebersprungen += 1
            continue
        vorname = str(kontakt.get("vorname") or "").strip()
        nachname = str(kontakt.get("nachname") or "").strip()
        firma = str(kontakt.get("firma") or "").strip()
        emails = [eintrag["wert"] for eintrag in _email_eintraege(kontakt)]
        cn = " ".join(teil for teil in (vorname, nachname) if teil) or firma
        if not cn and emails:
            cn = emails[0]
        if not cn:
            uebersprungen += 1
            continue
        uid = _ldif_uid(kontakt, verwendet)
        zeilen = [
            _ldif_zeile("dn", "uid=" + _ldif_dn_wert(uid)),
            _ldif_zeile("objectClass", "top"),
            _ldif_zeile("objectClass", "person"),
            _ldif_zeile("objectClass", "organizationalPerson"),
            _ldif_zeile("objectClass", "inetOrgPerson"),
            _ldif_zeile("uid", uid),
            _ldif_zeile("cn", cn),
        ]
        if vorname:
            zeilen.append(_ldif_zeile("givenName", vorname))
        zeilen.append(_ldif_zeile("sn", nachname or firma or cn))
        zeilen.extend(_ldif_zeile("mail", email) for email in emails)
        for telefon in _telefon_liste(kontakt):
            typen = set(_telefon_typen(telefon.get("typen")))
            if "FAX" in typen:
                attribut = "facsimileTelephoneNumber"
            elif "PAGER" in typen:
                attribut = "pager"
            elif typen & {"CELL", "MOBILE"}:
                attribut = "mobile"
            elif "HOME" in typen:
                attribut = "homePhone"
            elif "WORK" in typen:
                attribut = "workPhone"
            else:
                attribut = "telephoneNumber"
            zeilen.append(_ldif_zeile(attribut, telefon["wert"]))
        for anschrift in _anschrift_liste(kontakt):
            teile = [str(anschrift.get("strasse") or "").strip(),
                     " ".join(teil for teil in
                              (str(anschrift.get("plz") or "").strip(),
                               str(anschrift.get("ort") or "").strip()) if teil),
                     str(anschrift.get("land") or "").strip()]
            post = "$".join(re.sub(r"[\r\n\x00]+", " ", teil).replace("$", "\\24")
                            for teil in teile if teil)
            if post:
                zeilen.append(_ldif_zeile("postalAddress", post))
        if firma:
            zeilen.append(_ldif_zeile("o", firma))
        if kontakt.get("notiz"):
            zeilen.append(_ldif_zeile("description", kontakt["notiz"]))
        geburtstag = str(kontakt.get("geburtstag") or "")
        if geburtstag and not kontakt.get("geburtstagJahrUnbekannt"):
            try:
                datetime.strptime(geburtstag, "%Y-%m-%d")
                zeilen.append(_ldif_zeile("dateOfBirth", geburtstag))
            except ValueError:
                pass
        if kontakt.get("foto"):
            jpeg = _ldif_jpeg(kontakt["foto"])
            if jpeg is None:
                foto_verloren += 1
            else:
                zeilen.append(_ldif_zeile("jpegPhoto", jpeg, binaer=True))
        eintraege.append("\r\n".join(zeilen))
    inhalt = "version: 1\r\n"
    if eintraege:
        inhalt += "\r\n" + "\r\n\r\n".join(eintraege) + "\r\n"
    return inhalt, uebersprungen, foto_verloren


def ldif_schreiben(kontakte):
    return _ldif_export(kontakte)[0]


def claws_xml_lesen(roh):
    """Liest das native addrbook-*.xml von Claws Mail ohne externe Entitäten."""
    if isinstance(roh, str):
        roh = roh.encode("utf-8")
    if len(roh or b"") > 32 * 1024 * 1024:
        raise ValueError(_("The Claws Mail address book is larger than 32 megabytes."))
    if b"<!DOCTYPE" in (roh or b"").upper():
        raise ValueError(_("DOCTYPE is not allowed in a Claws Mail address book."))
    wurzel = ET.fromstring(roh or b"")
    if wurzel.tag != "address-book":
        raise ValueError(_("No Claws Mail address book was detected."))
    ergebnis = {"kontakte": [], "geburtstage": [], "uebersprungen": 0}
    personen = wurzel.findall("./person")
    if len(personen) > 200000:
        raise ValueError(_("The Claws Mail address book contains too many people."))
    for person in personen:
        felder = {
            "first-name": [person.get("first-name") or ""],
            "last-name": [person.get("last-name") or ""],
            "cn": [person.get("cn") or ""],
            "uid": [person.get("uid") or ""],
        }
        bemerkungen = []
        for adresse in person.findall("./address-list/address"):
            felder.setdefault("mail", []).append(adresse.get("email") or "")
            if adresse.get("remarks"):
                bemerkungen.append(adresse.get("remarks"))
        for attribut in person.findall("./attribute-list/attribute"):
            name = (attribut.get("name") or "").strip().casefold()
            if name:
                felder.setdefault(name, []).append(attribut.text or "")
        if bemerkungen:
            felder.setdefault("remarks", []).extend(bemerkungen)
        kontakt, name, geburtstag = _claws_kontakt(felder)
        if not name and not kontakt["emails"]:
            ergebnis["uebersprungen"] += 1
            continue
        ergebnis["kontakte"].append(kontakt)
        if name and geburtstag:
            ergebnis["geburtstage"].append({"name": name, "datum": geburtstag})
    return ergebnis


def _kontakt_name_schluessel(kontakt):
    nach = kanonischer_text(kontakt.get("nachname"))
    vor = kanonischer_text(kontakt.get("vorname"))
    if nach or vor:
        return ("person", nach, vor)
    firma = kanonischer_text(kontakt.get("firma"))
    return ("firma", firma)


def _kontakt_telefone(kontakt):
    return {schluessel for schluessel in
            (_telefon_schluessel(eintrag["wert"]) for eintrag in _telefon_liste(kontakt))
            if schluessel}


def _kontakt_sparsam(kontakt):
    return (not any(str(kontakt.get(feld) or "").strip() for feld in
                    ("firma", "strasse", "plz", "ort", "notiz", "foto"))
            and len(_email_liste(kontakt)) <= 1 and len(_telefon_liste(kontakt)) <= 1)


def kontakte_vor_sync_zuordnen(lokal, entfernt):
    """Ordnet eine eindeutige lokale Dublette dem vorhandenen Online-Kontakt zu."""
    vergeben = {obj.get("uid") for obj in lokal if obj.get("sync")}
    for obj in lokal:
        uid = obj.get("uid")
        if obj.get("sync") or (uid and uid in entfernt):
            continue
        mails = {wert.casefold() for wert in _email_liste(obj)}
        telefone = _kontakt_telefone(obj)
        name = _kontakt_name_schluessel(obj)
        kandidaten = []
        for fern_uid, fern in entfernt.items():
            if fern_uid in vergeben:
                continue
            fern_mails = {wert.casefold() for wert in _email_liste(fern)}
            stark = bool(mails & fern_mails) or bool(telefone & _kontakt_telefone(fern))
            sparsam = (_kontakt_sparsam(obj) or _kontakt_sparsam(fern)) and name == _kontakt_name_schluessel(fern)
            if stark or sparsam:
                kandidaten.append((fern_uid, fern))
        if len(kandidaten) != 1:
            continue
        fern_uid, fern = kandidaten[0]
        obj["uid"] = fern_uid
        vergeben.add(fern_uid)
        for feld in KONTAKT_FELDER:
            if feld in ("email", "emails", "telefon", "mobil", "telefone",
                        "strasse", "plz", "ort", "anschriften", "sozialeMedien"):
                continue
            if not obj.get(feld) and fern.get(feld):
                obj[feld] = fern[feld]
        email_eintraege = _email_eintraege_vereinigen(obj, fern)
        emails = [eintrag["wert"] for eintrag in email_eintraege]
        obj["email"] = emails[0] if emails else ""
        obj["emails"] = emails
        obj["emailEintraege"] = email_eintraege
        _telefone_setzen(obj, _telefone_vereinigen(obj, fern))
        _anschriften_setzen(obj, _anschriften_vereinigen(obj, fern))
        _kontaktpersonen_setzen(obj, _kontaktpersonen_vereinigen(obj, fern))
        obj["sozialeMedien"] = _soziale_medien_vereinigen(obj, fern)
        for feld in ("vcardRoundtrip", "vcardParameter"):
            if feld in fern:
                obj[feld] = fern[feld]
    return lokal


def vcf_lesen(text, lokale_dateien=False):
    """Liest vCard-Dateien (2.1 / 3.0 / 4.0, tolerant)."""
    ergebnis = {"kontakte": [], "geburtstage": [], "uebersprungen": 0}
    for karte in _vcard_karten(text):
        n_teile, fn, firma, emails, notiz, bday, uid_wert = [], "", "", [], "", "", ""
        bday_unbekannt = False
        email_eintraege = []
        kontaktperson_name = kontaktperson_telefon = kontaktperson_status = ""
        kontaktpersonen = []
        soziale_medien = []
        foto = ""
        strasse = ort = plz = ""
        telefone = []
        anschriften = []
        geaendert = 0
        gruppen_label = {}
        vcard_parameter = {"TEL": [], "EMAIL": [], "ADR": []}
        vcard_roundtrip = []
        for label_zeile in karte:
            label_zerlegt = _prop_zerlegen(label_zeile)
            gruppe = _prop_gruppe(label_zeile)
            if label_zerlegt and gruppe and label_zerlegt[0] == "X-ABLABEL":
                gruppen_label[gruppe.casefold()] = _kontakt_label(
                    _ical_unescape(_vcard_wert(label_zerlegt[2], label_zerlegt[1])))
        for zeile in karte:
            zerlegt = _prop_zerlegen(zeile)
            if not zerlegt:
                continue
            name, params, wert = zerlegt
            wert = _vcard_wert(wert, params)
            if name == "N":
                n_teile = [_ical_unescape(t) for t in _semikolon_teile(wert)]
            elif name == "FN" and not fn:
                fn = _ical_unescape(wert).strip()
            elif name == "ORG" and not firma:
                firma = _ical_unescape(_semikolon_teile(wert)[0]).strip()
            elif name == "EMAIL":
                adresse = _email_adresse(_ical_unescape(wert))
                if adresse and adresse.lower() not in {
                        eintrag.lower() for eintrag in emails}:
                    emails.append(adresse)
                    email_eintraege.append({
                        "wert": adresse, "typen": sorted(_typen_von(params)),
                        "vcardParameter": _vcard_restparameter(params),
                        "label": gruppen_label.get(
                            _prop_gruppe(zeile).casefold(), "")})
            elif name == "TEL":
                nummer = re.sub(r"^tel:", "", _ical_unescape(wert).strip(), flags=re.I)
                if not nummer:
                    continue
                label = gruppen_label.get(_prop_gruppe(zeile).casefold(), "")
                telefone.append({"wert": nummer,
                                  "typen": _telefon_typen_aus_label(
                                      _typen_von(params), label),
                                  "vcardParameter": _vcard_restparameter(params),
                                  "label": label})
            elif name == "ADR":
                teile = [_ical_unescape(t) for t in _semikolon_teile(wert)]
                while len(teile) < 7:
                    teile.append("")
                anschriften.append({"strasse": teile[2].strip(),
                                    "ort": teile[3].strip(), "plz": teile[5].strip(),
                                    "land": teile[6].strip(),
                                    "typen": sorted(_typen_von(params)),
                                    "vcardParameter": _vcard_restparameter(params),
                                    "label": gruppen_label.get(
                                        _prop_gruppe(zeile).casefold(), "")})
            elif name == "NOTE" and not notiz:
                notiz = _ical_unescape(wert)
            elif name == "PHOTO" and not foto:
                foto = _vcard_foto(wert, params, lokale_dateien)
            elif name == "BDAY" and not bday:
                bday = _bday_datum(wert)
                bday_unbekannt = str(wert).strip().startswith("--")
            elif name == "UID" and not uid_wert:
                uid_wert = wert.strip()
            elif name == "REV" and not geaendert:
                geaendert = _stempel_zu_ms(wert)
            elif name == "X-MAGNOLIE-KONTAKTPERSON-NAME":
                kontaktperson_name = _ical_unescape(wert).strip()
            elif name == "X-MAGNOLIE-KONTAKTPERSON-TELEFON":
                kontaktperson_telefon = _ical_unescape(wert).strip()
            elif name == "X-MAGNOLIE-KONTAKTPERSON-STATUS":
                kontaktperson_status = _ical_unescape(wert).strip()
            elif name == "X-MAGNOLIE-NOTFALLKONTAKT":
                try:
                    person = json.loads(_ical_unescape(wert))
                    if isinstance(person, dict):
                        kontaktpersonen.append(person)
                except (TypeError, ValueError):
                    pass
            elif name == "X-MAGNOLIE-SOZIALES-MEDIUM":
                try:
                    eintrag = json.loads(_ical_unescape(wert))
                    if isinstance(eintrag, dict):
                        soziale_medien.append(eintrag)
                except (TypeError, ValueError):
                    pass
            elif (name not in ("VERSION", "X-ABLABEL") and len(zeile) <= 65536 and
                  len(vcard_roundtrip) < 256):
                vcard_roundtrip.append(zeile)
        nachname = (n_teile[0] if len(n_teile) > 0 else "").strip()
        vorname = (n_teile[1] if len(n_teile) > 1 else "").strip()
        if not nachname and not vorname and fn:
            worte = fn.split()
            if len(worte) == 1:
                nachname = worte[0]
            else:
                nachname = worte[-1]
                vorname = " ".join(worte[:-1])
        if not (nachname or vorname or firma):
            ergebnis["uebersprungen"] += 1
            continue
        kontakt = {
            "nachname": nachname, "vorname": vorname, "firma": firma,
            "strasse": strasse, "plz": plz, "ort": ort,
            "email": emails[0] if emails else "", "emails": emails,
            "emailEintraege": _email_eintraege({
                "emailEintraege": email_eintraege}),
            "notiz": notiz,
            "foto": foto, "uid": uid_wert, "geaendert": geaendert,
            "geburtstag": bday,
            "geburtstagJahrUnbekannt": bday_unbekannt,
            "kontaktpersonName": kontaktperson_name,
            "kontaktpersonTelefon": kontaktperson_telefon,
            "kontaktpersonStatus": kontaktperson_status,
            "kontaktpersonen": kontaktpersonen,
            "vcardRoundtrip": vcard_roundtrip,
            "vcardParameter": vcard_parameter,
            "sozialeMedien": _soziale_medien_liste(
                {"sozialeMedien": soziale_medien})}
        _telefone_setzen(kontakt, telefone)
        _anschriften_setzen(kontakt, anschriften)
        _kontaktpersonen_setzen(kontakt, _kontaktpersonen_liste(kontakt))
        ergebnis["kontakte"].append(kontakt)
        if bday:
            anzeigename = fn or (" ".join(x for x in (vorname, nachname) if x)) or firma
            ergebnis["geburtstage"].append({"name": anzeigename, "datum": bday})
    return ergebnis


def _vcard_escape(wert):
    return (str(wert or "")
            .replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,")
            .replace("\r\n", "\n").replace("\n", "\\n"))


def vcard_text(k):
    zeilen = ["BEGIN:VCARD", "VERSION:3.0",
              "N:%s;%s;;;" % (_vcard_escape(k.get("nachname")), _vcard_escape(k.get("vorname")))]
    voller_name = (" ".join(x for x in (k.get("vorname"), k.get("nachname")) if x)
                   or k.get("firma") or "").strip()
    zeilen.append("FN:" + _vcard_escape(voller_name or _("(unnamed)")))
    if k.get("firma"):
        zeilen.append("ORG:" + _vcard_escape(k["firma"]))
    gruppe_nummer = 0
    for telefon_index, telefon in enumerate(_telefon_liste(k)):
        typen = _telefon_typen(telefon.get("typen"))
        parameter = ";TYPE=" + ",".join(typen) if typen else ""
        parameter += _vcard_parameter_text(telefon, k, "TEL", telefon_index)
        label = ("Privat" if telefon.get("rolle") == "private" else
                 _kontakt_label(telefon.get("label")))
        gruppe_nummer += 1 if label else 0
        gruppe = "item%d." % gruppe_nummer if label else ""
        zeilen.append("%sTEL%s:%s" % (gruppe, parameter,
                                      _vcard_escape(telefon["wert"])))
        if label:
            zeilen.append("%sX-ABLabel:%s" % (gruppe, _vcard_escape(label)))
    for email_index, email in enumerate(_email_eintraege(k)):
        typen = _telefon_typen(email.get("typen"))
        if "INTERNET" not in typen:
            typen.append("INTERNET")
        parameter = ";TYPE=" + ",".join(typen)
        parameter += _vcard_parameter_text(email, k, "EMAIL", email_index)
        label = ("Privat" if email.get("rolle") == "private" else
                 _kontakt_label(email.get("label")))
        gruppe_nummer += 1 if label else 0
        gruppe = "item%d." % gruppe_nummer if label else ""
        zeilen.append("%sEMAIL%s:%s" % (
            gruppe, parameter, _vcard_escape(email["wert"])))
        if label:
            zeilen.append("%sX-ABLabel:%s" % (gruppe, _vcard_escape(label)))
    for anschrift_index, anschrift in enumerate(_anschrift_liste(k)):
        typen = _telefon_typen(anschrift.get("typen"))
        if "X-HEAD-OFFICE" in typen:
            typen.append("X-HAUPTSITZ")
        if "X-SECONDARY-OFFICE" in typen:
            typen.append("X-ZWEITSITZ")
        parameter = ";TYPE=" + ",".join(typen) if typen else ""
        parameter += _vcard_parameter_text(anschrift, k, "ADR", anschrift_index)
        label = _kontakt_label(anschrift.get("label"))
        gruppe_nummer += 1 if label else 0
        gruppe = "item%d." % gruppe_nummer if label else ""
        zeilen.append("%sADR%s:;;%s;%s;;%s;%s" % (
            gruppe, parameter, _vcard_escape(anschrift.get("strasse")),
            _vcard_escape(anschrift.get("ort")), _vcard_escape(anschrift.get("plz")),
            _vcard_escape(anschrift.get("land"))))
        if label:
            zeilen.append("%sX-ABLabel:%s" % (gruppe, _vcard_escape(label)))
    if k.get("notiz"):
        zeilen.append("NOTE:" + _vcard_escape(k["notiz"]))
    if k.get("geburtstag"):
        geburtstag = str(k["geburtstag"])
        datetime.strptime(geburtstag, "%Y-%m-%d")
        zeilen.append("BDAY:" + (("--" + geburtstag[5:]) if
                                  k.get("geburtstagJahrUnbekannt") else geburtstag))
    for feld, name in (("kontaktpersonName", "X-MAGNOLIE-KONTAKTPERSON-NAME"),
                       ("kontaktpersonTelefon", "X-MAGNOLIE-KONTAKTPERSON-TELEFON"),
                       ("kontaktpersonStatus", "X-MAGNOLIE-KONTAKTPERSON-STATUS")):
        if k.get(feld):
            zeilen.append(name + ":" + _vcard_escape(k[feld]))
    for person in _kontaktpersonen_liste(k):
        zeilen.append("X-MAGNOLIE-NOTFALLKONTAKT:" + _vcard_escape(
            json.dumps(person, ensure_ascii=False, separators=(",", ":"))))
    for eintrag in _soziale_medien_liste(k):
        draht = dict(eintrag)
        draht["dienstId"] = eintrag["dienst"]
        draht["dienst"] = "telefon" if eintrag["dienst"] == "phone" else eintrag["dienst"]
        if eintrag.get("aktionArt"):
            draht["aktionArtId"] = eintrag["aktionArt"]
            draht["aktionArt"] = {"website": "webseite", "program": "programm"}.get(
                eintrag["aktionArt"], eintrag["aktionArt"])
        zeilen.append("X-MAGNOLIE-SOZIALES-MEDIUM:" + _vcard_escape(
            json.dumps(draht, ensure_ascii=False, separators=(",", ":"))))
    foto = _vcard_foto(k.get("foto"), {})
    if foto:
        treffer = re.match(r"^data:image/([^;]+);base64,(.+)$", foto, re.I)
        if treffer:
            art = "JPEG" if treffer.group(1).lower() in ("jpg", "jpeg") \
                else treffer.group(1).upper()
            zeilen.append("PHOTO;ENCODING=b;TYPE=%s:%s"
                          % (art, treffer.group(2)))
    bekannte = {"BEGIN", "END", "VERSION", "N", "FN", "ORG", "TEL", "EMAIL",
                "ADR", "NOTE", "PHOTO", "BDAY", "UID", "REV", "X-ABLABEL",
                "X-MAGNOLIE-KONTAKTPERSON-NAME",
                "X-MAGNOLIE-KONTAKTPERSON-TELEFON",
                "X-MAGNOLIE-KONTAKTPERSON-STATUS", "X-MAGNOLIE-NOTFALLKONTAKT",
                "X-MAGNOLIE-SOZIALES-MEDIUM"}
    for roh in k.get("vcardRoundtrip") or []:
        zerlegt = _prop_zerlegen(roh) if isinstance(roh, str) and len(roh) <= 65536 else None
        if zerlegt and zerlegt[0] not in bekannte:
            zeilen.append(roh)
    zeilen.append("UID:" + (k.get("uid") or _neue_uid()))
    zeilen.append("REV:" + _utc_stempel(k.get("geaendert") or None))
    zeilen.append("END:VCARD")
    return "\r\n".join(_falte(z) for z in zeilen) + "\r\n"


def vcf_schreiben(kontakte):
    return "".join(vcard_text(k) for k in kontakte)


# ---------------------------------------------------------------------------
# Lotus-Organizer-CSV – lesen und schreiben
# ---------------------------------------------------------------------------

LOTUS_SPALTEN = ["VERTRAULICH", "KATEGORIEN", "ANFANGSDATUMZEIT", "ENDDATUMZEIT",
                 "BESCHREIBUNG", "KOSTENSTELLENCODE", "KUNDENNUMMER",
                 "VORLAEUFIGZUSAGEN"]


def _spaltenname_norm(s):
    s = (s or "").strip().upper()
    for a, b in (("Ä", "AE"), ("Ö", "OE"), ("Ü", "UE"), ("ß", "SS")):
        s = s.replace(a, b)
    return re.sub(r"[^A-Z]", "", s)


def _datumzeit_lesen(s):
    s = str(s or "").replace("\xa0", " ").strip().strip('"')
    if not s:
        return "", ""
    s = re.sub(r"\s+Uhr\s*$", "", s, flags=re.I)
    s = re.sub(r"^[A-Za-zÄÖÜäöüß]+,\s*", "", s)
    hat_ampm = bool(re.search(r"\b[AP]M\b", s, re.I))
    monate = {
        "januar": 1, "februar": 2, "märz": 3, "maerz": 3, "april": 4,
        "mai": 5, "juni": 6, "juli": 7, "august": 8, "september": 9,
        "oktober": 10, "november": 11, "dezember": 12,
        "jan": 1, "feb": 2, "mär": 3, "mrz": 3, "apr": 4, "jun": 6,
        "jul": 7, "aug": 8, "sep": 9, "okt": 10, "nov": 11, "dez": 12,
    }
    monat_muster = "|".join(sorted(map(re.escape, monate), key=len, reverse=True))
    treffer = re.match(
        r"^(\d{1,2})\.?\s+(%s)\.?\s+(\d{2,4})(.*)$" % monat_muster,
        s, re.I)
    if treffer:
        jahr = treffer.group(3)
        s = "%s.%02d.%s%s" % (treffer.group(1),
                                monate[treffer.group(2).lower()], jahr,
                                treffer.group(4))
    # Einige Exporte schreiben Uhrzeiten mit Punkten oder trennen Datum und
    # Uhrzeit durch ein Komma.
    s = re.sub(r"(?<=\d),\s+(?=\d{1,2}[:.]\d{2})", " ", s)
    s = re.sub(r"(\s\d{1,2})\.(\d{2})(?:\.(\d{2}))?(\s*(?:AM|PM))?$",
               lambda m: m.group(1) + ":" + m.group(2) +
               ((":" + m.group(3)) if m.group(3) else "") + (m.group(4) or ""),
               s, flags=re.I)
    def _zeit_24(treffer):
        stunde = int(treffer.group(1)) % 12
        if treffer.group(4).upper() == "PM":
            stunde += 12
        return "%02d:%s%s" % (
            stunde, treffer.group(2),
            (":" + treffer.group(3)) if treffer.group(3) else "")
    # %p richtet sich nach der Systemsprache und versteht in einer deutschen
    # Sitzung oft weder AM noch PM. Vorher in eine 24-Stunden-Zeit umwandeln.
    s = re.sub(r"\b(\d{1,2}):(\d{2})(?::(\d{2}))?\s*([AP]M)\b",
               _zeit_24, s, flags=re.I)
    s = re.sub(r"(\d{1,2}:\d{2}:\d{2})\.\d+", r"\1", s)

    slash = re.match(r"^(\d{1,2})/(\d{1,2})/(\d{2,4})(?:\s|$)", s)
    if slash and int(slash.group(1)) <= 12 and int(slash.group(2)) <= 12 and not hat_ampm:
        # Ohne Sprach-/AM-PM-Kontext sind Monat und Tag nicht unterscheidbar.
        return "", ""

    # Tabellenprogramme geben Datumswerte mitunter als Excel-Seriennummern
    # weiter. Lotus-Dateien aus den letzten Jahrzehnten liegen sicher im hier
    # begrenzten Bereich.
    if re.fullmatch(r"\d{4,5}(?:[.,]\d+)?", s):
        try:
            zahl = float(s.replace(",", "."))
            if 1000 <= zahl <= 100000:
                dt = datetime(1899, 12, 30) + timedelta(days=zahl)
                zeit = dt.strftime("%H:%M") if zahl % 1 else ""
                return dt.strftime("%Y-%m-%d"), zeit
        except (OverflowError, ValueError):
            pass

    formen = (("%m/%d/%Y %H:%M:%S", True), ("%m/%d/%Y %H:%M", True),
              ("%m/%d/%y %H:%M", True)) if slash and hat_ampm else ()
    formen += (
        ("%d.%m.%Y %H:%M:%S", True), ("%d.%m.%Y %H:%M", True),
        ("%d.%m.%y %H:%M:%S", True), ("%d.%m.%y %H:%M", True),
        ("%d.%m.%Y %I:%M:%S %p", True), ("%d.%m.%Y %I:%M %p", True),
        ("%d.%m.%Y", False), ("%d.%m.%y", False),
        ("%d/%m/%Y %H:%M:%S", True), ("%d/%m/%Y %H:%M", True),
        ("%d/%m/%y %H:%M", True), ("%d/%m/%Y", False),
        ("%d/%m/%Y %I:%M:%S %p", True), ("%d/%m/%Y %I:%M %p", True),
        ("%d/%m/%y %I:%M %p", True),
        ("%d-%m-%Y %H:%M", True), ("%d-%m-%Y", False),
        ("%Y-%m-%d %H:%M:%S", True), ("%Y-%m-%d %H:%M", True),
        ("%Y-%m-%dT%H:%M:%S", True), ("%Y-%m-%dT%H:%M", True),
        ("%Y-%m-%d", False),
        ("%m/%d/%Y %I:%M:%S %p", True), ("%m/%d/%Y %I:%M %p", True),
        ("%m/%d/%y %I:%M %p", True), ("%m/%d/%Y", False),
    )
    for form, mit_zeit in formen:
        try:
            dt = datetime.strptime(s, form)
            return dt.strftime("%Y-%m-%d"), (dt.strftime("%H:%M") if mit_zeit else "")
        except ValueError:
            continue
    return "", ""


def _ist_ja(s):
    return (s or "").strip().lower() in ("ja", "j", "yes", "y", "true", "wahr", "1", "x")


def _lotus_teile(beschreibung):
    """Lotus führt Betreff und Beschreibung in einem Feld: Die erste Zeile
    ist der Betreff, alles Weitere gehört zur Notiz."""
    text = (beschreibung or "").replace("\r\n", "\n").replace("\r", "\n")
    erste, _, rest = text.partition("\n")
    return erste.strip(), rest.strip("\n")


def _lotus_titel(beschreibung):
    return _lotus_teile(beschreibung)[0] or _("Untitled")


def _lotus_notiz(beschreibung):
    return _lotus_teile(beschreibung)[1]


def _lotus_beschreibung(termin):
    """Setzt Betreff und Notiz wieder zu einem Lotus-Feld zusammen."""
    titel = (termin.get("titel") or "").strip()
    notiz = (termin.get("notiz") or "").strip()
    return titel + ("\n" + notiz if notiz else "")


# Weitere Bereiche des Lotus Organizers. Die Spaltennamen unterscheiden
# sich je nach Fassung und Sprache, darum wird großzügig zugeordnet: Es
# genügt, wenn der Name einen der genannten Bestandteile enthält.
LOTUS_ADRESS_FELDER = {
