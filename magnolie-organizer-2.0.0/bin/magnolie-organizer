_DEBUG_LOGGER = None
_DEBUG_PFAD = ""


class _DebugFormat(logging.Formatter):
    def formatTime(self, record, datefmt=None):
        return datetime.fromtimestamp(record.created).astimezone().isoformat(
            timespec="milliseconds")


def debug_pfad():
    basis = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(basis, PROGRAMM_NAME, "debug.log")


def _debug_wert(wert):
    text = str(wert)
    zuhause = os.path.expanduser("~")
    if zuhause and zuhause != "/":
        text = text.replace(zuhause, "~")
    return text.replace("\n", "\\n")


def debug_notiz(ereignis, **felder):
    if _DEBUG_LOGGER is None:
        return
    teile = [str(ereignis)]
    for name in sorted(felder):
        teile.append("%s=%s" % (name, json.dumps(_debug_wert(felder[name]),
                                             ensure_ascii=False)))
    _DEBUG_LOGGER.info(" ".join(teile))


def debug_ausnahme(ereignis, **felder):
    if _DEBUG_LOGGER is None:
        return
    debug_notiz(ereignis, **felder)
    _DEBUG_LOGGER.exception("%s.traceback" % ereignis)


def debug_einrichten():
    global _DEBUG_LOGGER, _DEBUG_PFAD
    if _DEBUG_LOGGER is not None:
        return _DEBUG_PFAD
    ziel = debug_pfad()
    try:
        ordner = os.path.dirname(ziel)
        os.makedirs(ordner, mode=0o700, exist_ok=True)
        os.chmod(ordner, 0o700)
        handler = RotatingFileHandler(ziel, maxBytes=2 * 1024 * 1024,
                                      backupCount=2, encoding="utf-8")
        os.chmod(ziel, 0o600)
        handler.setFormatter(_DebugFormat(
            "%(asctime)s pid=%(process)d thread=%(threadName)s %(levelname)s %(message)s"))
        logger = logging.getLogger("magnolie-organizer.debug")
        logger.handlers.clear()
        logger.setLevel(logging.INFO)
        logger.propagate = False
        logger.addHandler(handler)
        _DEBUG_LOGGER, _DEBUG_PFAD = logger, ziel

        vorher = sys.excepthook
        def haupt_ausnahme(art, wert, spur):
            logger.error("unhandled.main", exc_info=(art, wert, spur))
            vorher(art, wert, spur)
        sys.excepthook = haupt_ausnahme
        if hasattr(threading, "excepthook"):
            thread_vorher = threading.excepthook
            def thread_ausnahme(argumente):
                logger.error("unhandled.thread name=%s", argumente.thread.name,
                             exc_info=(argumente.exc_type, argumente.exc_value,
                                       argumente.exc_traceback))
                thread_vorher(argumente)
            threading.excepthook = thread_ausnahme
        debug_notiz("debug.enabled", version=PROGRAMM_FASSUNG)
        debug_notiz("imports", gtk_ok=GTK_OK,
                     gtk_error=_GTK_IMPORT_FEHLER or "none",
                     webkit_ok=WEBKIT_OK, webkit_error=WEBKIT_FEHLER or "none",
                    appindicator="available" if AppIndicator is not None else "missing",
                    appindicator_errors="; ".join(_INDIKATOR_IMPORT_FEHLER) or "none",
                    xapp="available" if XApp is not None else "missing",
                    xapp_error=_XAPP_IMPORT_FEHLER or "none")
        return ziel
    except OSError as fehler:
        sys.stderr.write(_("Debug logging could not be started: %s") % fehler + "\n")
        return ""

JT_TYPEN = {
    "birthday": ("Birthday", "Geburtstag"),
    "death-anniversary": ("Death anniversary", "Todestag"),
    "wedding-anniversary": ("Wedding anniversary", "Hochzeitstag"),
    "partnership-anniversary": ("Partnership anniversary", "Partnerschaftstag"),
    "name-day": ("Name day", "Namenstag"),
    "baptism": ("Baptism", "Tauftag"),
    "first-communion": ("First Communion", "Kommunion"),
    "confirmation": ("Confirmation", "Konfirmation"),
    "catholic-confirmation": ("Catholic confirmation", "Firmung"),
    "anniversary": ("Anniversary", "Jubiläum"),
    "club-anniversary": ("Club anniversary", "Vereinsjubiläum"),
    "work-anniversary": ("Work anniversary", "Dienstjubiläum"),
    "founding-day": ("Founding day", "Gründungstag"),
    "memorial-day": ("Memorial day", "Gedenktag"),
    "other": ("Other", "Sonstiges"),
}


def kanonischer_text(wert):
    """Locale-unabhängiger Schlüssel für fachliche Textvergleiche."""
    text = unicodedata.normalize("NFKD", str(wert or "")).replace("ß", "ss")
    text = "".join(zeichen for zeichen in text
                   if not unicodedata.combining(zeichen)).lower()
    return " ".join(text.split())


def jahrestag_typ_id(wert):
    schluessel = kanonischer_text(wert)
    for typ_id, aliase in JT_TYPEN.items():
        if schluessel in {kanonischer_text(typ_id),
                          *(kanonischer_text(alias) for alias in aliase)}:
            return typ_id
    return ""


def jahrestag_typ_text(wert):
    typ_id = jahrestag_typ_id(wert)
    return _(JT_TYPEN[typ_id][0]) if typ_id else str(wert or "")


def wiederholung_art(wert):
    return {"keine": "none", "none": "none", "tag": "daily", "daily": "daily",
            "woche": "weekly",
            "weekly": "weekly", "monat": "monthly", "monthly": "monthly",
            "monthly_weekday": "monthly",
            "jahr": "yearly", "yearly": "yearly", "custom": "custom"}.get(
                str(wert or "").strip().lower(), "none")


def erinnerungs_art(wert):
    return {"meldung": "notification", "notification": "notification",
            "ton": "sound", "sound": "sound", "beides": "both",
            "both": "both"}.get(str(wert or "").strip().lower(), "both")

