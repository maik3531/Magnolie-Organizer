    "text": ["TEXT", "INHALT", "NOTIZ", "BESCHREIBUNG", "BODY"],
}


def _lotus_termin_zuordnung(kopf):
    """Ordnet auch allgemein benannte Kalender-CSV-Spalten zu."""
    mengen = {
        "anfang": {"ANFANGSDATUMZEIT", "STARTDATUMZEIT", "BEGINNDATUMZEIT",
                    "ANFANGSDATUM", "STARTDATUM", "BEGINNDATUM", "STARTDATE",
                    "DATUMZEIT", "DATUM", "DATE"},
        "anfangszeit": {"ANFANGSZEIT", "STARTZEIT", "BEGINNZEIT", "STARTTIME",
                         "UHRZEIT", "ZEIT", "TIME"},
        "ende": {"ENDDATUMZEIT", "ENDEDATUMZEIT", "ENDDATUM", "ENDEDATUM",
                 "ENDDATE", "END"},
        "endzeit": {"ENDZEIT", "ENDEZEIT", "ENDTIME"},
        "beschreibung": {"BESCHREIBUNG", "BETREFF", "TITEL", "TERMIN",
                          "SUBJECT", "SUMMARY", "DESCRIPTION", "ANLASS"},
        "kategorien": {"KATEGORIEN", "KATEGORIE", "CATEGORY", "CATEGORIES"},
        "vertraulich": {"VERTRAULICH", "PRIVAT", "CONFIDENTIAL", "PRIVATE"},
        "vorlaeufig": {"VORLAEUFIGZUSAGEN", "VORLAEUFIG", "TENTATIVE"},
        "kostenstelle": {"KOSTENSTELLENCODE", "KOSTENSTELLE", "COSTCENTER"},
        "kunde": {"KUNDENNUMMER", "KUNDE", "CUSTOMERNUMBER"},
    }
    zuordnung = {}
    for ziel, namen in mengen.items():
        for i, name in enumerate(kopf):
            if name in namen:
                zuordnung[ziel] = i
                break
    # Lange Lotus-Kopfzeilen tragen gelegentlich Zusätze in Klammern.
    for i, name in enumerate(kopf):
        if "anfang" not in zuordnung and name.startswith(("ANFANG", "START", "BEGINN")) \
                and ("DATUM" in name or "DATE" in name):
            zuordnung["anfang"] = i
        if "ende" not in zuordnung and name.startswith(("END", "ENDE")) \
                and ("DATUM" in name or "DATE" in name):
            zuordnung["ende"] = i
    return zuordnung


def _lotus_zuordnung(kopf, felder):
    """Ordnet die Spalten einer Kopfzeile den bekannten Feldern zu."""
    zuordnung = {}
    for i, name in enumerate(kopf):
        if not name:
            continue
        for ziel, muster in felder.items():
            if ziel in zuordnung:
                continue
            if any(teil in name for teil in muster):
                zuordnung[ziel] = i
                break
    return zuordnung


def lotus_art_erkennen(kopf):
    """Welcher Bereich des Lotus Organizers steckt in dieser Datei?"""
    zusammen = " ".join(kopf)
    if "ANFANGSDATUM" in zusammen or "VORLAEUFIGZUSAGEN" in zusammen:
        return "termine"
    termin_felder = _lotus_termin_zuordnung(kopf)
    if "anfang" in termin_felder and "beschreibung" in termin_felder:
        return "termine"
    if any("NACHNAME" in f or "ZUNAME" in f or "LASTNAME" in f or
           "FAMILYNAME" in f for f in kopf) or (
            any("FIRMA" in f or "COMPANY" in f for f in kopf) and
            any("ORT" in f or "CITY" in f or "TELEFON" in f or "PHONE" in f
                or "EMAIL" in f for f in kopf)):
        return "kontakte"
    if any("FAELLIG" in f for f in kopf) or (
            any("ERLEDIGT" in f for f in kopf) and
            any("PRIORITAET" in f or "BESCHREIBUNG" in f for f in kopf)):
        return "aufgaben"
    if any("JAHRESTAG" in f or "GEBURTSTAG" in f for f in kopf):
        return "jahrestage"
    # Eine schlichte Liste aus Anlass und Datum sind ebenfalls Jahrestage
    if (any(f == "DATUM" or f.startswith("DATUM") for f in kopf)
            and any("NAME" in f or "ANLASS" in f or "BEZEICHNUNG" in f
                    for f in kopf)):
        return "jahrestage"
    if any("TEXT" in f or "INHALT" in f for f in kopf):
        return "notizen"
    return "unbekannt"


def _lotus_ja(wert):
    roh = (wert or "").strip().upper()
    return (_ist_ja(wert) or roh in ("X", "WAHR", "TRUE", "COMPLETED",
                                     "COMPLETE", "ABGESCHLOSSEN", "FERTIG"))


def _lotus_kontakte(zeilen, kopf):
    zuordnung = _lotus_zuordnung(kopf, LOTUS_ADRESS_FELDER)
    if not zuordnung:
        return [], len(zeilen)
    kontakte, uebersprungen = [], 0
    for zeile in zeilen:
        def hol(feld, zeile=zeile):
            i = zuordnung.get(feld)
            return (zeile[i].strip() if i is not None and i < len(zeile) else "")
        eintrag = {ziel: hol(ziel) for ziel in LOTUS_ADRESS_FELDER}
        if not any(eintrag.values()):
            uebersprungen += 1
            continue
        telefone = []
        for i, spalte in enumerate(kopf):
            if i >= len(zeile) or not zeile[i].strip():
                continue
            if not any(wort in spalte for wort in
                       ("TELEFON", "PHONE", "MOBIL", "HANDY", "CELL",
                        "RUFNUMMER", "FESTNETZ", "FAX", "PAGER")):
                continue
            if any(wort in spalte for wort in ("MOBIL", "HANDY", "CELL", "FUNK")):
                typen = ["CELL"]
            elif "FAX" in spalte:
                typen = ["FAX"]
            elif "PAGER" in spalte:
                typen = ["PAGER"]
            elif any(wort in spalte for wort in ("GESCHAEFT", "ARBEIT", "WORK", "BUERO")):
                typen = ["WORK", "VOICE"]
            elif any(wort in spalte for wort in ("PRIVAT", "HOME")):
                typen = ["HOME", "VOICE"]
            else:
                typen = ["VOICE"]
            telefone.append({"wert": zeile[i].strip(), "typen": typen})
        _telefone_setzen(eintrag, _telefone_vereinigen(eintrag, {"telefone": telefone}))
        anschriften = _anschrift_liste(eintrag)
        nach_sitz = {"HOME": {"strasse": "", "plz": "", "ort": "", "land": ""},
                     "WORK": {"strasse": "", "plz": "", "ort": "", "land": ""}}
        for i, spalte in enumerate(kopf):
            if i >= len(zeile) or not zeile[i].strip():
                continue
            sitz = "HOME" if any(w in spalte for w in ("PRIVAT", "HOME")) else \
                "WORK" if any(w in spalte for w in ("GESCHAEFT", "ARBEIT", "WORK", "FIRMA")) else ""
            if not sitz:
                continue
            if any(w in spalte for w in ("STRASSE", "STREET", "ANSCHRIFT", "ADRESSE")):
                feld = "strasse"
            elif any(w in spalte for w in ("POSTLEITZAHL", "PLZ", "ZIP", "POSTALCODE")):
                feld = "plz"
            elif any(w in spalte for w in ("ORT", "STADT", "CITY")):
                feld = "ort"
            elif any(w in spalte for w in ("LAND", "COUNTRY")):
                feld = "land"
            else:
                continue
            nach_sitz[sitz][feld] = zeile[i].strip()
        for sitz, anschrift in nach_sitz.items():
            if any(anschrift.values()):
                anschriften.append(dict(anschrift, typen=[sitz]))
        _anschriften_setzen(eintrag, anschriften)
        kontakte.append(eintrag)
    return kontakte, uebersprungen


def _lotus_aufgaben(zeilen, kopf):
    zuordnung = _lotus_zuordnung(kopf, LOTUS_AUFGABEN_FELDER)
    if "titel" not in zuordnung:
        return [], len(zeilen)
    aufgaben, uebersprungen = [], 0
    for zeile in zeilen:
        def hol(feld, zeile=zeile):
            i = zuordnung.get(feld)
            return (zeile[i].strip() if i is not None and i < len(zeile) else "")
        titel = _lotus_titel(hol("titel"))
        if not _lotus_teile(hol("titel"))[0] and not hol("notiz"):
            uebersprungen += 1
            continue
        roh_prio = hol("prio").upper()
        prio = 2
        if roh_prio[:1] in ("1", "H") or "HOCH" in roh_prio:
            prio = 1
        elif roh_prio[:1] in ("3", "N") or "NIEDRIG" in roh_prio:
            prio = 3
        aufgaben.append({
            "titel": titel,
            "notiz": hol("notiz") or _lotus_notiz(hol("titel")),
            "faellig": _datumzeit_lesen(hol("faellig"))[0] or "",
            "prio": prio,
            "erledigt": _lotus_ja(hol("erledigt")),
        })
    return aufgaben, uebersprungen


def _lotus_jahrestage(zeilen, kopf):
    zuordnung = _lotus_zuordnung(kopf, LOTUS_JAHRESTAG_FELDER)
    if "datum" not in zuordnung:
        return [], len(zeilen)
    jahrestage, uebersprungen = [], 0
    for zeile in zeilen:
        def hol(feld, zeile=zeile):
            i = zuordnung.get(feld)
            return (zeile[i].strip() if i is not None and i < len(zeile) else "")
        datum = _datumzeit_lesen(hol("datum"))[0]
        name = hol("name")
        if not datum or not name:
            uebersprungen += 1
            continue
        typ_text = hol("typ").strip()[:80]
        roh_typ = typ_text.upper()
        typ = jahrestag_typ_id(typ_text) or typ_text or "other"
        if "GEBURT" in roh_typ or "BIRTH" in roh_typ:
            typ = "birthday"
        elif "TOD" in roh_typ or "DEATH" in roh_typ:
            typ = "death-anniversary"
        elif "HOCHZEIT" in roh_typ or "WEDDING" in roh_typ:
            typ = "wedding-anniversary"
        elif not roh_typ and any("GEBURTSTAG" in f for f in kopf):
            typ = "birthday"
        jahrestage.append({"name": name, "datum": datum, "typ": typ})
    return jahrestage, uebersprungen


def _lotus_notizen(zeilen, kopf):
    zuordnung = _lotus_zuordnung(kopf, LOTUS_NOTIZ_FELDER)
    if not zuordnung:
        return [], len(zeilen)
    notizen, uebersprungen = [], 0
    for zeile in zeilen:
        def hol(feld, zeile=zeile):
            i = zuordnung.get(feld)
            return (zeile[i].strip() if i is not None and i < len(zeile) else "")
        titel, text = hol("titel"), hol("text")
        if not titel and not text:
            uebersprungen += 1
            continue
        if not titel:
            titel = _lotus_titel(text)
        notizen.append({"titel": titel, "text": text or titel})
    return notizen, uebersprungen


def lotus_csv_lesen(rohbytes):
    """Liest eine CSV aus dem Lotus Organizer.

    Erkannt werden alle Bereiche: Termine, Adressen, Aufgaben, Jahrestage
    und Notizen. Welcher es ist, verrät die Kopfzeile."""
    if (not isinstance(rohbytes, (bytes, bytearray)) or b"\x00" in rohbytes or
            bytes(rohbytes).startswith(b"SQLite format 3\x00")):
        raise ValueError(_("The selected file is not a readable CSV file."))
    text = _text_dekodieren(rohbytes)
    if re.match(r"^sep\s*=\s*[,;\t|]\s*$", text.splitlines()[0] if text.splitlines()
                else "", re.I):
        text = "\n".join(text.splitlines()[1:])
    probe = text[:16384]
    try:
        trenner = csv.Sniffer().sniff(probe, delimiters=",;\t|").delimiter
    except csv.Error:
        erste = next((z for z in text.splitlines() if z.strip()), "")
        trenner = max((",", ";", "\t", "|"), key=erste.count)
    leser = csv.reader(io.StringIO(text), delimiter=trenner)
    zeilen = [z for z in leser if any((feld or "").strip() for feld in z)]
    ergebnis = {"termine": [], "uebersprungen": 0}
    if not zeilen:
        return ergebnis

    kopfzeile = [_spaltenname_norm(feld) for feld in zeilen[0]]
    art = lotus_art_erkennen(kopfzeile)
    if art in ("kontakte", "aufgaben", "jahrestage", "notizen"):
        leser_je_art = {"kontakte": _lotus_kontakte, "aufgaben": _lotus_aufgaben,
                        "jahrestage": _lotus_jahrestage, "notizen": _lotus_notizen}
        eintraege, uebersprungen = leser_je_art[art](zeilen[1:], kopfzeile)
        return {art: eintraege, "termine": [], "uebersprungen": uebersprungen,
                "lotusArt": art}

    kopf = [_spaltenname_norm(feld) for feld in zeilen[0]]
    zuordnung = _lotus_termin_zuordnung(kopf)
    hat_kopf = "anfang" in zuordnung and (
        "beschreibung" in zuordnung or art == "termine")
    if hat_kopf:
        zeilen = zeilen[1:]
    else:
        probezeilen = zeilen[:20]
        passende = sum(1 for zeile in probezeilen if len(zeile) >= 5 and
                       _datumzeit_lesen(zeile[2].strip())[0])
        if not probezeilen or passende * 2 < len(probezeilen):
            raise ValueError(_("The CSV columns were not recognized."))
        zuordnung = {
            "vertraulich": 0, "kategorien": 1, "anfang": 2, "ende": 3,
            "beschreibung": 4, "kostenstelle": 5, "kunde": 6,
            "vorlaeufig": 7,
        }

    def zelle(zeile, name):
        i = zuordnung.get(name)
        return zeile[i].strip() if i is not None and i < len(zeile) else ""

    mehrdeutig = 0
    for zeile in zeilen:
        anfang = zelle(zeile, "anfang")
        startzeit = zelle(zeile, "anfangszeit")
        datum, zeit = _datumzeit_lesen(
            anfang + ((" " + startzeit) if startzeit else ""))
        if not datum:
            slash = re.match(r"^(\d{1,2})/(\d{1,2})/(\d{2,4})(?:\s|$)", anfang)
            if slash and int(slash.group(1)) <= 12 and int(slash.group(2)) <= 12 \
                    and not re.search(r"\b[AP]M\b", anfang, re.I):
                mehrdeutig += 1
            ergebnis["uebersprungen"] += 1
            continue
        ende = zelle(zeile, "ende")
        endzeit = zelle(zeile, "endzeit")
        e_datum, e_zeit = _datumzeit_lesen(
            ende + ((" " + endzeit) if endzeit else ""))
        if not ende and endzeit:
            e_datum, e_zeit = _datumzeit_lesen(datum + " " + endzeit)
        ergebnis["termine"].append({
            "datum": datum,
            "endDatum": e_datum if e_datum and e_datum > datum else "",
            "zeit": zeit,
            "endZeit": e_zeit if (e_datum == datum and zeit and e_zeit
                                  and e_zeit != zeit) else (
                                      e_zeit if e_datum > datum and zeit else ""),
            "titel": _lotus_titel(zelle(zeile, "beschreibung")),
            "notiz": _lotus_notiz(zelle(zeile, "beschreibung")),
            "kategorien": zelle(zeile, "kategorien"),
            "vertraulich": _ist_ja(zelle(zeile, "vertraulich")),
            "vorlaeufig": _ist_ja(zelle(zeile, "vorlaeufig")),
            "kostenstelle": zelle(zeile, "kostenstelle"),
            "kunde": zelle(zeile, "kunde"),
            "uid": "", "geaendert": 0})
    if mehrdeutig:
        ergebnis["bericht"] = ("%d mehrdeutige US-/EU-Datumswerte wurden nicht "
                               "geraten und ausgelassen." % mehrdeutig)
    return ergebnis


def _datumzeit_schreiben(datum, zeit):
    if not datum:
        return ""
    jahr, monat, tag = datum.split("-")
    punktform = "%s.%s.%s" % (tag, monat, jahr)
    return punktform + " " + zeit if zeit else punktform


def lotus_csv_schreiben(termine):
    puffer = io.StringIO()
    schreiber = csv.writer(puffer, delimiter=",", quoting=csv.QUOTE_MINIMAL,
                           lineterminator="\r\n")
    schreiber.writerow(LOTUS_SPALTEN)
    for t in termine:
        anfang = _datumzeit_schreiben(t.get("datum", ""), t.get("zeit", ""))
        ende = _datumzeit_schreiben(t.get("endDatum") or t.get("datum", ""),
                                    t.get("endZeit", "") or t.get("zeit", ""))
        schreiber.writerow([
            "Ja" if t.get("vertraulich") else "Nein",
            t.get("kategorien", ""),
            anfang, ende,
            _lotus_beschreibung(t),
            t.get("kostenstelle", ""),
            t.get("kunde", ""),
            "Ja" if t.get("vorlaeufig") else "Nein"])
    return puffer.getvalue()


def import_rohdaten_lesen(art, roh, dateiname=""):
    """Liest Einzeldateien und begrenzte ZIP-/Takeout-Sammlungen ohne Entpacken."""
    def einzelne(daten, name, quellen_id=""):
        endung = os.path.splitext(name.lower())[1]
        if art == "ics":
            sicherer_name = _sicherer_ics_quellenpfad(name)
            return ics_lesen(_text_dekodieren(daten), sicherer_name,
                             quellen_id or sicherer_name)
        if art == "lotus" or art == "vcf" and endung == ".csv":
            return lotus_csv_lesen(daten)
        if art == "vcf":
            return vcf_lesen(_text_dekodieren(daten))
        if art == "claws":
            probe = daten.lstrip()[:200].lower()
            return claws_xml_lesen(daten) if probe.startswith(b"<?xml") or \
                b"<address-book" in probe else ldif_lesen(daten)
        raise ValueError(_("The file has an unsupported format."))

    puffer = io.BytesIO(bytes(roh))
    if not zipfile.is_zipfile(puffer):
        return einzelne(bytes(roh), dateiname)
    erlaubte = {
        "ics": (".ics", ".vcs", ".lcs"), "lotus": (".csv",),
        "vcf": (".vcf", ".csv"), "claws": (".xml", ".ldif", ".ldi")}[art]
    ergebnis = {name: [] for name in ("termine", "jahrestage", "geburtstage",
                                      "aufgaben", "kontakte", "notizen")}
    ergebnis.update({"uebersprungen": 0, "wiederholend": 0})
    berichte, gesamt, gelesen = [], 0, 0
    with zipfile.ZipFile(puffer) as archiv:
        dateien = [info for info in archiv.infolist() if not info.is_dir()]
        if len(dateien) > IMPORT_ARCHIV_EINTRAEGE_MAX:
            raise ValueError(_("The archive contains too many files."))
        for info in dateien:
            if not info.filename.lower().endswith(erlaubte):
                continue
            if info.flag_bits & 1:
                raise ValueError(_("Encrypted archive entries are not supported."))
            if info.file_size > IMPORT_ARCHIV_EINTRAG_MAX:
                raise ValueError(_("An archive entry is too large."))
            if info.compress_size == 0 and info.file_size or (info.compress_size and
                    info.file_size > info.compress_size * IMPORT_ARCHIV_VERHAELTNIS_MAX):
                raise ValueError(_("The archive has an unsafe compression ratio."))
            gesamt += info.file_size
            if gesamt > IMPORT_DATEI_MAX:
                raise ValueError(_("The archive content is larger than 32 megabytes."))
            with archiv.open(info) as quelle:
                daten = quelle.read(IMPORT_ARCHIV_EINTRAG_MAX + 1)
            if len(daten) > IMPORT_ARCHIV_EINTRAG_MAX:
                raise ValueError(_("An archive entry is too large."))
            gesamt += len(daten) - info.file_size
            if gesamt > IMPORT_DATEI_MAX:
                raise ValueError(_("The archive content is larger than 32 megabytes."))
            sicherer_archivname = _sicherer_ics_quellenpfad(dateiname)
            sicherer_eintrag = _sicherer_ics_quellenpfad(info.filename)
            teil = einzelne(daten, sicherer_eintrag,
                            sicherer_archivname + "!/" + sicherer_eintrag)
            for name in ergebnis:
                if isinstance(ergebnis[name], list):
                    ergebnis[name].extend(teil.get(name) or [])
            ergebnis["uebersprungen"] += teil.get("uebersprungen") or 0
            ergebnis["wiederholend"] += teil.get("wiederholend") or 0
            if teil.get("bericht"):
                berichte.append(teil["bericht"])
            gelesen += 1
    if not gelesen:
        raise ValueError(_("The archive contains no supported import files."))
    ergebnis["bericht"] = " ".join(berichte)
    return ergebnis


# ---------------------------------------------------------------------------
# Zwei-Wege-Abgleich (Synchronisation)
# ---------------------------------------------------------------------------

GRABSTEIN_SCHONFRIST_MS = 90 * 24 * 60 * 60 * 1000


def grabsteine_behalten(tombstones, zeitpunkt):
    """Bewahrt frische und unlesbare Löschmarken ohne doppelte Kennungen."""
    ergebnis = {}
    for tombstone in tombstones or []:
        if not isinstance(tombstone, dict) or not tombstone.get("uid"):
            continue
        try:
            zeit = int(tombstone.get("zeit"))
        except (TypeError, ValueError, OverflowError):
            zeit = None
        if zeit is not None and zeit > 0 and zeitpunkt - zeit >= GRABSTEIN_SCHONFRIST_MS:
            continue
        schluessel = (str(tombstone["uid"]),
                      str(tombstone.get("syncKalenderUid") or ""))
        vorhanden = ergebnis.get(schluessel)
        try:
            vorhandene_zeit = int((vorhanden or {}).get("zeit") or 0)
        except (TypeError, ValueError, OverflowError):
            vorhandene_zeit = 0
        if vorhanden is None or (zeit or 0) > vorhandene_zeit:
            ergebnis[schluessel] = dict(tombstone)
    return list(ergebnis.values())


def kontakt_grabsteine_nach_loeschung(tombstones, loeschen, geschafft, zeitpunkt):
    """Behält die Schonfrist und ergänzt fehlgeschlagene Fernlöschungen."""
    zeiten = {str(t.get("uid") or ""): t.get("zeit", 0)
              for t in tombstones or [] if isinstance(t, dict)}
    ergebnis = grabsteine_behalten(tombstones, zeitpunkt)
    vorhanden = {str(t.get("uid") or "") for t in ergebnis}
    ergebnis.extend({"uid": uid, "zeit": zeiten.get(uid, 0)}
                    for uid in loeschen
                    if uid not in geschafft and uid not in vorhanden)
    return ergebnis


def _sync_inhalt(obj, felder):
    namen = list(felder)
    if felder is TERMIN_FELDER or felder == TERMIN_FELDER:
        namen.extend(("icsRoundtrip", "icsKomplex", "icsSerienUid", "icsSequence"))
    return {name: obj.get(name) for name in namen}


def _sync_inhalt_hash(obj, felder):
    return hashlib.sha256(json.dumps(
        _sync_inhalt(obj, felder), ensure_ascii=False, sort_keys=True,
        separators=(",", ":")).encode("utf-8")).hexdigest()


def _sync_sequence(obj):
    try:
        return max(0, int(obj.get("icsSequence") or 0))
    except (TypeError, ValueError, OverflowError):
        return 0


def _sync_konflikt_bewahren(obj, fern, felder):
    """Archiviert beide Fassungen einmalig innerhalb des kanonischen Eintrags."""
    lokal = _sync_inhalt(obj, felder)
    lokal["geaendert"] = obj.get("geaendert") or 0
    entfernt = _sync_inhalt(fern, felder)
    entfernt["geaendert"] = fern.get("geaendert") or 0
    kennung = hashlib.sha256(json.dumps(
        [lokal, entfernt], ensure_ascii=False, sort_keys=True,
        separators=(",", ":")).encode("utf-8")).hexdigest()
    konflikte = list(obj.get("syncKonflikte") or [])
    if not any(k.get("id") == kennung for k in konflikte if isinstance(k, dict)):
        konflikte.append({"id": kennung, "lokal": lokal, "remote": entfernt})
    obj["syncKonflikte"] = konflikte[-16:]


def sync_merge(lokal, entfernt, tombstones, letzter_sync, felder):
    """Gleicht die lokale Liste mit dem entfernten Stand ab.

    lokal      Liste von Objekten mit uid / geaendert / sync
    entfernt   dict uid -> Objekt (aus dem Evolution-Data-Server gelesen)
    tombstones Liste {"uid":…, "zeit":…} lokal gelöschter, schon einmal
               synchronisierter Einträge
    felder     Feldnamen, die inhaltlich abgeglichen werden

    Liefert (neue_lokal, anlegen, aendern, loeschen_uids, zaehler).
    Bei gleichem Eintrag gewinnt die zuletzt geänderte Seite.
    """
    zaehler = {"lokal_neu": 0, "lokal_geaendert": 0, "lokal_geloescht": 0,
               "remote_neu": 0, "remote_geaendert": 0, "remote_geloescht": 0,
               "konflikte": 0}
    anlegen, aendern, loeschen = [], [], []
    neue_lokal = []
    tote = {t.get("uid"): t.get("zeit", 0) for t in tombstones if t.get("uid")}
    gesehen = set()

    for obj in lokal:
        if not obj.get("uid"):
            obj["uid"] = _neue_uid()
        u = obj["uid"]
        gesehen.add(u)
        fern = entfernt.get(u)
        if fern is None:
            if obj.get("sync"):
                if (obj.get("geaendert") or 0) > letzter_sync:
                    obj["sync"] = True          # drüben gelöscht, hier neuer geändert
                    anlegen.append(obj)
                    zaehler["remote_neu"] += 1
                    neue_lokal.append(obj)
                else:
                    zaehler["lokal_geloescht"] += 1   # Löschung übernehmen
            else:
                obj["sync"] = True
                anlegen.append(obj)
                zaehler["remote_neu"] += 1
                neue_lokal.append(obj)
        else:
            lokal_zeit = obj.get("geaendert") or 0
            fern_zeit = fern.get("geaendert") or 0
            ergaenzung_hochladen = False
            if "foto" in felder:
                lokal_foto = obj.get("foto") or ""
                fern_foto = fern.get("foto") or ""
                if fern_foto and not lokal_foto:
                    # Ein Foto kann von EDS später als die übrige vCard
                    # geliefert werden. Es darf dann nicht wegen eines
                    # neueren lokalen Zeitstempels wieder verschwinden.
                    obj["foto"] = fern_foto
                elif lokal_foto and not fern_foto:
                    # Ein fehlendes PHOTO-Feld ist bei vielen EDS-Backends
                    # keine ausdrückliche Löschung. Das lokale Bild erhalten
                    # und nach dem Zusammenführen erneut hochgeben.
                    ergaenzung_hochladen = True
            if "email" in felder or "emails" in felder:
                lokale_emails = _email_liste(obj)
                ferne_emails = _email_liste(fern)
                ferne_schluessel = {wert.lower() for wert in ferne_emails}
                if any(wert.lower() not in ferne_schluessel
                       for wert in lokale_emails):
                    ergaenzung_hochladen = True
                email_eintraege = _email_eintraege_vereinigen(obj, fern)
                emails = [eintrag["wert"] for eintrag in email_eintraege]
                obj["email"] = emails[0] if emails else ""
                obj["emails"] = emails
                obj["emailEintraege"] = email_eintraege
            if "telefone" in felder:
                lokale_telefone = _telefon_liste(obj)
                ferne_telefone = _telefon_liste(fern)
                ferne_schluessel = {(_telefon_schluessel(t["wert"]) or t["wert"],
                                      kanonischer_text(_kontakt_label(t.get("label"))))
                                     for t in ferne_telefone}
                if any(((_telefon_schluessel(t["wert"]) or t["wert"]),
                        kanonischer_text(_kontakt_label(t.get("label"))))
                       not in ferne_schluessel for t in lokale_telefone):
                    ergaenzung_hochladen = True
                _telefone_setzen(obj, _telefone_vereinigen(obj, fern))
            if "anschriften" in felder:
                lokale_anschriften = _anschrift_liste(obj)
                ferne_anschriften = _anschrift_liste(fern)
                if any(a not in ferne_anschriften for a in lokale_anschriften):
                    ergaenzung_hochladen = True
                _anschriften_setzen(obj, _anschriften_vereinigen(obj, fern))
            if "kontaktpersonen" in felder:
                lokale_personen = _kontaktpersonen_liste(obj)
                ferne_personen = _kontaktpersonen_liste(fern)
                if any(person not in ferne_personen for person in lokale_personen):
                    ergaenzung_hochladen = True
                _kontaktpersonen_setzen(
                    obj, _kontaktpersonen_vereinigen(obj, fern))
            if "sozialeMedien" in felder:
                lokale_soziale = _soziale_medien_liste(obj)
                ferne_soziale = _soziale_medien_liste(fern)
                if any(eintrag not in ferne_soziale for eintrag in lokale_soziale):
                    ergaenzung_hochladen = True
                obj["sozialeMedien"] = _soziale_medien_vereinigen(obj, fern)
            ist_termin = felder is TERMIN_FELDER or felder == TERMIN_FELDER
            inhalt_gleich = (not ist_termin or
                             _sync_inhalt_hash(obj, felder) ==
                             _sync_inhalt_hash(fern, felder))
            lokal_sequence = _sync_sequence(obj) if ist_termin else 0
            fern_sequence = _sync_sequence(fern) if ist_termin else 0
            if ist_termin and lokal_sequence != fern_sequence:
                entscheidung = "remote" if fern_sequence > lokal_sequence else "lokal"
            elif (ist_termin and not inhalt_gleich and
                  (fern.get("icsAenderungszeitFehlt") or
                   abs(fern_zeit - lokal_zeit) <= 1000)):
                entscheidung = "konflikt"
            elif fern_zeit > lokal_zeit:
                entscheidung = "remote"
            elif lokal_zeit > fern_zeit:
                entscheidung = "lokal"
            else:
                entscheidung = "gleich"
            if entscheidung == "konflikt":
                _sync_konflikt_bewahren(obj, fern, felder)
                zaehler["konflikte"] += 1
                entscheidung = ("lokal" if fern.get("icsAenderungszeitFehlt") and
                                 lokal_zeit > letzter_sync else "remote")
            if entscheidung == "remote":
                for f in felder:
                    if f == "foto" and not fern.get(f) and obj.get(f):
                        continue
                    if f in ("email", "emails", "emailEintraege",
                             "telefon", "mobil", "telefone",
                             "strasse", "plz", "ort", "anschriften",
                             "kontaktpersonName", "kontaktpersonTelefon",
                             "kontaktpersonStatus", "kontaktpersonen",
                             "sozialeMedien"):
                        continue
                    if f in fern:
                        obj[f] = fern[f]
                for f in ("vcardRoundtrip", "vcardParameter"):
                    if f in fern:
                        obj[f] = fern[f]
                if felder is TERMIN_FELDER or felder == TERMIN_FELDER:
                    for f in ICS_BEGLEITFELDER:
                        if f in fern:
                            obj[f] = fern[f]
                        else:
                            obj.pop(f, None)
                obj["geaendert"] = fern_zeit
                zaehler["lokal_geaendert"] += 1
            elif entscheidung == "lokal":
                if ist_termin:
                    obj["icsSequence"] = max(lokal_sequence, fern_sequence) + 1
                    obj["icsAenderungszeitFehlt"] = False
                aendern.append(obj)
                zaehler["remote_geaendert"] += 1
                ergaenzung_hochladen = False
            if ergaenzung_hochladen and not any(obj is eintrag for eintrag in aendern):
                aendern.append(obj)
                zaehler["remote_geaendert"] += 1
            obj["sync"] = True
            neue_lokal.append(obj)

    for u, fern in entfernt.items():
        if u in gesehen:
            continue
        if u in tote:
            if tote[u] >= (fern.get("geaendert") or 0):
                loeschen.append(u)
                zaehler["remote_geloescht"] += 1
                continue
            # drüben nach unserer Löschung geändert -> wiederbeleben
        neu = dict(fern)
        if "email" in felder or "emails" in felder:
            email_eintraege = _email_eintraege(neu)
            emails = [eintrag["wert"] for eintrag in email_eintraege]
            neu["email"] = emails[0] if emails else ""
            neu["emails"] = emails
            neu["emailEintraege"] = email_eintraege
        if "telefone" in felder:
            _telefone_setzen(neu, _telefon_liste(neu))
        if "anschriften" in felder:
            _anschriften_setzen(neu, _anschrift_liste(neu))
        if "kontaktpersonen" in felder:
            _kontaktpersonen_setzen(neu, _kontaktpersonen_liste(neu))
        if "sozialeMedien" in felder:
            neu["sozialeMedien"] = _soziale_medien_liste(neu)
        neu["sync"] = True
        neu.setdefault("geaendert", 0)
        neue_lokal.append(neu)
        zaehler["lokal_neu"] += 1

    return neue_lokal, anlegen, aendern, loeschen, zaehler


# ---------------------------------------------------------------------------
# Feiertage und Schulferien (einmaliger Abruf im Netz)
#
# Bezugsquelle ist der offene Dienst openholidaysapi.org, der gesetzliche
# Feiertage und Schulferien vieler Länder samt Bundesland-Genauigkeit führt.
# Abgerufen wird nur auf ausdrücklichen Wunsch; danach liegen die Daten im
# Organizer und das Programm kommt wieder ohne Netz aus.
# ---------------------------------------------------------------------------

def _rechtschreib_auswahl(sprache=None, umgebung=None):
    """Löst die gewählte Oberflächensprache auf Deutsch oder Englisch auf."""
    umgebung = umgebung if umgebung is not None else os.environ
    roh = str(sprache if sprache is not None else
              _REGIONAL.get("language") or "system").strip()
    if not roh or roh.lower() == "system":
        roh = ""
        for schluessel in ("LC_ALL", "LC_MESSAGES", "LANG", "LANGUAGE"):
            wert = (umgebung.get(schluessel) or "").strip()
            if wert:
                roh = wert.replace(":", " ").split()[0]
                break
    kurz = roh.split(".")[0].split("@")[0].replace("-", "_")
    if not kurz or kurz.upper() in ("C", "POSIX"):
        kurz = "en_US"
    basis = kurz.split("_", 1)[0].lower()
    effektiv = "de" if basis == "de" else "en"
    return effektiv, kurz if basis in ("de", "en") else ""


def rechtschreib_sprachen(sprache=None, umgebung=None):
    """Liefert Enchant-/WebKit-Kandidaten für die gewählte Sprache."""
    if isinstance(sprache, dict) and umgebung is None:
        umgebung, sprache = sprache, "system"
    effektiv, regional = _rechtschreib_auswahl(sprache, umgebung)
    sprachen = []
    for kandidat in ((regional,) if "_" in regional else ()) + (
            ("de_DE", "de") if effektiv == "de" else ("en_US", "en")):
        if kandidat and kandidat not in sprachen:
            sprachen.append(kandidat)
    return sprachen


_WOERTERBUCH = {"geprueft": False, "buch": None, "fehler": ""}
_WOERTERBUECHER = {"de": _WOERTERBUCH}
_WOERTERBUCH_SPERRE = threading.RLock()

PAKET_ENCHANT = "python3-enchant"
PAKET_WOERTER = "hunspell-de-de"


def woerterbuch_paket(sprache=None, umgebung=None):
    effektiv, regional = _rechtschreib_auswahl(sprache, umgebung)
    regional = regional.lower()
    if effektiv == "de":
        return {"de_at": "hunspell-de-at", "de_ch": "hunspell-de-ch"}.get(
            regional, "hunspell-de-de")
    return "hunspell-en-gb" if regional == "en_gb" else "hunspell-en-us"


def eigene_woerter_datei():
    return os.path.join(daten_verzeichnis(), "eigene-woerter.txt")


def _woerterbuch_zustand(sprache=None, umgebung=None):
    effektiv, _regional = _rechtschreib_auswahl(sprache, umgebung)
    if effektiv == "de":
        return _WOERTERBUCH
    with _WOERTERBUCH_SPERRE:
        return _WOERTERBUECHER.setdefault(
            effektiv, {"geprueft": False, "buch": None, "fehler": ""})


def woerterbuch_laden(sprache=None):
    """Öffnet das Wörterbuch für die Vorschläge. Liefert das Buch oder None;
    die Ursache wird im sprachabhängigen Wörterbuchzustand bewahrt."""
    zustand = _woerterbuch_zustand(sprache)
    with _WOERTERBUCH_SPERRE:
        if zustand["geprueft"]:
            return zustand["buch"]
        zustand["geprueft"] = True
        try:
            import enchant
        except ImportError:
            zustand["fehler"] = (
                _("A component for spelling suggestions is missing. Install it with:  "
                  "sudo apt install %s") % PAKET_ENCHANT)
            return None

        eigene = eigene_woerter_datei()
        try:
            if not os.path.exists(eigene):
                with open(eigene, "w", encoding="utf-8"):
                    pass
        except OSError:
            eigene = None

        for kandidat in rechtschreib_sprachen(sprache):
            try:
                if not enchant.dict_exists(kandidat):
                    continue
                buch = (enchant.DictWithPWL(kandidat, eigene) if eigene
                        else enchant.Dict(kandidat))
            except Exception:
                continue
            zustand["buch"] = buch
            return buch

        zustand["fehler"] = (
            _("No dictionary was found. Install one with:  sudo apt install %s")
            % woerterbuch_paket(sprache))
        return None


def rechtschreib_pruefen(wort, buch=None, sprache=None):
    """Prüft ein einzelnes Wort und liefert Verbesserungsvorschläge."""
    wort = (wort or "").strip()
    if not wort:
        return {"wort": "", "richtig": True, "vorschlaege": [], "fehler": ""}
    buch = buch or woerterbuch_laden(sprache)
    if buch is None:
        zustand = _woerterbuch_zustand(sprache)
        return {"wort": wort, "richtig": True, "vorschlaege": [],
                "fehler": zustand["fehler"]}
    try:
        if buch.check(wort):
            return {"wort": wort, "richtig": True, "vorschlaege": [], "fehler": ""}
        vorschlaege = [v for v in (buch.suggest(wort) or []) if v and v != wort]
    except Exception as fehler:
        return {"wort": wort, "richtig": True, "vorschlaege": [],
                "fehler": fehler_deutsch(fehler, _("Spell checking"))}
    return {"wort": wort, "richtig": False, "vorschlaege": vorschlaege[:8],
            "fehler": ""}


def wort_aufnehmen(wort, buch=None, sprache=None):
    """Nimmt ein Wort in das eigene Wörterbuch auf."""
    wort = (wort or "").strip()
    if not wort:
        return {"wort": "", "ok": False, "fehler": _("No word was provided.")}
    buch = buch or woerterbuch_laden(sprache)
    if buch is None:
        return {"wort": wort, "ok": False,
                "fehler": _woerterbuch_zustand(sprache)["fehler"]}
    try:
        buch.add(wort)
    except Exception as fehler:
        return {"wort": wort, "ok": False,
                "fehler": fehler_deutsch(fehler, _("Adding the word to the dictionary"))}
    return {"wort": wort, "ok": True, "fehler": ""}


def fenster_datei():
    return os.path.join(daten_verzeichnis(), "fenster.json")


def fenster_zustand_lesen(pfad=None):
    """Liest den zuletzt benutzten Fensterzustand. Fehlt oder klemmt die
    Datei, gilt die Voreinstellung."""
    standard = {"breite": 1280, "hoehe": 860, "x": None, "y": None,
                "maximiert": False, "vollbild": False}
    try:
        with open(pfad or fenster_datei(), "r", encoding="utf-8") as datei:
            roh = json.load(datei)
    except (OSError, ValueError):
        return standard
    if not isinstance(roh, dict):
        return standard
    zustand = dict(standard)
    try:
        breite = int(roh.get("breite", standard["breite"]))
        hoehe = int(roh.get("hoehe", standard["hoehe"]))
    except (TypeError, ValueError):
        breite, hoehe = standard["breite"], standard["hoehe"]
    zustand["breite"] = max(980, min(10000, breite))
    zustand["hoehe"] = max(640, min(10000, hoehe))
    try:
        x, y = int(roh.get("x")), int(roh.get("y"))
        if -10000 <= x <= 10000 and -10000 <= y <= 10000:
            zustand["x"], zustand["y"] = x, y
    except (TypeError, ValueError):
        pass
    zustand["maximiert"] = bool(roh.get("maximiert"))
    zustand["vollbild"] = bool(roh.get("vollbild"))
    return zustand


def fenster_zustand_schreiben(zustand, pfad=None):
    """Legt den Fensterzustand neben den Daten ab."""
    try:
        atomar_text_schreiben(
            pfad or fenster_datei(),
            json.dumps(zustand, ensure_ascii=False, indent=1))
        return True
    except OSError:
        return False


def tray_datei():
    return os.path.join(daten_verzeichnis(), "tray.json")


def tray_einstellungen(roh=None):
    roh = roh if isinstance(roh, dict) else {}
    oeffnen = {"letzte": "previous", "previous": "previous",
               "zentriert": "centered", "centered": "centered",
               "maximiert": "maximized", "maximized": "maximized"}.get(
                   str(roh.get("oeffnen") or "").lower(), "previous")
    return {"aktiv": bool(roh.get("aktiv")),
            "minimierenInTray": roh.get("minimierenInTray") is not False,
            "schliessenInTray": roh.get("schliessenInTray") is not False,
            "startMinimiert": bool(roh.get("startMinimiert")),
            "autostart": bool(roh.get("autostart")),
            "zaehler": bool(roh.get("zaehler")),
            "oeffnen": oeffnen}


def tray_einstellungen_lesen(pfad=None):
    try:
        with open(pfad or tray_datei(), "r", encoding="utf-8") as datei:
            return tray_einstellungen(json.load(datei))
    except (OSError, ValueError):
        return tray_einstellungen()


def tray_einstellungen_schreiben(einstellungen, pfad=None):
    try:
        ziel = pfad or tray_datei()
        atomar_text_schreiben(
            ziel, json.dumps(tray_einstellungen(einstellungen),
                             ensure_ascii=False, indent=1))
        return {"ok": True, "fehler": ""}
    except OSError as fehler:
        return {"ok": False, "fehler": fehler_deutsch(
            fehler, _("Saving the tray settings"))}


def tray_autostart_datei(ordner=None):
    basis = ordner or (os.environ.get("XDG_CONFIG_HOME")
                       or os.path.expanduser("~/.config"))
    return os.path.join(basis, "autostart", "magnolie-organizer-tray.desktop")


def tray_autostart_text(programm=None):
    return (
        "[Desktop Entry]\n"
        "Type=Application\n"
        "Version=1.0\n"
        "Name=%s\n" % _("Magnolie Organizer – Tray Applet") +
        "Comment=%s\n" % _("Starts Magnolie Organizer when signing in") +
        "Exec=\"%s\" --tray-start\n" % (programm or eigener_pfad()).replace(
            "\\", "\\\\").replace('"', '\\"') +
        "Icon=magnolie-organizer\n"
        "Terminal=false\n"
        "NoDisplay=true\n"
        "Hidden=false\n"
        "X-GNOME-Autostart-enabled=true\n"
        "X-GNOME-Autostart-Delay=10\n")


def tray_autostart_einrichten(an, pfad=None):
    pfad = pfad or tray_autostart_datei()
    try:
        if an:
            schreibe_wenn_anders(pfad, tray_autostart_text())
        elif os.path.exists(pfad):
            os.remove(pfad)
    except OSError as fehler:
        return {"ok": False, "fehler": fehler_deutsch(
            fehler, _("Adding the tray applet to autostart"))}
    return {"ok": True, "fehler": ""}


# ---------------------------------------------------------------------------
# Erinnerungen an Termine
#
# Der Wecker läuft in zwei Lagen: solange das Programm offen ist, meldet es
# sich selbst; darüber hinaus übernimmt ein kleiner Dienst der Sitzung
# (systemd --user), der jede Minute nachsieht und nach dem Hochfahren
# Versäumtes nachholt.
# ---------------------------------------------------------------------------

ERINNERUNG_EINHEIT = "magnolie-erinnerung"


def erinnerung_zustand_datei():
    return os.path.join(daten_verzeichnis(), "erinnerungen.json")


def erinnerungsdaten_datei():
    """Begrenzte Klartextdaten für den Wecker bei Kennwortschutz."""
    return os.path.join(daten_verzeichnis(), "erinnerungsdaten.json")


ERINNERUNG_TERMIN_FELDER = (
    "id", "uid", "datum", "endDatum", "zeit", "endZeit", "titel",
    "individuelleErinnerungTage", "standardErinnerung")
ERINNERUNG_ALARM_FELDER = (
    "offsetMinuten", "absolut", "aktiviert", "related", "aktion")
ERINNERUNG_WIEDERHOLUNG_FELDER = (
    "art", "bis", "ordinal", "wochentag", "intervall", "daten")
ERINNERUNG_AUFGABE_FELDER = (
    "id", "uid", "titel", "faellig", "erledigt", "erinnern",
    "individuelleErinnerungTage", "startZeit", "faelligZeit")
ERINNERUNG_JAHRESTAG_FELDER = ("id", "uid", "name", "datum", "typ")
ERINNERUNG_EINSTELLUNG_FELDER = (
    "an", "vorlauf", "verpasste", "aufgaben", "art", "stil", "protokoll",
    "protokollVoreinstellung")
ERINNERUNG_JAHRESTAG_EINSTELLUNG_FELDER = ("an", "tage", "amTag", "stunde")


def _erinnerungsfelder_auswaehlen(quelle, felder):
    if not isinstance(quelle, dict):
        return {}
    return {feld: quelle[feld] for feld in felder if feld in quelle}


def _alarm_normalisieren(alarm):
    if not isinstance(alarm, dict):
        return None
    aktion = alarm.get("aktion", "display")
    if not isinstance(aktion, str):
        return None
    basis = {"offsetMinuten": None, "absolut": "",
             "aktiviert": alarm.get("aktiviert") is not False,
             "related": "END" if str(alarm.get("related") or "START").upper() == "END" else "START",
             "aktion": aktion.lower()}
    if alarm.get("bearbeitbar") is False:
        trigger = str(alarm.get("triggerRaw") or "").strip()
        dauer = re.fullmatch(
            r"([+-]?)P(?:(\d+)W)?(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?)?",
            trigger, re.I)
        if dauer and any(wert is not None for wert in dauer.groups()[1:]):
            minuten = (int(dauer.group(2) or 0) * 10080 +
                       int(dauer.group(3) or 0) * 1440 +
                       int(dauer.group(4) or 0) * 60 +
                       int(dauer.group(5) or 0) +
                       (int(dauer.group(6) or 0) + 59) // 60)
            if minuten <= 525600:
                basis["offsetMinuten"] = minuten if dauer.group(1) == "-" else -minuten
                return basis
        datum, zeit = _ics_datumzeit(
            trigger, {"TZID": str(alarm.get("triggerTzid") or "")})
        if datum and zeit:
            basis["absolut"] = datum + " " + zeit
            return basis
        return None
    wert = alarm.get("offsetMinuten")
    if isinstance(wert, bool):
        return None
    try:
        minuten = int(wert)
        ganzzahlig = float(wert) == minuten
    except (TypeError, ValueError, OverflowError):
        return None
    if not ganzzahlig or not 0 <= minuten <= 525600:
        return None
    basis["offsetMinuten"] = minuten
    return basis


def erinnerungsdaten_auswaehlen(daten):
    """Wählt ausschließlich Inhalte aus, die der Wecker benötigt.

    Vertrauliche Einträge kommen nur mit einer zweiten ausdrücklichen
    Zustimmung hinein. Personen, Adressen und Notizen landen nie darin."""
    if not isinstance(daten, dict):
        return None
    einstellungen = daten.get("einstellungen")
    if not isinstance(einstellungen, dict):
        einstellungen = {}
    sicherheit = einstellungen.get("sicherheit")
    if not isinstance(sicherheit, dict):
        sicherheit = {}
    if not sicherheit.get("erinnernTrotzKennwort"):
        return None
    vertraulich = bool(sicherheit.get("vertraulicheErinnerungen"))

    def eintraege(name, felder):
        return [_erinnerungsfelder_auswaehlen(eintrag, felder)
                for eintrag in (daten.get(name) or [])
                if isinstance(eintrag, dict) and
                (vertraulich or not eintrag.get("vertraulich"))]

    rohe_termine = [t for t in (daten.get("termine") or [])
                    if isinstance(t, dict) and
                    (vertraulich or not t.get("vertraulich"))]
    termine = [_erinnerungsfelder_auswaehlen(t, ERINNERUNG_TERMIN_FELDER)
               for t in rohe_termine]
    for ausgewaehlt, original in zip(termine, rohe_termine):
        if isinstance(original.get("alarme"), list):
            ausgewaehlt["alarme"] = [alarm for alarm in (
                _alarm_normalisieren(roh) for roh in original["alarme"][:32])
                if alarm is not None]
        if "wiederholung" in original:
            ausgewaehlt["wiederholung"] = _erinnerungsfelder_auswaehlen(
                original["wiederholung"], ERINNERUNG_WIEDERHOLUNG_FELDER)

    erinnerung = _erinnerungsfelder_auswaehlen(
        einstellungen.get("erinnerung"), ERINNERUNG_EINSTELLUNG_FELDER)
    rohe_jahrestage = (einstellungen.get("erinnerung") or {}).get(
        "jahrestage") if isinstance(einstellungen.get("erinnerung"), dict) else None
    if isinstance(rohe_jahrestage, dict):
        erinnerung["jahrestage"] = _erinnerungsfelder_auswaehlen(
            rohe_jahrestage, ERINNERUNG_JAHRESTAG_EINSTELLUNG_FELDER)
    return {
        "version": 1,
        "nurErinnerungen": True,
        "termine": termine,
        "aufgaben": eintraege("aufgaben", ERINNERUNG_AUFGABE_FELDER),
        "jahrestage": eintraege("jahrestage", ERINNERUNG_JAHRESTAG_FELDER),
        "einstellungen": {"erinnerung": erinnerung},
    }


def erinnerungsdaten_schreiben(daten, pfad=None):
    pfad = pfad or erinnerungsdaten_datei()
    auswahl = erinnerungsdaten_auswaehlen(daten)
    if auswahl is None:
        try:
            os.unlink(pfad)
        except OSError:
            pass
        return False
    try:
        atomar_text_schreiben(pfad, json.dumps(
            auswahl, ensure_ascii=False, separators=(",", ":")))
        return True
    except OSError:
        return False


def erinnerungsdaten_lesen(pfad=None):
    try:
        with open(pfad or erinnerungsdaten_datei(), "r",
                  encoding="utf-8") as datei:
            daten = json.load(datei)
    except (OSError, ValueError):
        return None
    return daten if isinstance(daten, dict) and daten.get(
        "nurErinnerungen") else None


def erinnerung_zustand_lesen(pfad=None):
    try:
        with open(pfad or erinnerung_zustand_datei(), "r", encoding="utf-8") as datei:
            roh = json.load(datei)
    except (OSError, ValueError):
        roh = {}
    if not isinstance(roh, dict):
        roh = {}
    gemeldet = roh.get("gemeldet")
    return {"gemeldet": gemeldet if isinstance(gemeldet, dict) else {},
            "letzter_lauf": roh.get("letzter_lauf") or ""}


def erinnerung_zustand_schreiben(zustand, pfad=None):
    try:
        atomar_text_schreiben(
            pfad or erinnerung_zustand_datei(),
            json.dumps(zustand, ensure_ascii=False, indent=1))
        return True
    except OSError:
        return False


def _termin_zeitpunkt(termin, ganztags_stunde=8):
    """Wann beginnt ein Termin? Ganztägige gelten ab der genannten Stunde."""
    datum = (termin.get("datum") or "").strip()
    if not _ist_iso(datum):
        return None
    zeit = (termin.get("zeit") or "").strip()
    try:
        if len(zeit) >= 4 and ":" in zeit:
            stunde, minute = int(zeit[:2]), int(zeit[3:5])
        else:
            stunde, minute = ganztags_stunde, 0
        jahr, monat, tag = int(datum[:4]), int(datum[5:7]), int(datum[8:10])
        return datetime(jahr, monat, tag, stunde, minute)
    except (TypeError, ValueError):
        return None


def _termin_endzeitpunkt(termin, ganztags_stunde=8):
    """Terminende; fehlende Endwerte fallen wie im Webmodell zurück."""
    ende = dict(termin)
    ende["datum"] = termin.get("endDatum") or termin.get("datum")
    ende["zeit"] = termin.get("endZeit") or termin.get("zeit") or ""
    return _termin_zeitpunkt(ende, ganztags_stunde)


def _strukturierte_alarme(termin):
    """Aktive Display-Alarme als (Minuten, Bezug, absolute Wandzeit)."""
    ergebnis = []
    gesehen = set()
    rohe_alarme = termin.get("alarme")
    if not isinstance(rohe_alarme, list):
        return ergebnis
    for roh in rohe_alarme[:32]:
        alarm = _alarm_normalisieren(roh)
        if alarm is None or not alarm["aktiviert"]:
            continue
        if alarm["aktion"] != "display":
            continue
        minuten = alarm.get("offsetMinuten")
        related = alarm["related"]
        absolut = alarm.get("absolut") or ""
        schluessel = (minuten, related, absolut)
        if schluessel not in gesehen:
            gesehen.add(schluessel)
            ergebnis.append(schluessel)
    return ergebnis


def _termin_meldungen(termin, kennung, beginn, vorlauf):
    """Deduplizierte Meldungen aus Standard-, Legacy- und Webalarmen."""
    meldungen = {}

    def aufnehmen(art, minuten, related="START", tage=0, feste_zeit=None):
        basis = _termin_endzeitpunkt(termin) if related == "END" else beginn
        if basis is None:
            return
        erinnerungszeit = feste_zeit or (basis - timedelta(minutes=minuten))
        meldebasis = max(basis, erinnerungszeit)
        kennzeichen = art if feste_zeit is None else "%s-%s" % (
            art, feste_zeit.strftime("%Y%m%d%H%M"))
        marke = "%s@%s:v2:%s" % (
            kennung, basis.strftime("%Y%m%d%H%M"), kennzeichen)
        alte_marken = {kennung, "%s@%s" % (
            kennung, basis.strftime("%Y%m%d%H%M"))}
        if art == "standard":
            for alter_vorlauf in (0, 5, 10, 15, 30, 60, 120):
                alte_marken.add("%s@%s:%s" % (
                    kennung, (basis - timedelta(minutes=alter_vorlauf)).strftime(
                        "%Y%m%d%H%M"), art))
        else:
            alte_marken.add("%s@%s:%s" % (
                kennung, erinnerungszeit.strftime("%Y%m%d%H%M"), art))
        meldungen.setdefault((minuten, related, feste_zeit), (
            marke, erinnerungszeit, tage, meldebasis, alte_marken))

    tage = _erinnerung_tage(termin.get("individuelleErinnerungTage"))
    if not tage or termin.get("standardErinnerung") is not False:
        aufnehmen("standard", max(0, vorlauf))
    if 1 <= tage <= 7:
        aufnehmen("individuell-%d" % tage, tage * 1440,
                  tage=tage)
    for minuten, related, absolut in _strukturierte_alarme(termin):
        if absolut:
            if termin.get("folge"):
                continue
            try:
                feste_zeit = datetime.strptime(absolut, "%Y-%m-%d %H:%M")
            except ValueError:
                continue
            aufnehmen("alarm-absolut", 0, related, feste_zeit=feste_zeit)
            continue
        alarm_tage = minuten // 1440 if minuten and minuten > 0 and minuten % 1440 == 0 else 0
        aufnehmen("alarm-%s-%d" % (related, minuten),
                  minuten, related, alarm_tage)
    return list(meldungen.values())


def _letzter_tag(jahr, monat):
    from calendar import monthrange
    return monthrange(jahr, monat)[1]


def wiederholung_trifft(termin, tag):
    """Fällt dieser Tag auf eine Wiederholung des Termins?"""
    w = (termin or {}).get("wiederholung") or {}
    art = wiederholung_art(w.get("art"))
    if art == "none":
        return False
    datum = (termin.get("datum") or "").strip()
    if len(datum) < 10:
        return False
    iso = tag.strftime("%Y-%m-%d")
    if iso <= datum:
        return False
    bis = (w.get("bis") or "").strip()
    if bis and iso > bis:
        return False
    try:
        start = datetime.strptime(datum, "%Y-%m-%d")
    except ValueError:
        return False

    try:
        intervall = max(1, min(3660, int(w.get("intervall") or 1)))
    except (TypeError, ValueError):
        intervall = 1
    tage_seit_start = (tag.date() - start.date()).days
    if art == "custom":
        return iso in [wert for wert in (w.get("daten") or [])
                       if isinstance(wert, str)]
    if art == "daily":
        return tage_seit_start % intervall == 0
    if art == "weekly":
        return (start.weekday() == tag.weekday() and
                tage_seit_start % (7 * intervall) == 0)
    if art == "monthly":
        try:
            ordinal = int(w.get("ordinal"))
        except (TypeError, ValueError):
            ordinal = 0
        wochentag = str(w.get("wochentag") or "").upper()
        tage = ("MO", "TU", "WE", "TH", "FR", "SA", "SU")
        if ordinal in (-1, 1, 2, 3, 4) and wochentag in tage:
            if tag.weekday() != tage.index(wochentag):
                return False
            if ordinal == -1:
                return tag.day + 7 > _letzter_tag(tag.year, tag.month)
            return (tag.day - 1) // 7 + 1 == ordinal
        letzter = _letzter_tag(tag.year, tag.month)
        return tag.day == min(start.day, letzter)
    if art == "yearly":
        if (start.month, start.day) == (tag.month, tag.day):
            return True
        if (start.month, start.day) == (2, 29) and (tag.month, tag.day) == (2, 28):
            return _letzter_tag(tag.year, 2) == 28
        return False
    return False


def termine_mit_wiederholungen(daten, jetzt, tage_zurueck=4, tage_vor=2):
    """Ergänzt die gespeicherten Termine um die errechneten Male der
    Wiederholungen im betrachteten Zeitfenster.

    Jedes Mal bekommt eine eigene Kennung aus Termin und Datum, damit der
    Wecker sich merken kann, was er schon gemeldet hat."""
    from datetime import timedelta
    alle = list((daten or {}).get("termine") or [])
    wiederkehrend = [t for t in alle if isinstance(t, dict)
                     and wiederholung_art((t.get("wiederholung") or {}).get("art"))
                     != "none"]
    if not wiederkehrend:
        return alle

    ergaenzt = list(alle)
    for versatz in range(-max(0, tage_zurueck), max(1, tage_vor) + 1):
        tag = (jetzt + timedelta(days=versatz)).replace(
            hour=0, minute=0, second=0, microsecond=0)
        iso = tag.strftime("%Y-%m-%d")
        for termin in wiederkehrend:
            if not wiederholung_trifft(termin, tag):
                continue
            mal = dict(termin)
            mal["datum"] = iso
            end_datum = termin.get("endDatum") or ""
            if end_datum:
                try:
                    dauer = (datetime.strptime(end_datum, "%Y-%m-%d") -
                             datetime.strptime(termin["datum"], "%Y-%m-%d")).days
                    mal["endDatum"] = (tag + timedelta(days=dauer)).strftime("%Y-%m-%d")
                except (KeyError, TypeError, ValueError):
                    mal["endDatum"] = ""
            mal["id"] = "%s@%s" % (termin.get("id") or termin.get("uid") or "?",
                                   iso)
            mal["folge"] = True
            ergaenzt.append(mal)
    return ergaenzt


def faellige_erinnerungen(daten, jetzt, zustand, vorlauf=15, verpasste=True,
                          rueckblick_stunden=72, spielraum_minuten=5):
    """Sucht Termine, an die zu erinnern ist. Liefert fällige und verpasste
    Termine sowie den fortgeschriebenen Zustand."""
    from datetime import timedelta
    gemeldet = dict((zustand or {}).get("gemeldet") or {})
    faellig, verpasst = [], []
    grenze_zurueck = jetzt - timedelta(hours=max(1, rueckblick_stunden))
    spielraum = timedelta(minutes=max(0, spielraum_minuten))
    individuelle_tage = [_erinnerung_tage(t.get("individuelleErinnerungTage"))
                         for t in (daten or {}).get("termine") or []
                         if isinstance(t, dict)]
    alarm_minuten = [minuten for t in (daten or {}).get("termine") or []
                     if isinstance(t, dict)
                     for minuten, _related, _absolut in _strukturierte_alarme(t)
                     if minuten is not None]
    groesster_vorlauf = max([0] + alarm_minuten)
    tage_vor = max([2] + [tage + 1 for tage in individuelle_tage
                          if 1 <= tage <= 7] +
                   [(groesster_vorlauf + 1439) // 1440 + 1])

    for termin in termine_mit_wiederholungen(daten, jetzt, tage_vor=tage_vor):
        if not isinstance(termin, dict):
            continue
        kennung = str(termin.get("id") or termin.get("uid") or "")
        if not kennung:
            continue
        beginn = _termin_zeitpunkt(termin)
        if beginn is None:
            continue
        for marke, erinnerungszeit, tage, basis, alte_marken in _termin_meldungen(
                termin, kennung, beginn, vorlauf):
            if basis < grenze_zurueck:
                continue
            if marke in gemeldet:
                continue
            alte_marke = next((alt for alt in alte_marken if alt in gemeldet), None)
            if alte_marke is not None:
                gemeldet[marke] = gemeldet[alte_marke]
                continue
            if jetzt < erinnerungszeit:
                continue
            eintrag = {"id": marke,
                       "titel": (termin.get("titel") or "").strip()
                       or _("Untitled appointment"),
                       "datum": termin.get("datum") or "",
                       "zeit": (termin.get("zeit") or "").strip(),
                       "ort": (termin.get("kategorien") or "").strip(),
                       "individuelleTage": tage,
                       "beginn": beginn.strftime("%Y-%m-%d %H:%M")}
            if jetzt > basis + spielraum:
                if not verpasste:
                    gemeldet[marke] = jetzt.strftime("%Y-%m-%d %H:%M")
                    continue
                eintrag["verpasst"] = True
                verpasst.append(eintrag)
            else:
                eintrag["verpasst"] = False
                faellig.append(eintrag)
            gemeldet[marke] = jetzt.strftime("%Y-%m-%d %H:%M")

    # Vermerke zu längst vergangenen Terminen wieder wegräumen
    behalten = {}
    for kennung, wann in gemeldet.items():
        try:
            gemerkt = datetime.strptime(str(wann)[:16], "%Y-%m-%d %H:%M")
        except (TypeError, ValueError):
            # Nicht erneut melden, aber die Marke wieder regulär altern lassen.
            behalten[kennung] = jetzt.strftime("%Y-%m-%d %H:%M")
            continue
        if gemerkt >= grenze_zurueck - timedelta(
                days=max(7, (groesster_vorlauf + 1439) // 1440 + 7)):
            behalten[kennung] = wann

    return {"faellig": faellig, "verpasst": verpasst,
            "zustand": {"gemeldet": behalten,
                        "letzter_lauf": jetzt.strftime("%Y-%m-%d %H:%M")}}


def naechster_weckzeitpunkt(daten, jetzt, vorlauf=15):
    """Wann wäre die nächste Erinnerung fällig?"""
    bester = None
    alarm_minuten = [minuten for termin in (daten or {}).get("termine") or []
                     if isinstance(termin, dict)
                     for minuten, _related, _absolut in _strukturierte_alarme(termin)
                     if minuten is not None and minuten > 0]
    individuelle = [_erinnerung_tage(termin.get("individuelleErinnerungTage"))
                    for termin in (daten or {}).get("termine") or []
                    if isinstance(termin, dict)]
    vorlauf_tage = max([1, (max(0, vorlauf) + 1439) // 1440] +
                       [(minuten + 1439) // 1440 for minuten in alarm_minuten] +
                       [tage for tage in individuelle if 1 <= tage <= 7])
    termine = termine_mit_wiederholungen(
        daten, jetzt, tage_zurueck=0, tage_vor=370 + vorlauf_tage)
    for termin in termine:
        if not isinstance(termin, dict):
            continue
        beginn = _termin_zeitpunkt(termin)
        if beginn is None:
            continue
        kennung = str(termin.get("id") or termin.get("uid") or "?")
        for _marke, weckzeit, _tage, _basis, _alte_marken in _termin_meldungen(
                termin, kennung, beginn, vorlauf):
            if weckzeit <= jetzt:
                continue
            if bester is None or weckzeit < bester:
                bester = weckzeit
    return bester


def _jahrestag_im_jahr(jahrestag, jahr):
    """Auf welches Datum fällt ein Jahrestag in diesem Jahr?"""
    datum = (jahrestag.get("datum") or "").strip()
    if len(datum) < 10:
        return None
    try:
        monat, tag = int(datum[5:7]), int(datum[8:10])
        if monat == 2 and tag == 29:
            try:
                return datetime(jahr, 2, 29)
            except ValueError:
                return datetime(jahr, 2, 28)
        return datetime(jahr, monat, tag)
    except (TypeError, ValueError):
        return None


def jahrestagstext(jahrestag, tage_hin):
    """„Max Mustermann hat morgen Geburtstag“ und Ähnliches."""
    name = (jahrestag.get("name") or "").strip() or _("Someone")
    typ = (jahrestag.get("typ") or "").strip()
    typ_schluessel = jahrestag_typ_id(typ)
    wann = {0: _("today"), 1: _("tomorrow"),
            2: _("the day after tomorrow")}.get(
        tage_hin, ngettext("in %d day", "in %d days", tage_hin) % tage_hin)
    if typ_schluessel == "birthday":
        kopf = _("Birthday today") if tage_hin == 0 else _("Birthday")
        rumpf = _("%s has a birthday %s.") % (name, wann)
    elif typ_schluessel == "wedding-anniversary":
        kopf = _("Wedding anniversary")
        if tage_hin == 0:
            rumpf = _("%s: Wedding anniversary today.") % name
        elif tage_hin == 1:
            rumpf = _("%s: Wedding anniversary tomorrow.") % name
        elif tage_hin == 2:
            rumpf = _("%s: Wedding anniversary the day after tomorrow.") % name
        else:
            rumpf = ngettext(
                "%(name)s: Wedding anniversary in %(count)d day.",
                "%(name)s: Wedding anniversary in %(count)d days.",
                tage_hin) % {"name": name, "count": tage_hin}
    else:
        kopf = _("Anniversary")
        rumpf = _("%s: Anniversary %s (%s).") % (
            name, wann, jahrestag_typ_text(typ) or _("Other"))
    return kopf, rumpf


def faellige_jahrestage(daten, jetzt, ergebnis=None, tage_vorher=0,
                        auch_am_tag=True, stunde=8):
    """Sucht Jahrestage, an die zu erinnern ist – wahlweise ein bis sieben
    Tage vorher und noch einmal am Tag selbst."""
    from datetime import timedelta
    ergebnis = ergebnis or {"faellig": [], "verpasst": [],
                            "zustand": {"gemeldet": {}, "letzter_lauf": ""}}
    gemeldet = ergebnis["zustand"].setdefault("gemeldet", {})

    abstaende = []
    if tage_vorher:
        abstaende.append(int(tage_vorher))
    if auch_am_tag or not tage_vorher:
        abstaende.append(0)

    for jahrestag in (daten or {}).get("jahrestage") or []:
        if not isinstance(jahrestag, dict):
            continue
        kennung = str(jahrestag.get("id") or jahrestag.get("uid") or "")
        if not kennung:
            continue
        for jahr in (jetzt.year, jetzt.year + 1):
            termin = _jahrestag_im_jahr(jahrestag, jahr)
            if termin is None:
                continue
            for abstand in abstaende:
                zeitpunkt = termin.replace(hour=max(0, min(23, stunde)),
                                           minute=0) - timedelta(days=abstand)
                marke = "jt-%s-%d-%d" % (kennung, jahr, abstand)
                if marke in gemeldet:
                    continue
                if jetzt < zeitpunkt:
                    continue
                if jetzt > zeitpunkt + timedelta(hours=14):
                    gemeldet[marke] = jetzt.strftime("%Y-%m-%d %H:%M")
                    continue          # zu lange her, still abhaken
                kopf, rumpf = jahrestagstext(jahrestag, abstand)
                ergebnis["faellig"].append({
                    "id": marke, "titel": rumpf, "jahrestag": True,
                    "kopf": kopf, "datum": termin.strftime("%Y-%m-%d"),
                    "zeit": "", "verpasst": False,
                    "beginn": zeitpunkt.strftime("%Y-%m-%d %H:%M")})
                gemeldet[marke] = jetzt.strftime("%Y-%m-%d %H:%M")
    return ergebnis


def faellige_aufgaben(daten, jetzt, ergebnis=None, stunde=8):
    """Sucht Aufgaben, an die am Fälligkeitstag oder vorher zu erinnern ist.

    Gemeldet wird am Morgen des Fälligkeitstages – und nur, wenn die
    Aufgabe noch offen ist und ausdrücklich eine Erinnerung wünscht."""
    from datetime import timedelta
    ergebnis = ergebnis or {"faellig": [], "verpasst": [],
                            "zustand": {"gemeldet": {}, "letzter_lauf": ""}}
    gemeldet = ergebnis["zustand"].setdefault("gemeldet", {})

    for aufgabe in (daten or {}).get("aufgaben") or []:
        if not isinstance(aufgabe, dict):
            continue
        tage = _erinnerung_tage(aufgabe.get("individuelleErinnerungTage"))
        if not aufgabe.get("erinnern") and not 1 <= tage <= 7:
            continue
        if aufgabe.get("erledigt"):
            continue
        datum = (aufgabe.get("faellig") or "").strip()
        if len(datum) < 10:
            continue
        try:
            faelligkeit = datetime.strptime(datum, "%Y-%m-%d").replace(
                hour=max(0, min(23, stunde)))
            zeit = str(aufgabe.get("faelligZeit") or "")
            if len(zeit) == 5:
                uhr = datetime.strptime(zeit, "%H:%M")
                faelligkeit = faelligkeit.replace(hour=uhr.hour, minute=uhr.minute)
        except ValueError:
            continue
        basis_marke = "af-%s-%s-%s" % (
            aufgabe.get("id") or "?", datum,
            faelligkeit.strftime("%H%M"))
        alte_basis_marke = "af-%s-%s" % (aufgabe.get("id") or "?", datum)
        meldungen = []
        if aufgabe.get("erinnern"):
            meldungen.append((basis_marke, faelligkeit, 0, alte_basis_marke))
        if 1 <= tage <= 7:
            meldungen.append((basis_marke + "-vorher-%d" % tage,
                              faelligkeit - timedelta(days=tage), tage,
                              alte_basis_marke + "-vorher-%d" % tage))
        for marke, zeitpunkt, tage_vorher, alte_marke in meldungen:
            if marke not in gemeldet and alte_marke in gemeldet:
                gemeldet[marke] = gemeldet[alte_marke]
            if marke in gemeldet or jetzt < zeitpunkt:
                continue
            if jetzt > zeitpunkt + timedelta(hours=14):
                gemeldet[marke] = jetzt.strftime("%Y-%m-%d %H:%M")
                continue
            wer = ", ".join(n for n in (aufgabe.get("personenNamen") or []) if n)
            ergebnis["faellig"].append({
                "id": marke, "aufgabe": True,
                "kopf": _("Task reminder") if tage_vorher else _("Task is due"),
                "titel": aufgabe.get("titel") or _("Task"),
                "wer": wer, "individuelleTage": tage_vorher,
                "datum": datum, "zeit": faelligkeit.strftime("%H:%M"), "verpasst": False,
                "beginn": zeitpunkt.strftime("%Y-%m-%d %H:%M")})
            gemeldet[marke] = jetzt.strftime("%Y-%m-%d %H:%M")
    return ergebnis


def erinnerungstext(eintrag):
    """Kurzer lokalisierter Satz für eine Benachrichtigung."""
    if eintrag.get("jahrestag"):
        return eintrag.get("kopf") or _("Anniversary"), eintrag.get("titel") or ""
    if eintrag.get("aufgabe"):
        rumpf = eintrag.get("titel") or _("Task")
        tage = int(eintrag.get("individuelleTage") or 0)
        if tage:
            rumpf += " – " + ngettext("due in %d day", "due in %d days",
                                       tage) % tage
        if eintrag.get("wer"):
            rumpf += " – " + eintrag["wer"]
        return eintrag.get("kopf") or _("Task is due"), rumpf
    wann = eintrag.get("zeit") or ""
    tage = int(eintrag.get("individuelleTage") or 0)
    if tage and not eintrag.get("verpasst"):
        return (_("Appointment reminder"), "%s – %s" % (
            eintrag.get("titel", ""),
            ngettext("in %d day", "in %d days", tage) % tage))
    datum = eintrag.get("datum") or ""
    try:
        tag = datum_kurz(datetime.strptime(datum, "%Y-%m-%d"))
    except (TypeError, ValueError):
        tag = datum
    if eintrag.get("verpasst"):
        kopf = _("Missed appointment")
        rumpf = _("%(title)s – %(date)s%(time)s") % {
            "title": eintrag.get("titel", ""), "date": tag,
            "time": (_(" at %s") % wann) if wann else ""}
    else:
        kopf = _("Appointment is due")
        rumpf = _("%s – today at %s") % (eintrag.get("titel", ""), wann) \
            if wann else _("%s – today") % eintrag.get("titel", "")
    return kopf, rumpf


def finde_klang_datei():
    """Sucht den mitgelieferten Erinnerungsklang."""
    kandidaten = []
    aus_umgebung = os.environ.get("MAGNOLIE_ORGANIZER_KLANG")
    if aus_umgebung:
        kandidaten.append(aus_umgebung)
    skript = os.path.dirname(os.path.realpath(__file__))
    kandidaten += [
        "/usr/share/magnolie-organizer/klang/erinnerung.wav",
        os.path.join(skript, "..", "share", "magnolie-organizer",
                     "klang", "erinnerung.wav"),
        os.path.join(skript, "..", "klang", "erinnerung.wav"),
        os.path.join(skript, "klang", "erinnerung.wav"),
    ]
    for pfad in kandidaten:
        if pfad and os.path.isfile(pfad):
            return os.path.realpath(pfad)
    return ""


def klang_befehle(datei):
    """Wege, eine Klangdatei abzuspielen – der erste vorhandene gewinnt."""
    return [
        ["paplay", datei],
        ["pw-play", datei],
        ["aplay", "-q", datei],
        ["canberra-gtk-play", "-f", datei],
        ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", datei],
    ]


TON_BEFEHLE = [
    ["canberra-gtk-play", "-i", "message"],
    ["paplay", "/usr/share/sounds/freedesktop/stereo/message.oga"],
    ["aplay", "-q", "/usr/share/sounds/sound-icons/prompt.wav"],
]


class AnrufLautstaerke:
    """Temporarily ducks one default sink and restores its exact percentage."""
    def __init__(self, runner=None, finder=None):
        self.runner = runner or subprocess.run
        self.finder = finder or shutil.which
        self.saved = None

    def lower(self, call_ref):
        if self.saved:
            return self.saved[0] == call_ref
        pactl = self.finder("pactl")
        if not pactl:
            return False
        try:
            sink_result = self.runner([pactl, "get-default-sink"], capture_output=True,
                text=True, timeout=3, check=False)
            sink = sink_result.stdout.strip()
            volume_result = self.runner([pactl, "get-sink-volume", sink],
                capture_output=True, text=True, timeout=3, check=False)
            values = [int(value) for value in re.findall(r"\b([0-9]{1,3})%", volume_result.stdout)]
            if sink_result.returncode or volume_result.returncode or not sink or not values:
                return False
            original = values[0]
            target = min(25, max(1, round(original * .25)))
            changed = self.runner([pactl, "set-sink-volume", sink, str(target) + "%"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3,
                check=False)
            if changed.returncode:
                return False
            self.saved = (call_ref, sink, original)
            return True
        except (OSError, subprocess.SubprocessError, AttributeError):
            return False

    def restore(self, call_ref=None):
        saved = self.saved
        if not saved or call_ref is not None and saved[0] != call_ref:
            return False
        self.saved = None
        pactl = self.finder("pactl")
        if not pactl:
            return False
        try:
            return self.runner([pactl, "set-sink-volume", saved[1], str(saved[2]) + "%"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3,
                check=False).returncode == 0
        except (OSError, subprocess.SubprocessError):
            return False


class AnrufBluetooth:
    """Switches the Bluetooth radio on for a call and restores its prior state.

    Den Ton eines Anrufs uebertraegt nicht der Organizer, sondern das Telefon
    selbst ueber das Bluetooth-Freisprechprofil; der Organizer steuert nur.
    Damit der Ton am Rechner ankommt, muss der Funk an sein - und damit man ihn
    nicht dauerhaft laufen lassen muss, geschieht das nur rund um das Gespraech.

    Ausgeschaltet wird ausschliesslich, was diese Klasse selbst eingeschaltet
    hat und was seither niemand sonst abgeschaltet hat. Wer eine
    Bluetooth-Maus oder Kopfhoerer benutzt, hatte den Funk vorher an; dann
    bleibt er an. Ein pauschales "nach dem Gespraech aus" risse solche Geraete
    mit.
    """
    def __init__(self, runner=None, finder=None):
        self.runner = runner or subprocess.run
        self.finder = finder or shutil.which
        self.saved = None

    def _powered(self, tool):
        """True, False oder None, wenn der Zustand nicht zu ermitteln ist."""
        result = self.runner([tool, "show"], capture_output=True, text=True,
            timeout=3, check=False)
        if result.returncode:
            return None
        for line in (result.stdout or "").splitlines():
            if line.strip().startswith("Powered:"):
                return line.split(":", 1)[1].strip() == "yes"
        return None

    def ensure(self, call_ref):
        if self.saved:
            return self.saved[0] == call_ref
        tool = self.finder("bluetoothctl")
        if not tool:
            return False
        try:
            if self._powered(tool) is not False:
                return False
            changed = self.runner([tool, "power", "on"], stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, timeout=5, check=False)
            if changed.returncode:
                return False
            self.saved = (call_ref,)
            return True
        except (OSError, subprocess.SubprocessError, AttributeError):
            return False

    def restore(self, call_ref=None):
        saved = self.saved
        if not saved or call_ref is not None and saved[0] != call_ref:
            return False
        self.saved = None
        tool = self.finder("bluetoothctl")
        if not tool:
            return False
        try:
            if self._powered(tool) is not True:
                return False
            return self.runner([tool, "power", "off"], stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, timeout=5, check=False).returncode == 0
        except (OSError, subprocess.SubprocessError, AttributeError):
            return False


_ANRUF_LAUTSTAERKE = AnrufLautstaerke()
_ANRUF_BLUETOOTH = AnrufBluetooth()


def ton_abspielen(befehle=None, starter=None, eigener=True):
    """Spielt einen kurzen Hinweiston. Bevorzugt wird der mitgelieferte
    Klang der Magnolie; sonst meldet sich der Hinweiston des Systems.
    Liefert den benutzten Befehl."""
    import subprocess
    if befehle is None:
        datei = finde_klang_datei() if eigener else ""
        befehle = (klang_befehle(datei) if datei else []) + TON_BEFEHLE
    starter = starter or (lambda argumente: subprocess.Popen(
        argumente, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
    for argumente in befehle:
        werkzeug = shutil.which(argumente[0])
        if not werkzeug:
            continue
        try:
            prozess = starter([werkzeug] + argumente[1:])
            if prozess is None or not hasattr(prozess, "wait"):
                return argumente[0]
            try:
                status = prozess.wait(timeout=0.15)
            except subprocess.TimeoutExpired:
                return argumente[0]
            if status == 0:
                return argumente[0]
        except (OSError, subprocess.SubprocessError):
            continue
    return ""


def systemd_dienst_text(programm=None):
    programm = (programm or eigener_pfad()).replace("\\", "\\\\").replace(
        '"', '\\"')
    return (
        "[Unit]\n"
        "Description=" + _("Magnolie Organizer – appointment reminders") + "\n"
        "After=graphical-session.target\n"
        "\n"
        "[Service]\n"
        "Type=oneshot\n"
        "TimeoutStartSec=100\n"
        "ExecStart=\"" + programm + "\" --erinnerung\n")


def systemd_wecker_text():
    return (
        "[Unit]\n"
        "Description=" + _("Magnolie Organizer – check appointments regularly") + "\n"
        "\n"
        "[Timer]\n"
        "OnCalendar=*:0/1\n"
        "OnStartupSec=45\n"
        "Persistent=true\n"
        "AccuracySec=20s\n"
        "Unit=%s.service\n"
        "\n"
        "[Install]\n"
        "WantedBy=timers.target\n" % ERINNERUNG_EINHEIT)


def systemd_verzeichnis():
    basis = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(basis, "systemd", "user")


def schreibe_wenn_anders(pfad, inhalt):
    """Schreibt nur, wenn sich etwas geändert hat. Das spart bei jedem
    Programmstart überflüssige Schreibvorgänge und – bei systemd – ein
    unnötiges Neueinlesen der Dienste."""
    try:
        with open(pfad, "r", encoding="utf-8") as datei:
            if datei.read() == inhalt:
                return False
    except OSError:
        pass
    os.makedirs(os.path.dirname(pfad), exist_ok=True)
    with open(pfad, "w", encoding="utf-8") as datei:
        datei.write(inhalt)
    return True


DESKTOP_APP_ID = "io.gitlab.maik3531.MagnolieOrganizer"
DESKTOP_ID = DESKTOP_APP_ID + ".desktop"
SYSTEMKALENDER_DESKTOP = PROGRAMM_NAME + ".desktop"  # frühere MIME-Zuordnung
SYSTEMKALENDER_TYP = "text/calendar"


def systemkalender_merkdatei():
    basis = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(basis, PROGRAMM_NAME, "systemkalender.json")


def _systemkalender_standard(mime_typ, abfrager=None):
    if abfrager:
        return str(abfrager(mime_typ) or "").strip()
    werkzeug = shutil.which("xdg-mime")
    if not werkzeug:
        return ""
    import subprocess
    try:
        lauf = subprocess.run(
            [werkzeug, "query", "default", mime_typ], capture_output=True,
            text=True, timeout=10, env=dict(os.environ, LC_ALL="C"))
    except (OSError, subprocess.SubprocessError):
        return ""
    return lauf.stdout.strip() if lauf.returncode == 0 else ""


def _systemkalender_setzen(mime_typ, desktop, setzer=None):
    if setzer:
        return bool(setzer(mime_typ, desktop))
    werkzeug = shutil.which("xdg-mime")
    if not werkzeug:
        return False
    import subprocess
    try:
        return subprocess.run(
            [werkzeug, "default", desktop, mime_typ],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=10, env=dict(os.environ, LC_ALL="C")).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def _systemkalender_mimeapps_dateien():
    konfig = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    daten = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    dateien = [os.path.join(konfig, "mimeapps.list"),
               os.path.join(daten, "applications", "mimeapps.list")]
    desktop = (os.environ.get("XDG_CURRENT_DESKTOP") or "").split(":")[0].lower()
    if desktop:
        dateien.insert(0, os.path.join(konfig, desktop + "-mimeapps.list"))
    return dateien


def _systemkalender_ersatz(cache_dateien=None):
    """Findet einen anderen installierten Kalenderhandler aus dem MIME-Cache."""
    if cache_dateien is None:
        daten = [os.environ.get("XDG_DATA_HOME") or
                 os.path.expanduser("~/.local/share")]
        daten.extend((os.environ.get("XDG_DATA_DIRS") or
                      "/usr/local/share:/usr/share").split(":"))
        cache_dateien = [os.path.join(pfad, "applications", "mimeinfo.cache")
                         for pfad in daten if pfad]
    for pfad in cache_dateien:
        try:
            with open(pfad, "r", encoding="utf-8") as datei:
                zeilen = datei.readlines()
        except OSError:
            continue
        for zeile in zeilen:
            if "=" not in zeile:
                continue
            mime_typ, werte = zeile.strip().split("=", 1)
            if mime_typ != SYSTEMKALENDER_TYP:
                continue
            for desktop in werte.split(";"):
                if (desktop and desktop != SYSTEMKALENDER_DESKTOP and
                        re.match(r"^[A-Za-z0-9_.+\-]+\.desktop$", desktop)):
                    return desktop
    return ""


def _systemkalender_standard_entfernen(mime_typ, dateien=None):
    """Entfernt nur Magnolies eigene Default-Zeile aus Benutzerdateien."""
    geaendert = False
    for pfad in dateien or _systemkalender_mimeapps_dateien():
        try:
            with open(pfad, "r", encoding="utf-8") as datei:
                zeilen = datei.readlines()
        except OSError:
            continue
        sektion = ""
        neu = []
        datei_geaendert = False
        for zeile in zeilen:
            streifen = zeile.strip()
            if streifen.startswith("[") and streifen.endswith("]"):
                sektion = streifen[1:-1]
            if sektion == "Default Applications" and "=" in zeile:
                schluessel, werte = zeile.split("=", 1)
                if schluessel.strip() == mime_typ:
                    vorher = [wert for wert in werte.strip().split(";") if wert]
                    eintraege = [wert for wert in vorher
                                 if wert != SYSTEMKALENDER_DESKTOP]
                    if len(eintraege) != len(vorher):
                        datei_geaendert = True
                        if eintraege:
                            neu.append(schluessel + "=" + ";".join(eintraege) + ";\n")
                        continue
            neu.append(zeile)
        if datei_geaendert:
            try:
                with open(pfad, "w", encoding="utf-8") as datei:
                    datei.writelines(neu)
                geaendert = True
            except OSError:
                pass
    return geaendert


def systemkalender_bereinigen(merkdatei=None, abfrager=None, setzer=None,
                               mimeapps=None, ersatz=None):
    """Entfernt ausschließlich die frühere Systemkalender-Zuordnung."""
    merkdatei = merkdatei or systemkalender_merkdatei()
    vorher = {}
    try:
        with open(merkdatei, "r", encoding="utf-8") as datei:
            vorher = (json.load(datei) or {}).get("vorher") or {}
    except (OSError, ValueError, TypeError):
        vorher = {}
    aktuell = _systemkalender_standard(SYSTEMKALENDER_TYP, abfrager)
    if aktuell == SYSTEMKALENDER_DESKTOP:
        alt = str(vorher.get(SYSTEMKALENDER_TYP) or ersatz or
                  _systemkalender_ersatz()).strip()
        if alt and alt != SYSTEMKALENDER_DESKTOP:
            if not _systemkalender_setzen(SYSTEMKALENDER_TYP, alt, setzer):
                return False
        elif setzer:
            setzer(SYSTEMKALENDER_TYP, "")
        else:
            _systemkalender_standard_entfernen(SYSTEMKALENDER_TYP, mimeapps)
    try:
        os.remove(merkdatei)
    except OSError:
        pass
    return True


def erinnerungsdienst_einrichten(an, ordner=None, laufer=None):
    """Legt den Dienst der Sitzung an oder entfernt ihn wieder."""
    import subprocess
    ordner = ordner or systemd_verzeichnis()
    laufer = laufer or (lambda argumente: subprocess.run(
        argumente, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        timeout=20).returncode)
    dienst = os.path.join(ordner, ERINNERUNG_EINHEIT + ".service")
    wecker = os.path.join(ordner, ERINNERUNG_EINHEIT + ".timer")

    # Der Autostart-Eintrag ist der verlässliche Weg: Er startet den Wecker
    # in der angemeldeten Sitzung. Der Dienst unten kommt als Rückhalt dazu.
    eintrag = autostart_einrichten(an)

    if not shutil.which("systemctl"):
        return {"ok": eintrag["ok"], "fehler": eintrag["fehler"] or
                _("Reminders are running through session autostart; systemd was "
                  "not found on this system.")}
    try:
        if an:
            os.makedirs(ordner, exist_ok=True)
            geaendert = schreibe_wenn_anders(dienst, systemd_dienst_text())
            geaendert |= schreibe_wenn_anders(wecker, systemd_wecker_text())
            if geaendert:
                laufer(["systemctl", "--user", "daemon-reload"])
            fehlschlag = laufer(["systemctl", "--user", "enable", "--now",
                                 ERINNERUNG_EINHEIT + ".timer"])
        else:
            laufer(["systemctl", "--user", "disable", "--now",
                    ERINNERUNG_EINHEIT + ".timer"])
            for pfad in (dienst, wecker):
                if os.path.exists(pfad):
                    os.remove(pfad)
            laufer(["systemctl", "--user", "daemon-reload"])
            fehlschlag = 0
    except (OSError, subprocess.SubprocessError) as fehler:
        return {"ok": False, "fehler": fehler_deutsch(
            fehler, _("Setting up reminders"))}
    if fehlschlag and not eintrag["ok"]:
        return {"ok": False, "fehler":
                _("Reminders could not be set up. They will be shown only while "
                  "the organizer is open.")}
    return {"ok": True, "fehler": eintrag["fehler"]}


def weckruf_befehl(zeitpunkt, programm=None):
    """Baut den Befehl, der den Rechner zur genannten Zeit aufwecken soll."""
    # Eine Wandzeit in der Frühlingslücke wird auf den ersten realen Zeitpunkt
    # danach verschoben. Bei der doppelten Herbststunde gilt bewusst fold=0;
    # die persistente Meldemarke verhindert eine zweite Zustellung.
    try:
        zone_objekt = _organizer_zeitzone()
        eindeutig = zeitpunkt.replace(tzinfo=zone_objekt, fold=0)
        zeitpunkt = eindeutig.astimezone(timezone.utc).astimezone(
            zone_objekt).replace(tzinfo=None)
    except (AttributeError, OverflowError, ValueError):
        pass
    kalenderzeit = zeitpunkt.strftime("%Y-%m-%d %H:%M:%S")
    zone = _zeitzonenname()
    if zone:
        kalenderzeit += " " + zone
    return ["systemd-run", "--user",
            "--on-calendar=" + kalenderzeit,
            "--timer-property=WakeSystem=true",
            "--timer-property=AccuracySec=30s",
            "--unit=" + ERINNERUNG_EINHEIT + "-weckruf",
            programm or eigener_pfad(), "--erinnerung"]


def weckruf_stellen(zeitpunkt, laufer=None):
    """Versucht, den Rechner zur Erinnerung aus der Bereitschaft zu holen.
    Das darf nicht jede Sitzung – misslingt es, wird das ehrlich gemeldet."""
    import subprocess
    laufer = laufer or (lambda argumente: subprocess.run(
        argumente, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        timeout=20).returncode)
    try:
        laufer(["systemctl", "--user", "stop",
                ERINNERUNG_EINHEIT + "-weckruf.timer"])
    except Exception:
        pass
    if zeitpunkt is None:
        return {"ok": False, "fehler": _("No appointment is scheduled.")}
    if not shutil.which("systemd-run"):
        return {"ok": False, "fehler":
                _("systemd-run is required to schedule wake-up reminders on this "
                  "system.")}
    try:
        schluss = laufer(weckruf_befehl(zeitpunkt))
    except (OSError, subprocess.SubprocessError) as fehler:
        return {"ok": False, "fehler": fehler_deutsch(fehler,
                                                        _("The wake-up reminder"))}
    if schluss:
        return {"ok": False, "fehler":
                _("This system did not allow waking from suspend. The reminder "
                  "will appear as soon as the computer is running again.")}
    return {"ok": True, "fehler": ""}


def organizer_starten(starter=None):
    """Öffnet den Organizer aus einer Benachrichtigung heraus.

    Der Hintergrunddienst erbt nicht immer die Umgebung der Sitzung – ein
    schlichter Programmaufruf scheitert dort an der fehlenden Anzeige.
    Deshalb geht der Start bevorzugt über den Desktop-Eintrag."""
    import subprocess
    if starter is None:
        try:
            from gi.repository import Gio
            eintrag = Gio.DesktopAppInfo.new(DESKTOP_ID)
            if eintrag is not None:
                eintrag.launch([], None)
                return "desktop-eintrag"
        except Exception:
            pass

        def starter(argumente):
            umgebung = dict(os.environ)
            umgebung.setdefault("DISPLAY", ":0")
            subprocess.Popen(argumente, env=umgebung, start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    for argumente in (
            ["gtk-launch", DESKTOP_APP_ID],
            ["gio", "launch", "/usr/share/applications/%s" % DESKTOP_ID],
            [eigener_pfad()]):
        werkzeug = (shutil.which(argumente[0]) if not argumente[0].startswith("/")
                    else (argumente[0] if os.path.exists(argumente[0]) else None))
        if not werkzeug:
            continue
        try:
            starter([werkzeug] + argumente[1:])
            return argumente[0]
        except OSError:
            continue
    return ""


def handbuch_installiert():
    return bool(shutil.which(HANDBUCH_NAME))


def handbuch_version(befehls_laeufer=None):
    """Liest die installierte Paketfassung ohne sichtbaren Handbuchtext."""
    laeufer = befehls_laeufer or subprocess.check_output
    befehle = []
    if shutil.which("dpkg-query"):
        befehle.append(["dpkg-query", "-W", "-f=${Version}", HANDBUCH_NAME])
    starter = shutil.which(HANDBUCH_NAME)
    if starter:
        befehle.append([starter, "--version"])
    for befehl in befehle:
        try:
            text = laeufer(befehl, stderr=subprocess.DEVNULL, timeout=3,
                           text=True).strip()
        except (OSError, subprocess.SubprocessError):
            continue
        if versions_schluessel(text):
            return text
    return ""


def handbuch_oeffnen(starter=None):
    """Öffnet ausschließlich das installierte Magnolie-Handbuch."""
    import subprocess
    pfad = shutil.which(HANDBUCH_NAME)
    if not pfad:
        return {"ok": False, "fehler": _("The Magnolie manual is not installed.")}
    if starter is None:
        starter = lambda argumente: subprocess.Popen(
            argumente, start_new_session=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        starter([pfad])
    except (OSError, subprocess.SubprocessError) as fehler:
        return {"ok": False, "fehler": fehler_deutsch(fehler, _("The manual"))}
    return {"ok": True, "fehler": ""}


_SYSTEM_MELDUNGEN = set()


def benachrichtigen(kopf, rumpf, mit_aktion=True, wartezeit=60,
                    aktionsname=None, aktion=None, eigene_schleife=True):
    """Zeigt eine Desktop-Benachrichtigung, auf Wunsch mit einem Knopf zum
    Öffnen des Organizers."""
    import subprocess
    try:
        import gi
        gi.require_version("Notify", "0.7")
        from gi.repository import Notify, GLib as _GLib
    except (ImportError, ValueError):
        werkzeug = shutil.which("notify-send")
        if not werkzeug:
            return False
        try:
            subprocess.Popen([werkzeug, "-a", FENSTER_TITEL, kopf, rumpf],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        except OSError:
            return False

    try:
        Notify.init(FENSTER_TITEL)
        meldung = Notify.Notification.new(kopf, rumpf, PROGRAMM_NAME)
        try:
            meldung.set_hint("desktop-entry",
                             _GLib.Variant("s", DESKTOP_APP_ID))
        except Exception:
            pass
        if not mit_aktion:
            meldung.show()
            return True

        schleife = _GLib.MainLoop() if eigene_schleife else None

        def abschliessen():
            _SYSTEM_MELDUNGEN.discard(meldung)
            if schleife is not None:
                schleife.quit()

        def oeffnen(*_egal):
            if aktion:
                aktion()
            else:
                organizer_starten()
            abschliessen()

        meldung.add_action("oeffnen", aktionsname or _("Open organizer"), oeffnen)
        meldung.connect("closed", lambda *_egal: abschliessen())
        meldung.show()
        if not eigene_schleife:
            _SYSTEM_MELDUNGEN.add(meldung)
            if wartezeit:
                _GLib.timeout_add_seconds(max(5, wartezeit), lambda: (
                    meldung.close(), False)[1])
            return True
        if wartezeit:
            _GLib.timeout_add_seconds(max(5, wartezeit),
                                      lambda: (schleife.quit(), False)[1])
        schleife.run()
        return True
    except Exception:
        return False


