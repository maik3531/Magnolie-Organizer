msgid ""
"A component for spelling suggestions is missing. Install it with:  sudo apt "
"install %s"
msgstr ""
"Brakuje składnika podpowiedzi pisowni. Zainstaluj go poleceniem:  sudo apt "
"install %s"

msgid "A component required by the Magnolienbaum is missing."
msgstr "Brakuje składnika wymaganego przez Magnolienbaum."

