msgstr "Det nødvendige gendannelsesøjebliksbillede kunne ikke oprettes."

msgid "The response is too large."
msgstr "Svaret er for stort."

msgid ""
"The same code must appear on both computers:\n"
"\n"
"%(code)s\n"
"\n"
"Other branch: %(branch)s\n"
"Fingerprint: %(fingerprint)s\n"
"\n"
"Does the code match?"
msgstr ""
"Den samme kode skal vises på begge computere:\n"
"\n"
"%(code)s\n"
"\n"
"Anden gren: %(branch)s\n"
"Fingeraftryk: %(fingerprint)s\n"
"\n"
"Er koden den samme?"

msgid "The save request is invalid."
msgstr "Gemmeanmodningen er ugyldig."

msgid "The secure interface could not be registered."
msgstr "Den sikre brugerflade kunne ikke registreres."

msgid "The secure message could not be opened."
msgstr "Den sikre besked kunne ikke åbnes."

msgid "The secure message is invalid."
msgstr "Den sikre besked er ugyldig."

msgid "The secure session has already been used."
msgstr "Den sikre session er allerede blevet brugt."

msgid "The secure session is damaged."
msgstr "Den sikre session er beskadiget."

msgid "The secure session is unknown or expired."
msgstr "Den sikre session er ukendt eller udløbet."

msgid "The secure session request is invalid."
msgstr "Anmodningen om sikker session er ugyldig."

msgid "The secure session response is invalid."
msgstr "Svaret fra den sikre session er ugyldigt."

msgid "The selected Magnolie Notes phone is not available for dial requests."
msgstr ""
"Den valgte Magnolie Notes-telefon er ikke tilgængelig for opkaldsanmodninger."

msgid "The selected Nextcloud DAV source was not found."
msgstr "Den valgte Nextcloud DAV-kilde blev ikke fundet."

msgid "The selected contacts contain no values for these columns."
msgstr "De valgte kontakter indeholder ingen værdier for disse kolonner."

msgid "The selected file is not a readable CSV file."
msgstr "Den valgte fil er ikke en læsbar CSV-fil."

msgid "The selected file is not a readable iCalendar file."
msgstr "Den valgte fil er ikke en læsbar iCalendar-fil."

msgid "The selected health records contain no printable values."
msgstr ""
"De valgte sundhedsoptegnelser indeholder ingen værdier, der kan udskrives."

msgid "The selected iCalendar file is incomplete."
msgstr "Den valgte iCalendar-fil er ufuldstændig."

msgid "The selected path is not a regular file."
msgstr "Den valgte sti er ikke en almindelig fil."

msgid "The selected source was not found. Select it again in Settings."
msgstr "Den valgte kilde blev ikke fundet. Vælg den igen under Indstillinger."

msgid ""
"The server operator can see the account, folder and file names, sizes and "
"times of your messages."
msgstr ""
"Serverudbyderen kan se konto, mappe- og filnavne, størrelser og tidspunkter "
"for dine beskeder."

msgid "The service returned no entries for this selection."
msgstr "Tjenesten returnerede ingen poster for dette valg."

msgid ""
"The sheet appears at the edge of the screen, accompanied by the Magnolie "
"chime."
msgstr "Arket vises ved kanten af skærmen sammen med Magnolie-lyden."

msgid ""
"The small uniform icons open an installed application when possible. "
"Otherwise, a secure web service is used in the browser."
msgstr ""
"De små ensartede ikoner åbner et installeret program, når det er muligt. "
"Ellers bruges en sikker webtjeneste i browseren."

msgid "The snapshot operation failed."
msgstr "Øjebliksbilledhandlingen mislykkedes."

msgid "The start date must not be after the end date."
msgstr "Startdatoen må ikke ligge efter slutdatoen."

msgid "The synchronization resume journal is damaged."
msgstr "Journalen til genoptagelse af synkroniseringen er beskadiget."

msgid "The system dialer opens on the phone. Confirm the call there."
msgstr "Systemopkaldet åbner på telefonen. Bekræft opkaldet der."

msgid "The task is missing from the update."
msgstr "Opgaven mangler i opdateringen."

msgid ""
"The task will be sent to the selected branch. It will also remain here so "
"you can keep track of it."
msgstr ""
"Opgaven sendes til den valgte gren. Den bliver også her, så du fortsat kan "
"følge den."

msgid ""
"The traffic-light colors are general reference ranges for adults, not a "
"diagnosis. Check abnormal readings and discuss them with a doctor; seek "
"immediate medical help for severe symptoms."
msgstr ""
"Trafiklysfarverne viser generelle referenceområder for voksne, ikke en "
"diagnose. Kontrollér unormale målinger, og drøft dem med en læge. Søg straks "
"lægehjælp ved alvorlige symptomer."

#, python-format
msgid "The tray applet could not be started: %s"
msgstr "Panelappletten kunne ikke startes: %s"

msgid "The tray applet is not available on this system."
msgstr "Panelappletten er ikke tilgængelig på dette system."

msgid ""
"The tray applet requires Ayatana AppIndicator. On plain GNOME, the "
"AppIndicator extension is also required."
msgstr ""
"Panelappletten kræver Ayatana AppIndicator. På almindelig GNOME kræves "
"desuden AppIndicator-udvidelsen."

msgid "The trust setting is invalid."
msgstr "Tillidsindstillingen er ugyldig."

msgid "The two entries do not match."
msgstr "De to poster stemmer ikke overens."

msgid "The two new passwords do not match."
msgstr "De to nye adgangskoder stemmer ikke overens."

msgid "The update check failed."
msgstr "Opdateringskontrollen mislykkedes."

msgid "The update information does not contain a valid package checksum."
msgstr "Opdateringsoplysningerne indeholder ikke en gyldig pakkekontrolsum."

msgid "The update information does not contain a valid version."
msgstr "Opdateringsoplysningerne indeholder ikke en gyldig version."

msgid "The update information does not refer to an allowed package URL."
msgstr "Opdateringsoplysningerne henviser ikke til en tilladt pakke-URL."

msgid "The update information has an invalid signature."
msgstr "Opdateringsoplysningerne har en ugyldig signatur."

#, python-format
