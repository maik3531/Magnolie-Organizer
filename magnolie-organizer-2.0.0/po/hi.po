msgstr "Claws Mail पता-पुस्तिका में बहुत अधिक लोग हैं।"

msgid "The Claws Mail address book is larger than 32 megabytes."
msgstr "Claws Mail पता-पुस्तिका 32 मेगाबाइट से बड़ी है।"

msgid "The Contributor Key is invalid."
msgstr "Contributor Key अमान्य है।"

msgid "The DAV ETag is missing."
msgstr "DAV ETag गायब है।"

