msgid_plural ""
"The %(count)s note pages it contains will be moved to “%(notebook)s”."
msgstr[0] "इसमें मौजूद %(count)s नोट पृष्ठ “%(notebook)s” में ले जाया जाएगा।"
msgstr[1] "इसमें मौजूद %(count)s नोट पृष्ठ “%(notebook)s” में ले जाए जाएँगे।"

msgid "The CSV columns were not recognized."
msgstr "CSV कॉलम पहचाने नहीं गए।"

