#!/usr/bin/make -f
# Regelwerk des Magnolie Organizers – reine Skript-Installation ohne Kompilat.

JS_LAUFER := $(shell command -v node 2>/dev/null || command -v nodejs 2>/dev/null || command -v bun 2>/dev/null)
SOURCE_DATE_EPOCH ?= $(shell dpkg-parsechangelog -STimestamp)
export SOURCE_DATE_EPOCH

%:
	dh $@

# Kataloge erzeugen und die Python-Syntax prüfen.
override_dh_auto_build:
	python3 werkzeuge/klang.py klang/erinnerung.wav
	mkdir -p web/i18n
	set -e; while read sprache; do \
		mkdir -p locale/$$sprache/LC_MESSAGES; \
		msgfmt --check --check-format -o locale/$$sprache/LC_MESSAGES/magnolie-organizer.mo po/$$sprache.po; \
		python3 werkzeuge/po_zu_js.py $$sprache po/$$sprache.po web/i18n/$$sprache.js; \
	done < po/LINGUAS
	python3 -m py_compile bin/magnolie-organizer bin/magnolie_crash.py bin/magnolie_asset.py bin/magnolie_hintergrund.py bin/magnolie_kdeconnect.py bin/magnolie_telefon.py bin/magnolie_personal_sync.py bin/magnolie_nextcloud.py bin/magnolie_cloud_backup.py bin/magnolie_akonadi.py

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	set -e; while read sprache; do \
		python3 werkzeuge/katalog_pruefen.py po/magnolie-organizer.pot po/$$sprache.po; \
	done < po/LINGUAS
	python3 -m pytest -q pruefungen/test_locale_completeness.py
	mkdir -p debian/test-data debian/test-config
	DISPLAY= WAYLAND_DISPLAY= XDG_DATA_HOME=$(CURDIR)/debian/test-data XDG_CONFIG_HOME=$(CURDIR)/debian/test-config TZ=Europe/Berlin python3 pruefungen/test_parser.py
	TZ=Europe/Berlin python3 pruefungen/test_import_export_vertrag.py
	TZ=Europe/Berlin python3 pruefungen/test_gesamtarchiv.py
	TZ=Europe/Berlin python3 pruefungen/test_telefon.py
	TZ=Europe/Berlin python3 -m pytest -q pruefungen/test_asset_container.py pruefungen/test_kdeconnect.py pruefungen/test_personal_sync.py pruefungen/test_nextcloud.py pruefungen/test_hintergrunddienst.py pruefungen/test_naechster_weckzeitpunkt.py pruefungen/test_eds_adressbuch_sync.py pruefungen/test_chromium_fallback.py pruefungen/test_eds_calendar_dedup.py pruefungen/test_akonadi.py pruefungen/test_akonadi_sync.py pruefungen/test_journal_periodisch.py pruefungen/test_elf_glibc.py pruefungen/test_release_signatur.py pruefungen/test_restkorrekturen.py pruefungen/test_thunderbird_schema23.py pruefungen/test_update_security.py
	python3 -m pytest -q pruefungen/test_crash_reports.py
	python3 pruefungen/test_paketinhalt.py
	test -n "$(JS_LAUFER)"
	TZ=Europe/Berlin $(JS_LAUFER) pruefungen/test.js
	rm -rf bin/__pycache__ debian/test-data debian/test-config
endif

# Binärbauten erhalten die externe Contributor-Konfiguration. Sie wird nur im
# Paketbaum erzeugt und gehört nie zur Quelle.
override_dh_install:
	set -e; hash="$${MAGNOLIE_CONTRIBUTOR_HASH:-}"; \
	if [ -n "$$hash" ]; then \
	  test "$${#hash}" -eq 64 || { echo 'MAGNOLIE_CONTRIBUTOR_HASH ist ungueltig.' >&2; exit 2; }; \
	  case "$$hash" in *[!0-9a-fA-F]*) echo 'MAGNOLIE_CONTRIBUTOR_HASH ist ungueltig.' >&2; exit 2;; esac; \
	  hash=$$(printf '%s' "$$hash" | tr A-F a-f); \
	fi; \
	dh_install; \
	if [ -n "$$hash" ]; then \
	  ziel=debian/magnolie-organizer/usr/share/magnolie-organizer; \
	  mkdir -p "$$ziel"; \
	  printf '{"contributorHash":"%s"}\n' "$$hash" > "$$ziel/build-config.json"; \
	fi

override_dh_builddeb:
	find debian/magnolie-organizer -exec touch -h -d "@$(SOURCE_DATE_EPOCH)" {} +
	dh_builddeb

override_dh_auto_clean:
	rm -rf .flatpak-builder bin/__pycache__ debian/tests/__pycache__ pruefungen/__pycache__ werkzeuge/__pycache__ klang locale web/i18n/*.js debian/test-data debian/test-config bau
