    <Compile Include="../../../Magnolie-Organizer-Windows-2.0.0/PhoneUri.cs" />
    <Reference Include="PhoneNumbers"><HintPath>$(PhoneNumbersPath)</HintPath></Reference>
  </ItemGroup>
</Project>
