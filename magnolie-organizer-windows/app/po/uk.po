msgstr "Номери тижнів"

msgid "Weekly"
msgstr "щотижневий"

msgid "Weekly variation for %(name)s"
msgstr "Зміна за днями тижня для %(name)s"

msgid "Weekly view"
msgstr "Тижневий вигляд"

