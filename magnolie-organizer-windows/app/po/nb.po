msgid ""
"We are delighted to welcome you. This short assistant prepares Magnolie "
"Organizer around your wishes."
msgstr ""
"Vi ønsker deg hjertelig velkommen. Denne korte assistenten tilpasser "
"Magnolie Organizer etter ønskene dine."

msgid "We are glad you are here!"
msgstr "Vi er glade for at du er her!"

msgid "Weather"
msgstr "Vær"

