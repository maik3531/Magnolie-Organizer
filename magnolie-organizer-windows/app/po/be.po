msgstr "Адвязаць"

msgid "Unlock"
msgstr "Разблакіраваць"

msgid "Unlock Magnolie Organizer"
msgstr "Разблакіраваць Magnolie Organizer"

msgid "Unsupported alarm"
msgstr "Напамін, які не падтрымліваецца"

msgid "Until (leave blank for no end)"
msgstr "Да (пакіньце пустым, калі без канчатковай даты)"

msgid "Untitled"
msgstr "Без назвы"

msgid "Untitled appointment"
msgstr "Сустрэча без назвы"

