msgstr ""
"Каб змяніць яго, увядзіце толькі новы пароль; арганайзер ужо разблакіраваны."

msgid "Today"
msgstr "Сёння"

msgid "Today is %(date)s"
msgstr "Сёння %(date)s"

msgid "Tomorrow"
msgstr "Заўтра"

