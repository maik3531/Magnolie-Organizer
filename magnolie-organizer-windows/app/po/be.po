msgstr "Занадта шмат няўдалых спроб – пачакайце %(duration)s."

msgid "Too many failed attempts. Wait a moment."
msgstr "Занадта шмат няўдалых спроб. Крыху пачакайце."

msgid "Too many regions were selected."
msgstr "Выбрана занадта шмат рэгіёнаў."

msgid "Too many unfinished synchronization runs."
msgstr "Зашмат незавершаных сеансаў сінхранізацыі."

msgid "Top level"
msgstr "Верхні ўзровень"

msgid "Tray applet"
msgstr "Аплет сістэмнага трэя"

msgid "Trust and accept tasks and notes automatically"
msgstr "Давяраць і аўтаматычна прымаць задачы і нататкі"

