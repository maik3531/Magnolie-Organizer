<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Magnolie Organizer</AssemblyName>
    <RootNamespace>MagnolieOrganizer.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app\magnolie-organizer.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <MagnoliePhotoSync Condition="'$(MagnoliePhotoSync)' == '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(MAGNOLIE_CONTRIBUTOR_HASH)', '^[0-9a-fA-F]{64}$'))">true</MagnoliePhotoSync>
    <MagnoliePhoneCamera Condition="'$(MagnoliePhoneCamera)' == '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(MAGNOLIE_CONTRIBUTOR_HASH)', '^[0-9a-fA-F]{64}$'))">true</MagnoliePhoneCamera>
    <MagnoliePhotoSync Condition="'$(MagnoliePhotoSync)' == ''">false</MagnoliePhotoSync>
    <MagnoliePhoneCamera Condition="'$(MagnoliePhoneCamera)' == ''">false</MagnoliePhoneCamera>
    <DefineConstants Condition="'$(MagnoliePhotoSync)' == 'true'">$(DefineConstants);MAGNOLIE_PHOTO_SYNC</DefineConstants>
    <DefineConstants Condition="'$(MagnoliePhoneCamera)' == 'true'">$(DefineConstants);MAGNOLIE_PHONE_CAMERA</DefineConstants>
    <MagnolieHandbookWeb Condition="'$(MagnolieHandbookWeb)' == '' and Exists('..\magnolie-handbuch\web\index.html')">..\magnolie-handbuch\web</MagnolieHandbookWeb>
    <MagnolieHandbookWeb Condition="'$(MagnolieHandbookWeb)' == '' and Exists('shared\magnolie-handbuch\web\index.html')">shared\magnolie-handbuch\web</MagnolieHandbookWeb>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.19" />
    <PackageReference Include="libphonenumber-csharp" Version="9.0.38" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\bin\**\*;tests\obj\**\*" />
  </ItemGroup>

  <ItemGroup Condition="'$(MagnoliePhotoSync)' != 'true'">
    <Compile Remove="DeviceFile*.cs;PhotoDestinationPaths.cs;PhotoSyncPlan.cs;PhotoSyncSchedule.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MagnoliePhoneCamera)' != 'true'">
    <Compile Remove="PhoneCamera*.cs;PhoneWebcam*.cs" />
  </ItemGroup>

  <Target Name="ValidateDesktopPhoneComposition" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(MagnoliePhotoSync)' != 'true' and '$(MagnoliePhotoSync)' != 'false'" Text="Invalid desktop phone composition." />
    <Error Condition="'$(MagnoliePhoneCamera)' != 'true' and '$(MagnoliePhoneCamera)' != 'false'" Text="Invalid desktop phone composition." />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="app\filesystem-runtime.json" LogicalName="Magnolie.FilesystemPrerequisites.json" />
    <Content Include="app\thunderbird\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>thunderbird\%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="app\web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>web\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="app\symbole\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>symbole\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="app\erinnerung.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>erinnerung.wav</Link>
    </Content>
    <Content Include="app\magnolie-organizer.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>magnolie-organizer.ico</Link>
    </Content>
    <Content Include="app\native-i18n.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>native-i18n.json</Link>
    </Content>
    <Content Include="PROTECTED-ASSETS-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(MagnolieHandbookWeb)\**\*" Condition="'$(MagnolieHandbookWeb)' != ''">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>handbuch\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <Target Name="RemoveUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
