<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>NativeImportProbe</AssemblyName>
    <SourceRoot Condition="'$(SourceRoot)' == ''">$(MSBuildThisFileDirectory)../..</SourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs.txt" />
    <!-- Reuse the complete actual-source host, including bound resources and
         its locked dependencies, rather than a drifting subset of codecs.
         Referencing this assembly does not execute its test entry point. -->
    <ProjectReference Include="$(SourceRoot)/tests/CoreTests.csproj" />
  </ItemGroup>
</Project>
