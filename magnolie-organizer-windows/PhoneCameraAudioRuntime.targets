<Project>
  <!-- Optional source-checked artifact; NOT permission/readiness. Base builds
       need no compiler or download. Do not change the separate setup helper. -->
  <UsingTask TaskName="SnapshotPhoneAudioRuntime" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Root ParameterType="System.String" Required="true" />
      <InputDirectory ParameterType="System.String" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <BinaryOutput ParameterType="System.String" Output="true" />
      <ManifestOutput ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" /><Using Namespace="System.IO" /><Using Namespace="System.Linq" /><Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var names = new[] { "PhoneCameraAudioWorker", "PhoneCameraAudioRender", "PhoneCameraClock", "PhoneCameraSamples",
          "PhoneCameraPipe", "PhoneCameraRelay", "PhoneCameraOutputLease", "PhoneCameraOutputPublisher", "PhoneCameraRuntimeProcess", "PhoneCameraRuntimeStatus" };
        var sources = names.SelectMany(name => new[] { "native/phone-camera/"+name+".h", "native/phone-camera/"+name+".cpp" })
          .Concat(new[] { "native/phone-camera/PhoneCameraSource.h", "werkzeuge/phone_audio_runtime.py", "PhoneCameraAudioRuntime.targets" }).ToArray();
        Func<byte[],string> hash = bytes => { using(var sha = SHA256.Create()) return BitConverter.ToString(sha.ComputeHash(bytes)).Replace("-", "").ToLowerInvariant(); };
        var binary = File.ReadAllBytes(Path.Combine(InputDirectory, "Magnolie.PhoneAudioWorker.x64.exe"));
        if(binary.Length < 128 || binary.Length > 8*1024*1024 || binary[0] != 77 || binary[1] != 90) throw new InvalidDataException("Invalid runtime PE size/header");
        var pe = BitConverter.ToInt32(binary, 60);
        if(pe < 64 || pe > binary.Length-26 || BitConverter.ToUInt32(binary, pe) != 0x4550 || BitConverter.ToUInt16(binary, pe+4) != 0x8664 ||
           (BitConverter.ToUInt16(binary, pe+22) & 0x2000) != 0) throw new InvalidDataException("Runtime must be the native x64 executable");
        var lines = new[] { "magnolie-phone-audio-runtime-v1", "architecture=x64", "sha256=" + hash(binary) }
          .Concat(sources.Select(name => "source=" + name + "|" + hash(File.ReadAllBytes(Path.Combine(Root, name))))).ToArray();
        var manifest = File.ReadAllLines(Path.Combine(InputDirectory, "phone-audio-runtime.manifest"));
        if(!lines.SequenceEqual(manifest)) throw new InvalidDataException("Runtime artifact/source descriptor is stale or changed");
        Directory.CreateDirectory(OutputDirectory);
        BinaryOutput = Path.Combine(OutputDirectory, "Magnolie.PhoneAudioWorker.x64.exe");
        ManifestOutput = Path.Combine(OutputDirectory, "phone-audio-runtime.manifest");
        // ONE checked byte snapshot serves both the embedded trust identity and
        // installed sibling. Never re-open the mutable external input at publish.
        File.WriteAllBytes(BinaryOutput, binary);
        File.WriteAllLines(ManifestOutput, lines, new System.Text.UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="PreparePhoneAudioRuntimeResource" BeforeTargets="AssignTargetPaths" Condition="'$(MagnoliePhoneCameraRuntimeDirectory)' != ''">
    <Error Condition="'$(MagnoliePhoneCamera)' != 'true'" Text="The audio runtime may only be embedded in the optional camera composition." />
    <SnapshotPhoneAudioRuntime Root="$(MSBuildProjectDirectory)" InputDirectory="$(MagnoliePhoneCameraRuntimeDirectory)" OutputDirectory="$(IntermediateOutputPath)phone-audio-runtime">
      <Output TaskParameter="BinaryOutput" PropertyName="PhoneAudioRuntimeSnapshot" />
      <Output TaskParameter="ManifestOutput" PropertyName="PhoneAudioRuntimeManifestSnapshot" />
    </SnapshotPhoneAudioRuntime>
    <ItemGroup>
      <EmbeddedResource Include="$(PhoneAudioRuntimeSnapshot)" LogicalName="Magnolie.PhoneAudioWorker.x64.exe" />
      <EmbeddedResource Include="$(PhoneAudioRuntimeManifestSnapshot)" LogicalName="Magnolie.PhoneAudioWorker.manifest" />
      <Content Include="$(PhoneAudioRuntimeSnapshot)" Link="Magnolie.PhoneAudioWorker.x64.exe" TargetPath="Magnolie.PhoneAudioWorker.x64.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
