msgstr ""
"<figure><img src='06-jahrestage.png' alt='Seznam výročí s narozeninami a "
"výročím svatby'><figcaption>Seznam uvádí datum, příležitost, věk nebo pořadí "
"výročí a zbývající čas.</figcaption></figure>"

#, no-javascript-format
msgid ""
"<figure><img src='10-pin-abfrage.png' alt='Pairing dialog with a six-digit "
