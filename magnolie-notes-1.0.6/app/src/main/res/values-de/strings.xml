    <string name="einfuhr_ueberschrift">Notizen übernehmen</string>
    <string name="einfuhr_erklaerung">Samsung Notes, Google Keep und die anderen bewahren ihre Notizen in ihrem eigenen geschützten Speicher auf. Android lässt keine fremde App direkt hineinsehen. Zwei Wege gehen immer: eine Notiz direkt mit Magnolie Notes teilen — oder die Exportdatei einlesen, die diese Programme schreiben.</string>
    <string name="einfuhr_teilen_titel">Teilen (geht überall)</string>
    <string name="einfuhr_teilen_text">Notiz in Samsung Notes, Keep, ColorNote oder sonstwo öffnen, auf Teilen tippen und „Magnolie Notes“ wählen. Mehrere Notizen dürfen auch zusammen kommen.</string>
    <string name="einfuhr_datei_titel">Exportdatei einlesen</string>
    <string name="einfuhr_datei_knopf">Datei wählen …</string>
    <string name="einfuhr_ordner_knopf">Ordner wählen …</string>
    <string name="einfuhr_formate">Wird von selbst erkannt: Google Takeout (.zip / .json / .html), Samsung Notes (.sdocx / .txt / .html), Evernote (.enex), ColorNote-Sicherung, Standard Notes (.txt / .json), Simplenote, Joplin sowie schlichte Markdown- oder Textordner.</string>
    <string name="einfuhr_laeuft">Wird gelesen …</string>
    <plurals name="einfuhr_ergebnis">
        <item quantity="one">%1$d Notiz übernommen, bereits vorhanden: %2$d.</item>
        <item quantity="other">%1$d Notizen übernommen, %2$d waren schon da.</item>
    </plurals>
