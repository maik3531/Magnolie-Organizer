    <string name="telefon_titel">Connexion téléphonique Magnolie</string><string name="telefon_hinweis">Connexion chiffrée indépendante pour l’état de l’appareil, les demandes de numérotation et les notifications en lecture seule d’applications précisément sélectionnées. Elle n’utilise jamais les associations ni les autorisations de Magnolienbaum.</string><string name="telefon_hauptschalter">Activer la connexion téléphonique</string><string name="telefon_status">État de la connexion</string><string name="telefon_status_aus">Désactivée</string><string name="telefon_status_getrennt">Déconnectée</string><string name="telefon_status_gepaart">Associée</string><string name="telefon_status_code">Confirmer le code</string><string name="telefon_status_fehler">Erreur</string><string name="telefon_bluetooth_status">Connexion de secours des données par Bluetooth disponible</string><string name="telefon_suchen">Rechercher l’ordinateur</string><string name="telefon_verbinden">Se connecter à %1$s</string><string name="telefon_code_stimmt">Les codes correspondent</string><string name="telefon_code_falsch">Les codes diffèrent</string><string name="telefon_kopplung">Ordinateur associé</string><string name="telefon_geraetestatus">Autorisation d’accès à l’état de l’appareil</string><string name="telefon_freigegeben">Accordée</string><string name="telefon_nicht_freigegeben">Non accordée</string><string name="telefon_entkoppeln">Supprimer la connexion téléphonique</string><string name="telefon_dienst_laeuft">Connexion téléphonique activée ; en attente de l’ordinateur</string><string name="telefon_dienst_kanal">Connexion téléphonique Magnolie</string><string name="telefon_trennen">Déconnecter</string>
    <string name="telefon_bluetooth_fallback">Connexion de secours des données par Bluetooth</string><string name="telefon_bluetooth_hinweis">Facultative et désactivée par défaut. Le Wi-Fi reste prioritaire. Associez d’abord l’ordinateur dans les paramètres système Android, puis sélectionnez ici cet appareil déjà associé. La connexion téléphonique indépendante utilise sa propre négociation chiffrée et jamais le service Bluetooth de Magnolienbaum.</string><string name="telefon_bluetooth_systempaarung">Ouvrir l’association Bluetooth du système</string><string name="telefon_bluetooth_geraete">Choisir un appareil associé</string><string name="telefon_bluetooth_verwenden">Utiliser %1$s après vérification sécurisée</string><string name="telefon_bluetooth_zugeordnet">Appareil Bluetooth</string><string name="telefon_bluetooth_berechtigung">L’autorisation Bluetooth n’a pas été accordée. Aucune connexion n’a été tentée.</string><string name="telefon_bluetooth_voraussetzung">Activez et associez d’abord de manière sécurisée la connexion téléphonique par Wi-Fi.</string>
    <string name="telefon_benachrichtigungen_titel">Notifications sélectionnées</string><string name="telefon_benachrichtigungen_schalter">Transmettre les notifications de messages sélectionnées</string><string name="telefon_benachrichtigungen_hinweis">Lecture seule. Seules les notifications de messages provenant des applications précisément sélectionnées sont transmises. Les actions, réponses, RemoteInput et PendingIntent ne sont jamais transférés.</string><string name="telefon_systemzugriff_oeffnen">Ouvrir l’accès aux notifications</string><string name="telefon_systemzugriff_erteilt">Accès aux notifications accordé</string><string name="telefon_apps_titel">Applications autorisées</string>
    <string name="telefon_dienst_sucht">Recherche de l’ordinateur…</string><string name="telefon_dienst_verbindet">Connexion sécurisée à %1$s…</string><string name="telefon_dienst_wlan">Connecté à %1$s par Wi-Fi</string><string name="telefon_dienst_bluetooth">Connecté à %1$s par Bluetooth</string><string name="telefon_dienst_fehler">Échec de la connexion ; nouvelle tentative</string>
    <string name="telefon_waehlen_schalter">Autoriser les demandes de numérotation</string><string name="telefon_waehlen_hinweis">Désactivé par défaut et indépendant du contrôle des appels et de HFP. Une demande ouvre uniquement le composeur système ; vous y confirmez l’appel.</string><string name="telefon_waehlen_nicht_verfuegbar">Aucun composeur système n’est disponible. Les demandes de numérotation ne peuvent pas être activées.</string><string name="telefon_waehlen_kanal">Demandes de numérotation</string><string name="telefon_waehlen_titel">Confirmer l’appel dans le composeur système</string>
    <string name="telefon_eingehend_titel">Appels entrants</string><string name="telefon_eingehend_schalter">Partager l’état des appels entrants</string><string name="telefon_nummer_schalter">Partager le numéro de l’appelant lorsqu’il est disponible</string><string name="telefon_annehmen_schalter">Autoriser la réponse aux appels depuis l’ordinateur</string><string name="telefon_eingehend_hinweis">Chaque option est désactivée par défaut et ne demande que l’autorisation téléphonique nécessaire. Le son des appels n’est jamais envoyé via Magnolie.</string><string name="telefon_berechtigung_fehlt">L’autorisation téléphonique n’a pas été accordée. L’option reste désactivée.</string>
