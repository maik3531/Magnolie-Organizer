    <string name="einfuhr_ueberschrift">Importer des notes</string>
    <string name="einfuhr_erklaerung">Samsung Notes, Google Keep et les autres conservent leurs notes dans leur propre espace protégé. Android ne permet à aucune application d’y accéder directement. Deux méthodes fonctionnent toujours : partager une note directement avec Magnolie Notes ou importer le fichier exporté par ces applications.</string>
    <string name="einfuhr_teilen_titel">Partager (fonctionne partout)</string>
    <string name="einfuhr_teilen_text">Ouvrez une note dans Samsung Notes, Keep, ColorNote ou toute autre application, appuyez sur Partager et choisissez « Magnolie Notes ». Plusieurs notes peuvent être partagées à la fois.</string>
    <string name="einfuhr_datei_titel">Importer un fichier d’exportation</string>
    <string name="einfuhr_datei_knopf">Choisir un fichier …</string>
    <string name="einfuhr_ordner_knopf">Choisir un dossier …</string>
    <string name="einfuhr_formate">Reconnus automatiquement : Google Takeout (.zip / .json / .html), Samsung Notes (.sdocx / .txt / .html), Evernote (.enex), sauvegarde ColorNote, Standard Notes (.txt / .json), Simplenote, Joplin et dossiers contenant de simples fichiers Markdown ou texte.</string>
    <string name="einfuhr_laeuft">Lecture …</string>
    <plurals name="einfuhr_ergebnis">
        <item quantity="one">%1$d note importée, déjà présentes : %2$d.</item>
        <item quantity="many">%1$d notes importées, %2$d déjà présentes.</item>
        <item quantity="other">%1$d notes importées, %2$d déjà présentes.</item>
    </plurals>
