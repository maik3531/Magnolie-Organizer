    <string name="blatt_journal">Gjenoppretting</string><string name="journal_titel">Gjenopprettingsjournal</string><string name="journal_hinweis">Krypterte lokale øyeblikksbilder. De lagres aldri i Androids sikkerhetskopi i skyen.</string><string name="journal_zuletzt">Siste øyeblikksbilde</string><string name="journal_naechste">Neste øyeblikksbilde</string><string name="journal_status">Status</string><string name="journal_bereit">Klar</string><string name="journal_intervall">Intervall</string><string name="journal_aus">Av</string><string name="journal_6h">6 timer</string><string name="journal_12h">12 timer</string><string name="journal_taeglich">Daglig</string><string name="journal_woechentlich">Ukentlig</string><string name="journal_jetzt">Ta øyeblikksbilde nå</string><string name="journal_liste">Øyeblikksbilder</string><string name="journal_leer">Ingen øyeblikksbilder ennå.</string><string name="journal_integritaet">integritet bekreftet ved åpning</string><string name="journal_vorschau">Forhåndsvisning</string><string name="journal_restore">Gjenopprett</string><string name="journal_restore_frage">Gjenopprette «%1$s»? Et øyeblikksbilde fra før gjenopprettingen opprettes først.</string><string name="journal_loeschen_frage">Slette dette øyeblikksbildet permanent?</string>
    <string name="journal_kontakt_konflikt">Kontakt endret</string><string name="journal_kontakt_konflikt_frage">«%1$s» er endret siden øyeblikksbildet. Overskrive bare den valgte tilknyttede kontakten?</string><string name="journal_konflikt_ueberschreiben">Overskriv valgt kontakt</string>
    <string name="telefon_titel">Magnolie-telefontilkobling</string><string name="telefon_hinweis">Uavhengig kryptert tilkobling for enhetsstatus, oppringingsforespørsler og skrivebeskyttede varsler fra nøyaktig valgte apper. Den bruker aldri Magnolienbaum-paringer eller -tillatelser.</string><string name="telefon_hauptschalter">Aktiver telefontilkobling</string><string name="telefon_status">Tilkoblingsstatus</string><string name="telefon_status_aus">Av</string><string name="telefon_status_getrennt">Frakoblet</string><string name="telefon_status_gepaart">Paret</string><string name="telefon_status_code">Bekreft kode</string><string name="telefon_status_fehler">Feil</string><string name="telefon_bluetooth_status">Bluetooth-reserveløsning for data er tilgjengelig</string><string name="telefon_suchen">Søk etter datamaskin</string><string name="telefon_verbinden">Koble til %1$s</string><string name="telefon_code_stimmt">Kodene samsvarer</string><string name="telefon_code_falsch">Kodene er forskjellige</string><string name="telefon_kopplung">Paret datamaskin</string><string name="telefon_geraetestatus">Tillatelse til enhetsstatus</string><string name="telefon_freigegeben">Tillatt</string><string name="telefon_nicht_freigegeben">Ikke tillatt</string><string name="telefon_entkoppeln">Fjern telefontilkobling</string><string name="telefon_dienst_laeuft">Telefontilkobling aktivert; venter på datamaskin</string><string name="telefon_dienst_kanal">Magnolie-telefontilkobling</string><string name="telefon_trennen">Koble fra</string>
    <string name="telefon_bluetooth_fallback">Bluetooth-reserveløsning for data</string><string name="telefon_bluetooth_hinweis">Valgfritt og av som standard. Wi-Fi foretrekkes fortsatt. Par først datamaskinen i Androids systeminnstillinger, og velg deretter den allerede parede enheten her. Den uavhengige telefontilkoblingen bruker sin egen krypterte håndtrykksprotokoll og aldri Bluetooth-tjenesten til Magnolienbaum.</string><string name="telefon_bluetooth_systempaarung">Åpne Bluetooth-systemparing</string><string name="telefon_bluetooth_geraete">Velg paret enhet</string><string name="telefon_bluetooth_verwenden">Bruk %1$s etter sikker bekreftelse</string><string name="telefon_bluetooth_zugeordnet">Bluetooth-enhet</string><string name="telefon_bluetooth_berechtigung">Bluetooth-tillatelsen ble ikke gitt. Ingen tilkobling ble forsøkt.</string><string name="telefon_bluetooth_voraussetzung">Aktiver og par først telefontilkoblingen sikkert via Wi-Fi.</string>
    <string name="telefon_benachrichtigungen_titel">Valgte varsler</string><string name="telefon_benachrichtigungen_schalter">Videresend valgte meldingsvarsler</string><string name="telefon_benachrichtigungen_hinweis">Skrivebeskyttet. Bare meldingsvarsler fra nøyaktig valgte apper videresendes. Handlinger, svar, RemoteInput og PendingIntent overføres aldri.</string><string name="telefon_systemzugriff_oeffnen">Åpne varslingstilgang</string><string name="telefon_systemzugriff_erteilt">Varslingstilgang gitt</string><string name="telefon_apps_titel">Tillatte apper</string>
    <string name="telefon_dienst_sucht">Søker etter datamaskin…</string><string name="telefon_dienst_verbindet">Kobler sikkert til %1$s…</string><string name="telefon_dienst_wlan">Koblet til %1$s via Wi-Fi</string><string name="telefon_dienst_bluetooth">Koblet til %1$s via Bluetooth</string><string name="telefon_dienst_fehler">Tilkoblingen mislyktes; prøver på nytt</string>
    <string name="telefon_waehlen_schalter">Tillat oppringingsforespørsler</string><string name="telefon_waehlen_hinweis">Av som standard og uavhengig av anropskontroll og HFP. En forespørsel åpner bare systemets oppringingsapp; du bekrefter anropet der.</string><string name="telefon_waehlen_nicht_verfuegbar">Ingen systemoppringingsapp er tilgjengelig. Oppringingsforespørsler kan ikke aktiveres.</string><string name="telefon_waehlen_kanal">Oppringingsforespørsler</string><string name="telefon_waehlen_titel">Bekreft anrop i systemets oppringingsapp</string>
    <string name="telefon_eingehend_titel">Innkommende anrop</string><string name="telefon_eingehend_schalter">Del status for innkommende anrop</string><string name="telefon_nummer_schalter">Del innringerens nummer når det er tilgjengelig</string><string name="telefon_annehmen_schalter">Tillat svar på anrop fra datamaskinen</string><string name="telefon_eingehend_hinweis">Hvert alternativ er av som standard og ber bare om den nødvendige telefontillatelsen. Anropslyd sendes aldri via Magnolie.</string><string name="telefon_berechtigung_fehlt">Telefontillatelsen ble ikke gitt. Alternativet forblir av.</string>
