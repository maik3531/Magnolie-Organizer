    <string name="einfuhr_ueberschrift">Overfør notater</string>
    <string name="einfuhr_erklaerung">Samsung Notes, Google Keep og andre apper lagrer notatene i sitt eget beskyttede lagringsområde. Android lar ikke andre apper lese dette direkte. To metoder fungerer alltid: Del et notat direkte med Magnolie Notes, eller importer eksportfilen som appen oppretter.</string>
    <string name="einfuhr_teilen_titel">Del (fungerer overalt)</string>
    <string name="einfuhr_teilen_text">Åpne et notat i Samsung Notes, Keep, ColorNote eller en annen app, trykk på Del og velg «Magnolie Notes». Du kan dele flere notater samtidig.</string>
    <string name="einfuhr_datei_titel">Importer en eksportfil</string>
    <string name="einfuhr_datei_knopf">Velg fil …</string>
    <string name="einfuhr_ordner_knopf">Velg mappe …</string>
    <string name="einfuhr_formate">Gjenkjennes automatisk: Google Takeout (.zip / .json / .html), Samsung Notes (.sdocx / .txt / .html), Evernote (.enex), ColorNote-sikkerhetskopi, Standard Notes (.txt / .json), Simplenote, Joplin samt vanlige Markdown- eller tekstmapper.</string>
    <string name="einfuhr_laeuft">Leser …</string>
    <plurals name="einfuhr_ergebnis">
        <item quantity="one">%1$d notat overført, allerede til stede: %2$d.</item>
        <item quantity="other">%1$d notater overført, %2$d fantes allerede.</item>
    </plurals>
    <string name="einfuhr_nichts">Fant ingen lesbare notater i denne filen.</string>
    <string name="einfuhr_fehler">Kunne ikke lese filen: %1$s</string>
    <string name="einfuhr_anleitung_titel">Slik får du eksportfilen</string>
    <string name="einfuhr_anleitung_keep">Google Keep: Åpne takeout.google.com på telefonen, velg bare «Keep», be om eksporten og lagre .zip-filen her.</string>
    <string name="einfuhr_anleitung_samsung">Samsung Notes: Åpne listen, trykk og hold på et notat, velg Mer → Lagre som fil → PDF eller tekst, og importer deretter mappen her. Du kan velge en hel notatbok samtidig.</string>
    <string name="einfuhr_anleitung_evernote">Evernote: Notatbok → Eksporter notater → .enex.</string>
    <string name="baum_ueberschrift">Magnolienbaum</string>
    <string name="baum_erklaerung">Magnolienbaum kobler denne telefonen direkte til Magnolie Organizer — uten nettsky og uten mellomledd. Notater sendes kryptert og først etter at begge sider har bekreftet hverandre.</string>
