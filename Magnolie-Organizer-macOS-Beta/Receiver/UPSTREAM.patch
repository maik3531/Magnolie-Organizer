+static gboolean load_required_factory(const gchar *name) {
+    GstElementFactory *factory = gst_element_factory_find(name);
+    if (!factory) return FALSE;
+    // A stale registry entry is not evidence that its dynamic plugin can load.
+    GstPluginFeature *loaded = gst_plugin_feature_load(GST_PLUGIN_FEATURE(factory));
+    gst_object_unref(factory);
+    if (!loaded) return FALSE;
+    gst_object_unref(loaded);
+    return TRUE;
+}
+
+static gboolean check_magnolie_receiver_features(void) {
+    // This is the app's fixed default profile. Keep automatic sink/decoder
+    // selection; do not impose a hardware-specific macOS renderer or decoder.
+    const gchar *required[] = {
+        "appsrc", "queue", "avdec_aac", "avdec_alac", "h264parse", "decodebin",
+        "videoconvert", "videoscale", "autovideosink", "audioconvert",
+        "audioresample", "volume", "level", "autoaudiosink", NULL
+    };
+    for (int i = 0; required[i]; ++i) {
+        if (!load_required_factory(required[i])) return FALSE;
+    }
+
+    // decodebin itself is not an H.264 decoder. Require at least one loadable,
+    // automatically eligible decoder whose sink caps accept video/x-h264.
+    // This checks capability availability, not successful native decoding.
+    GList *decoders = gst_element_factory_list_get_elements(
+        GST_ELEMENT_FACTORY_TYPE_DECODER | GST_ELEMENT_FACTORY_TYPE_MEDIA_VIDEO,
+        GST_RANK_MARGINAL);
+    GstCaps *h264 = gst_caps_from_string("video/x-h264");
+    GList *matching = gst_element_factory_list_filter(decoders, h264, GST_PAD_SINK, FALSE);
+    gboolean available = FALSE;
+    for (GList *item = matching; item; item = item->next) {
+        GstPluginFeature *loaded = gst_plugin_feature_load(GST_PLUGIN_FEATURE(item->data));
+        if (loaded) {
+            gst_object_unref(loaded);
+            available = TRUE;
+            break;
+        }
+    }
+    gst_plugin_feature_list_free(matching);
+    gst_plugin_feature_list_free(decoders);
+    gst_caps_unref(h264);
+    return available;
+}
+
 bool gstreamer_init(){
-    gst_init(NULL,NULL);    
-    return (bool) check_plugins ();
+    gst_init(NULL,NULL);
+    return (bool) (check_plugins() && check_magnolie_receiver_features());
 }
 
