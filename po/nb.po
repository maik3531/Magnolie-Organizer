msgstr "Telefontilkoblingen er ikke tilgjengelig."

msgid "The photo could not be read."
msgstr "Bildet kunne ikke leses."

msgid "The photo is larger than 8 megabytes."
msgstr "Bildet er større enn 8 megabyte."

msgid "The planner layout is invalid."
msgstr "Planleggeroppsettet er ugyldig."

msgid "The port is invalid."
msgstr "Porten er ugyldig."

msgid "The previous data could not be backed up."
msgstr "De forrige dataene kunne ikke sikkerhetskopieres."

#, python-format
msgid "The print page is located at: %s"
msgstr "Utskriftssiden ligger her: %s"

#, python-format
msgid "The public address could not be determined (%(error)s)."
msgstr "Den offentlige adressen kunne ikke fastslås (%(error)s)."

msgid "The public address could not be determined."
msgstr "Den offentlige adressen kunne ikke fastslås."

msgid "The public key is invalid."
msgstr "Den offentlige nøkkelen er ugyldig."

msgid "The recovery snapshot folder must not be a symbolic link."
msgstr "Mappen for gjenopprettingsøyeblikksbilder må ikke være en symbolsk lenke."

