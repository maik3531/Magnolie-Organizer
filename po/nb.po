msgstr "Svaret er for stort."

msgid ""
"The same code must appear on both computers:\n"
"\n"
"%(code)s\n"
"\n"
"Other branch: %(branch)s\n"
"Fingerprint: %(fingerprint)s\n"
"\n"
"Does the code match?"
msgstr ""
"Den samme koden må vises på begge datamaskinene:\n"
"\n"
"%(code)s\n"
"\n"
"Annen gren: %(branch)s\n"
"Fingeravtrykk: %(fingerprint)s\n"
"\n"
"Er koden lik?"

msgid "The save request is invalid."
msgstr "Lagringsforespørselen er ugyldig."

msgid "The secure interface could not be registered."
msgstr "Det sikre grensesnittet kunne ikke registreres."

msgid "The secure message could not be opened."
msgstr "Den sikre meldingen kunne ikke åpnes."

msgid "The secure message is invalid."
msgstr "Den sikre meldingen er ugyldig."

msgid "The secure session has already been used."
msgstr "Den sikre økten er allerede brukt."

msgid "The secure session is damaged."
msgstr "Den sikre økten er skadet."

