msgstr "— njezwjazać —"

msgid "— not specified —"
msgstr "— njepodate —"

msgid "— please select —"
msgstr "— prošu wubrać —"

msgid "“%(name)s” was restored."
msgstr "„%(name)s“ bu wobnowjene."

msgid "“%(word)s” is now in the dictionary."
msgstr "„%(word)s“ je nětko w słowniku."

msgid ""
"“From this computer” reads contacts, appointments and tasks directly from "
"Evolution (including cached online accounts) and Thunderbird without further "
"setup. It only reads these stores and does not change them. The organizer "
"automatically detects whether a Lotus CSV contains appointments, contacts, "
"tasks, anniversaries or notes. Calendar files provide appointments, annual "
"recurrences as anniversaries, and tasks. Birthdays from contact files become "
"anniversaries. Existing entries are not added twice."
msgstr ""
"„Z tutoho ličaka“ čita kontakty, terminy a nadawki direktnje z Evolution "
"(inkluziwnje pufrowanych internetnych kontow) a Thunderbird bjez dalšeho "
"připrawjenja. Tute składowaki jenož čita a je njezměnja. Organizer "
"awtomatisce spóznaje, hač Lotus CSV terminy, kontakty, nadawki, róčnicy abo "
"noticy wobsahuje. Protykowe dataje dodawaja terminy, lětne wospjetowanja "
"jako róčnicy a nadawki. Narodniny z kontaktowych datajow so róčnicy stanu. "
"Hižo eksistowace zapiski so dwójce njepřidawaja."

msgid "… and %(count)s more item that will also be printed."
msgid_plural "… and %(count)s more items that will also be printed."
msgstr[0] "… a dale %(count)s zapisk, kotryž so tež ćišći."
msgstr[1] "… a dale %(count)s zapiskaj, kotrejž so tež ćišćitej."
msgstr[2] "… a dale %(count)s zapiski, kotrež so tež ćišća."
msgstr[3] "… a dale %(count)s zapiskow, kotrež so tež ćišća."

