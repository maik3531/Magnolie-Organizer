+++ b/magnolie-organizer/pruefungen/test_absolute_reminder_legacy.py
@@ -0,0 +1,245 @@
+"""#835: genuine pre-fix acknowledgment shapes and undated absolute VTODOs."""
+import copy
+import json
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+from zoneinfo import ZoneInfo
+
+from modul_laden import quellmodul_laden
+
+
+# Captured by executing the real importer and faellige_aufgaben from
+# 1543858e251d7e29ebeafb67d2605991c1d442d5, not generated by the code under test.
+UID = "independent-absolute-review"
+PREFIX = "af-58b0c6d3d9fe361ee648:" + UID
+OLD = PREFIX + "@2026-11-29T12:30:00+00:00-2026-11-29-1230-alarm-START-2026-11-27 10:30"
+OLD_NEXT = PREFIX + "@2026-11-30T12:30:00+00:00-2026-11-30-1230-alarm-START-2026-11-27 10:30"
+OLD_FOLD = PREFIX + "@2026-11-03T12:30:00+00:00-2026-11-03-0730-alarm-START-2026-11-01 01:30"
+NOW = datetime(2026, 11, 27, 10, 30, tzinfo=timezone.utc)
+
+
+class AbsoluteReminderLegacy(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        with patch.dict("sys.modules", {"gi": None}):
+            cls.m = quellmodul_laden("absolute_reminder_legacy_test",
+                Path(__file__).resolve().parents[1] / "bin/magnolie-organizer")
+
+    def setUp(self):
+        self.zone = "UTC"
+        self.zone_name = patch.object(self.m, "_zeitzonenname", lambda: self.zone)
+        self.zone_name.start()
+        self.zone_token = self.m._LAUF_ZEITZONE.set(ZoneInfo(self.zone))
+
+    def tearDown(self):
+        self.m._LAUF_ZEITZONE.reset(self.zone_token)
+        self.zone_name.stop()
+
+    def imported(self, trigger="20261127T103000Z", start="20261129T123000Z",
+                 due="20261129T123000Z", source="owned-calendar-a", recurrence="", status="", uid=UID):
+        lines = ["BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//Magnolie//Owned legacy fixture//EN",
+                 "BEGIN:VTODO", "UID:" + uid, "DTSTAMP:20261001T000000Z", "SUMMARY:Owned independent alarm"]
+        if start is not None:
+            lines.append("DTSTART:" + start)
+        if due is not None:
+            lines.append("DUE:" + due)
+        if recurrence:
+            lines.append("RRULE:" + recurrence)
+        if status:
+            lines.append("STATUS:" + status)
+        lines += ["BEGIN:VALARM", "ACTION:DISPLAY", "TRIGGER;VALUE=DATE-TIME:" + trigger,
+                  "DESCRIPTION:Owned independent alarm", "END:VALARM", "END:VTODO", "END:VCALENDAR", ""]
+        data = self.m.ics_lesen("\r\n".join(lines), quellen_id=source)
+        data["einstellungen"] = {"erinnerung": {"an": True}, "sicherheit": {"erinnernTrotzKennwort": True}}
+        self.assertEqual(len(data["aufgaben"]), 1)
+        return data
+
+    def run_tasks(self, data, state=None, at=NOW):
+        before = copy.deepcopy(data)
+        result = self.m.faellige_aufgaben(data, at, {"faellig": [], "verpasst": [],
+            "zustand": json.loads(json.dumps(state or {"gemeldet": {}}))})
+        self.assertEqual(data, before, "Alarm delivery must not invent or alter stored task dates")
+        return result
+
+    @staticmethod
+    def notices(result):
+        return result["faellig"] + result["verpasst"]
+
+    @staticmethod
+    def old_state(key=OLD, when="2026-11-27 10:30"):
+        return {"gemeldet": {key: when}, "letzter_lauf": ""}
+
+    def test_genuine_old_ack_survives_upgrade_and_background_projection(self):
+        for source, key in [("owned-calendar-a", OLD), ("", OLD.replace("58b0c6d3d9fe361ee648:", ""))]:
+            data = self.imported(source=source)
+            for chosen in [data, self.m.erinnerungsdaten_auswaehlen(data)]:
+                with self.subTest(source=source, background=chosen.get("nurErinnerungen", False)):
+                    result = self.run_tasks(chosen, self.old_state(key))
+                    self.assertEqual(self.notices(result), [])
+                    self.assertEqual(sum("@absolute:" in item for item in result["zustand"]["gemeldet"]), 1)
+                    self.assertEqual(self.notices(self.run_tasks(chosen, result["zustand"], at=NOW + timedelta(seconds=30))), [])
+
+    def test_real_series_occurrence_acknowledges_component_only_once(self):
+        data = self.imported(recurrence="FREQ=DAILY;COUNT=2")
+        for key in [OLD, OLD_NEXT]:
+            with self.subTest(key=key):
+                self.assertEqual(self.notices(self.run_tasks(data, self.old_state(key))), [])
+        forged = OLD_NEXT.replace("2026-11-30", "2026-12-01")
+        self.assertEqual(len(self.notices(self.run_tasks(data, self.old_state(forged)))), 1)
+
+    def test_similar_source_component_trigger_and_standard_marks_are_not_acks(self):
+        cases = [(self.imported(source="owned-calendar-b"), self.old_state(), NOW),
+                 (self.imported(uid=UID + "-different"), self.old_state(), NOW),
+                 (self.imported(trigger="20261127T103100Z"), self.old_state(), NOW + timedelta(minutes=1)),
+                 (self.imported(), self.old_state(OLD.split("-alarm-START-")[0]), NOW),
+                 (self.imported(), self.old_state(when="invalid time"), NOW)]
+        for data, state, at in cases:
+            with self.subTest(data=data["aufgaben"][0]["uid"], state=state, at=at):
+                self.assertEqual(len(self.notices(self.run_tasks(data, state, at))), 1)
+
+    def test_old_minute_mark_does_not_acknowledge_another_second(self):
+        data = self.imported(trigger="20261127T103015Z")
+        self.assertEqual(self.notices(self.run_tasks(data, self.old_state(), NOW + timedelta(seconds=14))), [])
+        result = self.run_tasks(data, self.old_state(), NOW + timedelta(seconds=15))
+        self.assertEqual(len(self.notices(result)), 1)
+        self.assertTrue(self.notices(result)[0]["id"].endswith("@absolute:20261127T103015Z"))
+        self.assertEqual(self.notices(self.run_tasks(data, result["zustand"], NOW + timedelta(seconds=45))), [])
+
+    def test_old_wall_mark_cannot_acknowledge_the_second_dst_fold(self):
+        self.zone = "America/New_York"
+        self.m._LAUF_ZEITZONE.set(ZoneInfo(self.zone))
+        first = datetime(2026, 11, 1, 5, 30, tzinfo=timezone.utc)
+        state = self.old_state(OLD_FOLD, "2026-11-01 01:30")
+        data = self.imported(trigger="20261101T053000Z", start="20261103T123000Z", due="20261103T123000Z")
+        self.assertEqual(self.notices(self.run_tasks(data, state, first)), [])
+        second = self.imported(trigger="20261101T063000Z", start="20261103T123000Z", due="20261103T123000Z")
+        self.assertEqual(self.notices(self.run_tasks(second, state, first)), [])
+        result = self.run_tasks(second, state, first + timedelta(hours=1))
+        self.assertEqual(len(self.notices(result)), 1)
+        self.assertTrue(self.notices(result)[0]["id"].endswith("@absolute:20261101T063000Z"))
+
+    def test_undated_task_uses_trigger_for_display_without_mutating_dates(self):
+        data = self.imported(trigger="20261127T103015Z", start=None, due=None)
+        for chosen in [data, self.m.erinnerungsdaten_auswaehlen(data)]:
+            self.assertEqual(self.notices(self.run_tasks(chosen, at=NOW + timedelta(seconds=14))), [])
+            result = self.run_tasks(chosen, at=NOW + timedelta(seconds=15))
+            self.assertEqual(len(self.notices(result)), 1)
+            notice = self.notices(result)[0]
+            self.assertEqual((notice["datum"], notice["zeit"]), ("2026-11-27", "10:30:15"))
+            self.assertEqual(notice["kopf"], self.m._("Task reminder"))
+            self.assertEqual(chosen["aufgaben"][0]["faellig"], "")
+            self.assertEqual(self.notices(self.run_tasks(chosen, result["zustand"], NOW + timedelta(seconds=45))), [])
+
+    def test_start_only_task_does_not_invent_a_due_date(self):
+        data = self.imported(due=None)
+        result = self.run_tasks(data)
+        self.assertEqual(len(self.notices(result)), 1)
+        self.assertEqual(self.notices(result)[0]["datum"], "2026-11-27")
+        self.assertEqual(data["aufgaben"][0]["faellig"], "")
+
+    def test_invalid_present_dates_and_times_do_not_become_undated(self):
+        cases = []
+        for field, value in [("faellig", "2026-11-31"), ("startDatum", "not-a-date"),
+                             ("faelligZeit", "12:30"), ("startZeit", "broken")]:
+            data = self.imported(start=None, due=None)
+            data["aufgaben"][0][field] = value
+            cases.append(data)
+        cases += [self.imported(start=None, due="invalid"), self.imported(start="invalid", due=None)]
+        for data in cases:
+            with self.subTest(task=data["aufgaben"][0]):
+                self.assertEqual(self.notices(self.run_tasks(data)), [])
+
+    def test_undated_task_retains_status_and_privacy_exclusions(self):
+        for status in ["CANCELLED", "COMPLETED"]:
+            self.assertEqual(self.notices(self.run_tasks(self.imported(start=None, due=None, status=status))), [])
+        data = self.imported(start=None, due=None)
+        data["aufgaben"][0]["vertraulich"] = True
+        chosen = self.m.erinnerungsdaten_auswaehlen(data)
+        self.assertEqual(chosen["aufgaben"], [])
+        self.assertEqual(self.notices(self.run_tasks(chosen)), [])
+
+    @staticmethod
+    def remove_absolute(data, collection="aufgaben"):
+        result = copy.deepcopy(data)
+        for item in result[collection]:
+            lines, block = [], None
+            for line in item["icsRoundtrip"]:
+                if line == "BEGIN:VALARM":
+                    block = [line]
+                elif block is not None:
+                    block.append(line)
+                    if line == "END:VALARM":
+                        if not any("TRIGGER;VALUE=DATE-TIME:" in value for value in block):
+                            lines.extend(block)
+                        block = None
+                else:
+                    lines.append(line)
+            item["icsRoundtrip"] = lines
+        return result
+
+    def test_coincident_task_due_and_absolute_acknowledge_both(self):
+        data = self.imported(start="20261127T093000Z", due="20261127T103000Z")
+        data["aufgaben"][0]["erinnern"] = True
+        normal = self.remove_absolute(data)
+        old_normal = self.run_tasks(normal)
+        self.assertEqual(len(self.notices(old_normal)), 1)
+        for chosen in [data, self.m.erinnerungsdaten_auswaehlen(data)]:
+            result = self.run_tasks(chosen)
+            self.assertEqual(len(self.notices(result)), 1)
+            self.assertEqual(len(result["zustand"]["gemeldet"]), 2)
+            self.assertEqual(self.notices(self.run_tasks(chosen, result["zustand"])), [])
+            self.assertEqual(self.notices(self.run_tasks(self.remove_absolute(chosen), result["zustand"])), [])
+            upgraded = self.run_tasks(chosen, old_normal["zustand"])
+            self.assertEqual(self.notices(upgraded), [])
+            self.assertEqual(len(upgraded["zustand"]["gemeldet"]), 2)
+
+    def test_coincident_explicit_task_alarms_keep_distinct_seconds_and_sources(self):
+        data = self.imported(start="20261127T113000Z", due="20261127T123000Z")
+        data["aufgaben"][0]["icsRoundtrip"] += ["BEGIN:VALARM", "ACTION:DISPLAY", "TRIGGER:-PT60M", "END:VALARM"]
+        result = self.run_tasks(data)
+        self.assertEqual(len(self.notices(result)), 1)
+        self.assertEqual(len(result["zustand"]["gemeldet"]), 2)
+        self.assertEqual(self.notices(self.run_tasks(self.remove_absolute(data), result["zustand"])), [])
+        other = self.imported(start="20261127T113000Z", due="20261127T123000Z", source="owned-calendar-b")
+        other["aufgaben"][0]["icsRoundtrip"] += ["BEGIN:VALARM", "ACTION:DISPLAY", "TRIGGER:-PT60M", "END:VALARM"]
+        data["aufgaben"].extend(other["aufgaben"])
+        self.assertEqual(len(self.notices(self.run_tasks(data))), 2)
+        seconds = self.imported(trigger="20261127T103001Z", start="20261127T093000Z", due="20261127T103000Z")
+        seconds["aufgaben"][0]["erinnern"] = True
+        self.assertEqual(len(self.notices(self.run_tasks(seconds, at=NOW + timedelta(seconds=1)))), 2)
+
+    def test_coincident_appointment_standard_or_relative_acknowledges_both(self):
+        for start, relative in [("20261127T104500Z", None), ("20261127T113000Z", "-PT60M")]:
+            lines = ["BEGIN:VCALENDAR", "VERSION:2.0", "BEGIN:VEVENT", "UID:owned-coinciding-event",
+                     "SUMMARY:Owned event", "DTSTART:" + start, "BEGIN:VALARM", "ACTION:DISPLAY",
+                     "TRIGGER;VALUE=DATE-TIME:20261127T103000Z", "DESCRIPTION:Owned alarm", "END:VALARM"]
+            if relative:
+                lines += ["BEGIN:VALARM", "ACTION:DISPLAY", "TRIGGER:" + relative, "DESCRIPTION:Owned alarm", "END:VALARM"]
+            data = self.m.ics_lesen("\r\n".join(lines + ["END:VEVENT", "END:VCALENDAR", ""]), quellen_id="owned-calendar-a")
+            normal = self.remove_absolute(data, "termine")
+            old_normal = self.m.faellige_erinnerungen(normal, NOW, {})
+            self.assertEqual(len(self.notices(old_normal)), 1)
+            result = self.m.faellige_erinnerungen(data, NOW, {})
+            self.assertEqual(len(self.notices(result)), 1)
+            self.assertEqual(len(result["zustand"]["gemeldet"]), 2)
+            state = json.loads(json.dumps(result["zustand"]))
+            self.assertEqual(self.notices(self.m.faellige_erinnerungen(data, NOW, state)), [])
+            self.assertEqual(self.notices(self.m.faellige_erinnerungen(normal, NOW, state)), [])
+            upgraded = self.m.faellige_erinnerungen(data, NOW, old_normal["zustand"])
+            self.assertEqual(self.notices(upgraded), [])
+            self.assertEqual(len(upgraded["zustand"]["gemeldet"]), 2)
+
+    def test_coincident_relative_occurrences_without_absolute_remain_separate(self):
+        data = self.imported(start="20261127T103000Z", due="20261127T103000Z", recurrence="FREQ=DAILY;COUNT=2")
+        data = self.remove_absolute(data)
+        data["aufgaben"][0]["erinnern"] = True
+        data["aufgaben"][0]["icsRoundtrip"] += ["BEGIN:VALARM", "ACTION:DISPLAY", "TRIGGER:-P1D", "END:VALARM"]
+        result = self.run_tasks(data)
+        self.assertEqual(len(self.notices(result)), 3)
+        self.assertEqual({value["datum"] for value in self.notices(result)}, {"2026-11-27", "2026-11-28"})
+
+
+if __name__ == "__main__":
+    unittest.main()
