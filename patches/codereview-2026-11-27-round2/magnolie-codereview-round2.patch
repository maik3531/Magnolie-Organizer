diff --git a/magnolie-organizer-windows/tests/AbsoluteReminderCoincidenceTests.cs b/magnolie-organizer-windows/tests/AbsoluteReminderCoincidenceTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..e34da997acacc8b7af1f395af9c16deae03f061a
--- /dev/null
+++ b/magnolie-organizer-windows/tests/AbsoluteReminderCoincidenceTests.cs
@@ -0,0 +1,142 @@
+using System.Globalization;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using MagnolieOrganizer.Windows;
+
+namespace MagnolieOrganizer.Windows.Tests;
+
+internal static class AbsoluteReminderCoincidenceTests
+{
+    private sealed record Scenario(string Name, string Kind, DateTime Trigger, bool Relative = false);
+
+    private static JsonObject Import(Scenario scenario, bool absolute = true, int seconds = 0, string source = "owned-calendar")
+    {
+        var lines = new List<string> { "BEGIN:VCALENDAR", "VERSION:2.0", "BEGIN:" + scenario.Kind,
+            "UID:owned-coincidence", "SUMMARY:Owned coincidence " + scenario.Name, "DTSTART:20261127T123000Z" };
+        if (scenario.Kind == "VTODO") lines.AddRange(["DUE:20261127T123000Z", "X-MAGNOLIE-ERINNERUNG-AM-TAG:1"]);
+        if (scenario.Relative) lines.AddRange(["BEGIN:VALARM", "ACTION:DISPLAY", "TRIGGER:-PT30M", "DESCRIPTION:Relative", "END:VALARM"]);
+        if (absolute) lines.AddRange(["BEGIN:VALARM", "ACTION:DISPLAY", "TRIGGER;VALUE=DATE-TIME:" +
+            scenario.Trigger.AddSeconds(seconds).ToString("yyyyMMdd'T'HHmmss'Z'", CultureInfo.InvariantCulture), "DESCRIPTION:Absolute", "END:VALARM"]);
+        lines.AddRange(["END:" + scenario.Kind, "END:VCALENDAR", ""]);
+        var parsed = ExchangeCodec.ParseIcs(string.Join("\r\n", lines), source, CalendarRecurrence.Zone("UTC"));
+        TestAssert.That(parsed.Uebersprungen == 0 && parsed.Termine.Count + parsed.Aufgaben.Count == 1,
+            scenario.Name + ": actual ICS import lost the component");
+        return new JsonObject { ["termine"] = parsed.Termine, ["aufgaben"] = parsed.Aufgaben,
+            ["einstellungen"] = new JsonObject {
+                ["regional"] = new JsonObject { ["timeZone"] = "UTC" },
+                ["erinnerung"] = new JsonObject { ["an"] = true, ["vorlauf"] = 15, ["verpasste"] = true, ["aufgaben"] = true },
+                ["sicherheit"] = new JsonObject { ["erinnernTrotzKennwort"] = true }
+            } };
+    }
+
+    private static string Select(JsonObject data, string mode) => mode switch
+    {
+        "runtime" => ReminderScheduler.SelectRuntimeData(data.ToJsonString()),
+        "background" => ReminderScheduler.SelectBackgroundData(data.ToJsonString())!,
+        _ => data.ToJsonString()
+    };
+
+    private static (string Key, DateTime Start, DateTime Due)[] Due(string text, string kind, DateTime now)
+    {
+        using var document = JsonDocument.Parse(text);
+        return (kind == "VEVENT" ? ReminderScheduler.DueAppointments(text, now) :
+            ReminderScheduler.DueTasks(document.RootElement,
+                document.RootElement.GetProperty("einstellungen").GetProperty("erinnerung"), now)).ToArray();
+    }
+
+    private static void Run(string state, string text, DateTime now, List<ReminderNotice> notices)
+    {
+        using var scheduler = new ReminderScheduler(state, notices.Add);
+        scheduler.UpdateData(text);
+        scheduler.RunOnce(now);
+        scheduler.RunOnce(now.AddTicks(1));
+        TestAssert.That(scheduler.LastError is null && scheduler.ExpansionErrors.Count == 0,
+            Path.GetFileName(state) + ": scheduler reported an error instead of an actual reminder");
+    }
+
+    private static void AssertStored(string state, params string[] keys)
+    {
+        var saved = JsonNode.Parse(File.ReadAllText(state))!.AsObject();
+        var reported = saved["reported"]!.AsArray().Select(value => value!.GetValue<string>()).ToHashSet(StringComparer.Ordinal);
+        foreach (var key in keys)
+            TestAssert.That(reported.Contains(key) && saved["reportedAt"]![key] is JsonValue timestamp &&
+                DateTimeOffset.TryParse(timestamp.GetValue<string>(), CultureInfo.InvariantCulture, DateTimeStyles.None, out _),
+                Path.GetFileName(state) + ": missing persisted canonical/legacy acknowledgement or timestamp: " + key);
+    }
+
+    internal static Task RunAsync()
+    {
+        var normalEvent = new Scenario("event-standard", "VEVENT", new DateTime(2026, 11, 27, 12, 15, 0, DateTimeKind.Utc));
+        var scenarios = new[] { normalEvent,
+            new Scenario("task-due", "VTODO", new DateTime(2026, 11, 27, 12, 30, 0, DateTimeKind.Utc)),
+            new Scenario("event-relative", "VEVENT", new DateTime(2026, 11, 27, 12, 0, 0, DateTimeKind.Utc), Relative: true) };
+        var directory = Path.Combine(Path.GetTempPath(), "magnolie-reminder-coincidence-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        try
+        {
+            foreach (var mode in new[] { "original", "runtime", "background" })
+            {
+                foreach (var scenario in scenarios)
+                {
+                    var label = scenario.Name + "-" + mode;
+                    var ordinary = Select(Import(scenario, absolute: false), mode);
+                    var combined = Select(Import(scenario), mode);
+                    var legacy = Due(ordinary, scenario.Kind, scenario.Trigger).Single().Key;
+                    var legacySuffix = scenario.Relative ? ":alarm-start-30" : scenario.Kind == "VEVENT" ? ":standard" : ":faellig";
+                    TestAssert.That(legacy.EndsWith(legacySuffix, StringComparison.Ordinal), label + ": ordinary-only fixture no longer establishes the historical acknowledgement");
+                    var due = Due(combined, scenario.Kind, scenario.Trigger);
+                    TestAssert.That(due.Length == 1 && due[0].Due.Ticks == scenario.Trigger.Ticks && due[0].Key.Contains("@absolute:", StringComparison.Ordinal),
+                        label + ": coincident absolute and ordinary/relative alarm were not one canonical candidate");
+                    var canonical = due[0].Key;
+                    var state = Path.Combine(directory, label + ".json");
+                    var notices = new List<ReminderNotice>();
+                    Run(state, combined, scenario.Trigger, notices);
+                    TestAssert.That(notices.Count == 1, label + ": more than one initial notification");
+                    AssertStored(state, canonical, legacy);
+                    Run(state, ordinary, scenario.Trigger.AddSeconds(1), notices);
+                    Run(state, combined, scenario.Trigger.AddSeconds(2), notices);
+                    TestAssert.That(notices.Count == 1, label + ": replay after restart and absolute alarm removal/readdition");
+
+                    if (scenario.Relative) continue;
+                    var upgraded = Path.Combine(directory, label + "-old-normal.json");
+                    var historical = new List<ReminderNotice>();
+                    Run(upgraded, ordinary, scenario.Trigger, historical);
+                    TestAssert.That(historical.Count == 1, label + ": ordinary reminder did not establish the real old acknowledgement");
+                    AssertStored(upgraded, legacy);
+                    Run(upgraded, combined, scenario.Trigger.AddSeconds(1), historical);
+                    TestAssert.That(historical.Count == 1, label + ": an existing normal acknowledgement produced a new absolute notification");
+                    AssertStored(upgraded, canonical, legacy);
+                }
+
+                // A nearby instant is a different alarm even within the same minute.
+                var separated = Select(Import(normalEvent, seconds: 1), mode);
+                var secondsDue = Due(separated, "VEVENT", normalEvent.Trigger.AddSeconds(1));
+                TestAssert.That(secondsDue.Length == 2 && secondsDue.Select(value => value.Due.Second).Order().SequenceEqual(new[] { 0, 1 }),
+                    mode + ": different trigger seconds were merged");
+                var secondsState = Path.Combine(directory, mode + "-seconds.json");
+                var secondsNotices = new List<ReminderNotice>();
+                Run(secondsState, separated, normalEvent.Trigger, secondsNotices);
+                TestAssert.That(secondsNotices.Count == 1, mode + ": future absolute second fired early");
+                Run(secondsState, separated, normalEvent.Trigger.AddSeconds(1), secondsNotices);
+                Run(secondsState, separated, normalEvent.Trigger.AddSeconds(2), secondsNotices);
+                TestAssert.That(secondsNotices.Count == 2, mode + ": independent seconds were lost or replayed after restart");
+
+                // The same UID and instant in two sources still represent two items.
+                var sources = Import(normalEvent);
+                sources["termine"]!.AsArray().Add(Import(normalEvent, source: "other-calendar")["termine"]![0]!.DeepClone());
+                var sourceText = Select(sources, mode);
+                var sourceDue = Due(sourceText, "VEVENT", normalEvent.Trigger);
+                TestAssert.That(sourceDue.Length == 2 && sourceDue.Select(value => value.Key).Distinct().Count() == 2,
+                    mode + ": coincident reminders from different sources were merged");
+                var sourceState = Path.Combine(directory, mode + "-sources.json");
+                var sourceNotices = new List<ReminderNotice>();
+                Run(sourceState, sourceText, normalEvent.Trigger, sourceNotices);
+                Run(sourceState, sourceText, normalEvent.Trigger.AddSeconds(1), sourceNotices);
+                TestAssert.That(sourceNotices.Count == 2, mode + ": source identities lost or replayed after restart");
+            }
+        }
+        finally { Directory.Delete(directory, true); }
+        Console.WriteLine("Absolute reminder coincidence: standard/due/relative deduplication, real persisted aliases, old acknowledgements, seconds and source separation passed in all three projections.");
+        return Task.CompletedTask;
+    }
+}
diff --git a/magnolie-organizer-windows/tests/AbsoluteReminderTests.cs b/magnolie-organizer-windows/tests/AbsoluteReminderTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..ce9039bb2f19efa674a49004c35dce63825e468b
--- /dev/null
+++ b/magnolie-organizer-windows/tests/AbsoluteReminderTests.cs
@@ -0,0 +1,140 @@
+using System.Globalization;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using MagnolieOrganizer.Windows;
+
+namespace MagnolieOrganizer.Windows.Tests;
+
+internal static class AbsoluteReminderTests
+{
+    private static string Text(JsonObject value, string key, string fallback = "") => value[key]?.GetValue<string>() ?? fallback;
+
+    private static JsonObject Import(JsonObject vector, string kind, string source = "owned-calendar")
+    {
+        var lines = new List<string> { "BEGIN:VCALENDAR", "VERSION:2.0", "BEGIN:" + kind,
+            "UID:owned-absolute-alarm", "SUMMARY:Owned absolute alarm" };
+        if (Text(vector, "start").Length > 0)
+        {
+            lines.Add("DTSTART:" + Text(vector, "start"));
+            if (kind == "VTODO") lines.Add("DUE:" + Text(vector, "start"));
+        }
+        if (vector["rule"] is not null) lines.Add("RRULE:" + Text(vector, "rule"));
+        if (vector["status"] is not null) lines.Add("STATUS:" + Text(vector, "status"));
+        var alarmComponent = Text(vector, "alarmCase") == "lower" ? "valarm" : "VALARM";
+        foreach (var value in vector["triggers"]!.AsArray())
+            lines.AddRange(["BEGIN:" + alarmComponent, "ACTION:" + Text(vector, "action", "DISPLAY"),
+                "TRIGGER;VALUE=DATE-TIME:" + value!.GetValue<string>(), "DESCRIPTION:PRIVATE ALARM TEXT", "END:" + alarmComponent]);
+        lines.AddRange(["END:" + kind, "END:VCALENDAR", ""]);
+        var parsed = ExchangeCodec.ParseIcs(string.Join("\r\n", lines), source, CalendarRecurrence.Zone(Text(vector, "zone", "UTC")));
+        var data = new JsonObject { ["termine"] = parsed.Termine, ["aufgaben"] = parsed.Aufgaben,
+            ["einstellungen"] = new JsonObject {
+                ["regional"] = new JsonObject { ["timeZone"] = Text(vector, "zone", "UTC") },
+                ["erinnerung"] = new JsonObject { ["an"] = true, ["vorlauf"] = 15, ["verpasste"] = vector["missed"]?.GetValue<bool>() ?? true },
+                ["sicherheit"] = new JsonObject { ["erinnernTrotzKennwort"] = true }
+            } };
+        foreach (var item in data[kind == "VEVENT" ? "termine" : "aufgaben"]!.AsArray().OfType<JsonObject>())
+        {
+            item["notiz"] = "PRIVATE ITEM TEXT";
+            if (vector["structured"]?.GetValue<bool>() is true)
+                item["alarme"] = new JsonArray(vector["triggers"]!.AsArray().Select(trigger => (JsonNode)new JsonObject {
+                    ["bearbeitbar"] = false, ["aktiviert"] = vector["enabled"]?.GetValue<bool>() ?? true,
+                    ["aktion"] = Text(vector, "action", "DISPLAY").ToLowerInvariant(), ["triggerRaw"] = trigger!.GetValue<string>()
+                }).ToArray());
+        }
+        return data;
+    }
+
+    private static string Select(JsonObject data, string mode) => mode switch
+    {
+        "runtime" => ReminderScheduler.SelectRuntimeData(data.ToJsonString()),
+        "background" => ReminderScheduler.SelectBackgroundData(data.ToJsonString())!,
+        _ => data.ToJsonString()
+    };
+
+    private static (string Key, DateTime Start, DateTime Due)[] Due(string text, string kind, DateTime now)
+    {
+        using var document = JsonDocument.Parse(text);
+        return (kind == "VEVENT" ? ReminderScheduler.DueAppointments(text, now) :
+            ReminderScheduler.DueTasks(document.RootElement,
+                document.RootElement.GetProperty("einstellungen").GetProperty("erinnerung"), now))
+            .Where(value => value.Key.Contains("@absolute:", StringComparison.Ordinal)).ToArray();
+    }
+
+    internal static Task RunAsync()
+    {
+        var vectors = JsonNode.Parse(File.ReadAllText(Path.Combine(TestSource.Root("contracts/absolute-reminder-vectors.json"),
+            "contracts/absolute-reminder-vectors.json")))!["cases"]!.AsArray();
+        var failures = new List<string>();
+        var checks = 0;
+        foreach (var vector in vectors.OfType<JsonObject>())
+        foreach (var kind in vector["kinds"]?.AsArray().Select(value => value!.GetValue<string>()) ?? ["VEVENT", "VTODO"])
+        foreach (var mode in new[] { "original", "runtime", "background" })
+        {
+            var label = Text(vector, "name") + "/" + kind + "/" + mode;
+            try
+            {
+                var data = Import(vector, kind);
+                var before = data.ToJsonString();
+                var text = Select(data, mode);
+                var now = DateTime.Parse(Text(vector, "now"), CultureInfo.InvariantCulture, DateTimeStyles.AdjustToUniversal);
+                var due = Due(text, kind, now);
+                var expected = vector["expected"]!.GetValue<int>();
+                TestAssert.That(due.Length == expected, $"{label}: expected {expected}, actual {due.Length}");
+                TestAssert.That(due.Select(value => value.Key).Distinct().Count() == due.Length, label + ": duplicate identity");
+                TestAssert.That(data.ToJsonString() == before, label + ": changed source");
+                if (mode != "original") TestAssert.That(!text.Contains("PRIVATE", StringComparison.Ordinal), label + ": leaked private content");
+                checks++;
+            }
+            catch (Exception error) { failures.Add(label + ": " + error.Message); }
+        }
+        TestAssert.That(failures.Count == 0, string.Join("\n", failures));
+
+        var sample = vectors[0]!.AsObject();
+        var when = DateTime.Parse(Text(sample, "now"), CultureInfo.InvariantCulture, DateTimeStyles.AdjustToUniversal);
+        var undated = vectors.OfType<JsonObject>().Single(vector => Text(vector, "name") == "undated-task");
+        foreach (var field in new[] { "faelligZeit", "startZeit", "faellig", "startDatum", "DUE", "DTSTART" })
+        {
+            var invalid = Import(undated, "VTODO");
+            var task = invalid["aufgaben"]![0]!.AsObject();
+            if (field is "DUE" or "DTSTART") task["icsRoundtrip"]!.AsArray().Add(field + ":invalid");
+            else task[field] = field.EndsWith("Zeit", StringComparison.Ordinal) ? "12:30" : "2026-02-30";
+            foreach (var mode in new[] { "original", "runtime", "background" })
+                TestAssert.That(Due(Select(invalid, mode), "VTODO", when).Length == 0, field + "/" + mode + ": malformed date treated as absent");
+        }
+        var directory = Path.Combine(Path.GetTempPath(), "magnolie-absolute-reminder-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        try
+        {
+            foreach (var kind in new[] { "VEVENT", "VTODO" })
+            foreach (var mode in new[] { "original", "runtime", "background" })
+            {
+                var state = Path.Combine(directory, kind + "-" + mode + ".json");
+                var notices = new List<ReminderNotice>();
+                using (var first = new ReminderScheduler(state, notices.Add))
+                {
+                    first.UpdateData(Select(Import(sample, kind), mode));
+                    first.RunOnce(when);
+                    first.RunOnce(when.AddSeconds(1));
+                }
+                TestAssert.That(notices.Count == 1, kind + "/" + mode + ": first delivery or repeat failed");
+                var moved = sample.DeepClone().AsObject(); moved["start"] = "20261201T123000Z";
+                using (var restarted = new ReminderScheduler(state, notices.Add))
+                {
+                    restarted.UpdateData(Select(Import(moved, kind), mode));
+                    restarted.RunOnce(when.AddSeconds(2));
+                }
+                TestAssert.That(notices.Count == 1, kind + "/" + mode + ": replay after restart/date edit");
+                var data = Import(sample, kind);
+                var collection = kind == "VEVENT" ? "termine" : "aufgaben";
+                var other = Import(sample, kind, "other-calendar")[collection]![0]!.DeepClone().AsObject();
+                data[collection]!.AsArray().Add(other);
+                TestAssert.That(Due(Select(data, mode), kind, when).Length == 2, "Merged different source identities");
+                other["vertraulich"] = true;
+                TestAssert.That(Due(Select(data, "background"), kind, when).Length == 1, "Confidential projection changed");
+            }
+        }
+        finally { Directory.Delete(directory, true); }
+        Console.WriteLine($"Absolute reminders: {checks} shared import/projection cases, repeated runs, real persisted restart, date edit, source identities and confidentiality passed.");
+        return Task.CompletedTask;
+    }
+}
