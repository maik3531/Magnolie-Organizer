@@ -0,0 +1,44 @@
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using MagnolieOrganizer.Windows;
+
+namespace MagnolieOrganizer.Windows.Tests;
+
+internal static class LotusCsvTaskValueTests
+{
+    internal static Task RunAsync()
+    {
+        const string relative = "contracts/lotus-csv-task-values.json";
+        var vectors = JsonNode.Parse(File.ReadAllText(Path.Combine(TestSource.Root(relative), relative)))!["cases"]!.AsArray();
+        var failures = new List<string>();
+        foreach (var vector in vectors.OfType<JsonObject>())
+        {
+            var id = vector["id"]!.ToString();
+            void Check(bool passed, string message) { if (!passed) failures.Add(id + ": " + message); }
+            string Csv(string field) => "\"" + field.Replace("\"", "\"\"") + "\"";
+            var raw = Encoding.UTF8.GetBytes("Beschreibung;Fällig;Priorität;Status\r\n" +
+                string.Join(';', new[] { id, "29.02.2028", vector["priority"]!.ToString(), vector["status"]!.ToString() }.Select(Csv)) + "\r\n");
+            var result = ExchangeCodec.ParseImport(raw, "lotus", "owned-tasks.csv");
+            Check(result.Uebersprungen == 0 && result.Aufgaben.Count == 1, "CSV record count changed");
+            if (result.Aufgaben.Count != 1) continue;
+            Check(JsonNode.DeepEquals(result.Aufgaben, ExchangeCodec.ParseImport(raw, "lotus", "owned-tasks.csv").Aufgaben), "Repeated CSV read changed the record");
+            var task = result.Aufgaben[0]!.AsObject();
+            for (var cycle = 0; cycle < 3; cycle++)
+            {
+                Check(task["titel"]!.ToString() == id && task["faellig"]!.ToString() == "2028-02-29", "Task title/date changed");
+                Check(task["prio"]!.GetValue<int>() == vector["expectedPriority"]!.GetValue<int>(), "Priority changed");
+                Check(task["erledigt"]!.GetValue<bool>() == vector["expectedCompleted"]!.GetValue<bool>(), "Completion changed");
+                var before = task.ToJsonString();
+                var exported = ExchangeCodec.WriteIcs("ics-aufgaben", JsonSerializer.SerializeToElement(new JsonArray(task.DeepClone())));
+                Check(task.ToJsonString() == before, "Export mutated the input");
+                Check(exported.Count == 1 && exported.Skipped == 0, "VTODO export lost the task");
+                var reread = ExchangeCodec.ParseIcs(exported.Text);
+                Check(reread.Aufgaben.Count == 1 && reread.Uebersprungen == 0, "VTODO import lost the task");
+                task = reread.Aufgaben.Single()!.AsObject();
+            }
+        }
+        TestAssert.That(failures.Count == 0, string.Join("\n", failures));
+        return Task.CompletedTask;
+    }
+}
