diff --git a/magnolie-organizer/pruefungen/test_lotus_csv_task_values.py b/magnolie-organizer/pruefungen/test_lotus_csv_task_values.py
new file mode 100644
index 0000000000000000000000000000000000000000..305b2ec4241d1d5044ac46f5e239dfd959bc8389
--- /dev/null
+++ b/magnolie-organizer/pruefungen/test_lotus_csv_task_values.py
@@ -0,0 +1,37 @@
+"""Actual CSV import and repeated VTODO exchange preserve task values (#837)."""
+import copy
+import csv
+import io
+import json
+from pathlib import Path
+
+import pytest
+
+from test_startup_read_failure import native
+
+
+VECTORS = json.loads((Path(__file__).resolve().parents[2] /
+                     "contracts/lotus-csv-task-values.json").read_text())["cases"]
+
+
+@pytest.mark.parametrize("vector", VECTORS, ids=lambda case: case["id"])
+def test_csv_task_values_survive_vtodo_roundtrips(native, vector):
+    text = io.StringIO()
+    writer = csv.writer(text, delimiter=";", lineterminator="\r\n")
+    writer.writerow(["Beschreibung", "Fällig", "Priorität", "Status"])
+    writer.writerow([vector["id"], "29.02.2028", vector["priority"], vector["status"]])
+    raw = text.getvalue().encode("utf-8")
+    result = native.import_rohdaten_lesen("lotus", raw, "owned-tasks.csv")
+    assert result["uebersprungen"] == 0
+    task, = result["aufgaben"]
+    assert native.import_rohdaten_lesen("lotus", raw, "owned-tasks.csv")["aufgaben"] == [task]
+    for _ in range(3):
+        assert task["titel"] == vector["id"]
+        assert task["faellig"] == "2028-02-29"
+        assert task["prio"] == vector["expectedPriority"]
+        assert task["erledigt"] is vector["expectedCompleted"]
+        before = copy.deepcopy(task)
+        exported = native.ics_schreiben_aufgaben([task])
+        assert task == before
+        assert exported.count("BEGIN:VTODO") == 1
+        task, = native.ics_lesen(exported)["aufgaben"]
