diff --git a/magnolie-organizer-windows/tests/README.md b/magnolie-organizer-windows/tests/README.md
index 18136bf79deda326843ae88b4ee008fdb5398756..30ccfb920ed0e6f4e5bc15ec8c28d6863bfc4c5e 100644
--- a/magnolie-organizer-windows/tests/README.md
