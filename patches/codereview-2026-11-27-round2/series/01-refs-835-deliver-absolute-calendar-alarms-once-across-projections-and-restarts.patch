+
+namespace MagnolieOrganizer.Windows.Tests;
+
+internal static class AbsoluteReminderTests
+{
+    private static string Text(JsonObject value, string key, string fallback = "") => value[key]?.GetValue<string>() ?? fallback;
+
+    private static JsonObject Import(JsonObject vector, string kind, string source = "owned-calendar")
+    {
+        var lines = new List<string> { "BEGIN:VCALENDAR", "VERSION:2.0", "BEGIN:" + kind,
+            "UID:owned-absolute-alarm", "SUMMARY:Owned absolute alarm" };
+        if (Text(vector, "start").Length > 0)
+        {
+            lines.Add("DTSTART:" + Text(vector, "start"));
+            if (kind == "VTODO") lines.Add("DUE:" + Text(vector, "start"));
+        }
+        if (vector["rule"] is not null) lines.Add("RRULE:" + Text(vector, "rule"));
+        if (vector["status"] is not null) lines.Add("STATUS:" + Text(vector, "status"));
+        var alarmComponent = Text(vector, "alarmCase") == "lower" ? "valarm" : "VALARM";
+        foreach (var value in vector["triggers"]!.AsArray())
+            lines.AddRange(["BEGIN:" + alarmComponent, "ACTION:" + Text(vector, "action", "DISPLAY"),
+                "TRIGGER;VALUE=DATE-TIME:" + value!.GetValue<string>(), "DESCRIPTION:PRIVATE ALARM TEXT", "END:" + alarmComponent]);
+        lines.AddRange(["END:" + kind, "END:VCALENDAR", ""]);
+        var parsed = ExchangeCodec.ParseIcs(string.Join("\r\n", lines), source, CalendarRecurrence.Zone(Text(vector, "zone", "UTC")));
+        var data = new JsonObject { ["termine"] = parsed.Termine, ["aufgaben"] = parsed.Aufgaben,
+            ["einstellungen"] = new JsonObject {
+                ["regional"] = new JsonObject { ["timeZone"] = Text(vector, "zone", "UTC") },
+                ["erinnerung"] = new JsonObject { ["an"] = true, ["vorlauf"] = 15, ["verpasste"] = vector["missed"]?.GetValue<bool>() ?? true },
+                ["sicherheit"] = new JsonObject { ["erinnernTrotzKennwort"] = true }
+            } };
+        foreach (var item in data[kind == "VEVENT" ? "termine" : "aufgaben"]!.AsArray().OfType<JsonObject>())
+        {
+            item["notiz"] = "PRIVATE ITEM TEXT";
+            if (vector["structured"]?.GetValue<bool>() is true)
+                item["alarme"] = new JsonArray(vector["triggers"]!.AsArray().Select(trigger => (JsonNode)new JsonObject {
+                    ["bearbeitbar"] = false, ["aktiviert"] = vector["enabled"]?.GetValue<bool>() ?? true,
+                    ["aktion"] = Text(vector, "action", "DISPLAY").ToLowerInvariant(), ["triggerRaw"] = trigger!.GetValue<string>()
+                }).ToArray());
+        }
+        return data;
+    }
+
+    private static string Select(JsonObject data, string mode) => mode switch
+    {
+        "runtime" => ReminderScheduler.SelectRuntimeData(data.ToJsonString()),
+        "background" => ReminderScheduler.SelectBackgroundData(data.ToJsonString())!,
+        _ => data.ToJsonString()
+    };
+
+    private static (string Key, DateTime Start, DateTime Due)[] Due(string text, string kind, DateTime now)
+    {
+        using var document = JsonDocument.Parse(text);
