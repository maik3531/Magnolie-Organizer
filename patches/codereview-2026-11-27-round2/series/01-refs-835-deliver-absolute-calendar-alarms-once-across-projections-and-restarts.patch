+        var checks = 0;
+        foreach (var vector in vectors.OfType<JsonObject>())
+        foreach (var kind in vector["kinds"]?.AsArray().Select(value => value!.GetValue<string>()) ?? ["VEVENT", "VTODO"])
+        foreach (var mode in new[] { "original", "runtime", "background" })
