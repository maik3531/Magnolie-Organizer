+def _absolute_alarm_meldungen(eintrag, kennung):
+    """One source-bound absolute alarm, independent of recurrence windows."""
+    if (str(eintrag.get("icsStatus") or "").upper() == "CANCELLED" or
+            any(name == "STATUS" and str(wert).upper() == "CANCELLED"
+                for name, _params, wert in ics_properties(eintrag.get("icsRoundtrip")))):
