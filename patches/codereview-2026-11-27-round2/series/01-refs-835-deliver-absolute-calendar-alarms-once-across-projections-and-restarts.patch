+        gesehen.add(zeitpunkt)
+        marke = "%s@absolute:%s" % (kennung, zeitpunkt.strftime("%Y%m%dT%H%M%SZ"))
+        # Absolute alarms expire relative to their trigger, not a possibly
+        # distant event. This also prevents replay after the marker is pruned.
+        result.append((marke, zeitpunkt, 0, zeitpunkt, set()))
+    return result
