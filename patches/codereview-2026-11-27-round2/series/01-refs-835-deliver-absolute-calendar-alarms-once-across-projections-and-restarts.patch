+                document.RootElement.GetProperty("einstellungen").GetProperty("erinnerung"), now))
+            .Where(value => value.Key.Contains("@absolute:", StringComparison.Ordinal)).ToArray();
+    }
+
+    internal static Task RunAsync()
+    {
+        var vectors = JsonNode.Parse(File.ReadAllText(Path.Combine(TestSource.Root("contracts/absolute-reminder-vectors.json"),
+            "contracts/absolute-reminder-vectors.json")))!["cases"]!.AsArray();
