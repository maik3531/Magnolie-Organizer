+def _absolute_erinnerungen_buendeln(meldungen):
+    """Join an absolute alarm to one same-source, same-instant normal notice."""
+    gruppen, anker = [], {}
+    # Keep independent normal recurrence notices unchanged. Only the new
+    # component-bound absolute alarm joins their first exact UTC match.
+    for absolut in (False, True):
+        for meldung in meldungen:
+            if meldung[1] != absolut:
+                continue
+            zeitpunkt = (meldung[0], meldung[3])
+            if absolut and zeitpunkt in anker:
+                anker[zeitpunkt].append(meldung)
+            else:
+                gruppe = [meldung]
+                gruppen.append(gruppe)
+                anker.setdefault(zeitpunkt, gruppe)
+    return gruppen
