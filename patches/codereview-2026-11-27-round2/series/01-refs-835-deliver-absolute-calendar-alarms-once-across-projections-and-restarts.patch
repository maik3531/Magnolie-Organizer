+                TestAssert.That(due.Length == expected, $"{label}: expected {expected}, actual {due.Length}");
+                TestAssert.That(due.Select(value => value.Key).Distinct().Count() == due.Length, label + ": duplicate identity");
+                TestAssert.That(data.ToJsonString() == before, label + ": changed source");
+                if (mode != "original") TestAssert.That(!text.Contains("PRIVATE", StringComparison.Ordinal), label + ": leaked private content");
+                checks++;
+            }
+            catch (Exception error) { failures.Add(label + ": " + error.Message); }
+        }
+        TestAssert.That(failures.Count == 0, string.Join("\n", failures));
+
+        var sample = vectors[0]!.AsObject();
+        var when = DateTime.Parse(Text(sample, "now"), CultureInfo.InvariantCulture, DateTimeStyles.AdjustToUniversal);
+        var undated = vectors.OfType<JsonObject>().Single(vector => Text(vector, "name") == "undated-task");
+        foreach (var field in new[] { "faelligZeit", "startZeit", "faellig", "startDatum", "DUE", "DTSTART" })
+        {
+            var invalid = Import(undated, "VTODO");
+            var task = invalid["aufgaben"]![0]!.AsObject();
+            if (field is "DUE" or "DTSTART") task["icsRoundtrip"]!.AsArray().Add(field + ":invalid");
+            else task[field] = field.EndsWith("Zeit", StringComparison.Ordinal) ? "12:30" : "2026-02-30";
+            foreach (var mode in new[] { "original", "runtime", "background" })
+                TestAssert.That(Due(Select(invalid, mode), "VTODO", when).Length == 0, field + "/" + mode + ": malformed date treated as absent");
+        }
+        var directory = Path.Combine(Path.GetTempPath(), "magnolie-absolute-reminder-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
