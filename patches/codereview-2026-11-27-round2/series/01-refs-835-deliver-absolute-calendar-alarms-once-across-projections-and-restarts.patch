+def _erinnerungsgruppe_quittieren(gruppe, gemeldet, wann=None):
+    if wann is None:
+        alt = next((key for meldung in gruppe for key in [meldung[2], *meldung[4]]
+                    if key in gemeldet), None)
+        if alt is None:
+            return False
+        wann = gemeldet[alt]
+    for meldung in gruppe:
+        gemeldet[meldung[2]] = wann
+    return True
