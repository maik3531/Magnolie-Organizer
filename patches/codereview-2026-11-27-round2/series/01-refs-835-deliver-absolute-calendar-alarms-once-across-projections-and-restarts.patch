+"""Refs #835: actual ICS import and reminder planning, no native notification UI."""
+import copy
+import importlib.machinery
+import importlib.util
+import json
+import re
+from datetime import datetime, timedelta
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+loader = importlib.machinery.SourceFileLoader("absolute_reminder_product", str(ROOT / "magnolie-organizer/bin/magnolie-organizer"))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+m = importlib.util.module_from_spec(spec)
+loader.exec_module(m)
+VECTORS = json.loads((ROOT / "contracts/absolute-reminder-vectors.json").read_text())["cases"]
+CASES = [(case, kind, projected) for case in VECTORS
+         for kind in case.get("kinds", ["VEVENT", "VTODO"]) for projected in [False, True]]
+
+
+def calendar(case, kind):
+    lines = ["BEGIN:VCALENDAR", "VERSION:2.0", "BEGIN:" + kind,
+             "UID:owned-absolute-alarm", "SUMMARY:Owned absolute alarm"]
+    if case["start"]:
+        lines.append("DTSTART:" + case["start"])
+        if kind == "VTODO":
+            lines.append("DUE:" + case["start"])
+    if case.get("rule"):
+        lines.append("RRULE:" + case["rule"])
+    if case.get("status"):
+        lines.append("STATUS:" + case["status"])
+    alarm_component = "valarm" if case.get("alarmCase") == "lower" else "VALARM"
+    for trigger in case["triggers"]:
+        lines.extend(["BEGIN:" + alarm_component, "ACTION:" + case.get("action", "DISPLAY"),
+                      "TRIGGER;VALUE=DATE-TIME:" + trigger,
+                      "DESCRIPTION:PRIVATE ALARM TEXT", "END:" + alarm_component])
+    return "\r\n".join(lines + ["END:" + kind, "END:VCALENDAR", ""])
+
+
+def imported(case, kind):
+    data = m.ics_lesen(calendar(case, kind))
+    data["einstellungen"] = {"erinnerung": {"an": True, "vorlauf": 15,
+        "verpasste": case.get("missed", True)}, "sicherheit": {"erinnernTrotzKennwort": True}}
+    collection = "termine" if kind == "VEVENT" else "aufgaben"
+    for item in data[collection]:
+        item["icsQuelleId"] = "owned-calendar"
+        item["notiz"] = "PRIVATE ITEM TEXT"
+        if case.get("structured"):
+            item["alarme"] = [{"bearbeitbar": False, "aktiviert": case.get("enabled", True),
+                "aktion": case.get("action", "DISPLAY").lower(), "triggerRaw": trigger}
+                for trigger in case["triggers"]]
+    return data
+
+
+def run(data, now, state=None, missed=True):
+    result = m.faellige_erinnerungen(data, now, state or {}, verpasste=missed)
+    result = m.faellige_aufgaben(data, now, result, verpasste=missed)
+    # Accept the legacy public result keys too, so running these behavioral
+    # vectors against the previous product does not manufacture lost alarms.
+    alarms = [x for key in ("faellig", "verpasst") for x in result[key]
+              if "@absolute:" in x["id"] or ":alarm-absolut-" in x["id"] or
+              re.search(r"-alarm-(?:START|END)-\d{4}-\d{2}-\d{2}", x["id"])]
+    return alarms, result["zustand"]
+
+
+@pytest.mark.parametrize("case,kind,projected", CASES,
+    ids=[f"{case['name']}-{kind}-{'background' if projected else 'original'}" for case, kind, projected in CASES])
+def test_absolute_vectors(case, kind, projected, monkeypatch):
+    monkeypatch.setattr(m, "_organizer_zeitzone", lambda: ZoneInfo(case["zone"]))
+    data = imported(case, kind)
+    if projected:
+        data = m.erinnerungsdaten_auswaehlen(data)
+        assert "PRIVATE" not in json.dumps(data)
+    before = copy.deepcopy(data)
+    now = datetime.fromisoformat(case["now"].replace("Z", "+00:00"))
+    alarms, state = run(data, now, missed=case.get("missed", True))
+    assert len(alarms) == case["expected"]
+    assert len({x["id"] for x in alarms}) == len(alarms)
+    assert run(data, now, json.loads(json.dumps(state)), case.get("missed", True))[0] == []
+    assert data == before
+
+
+@pytest.mark.parametrize("kind", ["VEVENT", "VTODO"])
+def test_actual_state_file_restart_and_changed_date(kind, tmp_path, monkeypatch):
+    monkeypatch.setattr(m, "_organizer_zeitzone", lambda: ZoneInfo("UTC"))
+    case = VECTORS[0]
+    data = imported(case, kind)
+    now = datetime.fromisoformat(case["now"].replace("Z", "+00:00"))
+    alarms, state = run(data, now)
+    assert len(alarms) == 1
+    path = str(tmp_path / "state.json")
+    m.erinnerung_zustand_schreiben(state, pfad=path)
+    restored = m.erinnerung_zustand_lesen(pfad=path)
+    moved = imported(dict(case, start="20261201T123000Z"), kind)
+    assert run(moved, now + timedelta(seconds=1), restored)[0] == []
+
+
+def test_next_wake_uses_absolute_trigger_outside_occurrence_window(monkeypatch):
