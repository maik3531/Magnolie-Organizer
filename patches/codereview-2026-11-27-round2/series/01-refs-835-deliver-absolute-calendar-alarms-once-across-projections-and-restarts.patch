+def test_projection_remains_idempotent_for_absolute_and_followup_alarms(monkeypatch):
+    monkeypatch.setattr(m, "_organizer_zeitzone", lambda: ZoneInfo("UTC"))
+    for trigger in ["20261127T103045Z", "+PT10M", "-PT10M"]:
+        raw = {"bearbeitbar": False, "triggerRaw": trigger, "aktion": "display"}
+        normalized = m._alarm_normalisieren(raw)
+        assert normalized is not None
+        assert m._alarm_normalisieren(json.loads(json.dumps(normalized))) == normalized
+
