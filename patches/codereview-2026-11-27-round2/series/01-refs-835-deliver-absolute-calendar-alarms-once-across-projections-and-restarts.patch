+@pytest.mark.parametrize("kind", ["VEVENT", "VTODO"])
+def test_same_uid_in_two_sources_and_confidential_projection(kind, monkeypatch):
+    monkeypatch.setattr(m, "_organizer_zeitzone", lambda: ZoneInfo("UTC"))
+    case = VECTORS[0]
+    data = imported(case, kind)
+    key = "termine" if kind == "VEVENT" else "aufgaben"
+    other = copy.deepcopy(data[key][0])
+    other.pop("id", None)
+    data[key][0].pop("id", None)
+    other["icsQuelleId"] = "other-calendar"
+    data[key].append(other)
+    now = datetime.fromisoformat(case["now"].replace("Z", "+00:00"))
+    assert len(run(data, now)[0]) == 2
+    other["vertraulich"] = True
+    assert len(run(m.erinnerungsdaten_auswaehlen(data), now)[0]) == 1
