From 14bc2fa1330037120f98b6dc31c76f5690a29eb6 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 27 Nov 2026 13:45:44 +0100
Subject: [PATCH] Refs #837: Retain exact H/N CSV task priority values

Add H and N to both existing exact priority sets, preserving current column aliases and completion handling. Extend the existing shared CSV/VTODO contract by two rows. The four-value reader probe fails both short values before this change and passes all eight port/value cases after it; the shared regression passes three Python groups and one C# group with all fourteen rows.
---
 ARBEITSSTAND.md                             | 3 +++
 contracts/lotus-task-csv-vectors.json       | 2 ++
 magnolie-organizer-windows/ExchangeCodec.cs | 4 ++--
 magnolie-organizer/bin/magnolie-organizer   | 4 ++--
 4 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/ARBEITSSTAND.md b/ARBEITSSTAND.md
index 1626ee65..6c570cd8 100644
--- a/ARBEITSSTAND.md
+++ b/ARBEITSSTAND.md
@@ -98,6 +98,9 @@ aufgeführt.
   Zwölf gemeinsame Aufgaben bestanden den CSV-/VTODO-Rundlauf auf
   Linux und nativ aus dem Windows-Quellarchiv; der Linux-Import-/Export-Vertrag
   und die portable Windows-Regression bestanden ebenfalls.
+  Die ergänzten Kurzwerte `H` (hoch) und `N` (niedrig) sind mit insgesamt
+  14 gemeinsamen Aufgaben im CSV-/VTODO-Rundlauf auf Linux und im
+  .NET-Quellhost geprüft. Die native Windows-Abnahme dieser Ergänzung steht aus.
 - [#836](https://github.com/maik3531/Magnolie-Organizer/issues/836):
   Notes bereitet Anhänge im Hintergrund vor und zeigt bei Cache-,
   Provider- oder Startfehlern die vorhandene Meldung. Fünf gezielte
diff --git a/contracts/lotus-task-csv-vectors.json b/contracts/lotus-task-csv-vectors.json
index 9dedacfa..4e3d8fb8 100644
--- a/contracts/lotus-task-csv-vectors.json
+++ b/contracts/lotus-task-csv-vectors.json
@@ -5,6 +5,8 @@
       { "csv": "English completed;31.05.2026;Hoch;Completed", "done": true, "priority": 1 },
       { "csv": "Deutsch abgeschlossen;31.05.2026;3;Abgeschlossen", "done": true, "priority": 3 },
       { "csv": "Deutsch niedrig;31.05.2026;Niedrig;Ja", "done": true, "priority": 3 },
+      { "csv": "High short value;31.05.2026;H;Nein", "done": false, "priority": 1 },
+      { "csv": "Low short value;31.05.2026;N;Nein", "done": false, "priority": 3 },
       { "csv": "Deutsch normal;31.05.2026;Normal;Nein", "done": false, "priority": 2 },
       { "csv": "Unknown words;31.05.2026;Not set;Not completed", "done": false, "priority": 2 },
       { "csv": "Unknown number;31.05.2026;10;Offen", "done": false, "priority": 2 },
diff --git a/magnolie-organizer-windows/ExchangeCodec.cs b/magnolie-organizer-windows/ExchangeCodec.cs
index 62e15239..d0f5dbea 100644
--- a/magnolie-organizer-windows/ExchangeCodec.cs
+++ b/magnolie-organizer-windows/ExchangeCodec.cs
@@ -775,8 +775,8 @@ internal static partial class ExchangeCodec
                     var title = Cell(descriptionIndex >= 0 ? descriptionIndex : Find("AUFGABE", "TITEL")); if (title.Length == 0) { omitted++; continue; }
                     var priority = Cell(taskPriorityIndex).ToUpperInvariant() switch
                     {
-                        "1" or "HOCH" or "HIGH" => 1,
-                        "3" or "NIEDRIG" or "LOW" => 3,
+                        "1" or "H" or "HOCH" or "HIGH" => 1,
+                        "3" or "N" or "NIEDRIG" or "LOW" => 3,
                         _ => 2
                     };
                     var status = Cell(taskStatusIndex);
diff --git a/magnolie-organizer/bin/magnolie-organizer b/magnolie-organizer/bin/magnolie-organizer
index b1eb83d3..a7a4d872 100755
--- a/magnolie-organizer/bin/magnolie-organizer
+++ b/magnolie-organizer/bin/magnolie-organizer
@@ -6332,9 +6332,9 @@ def _lotus_aufgaben(zeilen, kopf):
             continue
         roh_prio = hol("prio").upper()
         prio = 2
-        if roh_prio in ("1", "HOCH", "HIGH"):
+        if roh_prio in ("1", "H", "HOCH", "HIGH"):
             prio = 1
-        elif roh_prio in ("3", "NIEDRIG", "LOW"):
+        elif roh_prio in ("3", "N", "NIEDRIG", "LOW"):
             prio = 3
         aufgaben.append({
             "titel": titel,
