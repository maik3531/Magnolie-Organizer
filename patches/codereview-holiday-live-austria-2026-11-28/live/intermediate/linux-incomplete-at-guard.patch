+def _openholidays_region_code(code, zum_dienst=False):
+    """Map Austrian ISO state identities at the provider boundary (Refs #856)."""
+    import unicodedata
+    code = unicodedata.normalize("NFC", str(code or "")).strip().upper()
+    austria = {
+        "AT-1": "AT-BL", "AT-2": "AT-KÄ", "AT-3": "AT-NÖ",
+        "AT-4": "AT-OÖ", "AT-5": "AT-SB", "AT-6": "AT-SM",
+        "AT-7": "AT-TI", "AT-8": "AT-VA", "AT-9": "AT-WI",
+    }
+    if not code.startswith("AT-"):
+        return code
+    if zum_dienst:
+        return austria.get(code)
+    if code in austria:
+        return code
+    # Unknown Austrian codes, including apparent ISO children, cannot certify
+    # complete coverage merely by passing the generic parent/child matcher.
+    return next((iso for iso, provider in austria.items() if provider == code), None)
+
+
