+#!/usr/bin/env python3
+"""Refs #855: compile actual C# holiday bridge/parser with bounded HTTP doubles.
+
+Uses an existing .NET 8 SDK; downloads/installs nothing. Build files remain in
+the explicitly supplied scratch directory. --source-root supports baseline
+replay with exactly the same case file and unchanged public entry point.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--dotnet", default="dotnet")
+    parser.add_argument("--source-root", type=Path, default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--build-dir", required=True, type=Path)
+    args = parser.parse_args()
