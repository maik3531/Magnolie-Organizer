-      assert.equal(T.icsRuntime.state.worker, null, "A dead worker must not be reused for new jobs");
-      assert.equal(w.document.body.dataset.recurrenceState, "error");
-      assert.equal(w.document.body.getAttribute("aria-busy"), "false");
-      assert.equal(terminated, 1);
-      assert.equal(T.icsRuntime("expand", item, [1, 2]), null);
-      assert.equal(constructed, 2, "A new query after a crash needs a live worker");
-      T.icsRuntime.state.worker.onerror(new Error("worker crashed again"));
+      const beforeUrls = blobs.size, beforeBytes = retainedBlobBytes(), beforeListeners = unloadListeners.size;
+      let staleWorker = null;
+      for (let attempt = 0; attempt < 32; attempt++) {
+        assert.equal(T.icsRuntime("expand", item, [attempt, attempt + 1]), null);
+        const worker = T.icsRuntime.state.worker, key = [...T.icsRuntime.state.jobs.keys()].at(-1);
+        assert.equal(blobs.size, beforeUrls + 1, "A live worker must retain its source URL until disposal");
+        assert.ok(retainedBlobBytes() > beforeBytes);
+        if (staleWorker) {
+          staleWorker.onerror(new Error("late error from disposed worker"));
+          staleWorker.onmessage({ data: { key, timeZoneIdentity: "wrong-old-provider" } });
+          assert.equal(T.icsRuntime.state.worker, worker, "A stale worker disposed its replacement");
+          assert.equal(T.icsRuntime.state.jobs.get(key).status, "pending", "A stale worker changed the replacement's job");
+        }
+        if (attempt % 2) worker.onmessage({ data: { key, timeZoneIdentity: "wrong-provider" } });
+        else worker.onerror(new Error("worker crashed"));
+        assert.equal(T.icsRuntime.state.worker, null, "A dead worker must not be reused for new jobs");
+        assert.equal(w.document.body.dataset.recurrenceState, "error");
+        assert.equal(w.document.body.getAttribute("aria-busy"), "false");
+        assert.equal(blobs.size, beforeUrls, "Disposal retained a worker object URL");
+        assert.equal(retainedBlobBytes(), beforeBytes, "Disposal retained worker source bytes");
+        assert.equal(unloadListeners.size, beforeListeners, "Disposal retained a worker unload listener");
+        staleWorker = worker;
+      }
+      assert.equal(constructed, 32, "New queries after disposal need a live worker");
+      assert.equal(terminated, 32, "Each disposed worker must be terminated once");
+      assert.equal(T.icsRuntime("expand", item, [32, 33]), null);
+      assert.equal(blobs.size, beforeUrls + 1, "Successful construction must not revoke the active source early");
       T.icsRuntime.state = undefined;
       w.Worker = undefined;
       assert.equal(T.icsRuntime("expand", { icsRoundtrip: ["DTSTART:20260907T090000Z", "RRULE:FREQ=INVALID"] }, [0, 1]), null);
@@ -173,6 +217,10 @@ const { JSDOM } = require("jsdom");
       assert.equal(w.document.body.getAttribute("aria-busy"), "false");
       assert.equal(JSON.stringify(T.daten()), stored);
       w.Worker = originalWorker;
+      w.dispatchEvent(new w.Event("unload"));
+      assert.equal(blobs.size, 0, "Document unload must release every remaining worker source URL");
+      assert.equal(retainedBlobBytes(), 0);
+      assert.equal(unloadListeners.size, 0, "Document unload must release worker listeners");
     } finally { try { await workerFiles.close(); } finally { dom.window.close(); } }
   }
   process.stdout.write(`RECURRENCE WORKERS PASSED (${webRoots.length} packaged/source web roots)\n`);
