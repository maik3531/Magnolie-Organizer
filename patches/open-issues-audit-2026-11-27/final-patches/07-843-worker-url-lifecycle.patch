-    const w = dom.window, blobs = new Map(), workers = [];
+    const w = dom.window, blobs = new Map(), workers = [], unloadListeners = new Map();
+    let blobSequence = 0;
+    const addListener = w.addEventListener.bind(w), removeListener = w.removeEventListener.bind(w);
+    w.addEventListener = (type, listener, options) => {
+      if (type !== "unload") return addListener(type, listener, options);
+      const wrapped = function (event) {
+        if (options?.once) unloadListeners.delete(listener);
+        return listener.call(this, event);
+      };
+      unloadListeners.set(listener, wrapped);
+      return addListener(type, wrapped, options);
+    };
+    w.removeEventListener = (type, listener, options) => {
+      const wrapped = type === "unload" ? unloadListeners.get(listener) : null;
+      if (type === "unload") unloadListeners.delete(listener);
+      return removeListener(type, wrapped || listener, options);
+    };
