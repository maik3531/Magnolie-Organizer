 2 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/magnolie-organizer-windows/ExchangeCodec.cs b/magnolie-organizer-windows/ExchangeCodec.cs
index 08c3b68559d74f1fd718d2b7bf4a2283debe2a60..220df6371d6d3747d5b15c43285643158a5a4a32 100644
