+"""#845: explicit Nextcloud birthdays, without changing unrelated annual events."""
+import json
+from pathlib import Path
+
+import pytest
+from test_nextcloud import m, nc, SyncDav, run_sync, empty_data
+
+
+CASES = json.loads((Path(__file__).resolve().parents[2] /
+                   "contracts/nextcloud-birthday-vectors.json").read_text())["cases"]
+
+
+@pytest.mark.parametrize("case", CASES, ids=lambda case: case["id"])
+def test_actual_codec_and_saved_json_roundtrip(case, tmp_path):
+    parsed = m.ics_lesen(case["ics"])
+    if case["date"] is None:
+        assert not parsed["jahrestage"] and len(parsed["termine"]) == case.get("appointments", 1)
+        exported = m.ics_schreiben_termine(parsed["termine"])
+        assert "RRULE:" + case["rule"] in m._entfalte_zeilen(exported)
+        assert not m.ics_lesen(exported)["jahrestage"]
+        return
+    assert not parsed["termine"] and len(parsed["jahrestage"]) == 1
+    item = parsed["jahrestage"][0]
+    assert (item["typ"], item["datum"]) == ("birthday", case["date"])
+    assert (item["akzentFarbe"], item["icsCalendarColor"]) == ("#ff0000", "X-APPLE-CALENDAR-COLOR:#123456")
+    saved = tmp_path / "synthetic-dto.json"
+    saved.write_text(json.dumps(item))
+    restored = json.loads(saved.read_text())
+    exported = m.ics_schreiben_jahrestage([restored])
+    lines = m._entfalte_zeilen(exported)
+    rule = "FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=-1" if case["date"].endswith("02-29") else "FREQ=YEARLY"
+    assert "RRULE:" + rule in lines
+    assert "DTSTART;VALUE=DATE:" + case["start"] in lines
+    for line in ("X-SYNTHETIC-PRESERVE:keep", "COLOR:red", "TRANSP:TRANSPARENT",
+                 "TRIGGER;VALUE=DURATION:PT9H", "DESCRIPTION:Keep alarm"):
+        assert line in lines
+    again = m.ics_lesen(exported)["jahrestage"][0]
+    for key in ("uid", "name", "datum", "typ", "notiz", "akzentFarbe", "icsCalendarColor"):
+        assert again[key] == item[key], key
+    assert lines.count("X-NEXTCLOUD-BC-FIELD-TYPE:BDAY") == 1
+
+
+@pytest.mark.parametrize("date", ["--12-03", "1950-12-03", "--02-29", "1988-02-29", "--03-01"])
+def test_edit_keeps_nextcloud_year_and_rule_coherent(date):
+    item = m.ics_lesen(CASES[0]["ics"])["jahrestage"][0]
+    item["datum"] = date
+    exported = m.ics_schreiben_jahrestage([item])
+    lines = m._entfalte_zeilen(exported)
+    yearless = date.startswith("--")
+    assert lines.count("X-NEXTCLOUD-BC-UNKNOWN-YEAR:" + ("1" if yearless else "0")) == 1
+    years = [line for line in lines if line.startswith("X-NEXTCLOUD-BC-YEAR:")]
+    assert years == ([] if yearless else ["X-NEXTCLOUD-BC-YEAR:" + date[:4]])
+    assert m.ics_lesen(exported)["jahrestage"][0]["datum"] == date
+
+
+@pytest.mark.parametrize("marker", ["X-MAGNOLIE-TYPE-ID:other", "X-MAGNOLIE-TYPE-ID:custom"])
+def test_nextcloud_does_not_override_an_explicit_different_type(marker):
+    text = CASES[2]["ics"].replace("BEGIN:VALARM", marker + "\r\nBEGIN:VALARM")
+    parsed = m.ics_lesen(text)
+    assert not any(item.get("typ") == "birthday" for item in parsed["jahrestage"])
+    assert len(parsed["termine"]) + len(parsed["jahrestage"]) == 1
+
+
+@pytest.mark.parametrize("index", [0, 4], ids=["normal", "yearless-leap"])
+def test_explicit_type_edit_removes_stale_birthday_markers(index):
+    item = m.ics_lesen(CASES[index]["ics"])["jahrestage"][0]
+    item["typ"] = "wedding-anniversary"
+    exported = m.ics_schreiben_jahrestage([item])
+    assert "X-NEXTCLOUD-BC-" not in exported
+    assert "X-SYNTHETIC-PRESERVE:keep" in exported
+    again = m.ics_lesen(exported)["jahrestage"][0]
+    assert (again["typ"], again["datum"]) == ("wedding-anniversary", item["datum"])
+    if item["datum"].endswith("02-29"):
+        assert "RRULE:FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=-1" in exported
+        assert "RRULE:FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=-1" in m.ics_schreiben_jahrestage([again])
+
+
+@pytest.mark.parametrize("case", [case for case in CASES if case["date"]], ids=lambda case: case["id"])
+def test_linux_dav_does_not_silently_omit_the_new_typed_scope(monkeypatch, case):
+    dav = SyncDav({"calendar": [dict(href="https://cloud.example/calendar/birthday.ics",
+                                   etag='"fixture"', data=case["ics"])], "addressbook": []})
+    data = empty_data()
+    before = json.dumps(data, sort_keys=True)
+    with pytest.raises(nc.NextcloudError) as failed:
+        run_sync(monkeypatch, dav, data)
+    assert failed.value.code == "calendar_anniversaries_unsupported"
+    assert not dav.puts and not dav.deletes and json.dumps(data, sort_keys=True) == before
