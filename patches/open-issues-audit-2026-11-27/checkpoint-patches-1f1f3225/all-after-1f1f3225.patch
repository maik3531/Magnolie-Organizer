diff --git a/magnolie-organizer-windows/tests/CalendarColourRemainderTests.cs b/magnolie-organizer-windows/tests/CalendarColourRemainderTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..be633dcbffca827d6987b7a6c70409252812d9c1
--- /dev/null
+++ b/magnolie-organizer-windows/tests/CalendarColourRemainderTests.cs
@@ -0,0 +1,75 @@
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using MagnolieOrganizer.Windows;
+
+namespace MagnolieOrganizer.Windows.Tests;
+
+internal static class CalendarColourRemainderTests
+{
+    internal static Task RunAsync()
+    {
+        const string marker = "contracts/calendar-color-remainders.json";
+        var vectors = JsonNode.Parse(File.ReadAllText(Path.Combine(TestSource.Root(marker), marker)))!.AsArray();
+        var directory = Path.Combine(Path.GetTempPath(), "magnolie-colour-remainder-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        try
+        {
+            var store = new AtomicStore();
+            foreach (var vector in vectors.OfType<JsonObject>())
+            {
+                var id = vector["id"]!.GetValue<string>();
+                var section = vector["section"]!.GetValue<string>();
+                var expected = vector["expected_accent"]!.GetValue<string>();
+                var preserve = vector["preserve_line"]!.GetValue<string>();
+                var imported = Read(vector["input"]!.GetValue<string>());
+                var path = Path.Combine(directory, id + ".json");
+                store.WriteRecoverableJson(path, imported.ToJsonString());
+                var reopened = JsonNode.Parse(store.ReadRecoverableJson(path)!)!.AsObject();
+                var item = reopened[section]![0]!.AsObject();
+                TestAssert.That(Colour(item) == expected, id + ": native book reopen lost its imported accent.");
+                if (section == "jahrestage")
+                    TestAssert.That(item["datum"]!.GetValue<string>() == vector["expected_date"]!.GetValue<string>() &&
+                        item["typ"]!.GetValue<string>() == vector["expected_type"]!.GetValue<string>() &&
+                        reopened["termine"]!.AsArray().Count == 0, id + ": annual type or date changed.");
+                var text = Write(section, new JsonArray(item.DeepClone()));
+                TestAssert.That(text.Contains("X-OWNED:keep", StringComparison.Ordinal) &&
+                    (preserve.Length == 0 || text.Split("\r\n").Contains(preserve)), id + ": unchanged foreign property was lost.");
+                var again = Read(text);
+                TestAssert.That(Colour(again[section]![0]!) == expected, id + ": export/reimport lost its accent.");
+                if (section == "jahrestage")
+                    TestAssert.That(again[section]![0]!["datum"]!.GetValue<string>() == vector["expected_date"]!.GetValue<string>() &&
+                        again[section]![0]!["typ"]!.GetValue<string>() == vector["expected_type"]!.GetValue<string>() &&
+                        again["termine"]!.AsArray().Count == 0, id + ": export/reimport changed its annual identity.");
+                foreach (var accent in new[] { "#123456", "" })
+                {
+                    item["akzentFarbe"] = accent;
+                    var changed = Write(section, new JsonArray(item.DeepClone()));
+                    TestAssert.That(Colour(Read(changed)[section]![0]!) == accent && changed.Contains("X-OWNED:keep", StringComparison.Ordinal),
+                        id + ": explicit edit/clear restored an old colour or removed unrelated data.");
+                    if (preserve.StartsWith("COLOR;X-SOURCE", StringComparison.Ordinal))
+                        TestAssert.That(!changed.Split("\r\n").Contains(preserve), id + ": an edited colour retained the old effective property.");
+                    if (preserve == "COLOR:future-colour")
+                        TestAssert.That(changed.Split("\r\n").Contains(preserve), id + ": unknown colour was reinterpreted.");
+                }
+            }
+            var coloured = vectors.OfType<JsonObject>().Single(value => value["id"]!.GetValue<string>() == "birthday-calendar")["input"]!.GetValue<string>();
+            var other = coloured.Replace("COLOR:turquoise\r\n", "", StringComparison.Ordinal).Replace("birthday-calendar", "uncoloured", StringComparison.Ordinal);
+            var mixed = Write("jahrestage", Read(coloured + other)["jahrestage"]!.AsArray());
+            var result = Read(mixed)["jahrestage"]!.AsArray();
+            TestAssert.That(!mixed[..mixed.IndexOf("BEGIN:VEVENT", StringComparison.Ordinal)].Contains("COLOR:turquoise", StringComparison.Ordinal) &&
+                Colour(result[0]!) == "#40e0d0" && Colour(result[1]!) == "", "Mixed anniversary calendars leaked a colour into another source.");
+            Console.WriteLine($"Calendar colour remainders: {vectors.Count} native store/reopen/export vectors, {vectors.Count} edit/clear vectors, one mixed-calendar case.");
+            return Task.CompletedTask;
+        }
+        finally { Directory.Delete(directory, true); }
+    }
+
+    private static string Colour(JsonNode value) => value["akzentFarbe"]?.GetValue<string>() ?? "";
+    private static JsonObject Read(string text) => ExchangeCodec.ParseImport(Encoding.UTF8.GetBytes(text), "ics", "colour-remainders.ics").ToPayload("ics", "colour-remainders.ics");
+    private static string Write(string section, JsonArray data)
+    {
+        using var document = JsonDocument.Parse(data.ToJsonString());
+        return ExchangeCodec.WriteIcs("ics-" + section, document.RootElement).Text;
+    }
+}
diff --git a/magnolie-organizer-windows/tests/LotusCsvContactFieldTests.cs b/magnolie-organizer-windows/tests/LotusCsvContactFieldTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..f85bf44b9c50b24e002b1c60464ca281b3e5e593
--- /dev/null
+++ b/magnolie-organizer-windows/tests/LotusCsvContactFieldTests.cs
@@ -0,0 +1,50 @@
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using MagnolieOrganizer.Windows;
+
+namespace MagnolieOrganizer.Windows.Tests;
+
+internal static class LotusCsvContactFieldTests
+{
+    private static string[] Rows(JsonArray values, params string[] fields) => values.OfType<JsonObject>()
+        .Select(value => JsonSerializer.Serialize(fields.Select(field => value[field]?.ToString() ?? "")
+            .Append(string.Join(',', (value["typen"] as JsonArray ?? []).Select(type => type!.ToString()).Order(StringComparer.Ordinal)))))
+        .Order(StringComparer.Ordinal).ToArray();
+
+    internal static Task RunAsync()
+    {
+        const string relative = "contracts/lotus-csv-contact-fields.json";
+        var vectors = JsonNode.Parse(File.ReadAllText(Path.Combine(TestSource.Root(relative), relative)))!["cases"]!.AsArray();
+        var failures = new List<string>();
+        foreach (var vector in vectors.OfType<JsonObject>())
+        {
+            var id = vector["id"]!.ToString();
+            void Check(bool passed, string message) { if (!passed) failures.Add(id + ": " + message); }
+            string Csv(JsonNode? field) => "\"" + field!.ToString().Replace("\"", "\"\"") + "\"";
+            var raw = Encoding.UTF8.GetBytes(string.Join(';', vector["headers"]!.AsArray().Select(Csv)) + "\r\n" +
+                string.Join(';', vector["row"]!.AsArray().Select(Csv)) + "\r\n");
+            var result = ExchangeCodec.ParseImport(raw, "lotus", "owned-contacts.csv");
+            Check(result.Uebersprungen == 0 && result.Kontakte.Count == 1, "CSV record count changed");
+            if (result.Kontakte.Count != 1) continue;
+            Check(JsonNode.DeepEquals(result.Kontakte, ExchangeCodec.ParseImport(raw, "vcf", "owned-contacts.csv").Kontakte), "Contact-file import disagrees with Lotus import");
+            var contact = result.Kontakte[0]!.AsObject();
+            for (var cycle = 0; cycle < 3; cycle++)
+            {
+                Check(contact["vorname"]!.ToString() == "Synthetic" && contact["nachname"]!.ToString() == "CSV", "Contact name changed");
+                Check(Rows(contact["telefone"]!.AsArray(), "wert").SequenceEqual(Rows(vector["phones"]!.AsArray(), "wert")), "Phone values or roles changed");
+                var addresses = contact["anschriften"]!.AsArray();
+                Check(Rows(addresses, "strasse", "plz", "ort", "land").SequenceEqual(Rows(vector["addresses"]!.AsArray(), "strasse", "plz", "ort", "land")), "Address lost, fabricated or assigned to another role");
+                if (addresses.Count > 0)
+                    Check(new[] { "strasse", "plz", "ort" }.All(field => contact[field]!.ToString() == addresses[0]![field]!.ToString()), "Legacy address fields combine different locations");
+                var exported = RecordExportFile.Convert("vcf-adressen", JsonSerializer.SerializeToElement(new JsonArray(contact.DeepClone())));
+                Check(exported.Count == 1 && exported.Skipped == 0, "VCF export lost the contact");
+                var reread = ExchangeCodec.ParseImport(Encoding.UTF8.GetBytes(exported.Text), "vcf", "owned.vcf");
+                Check(reread.Kontakte.Count == 1 && reread.Uebersprungen == 0, "VCF import lost the contact");
+                contact = reread.Kontakte.Single()!.AsObject();
+            }
+        }
+        TestAssert.That(failures.Count == 0, string.Join("\n", failures));
+        return Task.CompletedTask;
+    }
+}
diff --git a/magnolie-organizer-windows/tests/NextcloudBirthdayMarkerTests.cs b/magnolie-organizer-windows/tests/NextcloudBirthdayMarkerTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..b7255ba814ccc8147f2149d70bbb95d7ea6fa9d2
--- /dev/null
+++ b/magnolie-organizer-windows/tests/NextcloudBirthdayMarkerTests.cs
@@ -0,0 +1,82 @@
+using System.Text.Json;
+using System.Text.Json.Nodes;
+
+namespace MagnolieOrganizer.Windows.Tests;
+
+internal static class NextcloudBirthdayMarkerTests
+{
+    internal static Task RunAsync()
+    {
+        using var vectors = JsonDocument.Parse(File.ReadAllText("../contracts/nextcloud-birthday-vectors.json"));
+        foreach (var fixture in vectors.RootElement.GetProperty("cases").EnumerateArray())
+        {
+            var id = fixture.GetProperty("id").GetString()!;
+            var parsed = ExchangeCodec.ParseIcs(fixture.GetProperty("ics").GetString()!);
+            var expected = fixture.GetProperty("date").GetString();
+            if (expected is null)
+            {
+                TestAssert.That(parsed.Jahrestage.Count == 0 && parsed.Termine.Count ==
+                    (fixture.TryGetProperty("appointments", out var count) ? count.GetInt32() : 1), id + " became a birthday");
+                var exported = Write("ics-termine", parsed.Termine);
+                TestAssert.That(exported.Contains("RRULE:" + fixture.GetProperty("rule").GetString() + "\r\n") &&
+                    ExchangeCodec.ParseIcs(exported).Jahrestage.Count == 0, id + " changed its annual rule/type");
+                continue;
+            }
+            TestAssert.That(parsed.Termine.Count == 0 && parsed.Jahrestage.Count == 1, id + " is not a typed birthday");
+            var item = parsed.Jahrestage[0]!.AsObject();
+            TestAssert.That(item["typ"]!.ToString() == "birthday" && item["datum"]!.ToString() == expected, id + " lost type/year");
+            TestAssert.That(item["akzentFarbe"]!.ToString() == "#ff0000" && item["icsCalendarColor"]!.ToString() == "X-APPLE-CALENDAR-COLOR:#123456", id + " lost colour");
+            // JSON persistence seam, not a claim of a native GUI/book commit.
+            var restored = JsonNode.Parse(item.ToJsonString())!.AsObject();
+            var output = Write("ics-jahrestage", restored);
+            var rule = expected.EndsWith("02-29", StringComparison.Ordinal) ? "FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=-1" : "FREQ=YEARLY";
+            TestAssert.That(output.Contains("RRULE:" + rule + "\r\n") &&
+                output.Contains("DTSTART;VALUE=DATE:" + fixture.GetProperty("start").GetString() + "\r\n"), id + " changed the recurrence/anchor");
+            foreach (var line in new[] { "X-SYNTHETIC-PRESERVE:keep", "COLOR:red", "TRANSP:TRANSPARENT", "TRIGGER;VALUE=DURATION:PT9H", "DESCRIPTION:Keep alarm" })
+                TestAssert.That(output.Contains(line + "\r\n"), id + " lost " + line);
+            var again = ExchangeCodec.ParseIcs(output).Jahrestage[0]!.AsObject();
+            foreach (var key in new[] { "uid", "name", "datum", "typ", "notiz", "akzentFarbe", "icsCalendarColor" })
+                TestAssert.That(JsonNode.DeepEquals(again[key], item[key]), id + " changed " + key);
+            TestAssert.That(output.Split("X-NEXTCLOUD-BC-FIELD-TYPE:BDAY").Length == 2, id + " duplicated marker");
+        }
+        foreach (var marker in new[] { "X-MAGNOLIE-TYPE-ID:other", "X-MAGNOLIE-TYPE-ID:custom" })
+        {
+            var text = vectors.RootElement.GetProperty("cases")[2].GetProperty("ics").GetString()!.Replace("BEGIN:VALARM", marker + "\r\nBEGIN:VALARM");
+            var parsed = ExchangeCodec.ParseIcs(text);
+            TestAssert.That(parsed.Jahrestage.All(item => item!["typ"]?.ToString() != "birthday") &&
+                parsed.Termine.Count + parsed.Jahrestage.Count == 1, marker + " was overridden by Nextcloud metadata");
+        }
+        foreach (var index in new[] { 0, 4 })
+        {
+            var item = ExchangeCodec.ParseIcs(vectors.RootElement.GetProperty("cases")[index].GetProperty("ics").GetString()!).Jahrestage[0]!.AsObject();
+            item["typ"] = "wedding-anniversary";
+            var output = Write("ics-jahrestage", item);
+            TestAssert.That(!output.Contains("X-NEXTCLOUD-BC-") && output.Contains("X-SYNTHETIC-PRESERVE:keep"), "Type edit retained stale BDAY markers or lost foreign metadata");
+            var again = ExchangeCodec.ParseIcs(output).Jahrestage[0]!.AsObject();
+            TestAssert.That(again["typ"]!.ToString() == "wedding-anniversary" && JsonNode.DeepEquals(again["datum"], item["datum"]), "Type edit changed canonical date/type");
+            if (item["datum"]!.ToString().EndsWith("02-29", StringComparison.Ordinal))
+                TestAssert.That(output.Contains("RRULE:FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=-1") &&
+                    Write("ics-jahrestage", again).Contains("RRULE:FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=-1"), "Type edit changed last-February recurrence");
+        }
+        foreach (var date in new[] { "--12-03", "1950-12-03", "--02-29", "1988-02-29", "--03-01" })
+        {
+            var item = ExchangeCodec.ParseIcs(vectors.RootElement.GetProperty("cases")[0].GetProperty("ics").GetString()!).Jahrestage[0]!.AsObject();
+            item["datum"] = date;
+            var output = Write("ics-jahrestage", item);
+            var yearless = date.StartsWith("--", StringComparison.Ordinal);
+            TestAssert.That(output.Contains("X-NEXTCLOUD-BC-UNKNOWN-YEAR:" + (yearless ? "1" : "0") + "\r\n"), date + " wrong unknown-year flag");
+            var years = output.Split("\r\n").Where(line => line.StartsWith("X-NEXTCLOUD-BC-YEAR:", StringComparison.Ordinal)).ToArray();
+            TestAssert.That(years.SequenceEqual(yearless ? [] : new[] { "X-NEXTCLOUD-BC-YEAR:" + date[..4] }), date + " stale year marker");
+            TestAssert.That(ExchangeCodec.ParseIcs(output).Jahrestage[0]!["datum"]!.ToString() == date, date + " failed edited reimport");
+        }
+        return Task.CompletedTask;
+    }
+
+    private static string Write(string kind, JsonObject item) => Write(kind, new JsonArray(item.DeepClone()));
+
+    private static string Write(string kind, JsonArray items)
+    {
+        using var data = JsonDocument.Parse(items.ToJsonString());
+        return ExchangeCodec.WriteIcs(kind, data.RootElement).Text;
+    }
+}
