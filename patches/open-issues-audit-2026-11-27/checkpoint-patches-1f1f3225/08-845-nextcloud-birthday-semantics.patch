+def _ics_letzter_februartag(props, datum):
+    regeln, tiefe = [], 0
+    for prop in props:
+        if not prop:
+            continue
+        name, _params, wert = prop
+        if name == "BEGIN":
+            tiefe += 1
+        elif name == "END":
+            tiefe = max(0, tiefe - 1)
