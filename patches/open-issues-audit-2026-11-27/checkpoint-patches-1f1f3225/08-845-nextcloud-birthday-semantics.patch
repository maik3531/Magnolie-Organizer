+            sorted(teil for teil in teile if teil != "INTERVAL=1") ==
+            ["BYMONTH=2", "BYMONTHDAY=-1", "FREQ=YEARLY"])
+
+
+def _nextcloud_geburtstagsdatum(props):
+    """Only promote an unambiguous, representable BirthdayService BDAY."""
+    haupt, tiefe = {}, 0
+    for prop in props:
+        if not prop:
+            continue
+        name, params, wert = prop
+        if name == "BEGIN":
+            tiefe += 1
+        elif name == "END":
