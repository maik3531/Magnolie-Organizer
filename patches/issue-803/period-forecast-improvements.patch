+
+/* Optional cycle estimates are derived display, never recorded bleeding. */
+.zyklus-prognose-kasten {
+  flex: 0 0 auto;
+  max-height: 24vh;
+  overflow-y: auto;
+  margin: 8px;
+  padding: 10px 12px;
