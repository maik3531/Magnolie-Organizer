+        foreach (var item in vectors)
+        {
+            var result = JsonSerializer.SerializeToNode(Estimate(item!["data"], item["asOf"]!.GetValue<string>()), camelCase)!.AsObject();
+            foreach (var expected in item["expected"]!.AsObject())
