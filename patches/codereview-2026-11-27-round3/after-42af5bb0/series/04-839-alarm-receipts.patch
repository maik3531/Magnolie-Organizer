+            .put(JSONObject().put("id","two").put("uid","same-source-uid")))
+        assertEquals(2,count(book,JSONArray().put(row("kalender:one:absolute:100000")).put(row("kalender:one:100000"))
+            .put(row("kalender:two:absolute:100000")).put(row("kalender:two:100000"))))
+        assertEquals(2,count(book,JSONArray().put(row("kalender:one:absolute:100017",100017L)).put(row("kalender:one:100000"))))
+        book.getJSONArray("aufgaben").put(JSONObject().put("id","one"))
+        assertEquals(2,count(book,JSONArray().put(row("kalender:one:absolute:100000")).put(row("kalender:one:100000"))
+            .put(row("aufgaben:one:absolute:100000",section="aufgaben")).put(row("aufgaben:one:100000",section="aufgaben"))))
+        book.getJSONArray("termine").put(JSONObject().put("id","one:absolute"))
+        assertEquals(2,count(book,JSONArray().put(row("kalender:one:absolute:100000")).put(row("kalender:one:100000"))))
+        book.put("termine",JSONArray().put(JSONObject().put("id","one")).put(JSONObject().put("id","one")))
+        assertEquals(2,count(book,JSONArray().put(row("kalender:one:absolute:100000")).put(row("kalender:one:100000"))))
+    }
