diff --git a/Magnolie-Organizer-Android-Tablet-Beta/app/src/main/java/io/gitlab/maik3531/magnolietabletbeta/Vault.kt b/Magnolie-Organizer-Android-Tablet-Beta/app/src/main/java/io/gitlab/maik3531/magnolietabletbeta/Vault.kt
index 85d720d6eb86db6e58e6cb7a2ae63e7db78c823a..723ea31af3ee98dff752f03ba0d47802bd95e449 100644
--- a/Magnolie-Organizer-Android-Tablet-Beta/app/src/main/java/io/gitlab/maik3531/magnolietabletbeta/Vault.kt
+++ b/Magnolie-Organizer-Android-Tablet-Beta/app/src/main/java/io/gitlab/maik3531/magnolietabletbeta/Vault.kt
@@ -170,20 +170,31 @@ internal class Vault(directory: File, key: () -> SecretKey,
         require(alarms.length() <= 100000)
         for (i in 0 until alarms.length()) {
             val a = alarms.getJSONObject(i)
-            require(a.getString("id").length <= 1024 && a.getLong("at") > 0)
+            alarmReceiptIds(a)
+            require(a.getLong("at") > 0)
             require(a.getString("section") in setOf("kalender", "aufgaben"))
             require(a.getString("title").length <= 300)
             a.getBoolean("custom")
         }
         val value = current ?: JSONObject().put("format", 1).put("enabled", false)
             .put("customEnabled", false).put("delivered", JSONObject())
-        value.put("data", data).put("alarms", alarms).put("revision", UUID.randomUUID().toString())
-        // Keep delivery receipts only for live alarms; edits/deletions invalidate old schedules.
         val old = value.optJSONObject("delivered") ?: JSONObject()
+        // Reconcile pre-alias plans against their old saved book before an edit
+        // removes one of the coincident alarms or changes the current record.
+        for (alarm in coincidentAlarms(value)) {
+            val ids = alarmReceiptIds(alarm)
+            val previous = ids.firstOrNull(old::has)
+            if (previous != null) ids.forEach { old.put(it, old.get(previous)) }
+        }
+        value.put("data", data).put("alarms", alarms).put("revision", UUID.randomUUID().toString())
+        // A coincident ordinary/absolute alarm acknowledges all of its former
+        // identities. Keep them across save/reopen and removal of either kind.
+        // Other deleted schedules still lose their receipts as before.
         val retained = JSONObject()
         for (i in 0 until alarms.length()) {
-            val id = alarms.getJSONObject(i).getString("id")
-            if (old.has(id)) retained.put(id, old.get(id))
+            val ids = alarmReceiptIds(alarms.getJSONObject(i))
+            val previous = ids.firstOrNull(old::has)
+            if (previous != null) ids.forEach { retained.put(it, old.get(previous)) }
         }
         value.put("delivered", retained)
         commit(value)
