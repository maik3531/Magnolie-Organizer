+    @Test fun coincidentAlarmReceiptsSuppressEitherIdentityWithoutSuppressingOtherItems() {
+        val combined=alarm().put("id","absolute-one").put("receiptAliases",JSONArray().put("ordinary-one"))
+        val other=alarm().put("id","absolute-two").put("receiptAliases",JSONArray().put("ordinary-two"))
+        for (receipt in listOf("absolute-one","ordinary-one")) {
+            val value=JSONObject().put("enabled",true).put("customEnabled",true)
+                .put("alarms",JSONArray().put(combined).put(other))
+                .put("delivered",JSONObject().put(receipt,100000L))
+            assertEquals(listOf("absolute-two"),eligibleAlarms(value,100000L).map {it.getString("id")})
+        }
+    }
+    @Test fun encryptedSaveMigratesEitherOldReceiptAndRetainsItWhenEitherAlarmKindIsRemoved() {
+        for (oldId in listOf("absolute-one","ordinary-one")) for (remainingId in listOf("absolute-one","ordinary-one")) {
+            val dir=Files.createTempDirectory("tablet-alarm-receipts").toFile()
+            try {
+                val key=key(); val old=Vault(dir,{key})
+                val original=old.save(data().toString(),JSONArray().put(alarm().put("id",oldId)))
+                original.put("enabled",true).getJSONObject("delivered").put(oldId,100000L)
+                old.write(original)
+                val combined=alarm().put("id","absolute-one").put("receiptAliases",JSONArray().put("ordinary-one"))
+                val migrated=Vault(dir,{key}).save(data().toString(),JSONArray().put(combined))
+                assertEquals(setOf("absolute-one","ordinary-one"),migrated.getJSONObject("delivered").keys().asSequence().toSet())
+                assertTrue(eligibleAlarms(Vault(dir,{key}).read()!!,100000L).isEmpty())
+                val remaining=Vault(dir,{key}).save(data().toString(),JSONArray().put(alarm().put("id",remainingId)))
+                assertTrue(eligibleAlarms(remaining,100000L).isEmpty())
+                assertTrue(eligibleAlarms(Vault(dir,{key}).read()!!,100000L).isEmpty())
+                val changed=alarm().put("id","new-instant").put("at",100017L)
+                val newTime=Vault(dir,{key}).save(data().toString(),JSONArray().put(changed))
+                assertEquals(listOf("new-instant"),eligibleAlarms(newTime,100017L).map {it.getString("id")})
+            } finally {dir.deleteRecursively()}
+        }
+    }
+    @Test fun deliveredCoincidentAlarmKeepsBothReceiptsAfterEncryptedReopen() {
+        val dir=Files.createTempDirectory("tablet-alarm-delivered").toFile()
+        try {
+            val key=key(); val vault=Vault(dir,{key})
+            val combined=alarm().put("id","absolute-one").put("receiptAliases",JSONArray().put("ordinary-one"))
+            val state=vault.save(data().toString(),JSONArray().put(combined)).put("enabled",true)
+            val next=eligibleAlarms(state,100000L).single()
+            // This is the same receipt operation used after notification delivery.
+            alarmReceiptIds(next).forEach {state.getJSONObject("delivered").put(it,100000L)}
+            vault.write(state)
+            val reloaded=Vault(dir,{key}).read()!!
+            assertEquals(setOf("absolute-one","ordinary-one"),reloaded.getJSONObject("delivered").keys().asSequence().toSet())
+            assertTrue(eligibleAlarms(reloaded,100000L).isEmpty())
+        } finally {dir.deleteRecursively()}
+    }
+    @Test fun malformedReceiptAliasesCannotReplaceTheSavedBook() {
+        val dir=Files.createTempDirectory("tablet-alarm-invalid").toFile()
+        try {
+            val key=key(); val vault=Vault(dir,{key}); vault.save(data("old").toString(),JSONArray())
+            val before=dir.resolve("tablet-vault.enc").readBytes()
+            for (aliases in listOf("wrong-shape",JSONArray().put(7),JSONArray().put(""),JSONArray().put("a".repeat(1025)),
+                JSONArray(listOf("a","b","c","d","e")))) {
+                reject {vault.save(data("replacement").toString(),JSONArray().put(alarm().put("receiptAliases",aliases)))}
+                assertArrayEquals(before,dir.resolve("tablet-vault.enc").readBytes())
+            }
+        } finally {dir.deleteRecursively()}
+    }
+    @Test fun preAliasEncryptedPlansAreReconciledBeforeAnyWebSaveAndBeforeRemovingEitherKind() {
+        val ordinary="kalender:one:100000"; val absolute="kalender:one:absolute:100000"
+        for (oldId in listOf("",ordinary,absolute)) for (remainingId in listOf(ordinary,absolute)) {
+            val dir=Files.createTempDirectory("tablet-legacy-alarms").toFile()
+            try {
+                val key=key(); val vault=Vault(dir,{key})
+                fun row(id:String)=alarm().put("id",id).put("section","kalender")
+                val old=vault.save(data().toString(),JSONArray().put(row(absolute)).put(row(ordinary))).put("enabled",true)
+                if (oldId.isNotEmpty()) old.getJSONObject("delivered").put(oldId,100000L)
+                vault.write(old)
+                val reopened=Vault(dir,{key}).read()!!
+                assertEquals(2,reopened.getJSONArray("alarms").length()) // No implicit resave or UI projection.
+                assertEquals(if(oldId.isEmpty()) 1 else 0,eligibleAlarms(reopened,100000L).size)
+                if (oldId.isEmpty()) {
+                    val next=eligibleAlarms(reopened,100000L).single()
+                    alarmReceiptIds(next).forEach {reopened.getJSONObject("delivered").put(it,100000L)}
+                    Vault(dir,{key}).write(reopened)
+                }
+                val remaining=Vault(dir,{key}).save(data().toString(),JSONArray().put(row(remainingId)))
+                assertTrue(eligibleAlarms(remaining,100000L).isEmpty())
+                assertTrue(eligibleAlarms(Vault(dir,{key}).read()!!,100000L).isEmpty())
+            } finally {dir.deleteRecursively()}
+        }
+    }
