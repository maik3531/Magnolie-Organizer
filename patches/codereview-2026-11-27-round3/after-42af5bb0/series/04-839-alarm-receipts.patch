diff --git a/Magnolie-Organizer-Android-Tablet-Beta/app/src/main/java/io/gitlab/maik3531/magnolietabletbeta/EligibleAlarms.kt b/Magnolie-Organizer-Android-Tablet-Beta/app/src/main/java/io/gitlab/maik3531/magnolietabletbeta/EligibleAlarms.kt
index e655d6292e499e093a8e8cf6af25fb7b92101011..45425e62c78ba03a571fc731944e47b477c2673a 100644
--- a/Magnolie-Organizer-Android-Tablet-Beta/app/src/main/java/io/gitlab/maik3531/magnolietabletbeta/EligibleAlarms.kt
+++ b/Magnolie-Organizer-Android-Tablet-Beta/app/src/main/java/io/gitlab/maik3531/magnolietabletbeta/EligibleAlarms.kt
@@ -3,12 +3,76 @@ package io.gitlab.maik3531.magnolietabletbeta
 import org.json.JSONArray
 import org.json.JSONObject
 
+private val legacyEarlyAlarmSuffix = Regex(":early-[1-7]$")
+
+internal fun alarmReceiptIds(alarm: JSONObject): List<String> {
+    val id = alarm.getString("id")
+    require(id.isNotEmpty() && id.length <= 1024)
+    val aliases = if (alarm.has("receiptAliases")) alarm.getJSONArray("receiptAliases") else JSONArray()
+    require(aliases.length() <= 4)
+    return (listOf(id) + (0 until aliases.length()).map {
+        val alias = aliases.get(it)
+        require(alias is String && alias.isNotEmpty() && alias.length <= 1024)
+        alias
+    }).distinct()
+}
+
+internal fun coincidentAlarms(value: JSONObject): List<JSONObject> {
+    val alarms = value.optJSONArray("alarms") ?: JSONArray()
+    val book = value.optJSONObject("data")
+    val records = mapOf("kalender" to "termine", "aufgaben" to "aufgaben").mapValues { (_, collection) ->
+        val rows = book?.optJSONArray(collection) ?: JSONArray()
+        val counts = mutableMapOf<String, Int>()
+        for (index in 0 until rows.length()) {
+            val id = rows.optJSONObject(index)?.opt("id") as? String ?: continue
+            counts[id] = (counts[id] ?: 0) + 1
+        }
+        counts
+    }
+    fun identity(alarm: JSONObject): Triple<String, String, Long>? {
+        if (alarm.getBoolean("custom")) return null
+        val section = alarm.getString("section")
+        val ids = records[section] ?: return null
+        val at = alarm.getLong("at")
+        val id = alarm.getString("id")
+        if (!id.startsWith("$section:") || !id.endsWith(":$at")) return null
+        val encoded = id.removePrefix("$section:").removeSuffix(":$at")
+        // Old saved plans predate aliases. Bind their namespace to an actual
+        // unique stored local ID; an ID containing ':absolute' is opaque data.
+        val candidates = mutableSetOf(encoded)
+        if (encoded.endsWith(":absolute")) candidates.add(encoded.removeSuffix(":absolute"))
+        if (section == "aufgaben" && legacyEarlyAlarmSuffix.containsMatchIn(encoded))
+            candidates.add(encoded.substringBeforeLast(":"))
+        val matches = candidates.filter(ids::containsKey)
+        if (matches.size != 1 || ids[matches.single()] != 1) return null
+        return Triple(section, matches.single(), at)
+    }
+    val result = mutableListOf<JSONObject>()
+    val groups = mutableMapOf<Triple<String, String, Long>, Int>()
+    for (index in 0 until alarms.length()) {
+        val alarm = alarms.getJSONObject(index)
+        val key = identity(alarm)
+        val previous = key?.let(groups::get)
+        if (previous == null) {
+            if (key != null) groups[key] = result.size
+            result.add(alarm)
+        } else {
+            val first = result[previous]
+            val aliases = (alarmReceiptIds(first) + alarmReceiptIds(alarm)).distinct().filter { it != first.getString("id") }
+            val merged = JSONObject()
+            for (name in first.keys()) merged.put(name, first.get(name))
+            if (aliases.isNotEmpty()) merged.put("receiptAliases", JSONArray(aliases))
+            result[previous] = merged
+        }
+    }
+    return result
+}
+
 internal fun eligibleAlarms(value: JSONObject, now: Long): List<JSONObject> {
     if (!value.optBoolean("enabled")) return emptyList()
-    val alarms = value.optJSONArray("alarms") ?: JSONArray()
     val delivered = value.optJSONObject("delivered") ?: JSONObject()
-    return (0 until alarms.length()).map { alarms.getJSONObject(it) }.filter {
+    return coincidentAlarms(value).filter {
         (!it.getBoolean("custom") || value.optBoolean("customEnabled")) &&
-            !delivered.has(it.getString("id")) && it.getLong("at") >= now - 24 * 60 * 60 * 1000
+            alarmReceiptIds(it).none(delivered::has) && it.getLong("at") >= now - 24 * 60 * 60 * 1000
     }.sortedBy { it.getLong("at") }
 }
