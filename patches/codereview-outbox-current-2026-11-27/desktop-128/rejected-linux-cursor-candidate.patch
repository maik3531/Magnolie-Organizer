+    def _pump_pending(self, channel, peer_id, transport):
+        # A new authenticated channel starts at the head. Merely inspecting
+        # pending messages or actor ACK candidates never advances this cursor.
+        old = self._outbox_actor_windows.get(channel)
+        after = old[2] if old is not None and old[:2] == (peer_id, transport) else None
+        messages, advance = self.store.pump_window(peer_id, transport, after)
+        for message in messages:
+            sent = self._send_message(channel, peer_id, message)
+            if sent and message.get("kind") == personal_actor_contract.DATA_KIND:
+                advance = None  # An authorized actor keeps the existing send order.
+        if advance is None:
+            self._outbox_actor_windows.pop(channel, None)
+        else:
+            self._outbox_actor_windows[channel] = (peer_id, transport, advance)
+
