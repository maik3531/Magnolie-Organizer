+++ b/magnolie-notes/app/src/test/java/io/gitlab/maik3531/magnolienotes/einfuhr/EinfuhrVerschachtelteArchiveTest.kt
@@ -0,0 +1,55 @@
+package io.gitlab.maik3531.magnolienotes.einfuhr
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.ByteArrayOutputStream
+import java.io.IOException
+import java.util.zip.ZipEntry
+import java.util.zip.ZipOutputStream
+
+/** Refs #825: use tiny bounded payloads to exercise the real recursive-import bypass. */
+class EinfuhrVerschachtelteArchiveTest {
+    private fun zip(vararg entries: Pair<String, ByteArray>): ByteArray = ByteArrayOutputStream().also { output ->
+        ZipOutputStream(output).use { zip -> for ((name, bytes) in entries) {
+            zip.putNextEntry(ZipEntry(name)); zip.write(bytes); zip.closeEntry()
+        } }
+    }.toByteArray()
+
+    @Test fun `verschachtelte Archive werden auch unter fremden Endungen ganz abgewiesen`() {
+        val nested = zip("note.txt" to "Nested note".toByteArray())
+        for (suffix in listOf("zip", "sdocx", "jex", "txt", "json", "html", "enex")) {
+            val outer = zip("before.txt" to "Do not partially import".toByteArray(), "nested.$suffix" to nested)
+            assertThrows(suffix, IOException::class.java) { Einfuhr.ausInhalt(outer, "outer.zip", 0L) }
+        }
+    }
+
+    @Test fun `neuer Archivaufruf kann die gesetzte Entpackgrenze nicht zuruecksetzen`() {
+        val nested = zip("note.txt" to "x".repeat(1024).toByteArray())
+        assertTrue(nested.size < 256)
+        val outer = zip("nested.sdocx" to nested)
+        assertThrows(IOException::class.java) {
+            Einfuhr.ausZip(outer, "outer.zip", null, eintragMax = 256, archivEntpacktMax = 256)
+        }
+    }
+
+    @Test fun `auch leere Unterarchive gelten nicht als gewoehnliche Textdatei`() {
+        assertThrows(IOException::class.java) { Einfuhr.ausInhalt(zip("empty.txt" to zip()), "outer.zip", 0L) }
+    }
+
+    @Test fun `oberstes Samsung Archiv mit normalen Dateien bleibt lesbar`() {
+        val archive = zip("samsung-note.html" to
+            "<html><head><title>Samsung</title></head><body>Keep this text</body></html>".toByteArray())
+        val note = Einfuhr.ausInhalt(archive, "export.sdocx", 0L).single()
+        assertEquals("Samsung Notes", note.herkunft)
+        assertTrue(note.html.contains("Keep this text"))
+    }
+
+    @Test fun `flaches Archiv und bisherige Groessengrenzen bleiben wirksam`() {
+        val archive = zip("one.txt" to "One".toByteArray(), "two.txt" to "Two".toByteArray())
+        assertEquals(listOf("One", "Two"), Einfuhr.ausInhalt(archive, "export.zip", 0L).map { it.text })
+        assertThrows(IOException::class.java) { Einfuhr.ausZip(archive, "export.zip", null, eintragMax = 2) }
+        assertThrows(IOException::class.java) { Einfuhr.ausZip(archive, "export.zip", null, archivEntpacktMax = 5) }
+    }
+}
