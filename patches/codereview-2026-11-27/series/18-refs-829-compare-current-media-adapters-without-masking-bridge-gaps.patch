Subject: [PATCH] Refs #829: compare current media adapters without masking
 bridge gaps

---
 .../tests/full-parity-contract.js             | 70 ++++++++++++++++++-
 .../tests/linux-parity-fixture.js             | 31 +++++++-
 .../resources/linux-parity-contract.json      | 17 ++++-
 magnolie-organizer/web/anwendung.js           |  2 +-
 4 files changed, 113 insertions(+), 7 deletions(-)

diff --git a/magnolie-organizer-windows/tests/full-parity-contract.js b/magnolie-organizer-windows/tests/full-parity-contract.js
index f5f725969eec39b799e748f4baf0c87f0bbe554f..cc99b402bcb9a643cc997d15bb45a3e160f56212 100644
--- a/magnolie-organizer-windows/tests/full-parity-contract.js
