diff --git a/magnolie-organizer-windows/CloudBackupService.cs b/magnolie-organizer-windows/CloudBackupService.cs
index db5f71c223103d76d15f330d5c3db1fdc841523a..0a3c5873c4136ee2dad6ae2d7dc102b634649eae 100644
--- a/magnolie-organizer-windows/CloudBackupService.cs
