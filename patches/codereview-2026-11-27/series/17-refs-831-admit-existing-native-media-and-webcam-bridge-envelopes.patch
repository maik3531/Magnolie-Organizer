--- /dev/null
+++ b/magnolie-organizer-windows/tests/BridgeMediaEnvelopeTests.cs
@@ -0,0 +1,55 @@
+using System.Text.Json.Nodes;
+using MagnolieOrganizer.Windows;
+
+namespace MagnolieOrganizer.Windows.Tests;
+
+internal static class BridgeMediaEnvelopeTests
+{
+    internal static Task RunAsync()
+    {
+        // Refs #831: exercise the outer parser used before the native handlers,
+        // not just the action-specific parser behind it.
+        foreach (var command in new[] { "telefon_webcam_stand", "telefon_webcam_start", "telefon_webcam_stop" })
+        {
+            var message = new JsonObject { ["cmd"] = command, ["requestId"] = "synthetic-request" };
+            if (command == "telefon_webcam_start") message["peer"] = "11111111-1111-4111-8111-111111111111";
+            if (command == "telefon_webcam_stop") message["run"] = "22222222-2222-4222-8222-222222222222";
+            using (BridgeDispatcherContract.Parse(message.ToJsonString())) { }
+            foreach (var field in message.Select(item => item.Key).Where(key => key != "cmd").ToArray())
+            {
+                var missing = message.DeepClone().AsObject(); missing.Remove(field);
+                Reject(missing, "Webcam request omitted " + field);
+                var wrongType = message.DeepClone().AsObject(); wrongType[field] = true;
+                Reject(wrongType, "Webcam request accepted a non-string " + field);
+            }
+            foreach (var field in new[] { "confirmed", "grant", "path", "receive_files" })
+            {
+                var forged = message.DeepClone().AsObject(); forged[field] = true;
+                Reject(forged, "Webcam request accepted browser authority: " + field);
+            }
+        }
+
+        var media = new JsonObject { ["cmd"] = "telefon_medien", ["requestId"] = "synthetic-request",
+            ["device_id"] = "11111111-1111-4111-8111-111111111111", ["action"] = "status" };
+        foreach (var (field, value) in new (string, JsonNode?)[] {
+            ("backup_id", JsonValue.Create(true)), ("location_id", JsonValue.Create(1)),
+            ("field", JsonValue.Create(false)), ("value", new JsonObject()),
+            ("value", new JsonArray()), ("value", JsonValue.Create(1)), ("value", null),
+            ("granted", JsonValue.Create("true")), ("granted", JsonValue.Create(1)) })
+        {
+            var wrongType = media.DeepClone().AsObject(); wrongType[field] = value;
+            Reject(wrongType, "Media envelope accepted a wrong type for " + field);
+        }
+        foreach (var field in new[] { "confirmed", "grant", "path", "receive_files" })
+        {
+            var forged = media.DeepClone().AsObject(); forged[field] = true;
+            Reject(forged, "Media envelope accepted browser authority: " + field);
+        }
+        media["cmd"] = "telefon_webcam_unknown";
+        Reject(media, "Unknown webcam command was admitted by prefix");
+        return Task.CompletedTask;
+    }
+
+    private static void Reject(JsonObject message, string reason) =>
+        TestAssert.Throws<InvalidDataException>(() => { using var parsed = BridgeDispatcherContract.Parse(message.ToJsonString()); }, reason);
+}
