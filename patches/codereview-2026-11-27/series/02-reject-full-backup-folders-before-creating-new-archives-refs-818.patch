+def check_capacity(directory):
+    """Reserve one listing slot before a new archive is encrypted or written.
+
+    Retention still re-reads the directory after verification. This preflight
+    prevents a consistently full folder from gaining an archive on every retry.
+    """
+    with os.scandir(directory) as listing:
+        for index, _entry in enumerate(listing):
+            if index >= LIST_LIMIT - 1:
+                raise OSError("The backup folder contains too many entries.")
+
