From: Maik Walter <154642264+maik3531@users.noreply.github.com>
Date: Fri, 27 Nov 2026 11:09:31 +0100
Subject: [PATCH] Refs #819: Preserve fractional seconds in note import
 timestamps

---
 .../maik3531/magnolienotes/einfuhr/Leser.kt   | 38 +++++++-----
 .../magnolienotes/einfuhr/LeserZeitTest.kt    | 59 +++++++++++++++++++
 2 files changed, 81 insertions(+), 16 deletions(-)
 create mode 100644 magnolie-notes/app/src/test/java/io/gitlab/maik3531/magnolienotes/einfuhr/LeserZeitTest.kt

diff --git a/magnolie-notes/app/src/main/java/io/gitlab/maik3531/magnolienotes/einfuhr/Leser.kt b/magnolie-notes/app/src/main/java/io/gitlab/maik3531/magnolienotes/einfuhr/Leser.kt
index c0838bdc71d65102d8f9727b39a305a48d37298e..b03b786eedd9dc3420a52b1172c771f087c03a30 100644
--- a/magnolie-notes/app/src/main/java/io/gitlab/maik3531/magnolienotes/einfuhr/Leser.kt
+++ b/magnolie-notes/app/src/main/java/io/gitlab/maik3531/magnolienotes/einfuhr/Leser.kt
@@ -5,6 +5,12 @@ import kotlinx.serialization.json.JsonObject
 import kotlinx.serialization.json.JsonPrimitive
 import kotlinx.serialization.json.Json
 import java.text.SimpleDateFormat
+import java.time.LocalDate
+import java.time.LocalDateTime
+import java.time.OffsetDateTime
+import java.time.ZoneId
+import java.time.format.DateTimeFormatter
+import java.time.format.ResolverStyle
 import java.util.Locale
 import java.util.TimeZone
 
@@ -251,26 +257,26 @@ object Leser {
         .replace(Regex("<[^>]*>"), "")
         .let { Rohnotiz.entwirreEntitaeten(it) }
 
-    private val ISO_FORMEN = listOf(
-        "yyyy-MM-dd'T'HH:mm:ss.SSSXXX",
-        "yyyy-MM-dd'T'HH:mm:ssXXX",
-        "yyyy-MM-dd'T'HH:mm:ss'Z'",
-        "yyyy-MM-dd HH:mm:ss",
-        "yyyy-MM-dd"
-    )
+    private val LOKALE_ZEIT = DateTimeFormatter.ofPattern("uuuu-MM-dd HH:mm:ss", Locale.ROOT)
+        .withResolverStyle(ResolverStyle.STRICT)
 
     fun isoZeit(roh: String): Long {
         if (roh.isBlank()) return 0L
-        roh.toLongOrNull()?.let { return if (it > 100_000_000_000L) it else it * 1000 }
-        for (form in ISO_FORMEN) {
-            val ergebnis = runCatching {
-                val formen = SimpleDateFormat(form, Locale.ROOT)
-                if (form.endsWith("'Z'")) formen.timeZone = TimeZone.getTimeZone("UTC")
-                formen.parse(roh)?.time
-            }.getOrNull()
-            if (ergebnis != null && ergebnis > 0) return ergebnis
+        roh.toLongOrNull()?.let {
+            return runCatching { if (it > 100_000_000_000L) it else Math.multiplyExact(it, 1000L) }
+                .getOrDefault(0L)
         }
-        return 0L
+        // ISO fractions describe parts of a second, not a count of milliseconds.
+        // java.time also consumes the whole input and rejects invalid dates.
+        val zeit = runCatching { OffsetDateTime.parse(roh, DateTimeFormatter.ISO_OFFSET_DATE_TIME).toInstant() }
+            .getOrElse {
+                runCatching { LocalDateTime.parse(roh, LOKALE_ZEIT).atZone(ZoneId.systemDefault()).toInstant() }
+                    .getOrElse {
+                        runCatching { LocalDate.parse(roh, DateTimeFormatter.ISO_LOCAL_DATE)
+                            .atStartOfDay(ZoneId.systemDefault()).toInstant() }.getOrNull()
+                    }
+            }
+        return runCatching { zeit?.toEpochMilli()?.takeIf { it > 0 } ?: 0L }.getOrDefault(0L)
     }
 
     /** Deutsche und englische Datumszeilen, wie Keep sie ins HTML schreibt. */
diff --git a/magnolie-notes/app/src/test/java/io/gitlab/maik3531/magnolienotes/einfuhr/LeserZeitTest.kt b/magnolie-notes/app/src/test/java/io/gitlab/maik3531/magnolienotes/einfuhr/LeserZeitTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..daae59117712063731e1df5f0c400a26c66e0772
--- /dev/null
+++ b/magnolie-notes/app/src/test/java/io/gitlab/maik3531/magnolienotes/einfuhr/LeserZeitTest.kt
@@ -0,0 +1,59 @@
+package io.gitlab.maik3531.magnolienotes.einfuhr
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import java.time.Instant
+import java.util.TimeZone
+
+/** Refs #819: source timestamps keep their instant, including fractional seconds. */
+class LeserZeitTest {
+    @Test fun `ISO Bruchteile behalten ihren Sekundenanteil`() {
+        val base = Instant.parse("2026-11-27T10:00:00Z").toEpochMilli()
+        val cases = mapOf("" to 0L, ".1" to 100L, ".12" to 120L, ".123" to 123L,
+            ".123456" to 123L, ".123456789" to 123L, ".000001" to 0L, ".999999999" to 999L)
+        for ((fraction, millis) in cases) {
+            assertEquals(fraction, base + millis, Leser.isoZeit("2026-11-27T10:00:00${fraction}Z"))
+            assertEquals("positive offset $fraction", base + millis,
+                Leser.isoZeit("2026-11-27T11:00:00${fraction}+01:00"))
+            assertEquals("negative offset $fraction", base + millis,
+                Leser.isoZeit("2026-11-27T04:30:00${fraction}-05:30"))
+        }
+    }
+
+    @Test fun `falsche Tage und Resttext werden nicht normalisiert`() {
+        for (value in listOf("2026-02-30T10:00:00.000Z", "2026-02-29T10:00:00Z",
+            "2026-13-01T10:00:00Z", "2026-11-27T25:00:00Z", "2026-11-27T10:60:00Z",
+            "2026-11-27T10:00:00.1234567890Z", "2026-11-27T10:00:00Zrest",
+            "2026-11-27T10:00:00.000Zrest", "2026-02-30 10:00:00", "2026-11-27 10:00:00rest",
+            "2026-02-30", "2026-11-27rest", "not a date", "", " "))
+            assertEquals(value, 0L, Leser.isoZeit(value))
+        assertEquals(Instant.parse("2024-02-29T10:00:00Z").toEpochMilli(), Leser.isoZeit("2024-02-29T10:00:00Z"))
+    }
+
+    @Test fun `beide Exportleser erhalten Erstellungs und Aenderungszeit`() {
+        val created = "2026-11-27T10:00:00.123456Z"
+        val changed = "2026-11-27T10:01:00.1Z"
+        val standard = Leser.standardNotes("""{"items":[{"content_type":"Note",
+            "created_at":"$created","updated_at":"$changed",
+            "content":{"title":"Synthetic","text":"Content"}}]}""").single()
+        val simple = Leser.simplenote("""{"activeNotes":[{"content":"Synthetic",
+            "creationDate":"$created","lastModified":"$changed"}]}""").single()
+        for (note in listOf(standard, simple)) {
+            assertEquals(Instant.parse(created).toEpochMilli(), note.angelegt)
+            assertEquals(Instant.parse(changed).toEpochMilli(), note.geaendert)
+        }
+    }
+
+    @Test fun `lokale und numerische Altformate bleiben erhalten`() {
+        val original = TimeZone.getDefault()
+        try {
+            TimeZone.setDefault(TimeZone.getTimeZone("Europe/Berlin"))
+            assertEquals(Instant.parse("2026-11-27T09:00:00Z").toEpochMilli(), Leser.isoZeit("2026-11-27 10:00:00"))
+            assertEquals(Instant.parse("2026-11-26T23:00:00Z").toEpochMilli(), Leser.isoZeit("2026-11-27"))
+            assertEquals(Instant.parse("2026-11-27T10:00:00Z").toEpochMilli(), Leser.isoZeit("2026-11-27T10:00:00Z"))
+            assertEquals(1_700_000_000_000L, Leser.isoZeit("1700000000"))
+            assertEquals(1_700_000_000_000L, Leser.isoZeit("1700000000000"))
+            assertEquals(0L, Leser.isoZeit((Long.MIN_VALUE + 1).toString()))
+        } finally { TimeZone.setDefault(original) }
+    }
+}
