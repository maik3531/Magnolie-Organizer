diff --git a/magnolie-notes/app/src/main/java/io/gitlab/maik3531/magnolienotes/einfuhr/OrdnerImportBudget.kt b/magnolie-notes/app/src/main/java/io/gitlab/maik3531/magnolienotes/einfuhr/OrdnerImportBudget.kt
