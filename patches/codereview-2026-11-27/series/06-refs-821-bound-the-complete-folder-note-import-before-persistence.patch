+++ b/magnolie-notes/app/src/main/java/io/gitlab/maik3531/magnolienotes/einfuhr/OrdnerImportBudget.kt
@@ -0,0 +1,35 @@
+package io.gitlab.maik3531.magnolienotes.einfuhr
+
+import java.io.IOException
+
+/** Refs #821: one budget for the complete traversal, including expanded ZIP notes. */
+internal class OrdnerImportBudget(
+    private val maxEintraege: Int = 5000,
+    private val maxNotizen: Int = 5000,
+    private val maxRohbytes: Long = 64L * 1024 * 1024,
+    private val maxTextbytes: Long = 64L * 1024 * 1024
+) {
+    private var eintraege = 0
+    private var notizen = 0
+    private var rohbytes = 0L
+    private var textbytes = 0L
+    val verbleibendeRohbytes: Long get() = maxRohbytes - rohbytes
+
+    fun besuchen() {
+        if (++eintraege > maxEintraege) throw IOException("Zu viele Ordnereintraege")
+    }
+
+    fun gelesen(bytes: Long) {
+        if (bytes < 0 || bytes > verbleibendeRohbytes) throw IOException("Ordnerimport zu gross")
+        rohbytes += bytes
+    }
+
+    fun aufnehmen(notiz: Rohnotiz) {
+        if (++notizen > maxNotizen) throw IOException("Zu viele importierte Notizen")
+        for (text in listOf(notiz.titel, notiz.text, notiz.html, notiz.herkunft, notiz.notizbuch)) {
+            val bytes = text.toByteArray(Charsets.UTF_8).size.toLong()
+            if (bytes > maxTextbytes - textbytes) throw IOException("Entpackgrenze des Ordnerimports ueberschritten")
+            textbytes += bytes
+        }
+    }
+}
diff --git a/magnolie-notes/app/src/test/java/androidx/documentfile/provider/SyntheticImportDocumentFile.kt b/magnolie-notes/app/src/test/java/androidx/documentfile/provider/SyntheticImportDocumentFile.kt
new file mode 100644
index 0000000000000000000000000000000000000000..79c15533449c48444f6818b1d7fa2e8ee473b2b1
--- /dev/null
+++ b/magnolie-notes/app/src/test/java/androidx/documentfile/provider/SyntheticImportDocumentFile.kt
@@ -0,0 +1,24 @@
+package androidx.documentfile.provider
+
+import android.net.Uri
+
+/** Test node lives beside DocumentFile because its constructor is package-private. */
+class SyntheticImportDocumentFile(private val label: String, val bytes: ByteArray = byteArrayOf(),
+                                  private val children: Array<SyntheticImportDocumentFile>? = null) : DocumentFile(null) {
+    override fun getName() = label
+    override fun isDirectory() = children != null
+    override fun isFile() = children == null
+    override fun listFiles(): Array<DocumentFile> = children?.map { it as DocumentFile }?.toTypedArray() ?: emptyArray()
+    override fun length() = bytes.size.toLong()
+    override fun lastModified() = 0L
+    override fun canRead() = true
+    override fun canWrite() = false
+    override fun exists() = true
+    override fun isVirtual() = false
+    override fun getType(): String? = null
+    override fun getUri(): Uri = throw AssertionError("Traversal must not access an unrequested URI")
+    override fun createFile(mimeType: String, displayName: String): DocumentFile? = null
+    override fun createDirectory(displayName: String): DocumentFile? = null
+    override fun delete() = false
+    override fun renameTo(displayName: String) = false
+}
