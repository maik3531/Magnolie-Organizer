       assert.ok(item.inhalt);
       if (language !== "en") assert.notEqual(item.inhalt, item._source.inhalt, `${language}/${id}`);
     }
+    const recoveryWarning = page("wiederherstellungspunkte-was").inhaltAnhang.en;
