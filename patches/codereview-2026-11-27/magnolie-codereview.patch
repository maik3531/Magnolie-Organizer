+  titel: id, notiz: id + " original", datum: "2026-11-27", zeit: id === "a" ? "09:00" : "10:00",
+  faellig: "2026-11-27", sync: true, syncQuellen: { [source]: { id: "/" + id, etag: '"observed"' } } });
